# JIT / build caches
out/
out-test/
__aiml_cache/
__exodus_cache/

# Test runner output
test_results.txt

# AionDB persistence artifacts (produced by `db.*` calls in tests/runs)
*.kvwal
*.wal
*.db
*.db-journal
*.tslog

# Test-generated DB layouts (legacy and current)
mydb/
aiondb/
aiondb_rel_*/

# IR debug dumps (failed module verification writes /tmp/aiml_bad_module.ll;
# only relevant if someone copies it into the repo)
aiml_bad_module.ll

# Exodus artifacts
out/test_link_bug/
out-test/
test_link_bug
out/aiml_wasm/

assets/

out/aot_repro/
aot_trycatch_repro

out-asan/

# Driver binaries: tests/bundle_socket/run.sh builds them into the root directory
# (their own exodus-*.json, hence not covered by `exodus gitignore --all`).
bs_listener
bs_sender

# Build/suite/measurement logs and staging copies (11 MB, 223 files).
logs/

# Logs produced by test runs (drivers write them next to the probe).
# The audit logs under doc/analysis/ are versioned ON PURPOSE and stay.
tests/**/*.log
tests/**/*.log.off

# Build artifacts. They were versioned by accident (357 files, 5.8 MB): the
# AOT binaries and .o/.d of the leak audits, and the .ll that run_aot_tests.sh itself
# creates and deletes again. Sources and logs of the audits stay versioned.
*.o
*.d
*.pyc
__pycache__/
tests/*.ll
tests/**/*.ll
tests/bundle_socket/*.out
doc/analysis/**/bin

# Host library of the clearance probes: built by run.sh from the .c (F65-39).
tests/clearance/fixtures/*.so

# ZIM test fixture — built by tests/compress_zim/run.sh with the libzim writer (spec/33_2 §6)
tests/data/aiml_zim_test.zim

# Logs and measurement artifacts that accumulate alongside the work (848 kB).  Gate,
# suite and build logs belong in the leak_probes session dir: persistent,
# so that they survive a restart, but not versioned.  rc1 freed this
# repo of 376 MB of accidentally versioned build output; it stays that way.
leak_probes/
build_introspect.log
wasm_yaml_build.log
doc/reports/*.log

# Measurement artifacts of the performance runs.  What is versioned is the result
# (spec/70 F70-70: results/<case>/<run-id>.json), not the binaries and logs.
performance/results/**/*.bin
performance/results/**/*.log
performance/results/**/*.out
performance/results/**/*.stdout
performance/results/**/*.stderr

# Test/run artifacts written to the repo root
/test_io.txt
/logs_*.txt
