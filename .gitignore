# JIT / build caches
out/
out-test/
__aiml_cache/
__exodus_cache/

# Test runner output
test_results.txt

# AionDB persistence artifacts (produced by `db.*` calls in tests/runs)
*.kvwal
*.wal
*.db
*.db-journal
*.tslog

# Test-generated DB layouts (legacy and current)
mydb/
aiondb/
aiondb_rel_*/

# IR debug dumps (failed module verification writes /tmp/aiml_bad_module.ll;
# only relevant if someone copies it into the repo)
aiml_bad_module.ll

# Exodus artifacts
out/test_link_bug/
out-test/
test_link_bug
out/aiml_wasm/

assets/

out/aot_repro/
aot_trycatch_repro

out-asan/

# Treiber-Binaries: tests/bundle_socket/run.sh baut sie ins Wurzelverzeichnis
# (eigene exodus-*.json, deshalb von `exodus gitignore --all` nicht erfasst).
bs_listener
bs_sender

# Build-/Suite-/Messprotokolle und Staging-Kopien (11 MB, 223 Dateien).
logs/

# Von Testlaeufen erzeugte Protokolle (Treiber schreiben sie neben die Probe).
# Die Audit-Protokolle unter doc/analysis/ sind BEWUSST versioniert und bleiben.
tests/**/*.log
tests/**/*.log.off

# Bauartefakte. Sie waren versehentlich versioniert (357 Dateien, 5,8 MB): die
# AOT-Binaries und .o/.d der Leak-Audits, und die .ll, die run_aot_tests.sh selbst
# erzeugt und wieder loescht. Quellen und Protokolle der Audits bleiben versioniert.
*.o
*.d
*.pyc
__pycache__/
tests/*.ll
tests/**/*.ll
tests/bundle_socket/*.out
doc/analysis/**/bin

# Wirts-Bibliothek der Clearance-Proben: wird von run.sh aus der .c gebaut (F65-39).
tests/clearance/fixtures/*.so

# ZIM test fixture — built by tests/compress_zim/run.sh with the libzim writer (spec/33_2 §6)
tests/data/aiml_zim_test.zim

# Protokolle und Mess-Artefakte, die neben der Arbeit anfallen (848 kB).  Gate-,
# Suite- und Build-Protokolle gehoeren ins leak_probes-Session-Dir: persistent,
# damit sie einen Neustart ueberleben, aber nicht versioniert.  rc1 hat dieses
# Repo von 376 MB versehentlich versionierter Build-Ausgabe befreit; das bleibt so.
leak_probes/
build_introspect.log
wasm_yaml_build.log
doc/reports/*.log

# Mess-Artefakte der Performance-Laeufe.  Versioniert wird das Ergebnis
# (spec/70 F70-70: results/<case>/<run-id>.json), nicht die Binaries und Logs.
performance/results/**/*.bin
performance/results/**/*.log
performance/results/**/*.out
performance/results/**/*.stdout
performance/results/**/*.stderr

# Test/run artifacts written to the repo root
/test_io.txt
/logs_*.txt
