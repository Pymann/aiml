# Logic and Control Flow Proposal (Revised)

- set: [x, 10]
- set: [y, 20]
- set: [z, 5]

# If statement with Nested Dict Expressions
# condition: { and: [ { lt: [x, y] }, { gt: [x, z] } ] }
# This is unambiguous.

- if:
    condition: { and: [ { lt: [x, y] }, { gt: [x, z] } ] }
    then:
      - print: [x]
      - set: [result, 1]
    else:
      - print: [z]
      - set: [result, 0]

- print: [result]
