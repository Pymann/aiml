# static-check: off
# Spec 61 container audit: B4; target: correct content, 0 lost bytes, no memory errors.
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 400]}
          body:
            - decl: [index, "map<string:list<i32>>"]
            - decl: [row, list<i32>]
            - call: [row.push, 42]
            - call: [index.put, "key", row]
            - call: [index.remove, "key"]
            - if: {condition: {neq: [index.len, 0]}, then: [{return: 21}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
