# static-check: off
# Spec 61 container audit: control; target: correct content, 0 lost bytes, no memory errors.
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [grid, list<list<i32>>]
            - decl: [row, list<i32>]
            - call: [row.push, 42]
            - call: [grid.push, row]
            - if: {condition: {neq: [grid.len, 1]}, then: [{return: 22}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
