# static-check: off
# Spec 61 container audit: B7; target: correct content, 0 lost bytes, no memory errors.
- model: {name: Item, fields: [[text, string]]}
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [index, "map<string:Item>"]
            - decl: [item, Item]
            - set: [item.text, "payload=${42}"]
            - call: [index.put, "key", item]
            - if: {condition: {neq: [index.len, 1]}, then: [{return: 21}]}
            - decl: [view, ref<Item>, {call: [index.get, "key"]}]
            - if: {condition: {neq: [view.text, "payload=42"]}, then: [{return: 28}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
