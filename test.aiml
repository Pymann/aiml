- print: ["Testing System Calls..."]
- call: [io.write, io.stdout, "Hello from io.write!\n"]
- print: ["Sleeping for 500ms..."]
- call: [time.sleep_ms, 500]
- print: ["Done sleeping."]
- print: ["This should not be printed."]
- decl: [name, string]
- set: [name, "User"]
- decl: [age, i32]
- set: [age, 25]
- print: ["Hello ${name}, you are ${age}."]
- set: [age, { +: [age, 1] }]
- print: ["Next year you will be ${age}."]
- call: [sys.exit, 42]