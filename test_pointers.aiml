- decl: [x, i32, 10]
- print: ["Original X: ${x}"]

# Declare pointer
- decl: [p, ptr<i32>, { '&': [x] }]

# Dereference Read
- print: ["Value via pointer: ${ { '?': [p] } }"]

# Dereference Write (Store) is still store: [p, val] ?
# User only asked about ref/deref operators.
# store is a command.
- store: [p, 20]
# Dereference Write (Store)
- store: [p, 20]
- print: ["Modified X via pointer: ${x}"]

# Pointer to Pointer
- decl: [pp, ptr<ptr<i32>>, { '&': [p] }]
# Double Dereference (Syntax: '??' or '???')
- print: ["Value of X via PP (??): ${ { '??': [pp] } }"]

# Address of Address Check (&&)
# { '&&': [x] } creates a temporary pointer to pointer to x?
# No, &&[x] -> &(&x). &x is a value (address). &(&x) is address of that temporary value.
# Let's verify we can take address of address.
- decl: [pp_temp, ptr<ptr<i32>>, { '&&': [x] }]
- print: ["Value via pp_temp (should be x): ${ { '??': [pp_temp] } }"]

# Deep Store (Depth 2)
# Writes to *(*pp) which is x
# Depth 1 (default) is *pp. Depth 2 is **pp.
- store: [pp, 99, 2]
- print: ["Modified X via PP deep store: ${x}"]

# Pointer Arithmetic? (Maybe later)
# - set: [p, { +: [p, 1] }] 
