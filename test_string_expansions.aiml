- import: "lib.aiml"

- def:
    name: main
    args: [[argc, i32], [argv, ptr<ptr<string>>]]
    return: i32
    body:
      - decl: [name, string, "World"]
      - decl: [a, i32, 10]
      - decl: [b, i32, 20]
      
      # 1. Simple Variable Expansion
      - print: "Hello ${name}"

      # 2. Expression Expansion (Arithmetic)
      - print: "10 + 20 = ${ { +: [a, b] } }"
      
      # 3. Nested Expression (Function Call)
      - print: "Result from lib: ${ { call: [my.lib.add, a, b] } }"

      # 4. Implicit Type Conversion in Decl
      - decl: [res_str, string]
      - set: [res_str, "${ { +: [a, b] } }"]
      - print: "String variable holds: ${res_str}"
      
      # 5. Implicit Cast String -> Int (via ReturnCommand logic if applicable, or explicit atoi)
      # Note: set command might need explicit cast if target is int but source is string-expr.
      # But here we test printing mainly.
      
      - return: 0
