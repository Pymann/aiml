# Child program of tests/test_arg_dump_strict.aiml: prints what sys.arg_dump made of its
# command line.  Covers the alias (spec/15 F15-9) and the strict values of spec/23 F23-61.

- model:
    name: StrictOpts
    fields:
      - [ident, string, "", { alias: "id" }]
      - [depth, i32, -1]
      - [small, i8, 0]
      - [ratio, f32, 0.0]
      - [json, bool, false]
      - [mode_name, string, "dflt", { alias: "dry-run" }]
      - [big, u64, 0]
      - [ubyte, u8, 0]
      - [tiny, f64, 1.0]
      # the collector is found by its real name; this alias plays no part
      - [positional, list<string>, [], { alias: "rest" }]
      # F23-64: real names of the fields the command line set; never a flag itself
      - [given, list<string>, [], { alias: "seen" }]

- def:
    name: main
    return: i32
    body:
      - decl: [opts, StrictOpts]
      - call: [sys.arg_dump, opts]
      - decl: [ratio_x100, i32, { call: [math.round, { "*": [opts.ratio, 100.0] }] }]
      - decl: [json, i32, { cast: [opts.json, i32] }]
      - decl: [small, i32, { cast: [opts.small, i32] }]
      - decl: [words, list<string>, opts.positional]
      - decl: [rest, string, { call: [words.join, "|"] }]
      - print: ["ident=${opts.ident} depth=${opts.depth} small=${small} ratio=${ratio_x100} json=${json}"]
      - decl: [ubyte, i32, { cast: [opts.ubyte, i32] }]
      - decl: [tiny_zero, i32, 0]
      - if: [{ lt: [opts.tiny, 0.000001] }, true]
        then:
          - set: [tiny_zero, 1]
      # (print and "/" treat a u64 as signed, a separate issue; the test checks u64 by exit code)
      - print: ["mode=${opts.mode_name} ubyte=${ubyte} tiny_small=${tiny_zero}"]
      - print: ["positional=${rest}"]
      - decl: [given_list, list<string>, opts.given]
      - decl: [given_text, string, { call: [given_list.join, "|"] }]
      - print: ["given=${given_text}"]
      - return: 0
