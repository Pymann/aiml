# SPEC?: 14_enums,21_namespaces   # derived from the file name, to be confirmed
# Helper module (import-only, `_` prefix → skipped by the test runner).
# Defines an enum whose members are referenced ONLY in the entry — tests
# the whole-program merge (decl in the import, use in the entry).
- enum:
    name: Weekday
    values:
      - mon: 1       # used in the entry → no warning
      - tue: 2       # used nowhere → warning
      - wed: 3       # used nowhere → warning
