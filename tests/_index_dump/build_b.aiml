# Fixture: memory B, TEN other keys, same store name -- so that the
# file names match and B's WAL can be slipped under A's dump.
- decl: [var_kv, Kv<string:string>]
- set: [var_kv, { call: [db.open_kv, "idxswap", {persist: true, index_dump: true, path: "/tmp/aiml_idxswap/b/"}] }]
- call: [var_kv.clear]
- decl: [var_i, i32, 0]
- while:
    condition: { "<": [var_i, 10] }
    body:
      - call: [var_kv.set, "b${var_i}", "aus_b_${var_i}"]
      - set: [var_i, { +: [var_i, 1] }]
- decl: [rcc, i32, { call: [db.checkpoint] }]
- decl: [anz, i32, var_kv.len]
- print: ["b_len=${anz}"]
