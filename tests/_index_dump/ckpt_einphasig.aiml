# Counterpart to ckpt_phasen.aiml: the same 1.6 million keys, but only ONE
# checkpoint at the end.  Here the full key set in the overflow is unavoidable
# -- that is the reference value against which the phased peak is measured.
- decl: [var_kv, Kv<string:string>]
- set: [var_kv, { call: [db.open_kv, "einphasig", {persist: true, index_dump: true, path: "/tmp/aiml_ckpt_ein/"}] }]
- call: [var_kv.clear]
- decl: [var_i, i32, 0]
- while:
    condition: { "<": [var_i, 1600000] }
    body:
      - call: [var_kv.set, "schluessel_${var_i}", "wert_${var_i}"]
      - set: [var_i, { +: [var_i, 1] }]
- decl: [rcc, i32, { call: [db.checkpoint] }]
- decl: [anz, i32, { call: [var_kv.len] }]
- decl: [w_erst, string, { call: [var_kv.get, "schluessel_0"] }]
- decl: [w_letzt, string, { call: [var_kv.get, "schluessel_1599999"] }]
- call: [io.write, io.stdout, "len=${anz} erst=${w_erst} letzt=${w_letzt}\n"]
