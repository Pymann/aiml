# Fixture: vier Schreibphasen mit je einem checkpoint (spec/31 §6.2.1 "Nach dem
# Checkpoint gibt der Store den RAM-Index her").  Gibt der Store den Ueberlauf
# nach jedem checkpoint ab, bleibt die Spitze bei einer Phase; sonst waechst sie
# mit der Gesamtzahl.  Gegenstueck: ckpt_einphasig.aiml, dieselbe Gesamtzahl.
- decl: [var_kv, Kv<string:string>]
- set: [var_kv, { call: [db.open_kv, "phasen", {persist: true, index_dump: true, path: "/tmp/aiml_ckpt_phasen/"}] }]
- call: [var_kv.clear]
- decl: [phase, i32, 0]
- while:
    condition: { "<": [phase, 4] }
    body:
      - decl: [var_i, i32, { "*": [phase, 400000] }]
      - decl: [ende, i32, { +: [var_i, 400000] }]
      - while:
          condition: { "<": [var_i, ende] }
          body:
            - call: [var_kv.set, "schluessel_${var_i}", "wert_${var_i}"]
            - set: [var_i, { +: [var_i, 1] }]
      - decl: [rcc, i32, { call: [db.checkpoint] }]
      - set: [phase, { +: [phase, 1] }]
# Nach dem letzten checkpoint muss ALLES lesbar bleiben -- auch Phase 1.
- decl: [anz, i32, { call: [var_kv.len] }]
- decl: [w_erst, string, { call: [var_kv.get, "schluessel_0"] }]
- decl: [w_p2, string, { call: [var_kv.get, "schluessel_700000"] }]
- decl: [w_letzt, string, { call: [var_kv.get, "schluessel_1599999"] }]
- call: [io.write, io.stdout, "len=${anz} erst=${w_erst} p2=${w_p2} letzt=${w_letzt}\n"]
