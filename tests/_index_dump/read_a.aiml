# Fixture: reads memory A.  After slipping B's WAL underneath, A's dump must
# fail on the fingerprint and be fully replayed -- so B's content must
# appear, not A's and certainly no garbage.
- decl: [var_kv, Kv<string:string>]
- set: [var_kv, { call: [db.open_kv, "idxswap", {persist: true, index_dump: true, path: "/tmp/aiml_idxswap/a/"}] }]
- decl: [anz, i32, var_kv.len]
- decl: [hat_a0, i32, { call: [var_kv.has, "a0"] }]
- decl: [hat_b0, i32, { call: [var_kv.has, "b0"] }]
- decl: [wert_b7, string, { call: [var_kv.get, "b7"] }]
- print: ["len=${anz}"]
- print: ["has_a0=${hat_a0}"]
- print: ["has_b0=${hat_b0}"]
- print: ["b7=${wert_b7}"]
