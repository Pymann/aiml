# SPEC?: 15_models   # derived from the file name, to be confirmed
# static-check: off
# RED bis Paket 5 — doc/spec61_inline_value_model_release_plan_2026-09-24.md §1/§7.
# Contract (spec 61 §5.4): a value binding `decl copy = at(list,i)` (model) is an OWN inline
# copy whose string/container fields are retained. It MUST survive removal/realloc of the source slot with
# INTACT content — no shared view that after the remove shift points to another element
# (or garbage).
#
# Current state (is_view_alias): `copy` is a shared VIEW → after `remove(0)` (memmove shift)
# `copy` reads the element that moved up → wrong content (RED). Additionally a leak gate: 0 definitely+
# indirectly lost (elemKind-2 release is still deferred → currently a leak).
# Goal after package 5: PASS (exit 0) AND valgrind 0 lost.
- model: { name: Rec, fields: [[label, string], [tags, list<i32>]] }
- def:
    name: main
    return: i32
    body:
      - decl: [rows, list<Rec>]
      - decl: [src, Rec]
      - set: [src.label, "keep-me-intact"]
      - call: [src.tags.push, 42]
      - call: [rows.push, src]
      - decl: [src2, Rec]
      - set: [src2.label, "second-element"]
      - call: [src2.tags.push, 7]
      - call: [rows.push, src2]
      - decl: [copy, Rec, { at: [rows, 0] }]     # value binding: must be an independent copy
      - call: [rows.remove, 0]                     # shift: a shared view would now read rows[1]
      - if: { condition: { neq: [copy.label, "keep-me-intact"] }, then: [{ print: ["FAIL copy.label after remove: ${copy.label}"] }, { return: 1 }] }
      - decl: [tag0, i32, { at: [copy.tags, 0] }]
      - if: { condition: { neq: [tag0, 42] }, then: [{ print: ["FAIL copy.tags[0]: ${tag0}"] }, { return: 1 }] }
      - print: ["PASS 49 value_survives_remove"]
      - return: 0
