# SPEC?: 15_models   # aus dem Dateinamen, zu bestaetigen
# static-check: off
# RED bis Paket 3/5 — doc/spec61_inline_value_model_release_plan_2026-09-24.md §4/§9.1.
# Vertrag (Spec 61 §5.4): eine Value-Kopie TEILT ihre Container-Felder (retain = incref des Handles),
# hat aber UNABHÄNGIGE Scalar-/String-Felder.
#   copy.tags.push(x)  → im Quell-Element sichtbar (geteilter Container).
#   copy.label = "..."  → im Quell-Element NICHT sichtbar (unabhängiges Scalar/String-Feld).
# Wer den Slot selbst ändern will, bindet ref<Model>.
#
# Beobachteter Iststand (Codex §11, 2026-09-24): container-shared + scalar-independent ist bereits
# beobachtbar korrekt (chk.label bleibt "orig"). ABER `copy.label = "changed"` LEAKT 16 B
# (aiml_str_dup ← main): die Value-Kopie ist eine unbesessene View (kein scope-drop), der neu
# zugewiesene String wird nie freigegeben. Zweiter Leak-Pfad NEBEN dem Release-Leak. Kein
# "copy-on-write-at-set"-Beleg. Ziel nach dem Fix: chk.label=="orig" UND valgrind 0 lost.
- model: { name: Rec, fields: [[label, string], [tags, list<i32>]] }
- def:
    name: main
    return: i32
    body:
      - decl: [rows, list<Rec>]
      - decl: [src, Rec]
      - set: [src.label, "orig"]
      - call: [src.tags.push, 1]
      - call: [rows.push, src]
      - decl: [copy, Rec, { at: [rows, 0] }]
      - call: [copy.tags.push, 2]          # geteilter Container → in rows[0] sichtbar
      - set: [copy.label, "changed"]        # unabhängiges String-Feld → in rows[0] NICHT sichtbar
      - decl: [chk, Rec, { at: [rows, 0] }]
      - if: { condition: { neq: [chk.tags.len, 2] }, then: [{ print: ["FAIL geteilter Container nicht sichtbar: len=${chk.tags.len}"] }, { return: 1 }] }
      - if: { condition: { neq: [chk.label, "orig"] }, then: [{ print: ["FAIL Scalar schrieb durch: ${chk.label}"] }, { return: 1 }] }
      - print: ["PASS 50 share_semantics"]
      - return: 0
