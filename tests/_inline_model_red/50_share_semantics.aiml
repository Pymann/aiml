# SPEC?: 15_models   # derived from the file name, to be confirmed
# static-check: off
# RED bis Paket 3/5 — doc/spec61_inline_value_model_release_plan_2026-09-24.md §4/§9.1.
# Contract (spec 61 §5.4): a value copy SHARES its container fields (retain = incref of the handle),
# but has INDEPENDENT scalar/string fields.
#   copy.tags.push(x)  → im Quell-Element sichtbar (geteilter Container).
#   copy.label = "..."  → NOT visible in the source element (independent scalar/string field).
# Whoever wants to change the slot itself binds ref<Model>.
#
# Observed actual state (Codex §11, 2026-09-24): container-shared + scalar-independent is already
# observably correct (chk.label stays "orig"). BUT `copy.label = "changed"` LEAKS 16 B
# (aiml_str_dup ← main): the value copy is an unowned view (no scope drop), the newly
# assigned string is never freed. A second leak path NEXT TO the release leak. No
# evidence of "copy-on-write-at-set". Goal after the fix: chk.label=="orig" AND valgrind 0 lost.
- model: { name: Rec, fields: [[label, string], [tags, list<i32>]] }
- def:
    name: main
    return: i32
    body:
      - decl: [rows, list<Rec>]
      - decl: [src, Rec]
      - set: [src.label, "orig"]
      - call: [src.tags.push, 1]
      - call: [rows.push, src]
      - decl: [copy, Rec, { at: [rows, 0] }]
      - call: [copy.tags.push, 2]          # geteilter Container → in rows[0] sichtbar
      - set: [copy.label, "changed"]        # independent string field → NOT visible in rows[0]
      - decl: [chk, Rec, { at: [rows, 0] }]
      - if: { condition: { neq: [chk.tags.len, 2] }, then: [{ print: ["FAIL shared container not visible: len=${chk.tags.len}"] }, { return: 1 }] }
      - if: { condition: { neq: [chk.label, "orig"] }, then: [{ print: ["FAIL Scalar schrieb durch: ${chk.label}"] }, { return: 1 }] }
      - print: ["PASS 50 share_semantics"]
      - return: 0
