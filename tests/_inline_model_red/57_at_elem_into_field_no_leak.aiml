# static-check: off
# spec/61 §5.4/§7 regression: `set: [model.field, { at: [list<string>, i] }]` must NOT leak.
# BUG (found 2026-10-25 via the 9rooms starter deck set, probes in
# 9rooms_v2/leak_probes/starter_seed_20261025): the field store gated its borrow-read incref
# (322e0a0) on `!inStringTempStack(val)` — but `consumeStringTemp` had already removed the temp
# from the list right after evaluating the RHS, ~900 lines earlier. So the query always said
# "no temp". `{ at: [names, i] }` on a list<string> is BOTH: borrow read AND
# owned temp (visitAtExpr increfs the element and registers it) → a second reference that
# nobody frees: 1 string per assignment (~36 B here, 16 strings per 9rooms registration).
# FIX: `rhsWasOwnedStringTemp` fragen (direkt nach der Auswertung festgehalten) statt der
# emptied list. map.get/kv.get register no temp → their incref stays (322e0a0 intact).
#
# Covers the four sinks that 54_at_field_string_no_leak does NOT have: field store, field rebind,
# list in a model field (dotted receiver), and passing the model on by ref.
- model: { name: Row,    fields: [[nam, string], [kind, i32]] }
- model: { name: Holder, fields: [[names, list<string>]] }

- def:
    name: consume_row
    args: [[rowp, ref<Row>]]
    return: i32
    body:
      - decl: [cpy, Row, rowp]
      - return: cpy.nam.len

- def:
    name: fill_names
    args: [[dst, list<string>]]
    body:
      # literals are duplicated on push → real heap strings, rc=1 in the list.
      - call: [dst.push, "ember snare aaaaaaaaaaaaaaaaaa"]
      - call: [dst.push, "ash pit bbbbbbbbbbbbbbbbbbbbbb"]
      - call: [dst.push, "sudden blaze cccccccccccccccc"]

- def:
    name: main
    return: i32
    body:
      - decl: [tot, i32, 0]
      - decl: [reps, i32, 0]
      - while:
          condition: { lt: [reps, 200] }
          body:
            - decl: [names, list<string>]
            - call: [fill_names, names]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, names.len] }
                body:
                  # (a) at element directly into a model field (the leaking path)
                  - decl: [row, Row]
                  - set: [row.nam, { at: [names, idx] }]
                  - set: [row.kind, idx]
                  - set: [tot, { +: [tot, row.nam.len] }]
                  # (b) Modell per ref weitergeben, Callee kopiert es
                  - set: [tot, { +: [tot, { call: [consume_row, {'&': [row]}] }] }]
                  # (c) rebind the field → the old at value must be freed
                  - set: [row.nam, { at: [names, 0] }]
                  - set: [tot, { +: [tot, row.nam.len] }]
                  - set: [idx, { +: [idx, 1] }]
            # (d) the same sink, but the list lives in a model field
            - decl: [hld, Holder]
            - call: [fill_names, hld.names]
            - decl: [row2, Row]
            - set: [row2.nam, { at: [hld.names, 1] }]
            - set: [tot, { +: [tot, row2.nam.len] }]
            - set: [reps, { +: [reps, 1] }]
      - if:
          condition: { lt: [tot, 1] }
          then:
            - print: ["FAIL no read access counted"]
            - return: 1
      - print: ["PASS 57_at_elem_into_field tot=${tot}"]
      - return: 0
