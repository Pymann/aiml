# SPEC?: 52_arrays,15_models,61_memory_management   # derived from the file name, to be confirmed
# static-check: off
# RED — package 2 §9.6 (doc/spec61_inline_value_model_release_plan_2026-09-24.md): a heap ARRAY field
# (array<string:N>) in a model is mapped to RAWBYTES by serFieldSubtree (no array
# branch) → aiml_ser_retain/release do NOT see the string elements → leak (measured 6780 B/200 iter,
# no double free, a pure leak). Goal: map the array field as a STRUCT composition (N element subtrees with
# real stride) in the lifecycle descriptor, OR handle heap array fields in the copy/release paths
# mit gezielter Diagnose ablehnen — NICHT still als RAWBYTES-„sicher" behandeln.
# ⚠ RISK: serFieldSubtree changes serialisation descriptors → can change the schema fp/wire
# → KV incompatibility (like the matches KV FATALs). Hence consider a separate lifecycle descriptor,
# do NOT change the wire layout silently.
- model: { name: ArrRec, fields: [[names, array<string:3>], [label, string]] }
- def:
    name: fill_out
    args: [[out, ref<ArrRec>], [lst, list<ArrRec>]]
    body: [{ store: [out, { at: [lst, 0] }] }]
- def:
    name: main
    return: i32
    body:
      - decl: [itr, i32, 0]
      - while:
          condition: { lt: [itr, 200] }
          body:
            - decl: [rows, list<ArrRec>]
            - decl: [src, ArrRec]
            - set: [src.label, "lbl-${itr}"]
            - idx: [src.names, 0, "alpha-${itr}"]
            - idx: [src.names, 1, "beta-${itr}"]
            - call: [rows.push, src]
            - decl: [dst, ArrRec]
            - call: [fill_out, dst, rows]
            - set: [itr, { +: [itr, 1] }]
      - print: ["done arr"]
      - return: 0
