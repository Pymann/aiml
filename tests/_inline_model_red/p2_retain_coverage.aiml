# SPEC?: 15_models   # derived from the file name, to be confirmed
# static-check: off
# Package 2 (doc/spec61_inline_value_model_release_plan_2026-09-24.md §2/§3): audits the type
# coverage of `aiml_ser_retain` via the EXISTING `store: [ref<Model>, at(list,i)]` path
# (ast_compiler_stmt.cpp:4802 — release(dst) → memcpy(src) → retain). If the coverage is complete,
# dst and the list element co-own every heap field kind with a balanced rc → both drops free exactly
# once. If a field kind is missing in retain, a double free results (valgrind invalid free) OR a
# leak. Covers: string, list<i32>, nested value model (with its own string+list), map<string:i32>.
# Expectation: PASS + valgrind 0 lost + 0 errors (validates the §3 audit — should be GREEN).

- model: { name: Inner, fields: [[tag, string], [nums, list<i32>]] }
- model: { name: Rec, fields: [[label, string], [tags, list<i32>], [mana, map<string:i32>], [inner, Inner]] }

- def:
    name: fill_out
    args: [[out, ref<Rec>], [lst, list<Rec>]]
    body:
      - store: [out, { at: [lst, 0] }]   # VALUE-share via retain (§7)

- def:
    name: main
    return: i32
    body:
      - decl: [reps, i32, 0]
      - decl: [itr, i32, 0]
      - while:
          condition: { lt: [itr, 200] }
          body:
            - decl: [rows, list<Rec>]
            - decl: [src, Rec]
            - set: [src.label, "hello-retain-${itr}"]
            - call: [src.tags.push, 1]
            - call: [src.tags.push, 2]
            - call: [src.mana.put, "fire", 3]
            - set: [src.inner.tag, "inner-tag-${itr}"]
            - call: [src.inner.nums.push, 9]
            - call: [rows.push, src]
            - decl: [dst, Rec]
            - call: [fill_out, dst, rows]        # dst shared-owns rows[0] (retain)
            - if: { condition: { neq: [dst.label, "hello-retain-${itr}"] }, then: [{ print: ["FAIL dst.label: ${dst.label}"] }, { return: 1 }] }
            - if: { condition: { neq: [dst.inner.tag, "inner-tag-${itr}"] }, then: [{ print: ["FAIL dst.inner.tag: ${dst.inner.tag}"] }, { return: 1 }] }
            - set: [reps, { +: [reps, 1] }]
            - set: [itr, { +: [itr, 1] }]
      - print: ["PASS p2_retain_coverage reps=${reps}"]
      - return: 0
