# SPEC: 61_memory_management
- class:
    name: Node
    members: [[val, i32, 0]]
- class:
    name: Holder
    members:
      - [kept, ref<Node>]   # spec/61 §6.2: weak back-edge — storing a borrow here is sanctioned
    methods:
      - def:
          name: hold
          args: [[node, ptr<Node>]]
          body:
            - set: [<.kept, node]   # ref<T> member → weak store, no borrow-escape (does not own/free)
- def:
    name: main
    return: i32
    body:
      - decl: [hld, ptr<Holder>, { new: Holder }]
      - decl: [node2, ptr<Node>, { new: Node }]
      - call: [hld.hold, node2]
      - print: ["PASS borrow_escape_warn (ref<Node> weak back-edge — memory-safe)"]
      - return: 0
