# SPEC: 61_memory_management_DRAFT
# spec/61 (T1c): an interpolation/owned string temp built inside an if/while CONDITION must be freed
# on every path — including a branch that terminates (return/break) before visitStatement's
# per-statement temp-decref. Regression for CardArtCache.fetch `if has_texture("@art:${hsh}") return 1`
# which leaked the concat every cache-hit frame. Native RSS-delta.

- class:
    name: Svc
    members: [[dummy, i32]]
    methods:
      # borrow sink returning i32 (stands in for gl.has_texture / cache.contains)
      - def:
          name: probe_key
          static_off: ["same_arg"]
          args: [[key, string]]
          return: i32
          body:
            - if: { condition: { gt: [key.len, 0] }, then: [{ return: 1 }] }
            - return: 0

      # if-CONDITION builds an interpolation temp; the then-branch RETURNS (common path) → temp must
      # still be freed.
      - def:
          name: hit_path
          static_off: ["same_arg"]
          args: [[num, i32]]
          return: i32
          body:
            - if:
                condition: { eq: [{ call: [<.probe_key, "@art:${num}-payloadpayloadpayload"] }, 1] }
                then: [{ return: 1 }]
            - return: 0

      - def:
          name: loop
          static_off: ["same_arg"]
          args: [[iters, i32]]
          return: i64
          body:
            - decl: [before, i64, { call: [sys.mem_usage] }]
            - decl: [idx, i32, 0]
            - decl: [sink, i32, 0]
            - while:
                condition: { lt: [idx, iters] }
                body:
                  - set: [sink, { +: [sink, { call: [<.hit_path, idx] }] }]
                  - set: [idx, { +: [idx, 1] }]
            - return: { -: [{ call: [sys.mem_usage] }, before] }

- def:
    name: main
    return: i32
    body:
      - decl: [reps, i32, 400000]
      - decl: [limit, i64, 16777216]   # 16 MB (clean ~0; leak was ~20 MB at N=400k)
      - decl: [svc, ptr<Svc>, { new: Svc }]
      - decl: [warm, i64, { call: [svc.loop, 2000] }]
      - decl: [grow_b, i64, { call: [svc.loop, reps] }]
      - call: [log.info, "cond_interp_temp_drop: if-cond-interp on terminating branch=${grow_b} B  (limit=${limit} B, N=${reps})"]
      - if:
          condition: { gt: [grow_b, limit] }
          then:
            - call: [log.info, "FAIL cond_interp_temp_drop: if-condition interpolation temp leaked on the returning branch (${grow_b} B > ${limit} B)"]
            - return: 1
      - call: [log.info, "PASS cond_interp_temp_drop: if/while condition interpolation temps freed on all paths (bounded RSS)"]
      - return: 0
