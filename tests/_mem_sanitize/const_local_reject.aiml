# Finding #7: assigning to a { const: true } local must be REJECTED at compile time
# (the local->local model deep-copy path must honor const, not silently deep-copy).
- model: { name: Holder, fields: [[label, string]] }
- def:
    name: main
    return: i32
    body:
      - decl: [src, Holder]
      - decl: [dst, Holder, null, { const: true }]
      - set: [dst, src]
      - return: 0
