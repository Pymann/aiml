# SPEC: 61_memory_management
# spec/61 §3.1: `consumed` on an INTERFACE-overriding method param must be REJECTED — vtable
# dispatch cannot apply caller-move yet (would double-free). Expect a compile error.
- interface:
    name: Keeper
    methods:
      - [absorb, void, [[txt, string]]]

- class:
    name: KBag
    implements: [Keeper]
    members:
      - [items, list<string>]
    methods:
      - def:
          name: absorb
          args: [[txt, string, { lifetime: consumed }]]
          body:
            - call: [<.items.push, txt]

- def:
    name: main
    return: i32
    body:
      - return: 0
