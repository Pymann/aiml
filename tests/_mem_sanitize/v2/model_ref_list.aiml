- model:
    name: Thing
    fields:
      - [tag, string]
      - [count, i32]

- def:
    name: main
    return: i32
    body:
      - decl: [items, list<Thing>]
      - decl: [thing1, Thing, {new: Thing}]
      - set: [thing1.tag, "aaa"]
      - set: [thing1.count, 10]
      - call: [items.push, thing1]
      - decl: [thing2, Thing, {new: Thing}]
      - set: [thing2.tag, "bbb"]
      - set: [thing2.count, 20]
      - call: [items.push, thing2]
      - if: {condition: {neq: [items.len, 2]}, then: [{print: ["FAIL len=${items.len}"]}, {call: [sys.exit, 1]}]}
      - decl: [got, Thing, {call: [items.get, 0]}]
      - if: {condition: {neq: [got.tag, "aaa"]}, then: [{print: ["FAIL got.tag=${got.tag}"]}, {call: [sys.exit, 1]}]}
      - if: {condition: {neq: [got.count, 10]}, then: [{print: ["FAIL got.count=${got.count}"]}, {call: [sys.exit, 1]}]}
      - set: [got.count, 99]
      - decl: [again, Thing, {call: [items.get, 0]}]
      - if: {condition: {neq: [again.count, 99]}, then: [{print: ["FAIL reference-semantics: again.count=${again.count} (expected 99)"]}, {call: [sys.exit, 1]}]}
      - print: ["PASS list<Model>: push/get + reference-semantics mutation (again.count=${again.count})"]
      - return: 0
