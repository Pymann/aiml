- model:
    name: Thing
    fields:
      - [tag, string]
      - [count, i32]

- def:
    name: main
    return: i32
    body:
      - decl: [byname, map<string:Thing>]
      - decl: [thing1, Thing, {new: Thing}]
      - set: [thing1.count, 33]
      - call: [byname.put, "alpha", thing1]
      - decl: [got, Thing, {call: [byname.get, "alpha"]}]
      - if: {condition: {neq: [got.count, 33]}, then: [{print: ["FAIL got.count=${got.count}"]}, {call: [sys.exit, 1]}]}
      - set: [got.count, 44]
      - decl: [again, Thing, {call: [byname.get, "alpha"]}]
      - if: {condition: {neq: [again.count, 44]}, then: [{print: ["FAIL reference: again.count=${again.count}"]}, {call: [sys.exit, 1]}]}
      - print: ["PASS map<K:Model>: put/get + reference-semantics (again.count=${again.count})"]
      - return: 0
