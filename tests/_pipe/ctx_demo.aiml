# Not a test file, but the SOURCE for tests/test_ctx_pipeline.aiml:
# this is what a submitted pipeline looks like (cosmos doc/spec/96) — it names
# the distributed keys and is NOT run locally, but read
# (spec/62 §20).
- pipeline:
    name: ctx_demo
    agent: x86_64
    image: ubuntu-base
    timeout: 30000
    params:
      - [mode, string, [debug, release]]
    steps:
      - stage:
          name: bauen
          run: "make -j4"
      - stage:
          name: pruefen
          agent: arm64
          run: "ctest"
