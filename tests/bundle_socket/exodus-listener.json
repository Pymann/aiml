{
  "$schema": "exodus.project.config-1.0",
  "name": "bs_listener",
  "version": "0.0.1",
  "output_type": "executable",
  "sources": ["tests/bundle_socket/listener.aiml"],
  "compiler": { "name": "out/aiml/aiml", "lang_standard": "17", "flags": [] },
  "linker": {
    "name": "g++",
    "flags": ["-Wl,-rpath,out/libaiml"],
    "libraries": ["aiml", "pthread", "ssl", "crypto", "dl"],
    "library_paths": ["out/libaiml"]
  },
  "artifact_in_cwd": true, "optimization": "0", "debug": false, "warnings": [], "jobs": 8
}
