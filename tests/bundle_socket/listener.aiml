# SPEC: 29_2_sys_exec,29_serialize
# Live test (spec/29_2 §12/§13), receiver side — AOT, no JIT.
# Requires: peer — started in pairs by tests/bundle_socket/run.sh
#
# Two passes:
#   1. A bundle: source text -> code -> sys.exec in the isolated context.
#   2. Library + pipeline received SEPARATELY, merged here with Code.merge
#      and executed in ONE run — that is the only
#      way to make a library available, because an isolated context
#      keeps nothing between two sys.exec calls.
# Expected exit code: 0

- def:
    name: recv_text
    args: [[conn, socket_handle]]
    return: { type: string, lifetime: producer }
    body:
      - decl: [txt, string, { call: [net.recv_string, conn, 65536] }]
      - return: txt

- def:
    name: reply
    args: [[conn, socket_handle], [rcx, i32]]
    body:
      - if:
          condition: { eq: [rcx, 0] }
          then: [{ call: [net.send_string, conn, "ok"] }]
          else: [{ call: [net.send_string, conn, "fail"] }]

- def:
    name: main
    return: i32
    body:
      - decl: [server, socket_handle, { call: [net.socket, "tcp"] }]
      - call: [net.bind, server, "127.0.0.1", 47811]
      - call: [net.listen, server]
      - print: ["listener bereit"]
      - decl: [fails, i32, 0]

      # ── Pass 1: a single bundle ─────────────────────────────────────────
      - decl: [conn_one, socket_handle, { call: [net.accept, server] }]
      - decl: [wire1, string, { call: [recv_text, conn_one] }]
      - print: ["1) empfangen: ${wire1.len} Bytes"]
      - decl: [job_one, Code, { call: [sys.code_from, wire1, { start: "remote_task", context: true }] }]
      - decl: [rc_one, i32, { call: [sys.exec, job_one] }]
      - print: ["1) sys.exec rc=${rc_one}"]
      - if: { condition: { neq: [rc_one, 0] }, then: [{ set: [fails, { +: [fails, 1] }] }] }
      - call: [reply, conn_one, rc_one]
      - call: [net.close, conn_one]

      # ── Pass 2: library + pipeline separately, merged here ──────────────
      - decl: [conn_two, socket_handle, { call: [net.accept, server] }]
      - decl: [lib_wire, string, { call: [recv_text, conn_two] }]
      - print: ["2) library: ${lib_wire.len} bytes"]
      - decl: [pipe_wire, string, { call: [recv_text, conn_two] }]
      - print: ["2) pipeline: ${pipe_wire.len} bytes"]

      - decl: [lib_pkg, Code, { call: [sys.code_from, lib_wire, { context: true }] }]
      - decl: [pipe_pkg, Code, { call: [sys.code_from, pipe_wire, { start: "run_pipeline", context: true }] }]
      # Order matters: start_call inherits from the FIRST operand.
      - decl: [job_two, Code, { call: [pipe_pkg.merge, lib_pkg] }]
      - decl: [rc_two, i32, { call: [sys.exec, job_two] }]
      - print: ["2) sys.exec rc=${rc_two}"]
      - if: { condition: { neq: [rc_two, 0] }, then: [{ set: [fails, { +: [fails, 1] }] }] }
      - call: [reply, conn_two, rc_two]
      - call: [net.close, conn_two]

      - call: [net.close, server]
      - if: { condition: { neq: [fails, 0] }, then: [{ print: ["listener FAIL (${fails})"] }, { return: 1 }] }
      - print: ["listener PASS"]
      - return: 0
