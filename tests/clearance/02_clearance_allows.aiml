# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: host
# TIER: T1
# CONSTRUCT: spec/65 F65-4 — die Ordnung, am echten Wirt.  Der Wirt bietet `read_status` auf
#            Level 7 und `say_hello` auf Level 255 an; das Skript laeuft in einer Sitzung mit
#            Freigabe 7 und erreicht beide.  Die Freigabe kommt am `sys.exec` (F65-36), die
#            Level aus der Export-Tabelle (F65-23) — nicht aus der Skriptquelle, das waere
#            Selbstbeglaubigung (F65-27).
# COVERS: `session_clearance <= symbol_level`; Gleichheit ist Zugriff; das offene Ende (255).
#         Die Gegenprobe zur unteren Schranke ist neg/n19 (Level 2 bei Freigabe 7).
# EXPECT: exit 0.

- def:
    name: read_status
    level: 7
    return: i32
    body:
      - return: [3]

- def:
    name: say_hello
    level: 255
    return: i32
    body:
      - return: [4]

# Laeuft im BUENDEL, also in der eingeschraenkten Sitzung mit Freigabe 7.
- def:
    name: user_script
    return: i32
    body:
      - decl: [sta, i32, { call: [read_status] }]
      - decl: [hey, i32, { call: [say_hello] }]
      - if:
          condition: { neq: [{ +: [sta, hey] }, 7] }
          then:
            - call: [log.error, "Summe ${sta}+${hey} falsch"]
            - return: [1]
      - return: [0]

- def:
    name: main
    return: i32
    body:
      - decl: [fp_status, fn<:i32>]
      - set: [fp_status, read_status]
      - call: [sys.export_symbol, "read_status", fp_status, 7]

      - decl: [fp_hello, fn<:i32>]
      - set: [fp_hello, say_hello]
      - call: [sys.export_symbol, "say_hello", fp_hello, 255]

      - decl: [pkg, Code, { call: [sys.bundle, "user_script", { context: true }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7] }]
      - if:
          condition: { neq: [rcx, 0] }
          then:
            - call: [log.error, "Buendel lieferte ${rcx}, erwartet 0"]
            - return: [1]
      - call: [log.info, "PASS 02 Freigabe 7 erreicht Level 7 und 255"]
      - return: [0]
