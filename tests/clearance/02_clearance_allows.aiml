# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: host
# TIER: T1
# CONSTRUCT: spec/65 F65-4 — the ordering, on a real host.  The host offers `read_status` at
#            level 7 and `say_hello` at level 255; the script runs in a session with
#            clearance 7 and reaches both.  The clearance comes with `sys.exec` (F65-36), the
#            levels from the export table (F65-23) — not from the script source, that would be
#            self-certification (F65-27).
# COVERS: `session_clearance <= symbol_level`; equality is access; the open end (255).
#         The counter-probe for the lower bound is neg/n19 (level 2 with clearance 7).
# EXPECT: exit 0.

- def:
    name: read_status
    level: 7
    return: i32
    body:
      - return: [3]

- def:
    name: say_hello
    level: 255
    return: i32
    body:
      - return: [4]

# Runs in the BUNDLE, i.e. in the restricted session with clearance 7.
- def:
    name: user_script
    return: i32
    body:
      - decl: [sta, i32, { call: [read_status] }]
      - decl: [hey, i32, { call: [say_hello] }]
      - if:
          condition: { neq: [{ +: [sta, hey] }, 7] }
          then:
            - call: [log.error, "Summe ${sta}+${hey} falsch"]
            - return: [1]
      - return: [0]

- def:
    name: main
    return: i32
    body:
      - decl: [fp_status, fn<:i32>]
      - set: [fp_status, read_status]
      - call: [sys.export_symbol, "read_status", fp_status, 7]

      - decl: [fp_hello, fn<:i32>]
      - set: [fp_hello, say_hello]
      - call: [sys.export_symbol, "say_hello", fp_hello, 255]

      - decl: [pkg, Code, { call: [sys.bundle, "user_script", { context: true }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7] }]
      - if:
          condition: { neq: [rcx, 0] }
          then:
            - call: [log.error, "bundle returned ${rcx}, expected 0"]
            - return: [1]
      - call: [log.info, "PASS 02 clearance 7 reaches level 7 and 255"]
      - return: [0]
