# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: host
# TIER: T1
# STATIC-CLEARANCE: on
# CONSTRUCT: spec/65 F65-10 — the deliberate gateway, on a real host.  `restart_agent` is
#            callable for an operator (level 7) and states in ONE place that internally it
#            does level-2 work.  The flow check is ON here, so the probe also proves
#            that `grants:` actually relaxes the edge rule F65-9.
# COVERS: `grants:` allows a lower edge only WITHIN the body; callers are
#         checked against `level:`, not against `grants:`.  `kill_process` is NOT exported
#         — the bundle carries only the declaration of `restart_agent` (F65-38), the inner
#         edge stays with the host.  That is the point of the gateway: one checkable place.
# EXPECT: exit 0.

- def:
    name: kill_process
    level: 2
    return: i32
    body:
      - return: [11]

- def:
    name: restart_agent
    level: 7
    grants: 2
    return: i32
    body:
      - return: [{ call: [kill_process] }]

# Runs in the BUNDLE with clearance 7: reaches the gateway, never `kill_process`.
- def:
    name: user_script
    return: i32
    body:
      - decl: [res, i32, { call: [restart_agent] }]
      - if:
          condition: { neq: [res, 11] }
          then:
            - call: [log.error, "restart_agent returned ${res}, expected 11"]
            - return: [1]
      - return: [0]

- def:
    name: main
    return: i32
    body:
      # Only the gateway is offered.  `kill_process` stays outside the table and is
      # therefore unreachable for every session, regardless of its clearance.
      - decl: [fp_restart, fn<:i32>]
      - set: [fp_restart, restart_agent]
      - call: [sys.export_symbol, "restart_agent", fp_restart, 7]

      - decl: [pkg, Code, { call: [sys.bundle, "user_script", { context: true }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7] }]
      - if:
          condition: { neq: [rcx, 0] }
          then:
            - call: [log.error, "bundle returned ${rcx}, expected 0"]
            - return: [1]
      - call: [log.info, "PASS 03 grants gateway on the host"]
      - return: [0]
