# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: host
# TIER: T1
# CONSTRUCT: spec/65 F65-7 — „keine Freigabe" und „die hoechstprivilegierte Freigabe" sind
#            VERSCHIEDENE Zustaende.  Freigabe 1 ist die Admin-Konsole: sie erreicht jedes
#            ANNOTIERTE Level, hier Level 1 und Level 255 am echten Wirt.
# COVERS: die Erreichbarkeits-Haelfte.  Die anderen beiden Haelften sind neg/n12 (der
#         fallengelassene Dialekt gilt auch bei Freigabe 1) und neg/n14 (Level 0 erreicht
#         niemand, auch der Admin nicht).  Drei Proben, eine Anforderung — eine muss
#         uebersetzen, die beiden anderen nicht.
# EXPECT: exit 0.

- def:
    name: deep_work
    level: 1
    return: i32
    body:
      - return: [5]

- def:
    name: say_hello
    level: 255
    return: i32
    body:
      - return: [6]

# Laeuft im BUENDEL mit Freigabe 1 — der Admin-Sitzung.
- def:
    name: user_script
    return: i32
    body:
      - decl: [low, i32, { call: [deep_work] }]
      - decl: [hey, i32, { call: [say_hello] }]
      - if:
          condition: { neq: [{ +: [low, hey] }, 11] }
          then:
            - call: [log.error, "Summe ${low}+${hey} falsch"]
            - return: [1]
      - return: [0]

- def:
    name: main
    return: i32
    body:
      - decl: [fp_deep, fn<:i32>]
      - set: [fp_deep, deep_work]
      - call: [sys.export_symbol, "deep_work", fp_deep, 1]

      - decl: [fp_hello, fn<:i32>]
      - set: [fp_hello, say_hello]
      - call: [sys.export_symbol, "say_hello", fp_hello, 255]

      - decl: [pkg, Code, { call: [sys.bundle, "user_script", { context: true }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 1] }]
      - if:
          condition: { neq: [rcx, 0] }
          then:
            - call: [log.error, "Buendel lieferte ${rcx}, erwartet 0"]
            - return: [1]
      - call: [log.info, "PASS 05 Freigabe 1 erreicht Level 1 und 255"]
      - return: [0]
