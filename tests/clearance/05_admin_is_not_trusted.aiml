# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: host
# TIER: T1
# CONSTRUCT: spec/65 F65-7 — "no clearance" and "the most privileged clearance" are
#            DIFFERENT states.  Clearance 1 is the admin console: it reaches every
#            ANNOTATED level, here level 1 and level 255 on a real host.
# COVERS: the reachability half.  The other two halves are neg/n12 (the
#         dropped dialect also applies with clearance 1) and neg/n14 (level 0 is reached by
#         nobody, not even the admin).  Three probes, one requirement — one must
#         compile, the other two must not.
# EXPECT: exit 0.

- def:
    name: deep_work
    level: 1
    return: i32
    body:
      - return: [5]

- def:
    name: say_hello
    level: 255
    return: i32
    body:
      - return: [6]

# Runs in the BUNDLE with clearance 1 — the admin session.
- def:
    name: user_script
    return: i32
    body:
      - decl: [low, i32, { call: [deep_work] }]
      - decl: [hey, i32, { call: [say_hello] }]
      - if:
          condition: { neq: [{ +: [low, hey] }, 11] }
          then:
            - call: [log.error, "sum ${low}+${hey} wrong"]
            - return: [1]
      - return: [0]

- def:
    name: main
    return: i32
    body:
      - decl: [fp_deep, fn<:i32>]
      - set: [fp_deep, deep_work]
      - call: [sys.export_symbol, "deep_work", fp_deep, 1]

      - decl: [fp_hello, fn<:i32>]
      - set: [fp_hello, say_hello]
      - call: [sys.export_symbol, "say_hello", fp_hello, 255]

      - decl: [pkg, Code, { call: [sys.bundle, "user_script", { context: true }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 1] }]
      - if:
          condition: { neq: [rcx, 0] }
          then:
            - call: [log.error, "bundle returned ${rcx}, expected 0"]
            - return: [1]
      - call: [log.info, "PASS 05 clearance 1 reaches level 1 and 255"]
      - return: [0]
