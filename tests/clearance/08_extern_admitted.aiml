# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: exports
# TIER: T1
# CLEARANCE: 7
# EXPORTS: tests/clearance/host_exports.txt
# CONSTRUCT: spec/65 F65-13 — the flip side of neg/n05.  The host offers `aiml_str_dup`
#            at level 7, the session has clearance 7: the `extern` declaration is
#            therefore ADMITTED.  Without the table every one was rejected; with it the
#            level decides, and that is the difference between "fail closed" and "closed".
# EXPECT: exit 0.
- extern: "C"
  defs:
    - def:
        name: aiml_str_dup
        args: [[src, string]]
        return: string
- def:
    name: main
    return: i32
    body:
      - call: [log.info, "PASS 08 extern admitted from the export table"]
      - return: [0]
