# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: host
# TIER: T1
# CONSTRUCT: spec/65 §5c (F65-36/37/38) — a HOST in one file.  It defines its own `def`s
#            with a level, registers them with an address and runs a bundle in a
#            restricted session against them.  That is the fixture the three
#            old `host` probes (02/03/05) were missing — and that a cosmos console needs.
# COVERS: `sys.export_symbol` (address + name + level in ONE call, F65-37);
#         clearance on the bundle instead of in the environment (F65-36);
#         an exported symbol is bundled DECLARED, not copied as a body (F65-38)
#         — otherwise the access check would have nothing to act on;
#         `read_status` (level 7) is reachable with clearance 7, `wipe_queue` (level 2) is not.
# EXPECT: exit 0.

- def:
    name: read_status
    level: 7
    return: i32
    body:
      - return: [3]

- def:
    name: wipe_queue
    level: 2
    return: i32
    body:
      - return: [9]

# Runs in the BUNDLE, i.e. in the restricted session with clearance 7.
- def:
    name: user_script
    return: i32
    body:
      - decl: [sta, i32, { call: [read_status] }]
      - if:
          condition: { neq: [sta, 3] }
          then:
            - return: [1]
      - return: [0]

- def:
    name: main
    return: i32
    body:
      # Both halves of the handover in one call: address from the function pointer
      # to the host's own `def` (spec/12_1), name and level into the export table.
      - decl: [fp_status, fn<:i32>]
      - set: [fp_status, read_status]
      - call: [sys.export_symbol, "read_status", fp_status, 7]

      # `wipe_queue` is DELIBERATELY offered at level 2: reachable only for clearance <= 2.
      - decl: [fp_wipe, fn<:i32>]
      - set: [fp_wipe, wipe_queue]
      - call: [sys.export_symbol, "wipe_queue", fp_wipe, 2]

      - decl: [pkg, Code, { call: [sys.bundle, "user_script", { context: true }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7] }]
      - if:
          condition: { neq: [rcx, 0] }
          then:
            - call: [log.error, "bundle returned ${rcx}, expected 0"]
            - return: [1]
      - call: [log.info, "PASS 09 host offers callable symbols"]
      - return: [0]
