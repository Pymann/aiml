# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: step2
# TIER: T1
# CLEARANCE: none
# CONSTRUCT: spec/65 F65-37 — `sys.export_symbol(name, fn, level)`.  Checks the call itself,
#            without a restricted session: valid -> 0, invalid level -> -1.
# COVERS: address from a function pointer to the host's own `def` (spec/12_1); return value
#         as the observable effect (a read query on the table does not exist yet,
#         F65-32 allows it, it is not built);
#         a level outside 0..255 is rejected instead of silently clamped.
# EXPECT: exit 0.

- def:
    name: read_status
    level: 7
    return: i32
    body:
      - return: [3]

- def:
    name: main
    return: i32
    body:
      - decl: [fp_status, fn<:i32>]
      - set: [fp_status, read_status]

      - decl: [ok_rc, i32, { call: [sys.export_symbol, "read_status", fp_status, 7] }]
      - if:
          condition: { neq: [ok_rc, 0] }
          then:
            - call: [log.error, "valid export returned ${ok_rc}, expected 0"]
            - return: [1]

      - decl: [bad_rc, i32, { call: [sys.export_symbol, "zu_hoch", fp_status, 300] }]
      - if:
          condition: { neq: [bad_rc, -1] }
          then:
            - call: [log.error, "level 300 returned ${bad_rc}, expected -1"]
            - return: [1]

      - call: [log.info, "PASS 10 sys.export_symbol"]
      - return: [0]
