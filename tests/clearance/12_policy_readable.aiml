# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: write
# TIER: T1
# CLEARANCE: 7
# CREATE-LEVEL: 7
# REPLACE-LEVEL: 3
# CONSTRUCT: spec/65 F65-32 — the policy is READABLE, never writable.  Reading is harmless and
#            useful: only that way can a script give a usable error message instead of
#            failing on a compiler diagnostic.  Levels are not secret anyway
#            (F65-16).
# COVERS: `clearance.level`, `clearance.create_level`, `clearance.replace_level` in a
#         restricted session.  Here the policy comes from the environment (F65-20) —
#         that is the case in which the HOST sets it for the whole process.
#         The counterpart is neg/n24: a SETTER does not exist and is rejected.
# EXPECT: exit 0.

- def:
    name: main
    return: i32
    body:
      - decl: [clr, i32, { call: [clearance.level] }]
      - decl: [crt, i32, { call: [clearance.create_level] }]
      - decl: [rpl, i32, { call: [clearance.replace_level] }]
      - if:
          condition: { neq: [clr, 7] }
          then:
            - call: [log.error, "clearance.level = ${clr}, expected 7"]
            - return: [1]
      - if:
          condition: { neq: [crt, 7] }
          then:
            - call: [log.error, "clearance.create_level = ${crt}, expected 7"]
            - return: [1]
      - if:
          condition: { neq: [rpl, 3] }
          then:
            - call: [log.error, "clearance.replace_level = ${rpl}, expected 3"]
            - return: [1]
      - call: [log.info, "PASS 12 policy readable"]
      - return: [0]
