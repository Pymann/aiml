# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: writedown
# TIER: T1
# STATIC-CLEARANCE: on
# CONSTRUCT: spec/65 F65-34 — the permitted direction.  A value of level 2 may flow into a local
#            at level 2 (equal) and into one at level 0 (stricter).  Only storing
#            into a LESS restricted local is forbidden.
# COVERS: equality is allowed; downwards (stricter) is allowed; a local without
#         annotation and without restricted origin carries NO level, so a literal
#         into an annotated local is no violation — a rule that breaks every program
#         protects nothing.
# EXPECT: exit 0.

- def:
    name: read_secret
    level: 2
    return: i32
    body:
      - return: [42]

- def:
    name: main
    return: i32
    body:
      # gleiches Level: erlaubt
      - decl: [same, i32, 0, { level: 2 }]
      - set: [same, { call: [read_secret] }]
      # strenger: erlaubt
      - decl: [tighter, i32, 0, { level: 0 }]
      - set: [tighter, { call: [read_secret] }]
      # literal into an annotated local: no restricted origin, no violation
      - decl: [open_num, i32, 7, { level: 255 }]
      - if:
          condition: { neq: [{ +: [same, tighter] }, 84] }
          then:
            - call: [log.error, "Summe falsch: ${same}+${tighter}"]
            - return: [1]
      - call: [log.info, "PASS 13 Write-down: erlaubte Richtungen ${open_num}"]
      - return: [0]
