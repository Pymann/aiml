# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: host
# TIER: T1
# CLEARANCE: 7
# EXPORTS: tests/clearance/host_exports.txt
# PRELOAD: tests/clearance/fixtures/libclearance_host.so
# CONSTRUCT: spec/65 F65-24, the SECOND route to the address — and the only one that works for a
#            console.  Probe 09 has the host register its own `def`s via
#            `sys.export_symbol`; that presupposes that the host already had the code when
#            COMPILING.  A host that has foreign source text compiled
#            IS the compiler and only knows the script at runtime.  There the
#            address comes from a preloaded library and the level from the table.
# COVERS: an admitted `extern` is also CALLABLE — probe 08 only declares and never
#         calls, so it covers half the requirement.  Here the value is checked (42).
#         The counterpart is neg/n28: the same library, the same existing symbol,
#         but offered at level 2 → rejected.  Together the two show that
#         admission depends on the TABLE and not on whether the symbol can be found.
# EXPECT: exit 0.
- extern: "C"
  defs:
    - def:
        name: clearance_host_answer
        args: []
        return: i32

- def:
    name: main
    return: i32
    body:
      - decl: [ans, i32, { call: [clearance_host_answer] }]
      - if:
          condition: { neq: [ans, 42] }
          then:
            - call: [log.error, "host function returned ${ans}, expected 42"]
            - return: [1]
      - call: [log.info, "PASS 14 preloaded host symbol callable"]
      - return: [0]
