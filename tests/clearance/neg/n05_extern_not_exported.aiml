# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: guard
# CLEARANCE: 7
# NEGATIVE (spec/65 F65-13): `extern` bypasses EVERY symbol table of the compiler by
# design — the script names the signature itself, and the JIT resolves the name against the
# process (`LoadLibraryPermanently(nullptr)`).  A restricted session may
# therefore only declare names that the host has explicitly offered.
# The export table (§5a) does not exist yet, so the permissible set is EMPTY.
# EXPECT-ERROR: clearance-extern
- extern: "C"
  defs:
    - def:
        name: aiml_db_kv_set
        args: [[hnd, i64], [key, string], [val, string]]
        return: i32
- def:
    name: main
    return: i32
    body:
      - return: [0]
