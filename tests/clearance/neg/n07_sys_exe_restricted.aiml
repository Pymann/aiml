# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: guard
# CLEARANCE: 7
# NEGATIVE (spec/65 F65-12 pt.2, F65-35): builtins are closed from the ground up.  A shell is a
# complete bypass in one line, so it is out of reach as long as the host does not
# open it explicitly.
# EXPECT-ERROR: clearance-builtin
- def:
    name: main
    return: i32
    body:
      - decl: [argv, list<string>, ["id"]]
      - decl: [proc, process, { call: [sys.exe, argv] }]
      - return: [0]
