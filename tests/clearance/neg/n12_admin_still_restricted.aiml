# EXPECT-ERROR: clearance-dialect
- def:
    name: main
    return: i32
    body:
      - decl: [adr, i64, 140737488355328]
      - decl: [peek, ptr<i32>, { cast: [adr, ptr<i32>] }]
      - return: [0]
