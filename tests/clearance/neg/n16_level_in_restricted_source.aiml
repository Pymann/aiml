# SPEC: 65_symbol_clearance
# static-check: off
# Requires: driver
# NEEDS: session
# CLEARANCE: 7
# CREATE-LEVEL: 7
# NEGATIVE (spec/65 F65-27, F65-6): a created symbol's level IS the session's clearance. Writing
# `level:` in the source of a restricted session is self-certification — the script would be
# handing itself a policy that belongs to the host.
# EXPECT-ERROR: clearance-self-certify
- def:
    name: my_helper
    level: 2                                 # ← policy is not the newcomer's to write
    return: i32
    body:
      - return: [4]
- def:
    name: main
    return: i32
    body:
      - return: [{ call: [my_helper] }]
