# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: host
# NEGATIVE (spec/65 F65-4 am echten Wirt): dieselbe Vorrichtung wie 09, aber das Skript ruft
# `wipe_queue`, das der Wirt auf Level 2 anbietet.  Die Sitzung hat Freigabe 7 — also verweigert.
#
# Diese Probe ist der Grund, warum 6b vor der Zugriffspruefung noetig war: ein Symbol „auf
# Level 2, das ich nicht erreichen darf" MUSS vom Wirt kommen.  Schreibt es das Skript selbst,
# ist es Selbstbeglaubigung (F65-27) und die Pruefung richtet sich gegen nichts.
# EXPECT-ERROR: clearance-denied
- def:
    name: wipe_queue
    level: 2
    return: i32
    body:
      - return: [9]

- def:
    name: user_script
    return: i32
    body:
      - return: [{ call: [wipe_queue] }]

- def:
    name: main
    return: i32
    body:
      - decl: [fp_wipe, fn<:i32>]
      - set: [fp_wipe, wipe_queue]
      - call: [sys.export_symbol, "wipe_queue", fp_wipe, 2]
      - decl: [pkg, Code, { call: [sys.bundle, "user_script", { context: true }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7] }]
      # Der Fehlschlag des Buendels ist das ERGEBNIS dieser Probe — weitergeben,
      # sonst meldet der Wirt Erfolg, obwohl die Sitzung abgelehnt wurde.
      - return: [rcx]
