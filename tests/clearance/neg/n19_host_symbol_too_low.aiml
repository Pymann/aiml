# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: host
# NEGATIVE (spec/65 F65-4 on a real host): the same fixture as 09, but the script calls
# `wipe_queue`, which the host offers at level 2.  The session has clearance 7 — so denied.
#
# This probe is the reason why 6b was needed before the access check: a symbol "at
# level 2 that I may not reach" MUST come from the host.  If the script writes it itself,
# it is self-certification (F65-27) and the check is aimed at nothing.
# EXPECT-ERROR: clearance-denied
- def:
    name: wipe_queue
    level: 2
    return: i32
    body:
      - return: [9]

- def:
    name: user_script
    return: i32
    body:
      - return: [{ call: [wipe_queue] }]

- def:
    name: main
    return: i32
    body:
      - decl: [fp_wipe, fn<:i32>]
      - set: [fp_wipe, wipe_queue]
      - call: [sys.export_symbol, "wipe_queue", fp_wipe, 2]
      - decl: [pkg, Code, { call: [sys.bundle, "user_script", { context: true }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7] }]
      # The bundle's failure is the RESULT of this probe — pass it on,
      # otherwise the host reports success although the session was rejected.
      - return: [rcx]
