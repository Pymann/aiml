# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: write
# NEGATIVE (spec/65 F65-28): the chapter's shortest escalation.  The bundle delivers a
# body for `wipe_queue` — a name the host ALREADY HAS — into the SHARED context.
# The policy grants `create_level` 7, but `replace_level` stays 0: REPLACING is something
# other than CREATING, and the more dangerous one, because every later caller in the host
# runs the new body with the HOST's rights.
#
# That `create_level` is granted here is the point: the two rights are separate, and
# one does not grant the other.  If only one existed, this probe could not be built.
# EXPECT-ERROR: clearance-replace
- def:
    name: wipe_queue
    return: i32
    body:
      - return: [0]

- def:
    name: main
    return: i32
    body:
      - decl: [pkg, Code, { call: [sys.bundle, "wipe_queue", { context: false }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7, 7, 0] }]
      - return: [rcx]
