# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: write
# NEGATIVE (spec/65 F65-30): the silent pitfall from spec/29_2 §4.2.  Here `replace_level` is
# GRANTED (policy 7, 7, 7), so the permission is not the issue — the version is:
# with an equal or lower version today's logic would silently SKIP the incoming
# definition.  The script would then get the HOST's `wipe_queue` without
# noticing: a surprise in correctness before it is one in security.
#
# At a trust boundary shadowing is nothing that may happen silently — so it is an error.
# EXPECT-ERROR: clearance-collision
- def:
    name: wipe_queue
    return: i32
    body:
      - return: [0]

- def:
    name: main
    return: i32
    body:
      - decl: [pkg, Code, { call: [sys.bundle, "wipe_queue", { context: false }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7, 7, 7] }]
      - return: [rcx]
