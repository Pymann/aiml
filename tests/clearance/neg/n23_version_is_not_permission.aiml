# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: write
# NEGATIVE (spec/65 F65-29): a `version:` in incoming code is INPUT, not permission.
# The number is written by whoever wrote the bundle — at a trust boundary it
# may therefore permit nothing.  `version: 99` looks like a hot reload per spec/29_2 §4.2;
# without `replace_level` it is still none, and the order of the checks is the whole
# content of this requirement: FIRST the permission, THEN the version decides whether
# anything changes at all.
# EXPECT-ERROR: clearance-replace
- def:
    name: wipe_queue
    version: 99
    return: i32
    body:
      - return: [0]

- def:
    name: main
    return: i32
    body:
      - decl: [pkg, Code, { call: [sys.bundle, "wipe_queue", { context: false }] }]
      - decl: [rcx, i32, { call: [sys.exec, pkg, 7] }]
      - return: [rcx]
