# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: writedown
# STATIC-CLEARANCE: on
# NEGATIVE (spec/65 F65-34): the chapter's example.  `read_secret` is at level 2,
# `open_log` is declared at level 255 — so readable for everyone.  Without this rule a
# restricted value is laundered in ONE assignment: read it where one may, store it
# where anyone may.
# EXPECT-ERROR: clearance-writedown
- def:
    name: read_secret
    level: 2
    return: i32
    body:
      - return: [42]

- def:
    name: main
    return: i32
    body:
      - decl: [open_log, i32, 0, { level: 255 }]
      - set: [open_log, { call: [read_secret] }]
      - return: [0]
