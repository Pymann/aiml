# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: writedown
# STATIC-CLEARANCE: on
# NEGATIVE (spec/65 F65-34): the most obvious bypass, and therefore the more important probe.
# `tmp` carries no annotation — if a local without `level:` forgets the origin, the
# rule is bypassed with one intermediate step: `tmp = read_secret()` and then `open_log = tmp`.
#
# That is why a local has TWO meanings: `level:` is the barrier for storing, and
# what it CARRIES is the strictest thing that ever flowed in — and that travels on.
# EXPECT-ERROR: clearance-writedown
- def:
    name: read_secret
    level: 2
    return: i32
    body:
      - return: [42]

- def:
    name: main
    return: i32
    body:
      - decl: [tmp, i32, { call: [read_secret] }]
      - decl: [open_log, i32, 0, { level: 255 }]
      - set: [open_log, tmp]
      - return: [0]
