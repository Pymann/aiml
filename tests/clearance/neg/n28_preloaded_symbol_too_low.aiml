# SPEC: 65_symbol_clearance
# Requires: driver
# static-check: off
# NEEDS: host
# CLEARANCE: 7
# EXPORTS: tests/clearance/host_exports.txt
# PRELOAD: tests/clearance/fixtures/libclearance_host.so
# NEGATIVE (spec/65 F65-13/F65-4): the symbol `clearance_host_secret` is PRESENT in the
# process — the same preloaded library, the same address, findable.  But it is offered
# at level 2, and the session has clearance 7.
#
# That is why this probe is more important than it looks: it shows that admission depends on the
# TABLE and not on findability.  Had a host determined its offer only by
# "what is in the process", every library it needs for itself would
# automatically be the offer to every user.
# EXPECT-ERROR: clearance-denied
- extern: "C"
  defs:
    - def:
        name: clearance_host_secret
        args: []
        return: i32

- def:
    name: main
    return: i32
    body:
      - return: [{ call: [clearance_host_secret] }]
