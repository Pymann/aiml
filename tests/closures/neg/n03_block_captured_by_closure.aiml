# SPEC: 64_closures
# static-check: off
# Requires: driver
# NEGATIVE (spec/64 §3.2, §4.3, §9): a closure outlives its frame, so it may not capture a
# block — the block is a borrowed view of that very frame.
# EXPECT-ERROR: closure-borrowed-capture
- callable: { name: Each, args: [[v, i32]] }
- callable: { name: Bump }
- def:
    name: main
    return: i32
    body:
      - decl: [sum, i32, 0]
      - decl:
          - tally
          - block<Each>
          - block:
              body:
                - set: [sum, { +: [sum, v] }]
      - decl:
          - keeper
          - closure<Bump>
          - closure:
              capture: [tally]                  # ← a block may not be captured
              body:
                - call: [tally, 1]
      - return: 0
