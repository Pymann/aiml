# SPEC: 64_closures
# static-check: off
# Requires: driver
# NEGATIVE (spec/64 §3.3, §9): `break` inside a block body cannot target a loop outside the
# block. Non-local exit from a passed body is out of scope; use throw/catch.
# EXPECT-ERROR: block-nonlocal-control
- callable: { name: Each, args: [[v, i32]] }
- def:
    name: each
    args: [[xs, list<i32>], [body, block<Each>]]
    body:
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, xs.len] }
          body:
            - call: [body, { at: [xs, idx] }]
            - set: [idx, { +: [idx, 1] }]
- def:
    name: main
    return: i32
    body:
      - decl: [nums, list<i32>]
      - call: [nums.push, 1]
      - decl: [outer, i32, 0]
      - while:
          condition: { lt: [outer, 3] }
          body:
            - call:
                - each
                - nums
                - block:
                    body:
                      - break: []               # ← targets main's while, across the block
            - set: [outer, { +: [outer, 1] }]
      - return: 0
