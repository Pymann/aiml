# SPEC: 61_memory_management_DRAFT,64_closures
# static-check: off
# Requires: driver
# NEGATIVE (spec/64 §6 + spec/61 §10): a by-value closure parameter is a move-in sink; the
# caller's closure is moved-out. (For "hand a body to a function" use block<Sig> instead.)
# EXPECT-ERROR: use-after-move
- callable: { name: Read, return: i32 }
- def:
    name: sink
    args: [[cb, closure<Read>, { lifetime: consumed }]]
    return: i32
    body:
      - return: { call: [cb] }
- def:
    name: main
    return: i32
    body:
      - decl: [c, closure<Read>, { closure: { capture: [[n, i32, 4]], body: [ { return: n } ] } }]
      - decl: [first, i32, { call: [sink, c] }]    # c is moved into the sink
      - decl: [second, i32, { call: [c] }]         # ← use-after-move of `c`
      - return: 0
