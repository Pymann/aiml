# spec/71 §8: retired name -> compile error naming the replacement.
- class:
    name: Row
    members:
      - [rid, i32]

- def:
    name: main
    return: i32
    body:
      - decl: [str, Store<Row>, { call: [db.open, "r"] }]
      - decl: [row, Row]
      - call: [str.insert, row]
      - return: 0
