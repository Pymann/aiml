# Requires: driver
# spec/71 §8: retired name -> compile error naming the replacement.
- class:
    name: Row
    members:
      - [rid, i32]

- def:
    name: main
    return: i32
    body:
      - decl: [tns, TimeSeries<Row>, { call: [db.open_timeseries, "t"] }]
      - decl: [row, ref<Row>, { call: [tns.at, 1] }]
      - return: 0
