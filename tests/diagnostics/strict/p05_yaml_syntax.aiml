# SPEC: 49_static_analysis
# Requires: driver
# EXPECT: YAML parse error
# NO-RULE: ein Syntaxfehler setzt keine Regel durch, er stellt fest, dass die Form gebrochen ist.
# NO-NAME: er nennt auch kein Symbol -- es gibt an dieser Stelle keines.
#
# Falsche Einrueckung: der haeufigste echte YAML-Fehler, und seine Marke trifft
# die verursachende Zeile (anders als eine unbeendete Zeichenkette, die erst am
# Dateiende auffaellt -- dort waere die gemeldete Zeile die ERKENNUNGSstelle).
- def:
    name: main
    return: i32
   body:                            # <<HERE
      - return: 0
