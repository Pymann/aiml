# SPEC: 49_static_analysis
# Requires: driver
# EXPECT: YAML parse error
# NO-RULE: a syntax error enforces no rule, it establishes that the form is broken.
# NO-NAME: it names no symbol either -- there is none at this point.
#
# Wrong indentation: the most common real YAML error, and its mark hits
# the causing line (unlike an unterminated string, which only shows up at the
# end of the file -- there the reported line would be the DETECTION point).
- def:
    name: main
    return: i32
   body:                            # <<HERE
      - return: 0
