# Requires: driver
# EXPECT-ERROR: non-empty list default
# spec/15 F15-40: for a `list<T>` field `[]` is the only default; a
# filled default is a compile error.  The check existed only for
# `- model:`/`fields:`, not for `- class:`/`members:` — there the
# default was silently discarded and the field was empty at runtime.
- class:
    name: Probe
    members:
      - [liste, list<string>, ["eins", "zwei"], { access: public }]
    methods:
      - def:
          name: lauf
          args: []
          return: i32
          body:
            - return: <.liste.len
