# Requires: driver
# EXPECT-ERROR: non-empty list default
# A NESTED list as a default is filled as well and therefore an error.
- class:
    name: Probe
    members:
      - [listen, list<string>, [["eins"], ["zwei"]], { access: public }]
    methods:
      - def:
          name: lauf
          args: []
          return: i32
          body:
            - return: <.listen.len
