# Requires: driver
# EXPECT-ERROR: non-empty list default
# Counterpart for `- model:`/`fields:` — this path was already right, the
# test records it.
- model:
    name: Probe
    fields:
      - [liste, list<string>, ["eins", "zwei"]]

- def:
    name: main
    return: i32
    body:
      - decl: [prb, Probe]
      - return: prb.liste.len
