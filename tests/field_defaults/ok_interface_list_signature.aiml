# Requires: driver
# Edge case of the list default check: an INTERFACE signature has exactly
# the same form as a member with a default — `- [name, type, third]`, where
# the third element is a non-empty list and the second entry can be a
# container type:
#
#     - [spur_fuer, list<i32>, [[programm, string], [wert, i64]]]
#
# But here the third element is the ARGUMENT LIST, not a default.  A
# check that only looks at the form instead of at `members:`/`fields:` fires
# wrongly here and breaks every interface with a container return type.
#
# Real location: cai src/kern/graph/graph_dienst.aiml:20 (partner session
# exodus-b9).  Green there — this test records it, so that a later
# rework of the check does not break it silently.
- interface:
    name: Spurgeber
    methods:
      - [oeffne,    i32,       [[wissen, string]]]
      - [spur_fuer, list<i32>, [[programm, string], [wert, i64]]]

- class:
    name: Spurwerk
    implements: [Spurgeber]
    members:
      - [anzahl, i32, 0, { access: public }]
      - [spuren, list<i32>, [], { access: public }]
    methods:
      - def:
          name: oeffne
          args: [[wissen, string]]
          return: i32
          body:
            - set: [<.anzahl, wissen.len]
            - return: <.anzahl
      - def:
          name: spur_fuer
          args: [[programm, string], [wert, i64]]
          return: list<i32>
          body:
            - call: [<.spuren.push, programm.len]
            - return: <.spuren

- def:
    name: main
    return: i32
    body:
      - decl: [fehler, i32, 0]
      - decl: [werk, Spurwerk]

      - decl: [auf, i32, { call: [werk.oeffne, "abcd"] }]
      - if:
          condition: { neq: [auf, 4] }
          then:
            - print: ["FAIL oeffne returned ${auf}"]
            - set: [fehler, { +: [fehler, 1] }]

      - call: [werk.spur_fuer, "xyz", 7]
      - if:
          condition: { neq: [werk.spuren.len, 1] }
          then:
            - print: ["FAIL spuren.len=${werk.spuren.len}"]
            - set: [fehler, { +: [fehler, 1] }]

      - if:
          condition: { eq: [fehler, 0] }
          then: [{ print: ["PASS ok_interface_list_signature"] }]
      - return: fehler
