# Requires: library
# 9Rooms — Ability Text Lookup Helpers

- def:
    name: mana_color_name
    args: [[var_id, i32]]
    return: string
    body:
      - if: [{ eq: [var_id, 1] }, true]
        then:
          - return: "Fire"
      - if: [{ eq: [var_id, 2] }, true]
        then:
          - return: "Light"
      - if: [{ eq: [var_id, 3] }, true]
        then:
          - return: "Shadow"
      - if: [{ eq: [var_id, 4] }, true]
        then:
          - return: "Forest"
      - if: [{ eq: [var_id, 5] }, true]
        then:
          - return: "Earth"
      - if: [{ eq: [var_id, 6] }, true]
        then:
          - return: "Frost"
      - if: [{ eq: [var_id, 7] }, true]
        then:
          - return: "Air"
      - if: [{ eq: [var_id, 8] }, true]
        then:
          - return: "Stars"
      - if: [{ eq: [var_id, 9] }, true]
        then:
          - return: "Water"
      - if: [{ eq: [var_id, 10] }, true]
        then:
          - return: "Mana"
      - return: "Mana"

- def:
    name: card_type_name
    args: [[var_id, i32]]
    return: string
    body:
      - if: [{ eq: [var_id, 0] }, true]
        then:
          - return: "Card"
      - if: [{ eq: [var_id, 1] }, true]
        then:
          - return: "Creature"
      - if: [{ eq: [var_id, 2] }, true]
        then:
          - return: "Spell"
      - if: [{ eq: [var_id, 3] }, true]
        then:
          - return: "Mana"
      - if: [{ eq: [var_id, 4] }, true]
        then:
          - return: "Item"
      - if: [{ eq: [var_id, 5] }, true]
        then:
          - return: "Fate"
      - if: [{ eq: [var_id, 6] }, true]
        then:
          - return: "Primordial"
      - if: [{ eq: [var_id, 7] }, true]
        then:
          - return: "Trap"
      - return: "Card"

- def:
    name: deck_type_name
    args: [[var_id, i32]]
    return: string
    body:
      - if: [{ eq: [var_id, 1] }, true]
        then:
          - return: "Mana deck"
      - if: [{ eq: [var_id, 2] }, true]
        then:
          - return: "Spell deck"
      - if: [{ eq: [var_id, 3] }, true]
        then:
          - return: "Creature deck"
      - if: [{ eq: [var_id, 4] }, true]
        then:
          - return: "Item deck"
      - if: [{ eq: [var_id, 5] }, true]
        then:
          - return: "Primordial deck"
      - return: "Deck ${var_id}"

- def:
    name: zone_name
    args: [[var_id, i32]]
