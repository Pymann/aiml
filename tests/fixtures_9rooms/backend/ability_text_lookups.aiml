      - if: [{ eq: [var_id, 24] }, true]
        then:
          - return: "dream zone"
      - if: [{ eq: [var_id, 30] }, true]
        then:
          - return: "soulmage room"
      - if: [{ eq: [var_id, 31] }, true]
        then:
          - return: "combat zone 1"
      - if: [{ eq: [var_id, 32] }, true]
        then:
          - return: "combat zone 2"
      - if: [{ eq: [var_id, 33] }, true]
