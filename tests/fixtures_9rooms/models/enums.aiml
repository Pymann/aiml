# SPEC?: 14_enums,15_models   # derived from the file name, to be confirmed
# Requires: library
# 9Rooms — Enums (ported from ccg_gemini/card_api/schemas.py)

- enum:
    name: ManaColor
    values:
      - fire: 1
      - light: 2
      - shadow: 3
      - forest: 4
      - earth: 5
      - frost: 6
      - air: 7
      - stars: 8
      - water: 9
      - amorphous: 10

- enum:
    name: CardType
    values:
      - any: 0
      - creature: 1
      - spell: 2
      - mana_card: 3
      - item: 4
      - fate: 5
      - primordial: 6
      - trap: 7

- enum:
    name: RoomEffect
    values:
      - none: 0
      - flooded: 1
      - inflamed: 2
      - plague: 3
      - thunderstorm: 4
      - iced: 5
      - drought: 6

- enum:
    name: SpellType
    values:
      - sorcery: 2
      - ceremony: 3
      - enchantment: 4
      - incantation: 5

- enum:
    name: GamePhase
    values:
      - start_phase: 1
      - draw_phase: 2
      - mana_phase: 3
      - spell_phase: 4
      - combat_phase: 5
      - end_phase: 6

- enum:
    name: GameZone
    values:
      - hand: 1
      - graveyard: 2
      - deck_mana: 10
      - deck_spell: 11
      - deck_creature: 12
      - deck_item: 13
      - deck_fate: 14
      - deck_primordial: 15
      - mana_zone: 20
      - magic_zone: 21
      - trap_zone: 22
