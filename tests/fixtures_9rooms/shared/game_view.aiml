# Requires: library
# 9Rooms — GameView model (mirror sync)
# Shared between server (host) and client (replica).
# Server writes fields → mirror auto-syncs → client reads fields.

- import: "tests/fixtures_9rooms/models/models.aiml"   # Card (HandCardView inherits)
- import: "tests/fixtures_9rooms/shared/event_view.aiml"

# ══════════════════════════════════════════════════════════════════════════════
# HandCardView — one card in the player's hand
# Inherits all card fields from Card (incl. mana_cost, attack, defense, ...).
# iid = instance ID (unique per card in the hand; cid = card definition ID).
# ══════════════════════════════════════════════════════════════════════════════

- model:
    name: HandCardView
    inherits: Card
    fields:
      - [iid,          string]   # instance ID — unique identifier per hand card
      - [ability_text, string]   # precomputed text: passive + active abilities

# ══════════════════════════════════════════════════════════════════════════════
# RuntimeEffectView — an active effect slot of a creature
# ══════════════════════════════════════════════════════════════════════════════

- model:
    name: RuntimeEffectView
    fields:
      - [code,      i32,    0]   # effect code (200=frozen, 201=shield, 40=regen, ...)
      - [key,       string, ""]  # readable name ("frozen", "shield", "regen", ...)
      - [dur_type,  i32,    1]   # 1=PERMANENT, 2=TURNS, 3=NEXT_TURN_PHASE, 4=END_OF_PHASE
      - [dur_val,   i32,    0]   # remaining duration (rounds, phase ID, ...)
      - [src_iid,   string, ""]  # IID of the source ("" if none)

# ══════════════════════════════════════════════════════════════════════════════
# CreatureView — being/primal being on the battlefield (effective stats, live HP)
# ══════════════════════════════════════════════════════════════════════════════

- model:
    name: CreatureView
    fields:
      - [iid,    string]   # instance ID (unique, e.g. "ABC-123")
      - [cid,    string]   # Card-Definition-ID (z.B. "fire-dragon")
      - [name,   string]
      - [room,   i32]     # room 1..5
      - [var_hp,     i32]     # current HP
      - [lp_max, i32]     # maximum HP (base)
      - [atk,    i32]     # effective attack
      - [def,    i32]     # effective defense
      - [ini,    i32]     # effective initiative
      - [mor,    i32]     # current morale
      - [mor_max, i32]    # maximum morale (base)
      - [mov,    i32]     # current movement points
      - [mov_max, i32]    # maximum movement points (base)
      - [tapped,         i32]     # 1 = tapped (sprint 3)
      - [equip_cid_0,    string]  # item CID equipped to slot 0
      - [equip_cid_1,    string]  # item CID equipped to slot 1
      - [equip_cid_2,    string]  # item CID equipped to slot 2
      - [ability_text,   string]  # precomputed text: passive + active abilities
      - [mana_cost,      map<string:i32>]  # original card cost (hover preview)
      - [provides,       map<string:i32>]  # mostly empty (preview uniformity)
      - [card_type,      i32]     # CardType enum (1=creature, 6=primal being) — appended at the end
      - [spell_type,     i32]     # SpellType (0 for non-spells)
      - [passives,       map<string:i32>]  # active status effects: "frozen"=1, "shield"=1, "swimming"=1, etc.
      - [effect_count,   i32,    0]       # number of active fx slots (dirty detection)
      - [effects,        list<RuntimeEffectView>]  # runtime effects (for the UI)

# movement state lookup: state int as string ("1"-"4") → passives map key
- decl: [g_mov_state_names, map<string:string>]
- def:
    name: init_mov_state_names
    body:
      - call: [g_mov_state_names.put, "1", "swimming"]
      - call: [g_mov_state_names.put, "2", "flying"]
      - call: [g_mov_state_names.put, "3", "diving"]
      - call: [g_mov_state_names.put, "4", "subterranean"]

# ══════════════════════════════════════════════════════════════════════════════
# ZoneCardView — card in a non-combat zone (mana, trap, spell) or item in a combat zone
# face_down=1: the opponent only sees the card back (traps)
# ══════════════════════════════════════════════════════════════════════════════

- model:
    name: ZoneCardView
    fields:
      - [cid,       string]
      - [name,      string]   # "" if face_down=1 and opponent
      - [card_type, i32]      # 3=mana, 7=trap, 2=spell, 4=item, 5=fate
      - [zone,      string]   # "mana_zone"|"trap_zone"|"spell_zone"|"room_1".."room_5"
      - [face_down, i32]      # 1 = face down
      - [ability_text, string] # preview text (only if not face_down)
      - [mana_cost,   map<string:i32>]  # hover preview
      - [provides,    map<string:i32>]  # mana cards: produced mana
      - [spell_type,  i32]      # SpellType (0 for non-spells) — appended at the end
      - [initiative,  i32]      # initiative (items with equip_cost==0)
      - [equip_cost,  i32]      # equip cost (items)
      - [mkp,         i32]      # mana class points
      - [equipped_to_iid, string]  # IID of the creature that carries this item ("" = not equipped)

# ══════════════════════════════════════════════════════════════════════════════
# ManaPool — 10 mana colours per player
# FEUER=0, LICHT=1, SCHATTEN=2, WALD=3, ERDE=4,
# FROST=5, LUFT=6, STERNE=7, WASSER=8, AMORPH=9
# ══════════════════════════════════════════════════════════════════════════════

- model:
    name: ManaPool
    fields:
      - [feuer,    i32]
      - [licht,    i32]
      - [schatten, i32]
      - [wald,     i32]
      - [erde,     i32]
      - [frost,    i32]
      - [luft,     i32]
      - [sterne,   i32]
      - [wasser,   i32]
      - [amorph,   i32]

# ══════════════════════════════════════════════════════════════════════════════
# DeckCountsView — own remaining deck cards
# ══════════════════════════════════════════════════════════════════════════════

- model:
    name: DeckCountsView
    fields:
      - [creature, i32, 0]
      - [spell,    i32, 0]
      - [mana,     i32, 0]
      - [item,     i32, 0]
      - [trap,     i32, 0]
      - [urwesen,  i32, 0]

# ══════════════════════════════════════════════════════════════════════════════
# PlayerView — bundled visible player data
# ══════════════════════════════════════════════════════════════════════════════

- model:
    name: PlayerView
    fields:
      - [name,           string, ""]
      - [var_hp,             i32, 100]
      - [hand_count,     i32, 0]
      - [hand_cards,     list<HandCardView>]
      - [mana,           ManaPool]
      - [decks,          DeckCountsView]
      - [phase_confirm,  i32, 0]
      - [creature_count, i32, 0]
      - [creatures,      list<CreatureView>]
      - [zone_count,     i32, 0]
      - [zone_cards,     list<ZoneCardView>]
      - [field_item_count, i32, 0]
      - [field_items,      list<ZoneCardView>]

# ══════════════════════════════════════════════════════════════════════════════
# GameView model — all client-visible states
# ══════════════════════════════════════════════════════════════════════════════

- model:
    name: GameView
    fields:
      # Spiel-Meta
      - [round,          i32, 0]
      - [phase,          i32, 0]
      - [active,         i32, 0]
      - [over,           i32, 0]
      - [winner,         i32, -1]
      - [my_turn,        i32, 0]
      - [combat_attacker, string, ""]
      - [var_me,             PlayerView]
      - [opp,            PlayerView]
      # trap window (sprint 5): 1 = counter window open, trap_window_ms = remaining time
      - [trap_window,    i32, 0]
      - [trap_window_ms, i32, 0]
      # Event history — latest events (max. 5, ring buffer, sprint_event_1)
      - [event_seq,   i32, 0]
      - [event_count, i32, 0]
      - [events,      list<GameEventView>]
      # active triggers — trigger instances with full context (sprint_task_2)
      - [trigger_seq_counter,    i32, 0]
      - [active_trigger_count,   i32, 0]
      - [active_triggers,        list<TriggerEventView>]
      # reaction window — currently open counter window (sprint_task_3)
      - [reaction_state,         ReactionStateView]
      - [reactable_triggers,     list<TriggerEventView>]   # last 3 counterable triggers
      # Interaction state — open while a targeting action is active
      # mode: ""|"attack_target"|"spell_target"|"trap_target"|"equip_target"|"move_target"
      - [interaction_mode,        string, ""]
      - [interaction_source_iid,  string, ""]   # IID/CID of the source card
      - [interaction_source_zone, string, ""]   # zone of the source
      - [interaction_owner,       i32,    -1]   # 0=player 1, 1=player 2, -1=none
      - [interaction_prompt,      string, ""]   # display text for the client
      - [interaction_target_mask, string, ""]   # allowed targets (encoded string)
      - [interaction_cancelable,  i32,    1]    # 1 = cancelling allowed
    sync: [round, phase, active, over, winner, my_turn, combat_attacker,
           var_me, opp,
           trap_window, trap_window_ms,
           event_seq, event_count, events,
           trigger_seq_counter, active_trigger_count, active_triggers,
           reaction_state, reactable_triggers,
           interaction_mode, interaction_source_iid, interaction_source_zone,
           interaction_owner, interaction_prompt, interaction_target_mask,
           interaction_cancelable]

# ══════════════════════════════════════════════════════════════════════════════
# Hand accessor — 1-based slot index, returns ptr<HandCardView> or null
# ══════════════════════════════════════════════════════════════════════════════

- def:
    name: view_get_hand_card
    args: [[var_v, ptr<GameView>], [var_n, i32]]
    return: ptr<HandCardView>
    body:
      - if:
          condition: { "||": [{ "<": [var_n, 1] }, { ">": [var_n, var_v.var_me.hand_count] }] }
          then:
            - return: [null]
      - return: [{ call: [var_v.var_me.hand_cards.get, { -: [var_n, 1] }] }]

# ══════════════════════════════════════════════════════════════════════════════
# Creature accessor — 0-based index, side=0→p1, side=1→p2
# Returns ptr<CreatureView> or null
# ══════════════════════════════════════════════════════════════════════════════

- def:
    name: view_get_zone_card
    args: [[var_v, ptr<GameView>], [var_n, i32]]
    return: ptr<ZoneCardView>
    body:
      - if:
          condition: { "||": [{ "<": [var_n, 0] }, { ">=": [var_n, var_v.var_me.zone_count] }] }
          then:
            - return: [null]
      - return: [{ call: [var_v.var_me.zone_cards.get, var_n] }]

- def:
    name: view_get_creature
    args: [[var_v, ptr<GameView>], [side, i32], [var_n, i32]]
    return: ptr<CreatureView>
    body:
      - if:
          condition: { eq: [side, 0] }
          then:
            - if:
                condition: { "||": [{ "<": [var_n, 0] }, { ">=": [var_n, var_v.var_me.creature_count] }] }
                then:
                  - return: [null]
            - return: [{ call: [var_v.var_me.creatures.get, var_n] }]
          else:
            - if:
                condition: { "||": [{ "<": [var_n, 0] }, { ">=": [var_n, var_v.opp.creature_count] }] }
                then:
                  - return: [null]
            - return: [{ call: [var_v.opp.creatures.get, var_n] }]

# ══════════════════════════════════════════════════════════════════════════════
# Interaction helpers — Host-Seite
# ══════════════════════════════════════════════════════════════════════════════

# Resets all interaction fields (targeting window closed).
- def:
    name: view_reset_interaction
    args: [[var_v, ptr<GameView>]]
    body:
      - set: [var_v.interaction_mode, ""]
      - set: [var_v.interaction_source_iid, ""]
      - set: [var_v.interaction_source_zone, ""]
      - set: [var_v.interaction_owner, -1]
      - set: [var_v.interaction_prompt, ""]
      - set: [var_v.interaction_target_mask, ""]
      - set: [var_v.interaction_cancelable, 1]

# Opens a targeting window with complete parameters.
- def:
    name: view_set_interaction
    static_off: ["args"]
    args: [[var_v, ptr<GameView>], [mode, string], [src_iid, string], [src_zone, string],
           [owner, i32], [prompt, string], [mask, string], [cancelable, i32]]
    body:
      - set: [var_v.interaction_mode, mode]
      - set: [var_v.interaction_source_iid, src_iid]
      - set: [var_v.interaction_source_zone, src_zone]
      - set: [var_v.interaction_owner, owner]
      - set: [var_v.interaction_prompt, prompt]
      - set: [var_v.interaction_target_mask, mask]
      - set: [var_v.interaction_cancelable, cancelable]
