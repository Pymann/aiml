# Requires: driver
# Imports the library via "../" — resolved from app/ this becomes ../lib/sub/../shared.aiml.
- namespace: nrm.user
- import: "../shared.aiml"

- class:
    name: User
    members:
      - [counter, ptr<nrm.shared.Counter>, null, { access: public }]
    methods:
      - def:
          name: read
          args: []
          return: i32
          body:
            - set: [<.counter, { new: nrm.shared.Counter }]
            - return: { call: [<.counter.value] }
