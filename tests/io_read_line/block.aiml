# Requires: driver — tests/io_read_line/run.sh feeds stdin.  Started on its own,
# hangs the probe on an open pipe until the time limit strikes (600 s).
# io.read stays a block read: it does NOT stop at the end of the line (spec/23).
- def:
    name: main
    return: i32
    body:
      - decl: [blob, string, { call: [io.read, io.stdin, 100] }]
      - call: [log.info, "block_len=${blob.len}"]
      - return: 0
