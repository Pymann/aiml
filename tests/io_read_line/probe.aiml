# Requires: driver — tests/io_read_line/run.sh feeds stdin.  Started on its own,
# hangs the probe on an open pipe until the time limit strikes (600 s).
# Reads two lines line by line and reports length and content.
- def:
    name: main
    return: i32
    body:
      - decl: [first, string, { call: [io.read_line, io.stdin] }]
      - decl: [second, string, { call: [io.read_line, io.stdin] }]
      - call: [log.info, "L1=[${first}] len=${first.len}"]
      - call: [log.info, "L2=[${second}] len=${second.len}"]
      - return: 0
