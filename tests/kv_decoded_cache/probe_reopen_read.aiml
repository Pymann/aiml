# SPEC: 31_db_integration,61_memory_management
# static-check: off
# Requires: driver
# (started on its own this probe only creates the store — the case needs TWO
#  processes over the same WAL, see run.sh in this directory)
# spec/31 §6.7.3: the decoded_cache of a typed Kv is limited to MAX_DECODED_LRU (1024),
# and a `kv.get` returns the slot it has just created — never one
# that the same eviction has already freed.
#
# This probe runs TWICE over the same WAL (run.sh):
#   1st run  (store empty) → create 1200 rows, that is more than the cache window.
#   2nd run  (store full) → `db.open_kv` fills the decoded_cache with ALL 1200 rows
#      during the backfill of the db_indexed fields.  Then a `set` (evicts the key)
#      and a read of the same key: that is the cache miss where the eviction
#      strikes.  The CONTENT is read, so that a freed slot is noticed even
#      when the memory is still readable.
#
# That is the shape of the cai crash of 2026-11-04 (SIGSEGV in __strlen_avx2 <- enc <-
# aiml_ser_deep_copy <- cai.wissen.Aufloesung_eintraege): cai opens a names Kv with
# two indexed fields and tens of thousands of rows, writes new names during the run and reads
# them again later.
- model:
    name: NameRow
    fields:
      - [text, string, "", { db_indexed: true }]
      - [ding, string, "", { db_indexed: true }]
      - [sorte, string, ""]
      - [quelle, string, ""]

- class:
    name: Namensgraf
    members:
      - [namen, Kv<string:NameRow>, null, { access: public }]
    methods:
      - def:
          name: setup
          args: [[store, Kv<string:NameRow>]]
          body:
            - set: [<.namen, store]

      - def:
          name: wert_von
          args: [[nummer, i32]]
          return: string
          body:
            - return: "ding-${nummer}-mit-etwas-laenge-damit-der-heap-sichtbar-ist"

      - def:
          name: zeile_setzen
          args: [[nummer, i32], [marke, string]]
          body:
            - decl: [eintrag, NameRow]
            - set: [eintrag.text, "wort-${nummer}"]
            - set: [eintrag.ding, { call: [<.wert_von, nummer] }]
            - set: [eintrag.sorte, marke]
            - set: [eintrag.quelle, "quelle-${nummer}"]
            - call: [<.namen.set, "k-${nummer}", eintrag]

      - def:
          name: saen
          args: [[anzahl, i32]]
          return: i32
          body:
            - decl: [row, i32, 0]
            - while: [{ lt: [row, anzahl] }]
              body:
                - call: [<.zeile_setzen, row, "titel"]
                - set: [row, { +: [row, 1] }]
            - print: ["SEED ${anzahl}"]
            - return: 0

      # the read path from cai.wissen.Aufloesung.eintraege: keys via the index, then
      # get_copy per hit (the compiler turns that into kv_get + aiml_ser_deep_copy)
      - def:
          name: eintraege
          args: [[suchtext, string]]
          return: list<NameRow>
          body:
            - decl: [keys, list<string>, { call: [<.namen.findings_by, "text", suchtext] }]
            - decl: [out, list<NameRow>, []]
            - decl: [row, i32, 0]
            - while: [{ lt: [row, keys.len] }]
              body:
                - decl: [eintrag, NameRow, { call: [<.namen.get_copy, { call: [keys.get, row] }] }]
                - call: [out.push, eintrag]
                - set: [row, { +: [row, 1] }]
            - return: out

      - def:
          name: lies_und_pruefe
          args: [[nummer, i32], [marke, string]]
          return: i32
          body:
            - decl: [erwartet, string, { call: [<.wert_von, nummer] }]
            # 1. borrow view on the slot
            - decl: [sicht, ref<NameRow>, { call: [<.namen.get, "k-${nummer}"] }]
            - if: [{ neq: [sicht.ding, erwartet] }, true]
              then:
                - print: ["FAIL k-${nummer}: get.ding does not match"]
                - return: 1
            - if: [{ neq: [sicht.sorte, marke] }, true]
              then:
                - print: ["FAIL k-${nummer}: get.sorte='${sicht.sorte}' expected '${marke}'"]
                - return: 2
            # 2. the same slot via the index + get_copy — this is where cai blew up
            - decl: [zeilen, list<NameRow>, { call: [<.eintraege, "wort-${nummer}"] }]
            - if: [{ neq: [zeilen.len, 1] }, true]
              then:
                - print: ["FAIL k-${nummer}: eintraege.len=${zeilen.len}"]
                - return: 3
            - decl: [erste, NameRow, { call: [zeilen.get, 0] }]
            - if: [{ neq: [erste.ding, erwartet] }, true]
              then:
                - print: ["FAIL k-${nummer}: get_copy.ding does not match"]
                - return: 4
            - if: [{ neq: [erste.sorte, marke] }, true]
              then:
                - print: ["FAIL k-${nummer}: get_copy.sorte='${erste.sorte}' expected '${marke}'"]
                - return: 5
            - return: 0

      - def:
          name: pruefe
          return: i32
          body:
            # reading WITHOUT prior writing hits the cache (the backfill stored everything)
            - decl: [kalt, i32, { call: [<.lies_und_pruefe, 7, "titel"] }]
            - if: [{ neq: [kalt, 0] }, true]
              then:
                - return: kalt
            # writing evicts the key from the cache; the next read is the
            # miss where the eviction catches the slot that was just created.
            - decl: [row, i32, 0]
            - while: [{ lt: [row, 12] }]
              body:
                - decl: [nummer, i32, { +: [{ "*": [row, 97] }, 11] }]
                - call: [<.zeile_setzen, nummer, "neu"]
                - decl: [warm, i32, { call: [<.lies_und_pruefe, nummer, "neu"] }]
                - if: [{ neq: [warm, 0] }, true]
                  then:
                    - print: ["FAIL after set/get on k-${nummer}"]
                    - return: warm
                - set: [row, { +: [row, 1] }]
            - print: ["PASS kv decoded cache bounded, read slot stays valid"]
            - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [store, Kv<string:NameRow>, { call: [db.open_kv, "namen", { persist: true, path: "/tmp/aiml_test_kvcache/" }] }]
      - decl: [graf, shared<Namensgraf>, { new: Namensgraf }]
      - call: [graf.setup, store]
      - decl: [vorhanden, i64, { call: [store.len] }]
      - if: [{ eq: [vorhanden, 0] }, true]
        then:
          - return: { call: [graf.saen, 1200] }
      - return: { call: [graf.pruefe] }
