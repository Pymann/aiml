# SPEC: 31_db_integration,45_db_indexed_fields
# static-check: off
# Requires: driver
# spec/45 "Cost of index maintenance" + spec/31 §9: `kv.set` ist O(1) amortisiert, und zwar
# EINSCHLIESSLICH des db_indexed-Hooks — unabhaengig davon, wie viele Zeilen sich einen
# Feldwert teilen.  Diese Probe prueft das messend und prueft danach, dass die dafuer
# noetige Buchfuehrung (Graeber + Verdichtung) die Trefferliste nicht beschaedigt.
#
# Teil 1  Schreiben: zehn Bloecke gleicher Groesse in denselben, wachsenden Speicher
# Teil 2  Umschreiben: dieselben Schluessel erneut setzen (Pfad remove+add)
# Teil 3  Korrektheit: Einfuegereihenfolge der Treffer ueber Graeber und Verdichtung hinweg
#
# Das Urteil fallen Teil 1/2 NORMIERT: verglichen wird ein indiziertes Feld mit WENIGEN
# verschiedenen Werten (ein Bucket waechst auf die Zahl der Zeilen) gegen eines mit lauter
# verschiedenen Werten (Bucket = 1) im SELBEN Block.  Damit haengt das Urteil nicht an der
# Maschinengeschwindigkeit oder an der Last — nur am Verhaeltnis.
# Gemessener Stand vor dem Fix (cai 2026-11-04): je 4000 set 487 ms bei 4k Zeilen und
# 5074 ms bei 32k, gegen flache ~32 ms mit Bucket 1 — Faktor 160.
- model:
    name: PlainRow
    fields:
      - [text, string, ""]
      - [sorte, string, ""]
- model:
    name: HochRow
    fields:
      - [text, string, "", { db_indexed: true }]
      - [sorte, string, ""]
- model:
    name: NiedrigRow
    fields:
      - [text, string, ""]
      - [sorte, string, "", { db_indexed: true }]

- class:
    name: Messung
    members:
      - [ohne, Kv<string:PlainRow>, null, { access: public }]
      - [hoch, Kv<string:HochRow>, null, { access: public }]
      - [nied, Kv<string:NiedrigRow>, null, { access: public }]
      - [letzt_hoch, i64, 0, { access: public }]
      - [letzt_nied, i64, 0, { access: public }]
    methods:
      - def:
          name: setup
          body:
            - set: [<.ohne, { call: [db.open_kv, "scal_ohne", { persist: false }] }]
            - set: [<.hoch, { call: [db.open_kv, "scal_hoch", { persist: false }] }]
            - set: [<.nied, { call: [db.open_kv, "scal_nied", { persist: false }] }]

      - def:
          name: block_ohne
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - decl: [row, PlainRow]
                - set: [row.text, "wort-${num}"]
                - set: [row.sorte, "satz"]
                - call: [<.ohne.set, "k-${num}", row]
                - set: [num, { +: [num, 1] }]

      # Bucket 1: jeder Zeile ein eigener Feldwert
      - def:
          name: block_hoch
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - decl: [row, HochRow]
                - set: [row.text, "wort-${num}"]
                - set: [row.sorte, "satz"]
                - call: [<.hoch.set, "k-${num}", row]
                - set: [num, { +: [num, 1] }]

      # ein Bucket fuer ALLE Zeilen — hier schlug der O(n)-Scan zu
      - def:
          name: block_nied
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - decl: [row, NiedrigRow]
                - set: [row.text, "wort-${num}"]
                - set: [row.sorte, "satz"]
                - call: [<.nied.set, "k-${num}", row]
                - set: [num, { +: [num, 1] }]

      - def:
          name: lauf
          args: [[bloecke, i32], [pro_block, i32], [marke, string]]
          body:
            - decl: [blk, i32, 0]
            - while: [{ lt: [blk, bloecke] }]
              body:
                - decl: [von, i32, { "*": [blk, pro_block] }]
                - decl: [bis, i32, { +: [von, pro_block] }]
                - decl: [zt_a, i64, { call: [time.now] }]
                - call: [<.block_ohne, von, bis]
                - decl: [zt_b, i64, { call: [time.now] }]
                - call: [<.block_hoch, von, bis]
                - decl: [zt_c, i64, { call: [time.now] }]
                - call: [<.block_nied, von, bis]
                - decl: [zt_d, i64, { call: [time.now] }]
                - decl: [dau_ohne, i64, { -: [zt_b, zt_a] }]
                - decl: [dau_hoch, i64, { -: [zt_c, zt_b] }]
                - decl: [dau_nied, i64, { -: [zt_d, zt_c] }]
                - print: ["MESS ${marke} bis=${bis} ohne=${dau_ohne}ms bucket1=${dau_hoch}ms bucketN=${dau_nied}ms"]
                - set: [<.letzt_hoch, dau_hoch]
                - set: [<.letzt_nied, dau_nied]
                - set: [blk, { +: [blk, 1] }]

      # Urteil: der grosse Bucket darf den kleinen um hoechstens Faktor 10 schlagen
      # (+200 ms Sockel, damit kurze Bloecke und Last nicht allein entscheiden).
      - def:
          name: urteil
          args: [[marke, string]]
          return: i32
          body:
            - decl: [bkt_eins, i64, <.letzt_hoch]
            - decl: [bkt_viel, i64, <.letzt_nied]
            - decl: [grenze, i64, { +: [{ "*": [bkt_eins, 10] }, 200] }]
            - if: [{ gt: [bkt_viel, grenze] }, true]
              then:
                - print: ["FAIL ${marke}: bucketN=${bkt_viel}ms gegen bucket1=${bkt_eins}ms — Index-Pflege waechst mit der Bucketgroesse (spec/45)"]
                - return: 1
            - return: 0

- class:
    name: Ordnung
    members:
      - [nied, Kv<string:NiedrigRow>, null, { access: public }]
    methods:
      - def:
          name: setup
          body:
            - set: [<.nied, { call: [db.open_kv, "scal_ordn", { persist: false }] }]

      - def:
          name: lege
          args: [[num, i32], [art, string]]
          body:
            - decl: [row, NiedrigRow]
            - set: [row.text, "wort-${num}"]
            - set: [row.sorte, art]
            - call: [<.nied.set, "o-${num}", row]

      - def:
          name: treffer
          args: [[art, string]]
          return: string
          body:
            - decl: [keys, list<string>, { call: [<.nied.findings_by, "sorte", art] }]
            - decl: [aus, string, ""]
            - decl: [idx, i32, 0]
            - while: [{ lt: [idx, keys.len] }]
              body:
                - decl: [eins, string, { call: [keys.get, idx] }]
                - set: [aus, "${aus}${eins},"]
                - set: [idx, { +: [idx, 1] }]
            - return: aus

      - def:
          name: pruefe
          args: [[marke, string], [art, string], [erwartet, string]]
          return: i32
          body:
            - decl: [ist, string, { call: [<.treffer, art] }]
            - if: [{ neq: [ist, erwartet] }, true]
              then:
                - print: ["FAIL ${marke}: '${ist}' erwartet '${erwartet}'"]
                - return: 1
            - return: 0

      - def:
          name: lauf
          return: i32
          body:
            - decl: [fehler, i32, 0]
            # 20 Zeilen in EINEN Bucket, Einfuegereihenfolge o-0 .. o-19
            - decl: [num, i32, 0]
            - while: [{ lt: [num, 20] }]
              body:
                - call: [<.lege, num, "satz"]
                - set: [num, { +: [num, 1] }]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "voll", "satz",
                "o-0,o-1,o-2,o-3,o-4,o-5,o-6,o-7,o-8,o-9,o-10,o-11,o-12,o-13,o-14,o-15,o-16,o-17,o-18,o-19,"] }] }]
            # zwei umhaengen: Luecken MITTEN im Bucket, noch unter der Verdichtungsschwelle
            - call: [<.lege, 3, "andere"]
            - call: [<.lege, 7, "andere"]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "zwei_graeber", "satz",
                "o-0,o-1,o-2,o-4,o-5,o-6,o-8,o-9,o-10,o-11,o-12,o-13,o-14,o-15,o-16,o-17,o-18,o-19,"] }] }]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "umgehaengt", "andere", "o-3,o-7,"] }] }]
            # einer kommt zurueck — als JUENGSTER, also ans Ende
            - call: [<.lege, 3, "satz"]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "zurueck", "satz",
                "o-0,o-1,o-2,o-4,o-5,o-6,o-8,o-9,o-10,o-11,o-12,o-13,o-14,o-15,o-16,o-17,o-18,o-19,o-3,"] }] }]
            # jetzt ueber die Verdichtungsschwelle: 14 der 19 raus
            - decl: [weg, i32, 4]
            - while: [{ lt: [weg, 18] }]
              body:
                - call: [<.lege, weg, "andere"]
                - set: [weg, { +: [weg, 1] }]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "verdichtet", "satz",
                "o-0,o-1,o-2,o-18,o-19,o-3,"] }] }]
            # nach der Verdichtung weiter anhaengen und loeschen
            - call: [<.lege, 50, "satz"]
            - call: [<.nied.delete, "o-1"]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "nach_verdichtung", "satz",
                "o-0,o-2,o-18,o-19,o-3,o-50,"] }] }]
            # und ein Bucket vollstaendig leeren, dann neu befuellen
            - decl: [rest, i32, 0]
            - while: [{ lt: [rest, 60] }]
              body:
                - call: [<.nied.delete, "o-${rest}"]
                - set: [rest, { +: [rest, 1] }]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "leer", "satz", ""] }] }]
            - call: [<.lege, 99, "satz"]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "neu", "satz", "o-99,"] }] }]
            - return: fehler

# ── Teil 4: der SCHLICHTE Kv<string:string> ohne jedes Modell und ohne Index.
# Das Regime eines selbstgebauten Schluesselraums ("rs|<id>", "rd|<stamm>", …): lauter
# verschiedene Schluessel, dazu Lesen+Schreiben auf schon vorhandene (ein Zaehler).
# spec/31 §9 verspricht O(1) amortisiert auch hier — ohne Index gibt es nichts, was mit
# der Schluesselzahl wachsen darf.  Geprueft wird der WAL-Pfad (persist: true), weil nur
# der anhaengt und waechst.
- class:
    name: Schlicht
    members:
      - [roh, Kv<string:string>, null, { access: public }]
      - [erst, i64, 0, { access: public }]
      - [letzt, i64, 0, { access: public }]
    methods:
      - def:
          name: setup
          body:
            - set: [<.roh, { call: [db.open_kv, "scal_roh", { persist: true, path: "/tmp/aiml_test_kvscal/" }] }]

      - def:
          name: block_neu
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - call: [<.roh.set, "rs|${num}", "satz-${num}-mit-etwas-text-damit-es-nach-inhalt-aussieht"]
                - set: [num, { +: [num, 1] }]

      # lesen + zurueckschreiben auf vorhandene Schluessel — das Muster eines Zaehlers
      - def:
          name: block_zaehl
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - decl: [alt, string, { call: [<.roh.get, "rd|${num}"] }]
                - decl: [wie, i32, { call: [alt.parse_i32] }]
                - set: [wie, { +: [wie, 1] }]
                - call: [<.roh.set, "rd|${num}", "${wie}"]
                - set: [num, { +: [num, 1] }]

      - def:
          name: lauf
          args: [[bloecke, i32], [pro_block, i32]]
          body:
            - decl: [blk, i32, 0]
            - while: [{ lt: [blk, bloecke] }]
              body:
                - decl: [von, i32, { "*": [blk, pro_block] }]
                - decl: [bis, i32, { +: [von, pro_block] }]
                - decl: [zt_a, i64, { call: [time.now] }]
                - call: [<.block_neu, von, bis]
                - decl: [zt_b, i64, { call: [time.now] }]
                # immer DIESELBEN 2000 Zaehler, damit nur der Speicher drumherum waechst
                - call: [<.block_zaehl, 0, 2000]
                - decl: [zt_c, i64, { call: [time.now] }]
                - decl: [dau_neu, i64, { -: [zt_b, zt_a] }]
                - decl: [dau_zae, i64, { -: [zt_c, zt_b] }]
                - decl: [hab, i32, { call: [<.roh.len] }]
                - print: ["MESS schlicht keys=${hab} neu=${dau_neu}ms zaehler=${dau_zae}ms"]
                - if: [{ eq: [blk, 0] }, true]
                  then:
                    - set: [<.erst, { +: [dau_neu, dau_zae] }]
                - set: [<.letzt, { +: [dau_neu, dau_zae] }]
                - set: [blk, { +: [blk, 1] }]

      # Urteil ohne Vergleichsform: hier gibt es keine, also gegen den ERSTEN Block,
      # mit reichlich Luft (Faktor 4 + 300 ms Sockel) gegen Last und Seitenfehler.
      - def:
          name: urteil
          return: i32
          body:
            - decl: [anf, i64, <.erst]
            - decl: [end, i64, <.letzt]
            - decl: [grenze, i64, { +: [{ "*": [anf, 4] }, 300] }]
            - if: [{ gt: [end, grenze] }, true]
              then:
                - print: ["FAIL schlicht: letzter Block ${end}ms gegen ersten ${anf}ms — kv.set waechst mit der Schluesselzahl (spec/31 §9)"]
                - return: 1
            - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [fehler, i32, 0]
      - decl: [ordn, shared<Ordnung>, { new: Ordnung }]
      - call: [ordn.setup]
      - set: [fehler, { +: [fehler, { call: [ordn.lauf] }] }]

      - decl: [mess, shared<Messung>, { new: Messung }]
      - call: [mess.setup]
      # Teil 1: frische Schluessel in einen wachsenden Speicher
      - call: [mess.lauf, 6, 4000, "anlegen"]
      - set: [fehler, { +: [fehler, { call: [mess.urteil, "anlegen"] }] }]
      # Teil 2: dieselben Schluessel erneut — jetzt laeuft remove+add je set
      - call: [mess.lauf, 2, 4000, "umschreiben"]
      - set: [fehler, { +: [fehler, { call: [mess.urteil, "umschreiben"] }] }]

      - decl: [schl, shared<Schlicht>, { new: Schlicht }]
      - call: [schl.setup]
      - call: [schl.lauf, 8, 20000]
      - set: [fehler, { +: [fehler, { call: [schl.urteil] }] }]

      - if: [{ neq: [fehler, 0] }, true]
        then:
          - print: ["FAIL kv_set_scaling: ${fehler} Befunde"]
          - return: 1
      - print: ["PASS kv.set is O(1) amortized including the db_indexed hook"]
      - return: 0
