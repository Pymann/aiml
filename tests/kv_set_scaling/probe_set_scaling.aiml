# SPEC: 31_db_integration,45_db_indexed_fields
# static-check: off
# Requires: driver
# spec/45 "Cost of index maintenance" + spec/31 §9: `kv.set` is O(1) amortised, and that
# INCLUDING the db_indexed hook — regardless of how many rows share a
# field value.  This probe checks that by measuring and afterwards checks that the
# bookkeeping this needs (tombstones + compaction) does not damage the hit list.
#
# Part 1  writing: ten blocks of equal size into the same, growing store
# Part 2  rewriting: set the same keys again (path remove+add)
# Part 3  correctness: insertion order of the hits across tombstones and compaction
#
# The verdict of parts 1/2 is NORMALISED: an indexed field with FEW
# distinct values (one bucket grows to the number of rows) is compared against one with all
# distinct values (bucket = 1) in the SAME block.  That way the verdict does not depend on
# machine speed or load — only on the ratio.
# Measured state before the fix (cai 2026-11-04): 487 ms per 4000 sets at 4k rows and
# 5074 ms at 32k, against a flat ~32 ms with bucket 1 — factor 160.
- model:
    name: PlainRow
    fields:
      - [text, string, ""]
      - [sorte, string, ""]
- model:
    name: HochRow
    fields:
      - [text, string, "", { db_indexed: true }]
      - [sorte, string, ""]
- model:
    name: NiedrigRow
    fields:
      - [text, string, ""]
      - [sorte, string, "", { db_indexed: true }]

- class:
    name: Messung
    members:
      - [ohne, Kv<string:PlainRow>, null, { access: public }]
      - [hoch, Kv<string:HochRow>, null, { access: public }]
      - [nied, Kv<string:NiedrigRow>, null, { access: public }]
      - [letzt_hoch, i64, 0, { access: public }]
      - [letzt_nied, i64, 0, { access: public }]
    methods:
      - def:
          name: setup
          body:
            - set: [<.ohne, { call: [db.open_kv, "scal_ohne", { persist: false }] }]
            - set: [<.hoch, { call: [db.open_kv, "scal_hoch", { persist: false }] }]
            - set: [<.nied, { call: [db.open_kv, "scal_nied", { persist: false }] }]

      - def:
          name: block_ohne
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - decl: [row, PlainRow]
                - set: [row.text, "wort-${num}"]
                - set: [row.sorte, "satz"]
                - call: [<.ohne.set, "k-${num}", row]
                - set: [num, { +: [num, 1] }]

      # bucket 1: every row its own field value
      - def:
          name: block_hoch
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - decl: [row, HochRow]
                - set: [row.text, "wort-${num}"]
                - set: [row.sorte, "satz"]
                - call: [<.hoch.set, "k-${num}", row]
                - set: [num, { +: [num, 1] }]

      # one bucket for ALL rows — this is where the O(n) scan struck
      - def:
          name: block_nied
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - decl: [row, NiedrigRow]
                - set: [row.text, "wort-${num}"]
                - set: [row.sorte, "satz"]
                - call: [<.nied.set, "k-${num}", row]
                - set: [num, { +: [num, 1] }]

      - def:
          name: lauf
          args: [[bloecke, i32], [pro_block, i32], [marke, string]]
          body:
            - decl: [blk, i32, 0]
            - while: [{ lt: [blk, bloecke] }]
              body:
                - decl: [von, i32, { "*": [blk, pro_block] }]
                - decl: [bis, i32, { +: [von, pro_block] }]
                - decl: [zt_a, i64, { call: [time.now] }]
                - call: [<.block_ohne, von, bis]
                - decl: [zt_b, i64, { call: [time.now] }]
                - call: [<.block_hoch, von, bis]
                - decl: [zt_c, i64, { call: [time.now] }]
                - call: [<.block_nied, von, bis]
                - decl: [zt_d, i64, { call: [time.now] }]
                - decl: [dau_ohne, i64, { -: [zt_b, zt_a] }]
                - decl: [dau_hoch, i64, { -: [zt_c, zt_b] }]
                - decl: [dau_nied, i64, { -: [zt_d, zt_c] }]
                - print: ["MESS ${marke} bis=${bis} ohne=${dau_ohne}ms bucket1=${dau_hoch}ms bucketN=${dau_nied}ms"]
                - set: [<.letzt_hoch, dau_hoch]
                - set: [<.letzt_nied, dau_nied]
                - set: [blk, { +: [blk, 1] }]

      # verdict: the big bucket may beat the small one by at most factor 10
      # (+200 ms base, so that short blocks and load do not decide on their own).
      - def:
          name: urteil
          args: [[marke, string]]
          return: i32
          body:
            - decl: [bkt_eins, i64, <.letzt_hoch]
            - decl: [bkt_viel, i64, <.letzt_nied]
            - decl: [grenze, i64, { +: [{ "*": [bkt_eins, 10] }, 200] }]
            - if: [{ gt: [bkt_viel, grenze] }, true]
              then:
                - print: ["FAIL ${marke}: bucketN=${bkt_viel}ms against bucket1=${bkt_eins}ms — index maintenance grows with the bucket size (spec/45)"]
                - return: 1
            - return: 0

- class:
    name: Ordnung
    members:
      - [nied, Kv<string:NiedrigRow>, null, { access: public }]
    methods:
      - def:
          name: setup
          body:
            - set: [<.nied, { call: [db.open_kv, "scal_ordn", { persist: false }] }]

      - def:
          name: lege
          args: [[num, i32], [art, string]]
          body:
            - decl: [row, NiedrigRow]
            - set: [row.text, "wort-${num}"]
            - set: [row.sorte, art]
            - call: [<.nied.set, "o-${num}", row]

      - def:
          name: treffer
          args: [[art, string]]
          return: string
          body:
            - decl: [keys, list<string>, { call: [<.nied.findings_by, "sorte", art] }]
            - decl: [aus, string, ""]
            - decl: [idx, i32, 0]
            - while: [{ lt: [idx, keys.len] }]
              body:
                - decl: [eins, string, { call: [keys.get, idx] }]
                - set: [aus, "${aus}${eins},"]
                - set: [idx, { +: [idx, 1] }]
            - return: aus

      - def:
          name: pruefe
          args: [[marke, string], [art, string], [erwartet, string]]
          return: i32
          body:
            - decl: [ist, string, { call: [<.treffer, art] }]
            - if: [{ neq: [ist, erwartet] }, true]
              then:
                - print: ["FAIL ${marke}: '${ist}' expected '${erwartet}'"]
                - return: 1
            - return: 0

      - def:
          name: lauf
          return: i32
          body:
            - decl: [fehler, i32, 0]
            # 20 rows into ONE bucket, insertion order o-0 .. o-19
            - decl: [num, i32, 0]
            - while: [{ lt: [num, 20] }]
              body:
                - call: [<.lege, num, "satz"]
                - set: [num, { +: [num, 1] }]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "voll", "satz",
                "o-0,o-1,o-2,o-3,o-4,o-5,o-6,o-7,o-8,o-9,o-10,o-11,o-12,o-13,o-14,o-15,o-16,o-17,o-18,o-19,"] }] }]
            # re-hang two: gaps IN THE MIDDLE of the bucket, still below the compaction threshold
            - call: [<.lege, 3, "andere"]
            - call: [<.lege, 7, "andere"]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "zwei_graeber", "satz",
                "o-0,o-1,o-2,o-4,o-5,o-6,o-8,o-9,o-10,o-11,o-12,o-13,o-14,o-15,o-16,o-17,o-18,o-19,"] }] }]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "umgehaengt", "andere", "o-3,o-7,"] }] }]
            # one comes back — as the YOUNGEST, so at the end
            - call: [<.lege, 3, "satz"]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "zurueck", "satz",
                "o-0,o-1,o-2,o-4,o-5,o-6,o-8,o-9,o-10,o-11,o-12,o-13,o-14,o-15,o-16,o-17,o-18,o-19,o-3,"] }] }]
            # now above the compaction threshold: 14 of the 19 out
            - decl: [weg, i32, 4]
            - while: [{ lt: [weg, 18] }]
              body:
                - call: [<.lege, weg, "andere"]
                - set: [weg, { +: [weg, 1] }]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "verdichtet", "satz",
                "o-0,o-1,o-2,o-18,o-19,o-3,"] }] }]
            # after compaction keep appending and deleting
            - call: [<.lege, 50, "satz"]
            - call: [<.nied.delete, "o-1"]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "nach_verdichtung", "satz",
                "o-0,o-2,o-18,o-19,o-3,o-50,"] }] }]
            # and empty one bucket completely, then refill it
            - decl: [rest, i32, 0]
            - while: [{ lt: [rest, 60] }]
              body:
                - call: [<.nied.delete, "o-${rest}"]
                - set: [rest, { +: [rest, 1] }]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "leer", "satz", ""] }] }]
            - call: [<.lege, 99, "satz"]
            - set: [fehler, { +: [fehler, { call: [<.pruefe, "neu", "satz", "o-99,"] }] }]
            - return: fehler

# ── Part 4: the PLAIN Kv<string:string> without any model and without an index.
# The regime of a self-built key space ("rs|<id>", "rd|<stamm>", …): all
# distinct keys, plus reading+writing on existing ones (a counter).
# spec/31 §9 promises O(1) amortised here too — without an index there is nothing that may
# grow with the number of keys.  The WAL path is checked (persist: true), because only
# that one appends and grows.
- class:
    name: Schlicht
    members:
      - [roh, Kv<string:string>, null, { access: public }]
      - [erst, i64, 0, { access: public }]
      - [letzt, i64, 0, { access: public }]
    methods:
      - def:
          name: setup
          body:
            - set: [<.roh, { call: [db.open_kv, "scal_roh", { persist: true, path: "/tmp/aiml_test_kvscal/" }] }]

      - def:
          name: block_neu
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - call: [<.roh.set, "rs|${num}", "satz-${num}-mit-etwas-text-damit-es-nach-inhalt-aussieht"]
                - set: [num, { +: [num, 1] }]

      # read + write back on existing keys — the pattern of a counter
      - def:
          name: block_zaehl
          args: [[von, i32], [bis, i32]]
          body:
            - decl: [num, i32, von]
            - while: [{ lt: [num, bis] }]
              body:
                - decl: [alt, string, { call: [<.roh.get, "rd|${num}"] }]
                - decl: [wie, i32, { call: [alt.parse_i32] }]
                - set: [wie, { +: [wie, 1] }]
                - call: [<.roh.set, "rd|${num}", "${wie}"]
                - set: [num, { +: [num, 1] }]

      - def:
          name: lauf
          args: [[bloecke, i32], [pro_block, i32]]
          body:
            - decl: [blk, i32, 0]
            - while: [{ lt: [blk, bloecke] }]
              body:
                - decl: [von, i32, { "*": [blk, pro_block] }]
                - decl: [bis, i32, { +: [von, pro_block] }]
                - decl: [zt_a, i64, { call: [time.now] }]
                - call: [<.block_neu, von, bis]
                - decl: [zt_b, i64, { call: [time.now] }]
                # always the SAME 2000 counters, so that only the store around them grows
                - call: [<.block_zaehl, 0, 2000]
                - decl: [zt_c, i64, { call: [time.now] }]
                - decl: [dau_neu, i64, { -: [zt_b, zt_a] }]
                - decl: [dau_zae, i64, { -: [zt_c, zt_b] }]
                - decl: [hab, i32, { call: [<.roh.len] }]
                - print: ["MESS schlicht keys=${hab} neu=${dau_neu}ms zaehler=${dau_zae}ms"]
                - if: [{ eq: [blk, 0] }, true]
                  then:
                    - set: [<.erst, { +: [dau_neu, dau_zae] }]
                - set: [<.letzt, { +: [dau_neu, dau_zae] }]
                - set: [blk, { +: [blk, 1] }]

      # verdict without a comparison form: there is none here, so against the FIRST block,
      # with plenty of slack (factor 4 + 300 ms base) against load and page faults.
      - def:
          name: urteil
          return: i32
          body:
            - decl: [anf, i64, <.erst]
            - decl: [end, i64, <.letzt]
            - decl: [grenze, i64, { +: [{ "*": [anf, 4] }, 300] }]
            - if: [{ gt: [end, grenze] }, true]
              then:
                - print: ["FAIL plain: last block ${end}ms against first ${anf}ms — kv.set grows with the number of keys (spec/31 §9)"]
                - return: 1
            - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [fehler, i32, 0]
      - decl: [ordn, shared<Ordnung>, { new: Ordnung }]
      - call: [ordn.setup]
      - set: [fehler, { +: [fehler, { call: [ordn.lauf] }] }]

      - decl: [mess, shared<Messung>, { new: Messung }]
      - call: [mess.setup]
      # Part 1: fresh keys into a growing store
      - call: [mess.lauf, 6, 4000, "anlegen"]
      - set: [fehler, { +: [fehler, { call: [mess.urteil, "anlegen"] }] }]
      # Part 2: the same keys again — now remove+add runs per set
      - call: [mess.lauf, 2, 4000, "umschreiben"]
      - set: [fehler, { +: [fehler, { call: [mess.urteil, "umschreiben"] }] }]

      - decl: [schl, shared<Schlicht>, { new: Schlicht }]
      - call: [schl.setup]
      - call: [schl.lauf, 8, 20000]
      - set: [fehler, { +: [fehler, { call: [schl.urteil] }] }]

      - if: [{ neq: [fehler, 0] }, true]
        then:
          - print: ["FAIL kv_set_scaling: ${fehler} findings"]
          - return: 1
      - print: ["PASS kv.set is O(1) amortized including the db_indexed hook"]
      - return: 0
