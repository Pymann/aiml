# spec/31 §6.10 (negative): the same store, opened twice with a DIFFERENT value type.
# Requires: driver — tests/kv_typ_divergenz/run.sh runs both cases;
# started on its own, the ABORT of the cross case is the expected behaviour.
# The runtime must report that loudly on the second open and abort -- before,
# it served the deviating reader silently and the record was read as something foreign
# (datacreatures, 2026-11-11).

- model:
    name: Zaehler
    fields:
      - [schluessel, string]
      - [wert,       i32, 0]

- model:
    name: Fund
    fields:
      - [fid,    string]
      - [name,   string]
      - [marken, list<string>]
      - [stufe,  i32, 0]

# First open: typed as Zaehler.
- decl: [erst_kv, Kv<string:Zaehler>, { call: [db.open_kv, "tdiv_kreuz", {persist: true, path: "/tmp/aiml_test_kvtypdiv/"}] }]

- def:
    name: main
    body:
      - decl: [ein, Zaehler]
      - set: [ein.schluessel, "gate_feind"]
      - set: [ein.wert, 7]
      - call: [erst_kv.set, "schluessel", ein]

      # Second open of the same store, but typed as Fund -- here
      # the guard must strike.  What would come after is the crash from the report.
      - decl: [zweit_kv, Kv<string:Fund>, { call: [db.open_kv, "tdiv_kreuz", {persist: true, path: "/tmp/aiml_test_kvtypdiv/"}] }]
      - decl: [zur, Fund, { call: [zweit_kv.get_copy, "schluessel"] }]
      - call: [log.error, "FAIL: second open was served silently — name='${zur.name}'"]
