# spec/31 §6.10 (negativ): derselbe Store, zweimal mit VERSCHIEDENEM Werttyp.
# Die Laufzeit muss das beim zweiten Oeffnen laut melden und abbrechen -- vorher
# bediente sie den abweichenden Leser still und der Satz wurde fremd gelesen
# (datacreatures, 11.11.2026).

- model:
    name: Zaehler
    fields:
      - [schluessel, string]
      - [wert,       i32, 0]

- model:
    name: Fund
    fields:
      - [fid,    string]
      - [name,   string]
      - [marken, list<string>]
      - [stufe,  i32, 0]

# Erste Oeffnung: typisiert auf Zaehler.
- decl: [erst_kv, Kv<string:Zaehler>, { call: [db.open_kv, "tdiv_kreuz", {persist: true, path: "/tmp/aiml_test_kvtypdiv/"}] }]

- def:
    name: main
    body:
      - decl: [ein, Zaehler]
      - set: [ein.schluessel, "gate_feind"]
      - set: [ein.wert, 7]
      - call: [erst_kv.set, "schluessel", ein]

      # Zweite Oeffnung desselben Stores, aber typisiert auf Fund -- hier muss
      # die Wache zuschlagen.  Was danach kaeme, ist der Absturz aus dem Bericht.
      - decl: [zweit_kv, Kv<string:Fund>, { call: [db.open_kv, "tdiv_kreuz", {persist: true, path: "/tmp/aiml_test_kvtypdiv/"}] }]
      - decl: [zur, Fund, { call: [zweit_kv.get_copy, "schluessel"] }]
      - call: [log.error, "FAIL: zweite Oeffnung wurde still bedient — name='${zur.name}'"]
