# SPEC?: 35_ffi   # derived from the file name, to be confirmed
# Requires: library

- namespace: exta

- decl: [shared_counter, i32, 0, { extern: true }]
- decl: [shared_label, string, "", { extern: true }]

- def:
    name: set_counter
    args: [[var_v, i32]]
    body:
      - set: [shared_counter, var_v]

- def:
    name: inc_counter
    body:
      - set: [shared_counter, { +: [shared_counter, 1] }]

- def:
    name: get_counter
    return: i32
    body:
      - return: [shared_counter]

- def:
    name: set_label
    args: [[var_s, string]]
    body:
      - set: [shared_label, var_s]

- def:
    name: get_label
    return: string
    body:
      - return: [shared_label]
