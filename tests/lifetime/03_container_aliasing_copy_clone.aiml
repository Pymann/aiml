# SPEC?: 29_3_sys_clone,61_memory_management_DRAFT,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
# TIER: T2
# CONSTRUCT: containers are refcounted handles (§5, Option B).
# COVERS: assign = SHARE (aliasing); {copy: a} = shallow (independent spine, shared referents);
#         {clone: a} = deep (independent). Symbols: list<T>, {copy}, {clone}.
# EXPECT: b aliases a; c (copy) has independent spine; d (clone) is fully independent.
- def:
    name: main
    return: i32
    body:
      - decl: [ita, list<i32>]
      - call: [ita.push, 1]
      - decl: [itb, list<i32>, ita]              # SHARE (incref) — same list
      - call: [ita.push, 2]
      - if: { condition: { neq: [itb.len, 2] }, then: [{ print: ["FAIL alias itb.len=${itb.len}"] }, { return: 1 }] }   # aliasing → 2
      - decl: [itc, list<i32>, { copy: ita }]    # shallow copy — independent spine
      - call: [ita.push, 3]
      - if: { condition: { neq: [itc.len, 2] }, then: [{ print: ["FAIL copy itc.len=${itc.len}"] }, { return: 1 }] }     # unaffected
      - decl: [itd, list<i32>, { clone: ita }]   # deep clone — fully independent
      - call: [ita.push, 4]
      - if: { condition: { neq: [itd.len, 3] }, then: [{ print: ["FAIL clone itd.len=${itd.len}"] }, { return: 1 }] }
      # scope exit: a,b drop the shared list once at rc 0; c and d free their own buffers.
      - print: ["PASS 03 container_aliasing_copy_clone"]
      - return: 0
