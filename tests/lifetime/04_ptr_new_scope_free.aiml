# static-check: off
# TIER: T1
# CONSTRUCT: explicit heap via {new}, unique ptr<T>, scope-default release (§6, §9.1).
# COVERS: {new: T}, ptr<T>, scope-default auto-free (no free written), early free (nulls slot),
#         per-iteration free in a loop. Symbols: new, ptr<T>, free.
- model:
    name: Node
    fields:
      - [label, string, "n"]
      - [vals, list<i32>]

# a scope box: no `free` written — released automatically at scope exit (§9.1)
- def:
    name: use_scope
    return: i32
    body:
      - decl: [p, ptr<Node>, { new: Node }]   # heap; scope-managed by default
      - set: [p.label, "boxed"]               # dot-access auto-derefs
      - call: [p.vals.push, 7]
      - if: { condition: { neq: [p.label, "boxed"] }, then: [{ print: ["FAIL label ${p.label}"] }, { return: 1 }] }
      - return: 0                              # p auto-freed here — no manual free needed

# early free: releases now + nulls the slot; scope drop then a no-op (no double free)
- def:
    name: use_early_free
    return: i32
    body:
      - decl: [q, ptr<Node>, { new: Node }]
      - call: [q.vals.push, 1]
      - free: [q]                             # explicit EARLY release
      - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [i, i32, 0]
      - while:
          condition: { lt: [i, 20] }
          body:
            - decl: [rc, i32, { call: [use_scope] }]   # new+free per iteration, no accumulation
            - if: { condition: { neq: [rc, 0] }, then: [{ print: ["FAIL use_scope"] }, { return: 1 }] }
            - decl: [rc2, i32, { call: [use_early_free] }]
            - if: { condition: { neq: [rc2, 0] }, then: [{ print: ["FAIL use_early_free"] }, { return: 1 }] }
            - set: [i, { +: [i, 1] }]
      - print: ["PASS 04 ptr_new_scope_free"]
      - return: 0
