# SPEC?: 61_memory_management,24_time   # derived from the file name, to be confirmed
# static-check: off
# TIER: T2
# CONSTRUCT: opt-in shared<T> co-ownership + {share} (§6.2).
# COVERS: shared<T>, {share: {new: T}} (fresh co-owned handle), incref on push, decref on
#         remove, freed at rc 0; access via a ref<T> borrow. Symbols: shared<T>, {share}, ref<T>.
# EXPECT: two containers co-own one Sprite; it stays alive after one owner drops; freed once.
- model: { name: Sprite, fields: [[ident, i32, 0], [tags, list<string>]] }

- def:
    name: main
    return: i32
    static_off: ["str_cmp"]
    body:
      - decl: [its, shared<Sprite>, { share: { new: Sprite } }]   # fresh co-owned handle (rc=1)
      - set: [its.ident, 42]                         # direct member write through the shared handle
      - decl: [poolA, list<shared<Sprite>>]
      - decl: [poolB, list<shared<Sprite>>]
      - call: [poolA.push, its]                      # incref → rc=2
      - call: [poolB.push, its]                      # incref → rc=3 (co-owned by its, poolA, poolB)
      - decl: [viewa, ref<Sprite>, { at: [poolA, 0] }]
      - if: { condition: { neq: [viewa.ident, 42] }, then: [{ print: ["FAIL coown ident=${viewa.ident}"] }, { return: 1 }] }
      - call: [poolA.remove, 0]                       # decref → rc=2; Sprite still alive via its/poolB
      - decl: [viewb, ref<Sprite>, { at: [poolB, 0] }]
      - if: { condition: { neq: [viewb.ident, 42] }, then: [{ print: ["FAIL after decref ident=${viewb.ident}"] }, { return: 1 }] }
      # scope exit: its, poolB drop → rc → 0 → Sprite freed exactly once
      - print: ["PASS 06 shared_coown_adopt"]
      - return: 0
