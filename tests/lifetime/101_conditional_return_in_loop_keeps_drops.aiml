# SPEC: 61_memory_management_DRAFT
# static-check: off
# spec/61 §6/§7: a conditional `return local` inside a loop moves the local only on that path; every other iteration still drops it.
- def:
    name: first_match
    args: [[hand, list<string>], [want, string]]
    return: string
    body:
      - decl: [pos, i32, 0]
      - while:
          condition: { lt: [pos, hand.len] }
          body:
            - decl: [cid, string, { at: [hand, pos] }]
            - decl: [tags, list<string>]
            - call: [tags.push, "t-${pos}"]
            - if: { condition: { eq: [cid, want] }, then: [{ return: cid }] }
            - set: [pos, { +: [pos, 1] }]
      - return: ""
- def:
    name: main
    return: i32
    body:
      - decl: [hand, list<string>]
      - call: [hand.push, "card-${1}"]
      - call: [hand.push, "card-${2}"]
      - call: [hand.push, "card-${3}"]
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [hit, string, { call: [first_match, hand, "card-3"] }]
            - decl: [miss, string, { call: [first_match, hand, "nope"] }]
            - if: {condition: {neq: [hit, "card-3"]}, then: [{return: 190}]}
            - if: {condition: {neq: [miss.len, 0]}, then: [{return: 191}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
