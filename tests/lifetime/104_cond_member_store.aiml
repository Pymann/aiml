# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- model: {name: Box2, fields: [[cur, Item]]}
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [holder, Box2]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [one, Item, {call: [make_item, counter]}]
            - if: {condition: {eq: [{ '%': [counter, 2]}, 0]}, then: [{set: [holder.cur, one]}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
