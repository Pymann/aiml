# SPEC?: 42_path_type,61_memory_management_DRAFT,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- def:
    name: risky
    args: [[num, i32]]
    return: i32
    body:
      - decl: [loc, Item, {call: [make_item, num]}]
      - decl: [lst, list<string>]
      - call: [lst.push, "r-${num}"]
      - if: { condition: { eq: [{ '%': [num, 3] }, 0] }, then: [{ throw: {new: Exception, message: "boom"} }] }
      - return: loc.label.len
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [caught, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - try:
                body:
                  - decl: [res, i32, {call: [risky, counter]}]
                catch:
                  - type: Exception
                    var: err
                    body:
                      - set: [caught, {+: [caught, 1]}]
            - set: [counter, {+: [counter, 1]}]
      - if: {condition: {neq: [caught, 67]}, then: [{return: 110}]}
      - return: 0
