# SPEC?: 61_memory_management,24_time,09_strings   # derived from the file name, to be confirmed
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [names, list<string>]
      - call: [names.push, "x"]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - idx: [names, 0, "n-${counter}"]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
