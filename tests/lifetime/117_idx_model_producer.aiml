# SPEC?: 61_memory_management,15_models,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [items, list<Item>]
      - call: [items.push, {call: [make_item, 0]}]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - idx: [items, 0, {call: [make_item, counter]}]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
