# SPEC?: 61_memory_management_DRAFT,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Outer, fields: [[inner, Item], [name, string], [dict, "map<string:string>"], [items, list<Item>]]}
- model: {name: Node, fields: [[label, string], [child, ptr<Node>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out
- def:
    name: name_of
    args: [[num, i32]]
    return: string
    body:
      - return: "name-${num}"

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [grid, list<list<string>>]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [row, list<string>]
            - call: [row.push, "r-${counter}"]
            - call: [grid.push, row]
            - idx: [grid, 0, row]
            - if: {condition: {gt: [grid.len, 3]}, then: [{call: [grid.remove, 1]}]}
            - decl: [first, list<string>, {at: [grid, 0]}]
            - call: [first.push, "p-${counter}"]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
