# SPEC?: 61_memory_management,15_models,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Outer, fields: [[inner, Item], [name, string], [dict, "map<string:string>"], [items, list<Item>]]}
- model: {name: Node, fields: [[label, string], [child, ptr<Node>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out
- def:
    name: name_of
    args: [[num, i32]]
    return: string
    body:
      - return: "name-${num}"

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [buckets, "map<string:list<Item>>"]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [bucket, list<Item>]
            - call: [bucket.push, {call: [make_item, counter]}]
            - call: [buckets.put, "b${{ '%': [counter, 4] }}", bucket]
            - decl: [got, list<Item>, {call: [buckets.get, "b1"]}]
            - if: {condition: {eq: [{ '%': [counter, 7]}, 0]}, then: [{call: [buckets.remove, "b2"]}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
