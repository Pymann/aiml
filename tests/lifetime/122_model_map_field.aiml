# SPEC?: 61_memory_management,15_models,24_time   # derived from the file name, to be confirmed
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Outer, fields: [[inner, Item], [name, string], [dict, "map<string:string>"], [items, list<Item>]]}
- model: {name: Node, fields: [[label, string], [child, ptr<Node>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out
- def:
    name: name_of
    args: [[num, i32]]
    return: string
    body:
      - return: "name-${num}"

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [outer, Outer]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - call: [outer.dict.put, "k${{ '%': [counter, 5] }}", "v-${counter}"]
            - if: {condition: {eq: [{ '%': [counter, 3]}, 0]}, then: [{call: [outer.dict.remove, "k1"]}]}
            - call: [outer.items.push, {call: [make_item, counter]}]
            - if: {condition: {gt: [outer.items.len, 4]}, then: [{call: [outer.items.remove, 0]}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
