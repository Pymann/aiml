# SPEC?: 61_memory_management,24_time,09_strings   # derived from the file name, to be confirmed
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Outer, fields: [[inner, Item], [name, string], [dict, "map<string:string>"], [items, list<Item>]]}
- model: {name: Node, fields: [[label, string], [child, ptr<Node>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out
- def:
    name: name_of
    args: [[num, i32]]
    return: string
    body:
      - return: "name-${num}"

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [text, string, "a,b,${counter}, c "]
            - decl: [parts, list<string>, {call: [text.split, ","]}]
            - decl: [sub, string, {call: [text.substr, 0, 3]}]
            - decl: [rep, string, {call: [text.replace, "a", "z"]}]
            - decl: [trimmed, string, {call: [text.trim]}]
            - decl: [low, string, {call: [text.lower]}]
            - if: {condition: {eq: [{call: [text.trim]}, "x"]}, then: [{return: 1}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
