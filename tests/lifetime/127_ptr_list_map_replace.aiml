# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Outer, fields: [[inner, Item], [name, string], [dict, "map<string:string>"], [items, list<Item>]]}
- model: {name: Node, fields: [[label, string], [child, ptr<Node>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out
- def:
    name: name_of
    args: [[num, i32]]
    return: string
    body:
      - return: "name-${num}"

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [boxes, list<ptr<Node>>]
      - call: [boxes.push, {new: Node}]
      - decl: [bymap, "map<string:ptr<Node>>"]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - idx: [boxes, 0, {new: Node}]
            - call: [bymap.put, "k", {new: Node}]
            - if: {condition: {eq: [{ '%': [counter, 3]}, 0]}, then: [{call: [bymap.remove, "k"]}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
