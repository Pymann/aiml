# SPEC?: 61_memory_management,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Outer, fields: [[inner, Item], [name, string], [dict, "map<string:string>"], [items, list<Item>]]}
- model: {name: Node, fields: [[label, string], [child, ptr<Node>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out
- def:
    name: name_of
    args: [[num, i32]]
    return: string
    body:
      - return: "name-${num}"

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [hits, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - if: {condition: {eq: [{call: [name_of, counter]}, "name-3"]}, then: [{set: [hits, {+: [hits, 1]}]}]}
            - while:
                condition: {neq: [{call: [name_of, hits]}, {call: [name_of, hits]}]}
                body: [{set: [hits, {+: [hits, 1]}]}]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
