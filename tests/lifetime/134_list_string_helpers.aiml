# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [words, list<string>]
      - call: [words.push, "a"]
      - call: [words.push, "b"]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [has, i32, {call: [words.contains, "b"]}]
            - decl: [pos, i32, {call: [words.index_of, "a"]}]
            - call: [words.insert, 0, "w-${counter}"]
            - if: {condition: {gt: [words.len, 5]}, then: [{call: [words.pop]}]}
            - call: [words.clear]
            - call: [words.push, "a"]
            - call: [words.push, "b"]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
