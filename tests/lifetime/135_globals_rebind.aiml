# SPEC?: 61_memory_management,24_time   # derived from the file name, to be confirmed
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- decl: [g_names, list<string>]
- decl: [g_item, Item]
- decl: [g_label, string, ""]
- def:
    name: touch_globals
    args: [[num, i32]]
    body:
      - call: [g_names.push, "g-${num}"]
      - if: {condition: {gt: [g_names.len, 4]}, then: [{call: [g_names.remove, 0]}]}
      - set: [g_item, {call: [make_item, num]}]
      - set: [g_label, "l-${num}"]
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - call: [touch_globals, counter]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
