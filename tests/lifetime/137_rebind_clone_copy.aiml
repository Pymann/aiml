# SPEC?: 29_3_sys_clone,61_memory_management,24_time   # derived from the file name, to be confirmed
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [base, Item, {call: [make_item, 0]}]
      - decl: [work, Item]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - set: [work, {clone: base}]
            - set: [work, {copy: base}]
            - set: [work, {call: [make_item, counter]}]
            - set: [base.label, "b-${counter}"]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
