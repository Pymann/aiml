# SPEC: 53_dyn_arrays
# static-check: off
# TIER: T2
# CONSTRUCT: the remaining container/aggregate built-ins and their disciplines (§2.1, §5).
# COVERS: array<T:N> (inline value, element-recursive drop), dyn_array<T> ({ at: [Class, 3] } rc),
#         cascade<X> (reuses list<i32>), map<K:V> ({ at: [Class, 3] }), buffer ({ at: [Class, 3] }).
#         Symbols: array<T:N>, dyn_array<T>, cascade<X>, map<K:V>, buffer.
- def:
    name: main
    return: i32
    body:
      # array<i32:N> — inline value block ({ at: [Class, 1] } storage), value-copied element-wise
      - decl: [xsarr, "array<i32:4>"]
      - idx: [xsarr, 0, 10]                            # element write = idx: (not set:[{at}])
      - idx: [xsarr, 1, 20]
      - if: { condition: { neq: [{ at: [xsarr, 1] }, 20] }, then: [{ print: ["FAIL array<i32>"] }, { return: 1 }] }
      # array<string:N> — inline, but each element is an rc string → released per element on drop
      - decl: [labels, "array<string:3>"]
      - idx: [labels, 0, "ita"]
      - if: { condition: { neq: [{ at: [labels, 0] }, "ita"] }, then: [{ print: ["FAIL array<string>"] }, { return: 1 }] }
      # dyn_array<T> — heap, runtime-sized (spec/53): new_array to allocate, idx/at to write/read,
      # .free to release. Not list's push/len — a fixed count set at allocation.
      - decl: [buf, "dyn_array<i32>", { new_array: [i32, 4] }]
      - idx: [buf, 0, 1]
      - idx: [buf, 1, 2]
      - if: { condition: { neq: [{ at: [buf, 1] }, 2] }, then: [{ print: ["FAIL dyn_array"] }, { return: 1 }] }
      - call: [buf.free]
      # map<K:V> — { at: [Class, 3] } rc container; get_copy = independent element copy (§5.4)
      - decl: [itm, "map<string:i32>"]
      - call: [itm.put, "kdx", 7]
      - if: { condition: { neq: [{ call: [itm.get, "kdx"] }, 7] }, then: [{ print: ["FAIL map"] }, { return: 1 }] }
      - decl: [kcopy, i32, { call: [itm.get_copy, "kdx"] }]   # get_copy → independent copy of the value
      - if: { condition: { neq: [kcopy, 7] }, then: [{ print: ["FAIL get_copy=${kcopy}"] }, { return: 1 }] }
      # buffer — { at: [Class, 3] } mutable byte buffer
      - decl: [bytes, buffer]
      - call: [bytes.alloc, 16]
      # cascade<X> — reuses the list<i32> layout ({ at: [Class, 3] }, same rc/aliasing discipline)
      - decl: [eff, "cascade<Effect>"]                 # Effect is a top-level cascade type
      - decl: [row, "list<i32>"]
      - call: [row.push, 3]
      - print: ["PASS 13 array_dynarray_cascade_map_buffer"]
      - return: 0
