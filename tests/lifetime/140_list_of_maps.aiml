# SPEC: 61_memory_management_DRAFT
# static-check: off
# spec/61 §5.7: list<map> elements are handles — growth, nested put, drop.
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Holder, fields: [[name, string], [box, ptr<Item>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [maps, "list<map<string:i32>>"]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [one, "map<string:i32>"]
            - call: [one.put, "k${counter}", counter]
            - call: [maps.push, one]
            - if: {condition: {gt: [maps.len, 3]}, then: [{call: [maps.remove, 0]}]}
            - decl: [first, "map<string:i32>", {at: [maps, 0]}]
            - call: [first.put, "x", 1]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
