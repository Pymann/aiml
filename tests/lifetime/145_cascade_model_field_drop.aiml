# SPEC: 61_memory_management
# static-check: off
# spec/61 §2.1: a cascade<X> model field is a Class-3 handle — released with its model.
- cascade: {name: ProbeCode, nodes: [{value: [1, i32]}]}
- model: {name: Holder, fields: [[row, cascade<ProbeCode>]]}
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 20]}
          body:
            - decl: [holder, Holder]
            - decl: [fresh, cascade<ProbeCode>]
            - call: [fresh.push, 22]
            - set: [holder.row, fresh]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
