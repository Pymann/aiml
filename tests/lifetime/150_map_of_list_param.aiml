# SPEC: 61_memory_management
# static-check: off
# spec/61 §5.7/§8: map<string:list> parameter — put/get through the param, rebind of the param.
- def:
    name: add_row
    args: [[index, map<string:list<string>>], [key, string]]
    return: list<string>
    body:
      - decl: [row, list<string>]
      - call: [row.push, "v-${key}"]
      - call: [index.put, key, row]
      - return: {call: [index.get, key]}
- def:
    name: replace_index
    args: [[index, map<string:list<string>>]]
    return: i32
    body:
      - decl: [fresh, map<string:list<string>>]
      - set: [index, fresh]
      - return: index.len
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 60]}
          body:
            - decl: [index, map<string:list<string>>]
            - decl: [got, list<string>, {call: [add_row, index, "a"]}]
            - call: [got.push, "w"]
            - decl: [again, list<string>, {call: [index.get, "a"]}]
            - if: {condition: {neq: [again.len, 2]}, then: [{return: 1}]}
            - if: {condition: {neq: [{call: [replace_index, index]}, 0]}, then: [{return: 2}]}
            - if: {condition: {neq: [index.len, 1]}, then: [{return: 3}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
