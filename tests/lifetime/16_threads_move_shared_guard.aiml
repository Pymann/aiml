# static-check: off
# TIER: T2
# CONSTRUCT: cross-thread memory model P (§5.3) — move-send + guarded shared + Class-5 primitives.
# COVERS: chan<T>, chan.send (move of an exclusive value), send_unique (runtime-checked escape),
#         spawn, guarded shared<T> + lock (payload only in the guard), Class-5 lock.
#         Symbols: chan, chan.send, send_unique, spawn, shared<T> guarded, lock.
- model: { name: Msg, fields: [[ident, i32, 0], [tags, list<string>]] }
- model: { name: Meter, fields: [[hits, i32, 0]] }

# worker receives moved Msgs and counts them via a lock-guarded shared meter
- def:
    name: worker
    args: [[inbox, chan<Msg>], [meter, shared<Meter>]]
    body:
      - decl: [itm, Msg, { call: [inbox.recv] }]     # receives a MOVED Msg (sole owner now)
      - if: { condition: { neq: [itm.ident, 1] }, then: [{ print: ["FAIL recv ident=${itm.ident}"] }] }
      - lock: [meter, [{ set: [meter.hits, { +: [meter.hits, 1] }] }]]  # guarded: payload only in guard

- def:
    name: main
    return: i32
    body:
      - decl: [chn, chan<Msg>]
      - decl: [meter, shared<Meter>, { share: { new: Meter } }]  # guarded shared (lock-bundled)
      - decl: [itt, thread_handle, { call: [spawn, worker, chn, meter] }]  # spawn: meter shared, ch moved-capable
      # build a Msg locally (exclusive) and MOVE it through the channel — zero copy
      - decl: [itm, Msg]
      - set: [itm.ident, 1]
      - call: [itm.tags.push, "hot"]
      - call: [chn.send, itm]                        # move-send: m is exclusive → moved out
      # send_unique: runtime-checked escape for a value the static analysis can't prove exclusive
      - decl: [msgb, Msg]
      - set: [msgb.ident, 1]
      - call: [chn.send_unique, msgb]                # rc==1 checked at runtime, then moved
      - call: [itt.join]
      - lock: [meter, [{ if: { condition: { neq: [meter.hits, 2] }, then: [{ print: ["FAIL hits=${meter.hits}"] }, { return: 1 }] } }]]
      - print: ["PASS 16 threads_move_shared_guard"]
      - return: 0
