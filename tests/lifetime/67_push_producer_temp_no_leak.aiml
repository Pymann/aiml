# SPEC: 61_memory_management_DRAFT
# static-check: off
# spec/61 §5.4 push: a producer call result pushed directly is a MOVE source — the list takes
# over the fresh value; its nested heap must not be orphaned (9rooms mock_state_from_match:
# mst.players.push(player_to_mock(...)) leaked each MockPlayer incl. its hand per board update).
- model: { name: Card,   fields: [[card_id, string], [title, string]] }
- model: { name: Player, fields: [[player_id, string], [hand, list<Card>]] }

- def:
    name: make_player
    args: [[num, i32]]
    return: { type: Player, lifetime: producer }
    body:
      - decl: [ply, Player]
      - set: [ply.player_id, "player_${num}@example.com"]
      - decl: [card, Card]
      - set: [card.card_id, "card_${num}_0001"]
      - set: [card.title, "Title ${num}"]
      - call: [ply.hand.push, card]
      - return: ply

- def:
    name: main
    return: i32
    body:
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, 200] }
          body:
            - decl: [players, list<Player>]
            - call: [players.push, { call: [make_player, idx] }]
            - call: [players.push, { call: [make_player, { +: [idx, 1] }] }]
            - set: [idx, { +: [idx, 1] }]
      - return: 0
