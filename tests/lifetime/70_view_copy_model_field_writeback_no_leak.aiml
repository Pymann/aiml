# SPEC: 61_memory_management
# static-check: off
# spec/61 §5.4/§5.5: like 68, but the replaced field is a nested VALUE MODEL with a heap field.
# The view copy retained the old nested value; the member store must release it.
- model: { name: Tag,   fields: [[label, string]] }
- model: { name: Entry, fields: [[peer_id, i32], [tag, Tag]] }

- def:
    name: make_tag
    args: [[num, i32]]
    return: { type: Tag, lifetime: producer }
    body:
      - decl: [tag, Tag]
      - set: [tag.label, "tag_${num}_padding"]
      - return: tag

- def:
    name: retag_all
    args: [[entries, list<Entry>], [num, i32]]
    body:
      - decl: [tci, i32, 0]
      - while:
          condition: { lt: [tci, entries.len] }
          body:
            - decl: [ent, Entry, { at: [entries, tci] }]
            - set: [ent.tag, { call: [make_tag, num] }]
            - idx: [entries, tci, ent]
            - set: [tci, { +: [tci, 1] }]

- def:
    name: main
    return: i32
    body:
      - decl: [entries, list<Entry>]
      - decl: [first, Entry]
      - set: [first.peer_id, 1]
      - set: [first.tag, { call: [make_tag, 0] }]
      - call: [entries.push, first]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, 200] }
          body:
            - call: [retag_all, entries, idx]
            - set: [idx, { +: [idx, 1] }]
      - return: 0
