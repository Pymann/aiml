# static-check: off
# spec/61 §5.5/§7: set [dst, src] on an OCCUPIED model local releases dst's old heap first.
- model: {name: Item, fields: [[text, string]]}
- def:
    name: make_item
    return: {type: Item, lifetime: producer}
    body:
      - decl: [item, Item]
      - set: [item.text, "value=${42}"]
      - return: item
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [src, Item, {call: [make_item]}]
            - decl: [dst, Item, {call: [make_item]}]
            - set: [dst, src]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
