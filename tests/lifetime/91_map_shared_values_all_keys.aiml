# static-check: off
# spec/61 §5/§6.2: shared<T> map values are decref'd on map drop for every key type; a live external owner survives.
- model: {name: Item, fields: [[text, string]]}
- enum: {name: Slot, values: [first, second, third]}
- def:
    name: main
    return: i32
    body:
      - decl: [keeper, shared<Item>, {share: {new: Item}}]
      - set: [keeper.text, "kept=${7}"]
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [by_int, "map<i32:shared<Item>>"]
            - decl: [by_enum, "map<Slot:shared<Item>>"]
            - decl: [by_str, "map<string:shared<Item>>"]
            - decl: [empty_map, "map<i32:shared<Item>>"]
            - decl: [pos, i32, 0]
            - while:
                condition: {lt: [pos, 9]}
                body:
                  - decl: [item, shared<Item>, {share: {new: Item}}]
                  - set: [item.text, "payload=${pos}"]
                  - call: [by_int.put, pos, item]
                  - set: [pos, {+: [pos, 1]}]
            - decl: [enum_item, shared<Item>, {share: {new: Item}}]
            - set: [enum_item.text, "enum=${1}"]
            - call: [by_enum.put, Slot.second, enum_item]
            - call: [by_str.put, "kept", keeper]
            - if: {condition: {neq: [by_int.len, 9]}, then: [{return: 90}]}
            - if: {condition: {neq: [by_enum.len, 1]}, then: [{return: 91}]}
            - if: {condition: {neq: [empty_map.len, 0]}, then: [{return: 92}]}
            - set: [counter, {+: [counter, 1]}]
      - if: {condition: {neq: [keeper.text, "kept=7"]}, then: [{return: 93}]}
      - return: 0
