# static-check: off
# spec/61 class 4 / spec/54 §5: an iterator is released at owner drop — no free, early free, moved into a callee (free fn, method, <.method), early return.
- def:
    name: drain_count
    args: [[kvit, iterator<string>]]
    return: i32
    body:
      - decl: [seen, i32, 0]
      - while:
          condition: { gt: [{ call: [kvit.has_next] }, 0] }
          body:
            - decl: [key, string, { call: [kvit.next] }]
            - set: [seen, { +: [seen, 1] }]
      - return: seen
- def:
    name: first_key_len
    args: [[store, Kv<string:string>]]
    return: i32
    body:
      - decl: [scan, iterator<string>, { call: [store.iter] }]
      - while:
          condition: { gt: [{ call: [scan.has_next] }, 0] }
          body:
            - decl: [key, string, { call: [scan.next] }]
            - return: key.len
      - return: 0
- class:
    name: IterDesk
    members:
      - [hits, i32]
    methods:
      - def:
          name: drain
          args: [[kvit, iterator<string>]]
          body:
            - while:
                condition: { gt: [{ call: [kvit.has_next] }, 0] }
                body:
                  - decl: [key, string, { call: [kvit.next] }]
                  - set: [<.hits, { +: [<.hits, 1] }]
      - def:
          name: scan_all
          args: [[store, Kv<string:string>]]
          body:
            - if: { condition: { gt: [<.hits, -1] }, then: [{ decl: [inner, iterator<string>, { call: [store.iter] }] }, { call: [<.drain, inner] }] }
- def:
    name: main
    return: i32
    body:
      - decl: [store, Kv<string:string>]
      - set: [store, { call: [db.open_kv, "lt94", {persist: true, path: "/tmp/lt94_kv/"}] }]
      - call: [store.set, "aa", "x"]
      - call: [store.set, "bb", "y"]
      - decl: [desk, IterDesk]
      - decl: [counter, i32, 0]
      - decl: [total, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [plain, iterator<string>, { call: [store.iter] }]
            - if: { condition: { gt: [{ call: [plain.has_next] }, 0] }, then: [{ set: [total, { +: [total, 1] }] }] }
            - decl: [early, iterator<string>, { call: [store.iter] }]
            - call: [free, early]
            - decl: [moved, iterator<string>, { call: [store.iter] }]
            - set: [total, { +: [total, { call: [drain_count, moved] }] }]
            - set: [total, { +: [total, { call: [first_key_len, store] }] }]
            - decl: [outer, iterator<string>, { call: [store.iter] }]
            - call: [desk.drain, outer]
            - call: [desk.scan_all, store]
            - set: [counter, {+: [counter, 1]}]
      - if: {condition: {neq: [total, 1000]}, then: [{return: 120}]}
      - if: {condition: {neq: [desk.hits, 800]}, then: [{return: 121}]}
      - return: 0
