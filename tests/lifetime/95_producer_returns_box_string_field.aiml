# SPEC: 61_memory_management
# static-check: off
# spec/61 §6.2/§8: a producer returning a string field of an owned ptr<T> box keeps the string and frees the whole box, also after ref<T> borrows of the box.
- model:
    name: Entry
    fields:
      - [iid, string]
      - [score, i32]
      - [tags, list<string>]
      - [stats, map<string:i32>]
- class:
    name: Slot
    members:
      - [iid, string]
      - [marks, list<string>]
- def:
    name: slot_iid
    args: [[seed, i32]]
    return: { type: string, lifetime: producer }
    body:
      - decl: [best, ptr<Slot>, { new: Slot }]
      - set: [best.iid, "slot-${seed}"]
      - call: [best.marks.push, "m-${seed}"]
      - return: best.iid
- def:
    name: bump_score
    args: [[entry, ref<Entry>], [delta, i32]]
    body:
      - set: [entry.score, {+: [entry.score, delta]}]
- def:
    name: best_iid
    args: [[seed, i32]]
    return: { type: string, lifetime: producer }
    body:
      - decl: [best, ptr<Entry>, { new: Entry }]
      - set: [best.iid, "iid-${seed}"]
      - set: [best.score, seed]
      - call: [best.tags.push, "tag-${seed}"]
      - call: [best.stats.put, "hp", seed]
      - decl: [pos, i32, 0]
      - while:
          condition: {lt: [pos, 3]}
          body:
            - call: [bump_score, best, 1]
            - set: [pos, {+: [pos, 1]}]
      - return: best.iid
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [got, string, { call: [best_iid, 7] }]
            - if: {condition: {neq: [got, "iid-7"]}, then: [{return: 130}]}
            - decl: [slot_got, string, { call: [slot_iid, 3] }]
            - if: {condition: {neq: [slot_got, "slot-3"]}, then: [{return: 131}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
