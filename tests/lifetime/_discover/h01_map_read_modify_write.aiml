# SPEC?: 61_memory_management_DRAFT,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Holder, fields: [[name, string], [box, ptr<Item>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [idx, "map<string:Item>"]
      - call: [idx.put, "k", {call: [make_item, 0]}]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [cur, Item, {call: [idx.get, "k"]}]
            - set: [cur.label, "m-${counter}"]
            - call: [cur.tags.push, "t"]
            - if: {condition: {gt: [cur.tags.len, 3]}, then: [{call: [cur.tags.clear]}]}
            - call: [idx.put, "k", cur]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
