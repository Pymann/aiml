# SPEC?: 31_db_integration,61_memory_management,15_models,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Holder, fields: [[name, string], [box, ptr<Item>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [store, Kv<string:Item>]
      - set: [store, { call: [db.open_kv, "lt_h02", {persist: false}] }]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - call: [store.set, "k${{ '%': [counter, 5] }}", {call: [make_item, counter]}]
            - decl: [got, Item, {call: [store.get_copy, "k1"]}]
            - if: {condition: {eq: [{ '%': [counter, 7]}, 0]}, then: [{call: [store.delete, "k2"]}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
