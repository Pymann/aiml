# SPEC?: 61_memory_management,24_time,09_strings   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Item, fields: [[label, string], [tags, list<string>]]}
- model: {name: Holder, fields: [[name, string], [box, ptr<Item>]]}
- def:
    name: make_item
    args: [[num, i32]]
    return: { type: Item, lifetime: producer }
    body:
      - decl: [out, Item]
      - set: [out.label, "item-${num}"]
      - call: [out.tags.push, "tag-${num}"]
      - return: out

- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [words, list<string>]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - call: [words.push, "w-${{ '%': [counter, 9] }}"]
            - call: [words.sort]
            - if: {condition: {gt: [words.len, 6]}, then: [{call: [words.remove, 0]}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
