# SPEC?: 61_memory_management_DRAFT,15_models,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- model: {name: Card, fields: [[title, string], [tags, list<string>]]}
- model: {name: Deck, fields: [[top, Card], [cards, list<Card>]]}
- def:
    name: echo_card
    args: [[card, Card]]
    return: Card
    body:
      - return: card
- def:
    name: title_of
    args: [[subject, Card]]
    return: string
    body:
      - return: subject.title
- def:
    name: tags_of
    args: [[holder, Card]]
    return: list<string>
    body:
      - return: holder.tags
- def:
    name: stash
    args: [[entry, Card], [deck, ref<Deck>]]
    body:
      - set: [deck.top, entry]
      - call: [deck.cards.push, entry]
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [deck, Deck]
      - while:
          condition: {lt: [counter, 60]}
          body:
            - decl: [card, Card]
            - set: [card.title, "c-${counter}"]
            - call: [card.tags.push, "t"]
            - decl: [copy_back, Card, {call: [echo_card, card]}]
            - set: [copy_back.title, "x"]
            - if: {condition: {neq: [card.title, "c-${counter}"]}, then: [{return: 1}]}
            - decl: [ttl, string, {call: [title_of, card]}]
            - if: {condition: {neq: [ttl, "c-${counter}"]}, then: [{return: 2}]}
            - decl: [tgs, list<string>, {call: [tags_of, card]}]
            - if: {condition: {neq: [tgs.len, 1]}, then: [{return: 3}]}
            - if:
                condition: true
                then:
                  - decl: [scoped, Card]
                  - set: [scoped.title, "s-${counter}"]
                  - call: [stash, scoped, deck]
            - if: {condition: {neq: [deck.top.title, "s-${counter}"]}, then: [{return: 4}]}
            - set: [counter, {+: [counter, 1]}]
      - if: {condition: {neq: [deck.cards.len, 60]}, then: [{return: 5}]}
      - return: 0
