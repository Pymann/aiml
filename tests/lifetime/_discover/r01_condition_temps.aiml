# SPEC?: 61_memory_management,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
- def:
    name: make_rows
    args: [[count, i32]]
    return: list<string>
    body:
      - decl: [made, list<string>]
      - decl: [pos, i32, 0]
      - while:
          condition: {lt: [pos, count]}
          body:
            - call: [made.push, "r${pos}"]
            - set: [pos, {+: [pos, 1]}]
      - return: made
- def:
    name: rows_len
    args: [[rows, list<string>]]
    return: i32
    body:
      - return: rows.len
- def:
    name: label_of
    args: [[num, i32]]
    return: string
    body:
      - return: "lbl-${num}"
- def:
    name: scan
    args: [[limit, i32]]
    return: i32
    body:
      - decl: [pos, i32, 0]
      - while:
          condition: {lt: [pos, {call: [rows_len, {call: [make_rows, limit]}]}]}
          body:
            - if: {condition: {eq: [{call: [label_of, pos]}, "lbl-3"]}, then: [{return: pos}]}
            - set: [pos, {+: [pos, 1]}]
      - return: -1
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - decl: [hits, i32, 0]
      - while:
          condition: {lt: [counter, {call: [rows_len, {call: [make_rows, 40]}]}]}
          body:
            - if: {condition: {neq: [{call: [label_of, counter]}, "zzz"]}, then: [{set: [hits, {+: [hits, 1]}]}]}
            - if: {condition: {eq: [{call: [scan, 5]}, 3]}, then: [{set: [hits, {+: [hits, 1]}]}]}
            - set: [counter, {+: [counter, 1]}]
      - if: {condition: {neq: [hits, 80]}, then: [{return: 1}]}
      - return: 0
