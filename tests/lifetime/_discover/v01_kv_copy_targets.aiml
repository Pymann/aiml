# static-check: off
- model: {name: Entry, fields: [[name, string], [tags, list<string>]]}
- model: {name: Holder, fields: [[entry, Entry], [label, string]]}
- def:
    name: main
    return: i32
    body:
      - decl: [store, Kv<string:Entry>]
      - set: [store, { call: [db.open_kv, "v01", {persist: false}] }]
      - decl: [holder, Holder]
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 40]}
          body:
            - decl: [entry, Entry]
            - set: [entry.name, "e-${counter}"]
            - call: [entry.tags.push, "t"]
            - call: [store.set, "k", entry]
            - decl: [copy1, Entry, {call: [store.get_copy, "k"]}]
            - set: [copy1, {call: [store.get_copy, "k"]}]
            - set: [holder.entry, {call: [store.get_copy, "k"]}]
            - if: {condition: {neq: [holder.entry.name, "e-${counter}"]}, then: [{return: 1}]}
            - decl: [view, ref<Entry>, {call: [store.get, "k"]}]
            - if: {condition: {neq: [view.tags.len, 1]}, then: [{return: 2}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
