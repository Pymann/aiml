# SPEC: 61_memory_management
# static-check: off
# spec/61 regression: original chain with temporary argument
# Status: verified 2026-10-02 — exit 0, 0 definite/indirect leaks, no memory errors.
- def:
    name: make_values
    return: {type: list<i32>, lifetime: producer}
    body:
    - decl: [values, list<i32>]
    - call: [values.push, 7]
    - {return: values}
- def:
    name: consume_values
    args:
    - [values, list<i32>]
    return: i32
    body:
    - {return: values.len}
- class:
    name: Factory
    methods:
    - def:
        name: make_values
        return: {type: list<i32>, lifetime: producer}
        body:
        - return:
            call: [make_values]
- class:
    name: Holder
    members:
    - [factory, ptr<Factory>]
- def:
    name: main
    return: i32
    body:
    - decl:
      - holder
      - ptr<Holder>
      - {new: Holder}
    - set:
      - holder.factory
      - {new: Factory}
    - decl: [loopidx, i32, 0]
    - while:
        condition:
          lt: [loopidx, 10]
        body:
        - decl:
          - result
          - i32
          - call:
            - consume_values
            - call: [holder.factory.make_values]
        - if:
            condition:
              neq: [result, 1]
            then:
            - {return: 1}
        - set:
          - loopidx
          - +: [loopidx, 1]
    - {return: 0}
