- def:
    name: main_part_2
    static_off: ["str_cmp"]
    args: [[hold_ref, 'ref<Holder>'], [keepfn, 'fn<list<i32>,ref<Holder>,i32:i32>']]
    return: i32
    body:
    - decl: [caught, i32, 0]
    - if:
        condition:
          neq:
          - call:
            - keepfn
            - call: [make_value]
            - hold_ref
            - 0
          - 1
        then:
        - {return: 35}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 36}
    - if:
        condition:
          neq:
          - call: [seed, hold_ref]
          - 1
        then:
        - {return: 37}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 38}
    - {return: caught}
- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
    - decl: [holder, Holder]
    - decl:
      - keeper
      - ptr<Keeper>
      - {new: KeeperImpl}
    - decl:
      - direct
      - ptr<KeeperImpl>
      - {new: KeeperImpl}
    - decl: [keepfn, 'fn<list<i32>,ref<Holder>,i32:i32>']
    - set: [keepfn, keep]
    - decl: [counter, i32, 0]
    - decl: [caught, i32, 0]
    - while:
        condition:
          lt: [counter, 40]
        body:
        - decl: [part_1, i32, {call: [main_part_1, holder, keeper, direct, keepfn]}]
        - if: {condition: {gt: [part_1, 20]}, then: [{return: part_1}]}
        - set: [caught, {+: [caught, part_1]}]
        - decl: [part_2, i32, {call: [main_part_2, holder, keepfn]}]
        - if: {condition: {gt: [part_2, 20]}, then: [{return: part_2}]}
        - set: [caught, {+: [caught, part_2]}]
        - set:
          - counter
          - +: [counter, 1]
    - if:
        condition:
          neq: [caught, 160]
        then:
        - {return: 39}
    - {return: 0}
