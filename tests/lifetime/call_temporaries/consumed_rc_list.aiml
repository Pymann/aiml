# SPEC: 61_memory_management_DRAFT
# static-check: off
# spec/61 regression: consumed list: both owner-release orders, retained temporary, throw, all four dispatch paths
# Status: verified 2026-10-02 — exit 0, 0 definite/indirect leaks, no memory errors.
- model:
    name: Holder
    fields:
    - [saved, list<i32>]
- def:
    name: make_value
    return: {type: list<i32>, lifetime: producer}
    body:
    - decl: [value, list<i32>]
    - call: [value.push, 7]
    - {return: value}
- def:
    name: keep
    args:
    - - value
      - list<i32>
      - {lifetime: consumed}
    - [holder, ref<Holder>]
    - [fail, i32]
    return: i32
    body:
    - set: [holder.saved, value]
    - if:
        condition:
          eq: [fail, 1]
        then:
        - throw: {new: Exception, message: "retained"}
    - {return: 1}
- interface:
    name: Keeper
    methods:
    - - keep
      - i32
      - - - value
          - list<i32>
          - {lifetime: consumed}
        - [holder, ref<Holder>]
        - [fail, i32]
- class:
    name: KeeperImpl
    implements: [Keeper]
    methods:
    - def:
        name: keep
        args:
        - - value
          - list<i32>
          - {lifetime: consumed}
        - [holder, ref<Holder>]
        - [fail, i32]
        return: i32
        body:
        - set: [holder.saved, value]
        - if:
            condition:
              eq: [fail, 1]
            then:
            - throw: {new: Exception, message: "retained"}
        - {return: 1}
- def:
    name: seed
    args:
    - [holder, ref<Holder>]
    return: i32
    body:
    - decl:
      - local
      - list<i32>
      - call: [make_value]
    - return:
        call: [keep, local, holder, 0]
- def:
    name: main_part_1
    static_off: ["str_cmp"]
    args: [[hold_ref, 'ref<Holder>'], [keeper, 'ref<Keeper>'], [direct, 'ref<KeeperImpl>'], [keepfn, 'fn<list<i32>,ref<Holder>,i32:i32>']]
    return: i32
    body:
    - decl: [caught, i32, 0]
    - decl:
      - caller
      - list<i32>
      - call: [make_value]
    - if:
        condition:
          neq:
          - call: [keep, caller, hold_ref, 0]
          - 1
        then:
        - {return: 31}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 32}
    - set:
      - hold_ref.saved
      - call: [make_value]
    - if:
        condition:
          neq:
          - at: [caller, 0]
          - 7
        then:
        - {return: 33}
    - try:
        body:
        - call: [keep, caller, hold_ref, 1]
        - {return: 90}
        catch:
        - type: Exception
          var: error
          body:
          - if:
              condition:
                neq: [error.message, "retained"]
              then:
              - {return: 91}
          - set:
            - caught
            - +: [caught, 1]
    - set:
      - hold_ref.saved
      - call: [make_value]
    - if:
        condition:
          neq:
          - at: [caller, 0]
          - 7
        then:
        - {return: 34}
    - if:
        condition:
          neq:
          - call:
            - keep
            - call: [make_value]
            - hold_ref
            - 0
          - 1
        then:
        - {return: 35}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 36}
    - if:
        condition:
          neq:
          - call: [direct.keep, caller, hold_ref, 0]
          - 1
        then:
        - {return: 31}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 32}
    - set:
      - hold_ref.saved
      - call: [make_value]
    - if:
        condition:
          neq:
          - at: [caller, 0]
          - 7
        then:
        - {return: 33}
    - try:
        body:
        - call: [direct.keep, caller, hold_ref, 1]
        - {return: 90}
        catch:
        - type: Exception
          var: error
          body:
          - if:
              condition:
                neq: [error.message, "retained"]
              then:
              - {return: 91}
          - set:
            - caught
            - +: [caught, 1]
    - set:
      - hold_ref.saved
      - call: [make_value]
    - if:
        condition:
          neq:
          - at: [caller, 0]
          - 7
        then:
        - {return: 34}
    - if:
        condition:
          neq:
          - call:
            - direct.keep
            - call: [make_value]
            - hold_ref
            - 0
          - 1
        then:
        - {return: 35}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 36}
    - if:
        condition:
          neq:
          - call: [keeper.keep, caller, hold_ref, 0]
          - 1
        then:
        - {return: 31}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 32}
    - set:
      - hold_ref.saved
      - call: [make_value]
    - if:
        condition:
          neq:
          - at: [caller, 0]
          - 7
        then:
        - {return: 33}
    - try:
        body:
        - call: [keeper.keep, caller, hold_ref, 1]
        - {return: 90}
        catch:
        - type: Exception
          var: error
          body:
          - if:
              condition:
                neq: [error.message, "retained"]
              then:
              - {return: 91}
          - set:
            - caught
            - +: [caught, 1]
    - set:
      - hold_ref.saved
      - call: [make_value]
    - if:
        condition:
          neq:
          - at: [caller, 0]
          - 7
        then:
        - {return: 34}
    - if:
        condition:
          neq:
          - call:
            - keeper.keep
            - call: [make_value]
            - hold_ref
            - 0
          - 1
        then:
        - {return: 35}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 36}
    - if:
        condition:
          neq:
          - call: [keepfn, caller, hold_ref, 0]
          - 1
        then:
        - {return: 31}
    - if:
        condition:
          neq:
          - at: [hold_ref.saved, 0]
          - 7
        then:
        - {return: 32}
    - set:
      - hold_ref.saved
      - call: [make_value]
    - if:
        condition:
          neq:
          - at: [caller, 0]
          - 7
        then:
        - {return: 33}
    - try:
        body:
        - call: [keepfn, caller, hold_ref, 1]
        - {return: 90}
        catch:
        - type: Exception
          var: error
          body:
          - if:
              condition:
                neq: [error.message, "retained"]
              then:
              - {return: 91}
          - set:
            - caught
            - +: [caught, 1]
    - set:
      - hold_ref.saved
      - call: [make_value]
    - if:
