# SPEC: 61_memory_management
# static-check: off
# spec/61 regression: consumed shared: both owner-release orders, retained temporary, throw, all four dispatch paths
# Status: verified 2026-10-02 — exit 0, 0 definite/indirect leaks, no memory errors.
- model:
    name: Node
    fields:
    - [label, string]
- model:
    name: Holder
    fields:
    - [saved, shared<Node>]
- def:
    name: make_value
    return: {type: shared<Node>, lifetime: producer}
    body:
    - decl:
      - value
      - shared<Node>
      - share: {new: Node}
    - set: [value.label, 'value-${3}']
    - {return: value}
- def:
    name: keep
    args:
    - - value
      - shared<Node>
      - {lifetime: consumed}
    - [holder, ref<Holder>]
    - [fail, i32]
    return: i32
    body:
    - set: [holder.saved, value]
    - if:
        condition:
          eq: [fail, 1]
        then:
        - throw: {new: Exception, message: "retained"}
    - {return: 1}
- interface:
    name: Keeper
    methods:
    - - keep
      - i32
      - - - value
          - shared<Node>
          - {lifetime: consumed}
        - [holder, ref<Holder>]
        - [fail, i32]
- class:
    name: KeeperImpl
    implements: [Keeper]
    methods:
    - def:
        name: keep
        args:
        - - value
          - shared<Node>
          - {lifetime: consumed}
        - [holder, ref<Holder>]
        - [fail, i32]
        return: i32
        body:
        - set: [holder.saved, value]
        - if:
            condition:
              eq: [fail, 1]
            then:
            - throw: {new: Exception, message: "retained"}
        - {return: 1}
- def:
    name: seed
    args:
    - [holder, ref<Holder>]
    return: i32
    body:
    - decl:
      - local
      - shared<Node>
      - call: [make_value]
    - return:
        call: [keep, local, holder, 0]
- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
    - decl: [holder, Holder]
    - decl:
      - keeper
      - ptr<Keeper>
      - {new: KeeperImpl}
    - decl:
      - direct
      - ptr<KeeperImpl>
      - {new: KeeperImpl}
    - decl: [keepfn, 'fn<shared<Node>,ref<Holder>,i32:i32>']
    - set: [keepfn, keep]
    - decl: [counter, i32, 0]
    - decl: [caught, i32, 0]
    - while:
        condition:
          lt: [counter, 40]
        body:
        - decl:
          - caller
          - shared<Node>
          - call: [make_value]
        - if:
            condition:
              neq:
              - call: [keep, caller, holder, 0]
              - 1
            then:
            - {return: 31}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 32}
        - set:
          - holder.saved
          - call: [make_value]
        - if:
            condition:
              neq: [caller.label, "value-3"]
            then:
            - {return: 33}
        - try:
            body:
            - call: [keep, caller, holder, 1]
            - {return: 90}
            catch:
            - type: Exception
              var: error
              body:
              - if:
                  condition:
                    neq: [error.message, "retained"]
                  then:
                  - {return: 91}
              - set:
                - caught
                - +: [caught, 1]
        - set:
          - holder.saved
          - call: [make_value]
        - if:
            condition:
              neq: [caller.label, "value-3"]
            then:
            - {return: 34}
        - if:
            condition:
              neq:
              - call:
                - keep
                - call: [make_value]
                - holder
                - 0
              - 1
            then:
            - {return: 35}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 36}
        - if:
            condition:
              neq:
              - call: [direct.keep, caller, holder, 0]
              - 1
            then:
            - {return: 31}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 32}
        - set:
          - holder.saved
          - call: [make_value]
        - if:
            condition:
              neq: [caller.label, "value-3"]
            then:
            - {return: 33}
        - try:
            body:
            - call: [direct.keep, caller, holder, 1]
            - {return: 90}
            catch:
            - type: Exception
              var: error
              body:
              - if:
                  condition:
                    neq: [error.message, "retained"]
                  then:
                  - {return: 91}
              - set:
                - caught
                - +: [caught, 1]
        - set:
          - holder.saved
          - call: [make_value]
        - if:
            condition:
              neq: [caller.label, "value-3"]
            then:
            - {return: 34}
        - if:
            condition:
              neq:
              - call:
                - direct.keep
                - call: [make_value]
                - holder
                - 0
              - 1
            then:
            - {return: 35}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 36}
        - if:
            condition:
              neq:
              - call: [keeper.keep, caller, holder, 0]
              - 1
            then:
            - {return: 31}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 32}
        - set:
          - holder.saved
          - call: [make_value]
        - if:
            condition:
              neq: [caller.label, "value-3"]
            then:
            - {return: 33}
        - try:
            body:
            - call: [keeper.keep, caller, holder, 1]
            - {return: 90}
            catch:
            - type: Exception
              var: error
              body:
              - if:
                  condition:
                    neq: [error.message, "retained"]
                  then:
                  - {return: 91}
              - set:
                - caught
                - +: [caught, 1]
        - set:
          - holder.saved
          - call: [make_value]
        - if:
            condition:
              neq: [caller.label, "value-3"]
            then:
            - {return: 34}
        - if:
            condition:
              neq:
              - call:
                - keeper.keep
                - call: [make_value]
                - holder
                - 0
              - 1
            then:
            - {return: 35}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 36}
        - if:
            condition:
              neq:
              - call: [keepfn, caller, holder, 0]
              - 1
            then:
            - {return: 31}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 32}
        - set:
          - holder.saved
          - call: [make_value]
        - if:
            condition:
              neq: [caller.label, "value-3"]
            then:
            - {return: 33}
        - try:
            body:
            - call: [keepfn, caller, holder, 1]
            - {return: 90}
            catch:
            - type: Exception
              var: error
              body:
              - if:
                  condition:
                    neq: [error.message, "retained"]
                  then:
                  - {return: 91}
              - set:
                - caught
                - +: [caught, 1]
        - set:
          - holder.saved
          - call: [make_value]
        - if:
            condition:
              neq: [caller.label, "value-3"]
            then:
            - {return: 34}
        - if:
            condition:
              neq:
              - call:
                - keepfn
                - call: [make_value]
                - holder
                - 0
              - 1
            then:
            - {return: 35}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 36}
        - if:
            condition:
              neq:
              - call: [seed, holder]
              - 1
            then:
            - {return: 37}
        - if:
            condition:
              neq: [holder.saved.label, "value-3"]
            then:
            - {return: 38}
        - set:
          - counter
          - +: [counter, 1]
    - if:
        condition:
          neq: [caught, 160]
        then:
        - {return: 39}
    - {return: 0}
