# static-check: off
# spec/61 regression: original fnptr_consumer with temporary argument
# Status: NOT RUN. Expected: exit 0; zero definite/indirect leaks; no memory errors.
- def:
    name: make_values
    return: {type: list<i32>, lifetime: producer}
    body:
    - decl: [values, list<i32>]
    - call: [values.push, 7]
    - {return: values}
- def:
    name: consume_values
    args:
    - [values, list<i32>]
    return: i32
    body:
    - {return: values.len}
- def:
    name: main
    return: i32
    body:
    - decl: [reader, 'fn<list<i32>:i32>']
    - set: [reader, consume_values]
    - decl: [loopidx, i32, 0]
    - while:
        condition:
          lt: [loopidx, 1000]
        body:
        - decl:
          - result
          - i32
          - call:
            - reader
            - call: [make_values]
        - if:
            condition:
              neq: [result, 1]
            then:
            - {return: 1}
        - set:
          - loopidx
          - +: [loopidx, 1]
    - {return: 0}
