# SPEC: 61_memory_management_DRAFT
# static-check: off
# spec/61 regression: original fnptr_consumer with named-owner control
# Status: verified 2026-10-02 — exit 0, 0 definite/indirect leaks, no memory errors.
- def:
    name: make_values
    return: {type: list<i32>, lifetime: producer}
    body:
    - decl: [values, list<i32>]
    - call: [values.push, 7]
    - {return: values}
- def:
    name: consume_values
    args:
    - [values, list<i32>]
    return: i32
    body:
    - {return: values.len}
- def:
    name: main
    return: i32
    body:
    - decl: [reader, 'fn<list<i32>:i32>']
    - set: [reader, consume_values]
    - decl: [loopidx, i32, 0]
    - while:
        condition:
          lt: [loopidx, 10]
        body:
        - decl:
          - temporary
          - list<i32>
          - call: [make_values]
        - decl:
          - result
          - i32
          - call: [reader, temporary]
        - if:
            condition:
              neq: [result, 1]
            then:
            - {return: 1}
        - set:
          - loopidx
          - +: [loopidx, 1]
    - {return: 0}
