# SPEC: 61_memory_management_DRAFT
# static-check: off
# spec/61 regression: original iface_consumer with temporary argument
# Status: verified 2026-10-02 — exit 0, 0 definite/indirect leaks, no memory errors.
- def:
    name: make_values
    return: {type: list<i32>, lifetime: producer}
    body:
    - decl: [values, list<i32>]
    - call: [values.push, 7]
    - {return: values}
- def:
    name: consume_values
    args:
    - [values, list<i32>]
    return: i32
    body:
    - {return: values.len}
- interface:
    name: Sink
    methods:
    - - read_values
      - i32
      - - [values, list<i32>]
- class:
    name: SinkImpl
    implements: [Sink]
    methods:
    - def:
        name: read_values
        args:
        - [values, list<i32>]
        return: i32
        body:
        - {return: values.len}
- def:
    name: main
    return: i32
    body:
    - decl:
      - sink
      - ptr<Sink>
      - {new: SinkImpl}
    - decl: [loopidx, i32, 0]
    - while:
        condition:
          lt: [loopidx, 1000]
        body:
        - decl:
          - result
          - i32
          - call:
            - sink.read_values
            - call: [make_values]
        - if:
            condition:
              neq: [result, 1]
            then:
            - {return: 1}
        - set:
          - loopidx
          - +: [loopidx, 1]
    - {return: 0}
