# static-check: off
# spec/61 regression: imported inherited producer through field chain; same-named scalar method must not affect ownership
# Status: verified 2026-10-02 — exit 0, 0 definite/indirect leaks, no memory errors.
- {import: tests/lifetime/call_temporaries/support/imported_factory.aiml}
- class: {name: DerivedFactory, extends: BaseFactory}
- class:
    name: ScalarFactory
    methods:
    - def:
        name: make
        return: i32
        body:
        - {return: 9}
- class:
    name: Holder
    members:
    - [factory, ptr<DerivedFactory>]
- def:
    name: read
    args:
    - [values, list<i32>]
    return: i32
    body:
    - return:
        at: [values, 0]
- def:
    name: main
    return: i32
    body:
    - decl:
      - holder
      - ptr<Holder>
      - {new: Holder}
    - set:
      - holder.factory
      - {new: DerivedFactory}
    - decl: [other, ScalarFactory]
    - decl: [counter, i32, 0]
    - while:
        condition:
          lt: [counter, 40]
        body:
        - if:
            condition:
              neq:
              - call:
                - read
                - call: [holder.factory.make]
              - 7
            then:
            - {return: 61}
        - if:
            condition:
              neq:
              - call: [other.make]
              - 9
            then:
            - {return: 62}
        - set:
          - counter
          - +: [counter, 1]
    - {return: 0}
