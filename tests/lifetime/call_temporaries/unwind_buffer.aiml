# static-check: off
# spec/61 regression: typed buffer temps, producer/consumer/later-argument throws, nested handlers, free+method+interface+fn
# Status: NOT RUN. Expected: exit 0; zero definite/indirect leaks; no memory errors.
- def:
    name: make_value
    args:
    - [fail, i32]
    return: {type: buffer, lifetime: producer}
    body:
    - decl: [value, buffer]
    - call: [value.alloc, 16]
    - if:
        condition:
          eq: [fail, 1]
        then:
        - throw: {new: Exception, message: producer}
    - {return: value}
- def:
    name: later
    return: i32
    body:
    - throw: {new: Exception, message: later}
    - {return: 0}
- def:
    name: sink
    args:
    - [value, buffer]
    - [fail, i32]
    return: i32
    body:
    - if:
        condition:
          neq: [value.len, 16]
        then:
        - {return: 21}
    - if:
        condition:
          eq: [fail, 1]
        then:
        - throw: {new: Exception, message: sink}
    - {return: 1}
- interface:
    name: Sink
    methods:
    - - read
      - i32
      - - [value, buffer]
        - [fail, i32]
- class:
    name: SinkImpl
    implements: [Sink]
    methods:
    - def:
        name: read
        args:
        - [value, buffer]
        - [fail, i32]
        return: i32
        body:
        - if:
            condition:
              neq: [value.len, 16]
            then:
            - {return: 21}
        - if:
            condition:
              eq: [fail, 1]
            then:
            - throw: {new: Exception, message: sink}
        - {return: 1}
- def:
    name: main
    return: i32
    body:
    - decl:
      - obj
      - ptr<Sink>
      - {new: SinkImpl}
    - decl:
      - direct
      - ptr<SinkImpl>
      - {new: SinkImpl}
    - decl: [sinkfn, 'fn<buffer,i32:i32>']
    - set: [sinkfn, sink]
    - decl: [counter, i32, 0]
    - decl: [caught, i32, 0]
    - while:
        condition:
          lt: [counter, 40]
        body:
        - if:
            condition:
              neq:
              - call:
                - sink
                - call: [make_value, 0]
                - 0
              - 1
            then:
            - {return: 22}
        - try:
            body:
            - call:
              - sink
              - call: [make_value, 0]
              - 1
            - {return: 90}
            catch:
            - type: Exception
              var: error
              body:
              - if:
                  condition:
                    neq: [error.message, sink]
                  then:
                  - {return: 91}
              - set:
                - caught
                - +: [caught, 1]
        - try:
            body:
            - call:
              - sink
              - call: [make_value, 0]
              - call: [later]
            - {return: 90}
            catch:
            - type: Exception
              var: error
              body:
              - if:
                  condition:
                    neq: [error.message, later]
                  then:
                  - {return: 91}
              - set:
                - caught
                - +: [caught, 1]
        - try:
