# SPEC?: 57_function_cascades,61_memory_management,24_time   # derived from the file name, to be confirmed
# A parameter must keep the old handle alive when its original owner is rebound.
- cascade: {name: ProbeCode, nodes: [{value: [1, i32]}]}
- model: {name: Holder, fields: [[row, cascade<ProbeCode>]]}
- def:
    name: change_owner
    args: [[row, cascade<ProbeCode>], [holder, ref<Holder>]]
    return: i32
    body:
      - decl: [fresh, cascade<ProbeCode>]
      - call: [fresh.push, 22]
      - set: [holder.row, fresh]
      - call: [row.push, 33]
      - if: {condition: {neq: [row.len, 2]}, then: [{return: 1}]}
      - if: {condition: {neq: [{call: [row.get, 0]}, 11]}, then: [{return: 2}]}
      - return: 0
- def:
    name: main
    return: i32
    body:
      - decl: [holder, Holder]
      - if:
          condition: true
          then:
            - decl: [seed, cascade<ProbeCode>]
            - call: [seed.push, 11]
            - set: [holder.row, seed]
      - decl: [result, i32, {call: [change_owner, holder.row, holder]}]
      - if: {condition: {neq: [result, 0]}, then: [{return: result}]}
      - if: {condition: {neq: [holder.row.len, 1]}, then: [{return: 3}]}
      - return: 0
