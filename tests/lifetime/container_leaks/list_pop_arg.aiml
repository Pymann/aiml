# SPEC?: 61_memory_management,24_time   # derived from the file name, to be confirmed
# static-check: off
# Spec 61 container audit: B6; target: correct content, 0 lost bytes, no memory errors.
- def:
    name: observe
    args: [[text, string]]
    body:
      - if: {condition: {neq: [text, "value=42"]}, then: [{call: [sys.exit, 27]}]}
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [lines, list<string>]
            - call: [lines.push, "value=${42}"]
            - call: [observe, {call: [lines.pop]}]
            - if: {condition: {neq: [lines.len, 0]}, then: [{return: 23}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
