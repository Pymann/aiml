# SPEC?: 61_memory_management_DRAFT,15_models,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
# Spec 61 container audit: B4; target: correct content, 0 lost bytes, no memory errors.
- model: {name: Item, fields: [[text, string]]}
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [index, "map<string:Item>"]
            - decl: [item, Item]
            - set: [item.text, "payload=${42}"]
            - call: [index.put, "key", item]
            - call: [index.remove, "key"]
            - if: {condition: {neq: [index.len, 0]}, then: [{return: 21}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
