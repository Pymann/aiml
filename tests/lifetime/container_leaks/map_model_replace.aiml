# SPEC?: 61_memory_management,15_models,24_time   # derived from the file name, to be confirmed
# static-check: off
# Spec 61 container audit: B5; target: correct content, 0 lost bytes, no memory errors.
- model: {name: Item, fields: [[text, string]]}
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [index, "map<string:Item>"]
            - decl: [first, Item]
            - set: [first.text, "first=${42}"]
            - call: [index.set, "key", first]
            - decl: [second, Item]
            - set: [second.text, "second=${42}"]
            - call: [index.set, "key", second]
            - if: {condition: {neq: [index.len, 1]}, then: [{return: 21}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
