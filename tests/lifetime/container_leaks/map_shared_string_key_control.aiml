# SPEC?: 61_memory_management,24_time,09_strings   # aus dem Dateinamen, zu bestaetigen
# static-check: off
# Spec 61 container audit: control; target: correct content, 0 lost bytes, no memory errors.
- model: {name: Item, fields: [[text, string]]}
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [index, "map<string:shared<Item>>"]
            - decl: [item, shared<Item>, {share: {new: Item}}]
            - set: [item.text, "payload=${42}"]
            - call: [index.put, "key", item]
            - if: {condition: {neq: [index.len, 1]}, then: [{return: 21}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
