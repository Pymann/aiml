# SPEC?: 61_memory_management,24_time,09_strings   # derived from the file name, to be confirmed
# static-check: off
# Spec 61 container audit: control; target: correct content, 0 lost bytes, no memory errors.
- def:
    name: main
    return: i32
    body:
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 200]}
          body:
            - decl: [index, "map<string:string>"]
            - call: [index.put, "key", "payload=${42}"]
            - call: [index.remove, "key"]
            - if: {condition: {neq: [index.len, 0]}, then: [{return: 21}]}
            - set: [counter, {+: [counter, 1]}]
      - return: 0
