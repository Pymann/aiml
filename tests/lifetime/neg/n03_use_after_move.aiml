# SPEC?: 61_memory_management_DRAFT,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
# NEGATIVE (§6.2/§10): using a ptr<T> after it was MOVED (pushed into a container) is an error.
# EXPECT-ERROR: use-after-move
- model: { name: Wid, fields: [[ident, i32, 0]] }
- def:
    name: main
    return: i32
    body:
      - decl: [box, ptr<Wid>, { new: Wid }]
      - decl: [pool, list<ptr<Wid>>]
      - call: [pool.push, box]              # box moved into pool
      - set: [box.ident, 9]                 # ← use-after-move
      - return: 0
