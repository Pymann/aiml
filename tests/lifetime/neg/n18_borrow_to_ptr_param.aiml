# SPEC: 61_memory_management
# EXPECT-ERROR: owning ptr<T> parameter
# spec/61 §8: a ptr<T> parameter takes ownership — a borrow (&x, a field, an element) cannot be passed; use ref<T>.
- model: {name: Card, fields: [[title, string]]}
- model: {name: Holder, fields: [[card, ptr<Card>]]}
- def:
    name: sink_card
    args: [[sunk, ptr<Card>]]
    return: i32
    body:
      - return: sunk.title.len
- def:
    name: main
    return: i32
    body:
      - decl: [holder, Holder]
      - set: [holder.card, {new: Card}]
      - decl: [res, i32, {call: [sink_card, holder.card]}]
      - return: 0
