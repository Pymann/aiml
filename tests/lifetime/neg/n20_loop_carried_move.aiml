# EXPECT-ERROR: use-after-move
# spec/61 §8/§10: a ptr<T> moved into a parameter inside a loop is gone in the next iteration.
- model: {name: Card, fields: [[title, string]]}
- def:
    name: sink_card
    args: [[sunk, ptr<Card>]]
    return: i32
    body:
      - return: sunk.title.len
- def:
    name: main
    return: i32
    body:
      - decl: [box, ptr<Card>, {new: Card}]
      - decl: [counter, i32, 0]
      - while:
          condition: {lt: [counter, 3]}
          body:
            - decl: [res, i32, {call: [sink_card, box]}]
            - set: [counter, {+: [counter, 1]}]
      - return: 0
