# SPEC?: 61_memory_management,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
# WARN (§10 owning-cycle lint): a Ring whose owning ptr<Ring> edge points back at Ring forms an
# owning cycle with no ref<T> break → leak-prone. Must WARN (not error — compiles + runs, rc=0).
# EXPECT-WARN: owning-cycle
- model: { name: Ring, fields: [[ident, i32, 0], [nxt, ptr<Ring>]] }
- def:
    name: main
    return: i32
    body:
      - decl: [nod, ptr<Ring>, { new: Ring }]
      - set: [nod.ident, 1]
      - print: ["PASS w01 owning_cycle (warns)"]
      - return: 0
