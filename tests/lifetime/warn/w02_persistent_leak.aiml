# SPEC?: 61_memory_management,24_time   # aus dem Dateinamen, zu bestaetigen
# static-check: off
# WARN (§10 leak lint): a `persistent` box declared then never moved out / stored / returned
# reaches scope exit without escaping → leak. Must WARN (compiles + runs, rc=0).
# EXPECT-WARN: leak: persistent box
- model: { name: Wid, fields: [[ident, i32, 0]] }
- def:
    name: main
    return: i32
    body:
      - decl: [box, ptr<Wid>, { new: Wid }, { lifetime: persistent }]   # persistent, but never escapes
      - set: [box.ident, 1]
      - print: ["PASS w02 persistent_leak (warns)"]
      - return: 0
