# SPEC: 21_namespaces
# Probe for the globals lint (spec/21 §6.2 rule 5).
# Deliberately contains all three cases.

# 1. const primitive — must NOT warn (a named constant is not state).
- decl: [MAX_TRIES, i32, 5, { const: true }]
- decl: [GREETING, string, "hallo", { const: true }]

# 2. schreibbares Primitiv — warnt (geteilter veraenderlicher Zustand).
- decl: [g_counter, i32, 0]

# 3. owning global — warns with a reason (passing it on moves the ownership).
- model:
    name: LintBox
    fields:
      - [value, i32]

- decl: [g_box, ptr<LintBox>, null]

- def:
    name: main
    return: i32
    body:
      - set: [g_counter, { +: [g_counter, MAX_TRIES] }]
      - set: [g_box, { new: LintBox }]
      - call: [log.info, "${GREETING} ${g_counter}"]
      - return: 0
