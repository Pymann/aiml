# SPEC?: 21_namespaces   # derived from the file name, to be confirmed
- namespace: my.math

- def:
    name: add
    args: [[var_a, i32], [var_b, i32]]
    return: i32
    body:
      - ret: { +: [var_a, var_b] }

- def:
    name: sub
    args: [[var_a, i32], [var_b, i32]]
    return: i32
    body:
      - ret: { -: [var_a, var_b] }
