# Requires: library
# Imported library used by test_import_toplevel_order.aiml.
#
# Verifies libraryMode source-order: top-level statements run in the
# textual order they appear, even when mixing `- decl: [..., { call: [...] }]`
# with imperative `- call: [...]` and even when they reference a global
# list defined in the same file.
#
# A pre-fix hoisting compiler ("all decls first, then imperatives")
# would produce 1, 3, 5, 2, 4 instead of 1, 2, 3, 4, 5.
#
# Note: mark returns i32 so the `decl: [var_a, i32, {call: [mark, ...]}]`
# initializer is well-typed.  Void-call init is a separate orthogonal
# concern.

- decl: [order_log, list<i32>]

- def:
    name: mark
    args: [[var_v, i32]]
    return: i32
    body:
      - call: [order_log.push, var_v]
      - return: var_v

- def:
    name: order_lib_len
    return: i32
    body:
      - return: order_log.len

- def:
    name: order_lib_at
    args: [[var_i, i32]]
    return: i32
    body:
      - return: { at: [order_log, var_i] }

# Interleaved top-level: must execute in source order 1, 2, 3, 4, 5.
- decl: [var_a, i32, { call: [mark, 1] }]
- call: [mark, 2]
- decl: [var_b, i32, { call: [mark, 3] }]
- call: [mark, 4]
- decl: [var_c, i32, { call: [mark, 5] }]
