# SPEC: 70_performance
# Requires: driver
# EXPECT-ERROR: unknown statement 'for'
# The error arises in the parse/AST pass, so --parse-only MUST report it
# (spec/70 F70-91) -- otherwise the switch would be a silent shortcut.
- def:
    name: main
    return: i32
    body:
      - decl: [nums, list<i32>, [1, 2, 3]]
      - for: [num, nums]
        body:
          - call: [log.info, "${num}"]
      - return: 0
