# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# F62-17: `host:` traegt NAMEN, nie name=value — ein Wert im Quelltext waere
# Requires: driver
# ein Geheimnis im Quelltext.
- pipeline:
    name: with_host_value
    params:
      - [arch, string, [x86_64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: first, host: ["PKG=secret"], return: i32, body: [{ return: 0 }] }
