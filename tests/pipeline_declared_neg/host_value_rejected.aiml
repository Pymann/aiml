# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# F62-17: `host:` carries NAMES, never name=value — a value in the source text would be
# Requires: driver
# a secret in the source text.
- pipeline:
    name: with_host_value
    params:
      - [arch, string, [x86_64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: first, host: ["PKG=secret"], return: i32, body: [{ return: 0 }] }
