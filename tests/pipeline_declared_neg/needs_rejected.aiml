# SPEC: 62_pipelines
# F62-9: a step's `needs:` names an EARLIER step.  One that names no step is
# Requires: driver
# rejected, not ignored — a discarded need would be a pipeline that runs in the
# wrong order and reports green while doing so.
- pipeline:
    name: with_needs
    params:
      - [arch, string, [x86_64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: first, needs: [other], return: i32, body: [{ return: 0 }] }
