# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# F62-111: `needs:` is not covered yet and is REJECTED, not
# Requires: driver
# ignored — a discarded needs would be a pipeline that runs in the wrong
# order and reports green while doing so.
- pipeline:
    name: with_needs
    params:
      - [arch, string, [x86_64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: first, needs: [other], return: i32, body: [{ return: 0 }] }
