# SPEC: 62_pipelines §18.5
# F110-127: old key names are REJECTED and name the new one.  Two
# Requires: driver
# spellings for the same thing are never resolved later by anyone — and the
# COMPILER says so, not every host for itself (§20.2 F62-150).
- pipeline:
    name: alte_namen
    runs_on: x86_64
    steps:
      - stage:
          name: eins
          steps:
            - step: { name: erster, return: i32, body: [{ return: 0 }] }
