# SPEC: 62_pipelines §18.1
# F62-124: `push:` schreibt ein Abbild — eine Nebenwirkung, die es lokal nicht
# gibt.  Lieber eine Diagnose mit Weg als eine verschluckte Zusage.
- pipeline:
    name: with_push
    params: { arch: [x86_64] }
    push: [{ from: one, to: "oci:deploy/oci/probe" }]
    stages:
      - stage:
          name: one
          steps:
            - step: { name: first, return: i32, body: [{ return: 0 }] }
