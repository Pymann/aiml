# SPEC: 62_pipelines §18.6
# F62-167: a stage that binds secrets and says `cache: pure` claims a reuse
# that cannot be true.
# Requires: driver
- pipeline:
    name: geheim_und_rein
    steps:
      - stage:
          name: hochladen
          cache: pure
          secrets:
            - { name: deploy, env: DEPLOY }
          run: "true"
