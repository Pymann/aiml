# SPEC: 62_pipelines §18.6
# F62-165: a secret entry is { name, env } — no value, no other key.
# Requires: driver
- pipeline:
    name: wert_im_klartext
    steps:
      - stage:
          name: hochladen
          secrets:
            - { name: deploy, env: DEPLOY, value: "hunter22" }
          run: "true"
