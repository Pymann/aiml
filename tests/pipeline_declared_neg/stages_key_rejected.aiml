# SPEC: 62_pipelines §5.0
# F62-57: a pipeline lists its stages under `steps:`, a stage lists its
# Requires: driver
# steps under it.  The rewrite read `stages:` until 2026-10-25 — the spec
# says `steps:`, so the rewrite says it too.
- pipeline:
    name: falscher_listenname
    stages:
      - stage:
          name: eins
          steps:
            - step: { name: erster, return: i32, body: [{ return: 0 }] }
