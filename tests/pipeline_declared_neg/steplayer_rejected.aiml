# SPEC: 62_pipelines §18.5
# F110-125: the default FOLLOWS from `image:` and is not guessed;
# Requires: driver
# contradictory settings are rejected instead of letting one of them
# win.
- pipeline:
    name: widerspruch
    image: ubuntu-base
    steps:
      - stage:
          name: eins
          steplayer: none
          steps:
            - step: { name: erster, return: i32, body: [{ return: 0 }] }
