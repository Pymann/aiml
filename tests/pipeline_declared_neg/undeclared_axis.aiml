# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# F62-110: ${mode} ist nicht deklariert (args nennt nur arch) -> im erzeugten
# Requires: driver
# Rumpf eine undefinierte Variable.  Der Fehler, den F62-7 verlangt, faellt
# aus der Umschreibung heraus.
- pipeline:
    name: blind_key
    params:
      - [arch, string, [x86_64]]
      - [mode, string, [debug]]
    steps:
      - stage:
          name: one
          steps:
            - step:
                name: first
                args: [arch]
                return: i32
                body:
                  - call: [io.write_file, "out.txt", "${mode}"]
                  - return: 0
