# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# F62-110: ${mode} is not declared (args only names arch) -> in the generated
# Requires: driver
# body an undefined variable.  The error that F62-7 demands falls
# out of the rewrite.
- pipeline:
    name: blind_key
    params:
      - [arch, string, [x86_64]]
      - [mode, string, [debug]]
    steps:
      - stage:
          name: one
          steps:
            - step:
                name: first
                args: [arch]
                return: i32
                body:
                  - call: [io.write_file, "out.txt", "${mode}"]
                  - return: 0
