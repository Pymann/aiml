# SPEC: 62_pipelines §20.5
# What the compiler does not know is an error — not a silent
# Requires: driver
# no-op.  Exactly that makes a second check in the controller
# unnecessary.
- pipeline:
    name: fremder_schluessel
    bildnis: ubuntu-base
    steps:
      - stage:
          name: eins
          steps:
            - step: { name: erster, return: i32, body: [{ return: 0 }] }
