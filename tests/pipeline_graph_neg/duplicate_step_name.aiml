# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# Requires: driver
# F62-9: step names are UNIQUE in the pipeline — otherwise it cannot be
# decided which step a `needs` means.
- pipeline:
    name: dup_names
    params:
      - [arch, string, [x86_64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: twice, return: i32, body: [{ return: 0 }] }
            - step: { name: twice, return: i32, body: [{ return: 0 }] }
