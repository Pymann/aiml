# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# Requires: driver
# F62-9: `needs` may only name EARLIER steps; an unknown name is
# an error and not an edge that silently drops out.
- pipeline:
    name: bad_need
    params:
      - [arch, string, [x86_64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: first, needs: [gibtsnicht], return: i32, body: [{ return: 0 }] }
