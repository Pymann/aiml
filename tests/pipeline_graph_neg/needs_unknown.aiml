# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# Requires: driver
# F62-9: `needs` darf nur FRUEHERE Schritte nennen; ein unbekannter Name ist
# ein Fehler und nicht eine Kante, die stillschweigend entfaellt.
- pipeline:
    name: bad_need
    params:
      - [arch, string, [x86_64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: first, needs: [gibtsnicht], return: i32, body: [{ return: 0 }] }
