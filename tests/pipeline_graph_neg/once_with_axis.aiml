# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# Requires: driver
# F62-115: `per: once` with a declared axis is an error — there is ONE
# result for the whole matrix, so it cannot depend on an axis.
- pipeline:
    name: once_axis
    params:
      - [arch, string, [x86_64, arm64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: shared, per: once, args: [arch], return: i32, body: [{ return: 0 }] }
