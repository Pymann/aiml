# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# Requires: driver
# F62-115: `per: once` mit deklarierter Achse ist ein Fehler — es gibt EIN
# Ergebnis fuer die ganze Matrix, also kann es nicht von einer Achse haengen.
- pipeline:
    name: once_axis
    params:
      - [arch, string, [x86_64, arm64]]
    steps:
      - stage:
          name: one
          steps:
            - step: { name: shared, per: once, args: [arch], return: i32, body: [{ return: 0 }] }
