# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# Computed path: a WARNING, not an error — not statically decidable, and
# Requires: driver
# claiming anything else would be dishonest (F62-20).
- def:
    name: body_read_rel
    args: [[stem, string]]
    return: i32
    body:
      - decl: [full, string, "out/${stem}.txt"]
      - decl: [txt, string, { call: [io.read_file, full] }]
      - if: { condition: { eq: [txt.len, 0] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [pkg, Code, { call: [sys.bundle, "body_read_rel", { context: true, pure: true }] }]
      - return: 0
