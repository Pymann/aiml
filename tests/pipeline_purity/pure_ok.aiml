# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# Pure body: only computing and log (log is always allowed, §10.2).
# Requires: driver
# No purity diagnostic expected.
- def:
    name: body_ok
    return: i32
    body:
      - decl: [val, i32, { '*': [6, 7] }]
      - call: [log.info, "rechne"]
      - if: { condition: { neq: [val, 42] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [pkg, Code, { call: [sys.bundle, "body_ok", { context: true, pure: true }] }]
      - return: 0
