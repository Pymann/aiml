# SPEC?: 62_pipelines   # derived from the file name, to be confirmed
# sys.env bleibt verboten, auch MIT assert_pure: es gibt eine aiml-Alternative
# Requires: driver
# (host:), also keinen Grund fuer eine Ausnahme (F62-22).
- def:
    name: body_env
    return: i32
    body:
      - decl: [who, string, { call: [sys.env, "HOME"] }]
      - if: { condition: { eq: [who.len, 0] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [pkg, Code, { call: [sys.bundle, "body_env", { context: true, pure: true, assert_pure: true }] }]
      - return: 0
