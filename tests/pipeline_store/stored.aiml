# Requires: driver
# The pipeline of tests/pipeline_store/run.sh (spec/62 F62-24/24a): two lanes, a pure step whose
# result a pure successor reads, and an opaque step that is never stored.
- pipeline:
    name: stored
    params:
      - [mode, string, [debug, release]]
    steps:
      - stage:
          name: work
          steps:
            - step:
                name: produce
                cache: pure
                args: [mode]
                return: string
                body:
                  - return: "built-${mode}"
            - step:
                name: consume
                needs: [produce]
                cache: pure
                args: [mode]
                return: string
                body:
                  - return: "used-${produce}"
            - step:
                name: always
                cache: opaque
                args: []
                return: i32
                body:
                  - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [pipe, pipeline, { call: [stored] }]
      - decl: [envm, map<string:string>, { call: [sys.env] }]
      - if:
          condition: { call: [envm.contains, "STORE_FOR_VALUE"] }
          then:
            - call: [pipe.set_store, { call: [envm.get, "STORE_FOR_VALUE"] }]
      - decl: [rc_run, i32, { call: [pipe.run] }]
      - print: ["ran ${pipe.ran_count} reused ${pipe.reused_count} rc ${rc_run}"]
      - return: rc_run
