# SPEC: 44_8_prefab_static
# Requires: driver
# EXPECT: F44_8-2
# EXPECT-SEV: warning
- prefab:
    name: SidePanel
    width: 150
    height: 100
    children:
      - { name: overhang, type: button, pos_x: 100, pos_y: 10, width: 100, height: 30 }   # <<HERE
- def:
    name: main
    return: i32
    body:
      - decl: [panel, prefab_instance, { call: [engine.instantiate, "SidePanel"] }]
      - decl: [hit, i32, { call: [panel.child_clicked, "overhang"] }]
      - return: 0
