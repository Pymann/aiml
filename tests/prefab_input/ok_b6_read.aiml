# SPEC: 44_8_prefab_static
# Requires: driver
# EXPECT-SILENT: das Widget wird gelesen
- prefab:
    name: QuietForm
    width: 200
    height: 80
    children:
      - { name: submit_btn, type: button, pos_x: 10, pos_y: 10, width: 120, height: 30 }
- def:
    name: main
    return: i32
    body:
      - decl: [form, prefab_instance, { call: [engine.instantiate, "QuietForm"] }]
      - decl: [hit, i32, { call: [form.child_clicked, "submit_btn"] }]
      - return: 0
