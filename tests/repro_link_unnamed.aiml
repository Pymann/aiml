# Repro test for the linker bug `undefined reference to __unnamed_<N>`.
#
# Observed while building tul_train after introducing BaseCfg
# inheritance + sys.serialize/deserialize from main.aiml. main.o
# references `__unnamed_210` (or a similar index), nobody
# defines the symbol.
#
# Suspicion: schema registry / fptable / serialize glue produces an
# external symbol reference that is not emitted if:
#   - a Cfg model inherits from a base declared in ANOTHER file
#     (BaseCfg in cfg_base.aiml, TulTrainCfg in tul_config.aiml)
#   - sys.serialize / sys.deserialize is called
#
# Test strategy: a minimal multi-file build that uses the same structure.
# If a linker error occurs → repro confirmed.
# If not → the bug is more specific, further narrowing down needed.

- import: "tests/repro_link_unnamed_base.aiml"

# ReproToolCfg is defined in the base file (with the full TulTrainCfg structure).
# Here only helpers in the same file as main, which add many small functions analogous to
# main.aiml's expand_glob/build_default_bpe_tag helpers.

- def:
    name: local_helper_a
    args: [[var_s, string]]
    return: string
    body:
      - print: ["local_helper_a input=${var_s}"]
      - return: [var_s]

- def:
    name: local_helper_b
    args: [[var_s, string]]
    return: i32
    body:
      - print: ["local_helper_b parse=${var_s}"]
      - return: [{ call: [var_s.len] }]

- def:
    name: local_helper_c
    args: [[var_a, i32], [var_b, i32]]
    return: i32
    body:
      - print: ["local_helper_c var_a=${var_a} var_b=${var_b}"]
      - return: [{ +: [var_a, var_b] }]

- def:
    name: main
    args: []
    return: i32
    body:
      # Mimics main.aiml's load_train_cfg pattern.
      - decl: [cfg, ReproToolCfg]
      - call: [sys.arg_dump, cfg]
      - set: [cfg.config, "/tmp/x.json"]
      - print: ["cfg loaded"]
      # Cross-module function calls: forces main.o to emit the fptable slots for
      # these functions (with pointers into other compilation units).
      - decl: [var_a, i32, { call: [helper_a, 1] }]
      - decl: [var_b, i32, { call: [helper_b, 2] }]
      - decl: [var_c, i32, { call: [helper_c, 3] }]
      - decl: [var_d, i32, { call: [helper_d, 4] }]
      - decl: [var_e, i32, { call: [helper_e, 5] }]
      - decl: [var_f, i32, { call: [helper_f, 6] }]
      - decl: [var_g, i32, { call: [helper_g, 7] }]
      - decl: [var_h, i32, { call: [helper_h, 8] }]
      - decl: [var_i, i32, { call: [helper_i, 9] }]
      - decl: [var_j, i32, { call: [helper_j, 10] }]
      - print: ["var_a=${var_a} var_b=${var_b} var_c=${var_c} var_d=${var_d} var_e=${var_e}"]
      - print: ["var_f=${var_f} var_g=${var_g} var_h=${var_h} var_i=${var_i} var_j=${var_j}"]
      # call the local helpers too
      - decl: [var_s, string, { call: [local_helper_a, "test"] }]
      - decl: [var_n, i32, { call: [local_helper_b, "test"] }]
      - decl: [var_m, i32, { call: [local_helper_c, 1, 2] }]
      - print: ["var_s=${var_s} var_n=${var_n} var_m=${var_m}"]
      # sys.serialize: erzeugt anonymen String-Konstanten + Schema-Lookup
      - decl: [json_str, string, { call: [sys.serialize, cfg] }]
      - print: ["${json_str}"]
      # sys.deserialize: the same schema lookup path backwards
      - decl: [restored, ReproToolCfg, { call: [sys.deserialize, json_str, "ReproToolCfg"] }]
      - print: ["restored loaded"]
      - return: 0
