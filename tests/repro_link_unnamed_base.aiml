# Repro-Helper: BaseCfg + TulConfig-aequivalent + viele Hilfsfunktionen
# mit print-/log-Strings (analog train_transformer.aiml als grosses File mit
# vielen anonymen rodata-Strings).

- model:
    name: ReproBaseCfg
    fields:
      - [config, string, ""]
      - [save_config, string, ""]
      - [init_config, i32, 0]

# mid tier like TulConfig (BaseCfg + architecture fields)
- model:
    name: ReproMidCfg
    inherits: ReproBaseCfg
    fields:
      - [embed_dim, i32, 768]
      - [n_layers, i32, 8]
      - [n_heads, i32, 12]
      - [max_seq_len, i32, 512]
      - [bpe_merges, i32, 4000]
      - [max_tokens, i32, 12288]
      - [arena_mb, i32, 512]
      - [db_tag, string, ""]
      - [bpe_tag, string, ""]
      - [trajectory_epoch_stride, i32, 0]

# top tier like TulTrainCfg (all training-specific fields)
- model:
    name: ReproToolCfg
    inherits: ReproMidCfg
    fields:
      - [ff_dim, i32, 3072]
      - [train_epochs, i32, 25]
      - [learning_rate, f32, 0.0002]
      - [triplet_margin, f32, 0.5]
      - [adam_beta1, f32, 0.9]
      - [adam_beta2, f32, 0.999]
      - [adam_eps, f32, 0.00000001]
      - [n_workers, i32, 1]
      - [train_stride, i32, 0]
      - [clip_grad_norm, f32, 0.0]
      - [log_level, string, "info"]
      - [reset, i32, 0]
      - [objective, string, "all"]
      - [input, string, ""]
      - [per_file, i32, 0]
      - [pf_gamma, f32, 1.0]
      - [pf_eps, f32, 0.00000001]
      - [pf_var_floor, f32, 0.00000001]
      - [pf_trust_min, f32, 0.0]
      - [pf_beta_q, f32, 1.0]
      - [pf_lambda_prior, f32, 0.0]
      - [pf_consensus_weight, f32, 0.0]
      - [lambda_pos, f32, 0.0]
      - [gamma_conflict, f32, 1.0]
      - [lambda_time, f32, 0.0]
      - [pf_lambda_mad, f32, 0.0]
      - [pf_db_tag, string, ""]
      - [bpe_hash, string, ""]
      - [struct_tokens, i32, 0]
      - [vis_enabled, i32, 0]
      - [vis_stride, i32, 50]

# Many helper functions with many print statements — simulates
# train_transformer.aiml's large number of anonymous rodata strings.

- def:
    name: helper_a
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_a var_x=${var_x} step1"]
      - print: ["helper_a var_x=${var_x} step2"]
      - print: ["helper_a var_x=${var_x} step3"]
      - print: ["helper_a var_x=${var_x} done"]
      - return: [{ +: [var_x, 1] }]

- def:
    name: helper_b
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_b init"]
      - print: ["helper_b loop_start ${var_x}"]
      - print: ["helper_b loop_body ${var_x}"]
      - print: ["helper_b loop_end ${var_x}"]
      - return: [{ "*": [var_x, 2] }]

- def:
    name: helper_c
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_c a=${var_x}"]
      - print: ["helper_c b=${var_x}"]
      - print: ["helper_c c=${var_x}"]
      - print: ["helper_c d=${var_x}"]
      - print: ["helper_c e=${var_x}"]
      - return: [var_x]

- def:
    name: helper_d
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_d alpha=${var_x}"]
      - print: ["helper_d beta=${var_x}"]
      - print: ["helper_d gamma=${var_x}"]
      - print: ["helper_d delta=${var_x}"]
      - return: [var_x]

- def:
    name: helper_e
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_e red=${var_x}"]
      - print: ["helper_e green=${var_x}"]
      - print: ["helper_e blue=${var_x}"]
      - return: [var_x]

- def:
    name: helper_f
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_f n_layers=${var_x}"]
      - print: ["helper_f n_heads=${var_x}"]
      - print: ["helper_f embed_dim=${var_x}"]
      - print: ["helper_f ff_dim=${var_x}"]
      - return: [var_x]

- def:
    name: helper_g
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_g loss_min=${var_x}"]
      - print: ["helper_g loss_mean=${var_x}"]
      - print: ["helper_g loss_max=${var_x}"]
      - print: ["helper_g g_rms=${var_x}"]
      - print: ["helper_g p_rms=${var_x}"]
      - print: ["helper_g upd_rms=${var_x}"]
      - return: [var_x]

- def:
    name: helper_h
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_h epoch ${var_x} start"]
      - print: ["helper_h epoch ${var_x} step"]
      - print: ["helper_h epoch ${var_x} end"]
      - return: [var_x]

- def:
    name: helper_i
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_i tok_embed=${var_x}"]
      - print: ["helper_i pos_embed=${var_x}"]
      - print: ["helper_i ln_f_g=${var_x}"]
      - print: ["helper_i ln_f_b=${var_x}"]
      - print: ["helper_i w_out=${var_x}"]
      - return: [var_x]

- def:
    name: helper_j
    args: [[var_x, i32]]
    static_off: ["same_arg"]
    return: i32
    body:
      - print: ["helper_j w_q=${var_x}"]
      - print: ["helper_j w_k=${var_x}"]
      - print: ["helper_j w_v=${var_x}"]
      - print: ["helper_j w_o=${var_x}"]
      - return: [var_x]
