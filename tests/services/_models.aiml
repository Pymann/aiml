# Request/response models for the spec/66 tests (max 3 types per file, spec/49 §6).
- model:
    name: ResolveReq
    fields:
      - [purl, string, ""]
      - [release_id, string, ""]
      - [token, string, ""]        # spec/66 §6: Tokenquelle fuer RPC

- model:
    name: ResolveResp
    fields:
      - [spdx, string, ""]
      - [confidence, i32, 0]
