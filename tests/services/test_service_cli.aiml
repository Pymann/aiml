# SPEC: 66_services §4.3 — CLI transport: run_cli fills the request model from
# --flag values, calls the same body and writes the response as JSON to stdout.
# An unknown subcommand returns 1 (then it is not ours).
# Expected exit code: 0
- import: "tests/services/_models.aiml"

# The body records what arrived in the model — otherwise the test would only
# check the return values and not notice a field that was NOT filled.
- decl: [seen_purl, string, ""]

- service:
    name: CliApi
    base: "/api/v1"
    transport: [cli]
    auth: none
    endpoints:
      - def:
          name: resolve_component
          cli: [resolve]
          args: [[req, ResolveReq]]
          return: ResolveResp
          body:
            - set: [seen_purl, req.purl]
            - decl: [out, ResolveResp]
            - set: [out.spdx, req.purl]
            - set: [out.confidence, 42]
            - return: out

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [bad, i32, 0]
      - decl: [api, ptr<CliApi>, { new: CliApi }]

      - decl: [mine, list<string>, ["resolve", "--purl", "pkg:conan/zlib"]]
      - decl: [ran, i32, { call: [api.run_cli, mine] }]
      - if: { condition: { neq: [ran, 0] }, then: [{ print: ["FAIL own subcommand -> ${ran}"] }, { set: [bad, 1] }] }

      - if: { condition: { neq: [seen_purl, "pkg:conan/zlib"] }, then: [{ print: ["FAIL --purl arrived as '${seen_purl}'"] }, { set: [bad, 1] }] }

      - decl: [foreign, list<string>, ["nicht-meins"]]
      - decl: [skipped, i32, { call: [api.run_cli, foreign] }]
      - if: { condition: { neq: [skipped, 1] }, then: [{ print: ["FAIL foreign subcommand -> ${skipped}"] }, { set: [bad, 1] }] }

      - free: api
      - if: { condition: { eq: [bad, 0] }, then: [{ print: ["test_service_cli PASS"] }] }
      - return: bad
