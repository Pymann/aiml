# SPEC: 66_services §5.6 (counter-probe) — the same build gate as in the negative test, but
# the service IS used: the endpoint body and the reflection table.  Here
# §5.6 must not fire.
# Expected exit code: 0
- model:
    name: PingReq
    fields:
      - [who, string, ""]

- model:
    name: PingResp
    fields:
      - [echo, string, ""]

- service:
    name: PingApi
    base: "/v1"
    transport: [rpc]
    auth: none
    endpoints:
      - def:
          name: ping
          http: [get, "/ping"]
          roles: []
          args: [[req, PingReq]]
          return: PingResp
          body:
            - decl: [out, PingResp]
            - set: [out.echo, req.who]
            - return: out

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [req, PingReq]
      - set: [req.who, "lio"]
      - decl: [res, PingResp, { call: [PingApi_ping, req] }]
      - if: { condition: { neq: [res.echo, "lio"] }, then: [{ print: ["FAIL echo=${res.echo}"] }, { return: 1 }] }
      - decl: [rows, list<ServiceEndpoint>, { call: [PingApi__describe] }]
      - if: { condition: { neq: [rows.len, 1] }, then: [{ print: ["FAIL rows=${rows.len}"] }, { return: 2 }] }
      - print: ["test_service_used_single_file PASS"]
      - return: 0
