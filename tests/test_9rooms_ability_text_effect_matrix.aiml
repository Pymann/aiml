# static-check: off
# Smoke test: import real 9rooms ability text generator and ensure each current
# effect bytecode produces some non-empty text.
# Expected exit code: 0

- import: "tests/fixtures_9rooms/backend/ability_text.aiml"

- def:
    name: assert_non_empty_effect_text
    args: [[label, string], [ability_json, string]]
    return: i32
    body:
      - decl: [var_ab, ActiveAbility]
      - set: [var_ab, { call: [sys.deserialize, ability_json, "ActiveAbility"] }]

      # Get a stable ptr<ActiveAbility> via list.get(...) to avoid ptr/value ambiguity.
      - decl: [pool, list<ActiveAbility>]
      - call: [pool.push, var_ab]
      - decl: [abp, ref<ActiveAbility>, { call: [pool.get, 0] }]
      - decl: [txt, string, { call: [generate_ability_text, abp] }]

      - if:
          condition: { eq: [{ call: [txt.len] }, 0] }
          then:
            - print: ["FAIL ${label}: empty text"]
            - call: [sys.exit, 1]

      - print: ["${label}: ${txt}"]
      - return: 0

- def:
    name: main
    return: i32
    body:
      - call: [assert_non_empty_effect_text, "draw_card", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[1,12,1,2]]}']
      - call: [assert_non_empty_effect_text, "discard_card", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[2,2,1,1,1]]}']
      - call: [assert_non_empty_effect_text, "move_card", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[3,1,20,2]]}']
      - call: [assert_non_empty_effect_text, "destroy_card", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[4,2,2]]}']
      - call: [assert_non_empty_effect_text, "deal_damage", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[10,2,2,1,3]]}']
      - call: [assert_non_empty_effect_text, "heal_damage", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[11,1,2,1,2]]}']
      - call: [assert_non_empty_effect_text, "modify_stat", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[12,1,2,1,2,1]]}']
      - call: [assert_non_empty_effect_text, "add_passive_ability", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[20,18,1,1]]}']
      - call: [assert_non_empty_effect_text, "remove_passive_ability", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[21,18,1]]}']
      - call: [assert_non_empty_effect_text, "reveal_card", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[30,2,1,2]]}']
      - call: [assert_non_empty_effect_text, "peek_hand", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[31,2,1,2]]}']
      - call: [assert_non_empty_effect_text, "peek_deck", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[32,2,1,2]]}']
      - call: [assert_non_empty_effect_text, "counter_spell", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[40,2]]}']
      - call: [assert_non_empty_effect_text, "summon_token", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[41,1,1,2]]}']
      - call: [assert_non_empty_effect_text, "transform", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[42,1,6]]}']
      - call: [assert_non_empty_effect_text, "drain_mana", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[43,4,1,2]]}']
      - call: [assert_non_empty_effect_text, "destroy_mana", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[44,4,1,1]]}']
      - call: [assert_non_empty_effect_text, "heal_soulmage", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[45,1,1,3]]}']
      - call: [assert_non_empty_effect_text, "paralyze", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[46,2,1]]}']
      - call: [assert_non_empty_effect_text, "revive", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[47,1,2,2,1]]}']
      - call: [assert_non_empty_effect_text, "counter_trap", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[48,2]]}']
      - call: [assert_non_empty_effect_text, "cant_be_attacked", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[49,1,1]]}']
      - call: [assert_non_empty_effect_text, "soulmage_cant_be_attacked", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[50,1,1]]}']
      - call: [assert_non_empty_effect_text, "produce_mana", '{"__type":"ActiveAbility","cost_text":"","activation_cost":[],"trigger":[],"effects":[[51,4,1,2]]}']

      - print: ["9rooms ability text effect matrix PASS"]
      - return: 0
