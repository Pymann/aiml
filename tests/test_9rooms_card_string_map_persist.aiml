# Regression test: approximate 9rooms Card with string-key mana maps in typed Kv.
# Expected exit code: 0

- enum:
    name: CardType
    values:
      - any: 0
      - creature: 1
      - spell: 2
      - mana_card: 3
      - item: 4
      - fate: 5
      - primordial: 6
      - trap: 7

- enum:
    name: SpellType
    values:
      - any: 0
      - sorcery: 2
      - ceremony: 3
      - enchantment: 4
      - incantation: 5

- enum:
    name: PassiveAbility
    values:
      - flying: 1
      - armored: 18

- model:
    name: ActiveAbility
    fields:
      - [cost_text, string]
      - [activation_cost, list<i32>]
      - [trigger, list<list<i32>>]
      - [effects, list<list<i32>>]

- model:
    name: BaseCard
    fields:
      - [name, string]
      - [card_type, CardType]
      - [mkp, i32]
      - [mana_cost, map<string:i32>]
      - [description, string]
      - [passive_abilities, list<PassiveAbility>]
      - [active_abilities, list<ActiveAbility>]

- model:
    name: Card
    inherits: BaseCard
    fields:
      - [lp, i32]
      - [attack, i32]
      - [defense, i32]
      - [initiative, i32]
      - [moral, i32]
      - [movement, i32]
      - [spell_type, SpellType]
      - [equip_cost, i32]
      - [provides, map<string:i32>]
      - [skp_cost, i32]
      - [duration, i32]
      - [room_effect, i32]
      - [created_at, i64]

- def:
    name: main
    return: i32
    body:
      - decl: [db_dir, path, "/tmp/aiml_test_9rooms_card_string_map_persist/"]
      - call: [io.remove_all, db_dir]

      - decl: [j1, string, '{"__type":"Card","name":"Fire Mana","card_type":3,"mkp":2,"mana_cost":{},"description":"mana source","passive_abilities":[18],"active_abilities":[{"cost_text":"Tap","activation_cost":[1],"trigger":[[1,7]],"effects":[[10,3]]}],"lp":0,"attack":0,"defense":0,"initiative":0,"moral":0,"movement":0,"spell_type":0,"equip_cost":0,"provides":{"1":1},"skp_cost":0,"duration":0,"room_effect":0,"created_at":0}']
      - decl: [c1, Card]
      - set: [c1, { call: [sys.deserialize, j1, "Card"] }]

      - if:
          condition: { eq: [{ eq: [c1.name, "Fire Mana"] }, 0] }
          then:
            - print: ["FAIL pre_name=${c1.name}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [c1.provides.len, 1] }
          then:
            - print: ["FAIL pre_provides_len=${c1.provides.len}"]
            - call: [sys.exit, 1]
      - decl: [pre_amt, i32, { call: [c1.provides.get, "1"] }]
      - if:
          condition: { neq: [pre_amt, 1] }
          then:
            - print: ["FAIL pre_amt=${pre_amt}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [c1.passive_abilities.len, 1] }
          then:
            - print: ["FAIL pre_pa_len=${c1.passive_abilities.len}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [c1.active_abilities.len, 1] }
          then:
            - print: ["FAIL pre_aa_len=${c1.active_abilities.len}"]
            - call: [sys.exit, 1]

      - decl: [kv, Kv<string:Card>]
      - set: [kv, { call: [db.open_kv, "card_string_map_persist", {persist: true, path: db_dir}] }]
      - call: [kv.set, "mana", c1]

      - decl: [got, ptr<Card>]
      - set: [got, { call: [kv.get, "mana"] }]
      - if:
          condition: { eq: [got, null] }
          then:
            - print: ["FAIL got=null"]
            - call: [sys.exit, 1]
      - if:
          condition: { eq: [{ eq: [got.name, "Fire Mana"] }, 0] }
          then:
            - print: ["FAIL got.name=${got.name}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [got.provides.len, 1] }
          then:
            - print: ["FAIL got_provides_len=${got.provides.len}"]
            - call: [sys.exit, 1]
      - decl: [got_amt, i32, { call: [got.provides.get, "1"] }]
      - if:
          condition: { neq: [got_amt, 1] }
          then:
            - print: ["FAIL got_amt=${got_amt}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [got.passive_abilities.len, 1] }
          then:
            - print: ["FAIL got_pa_len=${got.passive_abilities.len}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [got.active_abilities.len, 1] }
          then:
            - print: ["FAIL got_aa_len=${got.active_abilities.len}"]
            - call: [sys.exit, 1]

      - call: [db.checkpoint]
      - print: ["9rooms card string map persist PASS"]
      - return: 0
