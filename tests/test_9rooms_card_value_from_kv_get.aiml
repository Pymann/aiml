# Regression test: assigning typed Kv.get(Card) into a value Card variable,
# then reading nested heap fields like provides.get("1").
# Expected exit code: 0

- enum:
    name: CardType
    values:
      - any: 0
      - creature: 1
      - spell: 2
      - mana_card: 3
      - item: 4
      - fate: 5
      - primordial: 6
      - trap: 7

- enum:
    name: SpellType
    values:
      - any: 0
      - sorcery: 2
      - ceremony: 3
      - enchantment: 4
      - incantation: 5

- enum:
    name: PassiveAbility
    values:
      - flying: 1
      - armored: 18

- model:
    name: ActiveAbility
    fields:
      - [cost_text, string]
      - [activation_cost, list<i32>]
      - [trigger, list<list<i32>>]
      - [effects, list<list<i32>>]

- model:
    name: BaseCard
    fields:
      - [name, string]
      - [card_type, CardType]
      - [mkp, i32]
      - [mana_cost, map<string:i32>]
      - [description, string]
      - [passive_abilities, list<PassiveAbility>]
      - [active_abilities, list<ActiveAbility>]

- model:
    name: Card
    inherits: BaseCard
    fields:
      - [var_lp, i32]
      - [attack, i32]
      - [defense, i32]
      - [initiative, i32]
      - [moral, i32]
      - [movement, i32]
      - [spell_type, SpellType]
      - [equip_cost, i32]
      - [provides, map<string:i32>]
      - [skp_cost, i32]
      - [duration, i32]
      - [room_effect, i32]
      - [created_at, i64]

- def:
    name: main
    return: i32
    body:
      - decl: [db_dir, path, "/tmp/aiml_test_9rooms_card_value_from_kv_get/"]
      - call: [io.remove_all, db_dir]

      - decl: [var_j1, string, '{"__type":"Card","name":"Fire Mana","card_type":3,"mkp":2,"mana_cost":{},"description":"mana source","passive_abilities":[18],"active_abilities":[{"cost_text":"Tap","activation_cost":[1],"trigger":[[1,7]],"effects":[[10,3]]}],"var_lp":0,"attack":0,"defense":0,"initiative":0,"moral":0,"movement":0,"spell_type":0,"equip_cost":0,"provides":{"1":1},"skp_cost":0,"duration":0,"room_effect":0,"created_at":0}']
      - decl: [src, Card]
      - set: [src, { call: [sys.deserialize, var_j1, "Card"] }]

      - decl: [var_kv, Kv<string:Card>]
      - set: [var_kv, { call: [db.open_kv, "card_value_from_kv_get", {persist: true, path: db_dir}] }]
      - call: [var_kv.set, "mana", src]

      - decl: [gotp, ptr<Card>]
      - set: [gotp, { call: [var_kv.get, "mana"] }]
      - if:
          condition: { eq: [gotp, null] }
          then:
            - print: ["FAIL gotp=null"]
            - call: [sys.exit, 1]

      - decl: [ptr_amt, i32, { call: [gotp.provides.get, "1"] }]
      - if:
          condition: { neq: [ptr_amt, 1] }
          then:
            - print: ["FAIL ptr_amt=${ptr_amt}"]
            - call: [sys.exit, 1]

      - decl: [gotv, Card, { call: [var_kv.get_copy, "mana"] }]
      - if:
          condition: { eq: [{ eq: [gotv.name, "Fire Mana"] }, 0] }
          then:
            - print: ["FAIL gotv.name=${gotv.name}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [gotv.provides.len, 1] }
          then:
            - print: ["FAIL gotv.provides.len=${gotv.provides.len}"]
            - call: [sys.exit, 1]

      - decl: [val_amt, i32, { call: [gotv.provides.get, "1"] }]
      - if:
          condition: { neq: [val_amt, 1] }
          then:
            - print: ["FAIL val_amt=${val_amt}"]
            - call: [sys.exit, 1]

      - print: ["9rooms card value-from-var_kv-get PASS"]
      - return: 0
