# SPEC?: 31_db_integration   # derived from the file name, to be confirmed
# Regression check: reopen the persistent Kv from a separate run.
# Run after test_aiondb_kv_reopen_1_write.aiml.
# Expected exit code: 0

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_test_aiondb_kv_reopen_20260319/"]
      - if:
          condition: { eq: [{ call: [db_path.exists] }, 0] }
          then:
            - print: ["SKIP kv_reopen_read (run test_aiondb_kv_reopen_1_write.aiml first)"]
            - return: 0

      - decl: [cfg, Kv<string:string>]
      - set: [cfg, { call: [db.open_kv, "reopen_cfg_20260319", {persist: true, path: db_path}] }]

      - decl: [mode, string]
      - set: [mode, { call: [cfg.get, "mode"] }]
      - if:
          condition: { eq: [{ eq: [mode, "battle"] }, 0] }
          then:
            - print: ["FAIL kv_reopen_read_mode=${mode}"]
            - call: [sys.exit, 1]

      - decl: [player, string]
      - set: [player, { call: [cfg.get, "player"] }]
      - if:
          condition: { eq: [{ eq: [player, "nikolai"] }, 0] }
          then:
            - print: ["FAIL kv_reopen_read_player=${player}"]
            - call: [sys.exit, 1]

      - print: ["AionDB kv reopen read PASS"]
      - return: 0
