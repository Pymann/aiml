# SPEC?: 61_memory_management   # derived from the file name, to be confirmed
# Regression check: reopen the persistent Store<T> with heap fields from a separate run.
# Run after test_aiondb_store_heap_reopen_1_write.aiml.
# Expected exit code: 0

- model:
    name: ReopenSnippet
    fields:
      - [intent, string]
      - [dependencies, list<string>]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_test_aiondb_store_heap_reopen_20260410/"]
      - if:
          condition: { eq: [{ call: [db_path.exists] }, 0] }
          then:
            - print: ["SKIP store_heap_reopen_read (run test_aiondb_store_heap_reopen_1_write.aiml first)"]
            - return: 0

      - decl: [snips, Store<ReopenSnippet>]
      - set: [snips, { call: [db.open, "reopen_heap_snippets_20260410", {persist: true, path: db_path}] }]

      - decl: [var_n, i32, snips.len]
      - if:
          condition: { neq: [var_n, 1] }
          then:
            - print: ["FAIL store_heap_reopen_read_len=${var_n}"]
            - call: [sys.exit, 1]

      - decl: [got, ref<ReopenSnippet>, { call: [snips.get, 1] }]
      - if:
          condition: { eq: [got, null] }
          then:
            - print: ["FAIL store_heap_reopen_read_get=null"]
            - call: [sys.exit, 1]
      - if:
          condition: { eq: [{ eq: [got.intent, "loop"] }, 0] }
          then:
            - print: ["FAIL store_heap_reopen_read_intent=${got.intent}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [got.dependencies.len, 2] }
          then:
            - print: ["FAIL store_heap_reopen_read_deps_len=${got.dependencies.len}"]
            - call: [sys.exit, 1]
      - if:
          condition: { eq: [{ eq: [{ at: [got.dependencies, 0] }, "stdio"] }, 0] }
          then:
            - print: ["FAIL store_heap_reopen_read_dep0=${ { at: [got.dependencies, 0] } }"]
            - call: [sys.exit, 1]
      - if:
          condition: { eq: [{ eq: [{ at: [got.dependencies, 1] }, "math"] }, 0] }
          then:
            - print: ["FAIL store_heap_reopen_read_dep1=${ { at: [got.dependencies, 1] } }"]
            - call: [sys.exit, 1]

      - print: ["AionDB store heap reopen read PASS"]
      - return: 0
