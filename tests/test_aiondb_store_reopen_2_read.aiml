# Regression check: reopen the persistent Store<T> from a separate run.
# Run after test_aiondb_store_reopen_1_write.aiml.
# Expected exit code: 0

- class:
    name: ReopenPlayer
    members: [[score, i32], [level, i32]]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_test_aiondb_store_reopen_20260319/"]
      - if:
          condition: { eq: [{ call: [db_path.exists] }, 0] }
          then:
            - print: ["SKIP store_reopen_read (run test_aiondb_store_reopen_1_write.aiml first)"]
            - return: 0

      - decl: [players, Store<ReopenPlayer>]
      - set: [players, { call: [db.open, "reopen_players_20260319", {persist: true, path: db_path}] }]

      - decl: [var_n, i32]
      - set: [var_n, { call: [players.len] }]
      - if:
          condition: { neq: [var_n, 1] }
          then:
            - print: ["FAIL store_reopen_read_len=${var_n}"]
            - call: [sys.exit, 1]

      - decl: [var_p, ptr<ReopenPlayer>]
      - set: [var_p, { call: [players.get, 1] }]
      - if:
          condition: { neq: [var_p.score, 456] }
          then:
            - print: ["FAIL store_reopen_read_score=${var_p.score}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_p.level, 9] }
          then:
            - print: ["FAIL store_reopen_read_level=${var_p.level}"]
            - call: [sys.exit, 1]

      - print: ["AionDB store reopen read PASS"]
      - return: 0
