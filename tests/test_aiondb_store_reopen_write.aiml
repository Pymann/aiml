# Regression setup: write persistent Store<T> contents for a later reopen/read test.
# Expected exit code: 0

- class:
    name: ReopenPlayer
    members: [[score, i32], [level, i32]]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_test_aiondb_store_reopen_20260319/"]
      - decl: [players, Store<ReopenPlayer>]
      - set: [players, { call: [db.open, "reopen_players_20260319", {persist: true, path: db_path}] }]

      - decl: [n, i32]
      - set: [n, { call: [players.len] }]
      - if:
          condition: { neq: [n, 0] }
          then:
            - print: ["FAIL store_reopen_write_nonempty len=${n}"]
            - call: [sys.exit, 1]

      - decl: [p, ReopenPlayer]
      - set: [p.score, 456]
      - set: [p.level, 9]

      - decl: [id, i32]
      - set: [id, { call: [players.insert, p] }]
      - if:
          condition: { neq: [id, 1] }
          then:
            - print: ["FAIL store_reopen_write_id=${id}"]
            - call: [sys.exit, 1]

      - decl: [rc, i32]
      - set: [rc, { call: [db.checkpoint] }]
      - if:
          condition: { neq: [rc, 0] }
          then:
            - print: ["FAIL store_reopen_write_checkpoint=${rc}"]
            - call: [sys.exit, 1]

      - print: ["AionDB store reopen write PASS"]
      - return: 0
