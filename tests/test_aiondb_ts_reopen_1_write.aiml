# Regression setup: write persistent TimeSeries contents for a later reopen/read test.
# Expected exit code: 0

- class:
    name: ReopenReading
    members: [[val, i32]]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_test_aiondb_ts_reopen_20260319/"]
      - decl: [var_ts, TimeSeries<ReopenReading>]
      - set: [var_ts, { call: [db.open_timeseries, "reopen_ts_20260319", {persist: true, path: db_path}] }]

      - decl: [var_r, ReopenReading]
      - set: [var_r.val, 11]
      - call: [var_ts.append, var_r, 100]
      - set: [var_r.val, 22]
      - call: [var_ts.append, var_r, 200]

      - decl: [var_rc, i32]
      - set: [var_rc, { call: [db.checkpoint] }]
      - if:
          condition: { neq: [var_rc, 0] }
          then:
            - print: ["FAIL ts_reopen_write_checkpoint=${var_rc}"]
            - call: [sys.exit, 1]

      - print: ["AionDB var_ts reopen write PASS"]
      - return: 0
