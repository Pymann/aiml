# Regression check: reopen the persistent TimeSeries from a separate run.
# Run after test_aiondb_ts_reopen_1_write.aiml.
# Expected exit code: 0

- class:
    name: ReopenReading
    members: [[val, i32]]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_test_aiondb_ts_reopen_20260319/"]
      - if:
          condition: { eq: [{ call: [db_path.exists] }, 0] }
          then:
            - print: ["SKIP ts_reopen_read (run test_aiondb_ts_reopen_1_write.aiml first)"]
            - return: 0

      - decl: [var_ts, TimeSeries<ReopenReading>]
      - set: [var_ts, { call: [db.open_timeseries, "reopen_ts_20260319", {persist: true, path: db_path}] }]

      - decl: [var_n, i32]
      - set: [var_n, { call: [var_ts.len] }]
      - if:
          condition: { neq: [var_n, 2] }
          then:
            - print: ["FAIL ts_reopen_read_len=${var_n}"]
            - call: [sys.exit, 1]

      - decl: [var_r1, ref<ReopenReading>]
      - set: [var_r1, { call: [var_ts.at, 150] }]
      - if:
          condition: { neq: [var_r1.val, 11] }
          then:
            - print: ["FAIL ts_reopen_read_150=${var_r1.val}"]
            - call: [sys.exit, 1]

      - decl: [var_r2, ref<ReopenReading>]
      - set: [var_r2, { call: [var_ts.at, 250] }]
      - if:
          condition: { neq: [var_r2.val, 22] }
          then:
            - print: ["FAIL ts_reopen_read_250=${var_r2.val}"]
            - call: [sys.exit, 1]

      - print: ["AionDB var_ts reopen read PASS"]
      - return: 0
