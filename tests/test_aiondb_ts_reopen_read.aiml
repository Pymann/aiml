# Regression check: reopen the persistent TimeSeries from a separate run.
# Run after test_aiondb_ts_reopen_write.aiml.
# Expected exit code: 0

- class:
    name: ReopenReading
    members: [[val, i32]]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_test_aiondb_ts_reopen_20260319/"]
      - if:
          condition: { "==": [{ call: [db_path.exists] }, 0] }
          then:
            - print: ["SKIP ts_reopen_read (run test_aiondb_ts_reopen_write.aiml first)"]
            - return: 0

      - decl: [ts, TimeSeries<ReopenReading>]
      - set: [ts, { call: [db.open_timeseries, "reopen_ts_20260319", {persist: true, path: db_path}] }]

      - decl: [n, i32]
      - set: [n, { call: [ts.len] }]
      - if:
          condition: { "!=": [n, 2] }
          then:
            - print: ["FAIL ts_reopen_read_len=${n}"]
            - call: [sys.exit, 1]

      - decl: [r1, ptr<ReopenReading>]
      - set: [r1, { call: [ts.at, 150] }]
      - if:
          condition: { "!=": [r1.val, 11] }
          then:
            - print: ["FAIL ts_reopen_read_150=${r1.val}"]
            - call: [sys.exit, 1]

      - decl: [r2, ptr<ReopenReading>]
      - set: [r2, { call: [ts.at, 250] }]
      - if:
          condition: { "!=": [r2.val, 22] }
          then:
            - print: ["FAIL ts_reopen_read_250=${r2.val}"]
            - call: [sys.exit, 1]

      - print: ["AionDB ts reopen read PASS"]
      - return: 0
