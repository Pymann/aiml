# Regression setup: write persistent TimeSeries contents for a later reopen/read test.
# Expected exit code: 0

- class:
    name: ReopenReading
    members: [[val, i32]]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_test_aiondb_ts_reopen_20260319/"]
      - decl: [ts, TimeSeries<ReopenReading>]
      - set: [ts, { call: [db.open_timeseries, "reopen_ts_20260319", {persist: true, path: db_path}] }]

      - decl: [r, ReopenReading]
      - set: [r.val, 11]
      - call: [ts.append, r, 100]
      - set: [r.val, 22]
      - call: [ts.append, r, 200]

      - decl: [rc, i32]
      - set: [rc, { call: [db.checkpoint] }]
      - if:
          condition: { neq: [rc, 0] }
          then:
            - print: ["FAIL ts_reopen_write_checkpoint=${rc}"]
            - call: [sys.exit, 1]

      - print: ["AionDB ts reopen write PASS"]
      - return: 0
