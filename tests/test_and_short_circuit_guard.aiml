# SPEC: 04_1_precedence,04_math
# spec/04_1 §4: `and`/`or` evaluate SHORT-circuit — "if first operand is false,
# remaining operands are not evaluated".  The most common pattern of all
# rests on this: first check whether a pointer is set, then use it.
#
# Occasion: in the cosmos client `{'&&': [{pneq: [<.live, null]}, {gt: [{call: [<.live.has]}, 0]}]}`
# passed the check and still crashed in the second operand (SIGSEGV addr=0x8) —
# the guard was ineffective because both sides were evaluated.
# Expected exit code: 0

- class:
    name: Inner
    members:
      - [value, i32]
    methods:
      - def:
          name: get_value
          return: i32
          body: [{ return: <.value }]

- class:
    name: Outer
    members:
      - [link, ptr<Inner>]

- def:
    name: main
    return: i32
    body:
      - decl: [host, ptr<Outer>, { new: Outer }]
      # The second operand must NOT run: host.link is null.
      - decl: [hits, i32, 0]
      - if:
          condition: { '&&': [{ pneq: [host.link, null] }, { gt: [{ call: [host.link.get_value] }, 0] }] }
          then: [{ set: [hits, 1] }]
      - if: { condition: { neq: [hits, 0] }, then: [{ print: ["FAIL: branch ran although the pointer is null"] }, { return: 1 }] }
      # The same guard in word form.
      - decl: [hits_word, i32, 0]
      - if:
          condition: { and: [{ pneq: [host.link, null] }, { gt: [{ call: [host.link.get_value] }, 0] }] }
          then: [{ set: [hits_word, 1] }]
      - if: { condition: { neq: [hits_word, 0] }, then: [{ print: ["FAIL: and-Zweig lief trotz null"] }, { return: 1 }] }
      # or: if the first operand is set, the second stays unread.
      - decl: [hits_or, i32, 0]
      - if:
          condition: { '||': [{ peq: [host.link, null] }, { gt: [{ call: [host.link.get_value] }, 0] }] }
          then: [{ set: [hits_or, 1] }]
      - if: { condition: { neq: [hits_or, 1] }, then: [{ print: ["FAIL: or did not take the first hit"] }, { return: 1 }] }
      - print: ["PASS and_short_circuit_guard"]
      - return: 0
