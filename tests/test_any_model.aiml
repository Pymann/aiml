# Test Any and Model Parameters

# 1. Define a Model
- class:
    name: TestModel
    members:
      - [var_id, i32, 0, {access: public}]
      - [name, string, "", {access: public}]

# 2. Function taking 'any' (void*)
- def:
    name: print_any_id
    args: [[obj, any]] 
    return: void
    body:
      # Cast back to TestModel to access fields
      - decl: [var_m, ptr<TestModel>]
      - set: [var_m, obj] # Implicit bitcast from any -> ptr<TestModel>
      - print: ["ID from Any: ${var_m.var_id}"]
      - print: ["Name from Any: ${var_m.name}"]

# 3. Function taking 'Model'
- def:
    name: process_model
    args: [[var_m, ref<TestModel>]]
    return: void
    body:
      - print: ["Processing Model: ${var_m.name}"]
      - call: [print_any_id, var_m] # Implicit cast ptr<TestModel> -> any

# 4. Main Execution
- decl: [myModel, TestModel]
- set: [myModel.var_id, 123]
- set: [myModel.name, "TestObject"]

- print: ["--- Calling process_model ---"]
- call: [process_model, myModel]

- print: ["--- Calling print_any_id directly ---"]
- call: [print_any_id, myModel]
