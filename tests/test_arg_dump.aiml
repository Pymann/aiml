# tests/test_arg_dump.aiml — Tests fuer sys.arg_dump
# Run: ./out/aiml/aiml tests/test_arg_dump.aiml -- --steps 5 --output foo.txt --scale 2.5 --verbose 1 --count 42 --db-tag myrun --output-prefix ft --limit-words 100

- model:
    name: CliArgs
    fields:
      - [steps, i32, 1]
      - [output, string, "default.txt"]
      - [scale, f32, 1.0]
      - [verbose, i32, 0]
      - [count, i64, 0]
      - [db_tag, string, ""]
      - [output_prefix, string, ""]
      - [limit_words, i32, 0]

- def:
    name: main
    args: []
    return: void
    body:
      # T1: sys.arg_dump befuellt Felder aus argv
      - decl: [cfg, CliArgs]
      - call: [sys.arg_dump, cfg]

      - print: ["cfg.steps   = ${cfg.steps}"]
      - print: ["cfg.output  = ${cfg.output}"]
      - print: ["cfg.scale   = ${cfg.scale}"]
      - print: ["cfg.verbose = ${cfg.verbose}"]
      - print: ["cfg.count   = ${cfg.count}"]

      # T1: steps >= 0
      - decl: [var_t1, i32, 0]
      - if:
          condition: { ">=": [cfg.steps, 0] }
          then:
            - set: [var_t1, 1]
      - print: ["T1: steps>=0 = ${var_t1}"]

      # T2: verbose is 0 or 1
      - decl: [var_t2, i32, 0]
      - if:
          condition: { "||": [{ eq: [cfg.verbose, 0] }, { eq: [cfg.verbose, 1] }] }
          then:
            - set: [var_t2, 1]
      - print: ["T2: verbose_ok = ${var_t2}"]

      # T3: --db-tag (hyphen in CLI) maps to db_tag field (underscore)
      - print: ["cfg.db_tag        = ${cfg.db_tag}"]
      - print: ["cfg.output_prefix = ${cfg.output_prefix}"]
      - print: ["cfg.limit_words   = ${cfg.limit_words}"]
      - decl: [var_t3, i32, 0]
      - if:
          condition: { eq: [cfg.db_tag, "myrun"] }
          then:
            - set: [var_t3, 1]
      - print: ["T3: db_tag(hyphen->underscore) = ${var_t3}"]
      - decl: [var_t4, i32, 0]
      - if:
          condition: { eq: [cfg.output_prefix, "ft"] }
          then:
            - set: [var_t4, 1]
      - print: ["T4: output_prefix(hyphen->underscore) = ${var_t4}"]
      - decl: [var_t5, i32, 0]
      - if:
          condition: { eq: [cfg.limit_words, 100] }
          then:
            - set: [var_t5, 1]
      - print: ["T5: limit_words(hyphen->underscore) = ${var_t5}"]
