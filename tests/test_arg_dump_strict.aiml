# sys.arg_dump: alias as flag name, tokens that only look like flags, strict values.
#   spec/23 F23-61  every non-bool field needs a well-formed value in its own range, else exit 1
#   spec/23 F23-62  a flag is one or two dashes plus a name; "-Flies(Tweety)" and "--5 + 1"
#                   are positional; "--" ends the flags and is never a value
#   spec/23 F23-63  an alias (spec/15 F15-9) is the flag name, normalised (dry-run -> dry_run);
#                   the collector is the field whose REAL name is `positional`
#   spec/23 F23-64  the field whose REAL name is `given` lists the real names of the fields set
# (A negative i8 is not checked here: `cast` i8 -> i32 zero-extends, a separate bug.)
# Each case runs tests/_cross/argdump_strict_child.aiml in its own process.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- class:
    name: StrictRun
    members:
      - [out, string, "", { access: public }]
      - [err, string, "", { access: public }]
    methods:
      - def:
          name: run_file
          args: [[child_file, string]]
          return: i32
          body:
            - decl: [argv, list<string>]
            - call: [argv.push, { call: [sys.exe_path] }]
            - call: [argv.push, "-r"]
            - call: [argv.push, child_file]
            - decl: [child, process, { call: [sys.exe, argv, { capture: true }] }]
            - decl: [code, i32, { call: [child.wait] }]
            - set: [<.out, child.stdout_buffer]
            - set: [<.err, child.stderr_buffer]
            - return: code
      - def:
          name: run
          args: [[extra, list<string>]]
          return: i32
          body:
            - decl: [argv, list<string>]
            - call: [argv.push, { call: [sys.exe_path] }]
            - decl: [head, list<string>, ["-r", "tests/_cross/argdump_strict_child.aiml", "--"]]
            - call: [argv.extend, head]
            - call: [argv.extend, extra]
            - decl: [child, process, { call: [sys.exe, argv, { capture: true }] }]
            - decl: [code, i32, { call: [child.wait] }]
            - set: [<.out, child.stdout_buffer]
            - set: [<.err, child.stderr_buffer]
            - return: code

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]
      - decl: [kid, ptr<StrictRun>, { new: StrictRun }]

      # ── alias: --id sets ident, the field name itself is no flag ──
      - decl: [case1, list<string>, ["--id", "7", "inspect"]]
      - call: [chk.expect_i, "alias exit", { call: [kid.run, case1] }, 0]
      - call: [chk.expect_has, "alias value", kid.out, "ident=7 "]
      - decl: [case2, list<string>, ["--ident", "7"]]
      - call: [chk.expect_i, "real name behind alias is unknown", { call: [kid.run, case2] }, 1]
      - call: [chk.expect_has, "real name message", kid.err, "unknown flag '--ident'"]

      # ── tokens that look like flags but have no name ──
      - decl: [case3, list<string>, ["fact", "add", "-Flies(Tweety)", "--5 + 1", "-", "-0.5"]]
      - call: [chk.expect_i, "dash tokens exit", { call: [kid.run, case3] }, 0]
      - call: [chk.expect_has, "dash tokens positional", kid.out, "positional=fact|add|-Flies(Tweety)|--5 + 1|-|-0.5"]
      - decl: [case4, list<string>, ["--depth", "-3", "a", "--", "--json", "--"]]
      - call: [chk.expect_i, "negative value and --", { call: [kid.run, case4] }, 0]
      - call: [chk.expect_has, "negative value", kid.out, "depth=-3 "]
      - call: [chk.expect_has, "after -- all positional", kid.out, "positional=a|--json|--"]

      # ── strict values: never a silent 1, 0 or "" ──
      - decl: [case5, list<string>, ["x", "--depth"]]
      - call: [chk.expect_i, "int without value", { call: [kid.run, case5] }, 1]
      - call: [chk.expect_has, "int without value message", kid.err, "flag '--depth' expects an integer"]
      - decl: [case6, list<string>, ["--depth", "--json"]]
      - call: [chk.expect_i, "int followed by flag", { call: [kid.run, case6] }, 1]
      - decl: [case7, list<string>, ["--depth", "12abc"]]
      - call: [chk.expect_i, "malformed int", { call: [kid.run, case7] }, 1]
      - call: [chk.expect_has, "malformed int message", kid.err, "got '12abc'"]
      - decl: [case8, list<string>, ["--small", "300"]]
      - call: [chk.expect_i, "i8 out of range", { call: [kid.run, case8] }, 1]
      - decl: [case9, list<string>, ["--ratio", "x1"]]
      - call: [chk.expect_i, "malformed real", { call: [kid.run, case9] }, 1]
      - decl: [case10, list<string>, ["--id"]]
      - call: [chk.expect_i, "string without value", { call: [kid.run, case10] }, 1]
      - decl: [case11, list<string>, ["--json=maybe"]]
      - call: [chk.expect_i, "bool with odd value", { call: [kid.run, case11] }, 1]

      # ── well-formed values still work, defaults stay when a flag is absent ──
      - decl: [case12, list<string>, ["--depth=4", "--small", "100", "--ratio", "0.25", "--json=false", "--id="]]
      - call: [chk.expect_i, "well-formed exit", { call: [kid.run, case12] }, 0]
      - call: [chk.expect_has, "well-formed values", kid.out, "ident= depth=4 small=100 ratio=25 json=0"]
      - decl: [case13, list<string>, ["--json"]]
      - call: [chk.expect_i, "switch exit", { call: [kid.run, case13] }, 0]
      - call: [chk.expect_has, "defaults kept", kid.out, "ident= depth=-1 small=0 ratio=0 json=1"]

      # ── found in review ──
      - decl: [case14, list<string>, ["--id", "--", "--json"]]
      - call: [chk.expect_i, "-- is never a value", { call: [kid.run, case14] }, 1]
      - call: [chk.expect_has, "-- after a value flag: value missing", kid.err, "flag '--id' expects a value"]
      - decl: [case15, list<string>, ["a", "b"]]
      - call: [chk.expect_i, "positional with an alias exit", { call: [kid.run, case15] }, 0]
      - call: [chk.expect_has, "positional found by its real name", kid.out, "positional=a|b"]
      - decl: [case16, list<string>, ["--dry-run", "x"]]
      - call: [chk.expect_i, "hyphenated alias exit", { call: [kid.run, case16] }, 0]
      - call: [chk.expect_has, "hyphenated alias sets the field", kid.out, "mode=x "]
      - decl: [case17, list<string>, ["--big", "18446744073709551615", "--ubyte", "255"]]
      - call: [chk.expect_i, "u64 above INT64_MAX is accepted", { call: [kid.run, case17] }, 0]
      - call: [chk.expect_has, "u8 full range", kid.out, "ubyte=255"]
      - decl: [case17b, list<string>, ["--big", "18446744073709551616"]]
      - call: [chk.expect_i, "u64 beyond 2^64-1 is rejected", { call: [kid.run, case17b] }, 1]
      - decl: [case17c, list<string>, ["--big", "-1"]]
      - call: [chk.expect_i, "u64 -1 is rejected", { call: [kid.run, case17c] }, 1]
      - decl: [case18, list<string>, ["--small", "200"]]
      - call: [chk.expect_i, "i8 200 is out of range", { call: [kid.run, case18] }, 1]
      - decl: [case19, list<string>, ["--ubyte", "-1"]]
      - call: [chk.expect_i, "u8 -1 is rejected", { call: [kid.run, case19] }, 1]
      - decl: [case20, list<string>, ["--ratio", "1e39"]]
      - call: [chk.expect_i, "f32 overflow is rejected", { call: [kid.run, case20] }, 1]
      - decl: [case21, list<string>, ["--tiny", "1e-310"]]
      - call: [chk.expect_i, "f64 underflow is a value", { call: [kid.run, case21] }, 0]
      - call: [chk.expect_has, "subnormal kept", kid.out, "tiny_small=1"]
      - decl: [case22, list<string>, ["--depth", " 12"]]
      - call: [chk.expect_i, "leading space is not a number", { call: [kid.run, case22] }, 1]

      # ── F23-64: given fields, a value equal to the default is still given ──
      - decl: [case23, list<string>, ["--depth", "-1", "x"]]
      - call: [chk.expect_i, "default value given exit", { call: [kid.run, case23] }, 0]
      - call: [chk.expect_has, "default value is recorded as given", kid.out, "given=depth\n"]
      - decl: [case24, list<string>, ["--id", "7", "--json", "--id", "8", "--dry-run", "y"]]
      - call: [chk.expect_i, "given in order exit", { call: [kid.run, case24] }, 0]
      - call: [chk.expect_has, "real names, each once, first-appearance order", kid.out, "given=ident|json|mode_name\n"]
      - decl: [case25, list<string>, ["a", "--", "--depth", "3"]]
      - call: [chk.expect_i, "nothing given exit", { call: [kid.run, case25] }, 0]
      - call: [chk.expect_has, "positional tokens are not given", kid.out, "given=\n"]
      - decl: [case26, list<string>, ["--given", "depth"]]
      - call: [chk.expect_i, "given is no flag", { call: [kid.run, case26] }, 1]
      - decl: [case27, list<string>, ["--seen", "depth"]]
      - call: [chk.expect_i, "alias of given is no flag either", { call: [kid.run, case27] }, 1]

      # ── F23-63: two fields must not answer to the same flag, and `given` is reserved ──
      - call: [chk.expect_i, "colliding alias does not compile",
               { call: [kid.run_file, "tests/_cross/argdump_alias_collision_child.aiml"] }, 1]
      - call: [chk.expect_has, "collision names both fields", kid.err, "are both set by '--mode'"]
      - call: [chk.expect_i, "alias 'given' does not compile",
               { call: [kid.run_file, "tests/_cross/argdump_alias_reserved_child.aiml"] }, 1]
      - call: [chk.expect_has, "reserved alias message", kid.err, "cannot be a flag name"]

      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL arg_dump_strict (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS arg_dump_strict"]
      - return: 0
