# sys.arg_dump: alias as flag name, tokens that only look like flags, strict values.
#   spec/15 F15-9   an alias is the external name: `[ident, ..., { alias: "id" }]` takes `--id`
#   spec/23 F23-61  a flag is one or two dashes plus a name; "-Flies(Tweety)" and "--5 + 1"
#                   are positional.  A non-bool flag needs a well-formed value, else exit 1.
# (A negative i8 is not checked here: `cast` i8 -> i32 zero-extends, a separate bug.)
# Each case runs tests/_cross/argdump_strict_child.aiml in its own process.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- class:
    name: StrictRun
    members:
      - [out, string, "", { access: public }]
      - [err, string, "", { access: public }]
    methods:
      - def:
          name: run
          args: [[extra, list<string>]]
          return: i32
          body:
            - decl: [argv, list<string>]
            - call: [argv.push, { call: [sys.exe_path] }]
            - decl: [head, list<string>, ["-r", "tests/_cross/argdump_strict_child.aiml", "--"]]
            - call: [argv.extend, head]
            - call: [argv.extend, extra]
            - decl: [child, process, { call: [sys.exe, argv, { capture: true }] }]
            - decl: [code, i32, { call: [child.wait] }]
            - set: [<.out, child.stdout_buffer]
            - set: [<.err, child.stderr_buffer]
            - return: code

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]
      - decl: [kid, ptr<StrictRun>, { new: StrictRun }]

      # ── alias: --id sets ident, the field name itself is no flag ──
      - decl: [case1, list<string>, ["--id", "7", "inspect"]]
      - call: [chk.expect_i, "alias exit", { call: [kid.run, case1] }, 0]
      - call: [chk.expect_has, "alias value", kid.out, "ident=7 "]
      - decl: [case2, list<string>, ["--ident", "7"]]
      - call: [chk.expect_i, "real name behind alias is unknown", { call: [kid.run, case2] }, 1]
      - call: [chk.expect_has, "real name message", kid.err, "unknown flag '--ident'"]

      # ── tokens that look like flags but have no name ──
      - decl: [case3, list<string>, ["fact", "add", "-Flies(Tweety)", "--5 + 1", "-", "-0.5"]]
      - call: [chk.expect_i, "dash tokens exit", { call: [kid.run, case3] }, 0]
      - call: [chk.expect_has, "dash tokens positional", kid.out, "positional=fact|add|-Flies(Tweety)|--5 + 1|-|-0.5"]
      - decl: [case4, list<string>, ["--depth", "-3", "a", "--", "--json", "--"]]
      - call: [chk.expect_i, "negative value and --", { call: [kid.run, case4] }, 0]
      - call: [chk.expect_has, "negative value", kid.out, "depth=-3 "]
      - call: [chk.expect_has, "after -- all positional", kid.out, "positional=a|--json|--"]

      # ── strict values: never a silent 1, 0 or "" ──
      - decl: [case5, list<string>, ["x", "--depth"]]
      - call: [chk.expect_i, "int without value", { call: [kid.run, case5] }, 1]
      - call: [chk.expect_has, "int without value message", kid.err, "flag '--depth' expects an integer"]
      - decl: [case6, list<string>, ["--depth", "--json"]]
      - call: [chk.expect_i, "int followed by flag", { call: [kid.run, case6] }, 1]
      - decl: [case7, list<string>, ["--depth", "12abc"]]
      - call: [chk.expect_i, "malformed int", { call: [kid.run, case7] }, 1]
      - call: [chk.expect_has, "malformed int message", kid.err, "got '12abc'"]
      - decl: [case8, list<string>, ["--small", "300"]]
      - call: [chk.expect_i, "i8 out of range", { call: [kid.run, case8] }, 1]
      - decl: [case9, list<string>, ["--ratio", "x1"]]
      - call: [chk.expect_i, "malformed real", { call: [kid.run, case9] }, 1]
      - decl: [case10, list<string>, ["--id"]]
      - call: [chk.expect_i, "string without value", { call: [kid.run, case10] }, 1]
      - decl: [case11, list<string>, ["--json=maybe"]]
      - call: [chk.expect_i, "bool with odd value", { call: [kid.run, case11] }, 1]

      # ── well-formed values still work, defaults stay when a flag is absent ──
      - decl: [case12, list<string>, ["--depth=4", "--small", "100", "--ratio", "0.25", "--json=false", "--id="]]
      - call: [chk.expect_i, "well-formed exit", { call: [kid.run, case12] }, 0]
      - call: [chk.expect_has, "well-formed values", kid.out, "ident= depth=4 small=100 ratio=25 json=0"]
      - decl: [case13, list<string>, ["--json"]]
      - call: [chk.expect_i, "switch exit", { call: [kid.run, case13] }, 0]
      - call: [chk.expect_has, "defaults kept", kid.out, "ident= depth=-1 small=0 ratio=0 json=1"]

      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL arg_dump_strict (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS arg_dump_strict"]
      - return: 0
