# test_array.aiml — Tests for array<T:N> type, { at: [...] } read, idx: [...] write
- decl: [pass, i32, 0]
- decl: [fail, i32, 0]

# === Phase A: 1D array basics ===

# A1: Declaration + zero-init
- decl: [v, "array<i32:4>"]
- decl: [a0, i32, { at: [v, 0] }]
- if:
    condition: { eq: [a0, 0] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL A1: expected 0, got ${a0}"]

# A2: Write + read back
- idx: [v, 0, 42]
- idx: [v, 1, 99]
- idx: [v, 3, -7]
- decl: [r0, i32, { at: [v, 0] }]
- decl: [r1, i32, { at: [v, 1] }]
- decl: [r3, i32, { at: [v, 3] }]
- if:
    condition: { "&&": [{ eq: [r0, 42] }, { "&&": [{ eq: [r1, 99] }, { eq: [r3, -7] }] }] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL A2: v[0]=${r0} v[1]=${r1} v[3]=${r3}"]

# A3: Dynamic index
- decl: [i, i32, 2]
- idx: [v, i, 55]
- decl: [r2, i32, { at: [v, i] }]
- if:
    condition: { eq: [r2, 55] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL A3: expected 55, got ${r2}"]

# A4: Computed index { at: [v, { "+": [i, 1] }] }
- decl: [r_comp, i32, { at: [v, { "+": [i, 1] }] }]
- if:
    condition: { eq: [r_comp, -7] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL A4: expected -7, got ${r_comp}"]

# === Phase B: Float array ===

# B1: f32 array
- decl: [fv, "array<f32:3>"]
- idx: [fv, 0, 1.5]
- idx: [fv, 1, 2.5]
- idx: [fv, 2, 3.5]
- decl: [sum, f32, 0.0]
- decl: [j, i32, 0]
- while:
    condition: { "<": [j, 3] }
    body:
      - set: [sum, { "+": [sum, { at: [fv, j] }] }]
      - set: [j, { "+": [j, 1] }]
- if:
    condition: { "&&": [{ ">": [sum, 7.4] }, { "<": [sum, 7.6] }] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL B1: expected 7.5, got ${sum}"]

# === Phase C: 2D array ===

# C1: 2D declaration + write + read
- decl: [mat, "array<i32:3:4>"]
- idx: [mat, 0, 0, 10]
- idx: [mat, 1, 2, 42]
- idx: [mat, 2, 3, 99]
- decl: [m00, i32, { at: [mat, 0, 0] }]
- decl: [m12, i32, { at: [mat, 1, 2] }]
- decl: [m23, i32, { at: [mat, 2, 3] }]
- if:
    condition: { "&&": [{ eq: [m00, 10] }, { "&&": [{ eq: [m12, 42] }, { eq: [m23, 99] }] }] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL C1: mat[0,0]=${m00} mat[1,2]=${m12} mat[2,3]=${m23}"]

# === Phase D: Properties ===

# D1: .len
- decl: [v4, "array<f32:8>"]
- decl: [len4, i32, v4.len]
- if:
    condition: { eq: [len4, 8] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL D1: expected 8, got ${len4}"]

# D2: .len on 2D
- decl: [mat2, "array<i32:3:4>"]
- decl: [len_mat, i32, mat2.len]
- if:
    condition: { eq: [len_mat, 12] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL D2: expected 12, got ${len_mat}"]

# D3: .dim0, .dim1
- decl: [d0, i32, mat2.dim0]
- decl: [d1, i32, mat2.dim1]
- if:
    condition: { "&&": [{ eq: [d0, 3] }, { eq: [d1, 4] }] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL D3: dim0=${d0} dim1=${d1}"]

# === Phase E: idx for lists (backward compat) ===

# E1: idx on list<i32>
- decl: [lst, list<i32>]
- call: [lst.push, 10]
- call: [lst.push, 20]
- call: [lst.push, 30]
- idx: [lst, 1, 99]
- decl: [lst_val, i32, { at: [lst, 1] }]
- if:
    condition: { eq: [lst_val, 99] }
    then:
      - set: [pass, { "+": [pass, 1] }]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL E1: expected 99, got ${lst_val}"]

# === Summary ===
- print: [""]
- print: ["test_array: ${pass} passed, ${fail} failed"]
- if:
    condition: { ">": [fail, 0] }
    then:
      - call: [sys.exit, 1]
