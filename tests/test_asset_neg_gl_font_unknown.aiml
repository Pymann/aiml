# SPEC?: 44_7_asset_registry   # aus dem Dateinamen, zu bestaetigen
# Negative: gl.font mit string-literalem unbekanntem Stem → Compile-Hard-Error.
# Counterpart zu test_asset_neg_unknown_stem (gl.tex) — eigenes Kind-Store.
#
# AssetRoots: tests/_asset_fixtures/basic/resources/fonts
# Expected exit code: 1
# ExpectedStderr: gl.font: stem 'missing_font' not in font store

- def:
    name: main
    return: i32
    body:
      - decl: [font, ui_font, { call: [gl.font, "missing_font", 16.0] }]
      - return: 0
