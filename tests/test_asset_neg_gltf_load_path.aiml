# SPEC: 44_7_asset_registry
# Negative: `gltf.load` with a string literal path that lies IN the asset bundle →
# compile hard error.  The same rule as for `gl.load_texture`: a fixed path
# breaks as soon as someone changes the working directory or builds for WASM.
# A dynamic path (command line) stays allowed.
#
# AssetRoots: tests/_asset_fixtures/mesh/resources/shapes
# Expected exit code: 1
# ExpectedStderr: gltf.load: literal path

- def:
    name: main
    return: i32
    body:
      - decl: [scene, gltf_scene, { call: [gltf.load, "tests/_asset_fixtures/mesh/resources/shapes/probe_cube.glb"] }]
      - return: 0
