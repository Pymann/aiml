# SPEC?: 42_path_type   # derived from the file name, to be confirmed
# Negative: gl.load_texture with a string literal path that lies in the asset bundle
# → compile hard error.  The escape hatch stays only for runtime variables
# (e.g. user uploads), not for static source strings.
#
# AssetRoots: tests/_asset_fixtures/basic/resources/textures
# Expected exit code: 1
# ExpectedStderr: gl.load_texture: literal path in asset bundle, use gl.tex("hammer")

- def:
    name: main
    return: i32
    body:
      - decl: [tex, gl_texture, { call: [gl.load_texture, "tests/_asset_fixtures/basic/resources/textures/hammer.png"] }]
      - return: 0
