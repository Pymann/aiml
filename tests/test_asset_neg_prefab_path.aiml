# SPEC?: 44_6_prefabs,42_path_type   # derived from the file name, to be confirmed
# Negative: prefab spec with a path literal in `texture:` → compile hard error.
# Stem-only is strict; paths in prefab specs are not allowed.
#
# AssetRoots: tests/_asset_fixtures/basic/resources/textures
# Expected exit code: 1
# ExpectedStderr: prefab texture must be a stem, not a path

- prefab:
    name: BadTile
    width: 80
    height: 80
    children:
      # Strict stem mode → no '/' and no extension allowed.
      - { name: icon_img, type: rect, x: 0, y: 0, width: 80, height: 80,
          texture: "resources/textures/hammer.png" }

- def:
    name: main
    return: i32
    body: [{ return: 0 }]
