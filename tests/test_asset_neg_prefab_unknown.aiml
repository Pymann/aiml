# SPEC?: 44_6_prefabs   # derived from the file name, to be confirmed
# Negative: prefab spec with a stem that does not exist in the texture store →
# compile hard error (the typo is caught at build time instead of as a
# black square at runtime).
#
# AssetRoots: tests/_asset_fixtures/basic/resources/textures
# Expected exit code: 1
# ExpectedStderr: prefab texture: stem 'misspelled' not in texture store

- prefab:
    name: BadTile
    width: 80
    height: 80
    children:
      - { name: icon_img, type: rect, x: 0, y: 0, width: 80, height: 80,
          texture: "misspelled" }

- def:
    name: main
    return: i32
    body: [{ return: 0 }]
