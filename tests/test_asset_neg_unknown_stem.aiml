# Expected exit code: 1
# ExpectedStderr: gl.tex: stem 'missing_stem' not in texture store

- def:
    name: main
    return: i32
    body:
      - decl: [tex, gl_texture, { call: [gl.tex, "missing_stem"] }]
      - return: 0
