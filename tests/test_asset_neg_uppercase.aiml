# SPEC?: 44_7_asset_registry   # derived from the file name, to be confirmed
# Negative: a file with upper-case letters (Sword.png) is warned about + skipped by the scanner.
# A lookup on the (skipped) stem → compile hard error as with unknown_stem.
# "hammer.png" (lowercase) is in the same root and is registered normally.
#
# AssetRoots: tests/_asset_fixtures/uppercase/resources/textures
# Expected exit code: 1
# ExpectedStderr: gl.tex: stem 'Sword' not in texture store

- def:
    name: main
    return: i32
    body:
      # "hammer" as a sanity check (should work if the scanner otherwise works OK).
      - decl: [hammer, gl_texture, { call: [gl.tex, "hammer"] }]
      # "Sword" was not registered because of the capital letter → hard error here.
      - decl: [sword, gl_texture, { call: [gl.tex, "Sword"] }]
      - return: 0
