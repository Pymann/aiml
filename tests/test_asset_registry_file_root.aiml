# SPEC?: 44_7_asset_registry   # derived from the file name, to be confirmed
# Asset registry: a single file as a root (no directory).
# Mirrors the DataCreatures setup (exodus-client.json contains
# resources/skills/skill_default.png directly as an asset_directory entry).
#
# AssetRoots: tests/_asset_fixtures/file_root/skill_default.png
# Expected exit code: 0

- def:
    name: main
    return: i32
    body:
      - decl: [tex, gl_texture, { call: [gl.tex, "skill_default"] }]
      - if:
          condition: { eq: [tex, null] }
          then:
            - print: ["FAIL file_root_null"]
            - call:  [sys.exit, 1]

      - print: ["Asset Registry file-root PASS"]
      - return: 0
