# SPEC: 44_7_asset_registry, 43_1_gltf
# Mesh kind: `.glb` belongs in the asset registry, and `gltf.model(stem)` finds it.
#
# Before, `.glb` was an UNKNOWN extension: the scanner warned per
# compilation unit and skipped the file — in cosmos 248 warnings for
# two models.  The only way to the model was a path in the source text, i.e.
# exactly what spec/44_7 forbids for textures.
#
# What is checked is not just "not null": the stem route must deliver THE SAME as
# the path route — otherwise the test only proves that some file was loaded.
#
# AssetRoots: tests/_asset_fixtures/mesh/resources/shapes
# Expected exit code: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      - decl: [viaa, gltf_scene, { call: [gltf.model, "probe_cube"] }]
      - if:
          condition: { neq: [viaa.valid, 1] }
          then: [{ print: ["FAIL mesh_stem: ${viaa.error}"] }, { call: [sys.exit, 1] }]

      # counter-probe via the path — a path OUTSIDE the bundle is allowed
      # (the same file also lies under tests/).
      - decl: [viab, gltf_scene, { call: [gltf.load, "tests/cube_textured.glb"] }]
      - if:
          condition: { neq: [viab.valid, 1] }
          then: [{ print: ["FAIL mesh_path: ${viab.error}"] }, { call: [sys.exit, 1] }]

      - decl: [nodes_stem, i32, viaa.node_count]
      - decl: [nodes_path, i32, viab.node_count]
      - decl: [mesh_stem, list<gltf_mesh>, viaa.meshes]
      - decl: [mesh_path, list<gltf_mesh>, viab.meshes]
      - decl: [count_stem, i32, mesh_stem.len]
      - decl: [count_path, i32, mesh_path.len]
      - if:
          condition: { neq: [nodes_stem, nodes_path] }
          then: [{ print: ["FAIL node_count ${nodes_stem} != ${nodes_path}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if:
          condition: { neq: [count_stem, count_path] }
          then: [{ print: ["FAIL mesh_count ${count_stem} != ${count_path}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if:
          condition: { lt: [count_stem, 1] }
          then: [{ print: ["FAIL mesh_count is 0 — nothing loaded"] }, { set: [fails, { +: [fails, 1] }] }]

      - call: [viaa.free]
      - call: [viab.free]
      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["Asset Registry mesh FAIL"] }, { return: 1 }]
      - print: ["Asset Registry mesh PASS (${count_stem} mesh(es), ${nodes_stem} node(s) via both routes)"]
      - return: 0
