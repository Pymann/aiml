# SPEC?: 44_7_asset_registry   # derived from the file name, to be confirmed
# Asset registry: overlapping roots (parent + child) → the same abs_path
# is registered exactly ONCE; no spurious duplicate stem errors.
# Mirrors the DataCreatures setup (exodus-client.json has both
# resources/ui and resources/ui/action_bar as asset_directories).
#
# AssetRoots: tests/_asset_fixtures/overlap/resources/ui,tests/_asset_fixtures/overlap/resources/ui/action_bar
# Expected exit code: 0

- def:
    name: main
    return: i32
    body:
      # "btn.png" lives directly under resources/ui — picked up by the parent root.
      - decl: [btn, gl_texture, { call: [gl.tex, "btn"] }]
      - if:
          condition: { eq: [btn, null] }
          then:
            - print: ["FAIL overlap_btn_null"]
            - call:  [sys.exit, 1]

      # "atk.png" lies under resources/ui/action_bar — reachable from both
      # roots.  The scanner dedups via abs_path; only one entry in the store.
      - decl: [atk, gl_texture, { call: [gl.tex, "atk"] }]
      - if:
          condition: { eq: [atk, null] }
          then:
            - print: ["FAIL overlap_atk_null"]
            - call:  [sys.exit, 1]

      # repeated lookup → identical cache pointer (no "second" tex).
      - decl: [atk2, gl_texture, { call: [gl.tex, "atk"] }]
      - if:
          condition: { neq: [atk, atk2] }
          then:
            - print: ["FAIL overlap_dup_register"]
            - call:  [sys.exit, 1]

      - print: ["Asset Registry overlap PASS"]
      - return: 0
