# SPEC?: 15_models,19_inheritance   # derived from the file name, to be confirmed
# static-check: off
# The assignment guard must NOT block RELATED models (inheritance):
# writing a derived model into a base field copies the shared
# prefix and is legitimate.  (Counterpart to the negative wrongmodel case.)
#
# Expectation: compiles + runs, base prefix fields copied correctly.

- model: { name: Base, fields: [[uid, string], [num, i32]] }
- model: { name: Derived, inherits: Base, fields: [[extra, i32]] }
- model: { name: Holder, fields: [[slot, Base]] }

- def:
    name: main
    return: i32
    body:
      - decl: [der, Derived]
      - set: [der.uid, "abc"]
      - set: [der.num, 7]
      - set: [der.extra, 99]
      - decl: [hold, Holder]
      - set: [hold.slot, der]          # derived → base field: must be allowed
      - decl: [fails, i32, 0]
      - if: { condition: { neq: [hold.slot.uid, "abc"] }, then: [{ print: ["FAIL uid='${hold.slot.uid}'"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [hold.slot.num, 7] }, then: [{ print: ["FAIL num=${hold.slot.num}"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS assign_inherited_model_ok"] }]
          else: [{ print: ["FAIL assign_inherited_model_ok: ${fails}"] }]
      - return: fails
