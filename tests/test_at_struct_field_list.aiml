# SPEC: 52_arrays,53_dyn_arrays
# Repro: `at: [struct.field_list, i]` fails with "at: unknown variable
# 'struct.field_list'", although indexing a list<T> member
# property is logically correct.  Workaround: copy into a local variable.
#
# Spec status (2026-06-01):
#   - spec/52_arrays.md shows at: only with bare variable containers
#   - spec/53_dyn_arrays.md likewise
#   - compiler ast_compiler_expr.cpp:911 hard-requires a VariableExpr
#
# Without a spec/compiler extension at least the error message should say clearly
# that at: needs a simple variable container (instead of
# "unknown variable", which looks like a symbol lookup failure).
#
# Expected status: failing build → demonstrates the limitation.
# If a future fix allows it: at: with a struct.field container → exit 0.

- model:
    name: Holder
    fields:
      - [var_xs, list<i32>]

- decl: [var_h, Holder]
- call: [var_h.var_xs.push, 10]
- call: [var_h.var_xs.push, 20]
- call: [var_h.var_xs.push, 30]

# Variante A: bare-variable, funktioniert
- decl: [xs_local, list<i32>, var_h.var_xs]
- decl: [var_a0, i32, { at: [xs_local, 0] }]
- if:
    condition: { neq: [var_a0, 10] }
    then:
      - print: ["FAIL bare-variable at: expected 10, got ${var_a0}"]
      - call: [sys.exit, 1]

# Variant B: struct.field as an at container — compile error in the current state.
# If a future fix allows that, this should set var_a1 = 10.
- decl: [var_a1, i32, { at: [var_h.var_xs, 0] }]
- if:
    condition: { neq: [var_a1, 10] }
    then:
      - print: ["FAIL struct-field at: expected 10, got ${var_a1}"]
      - call: [sys.exit, 1]

- print: ["PASS test_at_struct_field_list"]
