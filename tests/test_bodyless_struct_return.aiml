# SPEC?: 02_types   # derived from the file name, to be confirmed
# static-check: off
# BUG repro: a BODYLESS interface method with a STRUCT return type (here
# map<string:i32>) synthesises `UndefValue` as the default instead of a
# zero-initialised struct.  An undef map has undef data/size/cap →
# the caller (contains/get) reads garbage → SIGSEGV.
#
# Expectation after the fix: the bodyless method returns an EMPTY map
# (contains → 0), no crash.

- interface:
    name: Produce
    methods:
      - [give, map<string:i32>, []]

- model: { name: EmptyData, fields: [[tag, i32]] }

- class:
    name: Empty
    models: [EmptyData]
    implements: [Produce]
    methods:
      # bodyless → default return.  Must be an empty map, not undef.
      - def: { name: give, return: map<string:i32> }

- def:
    name: main
    return: i32
    body:
      - decl: [obj, ptr<Empty>, { new: Empty }]
      - decl: [got, map<string:i32>, { call: [obj.give] }]
      # mutate: undef data/size/cap → put reallocs over garbage → SIGSEGV.
      - call: [got.set, "9", 9]
      - decl: [has, i32, { call: [got.has, "1"] }]
      - if:
          condition: { eq: [has, 0] }
          then: [{ print: ["PASS bodyless_struct_return: empty map, no crash"] }]
          else: [{ print: ["FAIL bodyless_struct_return: has=${has}"] }]
      - return: has
