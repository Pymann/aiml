# SPEC?: 11_buffer   # aus dem Dateinamen, zu bestaetigen
# Test Buffer

- enum:
    name: TypeId
    values:
      - Player: 1
      - Enemy: 2

- class:
    name: PacketHeader
    members:
      - [var_id, i32, 0, { access: public }]
      - [type, TypeId, 0, { access: public }]

- decl: [buf, buffer]
- call: [buf.alloc, 1024]

# Write Primitives
- call: [buf.write, 0xAA, u8]
- call: [buf.write, 0x12345678, i32]

# Write Struct
- decl: [var_h, PacketHeader]
- set: [var_h.var_id, 99]
- set: [var_h.type, TypeId.Enemy]
- call: [buf.write, var_h, PacketHeader]

# Reset Read Cursor to 0 (Implied by not moving it? Or separate seek?)
# BufferImpl separated indices. read starts at 0.

# Read Primitives
- decl: [var_b1, u8]
- set: [var_b1, {call: [buf.read, u8]}]
- print: ["Read u8: ", var_b1]

- decl: [var_i1, i32]
- set: [var_i1, {call: [buf.read, i32]}]
- print: ["Read i32: ", var_i1]

# Read Struct
- decl: [var_h2, PacketHeader]
- set: [var_h2, {call: [buf.read, PacketHeader]}]
- print: ["Read Header ID: ", var_h2.var_id]
- print: ["Read Header Type: ", var_h2.type]

- if:
    condition: {eq: [var_h2.var_id, 99]}
    then:
      - print: ["SUCCESS: Header ID Match"]
    else:
      - print: ["FAIL: Header ID Mismatch"]
