# SPEC: 11_buffer,44_3_ui
# spec/11 + spec/44_3 §3.1: decl: [b, buffer<f32>, [v1, v2, ...]] writes every element (len = n·4)
# under memV3 (buffer = handle), at top level and inside a method; values read back in order.
# Expected exit code: 0
- class:
    name: Grid
    members: [[calls, i32]]
    methods:
      - def:
          name: second
          access: public
          return: f32
          body:
            - decl: [cols, buffer<f32>, [0.16, 0.84, 0.5]]
            - if: { condition: { neq: [cols.len, 12] }, then: [{ print: ["FAIL method len ${cols.len}"] }, { return: -1.0 }] }
            - call: [cols.seek, 4]
            - return: { call: [cols.read, f32] }
- def:
    name: main
    return: i32
    body:
      - decl: [top, buffer<f32>, [0.4, 0.6]]
      - if: { condition: { neq: [top.len, 8] }, then: [{ print: ["FAIL top len ${top.len}"] }, { return: 1 }] }
      - call: [top.seek, 0]
      - decl: [first, f32, { call: [top.read, f32] }]
      - decl: [want_first, f32, 0.4]
      - if: { condition: { neq: [first, want_first] }, then: [{ print: ["FAIL first ${first}"] }, { return: 1 }] }
      - decl: [grid, ptr<Grid>, { new: Grid }]
      - decl: [round, i32, 0]
      - while:
          condition: { lt: [round, 10] }
          body:
            - decl: [got, f32, { call: [grid.second] }]
            - decl: [want, f32, 0.84]
            - if: { condition: { neq: [got, want] }, then: [{ print: ["FAIL second ${got}"] }, { return: 1 }] }
            - set: [round, { +: [round, 1] }]
      - print: ["PASS buffer_literal_handle"]
      - return: 0
