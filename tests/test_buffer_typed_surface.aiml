# SPEC: 71_collection_vocabulary
# spec/71 §7 on a typed buffer: .len and .capacity count ELEMENTS, .byte_len counts BYTES;
# { at: [b, i] } indexes elements.  alloc(n) reserves n BYTES (spec/11).
#
# The split is the whole point of this test. A loop written as `idx < buf.byte_len` with
# `{ at: [buf, idx] }` runs four times too far on a buffer<f32>; since spec/71 that raises
# IndexOutOfBoundsException instead of reading past the data, and `.len` is the bound to use.
# Expected exit code: 0
- def:
    name: main
    return: i32
    body:
      # ── buffer<f32>: elements are four bytes wide ────────────────────────
      - decl: [pts, buffer<f32>]
      - call: [pts.alloc, 16]
      - if:
          condition: { neq: [pts.capacity, 4] }
          then: [{ print: ["FAIL capacity ${pts.capacity}, expected 4 elements"] }, { return: 1 }]
      - call: [pts.push, 1.0]
      - call: [pts.push, 2.5]
      - if:
          condition: { neq: [pts.len, 2] }
          then: [{ print: ["FAIL len ${pts.len}, expected 2 elements"] }, { return: 1 }]
      - if:
          condition: { neq: [pts.byte_len, 8] }
          then: [{ print: ["FAIL byte_len ${pts.byte_len}, expected 8 bytes"] }, { return: 1 }]

      # at indexes ELEMENTS, not bytes: at 1 is the second f32.
      - decl: [first, f32, { at: [pts, 0] }]
      - decl: [second, f32, { at: [pts, 1] }]
      - if:
          condition: { neq: [first, 1.0] }
          then: [{ print: ["FAIL at 0: ${first}"] }, { return: 1 }]
      - if:
          condition: { neq: [second, 2.5] }
          then: [{ print: ["FAIL at 1: ${second} -- byte-indexed instead of element-indexed?"] }, { return: 1 }]

      # ── buffer<u8>: bytes and elements coincide ──────────────────────────
      - decl: [bytes, buffer<u8>]
      - call: [bytes.alloc, 4]
      - call: [bytes.push, 7]
      - call: [bytes.push, 200]
      - if:
          condition: { neq: [bytes.len, 2] }
          then: [{ print: ["FAIL u8 len ${bytes.len}"] }, { return: 1 }]
      - if:
          condition: { neq: [bytes.byte_len, 2] }
          then: [{ print: ["FAIL u8 byte_len ${bytes.byte_len} -- must equal len for u8"] }, { return: 1 }]
      - decl: [big, i32, { cast: [{ at: [bytes, 1] }, i32] }]
      - if:
          condition: { neq: [big, 200] }
          then: [{ print: ["FAIL u8 at 1: ${big}"] }, { return: 1 }]

      # ── extend appends the other buffer's written elements ───────────────
      - decl: [more, buffer<f32>]
      - call: [more.alloc, 8]
      - call: [more.push, 3.5]
      - call: [pts.extend, more]
      - if:
          condition: { neq: [pts.len, 3] }
          then: [{ print: ["FAIL len after extend ${pts.len}, expected 3"] }, { return: 1 }]
      - decl: [third, f32, { at: [pts, 2] }]
      - if:
          condition: { neq: [third, 3.5] }
          then: [{ print: ["FAIL at 2 after extend: ${third}"] }, { return: 1 }]

      # ── an empty buffer has no element ───────────────────────────────────
      - decl: [none_buf, buffer<f32>]
      - call: [none_buf.alloc, 16]
      - if:
          condition: { neq: [none_buf.len, 0] }
          then: [{ print: ["FAIL empty len ${none_buf.len}"] }, { return: 1 }]
      - if:
          condition: { neq: [none_buf.empty, 1] }
          then: [{ print: ["FAIL .empty on an empty buffer"] }, { return: 1 }]

      - print: ["PASS buffer_typed_surface"]
      - return: 0
