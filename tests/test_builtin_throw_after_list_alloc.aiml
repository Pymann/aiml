# SPEC: 10_collections
# spec/10 F10-23 + spec/22: an index out of bounds throws a CATCHABLE
# IndexOutOfBoundsException with the reason "index 5 of 2".  This test is
# the wasm32 guard for that, because there both went wrong:
#   * the exception object was allocated with a fixed i64 width, although the
#     rest of the code declares `malloc` with size_t (i32 on wasm32) — that made
#     EVERY function with `at`/`get` uncompilable (220 in the 9rooms client),
#   * the exception record {object, thunk, type tag} was written with fixed offsets
#     8/16 at 24 bytes — with 4-byte pointers thunk and tag land in
#     nothing, and no `catch` finds its type,
#   * and the emcc link used libc++-noexcept, which made __cxa_throw trap.
# The index stays dynamic (via .len), so that the check does not fold away.
# No import: the wasm runner links only this file.
# Expected exit code: 0

- def:
    name: main
    return: i32
    body:
      - decl: [items, list<i32>, [10, 20]]
      - decl: [last, i32, { -: [items.len, 1] }]
      - decl: [sum, i32, 0]
      - decl: [caught, i32, 0]
      - decl: [reason, string, ""]

      # valid access: the check code must not get in the way.
      - try:
          body:
            - decl: [got, i32, { at: [items, last] }]
            - set: [sum, { +: [sum, got] }]
          catch:
            - type: IndexOutOfBoundsException
              var: err
              body:
                - call: [log.info, "FAIL: gueltiger Index warf: ${err.message}"]
                - set: [sum, -1]
      - if:
          condition: { neq: [sum, 20] }
          then:
            - call: [log.info, "FAIL: sum=${sum} expected 20"]
            - return: 1

      # out of bounds: must throw AND be caught here.
      - decl: [far, i32, { +: [items.len, 3] }]
      - try:
          body:
            - decl: [bad, i32, { at: [items, far] }]
            - call: [log.info, "FAIL: no throw, read ${bad}"]
          catch:
            - type: IndexOutOfBoundsException
              var: err
              body:
                - set: [caught, 1]
                - set: [reason, err.message]
      - if:
          condition: { neq: [caught, 1] }
          then:
            - call: [log.info, "FAIL: IndexOutOfBoundsException not caught"]
            - return: 1
      - if:
          condition: { neq: [reason, "index 5 of 2"] }
          then:
            - call: [log.info, "FAIL: Begruendung '${reason}' expected 'index 5 of 2'"]
            - return: 1

      - call: [log.info, "OK: gefangen mit '${reason}'"]
      - return: 0
