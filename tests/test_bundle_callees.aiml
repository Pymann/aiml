# SPEC: 29_2_sys_exec,29_serialize
# spec/29_2 §16: sys.bundle also collects CALLED functions.
#
# Before, a bundle only took the referenced TYPES along; a function that
# called another left it behind — the error only showed up at the receiver
# as "Unknown function", after the bundle was already on its way.
# Checked two levels deep, so that not only the first edge counts.
# Expected exit code: 0

- def:
    name: deep_leaf
    return: i32
    body:
      - return: 4

- def:
    name: mid_level
    return: i32
    body:
      - decl: [got, i32, { call: [deep_leaf] }]
      - return: { +: [got, 3] }

- def:
    name: bundle_root
    return: i32
    body:
      - decl: [sum, i32, { call: [mid_level] }]
      - if: { condition: { neq: [sum, 7] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [pkg, Code, { call: [sys.bundle, "bundle_root", { context: true }] }]

      # contains() is NO good as a completeness check: it is a
      # text search, and bundle_root MENTIONS mid_level in its call (§17).
      # Only the second level is therefore meaningful, and what matters
      # anyway is whether it RUNS.
      - set: [fails, { +: [fails, { call: [expect, "Bundle enthaelt die zweite Ebene", { call: [pkg.contains, "deep_leaf"] }] }] }]

      - decl: [rcx, i32, { call: [sys.exec, pkg] }]
      - print: ["sys.exec rc=${rcx}"]
      - set: [fails, { +: [fails, { call: [expect, "isolierter Lauf findet beide Ebenen", { eq: [rcx, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_bundle_callees FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_bundle_callees PASS"]
      - return: 0
