# SPEC: 29_2_sys_exec,29_serialize
# spec/29_2 §16: sys.bundle sammelt auch GERUFENE Funktionen ein.
#
# Vorher zog ein Bundle nur die referenzierten TYPEN mit; eine Funktion, die
# eine andere aufrief, liess sie zurueck — der Fehler fiel erst beim Empfaenger
# als "Unknown function" auf, nachdem das Bundle schon unterwegs war.
# Geprueft wird zwei Ebenen tief, damit nicht nur die erste Kante zaehlt.
# Expected exit code: 0

- def:
    name: deep_leaf
    return: i32
    body:
      - return: 4

- def:
    name: mid_level
    return: i32
    body:
      - decl: [got, i32, { call: [deep_leaf] }]
      - return: { +: [got, 3] }

- def:
    name: bundle_root
    return: i32
    body:
      - decl: [sum, i32, { call: [mid_level] }]
      - if: { condition: { neq: [sum, 7] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [pkg, Code, { call: [sys.bundle, "bundle_root", { context: true }] }]

      # contains() taugt NICHT als Vollstaendigkeitspruefung: es ist eine
      # Textsuche, und bundle_root ERWAEHNT mid_level in seinem Aufruf (§17).
      # Nur die zweite Ebene ist damit aussagekraeftig, und entscheidend ist
      # ohnehin, ob es LAEUFT.
      - set: [fails, { +: [fails, { call: [expect, "Bundle enthaelt die zweite Ebene", { call: [pkg.contains, "deep_leaf"] }] }] }]

      - decl: [rcx, i32, { call: [sys.exec, pkg] }]
      - print: ["sys.exec rc=${rcx}"]
      - set: [fails, { +: [fails, { call: [expect, "isolierter Lauf findet beide Ebenen", { eq: [rcx, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_bundle_callees FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_bundle_callees PASS"]
      - return: 0
