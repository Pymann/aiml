# SPEC: 29_2_sys_exec,29_serialize,62_pipelines
# spec/29_2 + spec/62 §5.6: what the return value of sys.exec actually says.
#
# This test records the ANSWER, not wishful thinking: by spec/62 a step
# counts as failed if its body THROWS (F62-41) — not
# if it returns a number != 0, because by §5.3 the return value is a
# result and is cached.  Both are distinguished here.
# Expected exit code: 0

- class:
    name: StepFailed
    members: [[message, string]]

- def:
    name: ret_seven
    return: i32
    body: [{ return: 7 }]

- def:
    name: throws
    return: i32
    body:
      - throw: { new: StepFailed, message: "geplatzt" }
      - return: 0

# container methods with a string literal IN the bundle — that is the case that
# reported 'Unknown Type: sleep' in the pipeline test.
- def:
    name: uses_list
    return: i32
    body:
      - decl: [parts, list<string>]
      - call: [parts.push, "eins"]
      - call: [parts.push, "zwei"]
      - if: { condition: { neq: [parts.len, 2] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      - decl: [rc_seven, i32, { call: [sys.exec, { call: [sys.bundle, "ret_seven", { context: true }] }] }]
      - print: ["  (Rueckgabe 7 im Bundle -> rc=${rc_seven})"]

      - decl: [rc_throw, i32, { call: [sys.exec, { call: [sys.bundle, "throws", { context: true }] }] }]
      - print: ["  (throwing body -> rc=${rc_throw})"]
      - set: [fails, { +: [fails, { call: [expect, "a throwing body reports an error", { neq: [rc_throw, 0] }] }] }]

      - decl: [rc_list, i32, { call: [sys.exec, { call: [sys.bundle, "uses_list", { context: true }] }] }]
      - print: ["  (list<string> + push im Bundle -> rc=${rc_list})"]
      - set: [fails, { +: [fails, { call: [expect, "Container-Methoden wirken im Bundle", { eq: [rc_list, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_bundle_exec_semantics FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_bundle_exec_semantics PASS"]
      - return: 0
