# SPEC: 29_2_sys_exec,29_serialize,62_pipelines
# spec/29_2 §13 + spec/62 F62-89: WHAT exactly does a bundle see of the host?
#
# The question is not academic: if a pipeline runs in the controller, it
# depends on this whether a step body gets at its state.  Checked statements:
#
#   1. A called function of the host IS reachable — it is bundled along as SOURCE
#      (spec/29_2 §16) and so runs as a COPY.
#   2. The copy has its OWN globals, freshly initialised.  The host's
#      counter stays untouched, the one in the bundle starts at 0.
#
# The actual lesson follows from that: the separation is LEXICAL (names and
# state), not a sandbox — files, network and database are in the same process
# for both.
# Expected exit code: 0

- decl: [g_counter, i32, 0]

- def:
    name: bump
    return: i32
    body:
      - set: [g_counter, { +: [g_counter, 1] }]
      - return: g_counter

- def:
    name: body_calls_host
    return: i32
    body:
      - decl: [seen, i32, { call: [bump] }]
      - decl: [txt, string, "${seen}"]
      - call: [io.write_file, "logs/bundle_boundary.txt", txt]
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # The host counts twice: its g_counter is at 2 afterwards.
      - decl: [first, i32, { call: [bump] }]
      - decl: [second, i32, { call: [bump] }]
      - set: [fails, { +: [fails, { call: [expect, "the host counts to 2", { eq: [second, 2] }] }] }]

      - decl: [rc_iso, i32, { call: [sys.exec, { call: [sys.bundle, "body_calls_host", { context: true }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the body could call the host function", { eq: [rc_iso, 0] }] }] }]

      - decl: [seen_txt, string, { call: [io.read_file, "logs/bundle_boundary.txt"] }]
      - print: ["  (in the bundle bump() saw the value: ${seen_txt})"]
      # 1 = fresh copy of the globals; 3 = shared state of the host.
      - set: [fails, { +: [fails, { call: [expect, "in the bundle the counter starts at 0 (fresh copy)", { eq: [seen_txt, "1"] }] }] }]

      - decl: [after, i32, { call: [bump] }]
      - set: [fails, { +: [fails, { call: [expect, "the host's counter stayed untouched", { eq: [after, 3] }] }] }]

      # And the flip side: the same process, the same files.  The body has
      # just written into the host's working directory.
      - set: [fails, { +: [fails, { call: [expect, "but both share files (no sandbox)", { call: [io.exists, "logs/bundle_boundary.txt"] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_bundle_state_boundary FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_bundle_state_boundary PASS"]
      - return: 0
