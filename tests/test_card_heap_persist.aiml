# Regression test: nested Card heap serialization in typed persistent Kv
# Expected exit code: 0

- model:
    name: ActiveAbility
    fields:
      - [cost_text, string]
      - [activation_cost, list<i32>]
      - [trigger, list<list<i32>>]
      - [effects, list<list<i32>>]

- enum:
    name: ManaColor
    values:
      - fire: 1
      - earth: 5

- enum:
    name: CardType
    values:
      - creature: 1
      - spell: 2
      - mana_card: 3
      - item: 4
      - primordial: 6

- enum:
    name: SpellType
    values:
      - sorcery: 2
      - ceremony: 3

- enum:
    name: PassiveAbility
    values:
      - flying: 1
      - double_strike: 10
      - burning: 30
      - reach: 12

- model:
    name: BaseCard
    fields:
      - [name, string]
      - [card_type, CardType]
      - [mkp, i32]
      - [mana_cost, map<ManaColor:i32>]
      - [description, string]
      - [passive_abilities, list<PassiveAbility>]
      - [active_abilities,  list<ActiveAbility>]

- model:
    name: Card
    inherits: BaseCard
    fields:
      - [var_lp, i32]
      - [attack, i32]
      - [defense, i32]
      - [initiative, i32]
      - [moral, i32]
      - [movement, i32]
      - [spell_type, SpellType]
      - [equip_cost, i32]
      - [created_at, i64]

- def:
    name: main
    return: i32
    body:
      - decl: [var_j1, string, '{"__type":"Card","name":"Red Pyromancer IV","card_type":1,"mkp":5,"mana_cost":{"1":2,"5":1},"description":"A red creature.","passive_abilities":[10,30,12],"active_abilities":[{"cost_text":"2 Fire","activation_cost":[1,2],"trigger":[[1,7]],"effects":[[10,3],[20,5,1]]}],"var_lp":4,"attack":5,"defense":1,"initiative":2,"moral":3,"movement":2,"spell_type":2,"equip_cost":0,"created_at":0}']
      - decl: [var_c1, Card]
      - set: [var_c1, {call: [sys.deserialize, var_j1, "Card"]}]

      - decl: [var_kv, Kv<string:Card>]
      - set: [var_kv, { call: [db.open_kv, "card_heap_persist", {persist: true, path: "/tmp/aiml_test_card_heap_persist/"}] }]
      - call: [var_kv.set, "var_c1", var_c1]

      - decl: [got, ptr<Card>]
      - set: [got, { call: [var_kv.get, "var_c1"] }]
      - if:
          condition: { eq: [{ eq: [got.name, "Red Pyromancer IV"] }, 0] }
          then:
            - print: ["FAIL got.name=${got.name}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [got.passive_abilities.len, 3] }
          then:
            - print: ["FAIL got.passive_abilities.len=${got.passive_abilities.len}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [got.active_abilities.len, 1] }
          then:
            - print: ["FAIL got.active_abilities.len=${got.active_abilities.len}"]
            - call: [sys.exit, 1]
      - decl: [var_ab, ActiveAbility, got.active_abilities-0]
      - if:
          condition: { eq: [{ eq: [var_ab.cost_text, "2 Fire"] }, 0] }
          then:
            - print: ["FAIL var_ab.cost_text=${var_ab.cost_text}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_ab.effects.len, 2] }
          then:
            - print: ["FAIL var_ab.effects.len=${var_ab.effects.len}"]
            - call: [sys.exit, 1]

      - call: [var_kv.delete, "var_c1"]
      - decl: [has, i32]
      - set: [has, { call: [var_kv.has, "var_c1"] }]
      - if:
          condition: { neq: [has, 0] }
          then:
            - print: ["FAIL has_after_delete=${has}"]
            - call: [sys.exit, 1]

      - call: [db.checkpoint]
      - print: ["Card heap persist PASS"]
      - return: 0
