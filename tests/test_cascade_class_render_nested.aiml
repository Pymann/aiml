# M3c — EXECUTABLE render with RUNTIME nested-cascade dispatch.
#
# OwnerRef.in_zone carries a ZoneType sub-field, so render must, at runtime, read the
# OwnerRef sub-opcode (block[1]) and only walk the extra ZoneType stage when it is
# `in_zone`.  Handlers read the actual element via <.field().
#
#   block [1, 1]     (deal, player)          → ["deal", "own1"]
#   block [1, 3, 2]  (deal, in_zone, room_b) → ["deal", "own3", "z2"]   ← extra stage

- enum:
    name: ZoneType
    values: [ {room_a: 1}, {room_b: 2} ]

- enum:
    name: OwnerType
    values: [ {player: 1}, {opponent: 2}, {in_zone: 3} ]

- cascade:
    name: OwnerRef
    opcode: OwnerType
    nodes:
      - [player]
      - [opponent]
      - [in_zone, ZoneType]          # sub-opcode WITH a sub-field

- enum:
    name: EffCode
    values: [ {deal_dmg: 1} ]

- cascade:
    name: EffPipe
    opcode: EffCode
    nodes:
      - [deal_dmg, OwnerRef]

- class:
    name: EffSkel
    renders: EffPipe
    rules:
      - before: []
        on: deal_dmg
        def: { name: bdeal, args: [[carry, list<string>]], return: list<string>, body: [ { call: [carry.push, "deal"] }, { return: carry } ] }

- class:
    name: OwnerRefText
    renders: OwnerRef
    rules:
      - before: ["*"]
        on: [player, opponent, in_zone]
        def: { name: owner, args: [[carry, list<string>]], return: list<string>, body: [ { decl: [oval, i32, { call: [<.field] }] }, { call: [carry.push, "own${oval}"] }, { return: carry } ] }

- class:
    name: ZoneText
    renders: ZoneType
    rules:
      - before: ["*"]
        on: ZoneType
        def: { name: zone, args: [[carry, list<string>]], return: list<string>, body: [ { decl: [zval, i32, { call: [<.field] }] }, { call: [carry.push, "z${zval}"] }, { return: carry } ] }

- cascade_class:
    name: EffText
    binds_cascade: EffPipe
    carrier: list<string>
    taker:   list<string>
    members: [EffSkel, OwnerRefText, ZoneText]

- def:
    name: chk
    args: [[got, string], [want, string], [label, string]]
    body:
      - if: { condition: { neq: [got, want] }, then: [{ print: ["FAIL ${label}: got='${got}' want='${want}'"] }, { call: [sys.exit, 1] }] }

- def:
    name: main
    return: i32
    body:
      - decl: [pool, ptr<EffText>, { new: EffText }]

      # deal + player: [1, 1] → 2 stages
      - decl: [blk, list<i32>]
      - call: [blk.push, 1]
      - call: [blk.push, 1]
      - decl: [carry, list<string>]
      - decl: [out, list<string>, { call: [pool.render, carry, blk] }]
      - if: { condition: { neq: [out.len, 2] }, then: [{ print: ["FAIL player len=${out.len}"] }, { call: [sys.exit, 1] }] }
      - call: [chk, { at: [out, 0] }, "deal", "player[0]"]
      - call: [chk, { at: [out, 1] }, "own1", "player[1]"]

      # deal + in_zone + room_b: [1, 3, 2] → 3 stages (extra ZoneType only in this branch)
      - decl: [blk2, list<i32>]
      - call: [blk2.push, 1]
      - call: [blk2.push, 3]
      - call: [blk2.push, 2]
      - decl: [carry2, list<string>]
      - decl: [out2, list<string>, { call: [pool.render, carry2, blk2] }]
      - if: { condition: { neq: [out2.len, 3] }, then: [{ print: ["FAIL in_zone len=${out2.len}"] }, { call: [sys.exit, 1] }] }
      - call: [chk, { at: [out2, 0] }, "deal", "zone[0]"]
      - call: [chk, { at: [out2, 1] }, "own3", "zone[1]"]
      - call: [chk, { at: [out2, 2] }, "z2",   "zone[2] nested sub-field"]

      - print: ["PASS cascade_class_render_nested: runtime nested dispatch (extra stage only on in_zone)"]
      - return: 0
