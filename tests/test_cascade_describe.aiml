# SPEC: 44_7_asset_registry,44_7_cascade_validate,49_static_analysis,49_static_off
# `expect` is a FUNCTION, so `call: [expect, ...]`.  Until 2026-10-15 this said
# `- expect: [...]` — an unknown statement key that the compiler
# silently discarded (spec/49 §2a).  So the test checked NOTHING and printed PASS.
# cascade.describe / cascade.type_range — schema introspection (spec/44_7).
#   type_range(type) → list<i32>  : possible values (enum members / cascade node IDs)
#   describe(cascade, opcodes?) → list<string> : element 0 = opcode enum name,
#     after that per opcode "[id]node [range]Type …" (opcodes empty → all).

- enum: { name: ECode,  values: [ {aa: 1}, {bb: 2} ] }
- enum: { name: Colr, values: [ {xx: 1}, {yy: 2}, {zz: 3} ] }
- cascade:
    name: Casc
    opcode: ECode
    nodes:
      - [aa, Colr]
      - [bb]

- def:
    name: joinlist
    args: [[parts, list<string>]]
    return: string
    body:
      - decl: [out, string, ""]
      - decl: [jix, i32, 0]
      - while:
          condition: { lt: [jix, parts.len] }
          body:
            - decl: [prt, string, { at: [parts, jix] }]
            - if: { condition: { eq: [jix, 0] }, then: [{ set: [out, prt] }], else: [{ set: [out, "${out} | ${prt}"] }] }
            - set: [jix, { +: [jix, 1] }]
      - return: out

- def:
    name: expect
    args: [[got, string], [want, string]]
    body:
      - if: { condition: { neq: [got, want] }, then: [{ print: ["FAIL got='${got}' want='${want}'"] }, { call: [sys.exit, 1] }] }

- def:
    name: main
    return: i32
    body:
      # type_range: enum-Member
      - decl: [trc, list<i32>, { call: [cascade.type_range, "Colr"] }]
      - call: [expect, "${trc.len}", "3"]
      - call: [expect, "${{ at: [trc, 0] }}", "1"]
      - call: [expect, "${{ at: [trc, 2] }}", "3"]
      # type_range: cascade-Node-IDs
      - decl: [trn, list<i32>, { call: [cascade.type_range, "Casc"] }]
      - call: [expect, "${trn.len}", "2"]
      # describe all opcodes
      - decl: [dall, list<string>, { call: [cascade.describe, "Casc"] }]
      - call: [expect, { call: [joinlist, dall] }, "ECode | [1]aa [1,2,3]Colr | [2]bb"]
      # describe filtered to opcode 2
      - decl: [ops, list<i32>]
      - call: [ops.push, 2]
      - decl: [dflt, list<string>, { call: [cascade.describe, "Casc", ops] }]
      - call: [expect, { call: [joinlist, dflt] }, "ECode | [2]bb"]
      - print: ["PASS cascade_describe: type_range + describe (Element0=ECode, ranges, opcode-filter)"]
      - return: 0
