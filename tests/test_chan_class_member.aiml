# Test: chan<T> works as a class member and can be shared with a spawned thread.
# Expected exit code: 0

- class:
    name: ChannelBox
    members:
      - [var_ch, chan<i32>]

- def:
    name: channel_box_producer
    args: [[worker_box, ref<ChannelBox>]]
    return: void
    body:
      - call: [worker_box.var_ch.send, 42]
      - call: [worker_box.var_ch.send, 99]

- decl: [box, ref<ChannelBox>, { new: ChannelBox }]
- decl: [var_th, thread_handle, { spawn: [channel_box_producer, box] }]

- decl: [var_v1, i32, { call: [box.var_ch.recv] }]
- decl: [var_v2, i32, { call: [box.var_ch.recv] }]

- call: [var_th.join]

- if:
    condition: { neq: [var_v1, 42] }
    then:
      - print: ["FAIL class-member chan first recv: expected 42, got ${var_v1}"]
      - exit: [1]

- if:
    condition: { neq: [var_v2, 99] }
    then:
      - print: ["FAIL class-member chan second recv: expected 99, got ${var_v2}"]
      - exit: [1]

- free: [box]

- print: ["PASS test_chan_class_member"]
