# SPEC?: 16_classes   # derived from the file name, to be confirmed
# Test: class method returning list<string>
# Expected exit code: 0

- class:
    name: Splitter
    methods:
      - def:
          name: do_split
          access: public
          args: [[text, string]]
          return: list<string>
          body:
            - decl: [result, list<string>]
            - set: [result, { call: [text.split, " "] }]
            - return: [result]

- decl: [var_sp, Splitter]
- decl: [parts, list<string>]
- set: [parts, { call: [var_sp.do_split, "hello world foo"] }]
- decl: [var_n, i32, parts.len]
- print: ["count=${var_n}"]
- if:
    condition: { eq: [var_n, 3] }
    then:
      - print: ["PASS"]
      - call: [sys.exit, 0]
    else:
      - print: ["FAIL var_n=${var_n}"]
      - call: [sys.exit, 1]
