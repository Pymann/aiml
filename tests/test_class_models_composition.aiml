# SPEC?: 15_models,16_classes   # aus dem Dateinamen, zu bestaetigen
# Probe: model + class via `models:` composition.  Class hat anderen Namen
# als Modell, referenziert das Modell explizit und fügt Methoden hinzu.

- model:
    name: Bar
    fields:
      - [var_n, i32, 7]
      - [var_s, string]

- class:
    name: BarBehavior
    models: [Bar]
    methods:
      - def: { name: greet, return: string, args: [], body: [{ return: "var_n=${<.var_n} var_s=${<.var_s}" }] }

- decl: [var_b, BarBehavior]
- set: [var_b.var_n, 99]
- set: [var_b.var_s, "yo"]
- decl: [out, string, { call: [var_b.greet] }]
- print: ["got='${out}'"]
