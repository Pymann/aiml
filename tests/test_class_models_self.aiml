# SPEC?: 15_models,16_classes   # derived from the file name, to be confirmed
# Probe: can var_a class use `models: [SameName]` to compose with var_a same-name model?

- model:
    name: Foo
    fields:
      - [var_a, i32, 7]
      - [var_b, string]

- class:
    name: FooT
    models: [Foo]
    methods:
      - def: { name: hello, return: string, args: [], body: [{ return: "${<.var_a}:${<.var_b}" }] }

- decl: [var_f, FooT]
- set: [var_f.var_a, 42]
- set: [var_f.var_b, "x"]
- decl: [var_s, string, { call: [var_f.hello] }]
- print: ["got='${var_s}' var_a=${var_f.var_a}"]
