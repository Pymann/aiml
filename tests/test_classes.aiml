# SPEC?: 16_classes   # derived from the file name, to be confirmed
# Class Definition Test

- class:
    name: Point
    members:
      - [var_x, i32]
      - [var_y, i32]
    methods:
      - def:
          name: print
          args: []
          return: void
          body:
            - print: ["Inside Point.print"]
            - print: ["Point(${<.var_x}, ${<.var_y})"]

- decl: [var_p1, Point] # Stack allocation
- set: [var_p1.var_x, 10]
- set: [var_p1.var_y, 20]
- call: [var_p1.print]

- print: ["Done."]

- decl: [var_p2, ptr<Point>, {new: Point}] # Heap allocation
- set: [var_p2.var_x, 100]
- set: [var_p2.var_y, 200]
- call: [var_p2.print]
- call: [free, var_p2]
