# SPEC: 58_classgroups
# static-check: relaxed
# spec/58 §12 — group interfaces.  One contract (LayerStore: registry + codec),
# two groups implementing it (RealStore, MockStore).  The user code (`publish`,
# `Publisher`) names only the contract; which group it drives is decided where
# the group is built.  The concrete type keeps its full API (§12.2).
# (static-check: relaxed — the demo needs more than 3 top-level types.)
# Expected exit code: 0

- interface:
    name: Registry
    methods:
      - [push, i32, [[blob, string]]]
- interface:
    name: Codec
    methods:
      - [encode, string, [[data, string]]]

- groupinterface:
    name: LayerStore
    exports:
      - [registry, Registry]
      - [codec, Codec]

- class:
    name: HttpRegistry
    implements: [Registry]
    members:
      - [pushed, i32, 0]
      - [last, string, ""]
    methods:
      - def: { name: push, args: [[blob, string]], return: i32, body: [{ set: [<.pushed, { +: [<.pushed, 1] }] }, { set: [<.last, blob] }, { return: 201 }] }
      - def: { name: count, return: i32, body: [{ return: <.pushed }] }

- class:
    name: TarCodec
    implements: [Codec]
    methods:
      - def: { name: encode, args: [[data, string]], return: string, body: [{ return: "tar(${data})" }] }

- class:
    name: Cache
    members:
      - [hits, i32, 0]
    methods:
      - def: { name: touch, return: i32, body: [{ set: [<.hits, { +: [<.hits, 1] }] }, { return: <.hits }] }

- class:
    name: NullRegistry
    implements: [Registry]
    members:
      - [seen, i32, 0]
    methods:
      - def: { name: push, args: [[blob, string]], return: i32, body: [{ set: [<.seen, { +: [<.seen, 1] }] }, { return: 0 }] }

- classgroup:
    name: RealStore
    implements: [LayerStore]
    instances:
      - { class: HttpRegistry, instance: registry }
      - { class: TarCodec, instance: codec }
      - { class: Cache, instance: cache }
    export: [registry, codec, cache]

- classgroup:
    name: MockStore
    implements: [LayerStore]
    instances:
      - { class: NullRegistry, instance: registry }
      - { class: TarCodec, instance: codec }

# user code: only the contract
- def:
    name: publish
    args: [[store, ref<LayerStore>], [what, string]]
    return: i32
    body:
      - decl: [packed, string, { call: [store.codec.encode, what] }]
      - return: { call: [store.registry.push, packed] }

- class:
    name: Publisher
    members:
      - [store, ptr<LayerStore>]
    methods:
      - def:
          name: run
          args: [[what, string]]
          return: i32
          body:
            - return: { call: [<.store.registry.push, what] }

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      # 1. ptr<G> from {new: Impl}; a free function on ref<G>
      - decl: [real, ptr<LayerStore>, { new: RealStore }]
      - decl: [rc1, i32, { call: [publish, real, "a"] }]
      - if: { condition: { neq: [rc1, 201] }, then: [{ print: ["FAIL real publish rc=${rc1}"] }, { set: [fails, { +: [fails, 1] }] }] }
      - decl: [mock, ptr<LayerStore>, { new: MockStore }]
      - decl: [rc2, i32, { call: [publish, mock, "a"] }]
      - if: { condition: { neq: [rc2, 0] }, then: [{ print: ["FAIL mock publish rc=${rc2}"] }, { set: [fails, { +: [fails, 1] }] }] }
      # 2. an export as a value: a borrow of the instance the group owns
      - decl: [reg, ref<Registry>, real.registry]
      - decl: [rc3, i32, { call: [reg.push, "b"] }]
      - if: { condition: { neq: [rc3, 201] }, then: [{ print: ["FAIL export value rc=${rc3}"] }, { set: [fails, { +: [fails, 1] }] }] }
      # 3. the concrete type: full API, and it saw what went through the contract
      - decl: [full, ptr<RealStore>, { new: RealStore }]
      - decl: [rc4, i32, { call: [publish, full, "c"] }]
      - decl: [cnt, i32, { call: [full.registry.count] }]
      - decl: [last, string, full.registry.last]
      - if: { condition: { or: [{ neq: [cnt, 1] }, { neq: [last, "tar(c)"] }] }, then: [{ print: ["FAIL concrete view cnt=${cnt} last=${last}"] }, { set: [fails, { +: [fails, 1] }] }] }
      - decl: [hits, i32, { call: [full.cache.touch] }]
      - if: { condition: { neq: [hits, 1] }, then: [{ print: ["FAIL concrete-only instance"] }, { set: [fails, { +: [fails, 1] }] }] }
      # 4. a class member typed by the contract
      - decl: [pub, ptr<Publisher>, { new: Publisher }]
      - set: [pub.store, { new: MockStore }]
      - decl: [rc5, i32, { call: [pub.run, "d"] }]
      - if: { condition: { neq: [rc5, 0] }, then: [{ print: ["FAIL member contract rc=${rc5}"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { gt: [fails, 0] }, then: [{ print: ["FAIL classgroup_giface (${fails})"] }, { return: 1 }] }
      - print: ["PASS classgroup_giface: one contract, real and mock groups, full API on the concrete type"]
      - return: 0
