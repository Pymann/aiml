# SPEC: 58_classgroups,61_memory_management
# static-check: relaxed
# PROBE/spec/58: can a group instance with instance-level
# `implements: [Iface]` be passed to a parameter of type `ptr<Iface>`,
# STORED there and later called via the vtable?
#
# That is the pattern of cosmos' RpcDispatcher:
#   disp.register(name, hnd: ref<mirror.RpcHandler>) → map<string:ref<Iface>>
#   (ptr<> fails: a group instance is a BORROW — the group owns
#    it —, and ptr<T> as a parameter takes over the box, spec/61 §8.)
#   disp.dispatch(...)                                → hnd.run(...)
# spec/58 lists "group type as a function-signature parameter" as NOT
# supported — but here the parameter is the INTERFACE type, not the
# group type.  M3 says the synthesised subclass carries the vtable.
# This probe decides whether cosmos' 18 handlers can become instances.
# Expected exit code: 0

- interface:
    name: Greeter
    methods:
      - [greet, i32, []]

- class:
    name: Backend
    members:
      - [base_value, i32]
    methods:
      - def: { name: seed,  args: [[val, i32]], body: [{ set: [<.base_value, val] }] }
      - def: { name: value, return: i32, body: [{ return: <.base_value }] }

# The dispatcher dummy: stores interface pointers and calls them later.
- class:
    name: Slots
    members:
      - [by_name, map<string:ref<Greeter>>]
    methods:
      - def:
          name: put
          args: [[name, string], [who, ref<Greeter>]]
          body: [{ call: [<.by_name.put, name, who] }]
      - def:
          name: invoke
          args: [[name, string]]
          return: i32
          body:
            - if: { condition: { eq: [{ call: [<.by_name.contains, name] }, 0] }, then: [{ return: -1 }] }
            - decl: [who, ref<Greeter>, { call: [<.by_name.get, name] }]
            - return: { call: [who.greet] }

- classgroup:
    name: GreetRuntime
    instances:
      - class: Backend
        instance: data
        constructor: [seed, 20]

      - class: Backend
        instance: hello
        sees: [data]
        implements: [Greeter]
        methods:
          # Uses base state AND the sees edge — exactly the form that a
          # base method alone cannot express (cosmos handlers need
          # that: own logic + access to several services).
          - def:
              name: greet
              return: i32
              body:
                - decl: [from_edge, i32, { call: [<.data.value] }]
                - return: { +: [from_edge, 1] }

- def:
    name: via_free_function
    args: [[who, ref<Greeter>]]
    return: i32
    body: [{ return: { call: [who.greet] } }]

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [grp, ptr<GreetRuntime>, { new: GreetRuntime }]

      # 1) direct call of the group method (known to work)
      - decl: [direct, i32, { call: [grp.hello.greet] }]
      - if: { condition: { neq: [direct, 21] }, then: [{ print: ["FAIL direct: ${direct}"] }, { return: 1 }] }

      # 2) as ptr<Iface> to a free function
      - decl: [via_fn, i32, { call: [via_free_function, grp.hello] }]
      - if: { condition: { neq: [via_fn, 21] }, then: [{ print: ["FAIL free function: ${via_fn}"] }, { return: 1 }] }

      # 3) store in a map and call later via the vtable
      - decl: [slots, ptr<Slots>, { new: Slots }]
      - call: [slots.put, "hello", grp.hello]
      - decl: [via_map, i32, { call: [slots.invoke, "hello"] }]
      - if: { condition: { neq: [via_map, 21] }, then: [{ print: ["FAIL via map: ${via_map}"] }, { return: 1 }] }

      # 4) a state change behind the edge takes effect (no value copy)
      - call: [grp.data.seed, 100]
      - decl: [after, i32, { call: [slots.invoke, "hello"] }]
      - if: { condition: { neq: [after, 101] }, then: [{ print: ["FAIL after change: ${after}"] }, { return: 1 }] }

      - print: ["PASS classgroup_iface_param"]
      - return: 0
