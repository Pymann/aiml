# checks the text.
# EXPECT-ERROR: groupinterface 'Store': export 'reg' names unknown interface 'Rge'.

- interface:
    name: Reg
    methods:
      - [push, i32, [[blob, string]]]
- interface:
    name: Other
    methods:
      - [ping, i32, []]
- groupinterface:
    name: Store
    exports:
      - [reg, Rge]
- def:
    name: main
    return: i32
    body:
      - return: 0
