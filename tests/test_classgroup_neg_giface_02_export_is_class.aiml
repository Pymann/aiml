# SPEC: 58_classgroups
# static-check: relaxed
# spec/58 §12.4 GI-2 — must be a hard compile error with exactly this message.
# Runner expects exit code 1 (test_classgroup_neg_ pattern); tests/classgroup_giface/run.sh
# checks the text.
# EXPECT-ERROR: groupinterface 'Store': export 'reg' must be typed by an interface, 'RegImpl' is a class.

- interface:
    name: Reg
    methods:
      - [push, i32, [[blob, string]]]
- interface:
    name: Other
    methods:
      - [ping, i32, []]
- class:
    name: RegImpl
    implements: [Reg]
    methods:
      - def: { name: push, args: [[blob, string]], return: i32, body: [{ return: 1 }] }
- groupinterface:
    name: Store
    exports:
      - [reg, RegImpl]
- def:
    name: main
    return: i32
    body:
      - return: 0
