# SPEC: 58_classgroups
# static-check: relaxed
# spec/58 §12.4 GI-11 — must be a hard compile error with exactly this message.
# Runner expects exit code 1 (test_classgroup_neg_ pattern); tests/classgroup_giface/run.sh
# checks the text.
# EXPECT-ERROR: 'cache' is not part of group interface 'Store' (exports: reg).

- interface:
    name: Reg
    methods:
      - [push, i32, [[blob, string]]]
- interface:
    name: Other
    methods:
      - [ping, i32, []]
- class:
    name: RegImpl
    implements: [Reg]
    methods:
      - def: { name: push, args: [[blob, string]], return: i32, body: [{ return: 1 }] }
- class:
    name: Plain
    methods:
      - def: { name: noop, return: i32, body: [{ return: 0 }] }
- groupinterface:
    name: Store
    exports:
      - [reg, Reg]
- classgroup:
    name: Impl
    implements: [Store]
    instances:
      - { class: RegImpl, instance: reg }
      - { class: Plain, instance: cache }
- def:
    name: main
    return: i32
    body:
      - decl: [st, ptr<Store>, { new: Impl }]
      - return: { call: [st.cache.noop] }
