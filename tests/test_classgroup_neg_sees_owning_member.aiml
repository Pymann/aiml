# SPEC: 58_classgroups
# Negative test (spec/58 §5.1): a sees target that wires an existing base member
# must be a BORROW.  Here `dep` is declared as `ptr<Dep>` — an owner
# (spec/61 §5.2).  The group frees its instances itself; a second owner
# leads to a double free on the group's `free:`.  The compiler must reject that.
#
# Expected exit code: 1

- class:
    name: Dep
    members:
      - [val, i32]
    methods:
      - def: { name: get_v, return: i32, body: [{ return: <.val }] }

- class:
    name: Consumer
    members:
      - [dep, ptr<Dep>]          # FEHLER: owning ptr als sees-Ziel
    methods:
      - def: { name: read_dep, return: i32, body: [{ return: { call: [<.dep.get_v] } }] }

- classgroup:
    name: Rtg
    instances:
      - class: Dep
        instance: dep
      - class: Consumer
        instance: usr
        sees: [dep]

- def:
    name: main
    return: i32
    body:
      - decl: [rtg, ptr<Rtg>, { new: Rtg }]
      - decl: [got, i32, { call: [rtg.usr.read_dep] }]
      - free: rtg
      - return: 0
