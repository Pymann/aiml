# SPEC: 58_classgroups
# M3 — a `sees` target whose name matches an EXISTING base-class member wires
# that member instead of synthesizing a new one.  This lets ordinary BASE methods
# use the collaborator via `<.dep` — the shape the real 9rooms MatchService needs
# (base methods use `<.cards_ref` etc.), while the classgroup provides the wiring
# declaratively instead of a constructor-injected pointer.
#
# Spec: spec/58_classgroups.md §5.1 (sees onto a base member).

- class:
    name: Dep
    members:
      - [val, i32]
    methods:
      - def: { name: set_v, args: [[nval, i32]], body: [{ set: [<.val, nval] }] }
      - def: { name: get_v, return: i32, body: [{ return: <.val }] }

- class:
    name: Consumer
    members:
      - [dep, ref<Dep>]          # base member; the classgroup wires it via `sees: [dep]`
                                 # BORROW: the group owns the instance (spec/58 §5.1).
    methods:
      # A BASE method that uses the collaborator through the base member <.dep.
      - def: { name: read_dep, return: i32, body: [{ return: { call: [<.dep.get_v] } }] }
      # Eine sees-Instanz ist VOLLWERTIG: ihre Attribute sind direkt lesbar UND
      # schreibbar, nicht nur ihre Methoden (spec/58 §5.1).  Ohne das muesste
      # jede Nachbar-Zusammenarbeit durch Getter/Setter oder durch zusaetzliche
      # Parameter laufen.
      - def: { name: peek_attr,  return: i32, body: [{ return: <.dep.val }] }
      - def: { name: poke_attr,  args: [[nval, i32]], body: [{ set: [<.dep.val, nval] }] }

- classgroup:
    name: Rtg
    instances:
      - class: Dep
        instance: dep
      - class: Consumer
        instance: usr
        sees: [dep]              # wires the existing `dep` base member (no duplicate)

- def:
    name: main
    return: i32
    body:
      - decl: [rtg, ptr<Rtg>, { new: Rtg }]
      - call: [rtg.dep.set_v, 42]
      # base method read_dep uses <.dep, which the classgroup wired to the dep instance
      - decl: [got, i32, { call: [rtg.usr.read_dep] }]
      - if: { condition: { neq: [got, 42] }, then: [{ print: ["FAIL read_dep=${got} exp 42 — base member not wired via sees"] }, { call: [sys.exit, 1] }] }
      # Attribut der Nachbar-Instanz DIREKT lesen …
      - decl: [seen, i32, { call: [rtg.usr.peek_attr] }]
      - if: { condition: { neq: [seen, 42] }, then: [{ print: ["FAIL peek_attr=${seen} exp 42 — sibling attribute not readable"] }, { call: [sys.exit, 1] }] }
      # … und schreiben; die Aenderung ist an der Instanz selbst sichtbar.
      - call: [rtg.usr.poke_attr, 7]
      - decl: [after, i32, { call: [rtg.dep.get_v] }]
      - if: { condition: { neq: [after, 7] }, then: [{ print: ["FAIL poke_attr → dep.val=${after} exp 7 — sibling attribute not writable"] }, { call: [sys.exit, 1] }] }
      # Die Gruppe FREIGEBEN: das verdrahtete Basismember ist ein Borrow, kein zweiter
      # Eigentuemer — ohne dieses free lief der Test am Double-Free vorbei (spec/58 §5.1).
      - free: rtg
      - print: ["PASS classgroup_sees_base_member: sees wires an existing base member; base method uses the collaborator; sibling ATTRIBUTES read+write; group free is clean"]
      - return: 0
