# SPEC: 71_collection_vocabulary
# spec/71 §1: every operation of the matrix, on every type that has it, under its one name.
# A failure prints "FAIL <section>: ..." and the test returns the number of failures.
# Expected exit code: 0

- class:
    name: Row
    members:
      - [rid, i32]
      - [hpv, i32]

- class:
    name: Sample
    members:
      - [val, i32]

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── 1.1 queries are properties ────────────────────────────────────────
      - decl: [lst, list<i32>, [3, 1, 2]]
      - if: [{ neq: [lst.len, 3] }, true]
        then: [{ print: ["FAIL list.len = ${lst.len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [lst.empty, 0] }, true]
        then: [{ print: ["FAIL list.empty"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [lst.byte_len, 12] }, true]
        then: [{ print: ["FAIL list.byte_len = ${lst.byte_len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [lst.capacity, 0] }, true]
        then: [{ print: ["FAIL list.capacity default = ${lst.capacity}"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [bff, buffer<f32>]
      - call: [bff.alloc, 16]
      - call: [bff.push, 1.5]
      - call: [bff.push, 2.5]
      - if: [{ neq: [bff.len, 2] }, true]
        then: [{ print: ["FAIL buffer<f32>.len = ${bff.len} (elements)"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [bff.byte_len, 8] }, true]
        then: [{ print: ["FAIL buffer<f32>.byte_len = ${bff.byte_len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [bff.capacity, 4] }, true]
        then: [{ print: ["FAIL buffer<f32>.capacity = ${bff.capacity} (16 bytes = 4 floats)"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [raw, buffer]
      - call: [raw.alloc, 8]
      - call: [raw.write, 7, i32]
      - if: [{ neq: [raw.len, 4] }, true]
        then: [{ print: ["FAIL buffer.len = ${raw.len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [raw.byte_len, 4] }, true]
        then: [{ print: ["FAIL buffer.byte_len = ${raw.byte_len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [raw.capacity, 8] }, true]
        then: [{ print: ["FAIL buffer.capacity = ${raw.capacity}"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [arr, "array<i32:4>"]
      - if: [{ neq: [arr.len, 4] }, true]
        then: [{ print: ["FAIL array.len"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [arr.byte_len, 16] }, true]
        then: [{ print: ["FAIL array.byte_len = ${arr.byte_len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [arr.empty, 0] }, true]
        then: [{ print: ["FAIL array.empty"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [num, i32, 5]
      - decl: [dar, "dyn_array<f64>", { new_array: [f64, num] }]
      - if: [{ neq: [dar.len, 5] }, true]
        then: [{ print: ["FAIL dyn_array.len = ${dar.len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [dar.byte_len, 40] }, true]
        then: [{ print: ["FAIL dyn_array.byte_len = ${dar.byte_len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [dar.empty, 0] }, true]
        then: [{ print: ["FAIL dyn_array.empty"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [str, string, "grün"]
      - if: [{ neq: [str.len, 5] }, true]
        then: [{ print: ["FAIL string.len = ${str.len} (bytes)"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [str.byte_len, 5] }, true]
        then: [{ print: ["FAIL string.byte_len = ${str.byte_len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [est, string, ""]
      - if: [{ neq: [est.empty, 1] }, true]
        then: [{ print: ["FAIL string.empty"] }, { set: [fails, { +: [fails, 1] }] }]

      # ── 1.2 keyed containers: set / get / has / delete / keys / clear ─────
      - decl: [mpp, "map<string:i32>"]
      - call: [mpp.set, "a", 1]
      - call: [mpp.set, "b", 2]
      - call: [mpp.set, "a", 10]
      - if: [{ neq: [{ call: [mpp.get, "a"] }, 10] }, true]
        then: [{ print: ["FAIL map.get"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [mpp.has, "b"] }, 1] }, true]
        then: [{ print: ["FAIL map.has"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [mpp.delete, "b"] }, 1] }, true]
        then: [{ print: ["FAIL map.delete present"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [mpp.delete, "b"] }, 0] }, true]
        then: [{ print: ["FAIL map.delete missing"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [mkeys, list<string>, { call: [mpp.keys] }]
      - if: [{ neq: [mkeys.len, 1] }, true]
        then: [{ print: ["FAIL map.keys"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [mpp.len, 1] }, true]
        then: [{ print: ["FAIL map.len"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [mpp.clear]
      - if: [{ neq: [mpp.empty, 1] }, true]
        then: [{ print: ["FAIL map.clear/empty"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [hmp, "hashmap<string:i32>"]
      - call: [hmp.set, "x", 5]
      - if: [{ neq: [{ call: [hmp.incr, "x", 2] }, 7] }, true]
        then: [{ print: ["FAIL hashmap.incr"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [hmp.incr, "y", 3] }, 3] }, true]
        then: [{ print: ["FAIL hashmap.incr missing"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [hmp.has, "y"] }, 1] }, true]
        then: [{ print: ["FAIL hashmap.has"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [hmp.delete, "y"] }, 1] }, true]
        then: [{ print: ["FAIL hashmap.delete"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [hkeys, list<string>, { call: [hmp.keys] }]
      - if: [{ neq: [hkeys.len, 1] }, true]
        then: [{ print: ["FAIL hashmap.keys"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [hmp.len, 1] }, true]
        then: [{ print: ["FAIL hashmap.len"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [hmp.clear]
      - if: [{ neq: [hmp.empty, 1] }, true]
        then: [{ print: ["FAIL hashmap.empty"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [kvs, "Kv<string:i32>", { call: [db.open_kv, "coll_vocab_kv"] }]
      - call: [kvs.set, "k", 4]
      - if: [{ neq: [{ call: [kvs.get, "k"] }, 4] }, true]
        then: [{ print: ["FAIL kvs.get"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [kvs.has, "k"] }, 1] }, true]
        then: [{ print: ["FAIL kvs.has"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [kkeys, list<string>, { call: [kvs.keys] }]
      - if: [{ neq: [kkeys.len, 1] }, true]
        then: [{ print: ["FAIL kvs.keys"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [kvs.len, 1] }, true]
        then: [{ print: ["FAIL kvs.len"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [kvs.delete, "k"] }, 1] }, true]
        then: [{ print: ["FAIL kvs.delete"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [kvs.empty, 1] }, true]
        then: [{ print: ["FAIL kvs.empty"] }, { set: [fails, { +: [fails, 1] }] }]

      - call: [storage.set, "coll_vocab_key", "v"]
      - if: [{ neq: [{ call: [storage.has, "coll_vocab_key"] }, 1] }, true]
        then: [{ print: ["FAIL storage.has"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [storage.delete, "coll_vocab_key"] }, 1] }, true]
        then: [{ print: ["FAIL storage.delete"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [storage.has, "coll_vocab_key"] }, 0] }, true]
        then: [{ print: ["FAIL storage.delete left the key"] }, { set: [fails, { +: [fails, 1] }] }]

      # ── 1.3 sequences ──────────────────────────────────────────────────────
      - call: [lst.push, 9]
      - if: [{ neq: [{ at: [lst, 3] }, 9] }, true]
        then: [{ print: ["FAIL list push/at"] }, { set: [fails, { +: [fails, 1] }] }]
      - idx: [lst, 0, 30]
      - if: [{ neq: [{ at: [lst, 0] }, 30] }, true]
        then: [{ print: ["FAIL list idx"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [popped, i32, { call: [lst.pop] }]
      - if: [{ neq: [popped, 9] }, true]
        then: [{ print: ["FAIL list.pop"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [lst.insert, 1, 2]
      - call: [lst.remove, 0]
      - call: [lst.extend, [2, 2]]
      - if: [{ neq: [{ call: [lst.count_of, 2] }, 4] }, true]
        then: [{ print: ["FAIL list.count_of = ${call: [lst.count_of, 2]}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [lst.index_of, 1] }, 1] }, true]
        then: [{ print: ["FAIL list.index_of"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [lst.contains, 7] }, 0] }, true]
        then: [{ print: ["FAIL list.contains"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [lst.clear]
      - if: [{ neq: [lst.len, 0] }, true]
        then: [{ print: ["FAIL list.clear"] }, { set: [fails, { +: [fails, 1] }] }]

      - if: [{ neq: [{ at: [bff, 1] }, 2.5] }, true]
        then: [{ print: ["FAIL buffer<f32> at 1 = second float"] }, { set: [fails, { +: [fails, 1] }] }]
      - idx: [bff, 0, 4.0]
      - decl: [bpop, f32, { call: [bff.pop] }]
      - if: [{ neq: [bpop, 2.5] }, true]
        then: [{ print: ["FAIL buffer<f32>.pop"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [bff2, buffer<f32>]
      - call: [bff2.alloc, 16]
      - call: [bff2.push, 8.0]
      - call: [bff.extend, bff2]
      - if: [{ neq: [bff.len, 2] }, true]
        then: [{ print: ["FAIL buffer<f32>.extend len = ${bff.len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [bff.clear]
      - if: [{ neq: [bff.empty, 1] }, true]
        then: [{ print: ["FAIL buffer<f32>.clear"] }, { set: [fails, { +: [fails, 1] }] }]

      - idx: [dar, 4, 1.25]
      - if: [{ neq: [{ at: [dar, 4] }, 1.25] }, true]
        then: [{ print: ["FAIL dyn_array at/idx"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [dar.free]

      # ── 1.4 records ────────────────────────────────────────────────────────
      - decl: [rows, Store<Row>, { call: [db.open, "coll_vocab_rows"] }]
      - decl: [row, Row]
      - set: [row.rid, 7]
      - set: [row.hpv, 50]
      - decl: [nid, i32, { call: [rows.add, row] }]
      - decl: [got, ref<Row>, { call: [rows.get, nid] }]
      - if: [{ neq: [got.hpv, 50] }, true]
        then: [{ print: ["FAIL Store.add/get"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [rows.len, 1] }, true]
        then: [{ print: ["FAIL Store.len"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [rows.delete, nid] }, 1] }, true]
        then: [{ print: ["FAIL Store.delete"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [rows.delete, nid] }, 0] }, true]
        then: [{ print: ["FAIL Store.delete twice"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [vec, VecStore, { call: [db.open_vec, "coll_vocab_vec", 2] }]
      - decl: [emb, list<f32>, [1.0, 0.0]]
      - call: [vec.set, "p", emb]
      - call: [vec.set, "p", emb]
      - if: [{ neq: [vec.len, 1] }, true]
        then: [{ print: ["FAIL VecStore.set overwrites: len ${vec.len}"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [{ call: [vec.delete, "p"] }, 1] }, true]
        then: [{ print: ["FAIL VecStore.delete"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [vec.empty, 1] }, true]
        then: [{ print: ["FAIL VecStore.empty"] }, { set: [fails, { +: [fails, 1] }] }]

      # ── 1.5 streams ────────────────────────────────────────────────────────
      - decl: [tser, TimeSeries<Sample>, { call: [db.open_timeseries, "coll_vocab_ts"] }]
      - decl: [smp, Sample]
      - set: [smp.val, 3]
      - call: [tser.append, smp, 100]
      - decl: [back, ref<Sample>, { call: [tser.at_time, 100] }]
      - if: [{ neq: [back.val, 3] }, true]
        then: [{ print: ["FAIL TimeSeries.at_time"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [tser.len, 1] }, true]
        then: [{ print: ["FAIL TimeSeries.len"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [tns, tensor, { call: [tensor.zeros, 3] }]
      - idx: [tns, 2, 0.5]
      - if: [{ neq: [{ at: [tns, 2] }, 0.5] }, true]
        then: [{ print: ["FAIL tensor at/idx"] }, { set: [fails, { +: [fails, 1] }] }]
      - if: [{ neq: [tns.len, 3] }, true]
        then: [{ print: ["FAIL tensor.len"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [doc, ptr<yaml_doc>, { call: [yaml.parse, "[1, 2, 3]"] }]
      - decl: [root, ref<yaml_node>, { call: [yaml.root, doc] }]
      - if: [{ neq: [{ call: [yaml.len, root] }, 3] }, true]
        then: [{ print: ["FAIL yaml.len"] }, { set: [fails, { +: [fails, 1] }] }]

      - if: [{ eq: [fails, 0] }, true]
        then: [{ print: ["collection vocabulary: all ok"] }]
      - return: [fails]
