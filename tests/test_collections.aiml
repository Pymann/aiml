# SPEC?: 10_collections   # derived from the file name, to be confirmed
- print: ["Testing Arrays with Hyphen Syntax..."]
- decl: [arr, "array<i32:3>"]
- idx: [arr, 0, 10]
- idx: [arr, 1, 20]
- idx: [arr, 2, { +: [{ at: [arr, 0] }, { at: [arr, 1] }] }]
- print: ["arr-2 = ${ { at: [arr, 2] } }"]
- call: [sys.exit, { at: [arr, 2] }]
