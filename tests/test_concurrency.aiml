- def:
    name: worker
    args: [[id, i32]]
    return: void
    body:
      - print: ["Worker ${id}: started"]
      - print: ["Worker ${id}: done"]

- def:
    name: producer
    args: [[ch, chan<i32>]]
    return: void
    body:
      - call: [ch.send, 42]
      - call: [ch.send, 99]

# Thread spawn and join
- decl: [t1, thread_handle]
- decl: [t2, thread_handle]

- set: [t1, { spawn: [worker, 1] }]
- set: [t2, { spawn: [worker, 2] }]

- print: ["Main: threads spawned"]

- call: [t1.join]
- call: [t2.join]

- print: ["Main: threads joined"]

# InvalidThreadStateException: join on already-joined thread
- try:
    body:
      - call: [t1.join]
      - print: ["ERROR: should not reach here"]
    catch:
      - type: InvalidThreadStateException
        var: e
        body:
          - print: ["Caught InvalidThreadStateException on double-join"]

# Mutex test
- decl: [mutex, lock]
- call: [mutex.init]
- call: [mutex.acquire]
- print: ["Main: in critical section"]
- call: [mutex.release]

- print: ["Main: done"]

# Channel test: producer sends 42 and 99, main receives both
- decl: [ch, chan<i32>]
- decl: [tp, thread_handle]
- set: [tp, { spawn: [producer, ch] }]
- decl: [v1, i32]
- decl: [v2, i32]
- set: [v1, { call: [ch.recv] }]
- set: [v2, { call: [ch.recv] }]
- call: [tp.join]
- print: ["Received: ${v1}"]
- print: ["Received: ${v2}"]
