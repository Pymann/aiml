# SPEC?: 26_concurrency   # aus dem Dateinamen, zu bestaetigen
- def:
    name: worker
    args: [[var_id, i32]]
    return: void
    body:
      - print: ["Worker ${var_id}: started"]
      - print: ["Worker ${var_id}: done"]

- def:
    name: producer
    args: [[var_ch, chan<i32>]]
    return: void
    body:
      - call: [var_ch.send, 42]
      - call: [var_ch.send, 99]

# Thread spawn and join
- decl: [var_t1, thread_handle]
- decl: [var_t2, thread_handle]

- set: [var_t1, { spawn: [worker, 1] }]
- set: [var_t2, { spawn: [worker, 2] }]

- print: ["Main: threads spawned"]

- call: [var_t1.join]
- call: [var_t2.join]

- print: ["Main: threads joined"]

# InvalidThreadStateException: join on already-joined thread
- try:
    body:
      - call: [var_t1.join]
      - print: ["ERROR: should not reach here"]
    catch:
      - type: InvalidThreadStateException
        var: e
        body:
          - print: ["Caught InvalidThreadStateException on double-join"]

# Mutex test
- decl: [mutex, lock]
- call: [mutex.init]
- call: [mutex.acquire]
- print: ["Main: in critical section"]
- call: [mutex.release]

- print: ["Main: done"]

# Channel test: producer sends 42 and 99, main receives both
- decl: [g_ch, chan<i32>]
- decl: [var_tp, thread_handle]
- set: [var_tp, { spawn: [producer, g_ch] }]
- decl: [var_v1, i32]
- decl: [var_v2, i32]
- set: [var_v1, { call: [g_ch.recv] }]
- set: [var_v2, { call: [g_ch.recv] }]
- call: [var_tp.join]
- print: ["Received: ${var_v1}"]
- print: ["Received: ${var_v2}"]
