- decl: [var_x, i32, 10]
- decl: [var_y, i32, 20]

- print: ["Testing Control Flow"]

- print: ["X is ${var_x}, Y is ${var_y}"]

- if:
    condition: { lt: [var_x, var_y] }
    then:
      - print: ["X is less than Y (Correct)"]
    else:
      - print: ["X is NOT less than Y (Wrong)"]

- if:
    condition: { gt: [var_x, var_y] }
    then:
      - print: ["X is greater than Y (Wrong)"]
    else:
      - print: ["X is NOT greater than Y (Correct)"]

- decl: [counter, i32, 0]
- print: ["Starting Loop..."]

- while:
    condition: { lt: [counter, 5] }
    body:
      - print: ["Counter: ${counter}"]
      - set: [counter, { +: [counter, 1] }]

- print: ["Loop Finished. Counter should be 5: ${counter}"]
