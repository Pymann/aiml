# SPEC: 29_2_sys_exec
# spec/29_2 §14a: `ctx` — the context as a namespace of its own.
#
# What the spec promises is checked:
#   1. `ctx.new` gives a context that lives longer than a call.
#   2. A second bundle SEES what the first defined in the same context
#      (F29_2-…f: what is visible is the order of the calls).
#   3. `kontext.symbol(name, type)` returns the symbol if the type matches.
#   4. If it does NOT, it throws (F29_2-…d) — and only then.
#   5. An unknown name throws as well, but a DIFFERENT exception (…d2).
#   6. Functions need the FULL signature (…d3): `fn(i32,i32) -> i32`.
#      A bare `"fn"` is too little, and so is a wrong arity.
#
# The gain at stake is the base cost: a fresh context costs
# ~96 ms (§15), a reused one does not.  That is why TWO bundles are run here
# in ONE context.
# Expected exit code: 0

- def:
    name: lib_sieben
    return: i32
    body:
      - return: 7

- def:
    name: lib_summe
    args: [[zahl, i32], [mehr, i32]]
    return: i32
    body:
      - return: { +: [zahl, mehr] }

- def:
    name: nutzt_lib
    return: i32
    body:
      # Sees the function from the FIRST bundle of the same context.
      - decl: [got, i32, { call: [lib_sieben] }]
      - print: ["nutzt_lib sah ${got}"]
      - return: { -: [got, 7] }

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]

      - decl: [kontext, ctx_handle, { call: [ctx.new] }]
      - decl: [lib, Code, { call: [sys.bundle, "lib_sieben"] }]
      - decl: [rc_lib, i32, { call: [kontext.exec, lib] }]
      - if:
          condition: { neq: [rc_lib, 0] }
          then: [{ print: ["  FAIL library did not run (rc=${rc_lib})"] }, { set: [fails, { +: [fails, 1] }] }]
          else: [{ print: ["  ok   library in the context"] }]

      # Second function, its own bundle — it has ARGUMENTS, so that the
      # signature has something to say.
      - decl: [sum, Code, { call: [sys.bundle, "lib_summe"] }]
      - decl: [rc_sum, i32, { call: [kontext.exec, sum] }]
      - if:
          condition: { neq: [rc_sum, 0] }
          then: [{ print: ["  FAIL lib_summe did not run (rc=${rc_sum})"] }, { set: [fails, { +: [fails, 1] }] }]

      # Third bundle, SAME context: it calls what the first defined.
      - decl: [use, Code, { call: [sys.bundle, "nutzt_lib"] }]
      - decl: [rc_use, i32, { call: [kontext.exec, use] }]
      - if:
          condition: { neq: [rc_use, 0] }
          then: [{ print: ["  FAIL second bundle did not see the library (rc=${rc_use})"] }, { set: [fails, { +: [fails, 1] }] }]
          else: [{ print: ["  ok   second bundle sees the first"] }]

      # Symbol mit RICHTIGER Signatur: kommt wortlos zurueck.
      - decl: [adr, i64, { call: [kontext.symbol, "lib_sieben", "fn() -> i32"] }]
      - if:
          condition: { le: [adr, 0] }
          then: [{ print: ["  FAIL address of lib_sieben missing"] }, { set: [fails, { +: [fails, 1] }] }]
          else: [{ print: ["  ok   Symbol mit passender Signatur"] }]

      # Whitespace does not count: the same signature, written differently.
      - decl: [adr2, i64, { call: [kontext.symbol, "lib_summe", "fn(i32,i32)->i32"] }]
      - if:
          condition: { le: [adr2, 0] }
          then: [{ print: ["  FAIL address of lib_summe missing"] }, { set: [fails, { +: [fails, 1] }] }]
          else: [{ print: ["  ok   argument types in the signature"] }]

      # A bare "fn" is too little (…d3).
      - try:
          body:
            - decl: [blank, i64, { call: [kontext.symbol, "lib_summe", "fn"] }]
            - print: ["  FAIL bare 'fn' was accepted"]
            - set: [fails, { +: [fails, 1] }]
          catch:
            - type: Exception
              var: ex0
              body: [{ print: ["  ok   blankes 'fn' wirft: ${ex0.message}"] }]

      # Wrong arity: throws although the name is a function.
      - try:
          body:
            - decl: [eng, i64, { call: [kontext.symbol, "lib_summe", "fn(i32) -> i32"] }]
            - print: ["  FAIL wrong arity was accepted"]
            - set: [fails, { +: [fails, 1] }]
          catch:
            - type: Exception
              var: ex3
              body: [{ print: ["  ok   falsche Stelligkeit wirft: ${ex3.message}"] }]

      # FALSCHER Typ: wirft.
      - try:
          body:
            - decl: [falsch, i64, { call: [kontext.symbol, "lib_sieben", "i32"] }]
            - print: ["  FAIL wrong type was NOT thrown"]
            - set: [fails, { +: [fails, 1] }]
          catch:
            - type: Exception
              var: ex
              body: [{ print: ["  ok   falscher Typ wirft: ${ex.message}"] }]

      # UNBEKANNTER Name: wirft ebenfalls.
      - try:
          body:
            - decl: [nix, i64, { call: [kontext.symbol, "gibtesnicht", "fn() -> i32"] }]
            - print: ["  FAIL unknown symbol was NOT thrown"]
            - set: [fails, { +: [fails, 1] }]
          catch:
            - type: Exception
              var: ex2
              body: [{ print: ["  ok   unbekanntes Symbol wirft: ${ex2.message}"] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_ctx FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_ctx PASS"]
      - return: 0
