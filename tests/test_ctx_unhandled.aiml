# SPEC: 29_2_sys_exec
# spec/29_2 §14a + spec/22: if NOBODY catches the signature error, the
# program ends with 2 — and names the REASON while doing so.
#
# The second is the point of this test: the throws placed by the compiler
# (`emitThrowMsg`) note their message like a `throw` in aiml, otherwise
# the top level only shows "(no message)" (measured 2026-10-25).
# Expected exit code: 2

- def:
    name: lib_acht
    return: i32
    body:
      - return: 8

- def:
    name: main
    return: i32
    body:
      - decl: [kontext, ctx_handle, { call: [ctx.new] }]
      - decl: [lib, Code, { call: [sys.bundle, "lib_acht"] }]
      - decl: [rcl, i32, { call: [kontext.exec, lib] }]
      # Eine Funktion, aber mit falschem Rueckgabetyp genannt: wirft.
      - decl: [adr, i64, { call: [kontext.symbol, "lib_acht", "fn() -> string"] }]
      - print: ["  FAIL not thrown (${adr})"]
      - return: 0
