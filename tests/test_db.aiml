# Tests for AionDB: Store<T>, Kv<K:V>, VecStore + VecResult
# Expected exit code: 0

# ── Phase A: Store<T> ─────────────────────────────────────────────────────────

- class:
    name: Entity
    members: [[id, i32], [hp, i32]]

- decl: [entities, Store<Entity>]
- set: [entities, { call: [db.open, "entities"] }]

# Insert an entity
- decl: [e, Entity]
- set: [e.id, 42]
- set: [e.hp, 100]
- decl: [eid, i32]
- set: [eid, { call: [entities.insert, e] }]
- print: ["inserted id: ${eid}"]

# Get entity back via ptr
- decl: [p, ptr<Entity>]
- set: [p, { call: [entities.get, 1] }]
- print: ["hp: ${p.hp}"]

# len
- decl: [n, i32]
- set: [n, { call: [entities.len] }]
- print: ["len: ${n}"]

# update
- set: [e.hp, 200]
- call: [entities.update, 1, e]
- set: [p, { call: [entities.get, 1] }]
- print: ["hp after update: ${p.hp}"]

# ── Phase B: Kv<string:string> ────────────────────────────────────────────────

- decl: [cfg, Kv<string:string>]
- set: [cfg, { call: [db.open_kv, "cfg"] }]

- call: [cfg.set, "theme", "dark"]

- decl: [v, string]
- set: [v, { call: [cfg.get, "theme"] }]
- print: ["theme: ${v}"]

- decl: [has, i32]
- set: [has, { call: [cfg.has, "theme"] }]
- print: ["has: ${has}"]

- decl: [klen, i32]
- set: [klen, { call: [cfg.len] }]
- print: ["klen: ${klen}"]

- call: [cfg.delete, "theme"]
- set: [has, { call: [cfg.has, "theme"] }]
- print: ["has after del: ${has}"]

- call: [cfg.set, "a", "1"]
- call: [cfg.set, "b", "2"]
- set: [klen, { call: [cfg.len] }]
- print: ["klen before clear: ${klen}"]

- call: [cfg.clear]
- set: [klen, { call: [cfg.len] }]
- print: ["klen after clear: ${klen}"]

# ── Phase B2: iterator<string> over Kv keys ──────────────────────────────────

- decl: [ikv, Kv<string:string>]
- set: [ikv, { call: [db.open_kv, "iter_test"] }]
- call: [ikv.set, "alpha", "1"]
- call: [ikv.set, "beta", "2"]
- call: [ikv.set, "gamma", "3"]

- decl: [it, "iterator<string>", { call: [ikv.iter] }]
- decl: [iter_count, i32, 0]
- while:
    condition: { call: [it.has_next] }
    body:
      - decl: [k, string, { call: [it.next] }]
      - print: ["iter key: ${k}"]
      - set: [iter_count, { +: [iter_count, 1] }]
- print: ["iter_count: ${iter_count}"]

# reset and iterate again
- call: [it.reset]
- decl: [iter_count2, i32, 0]
- while:
    condition: { call: [it.has_next] }
    body:
      - decl: [k2, string, { call: [it.next] }]
      - set: [iter_count2, { +: [iter_count2, 1] }]
- print: ["iter_count after reset: ${iter_count2}"]
- call: [free, it]

# ── Phase C: VecStore + VecResult ─────────────────────────────────────────────

- decl: [vs, VecStore]
- set: [vs, { call: [db.open_vec, "vecs", 3] }]

# Insert vector doc1 = [1, 0, 0]
- decl: [v1, list<f32>]
- call: [v1.push, 1.0]
- call: [v1.push, 0.0]
- call: [v1.push, 0.0]
- call: [vs.insert, "doc1", v1]

# Insert vector doc2 = [0, 1, 0]
- decl: [v2, list<f32>]
- call: [v2.push, 0.0]
- call: [v2.push, 1.0]
- call: [v2.push, 0.0]
- call: [vs.insert, "doc2", v2]

- decl: [vlen, i32]
- set: [vlen, { call: [vs.len] }]
- print: ["vs len: ${vlen}"]

# Search with query = [1, 0, 0] — should match doc1 first
- decl: [q, list<f32>]
- call: [q.push, 1.0]
- call: [q.push, 0.0]
- call: [q.push, 0.0]

- decl: [results, list<ptr<VecResult>>]
- set: [results, { call: [vs.search, q, 2] }]

- decl: [r, ptr<VecResult>]
- set: [r, { call: [results.get, 0] }]
- print: ["top id: ${r.id}"]

# ── Phase D: TimeSeries<T> ────────────────────────────────────────────────

- class:
    name: GameState
    members: [[score, i32], [hp, i32]]

- decl: [history, TimeSeries<GameState>]
- set: [history, { call: [db.open_timeseries, "game_history"] }]

- decl: [gs, GameState]
- set: [gs.score, 100]
- set: [gs.hp, 75]
- call: [history.append, gs, 1000]

- set: [gs.score, 200]
- set: [gs.hp, 50]
- call: [history.append, gs, 2000]

- decl: [tlen, i32]
- set: [tlen, { call: [history.len] }]
- print: ["ts len: ${tlen}"]

- decl: [tp, ptr<GameState>]
- set: [tp, { call: [history.at, 1500] }]
- print: ["score at 1500: ${tp.score}"]

# ── Phase E: db.run_system (ECS loop) + db.query (function predicate) ─────────
# Expected output:
#   "sys hp: 80"      — run_system: slot 1 active in both stores
#   "query count: 1"  — db.query: only hp=80 passes is_high_hp predicate

- class:
    name: Health
    members: [[hp, i32]]

- class:
    name: Pos
    members: [[x, i32]]

# Open two stores
- decl: [hp_store, Store<Health>]
- set: [hp_store, { call: [db.open, "health_data"] }]

- decl: [pos_store, Store<Pos>]
- set: [pos_store, { call: [db.open, "pos_data"] }]

# Entity 1: has both Health (hp=80) and Pos
- decl: [h1, Health]
- set: [h1.hp, 80]
- call: [hp_store.insert, h1]

- decl: [p1, Pos]
- set: [p1.x, 10]
- call: [pos_store.insert, p1]

# Entity 2: only has Health (hp=30) — no Pos → excluded from run_system
- decl: [h2, Health]
- set: [h2.hp, 30]
- call: [hp_store.insert, h2]

# System function: prints hp of entities with BOTH stores active
- def:
    name: tick_hp
    args: [[h, ptr<Health>]]
    return: void
    body:
      - print: ["sys hp: ${h.hp}"]

# Predicate: returns 1 if hp > 50
- def:
    name: is_high_hp
    args: [[h, ptr<Health>]]
    return: i32
    body:
      - if:
          condition: { gt: [h.hp, 50] }
          then:
            - return: 1
          else:
            - return: 0

# ECS run_system — only slot 1 is active in both stores
- call: [db.run_system, tick_hp, hp_store, pos_store]

# db.query with function predicate — only hp=80 qualifies
- decl: [high_hp, list<ptr<Health>>]
- set: [high_hp, { call: [db.query, hp_store, {where: is_high_hp}] }]
- decl: [qlen, i32]
- set: [qlen, { call: [high_hp.len] }]
- print: ["query count: ${qlen}"]
