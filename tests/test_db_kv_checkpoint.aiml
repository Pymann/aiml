# Tests for db.kv_checkpoint — compaction via temp+rename (Schritt 6).
# After many delete operations, checkpoint should reduce real disk usage
# and leave no orphan .compact file.
# Expected exit code: 0

- call: [io.write_file, "/tmp/aiml_chkpt_test/.keep", ""]

- decl: [kv, Kv<string:string>]
- set: [kv, { call: [db.open_kv, "chkpt_test", {persist: true, path: "/tmp/aiml_chkpt_test/"}] }]

# ── Phase A: fill with payload-heavy entries ─────────────────────────────────
- decl: [i, i32, 0]
- while:
    condition: { "<": [i, 200] }
    body:
      - call: [kv.set, "k${i}", "value_with_some_payload_to_take_space_${i}"]
      - set: [i, { +: [i, 1] }]

- decl: [n_after_fill, i32, { call: [kv.len] }]
- print: ["after fill: len=${n_after_fill}"]

- if:
    condition: { neq: [n_after_fill, 200] }
    then:
      - print: ["FAIL: expected len=200 after fill, got ${n_after_fill}"]
      - call: [sys.exit, 1]

# ── Phase B: delete all but a few entries ────────────────────────────────────
- set: [i, 0]
- while:
    condition: { "<": [i, 195] }
    body:
      - call: [kv.delete, "k${i}"]
      - set: [i, { +: [i, 1] }]

- decl: [n_after_delete, i32, { call: [kv.len] }]
- print: ["after delete: len=${n_after_delete}"]

- if:
    condition: { neq: [n_after_delete, 5] }
    then:
      - print: ["FAIL: expected len=5 after delete, got ${n_after_delete}"]
      - call: [sys.exit, 1]

# ── Phase C: checkpoint — should rewrite WAL with only 5 live entries ────────
- decl: [_chkpt_rc, i32, { call: [db.checkpoint] }]
- print: ["checkpoint done"]

# ── Phase D: read live entries → still accessible ────────────────────────────
- decl: [v195, string, { call: [kv.get, "k195"] }]
- decl: [v199, string, { call: [kv.get, "k199"] }]
- print: ["k195=${v195}"]
- print: ["k199=${v199}"]

# Soft check on values (use string comparison via len + contains heuristic)
- if:
    condition: { neq: [v195, "value_with_some_payload_to_take_space_195"] }
    then:
      - print: ["FAIL: k195 wrong value '${v195}'"]
      - call: [sys.exit, 1]

- decl: [n_after_chkpt, i32, { call: [kv.len] }]
- print: ["after checkpoint: len=${n_after_chkpt}"]

- if:
    condition: { neq: [n_after_chkpt, 5] }
    then:
      - print: ["FAIL: expected len=5 after checkpoint, got ${n_after_chkpt}"]
      - call: [sys.exit, 1]

# ── Phase E: deleted entries stay deleted ────────────────────────────────────
- decl: [has_old, i32, { call: [kv.has, "k0"] }]
- print: ["has k0 (deleted): ${has_old}"]
- if:
    condition: { neq: [has_old, 0] }
    then:
      - print: ["FAIL: deleted entry k0 visible after checkpoint"]
      - call: [sys.exit, 1]

# ── Phase F: writes after checkpoint still work ──────────────────────────────
- call: [kv.set, "post_chkpt", "alive"]
- decl: [v_post, string, { call: [kv.get, "post_chkpt"] }]
- print: ["post_chkpt=${v_post}"]
- if:
    condition: { neq: [v_post, "alive"] }
    then:
      - print: ["FAIL: post-checkpoint write/read broken"]
      - call: [sys.exit, 1]

- print: ["ALL PASSED"]
