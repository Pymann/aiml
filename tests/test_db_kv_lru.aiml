# SPEC?: 31_db_integration   # derived from the file name, to be confirmed
# Tests for bounded LRU on decoded_cache (step 7).
# Writes more typed entries than MAX_DECODED_LRU (1024), reads them back —
# correctness must hold despite cache eviction. Re-reads of evicted keys
# trigger fresh decode from mmap.
# Expected exit code: 0

- model:
    name: Counter
    fields:
      - [var_n, i32]
      - [label, string]

- def:
    name: main
    return: i32
    body:
      - decl: [var_kv, Kv<string:Counter>]
      - set: [var_kv, { call: [db.open_kv, "lru_test", {persist: true, path: "/tmp/aiml_lru_test/"}] }]

      # ── Phase A: write 1500 entries (> MAX_DECODED_LRU=1024) ─────────────────
      - decl: [var_i, i32, 0]
      - while:
          condition: { "<": [var_i, 1500] }
          body:
            - decl: [var_c, Counter]
            - set: [var_c.var_n, var_i]
            - set: [var_c.label, "label_${var_i}"]
            - call: [var_kv.set, "k${var_i}", var_c]
            - set: [var_i, { +: [var_i, 1] }]

      - decl: [n_after_fill, i32, var_kv.len]
      - if:
          condition: { neq: [n_after_fill, 1500] }
          then:
            - print: ["FAIL: expected len=1500, got ${n_after_fill}"]
            - call: [sys.exit, 1]

      # ── Phase B: read all 1500 sequentially → cache will roll through ────────
      - set: [var_i, 0]
      - decl: [errors, i32, 0]
      - while:
          condition: { "<": [var_i, 1500] }
          body:
            - decl: [got, ref<Counter>, { call: [var_kv.get, "k${var_i}"] }]
            - if:
                condition: { neq: [got.var_n, var_i] }
                then:
                  - print: ["FAIL k${var_i}: got.var_n=${got.var_n}"]
                  - set: [errors, { +: [errors, 1] }]
            - set: [var_i, { +: [var_i, 1] }]

      - if:
          condition: { neq: [errors, 0] }
          then:
            - print: ["FAIL: ${errors} read mismatches"]
            - call: [sys.exit, 1]

      # ── Phase C: re-read first 100 (these were evicted in Phase B) ───────────
      - set: [var_i, 0]
      - while:
          condition: { "<": [var_i, 100] }
          body:
            - decl: [got2, ref<Counter>, { call: [var_kv.get, "k${var_i}"] }]
            - if:
                condition: { neq: [got2.var_n, var_i] }
                then:
                  - print: ["FAIL re-read k${var_i}: got.var_n=${got2.var_n}"]
                  - call: [sys.exit, 1]
            - set: [var_i, { +: [var_i, 1] }]

      - print: ["LRU bounded cache OK"]
      - return: 0
