# SPEC: 31_db_integration
# spec/31: `path: "sub/dir/"` creates the substructure — including the
# intermediate levels.  Until 2026-10-15 it was a single-level `mkdir`: on the first
# open it failed with ENOENT, the store silently stayed empty, and only the
# SECOND run (with the directory then present) worked.
#
# Expected exit code: 0

- class:
    name: NestedStore
    members:
      - [store, Kv<string:string>]
    methods:
      - def:
          name: open
          access: public
          body:
            - set: [<.store, { call: [db.open_kv, "tief", {persist: true, path: "a/b/c/"}] }]
      - def:
          name: roundtrip
          access: public
          static_off: ["str_cmp"]
          return: i32
          body:
            - call: [<.store.set, "schluessel", "wert-42"]
            - if: { condition: { eq: [{ call: [<.store.has, "schluessel"] }, 0] }, then: [{ return: 0 }] }
            - decl: [back, string, { call: [<.store.get_copy, "schluessel"] }]
            - if: { condition: { neq: [back, "wert-42"] }, then: [{ return: 0 }] }
            - return: 1

- def:
    name: main
    return: i32
    body:
      - decl: [nest, ptr<NestedStore>, { new: NestedStore }]
      - call: [nest.open]
      - if:
          condition: { neq: [{ call: [nest.roundtrip] }, 1] }
          then: [{ print: ["FAIL nested path: store does not write/read"] }, { call: [sys.exit, 1] }]
      - decl: [made, path, "aiondb/a/b/c"]
      - if:
          condition: { eq: [{ call: [io.is_dir, made] }, false] }
          then: [{ print: ["FAIL the directory aiondb/a/b/c was not created"] }, { call: [sys.exit, 1] }]
      - print: ["PASS test_db_kv_nested_path"]
      - return: 0
