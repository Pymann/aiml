# SPEC: 31_db_integration
# Negativ-Test: `db.query` auf einem Kv muss beim UEBERSETZEN scheitern.
#
# `db.query` arbeitet auf einem Store<T> (db.open).  Ein Kv (db.open_kv) hat
# ein anderes Innenleben; der Aufruf uebersetzte trotzdem sauber und las dann
# Unsinn.  Zwei Gesichter desselben Fehlers:
#   - DataCreatures-Server, 12.11.2026: SIGSEGV beim Hochfahren in
#     aiml_db_store_is_active, addr=0x3f800000 -- das Bitmuster von 1.0f,
#     also ein Zahlenwert, der als Zeiger benutzt wurde.
#   - Dieselbe Zeile in klein: stumm eine LEERE Liste, obwohl ein passender
#     Eintrag im Kv liegt.
#
# Dazu kam, dass der Vorlauf den Typ eines KLASSENMITGLIEDS gar nicht
# ermittelte (`<.laden` ist auch eine VariableExpr, aber resolveVariable kennt
# sie nicht) -- damit fiel auch `order_by` auf einem Mitglied stillschweigend
# aus.  Beides ist jetzt ein Uebersetzungsfehler bzw. aufgeloest.
# Expected exit code: 1

- model:
    name: Posten
    fields:
      - [name, string]
      - [wert, i32]

- def:
    name: ist_gross
    args: [[pos, ref<Posten>]]
    return: i32
    body:
      - return: { ">": [pos.wert, 5] }

- class:
    name: Halter
    members:
      - [laden, Kv<string:Posten>]
    methods:
      - def:
          name: oeffne
          access: public
          body:
            - set: [<.laden, { call: [db.open_kv, "repro_mitglied", {persist: false}] }]
      - def:
          name: frage
          access: public
          return: i32
          body:
            - decl: [treffer, list<ref<Posten>>, { call: [db.query, <.laden, {where: ist_gross}] }]
            - return: treffer.len

- decl: [g_halter, ptr<Halter>, null]

- def:
    name: main
    return: i32
    body:
      - set: [g_halter, { new: Halter }]
      - call: [g_halter.oeffne]
      - decl: [eins, Posten]
      - set: [eins.name, "a"]
      - set: [eins.wert, 9]
      - call: [g_halter.laden.set, "a", eins]
      - print: ["vor der Abfrage"]
      - decl: [anzahl, i32, { call: [g_halter.frage] }]
      - print: ["Treffer: ${anzahl}"]
      - return: 0
