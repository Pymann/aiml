# SPEC: 31_db_integration
# Negative test: `db.query` on a Kv must fail when COMPILING.
#
# `db.query` works on a Store<T> (db.open).  A Kv (db.open_kv) has
# different internals; the call still compiled cleanly and then read
# nonsense.  Two faces of the same bug:
#   - DataCreatures server, 2026-11-12: SIGSEGV at startup in
#     aiml_db_store_is_active, addr=0x3f800000 -- the bit pattern of 1.0f,
#     i.e. a numeric value that was used as a pointer.
#   - The same line in small: silently an EMPTY list, although a matching
#     entry lies in the Kv.
#
# On top of that, the preliminary pass did not determine the type of a CLASS MEMBER at all
# (`<.laden` is a VariableExpr too, but resolveVariable does not know
# it) -- so `order_by` on a member silently dropped out as well.
# Both are now a compile error or resolved, respectively.
# Expected exit code: 1

- model:
    name: Posten
    fields:
      - [name, string]
      - [wert, i32]

- def:
    name: ist_gross
    args: [[pos, ref<Posten>]]
    return: i32
    body:
      - return: { ">": [pos.wert, 5] }

- class:
    name: Halter
    members:
      - [laden, Kv<string:Posten>]
    methods:
      - def:
          name: oeffne
          access: public
          body:
            - set: [<.laden, { call: [db.open_kv, "repro_mitglied", {persist: false}] }]
      - def:
          name: frage
          access: public
          return: i32
          body:
            - decl: [treffer, list<ref<Posten>>, { call: [db.query, <.laden, {where: ist_gross}] }]
            - return: treffer.len

- decl: [g_halter, ptr<Halter>, null]

- def:
    name: main
    return: i32
    body:
      - set: [g_halter, { new: Halter }]
      - call: [g_halter.oeffne]
      - decl: [eins, Posten]
      - set: [eins.name, "a"]
      - set: [eins.wert, 9]
      - call: [g_halter.laden.set, "a", eins]
      - print: ["before the query"]
      - decl: [anzahl, i32, { call: [g_halter.frage] }]
      - print: ["Treffer: ${anzahl}"]
      - return: 0
