# Regression test: typed persistent Deck Kv delete/clear operations
# Expected exit code: 0

- model:
    name: Deck
    fields:
      - [name, string]
      - [deck_type, string]
      - [description, string]
      - [card_ids, list<string>]
      - [total_mkp, i32]
      - [created_at, i64]

- def:
    name: main
    return: i32
    body:
      - decl: [var_kv, Kv<string:Deck>]
      - set: [var_kv, { call: [db.open_kv, "deck_persist_ops", {persist: true, path: "/tmp/aiml_test_deck_persist_ops/"}] }]

      - decl: [var_j1, string, '{"__type":"Deck","name":"Deck One","deck_type":"mana_deck","description":"one","card_ids":["a","b"],"total_mkp":3,"created_at":0}']
      - decl: [var_j2, string, '{"__type":"Deck","name":"Deck Two","deck_type":"spell_deck","description":"two","card_ids":["x","y","z"],"total_mkp":9,"created_at":1}']
      - decl: [var_d1, Deck]
      - decl: [var_d2, Deck]
      - set: [var_d1, { call: [sys.deserialize, var_j1, "Deck"] }]
      - set: [var_d2, { call: [sys.deserialize, var_j2, "Deck"] }]

      - call: [var_kv.set, "var_d1", var_d1]
      - call: [var_kv.set, "var_d2", var_d2]

      - decl: [klen, i32]
      - set: [klen, { call: [var_kv.len] }]
      - if:
          condition: { neq: [klen, 2] }
          then:
            - print: ["FAIL len_after_set=${klen}"]
            - call: [sys.exit, 1]

      - call: [var_kv.delete, "var_d1"]
      - decl: [has1, i32]
      - set: [has1, { call: [var_kv.has, "var_d1"] }]
      - if:
          condition: { neq: [has1, 0] }
          then:
            - print: ["FAIL has_d1=${has1}"]
            - call: [sys.exit, 1]

      - decl: [got2, ptr<Deck>]
      - set: [got2, { call: [var_kv.get, "var_d2"] }]
      - if:
          condition: { eq: [{ eq: [got2.name, "Deck Two"] }, 0] }
          then:
            - print: ["FAIL got2.name=${got2.name}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [got2.card_ids.len, 3] }
          then:
            - print: ["FAIL got2.card_ids.len=${got2.card_ids.len}"]
            - call: [sys.exit, 1]

      - call: [var_kv.clear]
      - set: [klen, { call: [var_kv.len] }]
      - if:
          condition: { neq: [klen, 0] }
          then:
            - print: ["FAIL len_after_clear=${klen}"]
            - call: [sys.exit, 1]

      - call: [db.checkpoint]
      - print: ["Deck persist ops PASS"]
      - return: 0
