# Tests for deep member access: a.b.c reads and writes
# Expected output:
# deep read: 99
# deep write: 7
# two level count: 10
# three level: 42
# three level after write: 55

- class:
    name: Inner
    members: [[value, i32]]

- class:
    name: Middle
    members: [[inner, Inner], [count, i32]]

- class:
    name: Outer
    members: [[mid, Middle], [tag, i32]]

# ── 1. Deep read: var_o.mid.inner.value ──────────────────────────────────────────

- decl: [var_o, Outer]
- set: [var_o.mid.inner.value, 99]
- decl: [var_r, i32, var_o.mid.inner.value]
- print: ["deep read: ${var_r}"]

# ── 2. Deep write: set: [var_o.mid.inner.value, val] ─────────────────────────────

- set: [var_o.mid.inner.value, 7]
- decl: [var_w, i32, var_o.mid.inner.value]
- print: ["deep write: ${var_w}"]

# ── 3. Two-level: var_o.mid.count ────────────────────────────────────────────────

- set: [var_o.mid.count, 10]
- decl: [var_mc, i32, var_o.mid.count]
- print: ["two level count: ${var_mc}"]

# ── 4. Fresh struct — three level read ───────────────────────────────────────

- decl: [var_o2, Outer]
- set: [var_o2.mid.inner.value, 42]
- decl: [var_pr, i32, var_o2.mid.inner.value]
- print: ["three level: ${var_pr}"]

# ── 5. Three level write + re-read ────────────────────────────────────────────

- set: [var_o2.mid.inner.value, 55]
- decl: [var_pw, i32, var_o2.mid.inner.value]
- print: ["three level after write: ${var_pw}"]
