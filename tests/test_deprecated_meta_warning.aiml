# SPEC?: 56_meta   # derived from the file name, to be confirmed
# static-check: off
# FEATURE: `meta: [deprecated]` on a def/method → the compiler emits at
# EVERY use site a WARNING with source location (not an error; the
# program compiles + runs normally).  Eases refactorings: mark the old API as
# deprecated, then the compiler shows all call sites.
#
# This test compiles + runs (exit 0).  The actual check is the
# warning on stderr — verified by the test runner via grep, not via the exit code.

- def:
    name: old_helper
    meta: [deprecated]
    return: i32
    body:
      - return: 7

- def:
    name: still_ok
    return: i32
    body:
      - return: 3

- model: { name: BoxData, fields: [[num, i32]] }

- class:
    name: Box
    models: [BoxData]
    methods:
      # deprecated Klassenmethode → Warning an jeder Aufrufstelle.
      - def: { name: old_read, meta: [deprecated], return: i32, body: [{ return: <.num }] }

- def:
    name: main
    return: i32
    body:
      # use of the deprecated function → the warning must arise here.
      - decl: [val_a, i32, { call: [old_helper] }]
      - decl: [val_b, i32, { call: [still_ok] }]
      - decl: [box, ptr<Box>, { new: Box }]
      - decl: [val_c, i32, { call: [box.old_read] }]
      - if:
          condition: { eq: [{ +: [val_a, val_b] }, 10] }
          then: [{ print: ["PASS deprecated_meta_warning: compiles + runs; check stderr for deprecation"] }]
          else: [{ print: ["FAIL deprecated_meta_warning"] }]
      - return: 0
