# SPEC?: 31_db_integration   # derived from the file name, to be confirmed
# Repro for a DataCreatures crash: two modules open the same
# `Kv<string:T>` with T = a deeply nested class (several nested
# structs, many list<> fields).
#
# Observed in the server: `aiml_ser_encode` crashes with signal 11 in
# `aiml_mirror_session_send_rpc_model` (serialising a DataCreature).
#
# Hypothesis: per compilation unit there is a PrivateLinkage global
# `__aiml_sernodes_<Type>`. If two modules open the same Kv with an identical
# type, the ser_nodes pointer from the FIRST open registers itself
# in the singleton cache. But the second module's code paths use their
# own local ser_nodes pointer — if the arrays diverge in content
# (e.g. because one module sees fewer transitive imports),
# encode/decode leads to wrong offsets → segfault.
#
# Write via the lib module, read via main → encode with lib's nodes,
# decode with main's nodes (or the other way round) → if the arrays are not
# byte-identical, it crashes.

- import: "tests/lib_typed_kv_repro.aiml"

# Double declaration in the main module: a NEW ser_nodes global for ReproOuter
# in this compilation unit.
- decl: [repro_kv, Kv<string:ReproOuter>, { call: [db.open_kv, "repro_things.kvwal", {persist: true}] }]

- call: [lib_put_thing, "id-A"]

# Lies via Main's get_copy → decode mit MAIN's ser_nodes (lib hat geschrieben).
- decl: [var_t, ReproOuter, { call: [repro_kv.get_copy, "id-A"] }]

- if:
    condition: { neq: [var_t.outer_id, "id-A"] }
    then:
      - print: ["FAIL: outer_id='${var_t.outer_id}' expected 'id-A'"]
      - call: [sys.exit, 1]
- if:
    condition: { neq: [var_t.mid.mid_id, "mid-id-A"] }
    then:
      - print: ["FAIL: mid.mid_id='${var_t.mid.mid_id}' expected 'mid-id-A'"]
      - call: [sys.exit, 1]
- if:
    condition: { neq: [var_t.mid.inner.inner_id, "inner-id-A"] }
    then:
      - print: ["FAIL: inner_id='${var_t.mid.inner.inner_id}'"]
      - call: [sys.exit, 1]
- if:
    condition: { neq: [var_t.mid.inner.tags.len, 2] }
    then:
      - print: ["FAIL: inner.tags.len=${var_t.mid.inner.tags.len} expected 2"]
      - call: [sys.exit, 1]
- if:
    condition: { neq: [var_t.mid.inner.counts.len, 2] }
    then:
      - print: ["FAIL: inner.counts.len=${var_t.mid.inner.counts.len} expected 2"]
      - call: [sys.exit, 1]
- decl: [var_c0, i32, { at: [var_t.mid.inner.counts, 0] }]
- decl: [var_c1, i32, { at: [var_t.mid.inner.counts, 1] }]
- if:
    condition: { neq: [var_c0, 7] }
    then: [{ print: ["FAIL: counts[0]=${var_c0}"] }, { call: [sys.exit, 1] }]
- if:
    condition: { neq: [var_c1, 42] }
    then: [{ print: ["FAIL: counts[1]=${var_c1}"] }, { call: [sys.exit, 1] }]
- if:
    condition: { neq: [var_t.extra.len, 1] }
    then: [{ print: ["FAIL: extra.len=${var_t.extra.len}"] }, { call: [sys.exit, 1] }]
- if:
    condition: { neq: [var_t.flags.len, 3] }
    then: [{ print: ["FAIL: flags.len=${var_t.flags.len}"] }, { call: [sys.exit, 1] }]

# Umgekehrt: schreibe via Main, lies via Main — full round trip.
- decl: [obj2, ReproOuter]
- set: [obj2.outer_id, "id-B"]
- set: [obj2.mid.mid_id, "mid-B"]
- set: [obj2.mid.inner.inner_id, "inner-B"]
- call: [obj2.mid.inner.tags.push, "main-tag"]
- call: [repro_kv.set, "id-B", obj2]
- decl: [var_t2, ReproOuter, { call: [repro_kv.get_copy, "id-B"] }]
- if:
    condition: { neq: [var_t2.mid.inner.tags.len, 1] }
    then: [{ print: ["FAIL: round-trip inner.tags.len=${var_t2.mid.inner.tags.len}"] }, { call: [sys.exit, 1] }]

- print: ["PASS test_dual_module_typed_kv"]
