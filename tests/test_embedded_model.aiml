# SPEC?: 15_models   # derived from the file name, to be confirmed
# tests/test_embedded_model.aiml — repro test: embedded model struct (by-value field in a model)
#
# Tests:
#   1. a model with an embedded model-by-value field (no ptr<T>)
#   2. { new: OuterModel } with an embedded inner struct
#   3. set: [outer.inner_field, inner_val] (struct-to-embedded-struct copy)
#   4. outer.inner_field.var_x chain access (read)
#   5. an embedded field as a by-value function argument
#   6. isolation of two heap instances

# ─── Test-Modelle ──────────────────────────────────────────────────────────────
- model:
    name: EPoint
    fields:
      - [var_x, i32, 0]
      - [var_y, i32, 0]

- model:
    name: ERect
    fields:
      - [origin, EPoint, 0]    # embedded EPoint by-value
      - [var_w,      i32,    0]
      - [var_h,      i32,    0]

# ─── Hilfsfunktion ────────────────────────────────────────────────────────────
- def:
    name: epoint_sum
    args: [[var_p, EPoint]]
    return: i32
    body:
      - return: [{ +: [var_p.var_x, var_p.var_y] }]

# ─── Haupttest ────────────────────────────────────────────────────────────────
- def:
    name: main
    args: []
    return: i32
    body:
      # T1: embedded field after { new: ERect } = 0 (default)
      - decl: [var_r, "ptr<ERect>", { new: ERect }]
      - if:
          condition: { neq: [var_r.origin.var_x, 0] }
          then:
            - print: ["FAIL T1a: new ERect origin.var_x should be 0, got ${var_r.origin.var_x}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_r.origin.var_y, 0] }
          then:
            - print: ["FAIL T1b: new ERect origin.var_y should be 0, got ${var_r.origin.var_y}"]
            - call: [sys.exit, 1]
      - print: ["T1 PASS: new ERect embedded field defaults"]

      # T2: embedded struct via lokale Variable setzen
      - decl: [var_p, EPoint]
      - set: [var_p.var_x, 42]
      - set: [var_p.var_y, 99]
      - set: [var_r.origin, var_p]
      - if:
          condition: { neq: [var_r.origin.var_x, 42] }
          then:
            - print: ["FAIL T2a: var_r.origin.var_x should be 42, got ${var_r.origin.var_x}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_r.origin.var_y, 99] }
          then:
            - print: ["FAIL T2b: var_r.origin.var_y should be 99, got ${var_r.origin.var_y}"]
            - call: [sys.exit, 1]
      - print: ["T2 PASS: set embedded field via local var"]

      # T3: other fields untouched
      - set: [var_r.var_w, 200]
      - set: [var_r.var_h, 100]
      - if:
          condition: { neq: [var_r.var_w, 200] }
          then:
            - print: ["FAIL T3a: var_r.var_w should be 200, got ${var_r.var_w}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_r.var_h, 100] }
          then:
            - print: ["FAIL T3b: var_r.var_h should be 100, got ${var_r.var_h}"]
            - call: [sys.exit, 1]
      - print: ["T3 PASS: other fields unaffected"]

      # T4: embedded field als by-value Funktionsargument
      - decl: [var_s, i32, { call: [epoint_sum, var_r.origin] }]
      - if:
          condition: { neq: [var_s, 141] }
          then:
            - print: ["FAIL T4: epoint_sum(var_r.origin) should be 141, got ${var_s}"]
            - call: [sys.exit, 1]
      - print: ["T4 PASS: embedded field as by-value function arg"]

      # T5: sub-field direkt setzen (var_r.origin.var_x = 7)
      - set: [var_r.origin.var_x, 7]
      - if:
          condition: { neq: [var_r.origin.var_x, 7] }
          then:
            - print: ["FAIL T5a: var_r.origin.var_x should be 7, got ${var_r.origin.var_x}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_r.origin.var_y, 99] }
          then:
            - print: ["FAIL T5b: var_r.origin.var_y should still be 99, got ${var_r.origin.var_y}"]
            - call: [sys.exit, 1]
      - print: ["T5 PASS: sub-field direct set"]

      # T6: isolation — the second instance does not affect the first
      - decl: [var_r2, "ptr<ERect>", { new: ERect }]
      - decl: [var_p2, EPoint]
      - set: [var_p2.var_x, 1]
      - set: [var_p2.var_y, 2]
      - set: [var_r2.origin, var_p2]
      - if:
          condition: { neq: [var_r.origin.var_x, 7] }
          then:
            - print: ["FAIL T6a: r1 should still have var_x=7 after var_r2 set, got ${var_r.origin.var_x}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_r2.origin.var_x, 1] }
          then:
            - print: ["FAIL T6b: var_r2.origin.var_x should be 1, got ${var_r2.origin.var_x}"]
            - call: [sys.exit, 1]
      - print: ["T6 PASS: two instances isolated"]

      - print: ["test_embedded_model PASS"]
      - return: [0]
