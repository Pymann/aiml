# SPEC?: 15_models   # derived from the file name, to be confirmed
# tests/test_embedded_model_large.aiml — repro: large embedded struct + multi-level ptr chain
#
# Mimics the PfJobQueue / TulTrainCfg situation:
#   - large inner struct with ~20 fields (i32, f32, string)
#   - heap-allocated outer struct (ptr<PfJobQueue>)
#   - worker struct with a ptr to outer (ptr<PfWorkerHandle>)
#   - set: [outer.inner, inner_val]       (struct-to-embedded-struct)
#   - var_wh.queue.inner.field  (3-level chain through an embedded struct)
#   - spawn + channel + embedded struct access in the thread

# ─── Modelle ──────────────────────────────────────────────────────────────────
- model:
    name: BigCfg
    fields:
      - [var_a0, i32, 0]
      - [var_a1, i32, 0]
      - [var_a2, i32, 0]
      - [var_a3, i32, 0]
      - [var_a4, i32, 0]
      - [var_a5, f32, 0.0]
      - [var_a6, f32, 0.0]
      - [var_a7, f32, 0.0]
      - [var_a8, string, ""]
      - [var_a9, string, ""]
      - [var_b0, i32, 0]
      - [var_b1, i32, 0]
      - [var_b2, i32, 0]
      - [var_b3, f32, 0.0]
      - [var_b4, f32, 0.0]
      - [var_b5, string, ""]
      - [var_b6, i32, 0]
      - [var_b7, i32, 0]
      - [var_b8, i32, 0]
      - [var_b9, i32, 0]

- model:
    name: BigQueue
    fields:
      - [var_ch,  "chan<i32>", 0]
      - [cfg, BigCfg,     0]

- model:
    name: BigWorker
    fields:
      - [queue,  "ptr<BigQueue>", 0]
      - [thread, thread_handle,   0]

# ─── helper function that receives BigCfg by value ──────────────────────────────
- def:
    name: process_cfg
    args:
      - [var_fi, i32]
      - [cfg, BigCfg]
    return: i32
    body:
      - set: [cfg.var_a0, { +: [cfg.var_a0, var_fi] }]
      - print: ["    [process_cfg] var_fi=${var_fi} var_a0=${cfg.var_a0} var_b6=${cfg.var_b6}"]
      - return: [cfg.var_a0]

# ─── Worker-Loop ──────────────────────────────────────────────────────────────
- def:
    name: big_worker_loop
    args:
      - [var_wh, "ref<BigWorker>"]
    return: void
    body:
      # read n_workers from the embedded struct via a 3-level chain
      - decl: [var_n, i32, var_wh.queue.cfg.var_b6]
      - print: ["  [worker] var_b6=${var_n}"]
      # Empfange Job-Index, bis Sentinel
      - decl: [var_fi, i32, { call: [var_wh.queue.var_ch.recv] }]
      - while:
          condition: { ">=": [var_fi, 0] }
          body:
            # CORE: pass the embedded BigCfg by value to a function
            - decl: [var_r, i32, { call: [process_cfg, var_fi, var_wh.queue.cfg] }]
            - print: ["  [worker] job ${var_fi} done, result=${var_r}"]
            - set: [var_fi, { call: [var_wh.queue.var_ch.recv] }]
      - print: ["  [worker] sentinel received, exiting"]
      - call: [tensor.thread_cleanup]

# ─── Test ─────────────────────────────────────────────────────────────────────
- def:
    name: main
    args: []
    return: i32
    body:
      # T1: BigCfg fields after new
      - decl: [var_q, "ptr<BigQueue>", { new: BigQueue }]
      - if:
          condition: { neq: [var_q.cfg.var_a0, 0] }
          then:
            - print: ["FAIL T1: var_q.cfg.var_a0 should be 0"]
            - call: [sys.exit, 1]
      - print: ["T1 PASS: new BigQueue embedded fields default 0"]

      # T2: BigCfg struct kopieren
      - decl: [var_c, BigCfg]
      - set: [var_c.var_a0, 100]
      - set: [var_c.var_a1, 200]
      - set: [var_c.var_b6, 42]
      - set: [var_c.var_a8, "hello"]
      - set: [var_c.var_a9, "world"]
      - set: [var_q.cfg, var_c]
      - if:
          condition: { neq: [var_q.cfg.var_a0, 100] }
          then:
            - print: ["FAIL T2a: var_q.cfg.var_a0 should be 100, got ${var_q.cfg.var_a0}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_q.cfg.var_a1, 200] }
          then:
            - print: ["FAIL T2b: var_q.cfg.var_a1 should be 200"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_q.cfg.var_b6, 42] }
          then:
            - print: ["FAIL T2c: var_q.cfg.var_b6 should be 42, got ${var_q.cfg.var_b6}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_q.cfg.var_a8, "hello"] }
          then:
            - print: ["FAIL T2d: var_q.cfg.var_a8 should be hello"]
            - call: [sys.exit, 1]
      - print: ["T2 PASS: BigCfg struct copy into embedded field"]

      # T3: set the channel + spawn a worker + 3-level chain in the thread
      - decl: [qch, "chan<i32>"]
      - set: [var_q.var_ch, qch]
      - decl: [var_wh, "ptr<BigWorker>", { new: BigWorker }]
      - set: [var_wh.queue, var_q]
      - decl: [var_tw, thread_handle, { spawn: [big_worker_loop, var_wh] }]
      - call: [var_q.var_ch.send, 99]
      - call: [var_q.var_ch.send, -1]
      - call: [var_tw.join]
      - print: ["T3 PASS: worker accesses embedded struct via 3-level chain"]

      - print: ["test_embedded_model_large PASS"]
      - return: [0]
