# SPEC?: 44_1_engine   # derived from the file name, to be confirmed
# Engine + Input + gl_mesh test
#
# Tests the full cross-platform abstraction layer:
#   engine  — window creation, game loop, frame timing
#   input   — init, mapping, polling, event queue
#   gl_mesh — manual geometry upload + prim.to_gl_mesh()
#
# Erfordert einen aktiven Display (X11 oder Wayland).
# Ausführen: ./out/aiml -r tests/test_engine.aiml
# Expected exit code: 0
# Requires: display

# ── Phase A: Plattform-Informationen (kein GL-Kontext nötig) ──────────────────
#
# engine.platform() ist eine compile-time Konstante (keine GLFW-Abhängigkeit).
# Auf Desktop muss sie "desktop" zurückgeben.

- decl: [plat, string, { call: [engine.platform] }]
- if: [{ neq: [plat, "desktop"] }, true]
  then:
    - print: ["FAIL Phase A: platform != 'desktop': ", plat]
    - call: [sys.exit, 1]

- decl: [mob, i32, { call: [engine.is_mobile] }]
- if: [{ neq: [mob, 0] }, true]
  then:
    - print: ["FAIL Phase A: is_mobile should be 0, got: ", mob]
    - call: [sys.exit, 1]

- decl: [web, i32, { call: [engine.is_web] }]
- if: [{ neq: [web, 0] }, true]
  then:
    - print: ["FAIL Phase A: is_web should be 0, got: ", web]
    - call: [sys.exit, 1]

- print: ["Phase A OK: platform=", plat, " mobile=", mob, " web=", web]

# ── Phase B: Fenster erstellen ────────────────────────────────────────────────
#
# engine.create_window ersetzt glfwInit + glfwCreateWindow + glfwMakeContextCurrent
# + glewInit vollständig. GL 3.3 Core Profile + Depth-Test sind danach aktiv.

- decl: [win, window_handle, { call: [engine.create_window, 800, 600, "AIML Engine Test"] }]
- if: [{ eq: [win, null] }, true]
  then:
    - print: ["FAIL Phase B: engine.create_window returned null"]
    - call: [sys.exit, 1]

- decl: [running, i32, { call: [engine.running, win] }]
- if: [{ eq: [running, 0] }, true]
  then:
    - print: ["FAIL Phase B: engine.running should be 1 after create_window"]
    - call: [sys.exit, 1]

- print: ["Phase B OK: window created, running=", running]

# ── Phase C: Input — Init, Mapping, Polling ───────────────────────────────────
#
# input.init registriert GLFW-Callbacks und verdrahtet aiml_input_update mit
# dem Frame-Loop via aiml_engine_register_input_update.

- call: [input.init, win]

# Achsen und Aktionen mappen
- call: [input.map_axis,   "forward", "W",  1.0]
- call: [input.map_axis,   "forward", "S", -1.0]
- call: [input.map_axis,   "strafe",  "D",  1.0]
- call: [input.map_axis,   "strafe",  "A", -1.0]
- call: [input.map_action, "fire",    "Space"]

# Keine Taste gedrückt → alle Polling-Werte müssen 0/0.0 sein

- decl: [ax_fwd, f32, { call: [input.axis, "forward"] }]
- if: [{ neq: [ax_fwd, 0] }, true]
  then:
    - print: ["FAIL Phase C: axis('forward') should be 0.0, got: ", ax_fwd]
    - call: [sys.exit, 1]

- decl: [fire_down, i32, { call: [input.action_down, "fire"] }]
- if: [{ neq: [fire_down, 0] }, true]
  then:
    - print: ["FAIL Phase C: action_down('fire') should be 0, got: ", fire_down]
    - call: [sys.exit, 1]

- decl: [has_ev, i32, { call: [input.has_event] }]
- if: [{ neq: [has_ev, 0] }, true]
  then:
    - print: ["FAIL Phase C: has_event should be 0, got: ", has_ev]
    - call: [sys.exit, 1]

- decl: [w_down, i32, { call: [input.key_down, "W"] }]
- if: [{ neq: [w_down, 0] }, true]
  then:
    - print: ["FAIL Phase C: key_down('W') should be 0, got: ", w_down]
    - call: [sys.exit, 1]

- decl: [mb0, i32, { call: [input.mouse_button, 0] }]
- if: [{ neq: [mb0, 0] }, true]
  then:
    - print: ["FAIL Phase C: mouse_button(0) should be 0, got: ", mb0]
    - call: [sys.exit, 1]

- decl: [gp0, i32, { call: [input.gamepad_connected, 0] }]
# gamepad_connected kann 0 oder 1 sein — kein Fehler, nur ausgeben

- print: ["Phase C OK: axis=", ax_fwd, " fire=", fire_down, " has_ev=", has_ev, " gamepad0=", gp0]

# ── Phase D: gl_mesh — manuelle Geometrie ────────────────────────────────────
#
# Ein einfaches Dreieck in der XY-Ebene: 3 Vertices (xyz), 3 Indizes.
# UVs und Normals werden als null übergeben (optionale Attribute).

- decl: [tri_pos, buffer<f32>, [-0.5, -0.5, 0.0,
                                  0.5, -0.5, 0.0,
                                  0.0,  0.5, 0.0]]

- decl: [tri_idx, buffer<u32>, [0, 1, 2]]

- decl: [tri_mesh, gl_mesh, { call: [gl.create_mesh, tri_pos, null, null, tri_idx] }]
- if: [{ eq: [tri_mesh, null] }, true]
  then:
    - print: ["FAIL Phase D: gl.create_mesh returned null"]
    - call: [sys.exit, 1]

- decl: [icnt, i32, { call: [tri_mesh.index_count] }]
- if: [{ neq: [icnt, 3] }, true]
  then:
    - print: ["FAIL Phase D: index_count should be 3, got: ", icnt]
    - call: [sys.exit, 1]

- print: ["Phase D OK: gl_mesh created, index_count=", icnt]

# ── Phase E: prim.to_gl_mesh — GLTF-Pipeline ─────────────────────────────────
#
# test.glb ist ein minimales GLB mit genau einem Mesh und einer Primitive.
# prim.to_gl_mesh() führt intern positions/uvs/normals/indices-Abruf und
# aiml_gl_create_mesh durch und gibt das fertige gl_mesh zurück.

- decl: [var_gp, path, "tests/test.glb"]
- decl: [scene, gltf_scene, { call: [gltf.load, var_gp] }]
- decl: [var_sv, i32, { call: [scene.valid] }]
- if: [{ eq: [var_sv, 0] }, true]
  then:
    - print: ["FAIL Phase E: gltf.load failed"]
    - call: [sys.exit, 1]

- decl: [meshes, list<gltf_mesh>]
- set:  [meshes, { call: [scene.meshes] }]
- decl: [var_mc, i32, { call: [meshes.len] }]
- if: [{ <: [var_mc, 1] }, true]
  then:
    - print: ["FAIL Phase E: no meshes in scene"]
    - call: [sys.exit, 1]

- decl: [gmesh, gltf_mesh, { call: [meshes.get, 0] }]
- decl: [prim, gltf_primitive, { call: [gmesh.primitive, 0] }]

- decl: [gltf_mesh_obj, gl_mesh, { call: [prim.to_gl_mesh] }]
- if: [{ eq: [gltf_mesh_obj, null] }, true]
  then:
    - print: ["FAIL Phase E: prim.to_gl_mesh returned null"]
    - call: [sys.exit, 1]

- decl: [gm_icnt, i32, { call: [gltf_mesh_obj.index_count] }]
- if: [{ <: [gm_icnt, 1] }, true]
  then:
    - print: ["FAIL Phase E: prim.to_gl_mesh index_count < 1, got: ", gm_icnt]
    - call: [sys.exit, 1]

- print: ["Phase E OK: prim.to_gl_mesh index_count=", gm_icnt]

# ── Phase F: Frame-Loop — engine.swap + Frame-Zähler ─────────────────────────
#
# Manueller Loop-Stil: 30 Frames rendern und dann beenden.
# Jeder engine.swap-Aufruf: SwapBuffers + PollEvents + frame_count++
# Wir prüfen, dass engine.frame() nach N Frames >= N ist.

- decl: [var_fr, i32, 0]
- while:
    condition: { lt: [var_fr, 30] }
    body:
      - call: [gl.clear_all, 0.0, 0.0, 0.1, 1.0]
      - call: [tri_mesh.draw]
      - call: [engine.swap, win]
      - set: [var_fr, { +: [var_fr, 1] }]

- decl: [eng_frame, i64, { call: [engine.frame] }]
- if: [{ <: [eng_frame, 30] }, true]
  then:
    - print: ["FAIL Phase F: engine.frame() < 30 after 30 swaps, got: ", eng_frame]
    - call: [sys.exit, 1]

- decl: [eng_fps, f32, { call: [engine.fps] }]
- print: ["Phase F OK: frame=", eng_frame, " fps=", eng_fps]

# ── Aufräumen ─────────────────────────────────────────────────────────────────

- call: [gltf_mesh_obj.delete]
- call: [tri_mesh.delete]
- call: [engine.destroy_window, win]

- print: ["All engine tests passed"]
