# SPEC: 14_enums
# Negative test: a string literal is passed to an enum-typed method
# argument.  That is a HARD compiler error at the call site —
# with source location and a hint to use the enum symbol (EnumType.<value>).
#
# Without this check the mismatch (i8* → i32) slips past the frontend and
# only shows up as a cryptic LLVM IR verifier error without a line number.
# See spec/14_enums.md §"Argument Type Checking".
#
# Expected exit code: 1
#
# Diagnostic form:
#   ...: Call to 'Painter_paint': argument 1 ('col') type mismatch —
#   passing a string/pointer where an integer- or enum-typed argument is
#   expected; use EnumType.<value> or an int literal

- enum:
    name: Color
    values: [red, green, blue]

- class:
    name: Painter
    members:
      - [tag, string]
    methods:
      - def:
          name: paint
          args: [[col, Color], [amount, i32]]
          return: i32
          body:
            - return: amount

- def:
    name: main
    return: i32
    body:
      - decl: [pnt, ptr<Painter>, { new: Painter }]
      # BUG: "green" is a string — col expects the enum Color.
      - decl: [res, i32, { call: [pnt.paint, "green", 5] }]
      - return: res
