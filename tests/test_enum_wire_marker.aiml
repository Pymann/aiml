# SPEC: 49_static_analysis §18.2a, 14_enums
# `wire: true`: an enum whose vocabulary crosses a boundary does NOT report its
# unnamed members as dead.
#
# Without the setting the build rightly warns (test_unused_enum_member.aiml records
# that).  Here is the opposite case: the same pattern WITH `wire: true` — one
# member named, three not — and not a word about it.
#
# The warning itself is checked by the test runner (absence of ExpectedStderr
# cannot be expressed); this test makes sure that `wire: true`
# COMPILES and leaves the values unchanged — a setting that silently shifted the
# numbers would be worse than the warning.
#
# Expected exit code: 0

- enum:
    name: JobWire
    wire: true
    values:
      - queued
      - running
      - agent_lost
      - finished

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [only_one, JobWire, JobWire.running]
      - if:
          condition: { neq: [{ cast: [only_one, i32] }, 1] }
          then: [{ print: ["FAIL wire enum shifts values: ${{ cast: [only_one, i32] }}"] }, { return: 1 }]
      - decl: [last_one, JobWire, JobWire.finished]
      - if:
          condition: { neq: [{ cast: [last_one, i32] }, 3] }
          then: [{ print: ["FAIL last value is not 3"] }, { return: 1 }]
      - print: ["enum wire PASS"]
      - return: 0
