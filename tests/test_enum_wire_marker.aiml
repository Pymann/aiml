# SPEC: 49_static_analysis §18.2a, 14_enums
# `wire: true`: ein Enum, dessen Vokabular ueber eine Grenze geht, meldet seine
# unbenannten Mitglieder NICHT als tot.
#
# Ohne die Angabe warnt der Build zu Recht (test_unused_enum_member.aiml haelt
# das fest).  Hier steht der Gegenfall: dasselbe Muster MIT `wire: true` — ein
# Mitglied benannt, drei nicht — und kein Wort darueber.
#
# Geprueft wird die Warnung selbst vom Testlaeufer (ExpectedStderr-Abwesenheit
# laesst sich nicht ausdruecken); dieser Test sichert, dass `wire: true`
# UEBERSETZT und die Werte unveraendert laesst — eine Angabe, die still die
# Zahlen verschoebe, waere schlimmer als die Warnung.
#
# Expected exit code: 0

- enum:
    name: JobWire
    wire: true
    values:
      - queued
      - running
      - agent_lost
      - finished

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [only_one, JobWire, JobWire.running]
      - if:
          condition: { neq: [{ cast: [only_one, i32] }, 1] }
          then: [{ print: ["FAIL wire-Enum verschiebt Werte: ${{ cast: [only_one, i32] }}"] }, { return: 1 }]
      - decl: [last_one, JobWire, JobWire.finished]
      - if:
          condition: { neq: [{ cast: [last_one, i32] }, 3] }
          then: [{ print: ["FAIL letzter Wert ist nicht 3"] }, { return: 1 }]
      - print: ["enum wire PASS"]
      - return: 0
