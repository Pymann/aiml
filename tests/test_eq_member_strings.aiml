# SPEC?: 39_operators,15_models
# Regression: `eq`/`neq` auf ZWEI Member-Strings desselben Objekts fiel auf
# Pointer-Identity zurueck, obwohl beide Typen statisch bekannt sind (beide
# `string`-Felder derselben Klasse).  Der Resolver in visitBinary kannte nur
# die Schreibweise `obj.feld`; die Quellschreibweise fuer das aktuelle Objekt
# ist aber `<.feld` — resolveVariable("<") schlug fehl, der Typname blieb leer,
# und der Vergleich uebersetzte lautlos zu "immer ungleich".
#
# Gefunden im cai-Wikipedia-Leser: `{ eq: [<.tag_name, <.skip_tag] }` traf nie,
# darum wurde 10.000 Artikel lang alles nach dem ersten uebersprungenen
# Element verworfen.  Eine Warnung gab es, aber sie war irrefuehrend —
# "without resolvable type" stimmte nicht, der Typ WAR da.
#
# Expected exit code: 0

- class:
    name: Tagger
    members:
      - [tag_name,   string, "", { access: public }]
      - [skip_tag,   string, "", { access: public }]
      - [other_tag,  string, "", { access: public }]
    methods:
      # `<.a` gegen `<.b` mit GLEICHEM Inhalt, aber getrennt gebauten Strings:
      # bei Pointer-Identity ist das false, inhaltlich true.
      - def:
          name: eq_same_content
          args: []
          return: i32
          body:
            - if: { condition: { eq: [<.tag_name, <.skip_tag] }, then: [{ return: 1 }] }
            - return: 0
      - def:
          name: neq_same_content
          args: []
          return: i32
          body:
            - if: { condition: { neq: [<.tag_name, <.skip_tag] }, then: [{ return: 1 }] }
            - return: 0
      # Gegenprobe: wirklich unterschiedlicher Inhalt muss ungleich sein.
      - def:
          name: eq_diff_content
          args: []
          return: i32
          body:
            - if: { condition: { eq: [<.tag_name, <.other_tag] }, then: [{ return: 1 }] }
            - return: 0
      # Die zweite Schreibweise fuer dasselbe Objekt.
      - def:
          name: eq_this_spelling
          args: []
          return: i32
          body:
            - if: { condition: { eq: [this.tag_name, this.skip_tag] }, then: [{ return: 1 }] }
            - return: 0
      # Kontrolle: Member gegen Literal ging schon vorher (Literal liefert den Typ).
      - def:
          name: eq_member_literal
          args: []
          return: i32
          body:
            - if: { condition: { eq: [<.tag_name, "span"] }, then: [{ return: 1 }] }
            - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [tgr, Tagger]

      # Beide Felder auf denselben INHALT setzen, aber aus getrennten Quellen,
      # damit kein Zufall zweimal denselben Zeiger liefert.
      - decl: [part_a, string, "sp"]
      - decl: [part_b, string, "an"]
      - set: [tgr.tag_name, "span"]
      - set: [tgr.skip_tag, "${part_a}${part_b}"]
      - set: [tgr.other_tag, "div"]

      - decl: [res_eq, i32, { call: [tgr.eq_same_content] }]
      - if:
          condition: { neq: [res_eq, 1] }
          then:
            - print: ["FAIL eq auf zwei gleiche Member-Strings ergab false (res=${res_eq})"]
            - set: [fails, { +: [fails, 1] }]

      - decl: [res_neq, i32, { call: [tgr.neq_same_content] }]
      - if:
          condition: { neq: [res_neq, 0] }
          then:
            - print: ["FAIL neq auf zwei gleiche Member-Strings ergab true (res=${res_neq})"]
            - set: [fails, { +: [fails, 1] }]

      - decl: [res_diff, i32, { call: [tgr.eq_diff_content] }]
      - if:
          condition: { neq: [res_diff, 0] }
          then:
            - print: ["FAIL eq auf unterschiedliche Member-Strings ergab true (res=${res_diff})"]
            - set: [fails, { +: [fails, 1] }]

      - decl: [res_this, i32, { call: [tgr.eq_this_spelling] }]
      - if:
          condition: { neq: [res_this, 1] }
          then:
            - print: ["FAIL eq mit this.-Schreibweise ergab false (res=${res_this})"]
            - set: [fails, { +: [fails, 1] }]

      - decl: [res_lit, i32, { call: [tgr.eq_member_literal] }]
      - if:
          condition: { neq: [res_lit, 1] }
          then:
            - print: ["FAIL eq Member gegen Literal ergab false (res=${res_lit})"]
            - set: [fails, { +: [fails, 1] }]

      # Kontrolle von AUSSEN: `obj.feld` gegen `obj.feld` ging schon vorher.
      - if:
          condition: { neq: [tgr.tag_name, tgr.skip_tag] }
          then:
            - print: ["FAIL eq von aussen (obj.feld) ergab ungleich"]
            - set: [fails, { +: [fails, 1] }]

      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS test_eq_member_strings"] }]
          else: [{ print: ["FAILED ${fails} Pruefungen"] }]
      - return: fails
