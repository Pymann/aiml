# SPEC?: 39_operators,15_models
# Regression: `eq`/`neq` on TWO member strings of the same object fell back to
# pointer identity, although both types are statically known (both
# `string` fields of the same class).  The resolver in visitBinary only knew
# the notation `obj.field`; but the source notation for the current object
# is `<.field` — resolveVariable("<") failed, the type name stayed empty,
# and the comparison silently compiled to "always unequal".
#
# Found in the cai Wikipedia reader: `{ eq: [<.tag_name, <.skip_tag] }` never matched,
# so for 10,000 articles everything after the first skipped
# element was discarded.  There was a warning, but it was misleading —
# "without resolvable type" was not true, the type WAS there.
#
# Expected exit code: 0

- class:
    name: Tagger
    members:
      - [tag_name,   string, "", { access: public }]
      - [skip_tag,   string, "", { access: public }]
      - [other_tag,  string, "", { access: public }]
    methods:
      # `<.a` against `<.b` with the SAME content, but separately built strings:
      # with pointer identity that is false, by content true.
      - def:
          name: eq_same_content
          args: []
          return: i32
          body:
            - if: { condition: { eq: [<.tag_name, <.skip_tag] }, then: [{ return: 1 }] }
            - return: 0
      - def:
          name: neq_same_content
          args: []
          return: i32
          body:
            - if: { condition: { neq: [<.tag_name, <.skip_tag] }, then: [{ return: 1 }] }
            - return: 0
      # counter-probe: really different content must be unequal.
      - def:
          name: eq_diff_content
          args: []
          return: i32
          body:
            - if: { condition: { eq: [<.tag_name, <.other_tag] }, then: [{ return: 1 }] }
            - return: 0
      # the second notation for the same object.
      - def:
          name: eq_this_spelling
          args: []
          return: i32
          body:
            - if: { condition: { eq: [this.tag_name, this.skip_tag] }, then: [{ return: 1 }] }
            - return: 0
      # control: member against literal already worked before (the literal provides the type).
      - def:
          name: eq_member_literal
          args: []
          return: i32
          body:
            - if: { condition: { eq: [<.tag_name, "span"] }, then: [{ return: 1 }] }
            - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [tgr, Tagger]

      # set both fields to the same CONTENT, but from separate sources,
      # so that no coincidence yields the same pointer twice.
      - decl: [part_a, string, "sp"]
      - decl: [part_b, string, "an"]
      - set: [tgr.tag_name, "span"]
      - set: [tgr.skip_tag, "${part_a}${part_b}"]
      - set: [tgr.other_tag, "div"]

      - decl: [res_eq, i32, { call: [tgr.eq_same_content] }]
      - if:
          condition: { neq: [res_eq, 1] }
          then:
            - print: ["FAIL eq on two equal member strings gave false (res=${res_eq})"]
            - set: [fails, { +: [fails, 1] }]

      - decl: [res_neq, i32, { call: [tgr.neq_same_content] }]
      - if:
          condition: { neq: [res_neq, 0] }
          then:
            - print: ["FAIL neq on two equal member strings gave true (res=${res_neq})"]
            - set: [fails, { +: [fails, 1] }]

      - decl: [res_diff, i32, { call: [tgr.eq_diff_content] }]
      - if:
          condition: { neq: [res_diff, 0] }
          then:
            - print: ["FAIL eq on different member strings gave true (res=${res_diff})"]
            - set: [fails, { +: [fails, 1] }]

      - decl: [res_this, i32, { call: [tgr.eq_this_spelling] }]
      - if:
          condition: { neq: [res_this, 1] }
          then:
            - print: ["FAIL eq with the this. notation gave false (res=${res_this})"]
            - set: [fails, { +: [fails, 1] }]

      - decl: [res_lit, i32, { call: [tgr.eq_member_literal] }]
      - if:
          condition: { neq: [res_lit, 1] }
          then:
            - print: ["FAIL eq member against literal gave false (res=${res_lit})"]
            - set: [fails, { +: [fails, 1] }]

      # control from OUTSIDE: `obj.field` against `obj.field` already worked before.
      - if:
          condition: { neq: [tgr.tag_name, tgr.skip_tag] }
          then:
            - print: ["FAIL eq from outside (obj.feld) gave unequal"]
            - set: [fails, { +: [fails, 1] }]

      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS test_eq_member_strings"] }]
          else: [{ print: ["FAILED ${fails} Pruefungen"] }]
      - return: fails
