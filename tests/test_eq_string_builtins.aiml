# SPEC?: 39_overloading,09_strings
# Regression: `eq`/`neq` on the result of TWO string builtins
# (`{ eq: [zeichen.lower(), zeichen.upper()] }`) fell back to pointer identity.
# Both operands are fresh allocations, so this was silently
# "always unequal" — although the return type is statically known.  A
# string builtin is in no FunctionInfo, which is why the resolver
# in visitBinary returned an empty type name.
#
# From the same cai night as test_eq_member_strings: in eigenschaft_leser.aiml
# `fortsetzung` the compiler warned about two call temporaries.  Worked around there with
# typed locals; recorded here that it also works directly.
#
# Expected exit code: 0

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [zeichen, string, "Abc"]
      - decl: [gleich,  string, "abc"]

      # two builtins, DIFFERENT content → must be unequal.
      - if:
          condition: { eq: [{ call: [zeichen.lower] }, { call: [zeichen.upper] }] }
          then:
            - print: ["FAIL lower==upper ergab gleich"]
            - set: [fails, { +: [fails, 1] }]
      - if:
          condition: { neq: [{ call: [zeichen.lower] }, { call: [zeichen.upper] }] }
          then: []
          else:
            - print: ["FAIL neq on lower/upper gave equal"]
            - set: [fails, { +: [fails, 1] }]

      # two builtins with the SAME content, allocated separately → must be equal.
      # Exactly that gave false before (two different pointers).
      - if:
          condition: { eq: [{ call: [zeichen.lower] }, { call: [gleich.lower] }] }
          then: []
          else:
            - print: ["FAIL two lower() with the same content gave unequal"]
            - set: [fails, { +: [fails, 1] }]

      # mixed: builtin against a typed local (already worked before).
      - decl: [klein, string, { call: [zeichen.lower] }]
      - if:
          condition: { eq: [{ call: [gleich.lower] }, klein] }
          then: []
          else:
            - print: ["FAIL builtin against local gave unequal"]
            - set: [fails, { +: [fails, 1] }]

      # trim/substr als zweite Builtin-Paarung.
      - decl: [roh, string, "  abc  "]
      - if:
          condition: { eq: [{ call: [roh.trim] }, { call: [gleich.trim] }] }
          then: []
          else:
            - print: ["FAIL trim-Paarung ergab ungleich"]
            - set: [fails, { +: [fails, 1] }]

      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS test_eq_string_builtins"] }]
          else: [{ print: ["FAILED ${fails} Pruefungen"] }]
      - return: fails
