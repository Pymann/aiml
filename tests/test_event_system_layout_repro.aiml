- model:
    name: EventLite
    fields:
      - [seq, i32, 0]
      - [kind, string, ""]
      - [text, string, ""]
      - [phase, i32, 0]

- model:
    name: TriggerLite
    fields:
      - [seq, i32, 0]
      - [code, i32, 0]
      - [text, string, ""]

- class:
    name: EventLikeSystem
    members:
      - [events, list<EventLite>]
      - [event_seq, i32]
      - [event_count, i32]
      - [active_triggers, list<TriggerLite>]
      - [trigger_seq, i32]
      - [active_trigger_count, i32]
      - [react_t0, TriggerLite]
      - [react_t1, TriggerLite]
      - [react_t2, TriggerLite]
      - [react_count, i32]
    methods:
      - def:
          name: push_event_like
          args: [[kind, string], [text, string], [phase, i32]]
          return: i32
          body:
            - print: ["push_event_like start event_count=${<.event_count} event_seq=${<.event_seq}"]
            - decl: [ev, EventLite]
            - set: [ev.seq, <.event_seq]
            - set: [ev.kind, kind]
            - set: [ev.text, text]
            - set: [ev.phase, phase]
            - decl: [lst, list<EventLite>, <.events]
            - call: [lst.push, ev]
            - print: ["after lst.push len=${lst.len}"]
            - set: [<.events, lst]
            - print: ["after set events"]
            - set: [<.event_count, {+: [<.event_count, 1]}]
            - print: ["after set event_count=${<.event_count}"]
            - set: [<.event_seq, {+: [<.event_seq, 1]}]
            - print: ["after set event_seq=${<.event_seq}"]
            - return: [<.event_count]

- def:
    name: main
    return: i32
    body:
      - print: ["test_event_system_layout_repro START"]
      - decl: [es, ptr<EventLikeSystem>, {new: EventLikeSystem}]
      - decl: [evs, list<EventLite>]
      - decl: [trs, list<TriggerLite>]
      - set: [es.events, evs]
      - set: [es.active_triggers, trs]
      - set: [es.event_seq, 0]
      - set: [es.event_count, 0]
      - set: [es.trigger_seq, 0]
      - set: [es.active_trigger_count, 0]
      - set: [es.react_count, 0]
      - print: ["system initialized"]
      - decl: [rc1, i32, {call: [es.push_event_like, "phase_start", "Round start", 1]}]
      - print: ["rc1=${rc1}"]
      - decl: [rc2, i32, {call: [es.push_event_like, "phase_start", "Round start 2", 2]}]
      - print: ["rc2=${rc2}"]
      - if:
          condition: { neq: [es.event_count, 2]}
          then:
            - print: ["FAIL event_count=${es.event_count}"]
            - return: [1]
      - if:
          condition: { neq: [es.event_seq, 2]}
          then:
            - print: ["FAIL event_seq=${es.event_seq}"]
            - return: [1]
      - if:
          condition: { neq: [es.events.len, 2]}
          then:
            - print: ["FAIL events.len=${es.events.len}"]
            - return: [1]
      - if:
          condition: { neq: [es.events-0.seq, 0]}
          then:
            - print: ["FAIL seq0=${es.events-0.seq}"]
            - return: [1]
      - if:
          condition: { neq: [es.events-1.seq, 1]}
          then:
            - print: ["FAIL seq1=${es.events-1.seq}"]
            - return: [1]
      - if:
          condition: { neq: [es.events-0.phase, 1]}
          then:
            - print: ["FAIL phase0=${es.events-0.phase}"]
            - return: [1]
      - if:
          condition: { neq: [es.events-1.phase, 2]}
          then:
            - print: ["FAIL phase1=${es.events-1.phase}"]
            - return: [1]
      - print: ["test_event_system_layout_repro PASS"]
      - return: [0]
