- import: "tests/lib_extern_a.aiml"
- import: "tests/lib_extern_b.aiml"

- call: [exta.set_counter, 10]
- decl: [c0, i32, { call: [extb.get_counter] }]
- print: ["extern A->B counter=${c0}"]

- call: [extb.add_counter, 5]
- call: [exta.inc_counter]
- decl: [c1, i32, { call: [exta.get_counter] }]
- decl: [c2, i32, { call: [extb.get_counter] }]
- print: ["extern shared counter a=${c1} b=${c2}"]

- call: [exta.set_label, "alpha"]
- decl: [s0, string, { call: [extb.get_label] }]
- print: ["extern A->B label=${s0}"]

- call: [extb.append_mark, "-beta"]
- decl: [s1, string, { call: [exta.get_label] }]
- decl: [s2, string, { call: [extb.get_label] }]
- print: ["extern shared label a=${s1} b=${s2}"]

- decl: [fail, i32, 0]

- if:
    condition: { "!=": [c0, 10] }
    then:
      - print: ["FAIL extern c0=${c0}"]
      - set: [fail, 1]

- if:
    condition: { "!=": [c1, 16] }
    then:
      - print: ["FAIL extern c1=${c1}"]
      - set: [fail, 1]

- if:
    condition: { "!=": [c2, 16] }
    then:
      - print: ["FAIL extern c2=${c2}"]
      - set: [fail, 1]

- if:
    condition: { "==": [{ eq: [s0, "alpha"] }, 0] }
    then:
      - print: ["FAIL extern s0=${s0}"]
      - set: [fail, 1]

- if:
    condition: { "==": [{ eq: [s1, "alpha-beta"] }, 0] }
    then:
      - print: ["FAIL extern s1=${s1}"]
      - set: [fail, 1]

- if:
    condition: { "==": [{ eq: [s2, "alpha-beta"] }, 0] }
    then:
      - print: ["FAIL extern s2=${s2}"]
      - set: [fail, 1]

- if:
    condition: { "==": [fail, 0] }
    then:
      - print: ["EXTERN_GLOBALS_PASS"]
    else:
      - call: [sys.exit, 1]
