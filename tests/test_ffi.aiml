# SPEC?: 35_ffi   # derived from the file name, to be confirmed
# Tests for extern "C" FFI
# Expected exit code: 0

# ── Phase A: Block-Syntax — POSIX-Funktionen ──────────────────────────────────

- extern: "C"
  defs:
    - def:
        name: strlen
        args: [[var_s, string]]
        return: i64
    - def:
        name: abs
        args: [[var_n, i32]]
        return: i32
    - def:
        name: puts
        args: [[var_s, string]]
        return: i32

- decl: [msg, string, "hello ffi"]
- decl: [len, i64, { call: [strlen, msg] }]
- print: ["strlen: ${len}"]

- decl: [var_n, i32, { call: [abs, -99] }]
- print: ["abs(-99): ${var_n}"]

# ── Phase B: Inline-Syntax ────────────────────────────────────────────────────

- extern: "C"
  defs:
    - def: { name: malloc, args: [[size, i64]], return: ptr }
    - def: { name: free,   args: [[var_p, ptr]],   return: void }

- decl: [buf, ptr, { call: [malloc, 32] }]
- print: ["malloc returned non-null"]
- call: [free, buf]
- print: ["free ok"]

# ── Phase C: multiple extern blocks (must not give a duplicate error) ──────────

- extern: "C"
  defs:
    - def: { name: strlen, args: [[var_s, string]], return: i64 }

- decl: [len2, i64, { call: [strlen, "duplicate extern block"] }]
- print: ["duplicate extern block ok: ${len2}"]

# ── Phase D: ptr type + address-of (&) ────────────────────────────────────────

- extern: "C"
  defs:
    - def: { name: memset, args: [[dst, ptr], [var_c, i32], [var_n, i64]], return: ptr }

- decl: [buf2, ptr, { call: [malloc, 16] }]
- call: [memset, buf2, 0, 16]
- print: ["memset ok"]
- call: [free, buf2]

# ── Phase E: sys.load_lib / sys.load_sym ─────────────────────────────────────

- decl: [lib, ptr, { call: [sys.load_lib, ""] }]    # null → current process
- decl: [sym, ptr, { call: [sys.load_sym, lib, "strlen"] }]
- print: ["sys.load_sym returned non-null"]

# ── Phase F: f64 arguments/result — typed like any function (idx into list<f64>, arithmetic) ──

- extern: "C"
  defs:
    - def: { name: sqrt, args: [[var_x, f64]], return: f64 }
    - def: { name: hypot, args: [[var_a, f64], [var_b, f64]], return: f64 }

- decl: [roots, list<f64>]
- call: [roots.push, 0.0]
- idx: [roots, 0, { call: [sqrt, 16.0] }]
- decl: [four, f64, { at: [roots, 0] }]
- decl: [five, f64, { call: [hypot, 3.0, 4.0] }]
- decl: [want_four, f64, 4.0]
- decl: [want_five, f64, 5.0]
- if: { condition: { "||": [{ neq: [four, want_four] }, { neq: [five, want_five] }] }, then: [{ print: ["FAIL f64 extern ${four} ${five}"] }, { return: 1 }] }
- decl: [legs, list<f64>]
- call: [legs.push, 6.0]
- call: [legs.push, 8.0]
- decl: [ten, f64, { call: [hypot, { at: [legs, 0] }, { at: [legs, 1] }] }]
- decl: [want_ten, f64, 10.0]
- if: { condition: { neq: [ten, want_ten] }, then: [{ print: ["FAIL f64 extern from list ${ten}"] }, { return: 1 }] }
- print: ["f64 extern ok"]

- print: ["ffi tests passed"]
