# SPEC?: 18_refs_and_pointers   # derived from the file name, to be confirmed
# Function pointer tests
# Expected exit code: 0

# ── Helper functions ───────────────────────────────────────────────────────────

- def:
    name: add
    args: [[var_a, i32], [var_b, i32]]
    return: i32
    body:
      - return: { +: [var_a, var_b] }

- def:
    name: double
    args: [[var_n, i32]]
    return: i32
    body:
      - return: { "*": [var_n, 2] }

- def:
    name: apply
    args: [[var_f, fn<i32:i32>], [var_x, i32]]
    return: i32
    body:
      - return: { call: [var_f, var_x] }

- def:
    name: greet
    args: [[name, string]]
    return: string
    body:
      - return: "hello"

# ── Phase A: decl + set + call ────────────────────────────────────────────────

- decl: [var_fp, fn<i32, i32:i32>]
- set: [var_fp, add]
- decl: [var_r, i32, { call: [var_fp, 3, 4] }]
- if: [{ neq: [var_r, 7] }, true]
  then:
    - print: ["FAIL A: var_fp(3,4) expected 7, got ", var_r]
    - call: [sys.exit, 1]
- print: ["Phase A OK: fn<i32,i32:i32> call via var_fp = ", var_r]

# ── Phase B: reassign to different function ────────────────────────────────────

- set: [var_fp, double]   # fn<i32, i32:i32> = double — only uses first arg
- decl: [fp2, fn<i32:i32>]
- set: [fp2, double]
- decl: [var_r2, i32, { call: [fp2, 5] }]
- if: [{ neq: [var_r2, 10] }, true]
  then:
    - print: ["FAIL B: fp2(5) expected 10, got ", var_r2]
    - call: [sys.exit, 1]
- print: ["Phase B OK: fn<i32:i32> call via fp2 = ", var_r2]

# ── Phase C: fn as function parameter ─────────────────────────────────────────

- decl: [var_r3, i32, { call: [apply, double, 6] }]
- if: [{ neq: [var_r3, 12] }, true]
  then:
    - print: ["FAIL C: apply(double,6) expected 12, got ", var_r3]
    - call: [sys.exit, 1]
- print: ["Phase C OK: fn parameter = ", var_r3]

# ── Phase D: null check ────────────────────────────────────────────────────────

- decl: [var_cb, fn<>]
- decl: [called, i32, 0]
- if: [{ eq: [var_cb, 0] }, true]
  then:
    - set: [called, 1]
- if: [{ neq: [called, 1] }, true]
  then:
    - print: ["FAIL D: null fn<> should be 0"]
    - call: [sys.exit, 1]
- print: ["Phase D OK: null fn<> == 0"]

# ── Phase E: string-returning fn ──────────────────────────────────────────────

- decl: [sfp, fn<string:string>]
- set: [sfp, greet]
- decl: [msg, string, { call: [sfp, "world"] }]
- if: [{ neq: [msg, "hello"] }, true]
  then:
    - print: ["FAIL E: expected hello"]
    - call: [sys.exit, 1]
- print: ["Phase E OK: fn<string:string> = ", msg]

- print: ["All fn_ptr tests passed"]
