# SPEC?: 07_functions   # derived from the file name, to be confirmed
- def:
    name: add_two
    args: [[var_a, i32], [var_b, i32]]
    return: i32
    body:
      - return: { +: [var_a, var_b] }

- def:
    name: greet
    args: []
    return: void
    body:
      - print: ["Hello from Function!"]

- print: ["Testing Functions..."]
- decl: [res, i32, { call: [add_two, 10, 20] }]
- print: ["Result of add_two(10, 20): ${res}"]

- call: [greet]
