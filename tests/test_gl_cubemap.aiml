# spec/43_5 §5: gl_cubemap — RGBA16F faces/levels, face orientation (u, v in [-1, 1]:
# +X (1,-v,-u), -X (-1,-v,u), +Y (u,1,v), -Y (u,-1,-v), +Z (u,-v,1), -Z (-u,-v,-1)),
# explicit level sampling, input validation, early close; sys.exe_path (spec/23).
# Requires: display
# Expected exit code: 0
- text: quad_vert
  value: |
    #version 330 core
    void main() {
      vec2 pos = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
      gl_Position = vec4(pos * 2.0 - 1.0, 0.0, 1.0);
    }
- text: probe_frag
  value: |
    #version 330 core
    uniform samplerCube uCube;
    uniform float uLevel;
    out vec4 fragColor;
    vec3 face_dir(int face, float u, float v) {
      if (face == 0) return vec3(1.0, -v, -u);
      if (face == 1) return vec3(-1.0, -v, u);
      if (face == 2) return vec3(u, 1.0, v);
      if (face == 3) return vec3(u, -1.0, -v);
      if (face == 4) return vec3(u, -v, 1.0);
      return vec3(-u, -v, -1.0);
    }
    void main() {
      int slot = int(gl_FragCoord.x);
      int face = slot / 4;
      int texel = slot - face * 4;
      float u = (float(texel % 2) + 0.5) - 1.0;
      float v = (float(texel / 2) + 0.5) - 1.0;
      fragColor = vec4(textureLod(uCube, face_dir(face, u, v), uLevel).rgb, 1.0);
    }
- class:
    name: CubeProbe
    members: [[fails, i32]]
    methods:
      # Face `face`, level 0 (2x2): texel t gets red = (face * 4 + t + 1) / 32.
      - def:
          name: face_pixels
          access: public
          args: [[face, i32]]
          return: buffer<f32>
          body:
            - decl: [pixels, buffer<f32>]
            - call: [pixels.alloc, 64]
            - decl: [texel, i32, 0]
            - decl: [scale, f64, 32.0]
            - while:
                condition: { lt: [texel, 4] }
                body:
                  - decl: [ident, f64, { cast: [{ +: [{ +: [{ "*": [face, 4] }, texel] }, 1] }, f64] }]
                  - call: [pixels.write, { cast: [{ /: [ident, scale] }, f32] }, f32]
                  - call: [pixels.write, 0.0, f32]
                  - call: [pixels.write, 0.0, f32]
                  - call: [pixels.write, 1.0, f32]
                  - set: [texel, { +: [texel, 1] }]
            - return: pixels

      - def:
          name: flat
          access: public
          args: [[count, i32], [green, f32]]
          return: buffer<f32>
          body:
            - decl: [pixels, buffer<f32>]
            - call: [pixels.alloc, { "*": [count, 16] }]
            - decl: [texel, i32, 0]
            - while:
                condition: { lt: [texel, count] }
                body:
                  - call: [pixels.write, 0.0, f32]
                  - call: [pixels.write, green, f32]
                  - call: [pixels.write, 0.0, f32]
                  - call: [pixels.write, 1.0, f32]
                  - set: [texel, { +: [texel, 1] }]
            - return: pixels

      - def:
          name: run
          access: public
          body:
            - decl: [cube, gl_cubemap, { call: [gl.create_cubemap, 2, 2] }]
            - if: { condition: { eq: [cube, null] }, then: [{ print: ["FAIL create"] }, { set: [<.fails, 1] }, { return: }] }
            - decl: [face, i32, 0]
            - while:
                condition: { lt: [face, 6] }
                body:
                  - decl: [ok0, i32, { call: [cube.upload_face, face, 0, { call: [<.face_pixels, face] }] }]
                  - decl: [ok1, i32, { call: [cube.upload_face, face, 1, { call: [<.flat, 1, 0.5] }] }]
                  - if: { condition: { "||": [{ neq: [ok0, 1] }, { neq: [ok1, 1] }] }, then: [{ print: ["FAIL upload face ${face}"] }, { set: [<.fails, { +: [<.fails, 1] }] }] }
                  - set: [face, { +: [face, 1] }]
            - decl: [bad_face, i32, { call: [cube.upload_face, 6, 0, { call: [<.flat, 4, 0.0] }] }]
            - decl: [bad_level, i32, { call: [cube.upload_face, 0, 2, { call: [<.flat, 1, 0.0] }] }]
            - decl: [bad_size, i32, { call: [cube.upload_face, 0, 0, { call: [<.flat, 3, 0.0] }] }]
            - if: { condition: { "||": [{ neq: [bad_face, 0] }, { "||": [{ neq: [bad_level, 0] }, { neq: [bad_size, 0] }] }] }, then: [{ print: ["FAIL validation ${bad_face} ${bad_level} ${bad_size}"] }, { set: [<.fails, { +: [<.fails, 1] }] }] }
            - decl: [too_many, gl_cubemap, { call: [gl.create_cubemap, 4, 4] }]
            - if: { condition: { neq: [too_many, null] }, then: [{ print: ["FAIL levels accepted"] }, { set: [<.fails, { +: [<.fails, 1] }] }] }

            - decl: [target, gl_framebuffer, { call: [gl.create_framebuffer_format, 24, 1, gl.RGBA8, false] }]
            - decl: [vao, gl_vao, { call: [gl.create_vao] }]
            - decl: [shader, gl_shader, { call: [gl.compile_shader, quad_vert, probe_frag] }]
            - call: [gl.bind_framebuffer, target]
            - call: [shader.use]
            - call: [gl.bind_cubemap, cube, 0]
            - call: [shader.uniform_i32, "uCube", 0]
            - call: [shader.uniform_f32, "uLevel", 0.0]
            - call: [gl.draw_arrays, vao, 3]
            - decl: [faces, buffer<u8>, { call: [gl.read_rgba8, 0, 0, 24, 1] }]
            - call: [shader.uniform_f32, "uLevel", 1.0]
            - call: [gl.draw_arrays, vao, 3]
            - decl: [coarse, buffer<u8>, { call: [gl.read_rgba8, 0, 0, 24, 1] }]
            - call: [gl.bind_default_framebuffer]
            - decl: [slot, i32, 0]
            - while:
                condition: { lt: [slot, 24] }
                body:
                  - decl: [red, i32, { cast: [{ call: [faces.get, { "*": [slot, 4] }] }, i32] }]
                  - decl: [want, i32, { /: [{ "*": [{ +: [slot, 1] }, 255] }, 32] }]
                  - if: { condition: { "||": [{ lt: [red, { -: [want, 2] }] }, { gt: [red, { +: [want, 2] }] }] }, then: [{ print: ["FAIL orientation slot ${slot}: red ${red} want ${want}"] }, { set: [<.fails, { +: [<.fails, 1] }] }] }
                  - decl: [green, i32, { cast: [{ call: [coarse.get, { +: [{ "*": [slot, 4] }, 1] }] }, i32] }]
                  - if: { condition: { "||": [{ lt: [green, 126] }, { gt: [green, 129] }] }, then: [{ print: ["FAIL level 1 slot ${slot}: green ${green}"] }, { set: [<.fails, { +: [<.fails, 1] }] }] }
                  - set: [slot, { +: [slot, 1] }]
            - call: [cube.delete]
            - call: [target.delete]
            - call: [shader.delete]
            - call: [vao.delete]

- def:
    name: main
    return: i32
    body:
      - decl: [exe, string, { call: [sys.exe_path] }]
      - if: { condition: { eq: [{ call: [exe.starts_with, "/"] }, 0] }, then: [{ print: ["FAIL exe_path '${exe}'"] }, { return: 1 }] }
      - decl: [win, window_handle, { call: [engine.create_window, 64, 64, "cubemap"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL window"] }, { return: 1 }] }
      - decl: [probe, ptr<CubeProbe>, { new: CubeProbe }]
      - call: [probe.run]
      - decl: [fails, i32, probe.fails]
      - free: probe
      - call: [engine.destroy_window, win]
      - if: { condition: { gt: [fails, 0] }, then: [{ return: 1 }] }
      - print: ["PASS gl_cubemap"]
      - return: 0
