# OpenGL window test: white cube, visible for 3 seconds, then exit.
# Requires an active display (X11 or Wayland).
# Run: ./out/aiml -r tests/test_gl_window.aiml
# Expected exit code: 0
# Requires: display

# ── GLFW window management via FFI ────────────────────────────────────────────
- extern: "C"
  defs:
    - def: { name: glfwInit,              args: [],                                                                    return: i32 }
    - def: { name: glfwWindowHint,        args: [[hint, i32], [value, i32]],                                          return: void }
    - def: { name: glfwCreateWindow,      args: [[var_w, i32], [var_h, i32], [title, string], [mon, ptr], [var_sh, ptr]],         return: ptr }
    - def: { name: glfwMakeContextCurrent, args: [[win, ptr]],                                                        return: void }
    - def: { name: glfwSwapBuffers,       args: [[win, ptr]],                                                         return: void }
    - def: { name: glfwPollEvents,        args: [],                                                                    return: void }
    - def: { name: glfwWindowShouldClose, args: [[win, ptr]],                                                         return: i32 }
    - def: { name: glfwTerminate,         args: [],                                                                    return: void }

# ── Phase A: initialise GLFW and open a window ───────────────────────────────

- decl: [var_ok, i32, { call: [glfwInit] }]
- if: [{ eq: [var_ok, 0] }, true]
  then:
    - print: ["FAIL: glfwInit failed"]
    - call: [sys.exit, 1]

# OpenGL 3.3 Core Profile
- call: [glfwWindowHint, 139266, 3]   # GLFW_CONTEXT_VERSION_MAJOR = 3
- call: [glfwWindowHint, 139267, 3]   # GLFW_CONTEXT_VERSION_MINOR = 3
- call: [glfwWindowHint, 139272, 204801]  # GLFW_OPENGL_PROFILE = GLFW_OPENGL_CORE_PROFILE

- decl: [win, ptr, { call: [glfwCreateWindow, 800, 600, "AIML — white cube", null, null] }]

- if: [{ eq: [win, null] }, true]
  then:
    - print: ["FAIL: glfwCreateWindow failed"]
    - call: [glfwTerminate]
    - call: [sys.exit, 1]

- call: [glfwMakeContextCurrent, win]

# ── Phase B: initialise OpenGL ────────────────────────────────────────────

- call: [gl.init]
- call: [gl.enable_depth_test]
- call: [gl.viewport, 0, 0, 800, 600]

- print: ["Phase A+B OK: window and GL context created"]

# ── Phase C: cube geometry ────────────────────────────────────────────────────
#
# 8 corners of a unit cube (−0.5 … +0.5 in X/Y/Z), vertex layout: x y z
#
#   7──────6
#  /|     /|
# 4──────5 |
# | 3────|─2
# |/     |/
# 0──────1

- decl: [verts, buffer<f32>, [
    -0.5, -0.5,  0.5,
     0.5, -0.5,  0.5,
     0.5,  0.5,  0.5,
    -0.5,  0.5,  0.5,
    -0.5, -0.5, -0.5,
     0.5, -0.5, -0.5,
     0.5,  0.5, -0.5,
    -0.5,  0.5, -0.5]]

# 2 triangles per face, 6 faces = 36 indices
- decl: [idxs, buffer<u32>, [
    0, 1, 2,  0, 2, 3,
    5, 4, 7,  5, 7, 6,
    4, 0, 3,  4, 3, 7,
    1, 5, 6,  1, 6, 2,
    3, 2, 6,  3, 6, 7,
    4, 5, 1,  4, 1, 0]]

- decl: [vbo, gl_buffer, { call: [gl.create_buffer, verts] }]
- decl: [ibo, gl_buffer, { call: [gl.create_index_buffer, idxs] }]
- decl: [vao, gl_vao,    { call: [gl.create_vao] }]
- call: [vao.bind_vbo, vbo]
- call: [vao.bind_ibo, ibo]
- call: [vao.attrib, 0, 3, 12, 0]   # attrib 0: 3 floats, stride 12, offset 0

# edge IBO: 12 real cube edges (no diagonals), 24 indices for GL_LINES
- decl: [edge_idxs, buffer<u32>, [
    0, 1,  1, 2,  2, 3,  3, 0,
    4, 5,  5, 6,  6, 7,  7, 4,
    0, 4,  1, 5,  2, 6,  3, 7]]

- decl: [edge_ibo, gl_buffer, { call: [gl.create_index_buffer, edge_idxs] }]
- decl: [edge_vao, gl_vao,    { call: [gl.create_vao] }]
- call: [edge_vao.bind_vbo, vbo]
- call: [edge_vao.bind_ibo, edge_ibo]
- call: [edge_vao.attrib, 0, 3, 12, 0]

- print: ["Phase C OK: cube geometry uploaded"]

# ── Phase D: compile shaders ───────────────────────────────────────────────

- text: vert_src
  value: |
    #version 330 core
    layout(location=0) in vec3 pos;
    uniform mat4 mvp;
    void main(){
      gl_Position = mvp * vec4(pos, 1.0);
    }

- text: frag_white
  value: |
    #version 330 core
    out vec4 color;
    void main(){
      color = vec4(1.0, 1.0, 1.0, 1.0);
    }

- text: frag_red
  value: |
    #version 330 core
    out vec4 color;
    void main(){
      color = vec4(1.0, 0.0, 0.0, 1.0);
    }

- decl: [sh_white, gl_shader, { call: [gl.compile_shader, vert_src, frag_white] }]
- decl: [sh_red,   gl_shader, { call: [gl.compile_shader, vert_src, frag_red] }]

- print: ["Phase D OK: shaders compiled"]

# ── Phase E: rotation render loop (~10 s, 300 frames at 33 ms) ───────────────
# Two-pass: 1) white faces (fill + polygon offset), 2) red edges (GL_LINES)

- decl: [proj,   mat4, { call: [math.mat4_perspective, 0.785, 1.333, 0.1, 100.0] }]
- decl: [eye,    vec3, { call: [math.vec3, 2.0, 1.5, 3.0] }]
- decl: [center, vec3, { call: [math.vec3, 0.0, 0.0, 0.0] }]
- decl: [var_up,     vec3, { call: [math.vec3, 0.0, 1.0, 0.0] }]
- decl: [view,   mat4, { call: [math.mat4_lookat, eye, center, var_up] }]
- decl: [model,  mat4]
- decl: [mvp,    mat4]
- decl: [angle,  f32, 0.0]
- decl: [frame,  i32, 0]

- while:
    condition: { lt: [frame, 300] }
    body:
      - set: [model, { call: [math.mat4_rotate_y, angle] }]
      - set: [mvp, { "*": [proj, view] }]
      - set: [mvp, { "*": [mvp, model] }]
      - call: [gl.clear_all, 0.05, 0.05, 0.1, 1.0]
      # pass 1: white faces, pushed back slightly
      - call: [gl.polygon_offset, 1.0, 1.0]
      - call: [gl.enable_polygon_offset_fill]
      - call: [sh_white.use]
      - call: [sh_white.uniform_mat4, "mvp", mvp]
      - call: [gl.draw_elements, vao, 36]
      - call: [gl.disable_polygon_offset_fill]
      # pass 2: red edges via GL_LINES (no diagonals)
      - call: [sh_red.use]
      - call: [sh_red.uniform_mat4, "mvp", mvp]
      - call: [gl.draw_lines, edge_vao, 24]
      - call: [glfwSwapBuffers, win]
      - call: [glfwPollEvents]
      - call: [time.sleep_ms, 33]
      - set: [angle, { +: [angle, 0.02] }]
      - set: [frame, { +: [frame, 1] }]

- print: ["Phase E OK: Rotation gerendert"]

# ── Clean-up ──────────────────────────────────────────────────────────────────

- call: [edge_vao.free]
- call: [edge_ibo.free]
- call: [vao.free]
- call: [vbo.free]
- call: [ibo.free]
- call: [sh_white.free]
- call: [sh_red.free]
- call: [glfwTerminate]

- print: ["All gl_window tests passed"]
