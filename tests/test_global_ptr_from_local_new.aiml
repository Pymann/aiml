# SPEC: 61_memory_management
# A pointer created locally with `new` is hung into a GLOBAL, then
# the function ends.
#
# spec/61: `new` creates a heap allocation with an owner.  If the
# function hangs it into a global and ends, the ownership must MOVE ALONG — otherwise
# discarding the local frees the memory and the global points to
# freed heap.  The next read access is then a grab into nothing.
#
# Occasion: the cosmos WASM client crashed with "memory access out of
# bounds" as soon as a live push had arrived.  The push handler has
# exactly this form (`decl fresh = new ClusterView` ... `set g_live = fresh`).
# Natively this silently falls through, because freed memory is usually still mapped;
# WASM checks the bounds and aborts.
#
# The NESTED case is checked (a model with list<Model> and strings),
# because only that owns inner heap — a flat model would not show the
# error.
# Expected exit code: 0

- model:
    name: Inner
    fields:
      - [name,   string]
      - [status, string]
      - [count,  i32]

- model:
    name: Outer
    fields:
      - [tag,    string]
      - [items,  list<Inner>]

- decl: [g_view, ptr<Outer>, null]
- decl: [g_seq,  i32,        0]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ call: [log.info, "  ok   ${what}"] }, { return: 0 }]
      - call: [log.info, "  FAIL ${what}"]
      - return: 1

# Exactly the form of the push handler: allocate fresh, fill, hang it into the global,
# return.
- def:
    name: apply_push
    static_off: ["str_cmp"]
    args: [[rounds, i32]]
    return: i32
    body:
      - decl: [fresh, ptr<Outer>, { new: Outer }]
      - set: [fresh.tag, "schnappschuss-${rounds}"]
      - decl: [fix_ix, i32, 0]
      - while:
          condition: { lt: [fix_ix, rounds] }
          body:
            - decl: [row, Inner]
            - set: [row.name,   "eintrag-${fix_ix}"]
            - set: [row.status, "pending"]
            - set: [row.count,  fix_ix]
            - call: [fresh.items.push, row]
            - set: [fix_ix, { +: [fix_ix, 1] }]
      - set: [g_view, fresh]
      - set: [g_seq, { +: [g_seq, 1] }]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # first push: exactly the case that crashed in the client.
      - call: [apply_push, 5]
      - set: [fails, { +: [fails, { call: [expect, "global set", { pneq: [g_view, null] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "5 entries survived", { eq: [g_view.items.len, 5] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "string survives", { eq: [g_view.tag, "schnappschuss-5"] }] }] }]

      # read the nested elements — this is where a dangling
      # global grabs into nothing.
      - decl: [sum, i32, 0]
      - decl: [row_ix, i32, 0]
      - while:
          condition: { lt: [row_ix, g_view.items.len] }
          body:
            - decl: [cur, Inner, { at: [g_view.items, row_ix] }]
            - set: [sum, { +: [sum, cur.count] }]
            - set: [fails, { +: [fails, { call: [expect, "element ${row_ix} readable", { eq: [cur.status, "pending"] }] }] }]
            - set: [row_ix, { +: [row_ix, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "sum 0+1+2+3+4", { eq: [sum, 10] }] }] }]

      # several pushes in a row: each replaces the global.  The old
      # snapshot must be freed, the new one must stay readable.
      - decl: [round, i32, 2]
      - while:
          condition: { lt: [round, 9] }
          body:
            - call: [apply_push, round]
            - set: [fails, { +: [fails, { call: [expect, "round ${round} readable", { eq: [g_view.items.len, round] }] }] }]
            - decl: [last, Inner, { at: [g_view.items, { -: [round, 1] }] }]
            - set: [fails, { +: [fails, { call: [expect, "round ${round} last element", { eq: [last.count, { -: [round, 1] }] }] }] }]
            - set: [round, { +: [round, 1] }]

      - set: [fails, { +: [fails, { call: [expect, "7 updates counted", { eq: [g_seq, 8] }] }] }]

      - if:
          condition: { eq: [fails, 0] }
          then: [{ call: [log.info, "test_global_ptr_from_local_new PASS"] }, { return: 0 }]
      - call: [log.info, "test_global_ptr_from_local_new FAIL (${fails})"]
      - return: 1
