# SPEC: 21_namespaces §6.2, 44_1_engine §4.1
# `singleton: true`: the declared anchor of a callback.
#
# `engine.run` takes FREE functions — a callback carries no state, so
# every window program needs an anchor at module level.  The marker
# takes the globals warning away from it and buys a CHECK in exchange
# (F21-S2, negative probe: tests/test_global_singleton_move_neg.aiml).
#
# Here it is checked that the anchor stays normally usable: set, read,
# call methods.  A marker that silently means something other than
# "no warning" would be worse than the warning.
#
# Expected exit code: 0

- class:
    name: Anchor
    members:
      - [ticks, i32]
    methods:
      - def:
          name: bump
          access: public
          body: [{ set: [<.ticks, { +: [<.ticks, 1] }] }]
      - def:
          name: count
          access: public
          return: i32
          body: [{ return: <.ticks }]

- decl: [g_anchor, ptr<Anchor>, null, { singleton: true }]

- def:
    name: tick_once
    body:
      - if: { condition: { peq: [g_anchor, null] }, then: [{ return: [] }] }
      - call: [g_anchor.bump]

- def:
    name: main
    return: i32
    body:
      - set: [g_anchor, { new: Anchor }]
      - call: [tick_once]
      - call: [tick_once]
      - decl: [seen, i32, { call: [g_anchor.count] }]
      - if:
          condition: { neq: [seen, 2] }
          then: [{ print: ["FAIL singleton counts ${seen} instead of 2"] }, { return: 1 }]
      - free: [g_anchor]
      - print: ["global singleton PASS"]
      - return: 0
