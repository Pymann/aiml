# SPEC: 21_namespaces §6.2 F21-S2
# Negative: a `singleton` global must NOT go to a `ptr<T>` parameter.
#
# Exactly this move made the cosmos WASM client crash twice: the
# parameter owns, its drop frees, and the global points into nothing.  Whoever
# switches the warning off with `singleton: true` accepts this check in
# exchange — otherwise the marker would only be a mute button.
#
# Expected exit code: 1
# ExpectedStderr: singleton

- class:
    name: Anchor
    members:
      - [ticks, i32]

- decl: [g_anchor, ptr<Anchor>, null, { singleton: true }]

- def:
    name: takes_owner
    args: [[owned, ptr<Anchor>]]
    body: [{ set: [owned.ticks, 1] }]

- def:
    name: main
    return: i32
    body:
      - set: [g_anchor, { new: Anchor }]
      - call: [takes_owner, g_anchor]
      - return: 0
