# SPEC?: 43_1_gltf   # derived from the file name, to be confirmed
# Tests for the gltf namespace: load, scene, node, mesh, primitive, material
# Expected exit code: 0

# ── Phase A: Fehlerbehandlung ──────────────────────────────────────────────

- decl: [bad, gltf_scene, { call: [gltf.load, "/nonexistent_file.glb"] }]
- decl: [bad_ok, i32, { call: [bad.valid] }]
- print: ["Phase A: bad.valid=${bad_ok}"]
- if: [{ eq: [bad_ok, 1] }, true]
  then:
    - print: ["FAIL: expected valid=0 for nonexistent file"]
    - call: [sys.exit, 1]

- decl: [bad_err, string, { call: [bad.error] }]
- print: ["bad.error=${bad_err}"]
- call: [bad.free]

- print: ["Phase A OK"]

# ── Phase B: loading a minimal .glb file ──────────────────────────────────

- decl: [var_p, path, "tests/test.glb"]
- decl: [scene, gltf_scene, { call: [gltf.load, var_p] }]
- decl: [var_ok, i32, { call: [scene.valid] }]
- print: ["Phase B: scene.valid=${var_ok}"]
- if: [{ eq: [var_ok, 0] }, true]
  then:
    - decl: [err, string, { call: [scene.error] }]
    - print: ["FAIL: load error: ${err}"]
    - call: [sys.exit, 1]

- print: ["Phase B OK: scene loaded"]

# ── Phase C: Scene-Listen ─────────────────────────────────────────────────

- decl: [nodes, list<gltf_node>, { call: [scene.nodes] }]
- decl: [var_nc, i32, { call: [nodes.len] }]
- print: ["Phase C: nodes.len=${var_nc}"]
- if: [{ <: [var_nc, 1] }, true]
  then:
    - print: ["FAIL: expected >= 1 node"]
    - call: [sys.exit, 1]

- decl: [meshes, list<gltf_mesh>, { call: [scene.meshes] }]
- decl: [var_mc, i32, { call: [meshes.len] }]
- print: ["Phase C: meshes.len=${var_mc}"]
- if: [{ <: [var_mc, 1] }, true]
  then:
    - print: ["FAIL: expected >= 1 mesh"]
    - call: [sys.exit, 1]

- decl: [mats, list<gltf_material>, { call: [scene.materials] }]
- decl: [matc, i32, { call: [mats.len] }]
- print: ["Phase C: materials.len=${matc}"]
- if: [{ <: [matc, 1] }, true]
  then:
    - print: ["FAIL: expected >= 1 material"]
    - call: [sys.exit, 1]

- print: ["Phase C OK"]

# ── Phase D: Node-Eigenschaften ────────────────────────────────────────────

- decl: [node, gltf_node]
- set: [node, { call: [nodes.get, 0] }]
- decl: [node_name, string, { call: [node.name] }]
- print: ["Phase D: node.name=${node_name}"]

- decl: [var_tx, f32, { call: [node.translation_x] }]
- decl: [var_ty, f32, { call: [node.translation_y] }]
- decl: [var_tz, f32, { call: [node.translation_z] }]
- print: ["Phase D: translation=(${var_tx},${var_ty},${var_tz})"]

- decl: [var_rw, f32, { call: [node.rotation_w] }]
- print: ["Phase D: rotation_w=${var_rw}"]

- decl: [var_sx, f32, { call: [node.scale_x] }]
- decl: [var_sy, f32, { call: [node.scale_y] }]
- decl: [var_sz, f32, { call: [node.scale_z] }]
- print: ["Phase D: scale=(${var_sx},${var_sy},${var_sz})"]

- print: ["Phase D OK"]

# ── Phase E: Mesh + Primitive ──────────────────────────────────────────────

- decl: [mesh, gltf_mesh]
- set: [mesh, { call: [meshes.get, 0] }]
- decl: [mesh_name, string, { call: [mesh.name] }]
- print: ["Phase E: mesh.name=${mesh_name}"]

- decl: [var_pc, i32, { call: [mesh.primitive_count] }]
- print: ["Phase E: primitive_count=${var_pc}"]
- if: [{ <: [var_pc, 1] }, true]
  then:
    - print: ["FAIL: expected >= 1 primitive"]
    - call: [sys.exit, 1]

- decl: [prim, gltf_primitive, { call: [mesh.primitive, 0] }]

- decl: [var_vc, i32, { call: [prim.vertex_count] }]
- decl: [var_ic, i32, { call: [prim.index_count] }]
- print: ["Phase E: vertex_count=${var_vc}, index_count=${var_ic}"]
- if: [{ eq: [var_vc, 0] }, true]
  then:
    - print: ["FAIL: expected > 0 vertices"]
    - call: [sys.exit, 1]
- if: [{ eq: [var_ic, 0] }, true]
  then:
    - print: ["FAIL: expected > 0 indices"]
    - call: [sys.exit, 1]

- print: ["Phase E OK"]

# ── Phase F: Vertex-Buffer ─────────────────────────────────────────────────

- decl: [positions, buffer<f32>, { call: [prim.positions] }]
- decl: [pos_bytes, i32, { call: [positions.len] }]
- print: ["Phase F: positions.len=${pos_bytes}"]
- if: [{ <: [pos_bytes, 1] }, true]
  then:
    - print: ["FAIL: expected positions bytes > 0"]
    - call: [sys.exit, 1]

- decl: [indices, buffer<u32>, { call: [prim.indices] }]
- decl: [idx_bytes, i32, { call: [indices.len] }]
- print: ["Phase F: indices.len=${idx_bytes}"]
- if: [{ <: [idx_bytes, 1] }, true]
  then:
    - print: ["FAIL: expected indices bytes > 0"]
    - call: [sys.exit, 1]

# read the first position value (x of the first position)
- decl: [var_x0, f32, { call: [positions.get, 0] }]
- print: ["Phase F: positions[0]=${var_x0}"]

# Ersten Index lesen
- decl: [var_i0, u32, { call: [indices.get, 0] }]
- print: ["Phase F: indices[0]=${var_i0}"]

- print: ["Phase F OK"]

# ── Phase G: Material ──────────────────────────────────────────────────────

- decl: [mat, gltf_material, { call: [prim.material] }]
- decl: [mat_name, string, { call: [mat.name] }]
- print: ["Phase G: mat.name=${mat_name}"]

- decl: [var_r, f32, { call: [mat.base_color_r] }]
- decl: [var_g, f32, { call: [mat.base_color_g] }]
- decl: [var_b, f32, { call: [mat.base_color_b] }]
- decl: [var_a, f32, { call: [mat.base_color_a] }]
- print: ["Phase G: base_color=(${var_r},${var_g},${var_b},${var_a})"]

- decl: [met, f32, { call: [mat.metallic] }]
- decl: [rough, f32, { call: [mat.roughness] }]
- print: ["Phase G: metallic=${met}, roughness=${rough}"]

- decl: [alpha, string, { call: [mat.alpha_mode] }]
- decl: [var_ds, i32, { call: [mat.double_sided] }]
- print: ["Phase G: alpha_mode=${alpha}, double_sided=${var_ds}"]

- print: ["Phase G OK"]

# ── Freigabe ───────────────────────────────────────────────────────────────

- call: [scene.free]
- print: ["All gltf tests passed"]
