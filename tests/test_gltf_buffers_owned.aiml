# SPEC: 43_1_gltf,61_memory_management
# spec/43_1 + spec/61 §5: glTF accessor buffers (positions, normals, indices, world_matrix) and
# node/mesh lists are owned containers — read in a helper, dropped at scope end, repeatedly.
# Expected exit code: 0
- class:
    name: GltfProbe
    members: [[calls, i32]]
    methods:
      - def:
          name: floats_of
          access: public
          args: [[node, gltf_node]]
          return: i32
          body:
            - decl: [total, i32, 0]
            - decl: [matrix, buffer<f32>, { call: [node.world_matrix] }]
            - set: [total, { +: [total, matrix.len] }]
            - decl: [mesh, gltf_mesh, { call: [node.mesh] }]
            - if:
                condition: { neq: [mesh, null] }
                then:
                  - decl: [prim, gltf_primitive, { call: [mesh.primitive, 0] }]
                  - decl: [positions, buffer<f32>, { call: [prim.positions] }]
                  - decl: [normals, buffer<f32>, { call: [prim.normals] }]
                  - decl: [indices, buffer<u32>, { call: [prim.indices] }]
                  - call: [positions.seek, 4]
                  - decl: [second, f32, { call: [positions.read, f32] }]
                  - set: [total, { +: [total, { +: [positions.len, { +: [normals.len, indices.len] }] }] }]
            - decl: [kids, list<gltf_node>, { call: [node.children] }]
            - decl: [cur, i32, 0]
            - while:
                condition: { lt: [cur, kids.len] }
                body:
                  - set: [total, { +: [total, { call: [<.floats_of, { call: [kids.get, cur] }] }] }]
                  - set: [cur, { +: [cur, 1] }]
            - return: total

      - def:
          name: bytes_in
          access: public
          args: [[file, string]]
          return: i32
          body:
            - decl: [file_path, path, file]
            - decl: [scene, gltf_scene, { call: [gltf.load, file_path] }]
            - if: { condition: { eq: [{ call: [scene.valid] }, 0] }, then: [{ return: -1 }] }
            - decl: [total, i32, 0]
            - decl: [roots, list<gltf_node>, { call: [scene.nodes] }]
            - decl: [meshes, list<gltf_mesh>, { call: [scene.meshes] }]
            - set: [total, { +: [total, meshes.len] }]
            - decl: [cur, i32, 0]
            - while:
                condition: { lt: [cur, roots.len] }
                body:
                  - set: [total, { +: [total, { call: [<.floats_of, { call: [roots.get, cur] }] }] }]
                  - set: [cur, { +: [cur, 1] }]
            - call: [scene.free]
            - set: [<.calls, { +: [<.calls, 1] }]
            - return: total
- def:
    name: main
    return: i32
    body:
      - decl: [probe, ptr<GltfProbe>, { new: GltfProbe }]
      - decl: [first, i32, { call: [probe.bytes_in, "tests/cube_textured.glb"] }]
      - if: { condition: { le: [first, 64] }, then: [{ print: ["FAIL bytes ${first}"] }, { return: 1 }] }
      - decl: [round, i32, 0]
      - while:
          condition: { lt: [round, 20] }
          body:
            - decl: [again, i32, { call: [probe.bytes_in, "tests/cube_textured.glb"] }]
            - if: { condition: { neq: [again, first] }, then: [{ print: ["FAIL round ${round}: ${again} != ${first}"] }, { return: 1 }] }
            - set: [round, { +: [round, 1] }]
      - print: ["PASS gltf_buffers_owned ${first}"]
      - return: 0
