# GLTF render test: texturierten Würfel aus cube_textured.glb laden und anzeigen.
#
# Testet die vollständige Pipeline von einer .glb-Datei bis zum fertigen Render:
#   gltf.load → Mesh/Primitive → Geometrie-Buffer + Material/Textur/Pixel
#   → GPU-Upload (VBO/IBO/VAO/Textur) → Shader-Kompilierung → Render-Loop
#
# Erfordert einen aktiven Display (X11 oder Wayland).
# Ausführen: ./out/aiml -r tests/test_gltf_render.aiml
# Expected exit code: 0
# Requires: display

# ── GLFW-Funktionen via FFI deklarieren ───────────────────────────────────────
#
# GLFW wird über das C-FFI direkt eingebunden (kein AIML-Wrapper).
# Die Funktionen werden hier mit ihren genauen C-Signaturen deklariert,
# damit der JIT-Compiler die Calls korrekt typprüfen und emittieren kann.
# 'ptr' entspricht void* / GLFWwindow* / GLFWmonitor*.
- extern: "C"
  defs:
    - def: { name: glfwInit,               args: [],                                                             return: i32 }
    - def: { name: glfwWindowHint,         args: [[hint, i32], [value, i32]],                                    return: void }
    - def: { name: glfwCreateWindow,       args: [[var_w, i32], [var_h, i32], [title, string], [mon, ptr], [var_sh, ptr]],   return: ptr }
    - def: { name: glfwMakeContextCurrent, args: [[win, ptr]],                                                   return: void }
    - def: { name: glfwSwapBuffers,        args: [[win, ptr]],                                                   return: void }
    - def: { name: glfwPollEvents,         args: [],                                                             return: void }
    - def: { name: glfwTerminate,          args: [],                                                             return: void }

# ── Phase A: GLB laden und Geometrie + Textur extrahieren ─────────────────────
#
# cgltf parst die .glb-Datei im Binary-Format (JSON-Chunk + BIN-Chunk).
# Wir greifen auf das erste Mesh → erste Primitive zu und holen:
#   positions : xyz-Koordinaten als buffer<f32> (Attribut 0, 3 Floats pro Vertex)
#   uvs       : Texturkoordinaten als buffer<f32> (Attribut 1, 2 Floats pro Vertex, UV-Set 0)
#   indices   : Dreiecks-Indizes als buffer<u32>
# Parallel dazu extrahieren wir die PBR-Basistextur:
#   material → base_color_texture → gltf_image → RGBA-Pixel-Buffer

- decl: [var_p, path, "tests/cube_textured.glb"]
- decl: [scene, gltf_scene, { call: [gltf.load, var_p] }]
# scene.valid() gibt 0 zurück wenn cgltf_parse oder cgltf_load_buffers fehlschlug
- decl: [var_ok, i32, { call: [scene.valid] }]
- if: [{ eq: [var_ok, 0] }, true]
  then:
    - print: ["FAIL: gltf.load failed"]
    - call: [sys.exit, 1]

# scene.meshes() befüllt eine list<gltf_mesh> über das interne GLTF_LIST-Makro
- decl: [meshes, list<gltf_mesh>]
- set:  [meshes, { call: [scene.meshes] }]
- decl: [var_mc, i32, { call: [meshes.len] }]
- if: [{ <: [var_mc, 1] }, true]
  then:
    - print: ["FAIL: no meshes in scene"]
    - call: [sys.exit, 1]

# Erstes Mesh → erste Primitive (cube_textured.glb hat genau ein Mesh mit einer Primitive)
- decl: [mesh, gltf_mesh, { call: [meshes.get, 0] }]
- decl: [prim, gltf_primitive, { call: [mesh.primitive, 0] }]

# Geometrie-Buffer aus der Primitive holen.
# prim.uvs(0) = UV-Set 0 (TEXCOORD_0 im glTF-Schema).4
# Alle Buffer nutzen das GLTF_BUFM-Makro: C gibt AimlGltfBuffer* zurück,
# der Handler kopiert das Struct per memcpy auf den Stack (buffer<T>).
- decl: [positions, buffer<f32>, { call: [prim.positions] }]
- decl: [uvs,       buffer<f32>, { call: [prim.uvs, 0] }]
- decl: [indices,   buffer<u32>, { call: [prim.indices] }]
- decl: [icnt,      i32,         { call: [prim.index_count] }]

- print: ["Phase A: index_count=", icnt]

# PBR-Textur-Pipeline: material → base_color_texture → image → Pixel-Daten.
# Jeder Schritt kann null zurückgeben (fehlende Textur ist valides glTF).
- decl: [mat, gltf_material, { call: [prim.material] }]
- if: [{ eq: [mat, null] }, true]
  then:
    - print: ["FAIL: no material on primitive"]
    - call: [sys.exit, 1]

# base_color_texture entspricht dem 'baseColorTexture' im PBR-MetallicRoughness-Block
- decl: [tex, gltf_texture, { call: [mat.base_color_texture] }]
- if: [{ eq: [tex, null] }, true]
  then:
    - print: ["FAIL: no base_color_texture on material"]
    - call: [sys.exit, 1]

# tex.image() gibt das erste gltf_image zurück, das dieser Textur zugeordnet ist
- decl: [img, gltf_image, { call: [tex.image] }]
- if: [{ eq: [img, null] }, true]
  then:
    - print: ["FAIL: gltf_texture.image() returned null"]
    - call: [sys.exit, 1]

- decl: [var_tw, i32, { call: [img.width] }]
- decl: [var_th, i32, { call: [img.height] }]
- print: ["Phase A OK: texture ", var_tw, "x", var_th, ", indices=", icnt]

# ── Phase B: GLFW-Fenster + GL-Kontext ───────────────────────────────────────
#
# glfwInit initialisiert die Event-Loop und den Display-Zugriff.
# Ohne aktives Display (z.B. in einer headless CI-Umgebung) schlägt dieser
# Schritt mit 0 fehl — der Test ist entsprechend mit '# Requires: display'
# markiert und wird von run_all_tests.var_sh übersprungen.

- decl: [ok2, i32, { call: [glfwInit] }]
- if: [{ eq: [ok2, 0] }, true]
  then:
    - print: ["FAIL: glfwInit failed"]
    - call: [sys.exit, 1]

# OpenGL 3.3 Core Profile anfordern.
# Die Integer-Konstanten sind definiert in <GLFW/glfw3.var_h>:
#   GLFW_CONTEXT_VERSION_MAJOR = 0x00022002 = 139266
#   GLFW_CONTEXT_VERSION_MINOR = 0x00022003 = 139267
#   GLFW_OPENGL_PROFILE        = 0x00022008 = 139272
#   GLFW_OPENGL_CORE_PROFILE   = 0x00032001 = 204801
- call: [glfwWindowHint, 139266, 3]       # GLFW_CONTEXT_VERSION_MAJOR = 3
- call: [glfwWindowHint, 139267, 3]       # GLFW_CONTEXT_VERSION_MINOR = 3
- call: [glfwWindowHint, 139272, 204801]  # GLFW_OPENGL_PROFILE = CORE

# null, null = kein Fullscreen-Monitor, kein geteilter GL-Kontext
- decl: [win, ptr, { call: [glfwCreateWindow, 800, 600, "AIML — texturierter Würfel", null, null] }]
- if: [{ eq: [win, null] }, true]
  then:
    - print: ["FAIL: glfwCreateWindow failed"]
    - call: [glfwTerminate]
    - call: [sys.exit, 1]

# GL-Kontext auf den aktuellen Thread binden, GLEW initialisieren und
# Depth-Test aktivieren (Würfel-Flächen korrekt sortiert nach Z-Abstand).
- call: [glfwMakeContextCurrent, win]
- call: [gl.init]
- call: [gl.enable_depth_test]
- call: [gl.viewport, 0, 0, 800, 600]
- print: ["Phase B OK: Fenster und GL-Kontext erstellt"]

# ── Phase C: GPU-Ressourcen hochladen ────────────────────────────────────────
#
# Alle Geometrie- und Textur-Daten werden jetzt in GPU-Speicher übertragen.
# Das Layout für diesen Würfel:
#   Attribut 0: Position (xyz), 3 × f32, stride = 12 Bytes
#   Attribut 1: UV        (uv), 2 × f32, stride =  8 Bytes
#
# Wichtig: jedes vao.bind_vbo() vor dem zugehörigen vao.attrib() setzen,
# da AimlVAO intern nur einen 'current vbo_id' Slot hat und attrib()
# immer den zuletzt gebundenen VBO für dieses Attribut verwendet.

# Positions-VBO (attrib 0: xyz, 3 floats, stride 12)
- decl: [pos_vbo, gl_buffer, { call: [gl.create_buffer, positions] }]
# UV-VBO (attrib 1: uv, 2 floats, stride 8)
- decl: [uv_vbo, gl_buffer, { call: [gl.create_buffer, uvs] }]
# Index-Buffer-Object: enthält u32-Indizes für gl_DrawElements
- decl: [ibo, gl_buffer, { call: [gl.create_index_buffer, indices] }]

# VAO bündelt den gesamten Vertex-State: welche VBOs zu welchen Attribs gehören.
# Reihenfolge: VBO binden → Attrib konfigurieren → ggf. nächsten VBO binden.
- decl: [vao, gl_vao, { call: [gl.create_vao] }]
- call: [vao.bind_vbo, pos_vbo]
- call: [vao.attrib, 0, 3, 12, 0]   # index=0, size=3 (xyz), stride=12, offset=0
- call: [vao.bind_ibo, ibo]
- call: [vao.bind_vbo, uv_vbo]
- call: [vao.attrib, 1, 2, 8, 0]    # index=1, size=2 (uv),  stride=8,  offset=0

# img.to_gl_texture() dekodiert das eingebettete PNG/JPEG via stb_image und
# lädt die Pixel direkt auf die GPU — kein buffer<u8> Zwischenschritt in AIML.
# gen_mipmaps erzeugt den vollständigen Mipmap-Stack (glGenerateMipmap).
- decl: [gltex, gl_texture, { call: [img.to_gl_texture] }]
- call: [gltex.gen_mipmaps]
- print: ["Phase C OK: Geometrie und Textur hochgeladen"]

# ── Phase D: Shader kompilieren ───────────────────────────────────────────────
#
# 'text: name / value: |...|' deklariert eine String-Variable mit mehrzeiligem
# Literal-Inhalt (YAML-Block-Skalar). Der Inhalt wird direkt als GLSL-Quelltext
# an gl.compile_shader übergeben — kein Datei-I/O nötig.
#
# Vertex-Shader:
#   - liest Positions (location=0) und UV-Koordinaten (location=1)
#   - transformiert mit der MVP-Matrix (model × view × projection)
#   - leitet vUv an den Fragment-Shader weiter
#
# Fragment-Shader:
#   - liest Texel aus dem Sampler2D 'tex' an der interpolierten UV-Koordinate
#   - gibt die Texturfarbe direkt als Ausgabe aus (kein Lighting)

- text: vert_src
  value: |
    #version 330 core
    layout(location=0) in vec3 pos;
    layout(location=1) in vec2 uv;
    uniform mat4 mvp;
    out vec2 vUv;
    void main(){
      gl_Position = mvp * vec4(pos, 1.0);
      vUv = uv;
    }

- text: frag_src
  value: |
    #version 330 core
    in vec2 vUv;
    uniform sampler2D tex;
    out vec4 color;
    void main(){
      color = texture(tex, vUv);
    }

- decl: [shader, gl_shader, { call: [gl.compile_shader, vert_src, frag_src] }]
- print: ["Phase D OK: Shader kompiliert"]

# ── Phase E: Rotations-Render-Schleife (300 Frames à 33 ms ≈ 10 s) ───────────
#
# Kamera-Setup (konstant, einmalig berechnet):
#   proj : Perspektiv-Matrix (FOV ≈ 45°, Aspect 4:3, Near=0.1, Far=100)
#   view : LookAt von [0,0,3] auf [0,0,0] mit Up=[0,1,0]
#
# Pro Frame:
#   1. model-Matrix um Y-Achse rotieren (angle += 0.02 rad ≈ 1.15°/Frame)
#   2. MVP = proj × view × model (zwei Mat4-Multiplikationen)
#   3. Clear (Farbe + Depth), Shader aktivieren, Uniforms setzen
#   4. Textur auf Slot 0 binden, Dreiecke zeichnen (gl.draw_elements)
#   5. Swap Buffers + PollEvents (GLFW Event-Queue abarbeiten)
#   6. 33 ms schlafen → ~30 fps

- decl: [proj,   mat4, { call: [math.mat4_perspective, 0.785, 1.333, 0.1, 100.0] }]
- decl: [eye,    vec3, { call: [math.vec3, 0.0, 0.0, 3.0] }]
- decl: [center, vec3, { call: [math.vec3, 0.0, 0.0, 0.0] }]
- decl: [var_up,     vec3, { call: [math.vec3, 0.0, 1.0, 0.0] }]
- decl: [view,   mat4, { call: [math.mat4_lookat, eye, center, var_up] }]
- decl: [model,  mat4]    # wird jeden Frame neu gesetzt
- decl: [mvp,    mat4]    # kombinierte Transform-Matrix
- decl: [angle,  f32, 0.0]
- decl: [frame,  i32, 0]

- while:
    condition: { lt: [frame, 300] }
    body:
      # Rotation um Y-Achse: 0.02 rad/Frame ≈ 1.15°/Frame → ~313° in 300 Frames
      - set: [model, { call: [math.mat4_rotate_y, angle] }]
      # MVP = proj × view × model (rechts-nach-links: erst model, dann view, dann proj)
      - set: [mvp, { "*": [proj, view] }]
      - set: [mvp, { "*": [mvp, model] }]
      # Hintergrundfarbe (dunkles Blaugrau) + Depth-Buffer löschen
      - call: [gl.clear_all, 0.1, 0.1, 0.15, 1.0]
      # Shader aktivieren und MVP-Matrix + Textur-Slot als Uniforms setzen
      - call: [shader.use]
      - call: [shader.uniform_mat4, "mvp", mvp]
      - call: [shader.uniform_i32,  "tex", 0]   # Sampler2D 'tex' → Textur-Slot 0
      # Textur auf Slot 0 binden, dann indexierten Draw-Call ausführen
      - call: [gl.bind_texture, gltex, 0]
      - call: [gl.draw_elements, vao, icnt]      # GL_TRIANGLES, icnt Indizes
      - call: [glfwSwapBuffers, win]
      - call: [glfwPollEvents]
      - call: [time.sleep_ms, 33]
      - set: [angle, { +: [angle, 0.02] }]
      - set: [frame, { +: [frame, 1] }]

- print: ["Phase E OK: texturierter Würfel gerendert"]

# ── Aufräumen ─────────────────────────────────────────────────────────────────
#
# GPU-Ressourcen in umgekehrter Reihenfolge der Erstellung freigeben
# (VAO vor VBOs, da VAO Referenzen auf die Buffers hält).
# scene.free() gibt den cgltf-Parse-Baum + alle Bild-Daten frei.

- call: [gltex.delete]
- call: [vao.delete]
- call: [ibo.delete]
- call: [uv_vbo.delete]
- call: [pos_vbo.delete]
- call: [shader.delete]
- call: [scene.free]
- call: [glfwTerminate]

- print: ["All gltf_render tests passed"]
