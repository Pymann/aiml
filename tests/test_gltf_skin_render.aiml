# spec/43_2 §3.4 + spec/43_1 §9: prim.to_gl_mesh uploads JOINTS_0 / WEIGHTS_0 as attributes 4 / 5;
# a skinning shader blends uBones (uniform_mat4_array) by them. tests/skin_tube.glb comes from
# shaper tests/p10/ok/skin_blend.shaml (6 bones, smooth weights).
# Requires: display
# Expected exit code: 0
- text: skin_vert
  value: |
    #version 330 core
    layout(location = 0) in vec3 aPos;
    layout(location = 4) in vec4 aJoints;
    layout(location = 5) in vec4 aWeights;
    uniform mat4 uBones[64];
    uniform mat4 uMvp;
    out vec4 vWeights;
    void main() {
      mat4 skin = aWeights.x * uBones[int(aJoints.x)] + aWeights.y * uBones[int(aJoints.y)]
                + aWeights.z * uBones[int(aJoints.z)] + aWeights.w * uBones[int(aJoints.w)];
      vWeights = aWeights;
      gl_Position = uMvp * skin * vec4(aPos, 1.0);
    }
- text: skin_frag
  value: |
    #version 330 core
    in vec4 vWeights;
    out vec4 fragColor;
    void main() { fragColor = vec4(vWeights.xyz, 1.0); }
- class:
    name: SkinProbe
    members: [[bones, i32]]
    methods:
      # Sum of the four weights of vertex `vtx`.
      - def:
          name: weight_sum
          access: public
          args: [[weights, buffer<f32>], [vtx, i32]]
          return: f32
          body:
            - call: [weights.seek, { "*": [vtx, 16] }]
            - decl: [sum, f32, 0.0]
            - decl: [slot, i32, 0]
            - while:
                condition: { lt: [slot, 4] }
                body:
                  - set: [sum, { +: [sum, { call: [weights.read, f32] }] }]
                  - set: [slot, { +: [slot, 1] }]
            - return: sum

      - def:
          name: identities
          access: public
          args: [[count, i32]]
          return: buffer<f32>
          body:
            - decl: [out, buffer<f32>]
            - call: [out.alloc, { "*": [count, 64] }]
            - decl: [mat, i32, 0]
            - while:
                condition: { lt: [mat, count] }
                body:
                  - decl: [cell, i32, 0]
                  - while:
                      condition: { lt: [cell, 16] }
                      body:
                        - decl: [val, f32, 0.0]
                        - if: { condition: { eq: [{ "%": [cell, 5] }, 0] }, then: [{ set: [val, 1.0] }] }
                        - call: [out.write, val, f32]
                        - set: [cell, { +: [cell, 1] }]
                  - set: [mat, { +: [mat, 1] }]
            - return: out
- def:
    name: main
    return: i32
    body:
      - decl: [probe, ptr<SkinProbe>, { new: SkinProbe }]
      - decl: [win, window_handle, { call: [engine.create_window, 320, 240, "skin"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL window"] }, { return: 1 }] }
      - decl: [file_path, path, "tests/skin_tube.glb"]
      - decl: [scene, gltf_scene, { call: [gltf.load, file_path] }]
      - if: { condition: { eq: [{ call: [scene.valid] }, 0] }, then: [{ print: ["FAIL load"] }, { return: 1 }] }
      - decl: [skins, list<gltf_skin>, { call: [scene.skins] }]
      - if: { condition: { neq: [skins.len, 1] }, then: [{ print: ["FAIL skins ${skins.len}"] }, { return: 1 }] }
      - decl: [skin, gltf_skin, { call: [skins.get, 0] }]
      - set: [probe.bones, { call: [skin.joint_count] }]
      - if: { condition: { neq: [probe.bones, 6] }, then: [{ print: ["FAIL joints ${probe.bones}"] }, { return: 1 }] }
      - decl: [meshes, list<gltf_mesh>, { call: [scene.meshes] }]
      - decl: [mesh, gltf_mesh, { call: [meshes.get, 0] }]
      - decl: [prim, gltf_primitive, { call: [mesh.primitive, 0] }]
      - decl: [weights, buffer<f32>, { call: [prim.weights, 0] }]
      - decl: [vtx_count, i32, { call: [prim.vertex_count] }]
      - if: { condition: { neq: [weights.len, { "*": [vtx_count, 16] }] }, then: [{ print: ["FAIL weights ${weights.len}"] }, { return: 1 }] }
      - decl: [vtx, i32, 0]
      - while:
          condition: { lt: [vtx, vtx_count] }
          body:
            - decl: [sum, f32, { call: [probe.weight_sum, weights, vtx] }]
            - if: { condition: { "||": [{ lt: [sum, 0.999] }, { gt: [sum, 1.001] }] }, then: [{ print: ["FAIL weight sum ${sum} at ${vtx}"] }, { return: 1 }] }
            - set: [vtx, { +: [vtx, 1] }]
      - decl: [gpu_mesh, gl_mesh, { call: [prim.to_gl_mesh] }]
      - decl: [shader, gl_shader, { call: [gl.compile_shader, skin_vert, skin_frag] }]
      - if: { condition: { eq: [shader, null] }, then: [{ print: ["FAIL shader"] }, { return: 1 }] }
      - decl: [bones, buffer<f32>, { call: [probe.identities, probe.bones] }]
      - decl: [mvp, mat4, { call: [math.mat4_identity] }]
      - decl: [frame, i32, 0]
      - while:
          condition: { lt: [frame, 5] }
          body:
            - call: [gl.clear_all, 0.0, 0.0, 0.0, 1.0]
            - call: [shader.use]
            - call: [shader.uniform_mat4, "uMvp", mvp]
            - call: [shader.uniform_mat4_array, "uBones", bones, probe.bones]
            - call: [gpu_mesh.draw]
            - call: [engine.swap, win]
            - set: [frame, { +: [frame, 1] }]
      - call: [gpu_mesh.delete]
      - call: [shader.delete]
      - call: [scene.free]
      - call: [engine.destroy_window, win]
      - print: ["PASS gltf_skin_render"]
      - return: 0
