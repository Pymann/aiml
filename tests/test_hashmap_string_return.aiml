# SPEC: 69_hashmap
# Regression: return hashmap<string:string>.get from a method and bind it in the caller.
# Trigger: ANY function with the short name `get` that returns a string (here Notebook.get).
# The compiler then no longer recognised `return: { call: [x.get, k] }` as a borrowed access.
# Before, get was a borrowed pointer: the calling method took it over as its own value and
# freed it at the end, while the table still held it -> garbage afterwards (found by cai,
# AimlStructureLearner.role / main_program).

- class:
    name: Notebook
    members:
      - [text, string, "notiz"]
    methods:
      - def:
          name: get
          args: []
          return: string
          body:
            - return: "${<.text}!"

- class:
    name: RoleTable
    members:
      - [roles, "hashmap<string:string>"]
      - [names, list<string>, null]
    methods:
      - def:
          name: role
          args: [[name, string]]
          return: string
          body:
            - return: { call: [<.roles.get, name] }
      - def:
          name: keep
          args: [[name, string], [value, string]]
          body:
            - call: [<.roles.put, name, value]
      - def:
          name: name_at
          args: [[index, i32]]
          return: string
          body:
            - return: { call: [<.names.get, index] }
      - def:
          name: render_list
          args: []
          return: string
          body:
            - decl: [first, string, { call: [<.name_at, 0] }]
            - return: "${first}"
      # like main_program in cai: read several roles, assemble them into one text
      - def:
          name: render
          args: []
          return: string
          body:
            - decl: [block, string, { call: [<.role, "programm"] }]
            - decl: [named, string, { call: [<.role, "programm.name"] }]
            - return: "${block}:${named}"

- def:
    name: main
    return: i32
    static_off: ["str_cmp"]
    body:
      - decl: [table, ptr<RoleTable>, { new: RoleTable }]
      - decl: [found, list<string>, ["def", "name"]]
      - decl: [slot, i32, 0]
      - while: [{ lt: [slot, 1] }]
        body:
          - decl: [first, string, { call: [found.get, 0] }]
          - decl: [second, string, { call: [found.get, 1] }]
          - call: [table.keep, "programm", first]
          - call: [table.keep, "programm.name", second]
          - set: [slot, { +: [slot, 1] }]
      - decl: [round, i32, 0]
      - decl: [bad, i32, 0]
      - while: [{ lt: [round, 20] }]
        body:
          - decl: [text, string, { call: [table.render] }]
          - if: [{ neq: [text, "def:name"] }, true]
            then:
              - set: [bad, { +: [bad, 1] }]
          - set: [round, { +: [round, 1] }]
      - call: [table.names.push, "alpha"]
      - decl: [list_bad, i32, 0]
      - set: [round, 0]
      - while: [{ lt: [round, 20] }]
        body:
          - decl: [item, string, { call: [table.render_list] }]
          - if: [{ neq: [item, "alpha"] }, true]
            then:
              - set: [list_bad, { +: [list_bad, 1] }]
          - set: [round, { +: [round, 1] }]
      - decl: [book, ptr<Notebook>, { new: Notebook }]
      - decl: [note, string, { call: [book.get] }]
      - free: [book]
      - if: [{ gt: [list_bad, 0] }, true]
        then:
          - print: ["FAIL list<string>.get return: ${list_bad}/20 wrong texts"]
          - return: 1
      - decl: [missing, string, { call: [table.role, "fehlt"] }]
      - if: [{ gt: [bad, 0] }, true]
        then:
          - print: ["FAIL hashmap string return: ${bad}/20 wrong texts"]
          - return: 1
      - if: [{ neq: [missing, ""] }, true]
        then:
          - print: ["FAIL missing key: '${missing}'"]
          - return: 1
      - free: [table]
      - print: ["PASS test_hashmap_string_return"]
      - return: 0
