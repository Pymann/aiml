# Hot-Reload Test — class version guard (struct append-only re-definition)
#
# Expected output:
#   v1 rc: 7       (make_box_val v1 called via fptable; Box v1 layout)
#   v2 rc: 7       (Box v2 hot-reloaded: compiled_version bumped to 2;
#                   make_box_val still returns 7 — GEP index 0 unchanged)
#   v1 skip rc: 7  (Box v1 <= live v2 → version guard skips)

# Define Box v1
- class:
    name: Box
    version: 1
    members:
      - [val, i32]

# Function that uses Box (zero-arg so sys.exec can call it)
- def:
    name: make_box_val
    version: 1
    return: i32
    body:
      - decl: [b, Box]
      - set: [b.val, 7]
      - return: 7

# Bundle v1 and execute it
- decl: [pkg1, Code]
- set: [pkg1, {call: [sys.bundle, "make_box_val"]}]
- decl: [rc, i32]
- set: [rc, {call: [sys.exec, pkg1]}]
- print: ["v1 rc: ${rc}"]

# Define Box v2 — append-only: new field extra
- class:
    name: Box
    version: 2
    members:
      - [val, i32]
      - [extra, i32]

# Bundle v2 (captures Box v2 YAML) and exec — should hot-reload Box class
- decl: [pkg2, Code]
- set: [pkg2, {call: [sys.bundle, "make_box_val"]}]
- set: [rc, {call: [sys.exec, pkg2]}]
- print: ["v2 rc: ${rc}"]

# Execute v1 bundle again — version guard should skip (1 <= live 1)
# rc stays at 7 (make_box_val still active)
- set: [rc, {call: [sys.exec, pkg1]}]
- print: ["v1 skip rc: ${rc}"]
