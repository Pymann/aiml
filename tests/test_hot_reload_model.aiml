# SPEC?: 15_models,30_hot_reload   # derived from the file name, to be confirmed
# Hot-Reload Test — model: version guard (primary_key model append-only re-definition)
#
# Expected output:
#   v1 var_rc: 42      (lookup_score v1 called via fptable; Player v1 layout)
#   v2 var_rc: 42      (Player v2 hot-reloaded: compiled_version bumped to 2;
#                   lookup_score still returns 42 — field offsets unchanged)
#   v1 skip var_rc: 42 (Player v1 <= live v2 → version guard skips)

# Define Player model v1
- model:
    name: Player
    version: 1
    primary_key: name
    fields:
      - [name, string]
      - [score, i32]

# Function that uses Player (no-arg so sys.exec can call it)
- def:
    name: lookup_score
    version: 1
    return: i32
    body:
      - decl: [var_p, Player]
      - set: [var_p.score, 42]
      - return: 42

# Bundle v1 and execute it
- decl: [pkg1, Code]
- set: [pkg1, {call: [sys.bundle, "lookup_score"]}]
- decl: [var_rc, i32]
- set: [var_rc, {call: [sys.exec, pkg1]}]
- print: ["v1 var_rc: ${var_rc}"]

# Define Player model v2 — append-only: new field level
- model:
    name: Player
    version: 2
    primary_key: name
    fields:
      - [name, string]
      - [score, i32]
      - [level, i32]

# Bundle v2 (captures Player v2 YAML) and exec — should hot-reload Player model
- decl: [pkg2, Code]
- set: [pkg2, {call: [sys.bundle, "lookup_score"]}]
- set: [var_rc, {call: [sys.exec, pkg2]}]
- print: ["v2 var_rc: ${var_rc}"]

# Execute v1 bundle again — version guard should skip (1 <= live 2)
- set: [var_rc, {call: [sys.exec, pkg1]}]
- print: ["v1 skip var_rc: ${var_rc}"]
