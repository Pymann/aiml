# Tests for http namespace + HTTP handle types
# Expected exit code: 0

# ── Phase A: URL parsing ──────────────────────────────────────────────────────

- decl: [u, url]
- set: [u, { call: [http.parse_url, "https://example.com:8443/api/v1?page=2&q=hello"] }]
- decl: [proto, string]
- set: [proto, { call: [u.protocol] }]
- print: ["url.protocol: ${proto}"]
- decl: [host, string]
- set: [host, { call: [u.host] }]
- print: ["url.host: ${host}"]
- decl: [upath, string]
- set: [upath, { call: [u.path] }]
- print: ["url.path: ${upath}"]
- decl: [port, i32]
- set: [port, { call: [u.port] }]
- print: ["url.port: ${port}"]
- decl: [is_s, i8]
- set: [is_s, { call: [u.is_https] }]
- print: ["url.is_https: ${is_s}"]

# Query params via chained call
- decl: [page, string]
- set: [page, { call: [u.get_param.get, "page"] }]
- print: ["url.get_param.get(page): ${page}"]
- decl: [q, string]
- set: [q, { call: [u.get_param.get, "q"] }]
- print: ["url.get_param.get(q): ${q}"]

# Roundtrip to string
- decl: [rebuilt, string]
- set: [rebuilt, { call: [u.to_string] }]
- print: ["url.to_string: ${rebuilt}"]

# ── Phase B: HTTP client — GET request against httpbin.org (or skip if offline) ──

- def:
    name: run_http_client
    args: []
    return: i32
    body:
      - decl: [req_url, url]
      - set: [req_url, { call: [http.parse_url, "http://httpbin.org/get"] }]
      - decl: [resp, http_response_handle]
      - set: [resp, { call: [http.get, req_url] }]
      - decl: [st, i32]
      - set: [st, { call: [resp.status] }]
      - print: ["GET httpbin.org/get status: ${st}"]
      - decl: [ok, i8]
      - set: [ok, { call: [resp.ok] }]
      - print: ["resp.ok: ${ok}"]
      - decl: [body, string]
      - set: [body, { call: [resp.body] }]
      - print: ["resp.body len > 0: (body received)"]
      - call: [resp.free]
      - return: 0

# Skip the live HTTP test in offline environments — comment the call below to skip
- call: [run_http_client]

# ── Phase C: HTTP server + client loopback ────────────────────────────────────

- def:
    name: handle_root
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - decl: [m, string]
      - set: [m, { call: [req.method] }]
      - decl: [p, string]
      - set: [p, { call: [req.path] }]
      - print: ["server: ${m} ${p}"]
      - set: [resp.status, 200]
      - set: [resp.body, "hello from aiml"]
      - call: [resp.headers.put, "Content-Type", "text/plain"]
      - call: [resp.send]

- def:
    name: http_server_thread
    args: []
    body:
      - decl: [srv, http_server_handle]
      - set: [srv, { call: [http.server, "127.0.0.1", 18080] }]
      - call: [srv.route, "GET", "/", handle_root]
      - call: [srv.start]

- def:
    name: http_client_thread
    args: []
    body:
      - call: [time.sleep_ms, 200]
      - decl: [curl, url]
      - set: [curl, { call: [http.parse_url, "http://127.0.0.1:18080/"] }]
      - decl: [resp, http_response_handle]
      - set: [resp, { call: [http.get, curl] }]
      - decl: [st, i32]
      - set: [st, { call: [resp.status] }]
      - print: ["loopback GET status: ${st}"]
      - decl: [rb, string]
      - set: [rb, { call: [resp.body] }]
      - print: ["loopback body: ${rb}"]
      - call: [resp.free]

- decl: [srv_th, thread_handle]
- set: [srv_th, { spawn: [http_server_thread] }]

- decl: [cli_th, thread_handle]
- set: [cli_th, { spawn: [http_client_thread] }]

- call: [cli_th.join]
- print: ["http loopback done"]
