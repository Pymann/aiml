# Isolates i64 comparison against an i32 literal (2147483647) + i64 string interpolation
# in WASM — exactly the primitives in mkp_i64_to_i32.
- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]

      # (a) small i64 against i32 max
      - decl: [small, i64, 7500]
      - decl: [cmp_a, i32, 0]
      - if: { condition: { gt: [small, 2147483647] }, then: [{ set: [cmp_a, 1] }] }
      - print: ["(a) small=${small} gt_max=${cmp_a} (expected 7500, 0)"]
      - if: { condition: { neq: [cmp_a, 0] }, then: [{ set: [fails, { +: [fails, 1] }] }] }

      # (b) big i64 (3 billion) against i32 max
      - decl: [big, i64, 3000000000]
      - decl: [cmp_b, i32, 0]
      - if: { condition: { gt: [big, 2147483647] }, then: [{ set: [cmp_b, 1] }] }
      - print: ["(b) big=${big} gt_max=${cmp_b} (expected 3000000000, 1)"]
      - if: { condition: { neq: [cmp_b, 1] }, then: [{ set: [fails, { +: [fails, 1] }] }] }

      # (c) i64-Produkt i64×i32 (Promotion) + Interpolation
      - decl: [base64, i64, 15000]
      - decl: [val32, i32, 1]
      - decl: [prod, i64, { '*': [base64, val32] }]
      - print: ["(c) 15000(i64) * 1(i32) = ${prod} (expected 15000)"]
      - if: { condition: { neq: [prod, 15000] }, then: [{ set: [fails, { +: [fails, 1] }] }] }

      # (d) i64 just above i32 max interpolated correctly
      - decl: [over, i64, 2147483648]
      - print: ["(d) over = ${over} (expected 2147483648)"]
      - if: { condition: { neq: [over, 2147483648] }, then: [{ set: [fails, { +: [fails, 1] }] }] }

      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS i64 cmp/interp"] }]
          else: [{ print: ["FAIL i64 cmp/interp: ${fails}"] }]
      - return: fails
