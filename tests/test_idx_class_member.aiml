# SPEC?: 16_classes   # derived from the file name, to be confirmed
# Repro: idx: [<.member_list, i, val] on class-member list
- class:
    name: Store
    members:
      - [items, list<string>]
    methods:
      - def:
          name: init
          body:
            - call: [<.items.push, "one"]
            - call: [<.items.push, "two"]
            - call: [<.items.push, "three"]
      - def:
          name: get_new
          return: string
          body: [{ return: "TWO_INLINE" }]
      - def:
          name: mutate
          body:
            - decl: [target_idx, i32, 1]
            # case A1: value is an inline binary op expression
            - decl: [text_a, list<string>]
            - call: [text_a.push, "ONE_A"]
            - idx: [<.items, target_idx, { call: [text_a.get, 0] }]
      - def:
          name: mutate2
          body:
            - decl: [target_idx, i32, 2]
            # case B: value is a call outside idx wrapped in an expression
            - decl: [tmp_val, string, { call: [<.get_new] }]
            - idx: [<.items, target_idx, tmp_val]

- def:
    name: main
    return: i32
    body:
      - decl: [store, ptr<Store>, { new: Store }]
      - call: [store.init]
      - decl: [before0, string, { at: [store.items, 0] }]
      - decl: [before1, string, { at: [store.items, 1] }]
      - decl: [before2, string, { at: [store.items, 2] }]
      - call: [log.info, "before: 0=${before0} 1=${before1} 2=${before2}"]
      - call: [store.mutate]
      - call: [store.mutate2]
      - decl: [after0, string, { at: [store.items, 0] }]
      - decl: [after1, string, { at: [store.items, 1] }]
      - decl: [after2, string, { at: [store.items, 2] }]
      - call: [log.info, "after A(1)+B(2):  0=${after0} 1=${after1} 2=${after2}"]
      - return: 0
