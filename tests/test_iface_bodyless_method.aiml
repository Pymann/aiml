# SPEC?: 02_types   # derived from the file name, to be confirmed
# static-check: off
# Bodyless interface method: a class declares an interface method
# WITHOUT `body:` — that syntactically satisfies the interface (the method exists),
# but means "no-op / default".  The compiler emits a default
# return (void→nothing, i32→0, ptr→null, struct→empty) instead of a
# hand-written empty body.  Saves boilerplate for polymorphic
# interfaces with many methods that many types do not need.
#
# Expectation: compiles, interface satisfied, bodyless methods return defaults.

- interface:
    name: Named
    methods:
      - [get_label,  string, []]
      - [do_thing,   void,   [[amount, i32]]]
      - [get_num,    i32,    []]
      - [get_tags,   list<string>, []]

- model: { name: FooData, fields: [[fid, string]] }

- class:
    name: Foo
    models: [FooData]
    implements: [Named]
    methods:
      # real impl:
      - def: { name: get_label, return: string, args: [], body: [{ return: <.fid }] }
      # bodyless — no-op void:
      - def: { name: do_thing, return: void, args: [[amount, i32]] }
      # bodyless — default i32 (0):
      - def: { name: get_num, return: i32, args: [] }
      # bodyless — default list<string> (empty):
      - def: { name: get_tags, return: list<string>, args: [] }

- def:
    name: main
    return: i32
    body:
      - decl: [foo, ptr<Foo>, { new: Foo }]
      - set: [foo.fid, "hello"]
      - decl: [nmd, ptr<Named>, foo]
      - decl: [fails, i32, 0]
      - if: { condition: { neq: [{ call: [nmd.get_label] }, "hello"] }, then: [{ print: ["FAIL get_label"] }, { set: [fails, { +: [fails, 1] }] }] }
      - call: [nmd.do_thing, 5]   # no-op, must not crash
      - if: { condition: { neq: [{ call: [nmd.get_num] }, 0] }, then: [{ print: ["FAIL get_num (bodyless default)"] }, { set: [fails, { +: [fails, 1] }] }] }
      - decl: [tgs, list<string>, { call: [nmd.get_tags] }]
      - if: { condition: { neq: [tgs.len, 0] }, then: [{ print: ["FAIL get_tags default not empty"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS iface_bodyless_method: bodyless satisfies interface + returns defaults"] }]
          else: [{ print: ["FAIL iface_bodyless_method: ${fails}"] }]
      - return: fails
