# SPEC?: 29_serialize,18_refs_and_pointers   # aus dem Dateinamen, zu bestaetigen
# static-check: off
# Symmetry probe: list<ptr<T>> roundtrip — analog to ref<T>, since the compiler
# treats ref and ptr as equivalent opaque pointers.

- interface:
    name: Tagged
    methods:
      - [tag, string, []]

- model:
    name: Item
    fields:
      - [name, string]
      - [var_n,    i32, 0]

- class:
    name: ItemBehavior
    models: [Item]
    implements: [Tagged]
    methods:
      - def: { name: tag, return: string, args: [], body: [{ return: "${<.name}#${<.var_n}" }] }

- model:
    name: Bag
    fields:
      - [items, list<ptr<ItemBehavior>>]

- decl: [var_a, ptr<ItemBehavior>, { new: ItemBehavior }]
- set: [var_a.name, "alpha"]
- set: [var_a.var_n,    1]
- decl: [var_b, ptr<ItemBehavior>, { new: ItemBehavior }]
- set: [var_b.name, "beta"]
- set: [var_b.var_n,    2]

- decl: [bag, Bag]
- call: [bag.items.push, var_a]
- call: [bag.items.push, var_b]

- decl: [var_s, string, { call: [sys.serialize, bag] }]
- print: ["serialized = ${var_s}"]
- decl: [bag2, Bag, { call: [sys.deserialize, var_s] }]
- print: ["bag2.items.len = ${bag2.items.len}"]

- decl: [items2, list<ptr<ItemBehavior>>, bag2.items]
- decl: [var_i, i32, 0]
- while:
    condition: { lt: [var_i, items2.len] }
    body:
      - decl: [var_it, ref<ItemBehavior>, { at: [items2, var_i] }]
      - decl: [var_v,  ref<Tagged>,       var_it]
      - print: ["bag2[${var_i}] poly: tag=${call: [var_v.tag]}"]
      - set: [var_i, { +: [var_i, 1] }]
