# Repro: same vtable-list-return pattern as test_iface_list_return.aiml, but
# the object goes through sys.serialize → sys.deserialize roundtrip first.
# This is the closest pattern to DataCreatures (Mirror RPC = ser/deser).
# Expected exit code: 0.

- interface:
    name: Tagged
    methods:
      - [tags, list<string>, []]

- model:
    name: Item
    fields:
      - [name, string]
      - [tags, list<string>]

- class:
    name: ItemImpl
    models: [Item]
    implements: [Tagged]
    methods:
      - def:
          name: tags
          return: list<string>
          args: []
          body:
            - decl: [var_r, list<string>, <.tags]
            - return: var_r

- decl: [src, ptr<ItemImpl>, { new: ItemImpl }]
- set: [src.name, "Hammer"]
- call: [src.tags.push, "tool"]
- call: [src.tags.push, "metal"]
- call: [src.tags.push, "starter"]

# Serialize to JSON, then deserialize back.
- decl: [json, string, { call: [sys.serialize, src] }]
- print: ["json=${json}"]
- decl: [restored, ptr<ItemImpl>, { call: [sys.deserialize, json, "ItemImpl"] }]

- print: ["restored.name=${restored.name}"]
- print: ["restored.tags.len=${restored.tags.len}"]

# Upcast → vtable dispatch
- decl: [view, ptr<Tagged>, restored]
- decl: [got, list<string>, { call: [view.tags] }]

- print: ["got.len=${got.len}"]
- if:
    condition: { neq: [got.len, 3] }
    then:
      - print: ["FAIL got.len=${got.len}"]
      - call: [sys.exit, 1]

# CRITICAL: at: [got, 0] — the operation that crashes in DataCreatures.
- decl: [first, string, { at: [got, 0] }]
- print: ["first='${first}'"]
- if:
    condition: { eq: [first, "tool"] }
    then:
      - print: ["PASS"]
      - call: [sys.exit, 0]
    else:
      - print: ["FAIL first='${first}'"]
      - call: [sys.exit, 1]
