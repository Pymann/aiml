# SPEC?: 02_types   # derived from the file name, to be confirmed
# static-check: off
# Probe: model + class via `models:` + `implements:` for interface polymorphism.
# Clean architecture: the model holds data, the class references the model via `models:`
# and implements the interface.

- interface:
    name: Sayable
    methods:
      - [say, string, []]

- model:
    name: Cat
    fields:
      - [name, string]

- class:
    name: CatBehavior
    models: [Cat]
    implements: [Sayable]
    methods:
      - def: { name: say, return: string, args: [], body: [{ return: "Meow! I am ${<.name}" }] }

- model:
    name: Dog
    fields:
      - [name, string]

- class:
    name: DogBehavior
    models: [Dog]
    implements: [Sayable]
    methods:
      - def: { name: say, return: string, args: [], body: [{ return: "Woof! I am ${<.name}" }] }

- decl: [var_c, ptr<CatBehavior>, { new: CatBehavior }]
- set: [var_c.name, "Whiskers"]
- decl: [var_d, ptr<DogBehavior>, { new: DogBehavior }]
- set: [var_d.name, "Rex"]

- print: ["cat direct: ${call: [var_c.say]}"]
- print: ["dog direct: ${call: [var_d.say]}"]

# polymorphism via ptr<Sayable>
- decl: [var_s1, ptr<Sayable>, var_c]
- decl: [var_s2, ptr<Sayable>, var_d]
- print: ["cat poly:   ${call: [var_s1.say]}"]
- print: ["dog poly:   ${call: [var_s2.say]}"]
