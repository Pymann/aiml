# SPEC: 19_inheritance
# For polymorphism spec/19 shows ONLY `decl: [d, ptr<Iface>]` + `set: [d, { new: X }]`.
# datacreatures uses three more forms; this file records them:
#   (a) ptr<Iface> from an existing ptr<Class> variable
#   (b) passing this pointer as a FUNCTION ARGUMENT of type ptr<Iface>
#   (c) storing it in a map<string:ptr<Iface>> and calling after reading it out
# Measured on 2026-11-10: exactly this route crashed in the client on hover
# (valgrind: "Invalid read of size 8, Address 0x68" in the virtual call).

- interface:
    name: Tileish
    methods:
      - [tile_icon_path, string,       []]
      - [tile_name,      string,       []]
      - [tile_tags,      list<string>, []]
      - [tile_count,     i32,          []]
      - [tile_id,        string,       []]

- model:
    name: ItemData
    fields:
      - [name,    string]
      - [item_id, string]
      - [anzahl,  i32, 1]

- class:
    name: ItemBehavior
    models: [ItemData]
    implements: [Tileish]
    methods:
      - def: { name: tile_icon_path, return: string, args: [], body: [{ return: "icons/${<.item_id}" }] }
      - def: { name: tile_name,      return: string, args: [], body: [{ return: <.name }] }
      - def:
          name: tile_tags
          return: list<string>
          args: []
          body:
            - decl: [out, list<string>]
            - call: [out.push, "starter"]
            - return: out
      - def: { name: tile_count, return: i32,    args: [], body: [{ return: <.anzahl }] }
      - def: { name: tile_id,    return: string, args: [], body: [{ return: <.item_id }] }

# (b) the argument type is the INTERFACE, the caller passes in an upcast
# class -- in the client that is TileGrid.spawn.
- def:
    name: stelle_auf
    args: [[tid, string], [verhalten, ptr<Tileish>], [karte, map<string:ptr<Tileish>>]]
    body:
      - decl: [icon, string, { call: [verhalten.tile_icon_path] }]
      - call: [log.info, "stelle_auf ${tid}: icon=${icon}"]
      - call: [karte.set, tid, verhalten]

- def:
    name: main
    return: i32
    static_off: ["str_cmp"]
    body:
      - decl: [var_ok, i32, 1]
      - decl: [verhalten, ptr<ItemBehavior>, { new: ItemBehavior }]
      - set: [verhalten.name,    "Hammer"]
      - set: [verhalten.item_id, "hammer"]
      - set: [verhalten.anzahl,  3]

      # (a) upcast into a variable of its own.
      - decl: [sicht, ptr<Tileish>, verhalten]
      - decl: [direkt, string, { call: [sicht.tile_name] }]
      - if:
          condition: { neq: [direkt, "Hammer"] }
          then: [{ print: ["FAIL A: ptr<Iface> from ptr<Class> -> '${direkt}'"] }, { set: [var_ok, 0] }]

      # (b) + (c) via argument and map.
      - decl: [karte, map<string:ptr<Tileish>>]
      - call: [stelle_auf, "hammer", sicht, karte]
      # (c) read out and call virtually again -- in the client the tooltip.
      - decl: [aus_karte, string, ""]
      - if:
          condition: { eq: [{ call: [karte.has, "hammer"] }, 1] }
          then:
            - decl: [zurueck, ref<Tileish>, { call: [karte.get, "hammer"] }]
            - set: [aus_karte, { call: [zurueck.tile_name] }]
      - if:
          condition: { neq: [aus_karte, "Hammer"] }
          then: [{ print: ["FAIL B: via argument+map -> '${aus_karte}'"] }, { set: [var_ok, 0] }]

      - if: { condition: { eq: [var_ok, 1] }, then: [{ print: ["PASS iface upcast"] }], else: [{ return: 1 }] }
      - return: 0
