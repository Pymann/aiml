# SPEC?: 18_refs_and_pointers   # derived from the file name, to be confirmed
# static-check: off
# BUG repro: an interface method takes ptr<Struct>; on the POLYMORPHIC
# (vtable) call a struct VARIABLE argument is loaded by value instead of
# passing its address → "Call parameter type does not match function
# signature".  The direct (non-vtable) method call coerces correctly;
# the vtable dispatch path (ast_compiler_call.cpp ~595) does not yet.
#
# Expectation after the fix: compiles, dst.val is set via the vtable call.

- model: { name: Box, fields: [[val, i32]] }
- model: { name: AData, fields: [[aid, i32]] }

- interface:
    name: Filler
    methods:
      - [fill, void, [[dst, ref<Box>]]]

- class:
    name: AImpl
    models: [AData]
    implements: [Filler]
    methods:
      - def:
          name: fill
          args: [[dst, ref<Box>]]
          return: void
          body: [{ set: [dst.val, 42] }]

- def:
    name: main
    return: i32
    body:
      - decl: [imp, ptr<AImpl>, { new: AImpl }]
      - decl: [flr, ptr<Filler>, imp]
      - decl: [box, Box]
      # POLYMORPHIC vtable call with a struct var arg (implicit ref should give the address):
      - call: [flr.fill, box]
      - if:
          condition: { eq: [box.val, 42] }
          then: [{ print: ["PASS iface_vtable_ptr_struct_arg: struct-var coerced to ptr in vtable call"] }]
          else: [{ print: ["FAIL box.val=${box.val} want 42"] }]
      - return: { -: [42, box.val] }
