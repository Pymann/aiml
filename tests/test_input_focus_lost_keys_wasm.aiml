# SPEC: 44_0_input
# spec/44_0 §2.1: focus loss releases HELD KEYS.
#
# Until 2026-11-15 both focus handlers only cleaned up the mouse
# (`glfw_focus_cb` native, `bin_blur` in the browser) -- the keyboard appeared in neither
# of them.  If someone holds a key and the window loses focus,
# the `keyup` goes to the window that has the focus NOW: the level stayed down
# forever, and every `key_down` query kept reporting the key.  In
# DataCreatures the combat camera (bound to `key_down("q"/"e")`) therefore
# rotated for the rest of the session.
#
# For the mouse this promise and its test (test_input_touch_cancel) had existed
# for a long time; for the keyboard both were missing.
# Requires: wasm
#   The browser branch only exists in the wasm build; natively input.init would
#   fail without a window.  Runs via run_wasm_tests.sh.
# Expected exit code: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - call: [input.init, null]

      # ── held means held, frame after frame ──────────────────────────────
      - call: [input.post_key_down, "q"]
      - if:
          condition: { neq: [{ call: [input.key_down, "q"] }, 1] }
          then: [{ call: [log.error, "FAIL q not down after press"] }, { return: 1 }]
      - call: [input.update]
      - if:
          condition: { neq: [{ call: [input.key_down, "q"] }, 1] }
          then: [{ call: [log.error, "FAIL q no longer down after one frame"] }, { return: 1 }]

      # ── focus loss releases it ───────────────────────────────────────────
      - call: [input.post_focus_lost]
      - if:
          condition: { neq: [{ call: [input.key_down, "q"] }, 0] }
          then: [{ call: [log.error, "FAIL q sticks after focus loss"] }, { return: 1 }]
      # No cancel channel for keys (§2.1): the focus loss is reported as a
      # RELEASE, so that whoever tracks "held" from edges does not
      # hang without any event at all.
      - if:
          condition: { neq: [{ call: [input.key_released, "q"] }, 1] }
          then: [{ call: [log.error, "FAIL release edge missing"] }, { return: 1 }]

      # ── and it stays up ──────────────────────────────────────────────────
      - decl: [bild, i32, 0]
      - while:
          condition: { lt: [bild, 20] }
          body:
            - set: [bild, { "+": [bild, 1] }]
            - call: [input.update]
            - if:
                condition: { neq: [{ call: [input.key_down, "q"] }, 0] }
                then: [{ call: [log.error, "FAIL q down again in frame ${bild}"] }, { return: 1 }]

      # ── several keys at once ─────────────────────────────────────────────
      - call: [input.update]
      - call: [input.post_key_down, "e"]
      - call: [input.post_key_down, "w"]
      - call: [input.post_key_down, "lshift"]
      - call: [input.post_focus_lost]
      - if:
          condition: { neq: [{ call: [input.key_down, "e"] }, 0] }
          then: [{ call: [log.error, "FAIL e sticks"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.key_down, "w"] }, 0] }
          then: [{ call: [log.error, "FAIL w sticks"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.key_down, "lshift"] }, 0] }
          then: [{ call: [log.error, "FAIL lshift sticks"] }, { return: 1 }]

      # ── afterwards everything is normal again ────────────────────────────
      - call: [input.update]
      - call: [input.post_key_down, "e"]
      - if:
          condition: { neq: [{ call: [input.key_down, "e"] }, 1] }
          then: [{ call: [log.error, "FAIL e can no longer be pressed after focus loss"] }, { return: 1 }]
      - call: [input.post_key_up, "e"]
      - if:
          condition: { neq: [{ call: [input.key_down, "e"] }, 0] }
          then: [{ call: [log.error, "FAIL e still down after release"] }, { return: 1 }]

      - call: [log.info, "OK focus loss releases held keys"]
      - return: 0
