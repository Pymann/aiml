# SPEC: 44_0_input,44_6_prefabs
# spec/44_0 §8 + spec/44_6: input injection drives a REAL click.
#
# That was not testable until now: test_prefab_textbox_selection itself says that
# mouse selection "needs a window and real clicks".  Here the chain is
# complete — query the widget geometry, move the cursor there, press, release,
# and the button reports the click.
#
# Checked in this order:
#   1. .child_rect_* returns the hit area in screen coordinates
#   2. an injected click on the centre triggers child_clicked
#   3. a click NEXT TO it does not trigger it (otherwise 2. would be worthless)
#   3b. in both cases the hit trace names the resolved target or "miss"
#   4. post_text lands in the focused field
#   5. post_key_down/up acts on key_down
# Requires: display
# Expected exit code: 0

- prefab:
    name: ClickScene
    width: 400
    height: 300
    children:
      - { name: ok_btn, type: button, x: 120, y: 100, width: 160, height: 40,
          label: "OK", bg_color: 0x2A4A6AFF, color: 0xFFFFFFFF, font_size: 14 }
      - { name: name_input, type: text_input, x: 20, y: 200, width: 360, height: 28,
          bg_color: 0x202020FF, color: 0xFFFFFFFF, font_size: 12 }

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "click"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]
      - decl: [font, ui_font, { call: [ui.load_font_default, 12.0] }]
      - if: { condition: { neq: [font, null] }, then: [{ call: [engine.prefab_set_font, font] }] }

      # Hit trace on: it names the widget that REALLY resolved the press
      # — without it a failure could not be told apart from "the click never
      # arrived" (spec/44_6 §5).
      - call: [engine.prefab_trace_hits, 1]

      - decl: [scene, prefab_instance, { call: [engine.instantiate, "ClickScene"] }]
      - call: [scene.set_pos, 0.0, 0.0]

      # ── 1. Geometry ─────────────────────────────────────────────────────
      - decl: [btn_x, f32, { call: [scene.child_rect_x, "ok_btn"] }]
      - decl: [btn_y, f32, { call: [scene.child_rect_y, "ok_btn"] }]
      - decl: [btn_w, f32, { call: [scene.child_rect_w, "ok_btn"] }]
      - decl: [btn_h, f32, { call: [scene.child_rect_h, "ok_btn"] }]
      - if:
          condition: { lt: [btn_w, 1.0] }
          then: [{ print: ["FAIL child_rect_w=${btn_w} (widget not found?)"] }, { return: 1 }]
      # Counter-probe against the existing point query: the centre of the
      # returned area must also lie inside according to child_contains.
      - decl: [mid_x, f32, { +: [btn_x, { /: [btn_w, 2.0] }] }]
      - decl: [mid_y, f32, { +: [btn_y, { /: [btn_h, 2.0] }] }]
      - decl: [inside, i32, { call: [scene.child_contains, "ok_btn", mid_x, mid_y] }]
      - if:
          condition: { neq: [inside, 1] }
          then: [{ print: ["FAIL centre (${mid_x},${mid_y}) is not inside the widget according to child_contains"] }, { return: 1 }]

      # ── 2. click on the centre ───────────────────────────────────────────
      # Three frames (spec/44_0 §8.4): move, press, release.  Injection happens
      # AFTER engine.swap, because swap clears the latches (§8.3).
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, mid_x, mid_y]
      - call: [engine.update_hover, mid_x, mid_y]

      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_hover, mid_x, mid_y]

      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - call: [engine.update_hover, mid_x, mid_y]

      - decl: [hit, i32, { call: [scene.child_clicked, "ok_btn"] }]
      - if:
          condition: { neq: [hit, 1] }
          then: [{ print: ["FAIL injected click did not trigger child_clicked (hit=${hit})"] }, { return: 1 }]

      # The trace must NAME the button.  Without this check it could not be told
      # above whether the button did nothing or the click never arrived.
      - decl: [trace, string, { call: [engine.prefab_last_hit] }]
      - if:
          condition: { lt: [{ call: [trace.index_of, "ClickScene[0]/ok_btn"] }, 0] }
          then: [{ print: ["FAIL hit trace does not name the button: '${trace}'"] }, { return: 1 }]

      # ── 3. a click next to it must NOT trigger ───────────────────────────
      - decl: [off_x, f32, 8.0]
      - decl: [off_y, f32, 8.0]
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, off_x, off_y]
      - call: [engine.update_hover, off_x, off_y]

      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_hover, off_x, off_y]

      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - call: [engine.update_hover, off_x, off_y]

      - decl: [miss, i32, { call: [scene.child_clicked, "ok_btn"] }]
      - if:
          condition: { neq: [miss, 0] }
          then: [{ print: ["FAIL click outside triggered the button (miss=${miss})"] }, { return: 1 }]

      # ... and the trace says "nothing hit" — an outcome of its own that can be checked.
      - decl: [trace2, string, { call: [engine.prefab_last_hit] }]
      - if:
          condition: { neq: [trace2.len, 0] }
          then: [{ print: ["FAIL click into empty space reports a hit: '${trace2}'"] }, { return: 1 }]

      # ── 4. text into the focused field ───────────────────────────────────
      - call: [scene.focus, "name_input"]
      - call: [engine.swap, win]
      - call: [input.post_text, "hallo"]
      - call: [engine.update_hover, off_x, off_y]
      - call: [engine.swap, win]
      - decl: [typed, string, { call: [scene.text_value, "name_input"] }]
      - if:
          condition: { neq: [typed, "hallo"] }
          then: [{ print: ["FAIL post_text: field contains '${typed}', expected 'hallo'"] }, { return: 1 }]

      # ── 5. Taste ─────────────────────────────────────────────────────────
      - call: [engine.swap, win]
      - call: [input.post_key_down, "lctrl"]
      - decl: [ctrl_now, i32, { call: [input.key_down, "lctrl"] }]
      - if:
          condition: { neq: [ctrl_now, 1] }
          then: [{ print: ["FAIL post_key_down: key_down(lctrl)=${ctrl_now}"] }, { return: 1 }]
      - call: [input.post_key_up, "lctrl"]
      - call: [engine.swap, win]
      - decl: [ctrl_after, i32, { call: [input.key_down, "lctrl"] }]
      - if:
          condition: { neq: [ctrl_after, 0] }
          then: [{ print: ["FAIL post_key_up: key_down(lctrl)=${ctrl_after} after release"] }, { return: 1 }]

      - call: [engine.destroy_window, win]
      - print: ["PASS input_injection_click"]
      - return: 0
