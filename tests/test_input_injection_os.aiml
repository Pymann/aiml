# SPEC: 13_cast,44_0_input
# spec/44_0 §8.5: input via the OS level (XTEST), not into our own
# process.  Counterpart to test_input_injection_click.aiml (input.post_*).
#
# The difference is the scope of the check: post_* writes our own frame state
# and checks everything FROM the application boundary up.  Here the event goes through the
# X server, the window system and only then into the application — so
# window position and delivery are involved too.
#
# Deliberately NO input.post_* in this test: otherwise it could not be told
# which channel delivered the click.
#
# Runs only where XTEST is available; otherwise the test reports that and passes
# (a Wayland machine has no XTEST — that is not a test failure).
# Requires: display
# Expected exit code: 0

- prefab:
    name: OsClickScene
    width: 400
    height: 300
    children:
      - { name: hit_btn, type: button, x: 100, y: 110, width: 200, height: 48,
          label: "OS", bg_color: 0x334455FF, color: 0xFFFFFFFF, font_size: 14 }

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [have_os, i32, { call: [input.os_available] }]
      - if:
          condition: { neq: [have_os, 1] }
          then:
            - print: ["SKIP input_injection_os — XTEST not available (Wayland? no DISPLAY?)"]
            - return: 0

      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "osclick"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]
      - call: [engine.prefab_trace_hits, 1]
      - decl: [font, ui_font, { call: [ui.load_font_default, 12.0] }]
      - if: { condition: { neq: [font, null] }, then: [{ call: [engine.prefab_set_font, font] }] }

      - decl: [scene, prefab_instance, { call: [engine.instantiate, "OsClickScene"] }]
      - call: [scene.set_pos, 0.0, 0.0]

      # A few frames, so that the window stands and has a position.
      - decl: [warm, i32, 0]
      - while:
          condition: { lt: [warm, 10] }
          body:
            - call: [engine.swap, win]
            - set: [warm, { +: [warm, 1] }]

      # Widget areas are WINDOW pixels, XTEST wants SCREEN coordinates →
      # add the window position (spec/44_0 §8.5).
      - decl: [wpos, ivec2, { call: [engine.window_pos, win] }]
      - decl: [btn_x, f32, { call: [scene.child_rect_x, "hit_btn"] }]
      - decl: [btn_y, f32, { call: [scene.child_rect_y, "hit_btn"] }]
      - decl: [btn_w, f32, { call: [scene.child_rect_w, "hit_btn"] }]
      - decl: [btn_h, f32, { call: [scene.child_rect_h, "hit_btn"] }]
      - if:
          condition: { lt: [btn_w, 1.0] }
          then: [{ print: ["FAIL child_rect_w=${btn_w}"] }, { return: 1 }]

      - decl: [mid_x, f32, { +: [btn_x, { /: [btn_w, 2.0] }] }]
      - decl: [mid_y, f32, { +: [btn_y, { /: [btn_h, 2.0] }] }]
      # Computed in f32: int→f32 is allowed, f32→int is not (spec/13), and
      # input.os_mouse_move takes floating point and converts itself.
      - decl: [scr_x, f32, { +: [{ cast: [wpos.x, f32] }, mid_x] }]
      - decl: [scr_y, f32, { +: [{ cast: [wpos.y, f32] }, mid_y] }]
      - print: ["[os] window at (${wpos.x},${wpos.y}), widget centre (${mid_x},${mid_y}) -> screen (${scr_x},${scr_y})"]

      # Set the pointer and CROSS-CHECK that it is there — otherwise a
      # later failure could not be told apart from "the movement never arrived".
      - call: [input.os_mouse_move, scr_x, scr_y]
      - call: [engine.swap, win]
      - decl: [got_xi, i32, { call: [input.os_pointer_x] }]
      - decl: [got_yi, i32, { call: [input.os_pointer_y] }]
      - decl: [got_x, f32, { cast: [got_xi, f32] }]
      - decl: [got_y, f32, { cast: [got_yi, f32] }]
      - if:
          condition: { neq: [got_x, scr_x] }
          then: [{ print: ["FAIL pointer is at x=${got_x}, expected ${scr_x}"] }, { return: 1 }]
      - if:
          condition: { neq: [got_y, scr_y] }
          then: [{ print: ["FAIL pointer is at y=${got_y}, expected ${scr_y}"] }, { return: 1 }]

      # Click via the X server.  The application receives the events via
      # glfwPollEvents in engine.swap; update_hover queries its own
      # cursor position, which follows from that.
      - decl: [tries, i32, 0]
      - decl: [clicked, i32, 0]
      - call: [input.os_mouse_down, 0]
      - while:
          condition: { '&&': [{ lt: [tries, 60] }, { eq: [clicked, 0] }] }
          body:
            - call: [engine.swap, win]
            - decl: [cur_x, f32, { call: [input.mouse_pos_x] }]
            - decl: [cur_y, f32, { call: [input.mouse_pos_y] }]
            - call: [engine.update_hover, cur_x, cur_y]
            - if:
                condition: { eq: [tries, 3] }
                then: [{ call: [input.os_mouse_up, 0] }]
            - set: [clicked, { call: [scene.child_clicked, "hit_btn"] }]
            - set: [tries, { +: [tries, 1] }]

      - if:
          condition: { neq: [clicked, 1] }
          then:
            - decl: [dbg, string, { call: [engine.prefab_last_hit] }]
            - decl: [pos_x, f32, { call: [input.mouse_pos_x] }]
            - decl: [pos_y, f32, { call: [input.mouse_pos_y] }]
            - print: ["FAIL OS click did not reach the button (trace='${dbg}', app cursor=(${pos_x},${pos_y}), frames=${tries})"]
            - return: 1

      # The trace must name the button — the proof that the resolution
      # really went through the widget and was not something else by chance.
      - decl: [trace, string, { call: [engine.prefab_last_hit] }]
      - if:
          condition: { lt: [{ call: [trace.index_of, "OsClickScene[0]/hit_btn"] }, 0] }
          then: [{ print: ["FAIL hit trace does not name the button: '${trace}'"] }, { return: 1 }]

      - call: [engine.destroy_window, win]
      - print: ["PASS input_injection_os (Spur: ${trace})"]
      - return: 0
