# SPEC: 44_0_input
# spec/44_0 §8.3a: die *_pending-Hooks auf dem DESKTOP.
#
# Die Ereignis-Schicht (pend_*) gibt es nur im Browser-Zweig; dort prueft
# tests/test_input_pending_layer_wasm.aiml die Zusicherung aus §2.3.  Nativ
# schreiben die GLFW-Rueckrufe direkt die frame-sichtbaren Slots, es gibt also
# keine zweite Schicht -- die Hooks sind hier dasselbe wie die Varianten ohne
# Zusatz.
#
# Dieser Test haelt zwei Dinge fest:
#   1. es GIBT sie nativ.  Bis 2026-11-11 fehlten sie im Desktop-Zweig ganz
#      (Android hatte Stubs), und wer sie rief, bekam erst beim LINKEN
#      `undefined reference to aiml_input_post_mouse_down_pending` -- nicht
#      beim Uebersetzen.  Ein Test, der sie aufruft, faengt genau das.
#   2. sie verhalten sich wie post_mouse_* (§8.3a, Plattform-Tabelle).
# Requires: display
# Expected exit code: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 320, 240, "pending"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [input.init, win]

      # Injiziert wird NACH dem Swap: er leert die Latches (§8.3).
      - call: [engine.swap, win]
      - call: [input.post_mouse_move_pending, 120.0, 80.0]
      - call: [input.post_mouse_down_pending, 0]

      - decl: [pos_x, f32, { call: [input.mouse_pos_x] }]
      - decl: [pos_y, f32, { call: [input.mouse_pos_y] }]
      - if:
          condition: { "||": [{ gt: [{ call: [math.abs, { "-": [pos_x, 120.0] }] }, 0.5] },
                              { gt: [{ call: [math.abs, { "-": [pos_y, 80.0] }] }, 0.5] }] }
          then: [{ print: ["FAIL move_pending: Cursor bei (${pos_x},${pos_y}), erwartet (120,80)"] }, { return: 1 }]

      - if:
          condition: { neq: [{ call: [input.mouse_pressed, 0] }, 1] }
          then: [{ print: ["FAIL down_pending: kein Druck-Rand im selben Frame (nativ = post_mouse_down)"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.mouse_button, 0] }, 1] }
          then: [{ print: ["FAIL down_pending: Taste gilt nicht als gehalten"] }, { return: 1 }]

      # Loslassen -- ebenfalls sofort sichtbar.
      - call: [input.post_mouse_up_pending, 0]
      - if:
          condition: { neq: [{ call: [input.mouse_released, 0] }, 1] }
          then: [{ print: ["FAIL up_pending: kein Loslass-Rand"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.mouse_button, 0] }, 0] }
          then: [{ print: ["FAIL up_pending: Taste gilt weiter als gehalten"] }, { return: 1 }]

      # Naechster Frame: die Raender sind weg (§8.3), der Cursor bleibt stehen.
      - call: [engine.swap, win]
      - if:
          condition: { neq: [{ call: [input.mouse_pressed, 0] }, 0] }
          then: [{ print: ["FAIL Druck-Rand ueberlebt den Frame"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.mouse_released, 0] }, 0] }
          then: [{ print: ["FAIL Loslass-Rand ueberlebt den Frame"] }, { return: 1 }]
      - decl: [bleibt_x, f32, { call: [input.mouse_pos_x] }]
      - if:
          condition: { gt: [{ call: [math.abs, { "-": [bleibt_x, 120.0] }] }, 0.5] }
          then: [{ print: ["FAIL Cursor springt nach dem Frame auf ${bleibt_x}"] }, { return: 1 }]

      - call: [engine.destroy_window, win]
      - print: ["OK input pending layer (nativ = frame-sichtbar)"]
      - return: 0
