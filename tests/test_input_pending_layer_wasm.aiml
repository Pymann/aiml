# SPEC: 44_0_input
# spec/44_0 §2.3 + §8.3a: the EVENT layer (pend_*) and its promise.
#
# What this is about: in the browser branch the event handlers do not write into the
# frame-visible slots, but into an intermediate layer that `update()` takes over at the
# start of the frame.  The handlers run between frames AND in the middle of a
# frame — every blocking network call yields to the event loop via emscripten_sleep.
# §2.3 says normatively about this: an edge created during a frame
# is KEPT and reported in the next frame.
#
# The case that matters: the user releases a dragged card,
# sees nothing happen (the frame hangs in the network call) and impatiently presses
# again.  Release and press are therefore in THE SAME gap.  If the
# press cleared the not yet delivered ended edge, the drop would be gone without replacement —
# indistinguishable from "the card cannot be dragged".  Exactly this
# bug was in bin_mousedown, bin_touchstart and in the native
# press path until 2026-10-20; it went unnoticed because the injection bypassed this layer.
#
# Second part: the kept edge alone is not enough.  If it is reported one frame
# later, the cursor is somewhere else — possibly on the new
# press point.  Whoever then resolves the drop via mouse_pos_* hits the wrong
# target, and that is worse than a lost drop.  That is why the drop carries
# its own position (drag_end_x/y), and the test moves the mouse between
# release and second press, so that both points can be told apart.
#
# Limit of this test: it drives the *_pending hooks, not the DOM handlers
# themselves (those only run in a real browser).  Both follow the same
# rule, and §8.3a fixes that in writing — but what is checked is the hook.
# Requires: wasm
#   The pend_* layer only exists in the wasm build; natively it does not exist.
#   Runs via run_wasm_tests.sh.
# Expected exit code: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - call: [input.init, null]

      # ── a press in the event layer is NOT immediately visible ────────────
      # That is the counter-probe that the pend layer really lies here and
      # not the same path as with post_mouse_down.
      - call: [input.post_mouse_move_pending, 100.0, 100.0]
      - call: [input.post_mouse_down_pending, 0]
      - if:
          condition: { neq: [{ call: [input.mouse_pressed, 0] }, 0] }
          then: [{ call: [log.error, "FAIL pend press was immediately visible — then it is the frame layer, the test would be worthless"] }, { return: 1 }]
      - call: [input.update]
      - if:
          condition: { neq: [{ call: [input.mouse_pressed, 0] }, 1] }
          then: [{ call: [log.error, "FAIL pend press was not delivered by the update"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.mouse_button, 0] }, 1] }
          then: [{ call: [log.error, "FAIL button does not count as held after the pend press"] }, { return: 1 }]

      # ── exceed the threshold → started edge, latched as well ─────────────
      # The threshold is 5 px (default), 12 px exceed it safely.
      - call: [input.post_mouse_move_pending, 100.0, 112.0]
      - if:
          condition: { neq: [{ call: [input.drag_started, 0] }, 0] }
          then: [{ call: [log.error, "FAIL started edge was immediately visible instead of latched"] }, { return: 1 }]
      - call: [input.update]
      - if:
          condition: { neq: [{ call: [input.drag_started, 0] }, 1] }
          then: [{ call: [log.error, "FAIL started edge was not delivered"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.drag_active, 0] }, 1] }
          then: [{ call: [log.error, "FAIL drag_active=0 during the drag"] }, { return: 1 }]

      # ── THE CORE: release, move, press again — all in ONE
      #    gap.  After that a single update.
      - call: [input.post_mouse_up_pending, 0]
      - call: [input.post_mouse_move_pending, 400.0, 400.0]
      - call: [input.post_mouse_down_pending, 0]
      - call: [input.update]

      - if:
          condition: { neq: [{ call: [input.drag_ended, 0] }, 1] }
          then: [{ call: [log.error, "FAIL the second press cleared the ended edge — the drop is gone without replacement (spec/44_0 §2.3)"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.drag_cancelled, 0] }, 0] }
          then: [{ call: [log.error, "FAIL release was reported as a cancel"] }, { return: 1 }]
      # The drop belongs at the release point (100/112), NOT at the new
      # press point (400/400) and not at the live cursor.
      - decl: [end_x, f32, { call: [input.drag_end_x, 0] }]
      - decl: [end_y, f32, { call: [input.drag_end_y, 0] }]
      - if:
          condition: { neq: [end_x, 100.0] }
          then: [{ call: [log.error, "FAIL drag_end_x=${end_x}, the release was at 100 — the drop would hit the wrong target"] }, { return: 1 }]
      - if:
          condition: { neq: [end_y, 112.0] }
          then: [{ call: [log.error, "FAIL drag_end_y=${end_y}, the release was at 112"] }, { return: 1 }]
      # Counter-probe: the new press has arrived as well, with ITS point.
      - if:
          condition: { neq: [{ call: [input.mouse_pressed, 0] }, 1] }
          then: [{ call: [log.error, "FAIL the second press was not delivered"] }, { return: 1 }]
      - decl: [org_x, f32, { call: [input.drag_origin_x, 0] }]
      - if:
          condition: { neq: [org_x, 400.0] }
          then: [{ call: [log.error, "FAIL drag_origin_x=${org_x}, the second press was at 400 — release and press point are not separated"] }, { return: 1 }]

      # ── the start point belongs to ITS edge, not to the last press ──────
      # The sequence that matters: press A -> drag -> release ->
      # press B, all in ONE gap.  The next frame then reports
      # started AND ended of drag A, while drag_origin_* already points to B.
      # If the pickup hangs on origin, it grabs the card at B — a move that
      # nobody started.  That is why the start point is latched with its edge
      # (spec/44_0 §2.3).
      - call: [input.post_mouse_up_pending, 0]
      - call: [input.update]

      - call: [input.post_mouse_move_pending, 10.0, 10.0]
      - call: [input.post_mouse_down_pending, 0]
      - call: [input.post_mouse_move_pending, 10.0, 30.0]
      - call: [input.post_mouse_up_pending, 0]
      - call: [input.post_mouse_move_pending, 380.0, 380.0]
      - call: [input.post_mouse_down_pending, 0]
      - call: [input.update]

      - if:
          condition: { neq: [{ call: [input.drag_started, 0] }, 1] }
          then: [{ call: [log.error, "FAIL started edge of drag A missing"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.drag_ended, 0] }, 1] }
          then: [{ call: [log.error, "FAIL ended edge of drag A missing"] }, { return: 1 }]
      - decl: [st_x, f32, { call: [input.drag_start_x, 0] }]
      - decl: [st_y, f32, { call: [input.drag_start_y, 0] }]
      - if:
          condition: { neq: [st_x, 10.0] }
          then: [{ call: [log.error, "FAIL drag_start_x=${st_x}, drag A began at 10 — the pickup would grab at the wrong point"] }, { return: 1 }]
      - if:
          condition: { neq: [st_y, 10.0] }
          then: [{ call: [log.error, "FAIL drag_start_y=${st_y}, drag A began at 10"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.drag_end_x, 0] }, 10.0] }
          then: [{ call: [log.error, "FAIL drag_end_x does not belong to the release of drag A"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [input.drag_end_y, 0] }, 30.0] }
          then: [{ call: [log.error, "FAIL drag_end_y does not belong to the release of drag A"] }, { return: 1 }]
      # Counter-probe: origin HAS moved on — otherwise the test would be worthless,
      # because start and origin would coincide by chance.
      - decl: [og_x, f32, { call: [input.drag_origin_x, 0] }]
      - if:
          condition: { neq: [og_x, 380.0] }
          then: [{ call: [log.error, "FAIL drag_origin_x=${og_x}, the second press was at 380 — start and origin are not separated, the test would be worthless"] }, { return: 1 }]

      - call: [log.info, "PASS input_pending_layer_wasm"]
      - return: 0
