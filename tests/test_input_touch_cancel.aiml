# SPEC: 44_0_input,44_6_prefabs
# spec/44_0 §2.2 "Cancel is not release" + §2.4 drag_cancelled + spec/44_6
# "Cancel: update_drag ends the drag without a drop".
#
# The bug this test nails down: a cancelled touch (touchcancel,
# second finger, focus loss) produced a NORMAL release.  So it could not be told apart from
# a deliberate release, ran into the drop detection
# "dragged before, not any more now" and triggered the drop action — in 9rooms
# a game move nobody made.
#
# Checked in this order:
#   1. the drag starts via an injected press and follows the cursor
#   2. post_touch_cancel ends it: get_dragged null, position at the origin
#   3. the edges separate the cases: cancelled=1 AND released=0
#   4. counter-probe with a real release: released=1 AND cancelled=0
#      (without 4. 3. would be worthless — then the cancel path could simply
#       swallow everything, including the real drop)
# Requires: display
# Expected exit code: 0

- prefab:
    name: CancelCard
    width: 80
    height: 100
    children:
      - { name: card_body, type: rect, x: 0, y: 0, width: 80, height: 100,
          bg_color: 0x3A5A8AFF }

- prefab:
    name: CancelTarget
    width: 120
    height: 120
    children:
      - { name: tgt_body, type: rect, x: 0, y: 0, width: 120, height: 120,
          bg_color: 0x2A2A2AFF }

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "cancel"] }]
      - if: { condition: { eq: [win, null] }, then: [{ call: [log.error, "FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]

      - decl: [tgt, prefab_instance, { call: [engine.instantiate, "CancelTarget"] }]
      - call: [tgt.set_pos, 250.0, 50.0]
      - call: [tgt.set_draggable, 0]

      - decl: [card, prefab_instance, { call: [engine.instantiate, "CancelCard"] }]
      - call: [card.set_pos, 50.0, 50.0]
      - call: [card.set_draggable, 1]
      - call: [card.set_z, 10]

      # centres: card (50,50)+40/50, target (250,50)+60/60.
      - decl: [card_mx, f32, 90.0]
      - decl: [card_my, f32, 100.0]
      - decl: [tgt_mx, f32, 310.0]
      - decl: [tgt_my, f32, 110.0]

      # Draw once first: the hit order for update_drag is established by
      # draw_scene (spec/44_6 §hit order).
      - call: [engine.draw_scene]

      # ── 1. grab + drag ───────────────────────────────────────────────────
      # Injection happens AFTER engine.swap, because swap clears the latches (§8.3).
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, card_mx, card_my]
      - call: [engine.update_drag, card_mx, card_my, { call: [input.mouse_button, 0] }, { call: [input.mouse_released, 0] }]

      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_drag, card_mx, card_my, { call: [input.mouse_button, 0] }, { call: [input.mouse_released, 0] }]

      - decl: [drg1, prefab_instance, { call: [engine.get_dragged] }]
      - if:
          condition: { peq: [drg1, null] }
          then: [{ call: [log.error, "FAIL drag did not start on the injected press"] }, { return: 1 }]

      - call: [engine.swap, win]
      - call: [input.post_mouse_move, tgt_mx, tgt_my]
      - call: [engine.update_drag, tgt_mx, tgt_my, { call: [input.mouse_button, 0] }, { call: [input.mouse_released, 0] }]

      - decl: [moved_x, f32, { call: [card.get_x] }]
      - if:
          condition: { lt: [moved_x, 100.0] }
          then: [{ call: [log.error, "FAIL card did not follow the cursor (x=${moved_x})"] }, { return: 1 }]

      # ── 2. + 3. Cancel ─────────────────────────────────────────────────
      - call: [engine.swap, win]
      - call: [input.post_touch_cancel]
      - decl: [cancelled, i32, { call: [input.mouse_cancelled, 0] }]
      - decl: [released,  i32, { call: [input.mouse_released, 0] }]
      - decl: [btn_after, i32, { call: [input.mouse_button, 0] }]
      - call: [engine.update_drag, tgt_mx, tgt_my, btn_after, released]

      - if:
          condition: { neq: [cancelled, 1] }
          then: [{ call: [log.error, "FAIL post_touch_cancel did not set the cancel edge (cancelled=${cancelled})"] }, { return: 1 }]
      # The core: a cancel is NOT a release.
      - if:
          condition: { neq: [released, 0] }
          then: [{ call: [log.error, "FAIL cancel additionally reported a release — indistinguishable from a real release, triggers a drop"] }, { return: 1 }]
      - if:
          condition: { neq: [btn_after, 0] }
          then: [{ call: [log.error, "FAIL button still counts as pressed after the cancel (btn=${btn_after})"] }, { return: 1 }]

      - decl: [drg2, prefab_instance, { call: [engine.get_dragged] }]
      - if:
          condition: { pneq: [drg2, null] }
          then: [{ call: [log.error, "FAIL drag continues after the cancel"] }, { return: 1 }]
      - decl: [back_x, f32, { call: [card.get_x] }]
      - decl: [back_y, f32, { call: [card.get_y] }]
      - if:
          condition: { '||': [{ gt: [back_x, 50.5] }, { lt: [back_x, 49.5] }] }
          then: [{ call: [log.error, "FAIL card did not return to the origin after the cancel (x=${back_x}, expected 50)"] }, { return: 1 }]
      - if:
          condition: { '||': [{ gt: [back_y, 50.5] }, { lt: [back_y, 49.5] }] }
          then: [{ call: [log.error, "FAIL card y after the cancel ${back_y}, expected 50"] }, { return: 1 }]

      # ── 4. counter-probe: a real release MUST count as a release ─────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, card_mx, card_my]
      - call: [engine.update_drag, card_mx, card_my, { call: [input.mouse_button, 0] }, { call: [input.mouse_released, 0] }]

      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_drag, card_mx, card_my, { call: [input.mouse_button, 0] }, { call: [input.mouse_released, 0] }]

      - decl: [drg3, prefab_instance, { call: [engine.get_dragged] }]
      - if:
          condition: { peq: [drg3, null] }
          then: [{ call: [log.error, "FAIL second drag did not start"] }, { return: 1 }]

      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - decl: [rel2, i32, { call: [input.mouse_released, 0] }]
      - decl: [can2, i32, { call: [input.mouse_cancelled, 0] }]
      - call: [engine.update_drag, tgt_mx, tgt_my, { call: [input.mouse_button, 0] }, rel2]

      - if:
          condition: { neq: [rel2, 1] }
          then: [{ call: [log.error, "FAIL real release reported no release (rel=${rel2})"] }, { return: 1 }]
      - if:
          condition: { neq: [can2, 0] }
          then: [{ call: [log.error, "FAIL real release additionally reported a cancel (can=${can2}) — then the cancel path would swallow real drops"] }, { return: 1 }]
      - decl: [drg4, prefab_instance, { call: [engine.get_dragged] }]
      - if:
          condition: { pneq: [drg4, null] }
          then: [{ call: [log.error, "FAIL drag continues after the release"] }, { return: 1 }]

      - call: [engine.destroy_window, win]
      - call: [log.info, "PASS input_touch_cancel"]
      - return: 0
