# An integer LITERAL on an i64 parameter of a METHOD.
#
# Regression: for free functions coerceArgs() adjusted the width, for
# methods it did not — the literal arrived as i32 at an i64 parameter, and the
# IR check failed with "Call parameter type does not match function
# signature".  In the source text the call looked perfectly right; found
# 2026-10-13 on an allocator with `lease_ms`.
# Expected exit code: 0

- class:
    name: Widener
    methods:
      - def:
          name: twice
          access: public
          args: [[value, i64]]
          return: i64
          body: [{ return: { +: [value, value] } }]
      - def:
          name: mixed
          access: public
          args: [[small, i32], [big, i64], [tag, string]]
          return: i64
          body: [{ return: { +: [big, small] } }]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [wide, ptr<Widener>, { new: Widener }]

      # literal on an i64 parameter — this is where the IR check failed.
      - decl: [doubled, i64, { call: [wide.twice, 30000] }]
      - set: [fails, { +: [fails, { call: [expect, "Literal an i64-Parameter", { eq: [doubled, 60000] }] }] }]

      # i32 variable on an i64 parameter (the sign must be preserved).
      - decl: [neg, i32, -7]
      - decl: [neg_doubled, i64, { call: [wide.twice, neg] }]
      - set: [fails, { +: [fails, { call: [expect, "negative i32 variable is widened with the correct sign", { eq: [neg_doubled, -14] }] }] }]

      # mixed, with a string after it (the order must not slip).
      - decl: [mixed_sum, i64, { call: [wide.mixed, 5, 1000000, "egal"] }]
      - set: [fails, { +: [fails, { call: [expect, "mixed widths in one call", { eq: [mixed_sum, 1000005] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_int_width_method_arg FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_int_width_method_arg PASS"]
      - return: 0
