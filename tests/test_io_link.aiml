# SPEC: 42_path_type
# spec/42: io.link(src, dst) — hard link, two names for the same content.
# The basis for content-addressed stores (cosmos doc/spec/92): take in and
# materialise without a second data block.
# Expected exit code: 0
- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [dir, string, "/tmp/aiml_io_link_test"]
      - call: [io.remove_all, dir]
      - call: [io.mkdir_all, dir]
      - decl: [src, string, "${dir}/original.txt"]
      - decl: [dst, string, "${dir}/zweiter_name.txt"]
      - decl: [fhw, file_handle, { call: [io.open, src, "wb"] }]
      - call: [io.write, fhw, "inhalt"]
      - call: [io.close, fhw]

      # link: both names point to the same content
      - decl: [rc_link, i32, { call: [io.link, src, dst] }]
      - if: { condition: { neq: [rc_link, 0] }, then: [{ print: ["FAIL link rc=${rc_link}"] }, { return: 1 }] }
      - if: { condition: { eq: [{ call: [io.is_file, dst] }, false] }, then: [{ print: ["FAIL target missing"] }, { return: 1 }] }
      - if: { condition: { neq: [{ call: [io.read_file, dst] }, "inhalt"] }, then: [{ print: ["FAIL content"] }, { return: 1 }] }
      # the same content address — it IS the same content, not a copy.
      # Do NOT compare two call results directly: eq/neq on two pointers
      # without a resolvable type falls back to pointer identity (the compiler warns).
      - decl: [hash_src, string, { call: [hash.sha256_file, src] }]
      - decl: [hash_dst, string, { call: [hash.sha256_file, dst] }]
      - if: { condition: { neq: [hash_dst, hash_src] }, then: [{ print: ["FAIL Hash ${hash_dst} != ${hash_src}"] }, { return: 1 }] }

      # delete the source: the content stays reachable via the second name
      - call: [io.remove, src]
      - if: { condition: { eq: [{ call: [io.is_file, dst] }, false] }, then: [{ print: ["FAIL after remove"] }, { return: 1 }] }
      - if: { condition: { neq: [{ call: [io.read_file, dst] }, "inhalt"] }, then: [{ print: ["FAIL content after remove"] }, { return: 1 }] }

      # existing target → -1 (the caller decides whether that is an error)
      - decl: [again, string, "${dir}/noch_einer.txt"]
      - decl: [rc_ok, i32, { call: [io.link, dst, again] }]
      - if: { condition: { neq: [rc_ok, 0] }, then: [{ print: ["FAIL second link"] }, { return: 1 }] }
      - decl: [rc_exists, i32, { call: [io.link, dst, again] }]
      - if: { condition: { eq: [rc_exists, 0] }, then: [{ print: ["FAIL an existing target should have returned -1"] }, { return: 1 }] }

      # missing source → -1, no crash
      - decl: [rc_missing, i32, { call: [io.link, "${dir}/gibts_nicht", "${dir}/egal"] }]
      - if: { condition: { eq: [rc_missing, 0] }, then: [{ print: ["FAIL missing source"] }, { return: 1 }] }

      - call: [io.remove_all, dir]
      - print: ["PASS io_link"]
      - return: 0
