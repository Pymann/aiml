# SPEC: 31_db_integration
# Acceptance test for kv.get_copy_at (spec/31 §6.7.2).  Spec-first: defines the
# target behaviour; runs green as soon as get_copy_at is implemented.
#
# get_copy_at(key, dst) deep-copies the value into a CALLER-owned, reused
# buffer — frees dst's previous heap BEFORE the refill → no per-call allocation,
# no growth on reuse.  Independent of the decoded_cache (like get_copy).
#
# Expected:
#   1. correctness: fills dst with the stored value; return 1=found, 0=missing.
#   2. refill: a repeated call into THE SAME buffer shows the new value (old content gone).
#   3. missing key → return 0, dst unchanged.
#   4. memory: 20,000 calls into ONE buffer do NOT grow (regression guard);
#      get_copy (comparison) leaks ~16 MB here.

- model:
    name: Rec
    fields:
      - [name, string]
      - [tags, list<string>]

- class:
    name: Store
    members:
      - [store, Kv<string:Rec>]
      - [work,  Rec]           # reused target buffer (allocated ONCE)
    methods:
      - def:
          name: setup
          args: [[dir, string]]
          body:
            - set: [<.store, { call: [db.open_kv, "get_copy_at_test", {persist: true, path: dir}] }]

      - def:
          name: seed
          static_off: ["same_arg"]
          args: [[key, string], [nmv, string], [ntags, i32]]
          body:
            - decl: [rec, Rec]
            - set: [rec.name, nmv]
            - decl: [tix, i32, 0]
            - while:
                condition: { lt: [tix, ntags] }
                body:
                  - call: [rec.tags.push, "tag-${nmv}-${tix}"]
                  - set: [tix, { +: [tix, 1] }]
            - call: [<.store.set, key, rec]

      # fetch_into: get_copy_at into the reused <.work buffer.
      - def:
          name: fetch_into
          args: [[key, string]]
          return: i32
          body:
            - return: { call: [<.store.get_copy_at, key, {'&': [<.work]}] }

      # write_corrupt: writes a deliberately too short blob (length prefix=1)
      # RAW via set_blob → on decode the very first field already runs past `end` (F1)
      # → aiml_ser_decode reports -1 → get_copy_at returns -1.
      - def:
          name: write_corrupt
          args: [[key, string]]
          body:
            - decl: [cbuf, buffer<u8>]
            - call: [cbuf.alloc, 8]
            - call: [cbuf.write, 1, i32]     # data_len prefix = 1 (fields run past end)
            - call: [cbuf.write, 0, i32]     # padding
            - call: [<.store.set_blob, key, cbuf]

      # probe_reuse: N calls into THE SAME buffer → RSS delta (should be ~0).
      - def:
          name: probe_reuse
          args: [[iters, i32]]
          return: i64
          body:
            - decl: [before, i64, { call: [sys.mem_usage] }]
            - decl: [rcnt, i32, 0]
            - while:
                condition: { lt: [rcnt, iters] }
                body:
                  - decl: [okr, i32, { call: [<.store.get_copy_at, "k", {'&': [<.work]}] }]
                  - set: [rcnt, { +: [rcnt, 1] }]
            - return: { -: [{ call: [sys.mem_usage] }, before] }

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - call: [io.remove_all, "/tmp/aiml_get_copy_at/"]
      - decl: [svc, ptr<Store>, { new: Store }]
      - call: [svc.setup, "/tmp/aiml_get_copy_at/"]
      - decl: [fails, i32, 0]

      # ── 1. correctness: initial fill ──────────────────────────────────────
      - call: [svc.seed, "k", "hello", 1]
      - decl: [ok1, i32, { call: [svc.fetch_into, "k"] }]
      - if: { condition: { neq: [ok1, 1] }, then: [{ print: ["FAIL 1: get_copy_at returned ${ok1} (exp 1)"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [svc.work.name, "hello"] }, then: [{ print: ["FAIL 2: work.name=${svc.work.name} (exp hello)"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [svc.work.tags.len, 1] }, then: [{ print: ["FAIL 3: work.tags.len=${svc.work.tags.len} (exp 1)"] }, { set: [fails, { +: [fails, 1] }] }] }

      # ── 2. refill into THE SAME buffer: new value, old content gone ────────
      - call: [svc.seed, "k", "world", 3]
      - decl: [ok2, i32, { call: [svc.fetch_into, "k"] }]
      - if: { condition: { neq: [svc.work.name, "world"] }, then: [{ print: ["FAIL 4: refill name=${svc.work.name} (exp world)"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [svc.work.tags.len, 3] }, then: [{ print: ["FAIL 5: refill tags.len=${svc.work.tags.len} (exp 3, old content must be gone)"] }, { set: [fails, { +: [fails, 1] }] }] }

      # ── 3. missing key → 0, buffer unchanged ──────────────────────────────
      - decl: [ok3, i32, { call: [svc.fetch_into, "does-not-exist"] }]
      - if: { condition: { neq: [ok3, 0] }, then: [{ print: ["FAIL 6: missing key returned ${ok3} (exp 0)"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [svc.work.name, "world"] }, then: [{ print: ["FAIL 7: missing key mutated buffer (name=${svc.work.name})"] }, { set: [fails, { +: [fails, 1] }] }] }

      # ── F3: korrupter/abgeschnittener Blob → -1, Puffer sicher genullt ─────
      - call: [svc.write_corrupt, "bad"]
      - decl: [okc, i32, { call: [svc.fetch_into, "bad"] }]
      - if: { condition: { neq: [okc, -1] }, then: [{ print: ["FAIL 9: corrupt blob returned ${okc} (exp -1)"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [svc.work.tags.len, 0] }, then: [{ print: ["FAIL 10: corrupt blob left non-empty buffer (tags.len=${svc.work.tags.len}, exp 0/gezeroed)"] }, { set: [fails, { +: [fails, 1] }] }] }

      # ── 4. memory regression: reuse does NOT grow ─────────────────────────
      - decl: [warm, i64, { call: [svc.probe_reuse, 2000] }]
      - decl: [delta, i64, { call: [svc.probe_reuse, 20000] }]
      - call: [log.info, "get_copy_at reuse delta over 20000 calls: ${delta} bytes (target ~0; get_copy leaked ~16 MB here)"]
      # generous bound: < 4 MB = no accumulation (get_copy: ~16 MB).
      - if: { condition: { gt: [delta, 4194304] }, then: [{ print: ["FAIL 8: reuse leaked ${delta} bytes (>4MB — get_copy_at akkumuliert)"] }, { set: [fails, { +: [fails, 1] }] }] }

      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS get_copy_at: correctness + refill + missing key + corrupt blob(-1) + no reuse leak"] }, { return: 0 }]
          else: [{ print: ["FAIL get_copy_at: ${fails} errors"] }, { return: 1 }]
