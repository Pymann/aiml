# SPEC: 31_db_integration
# Backlog-Punkt 4: `Kv<string:i32>.get` auf einen fehlenden Schluessel war ein SIGSEGV
# (gemessen rc 139). `Kv<string:string>` liefert in diesem Fall schon "" — der Zahlfall
# muss entsprechend den Nullwert liefern, nicht abstuerzen.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]
      - decl: [store, Kv<string:i32>, { call: [db.open_kv, "probe_missing_kv", { persist: false }] }]
      - call: [chk.expect_i, "fehlender Schluessel liefert 0", { call: [store.get, "fehlt"] }, 0]
      - call: [store.set, "da", 7]
      - call: [chk.expect_i, "vorhandener Schluessel unveraendert", { call: [store.get, "da"] }, 7]
      - call: [chk.expect_i, "nach dem Schreiben weiter 0 fuer andere", { call: [store.get, "immer_noch_weg"] }, 0]
      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL kv_get_missing (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS kv_get_missing_key"]
      - return: 0
