# SPEC: 31_db_integration
# Backlog item 4: `Kv<string:i32>.get` on a missing key was a SIGSEGV
# (measured rc 139). `Kv<string:string>` already returns "" in this case — the number case
# must correspondingly return the zero value, not crash.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]
      - decl: [store, Kv<string:i32>, { call: [db.open_kv, "probe_missing_kv", { persist: false }] }]
      - call: [chk.expect_i, "missing key returns 0", { call: [store.get, "fehlt"] }, 0]
      - call: [store.set, "da", 7]
      - call: [chk.expect_i, "existing key unchanged", { call: [store.get, "da"] }, 7]
      - call: [chk.expect_i, "after writing still 0 for others", { call: [store.get, "immer_noch_weg"] }, 0]
      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL kv_get_missing (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS kv_get_missing_key"]
      - return: 0
