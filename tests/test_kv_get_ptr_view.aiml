# SPEC?: 31_db_integration,18_refs_and_pointers   # derived from the file name, to be confirmed
# Regression: var_kv.get returning ptr<T> as a sync view.
#
# When the user declares `decl: [p, ptr<T>, var_kv.get(k)]`, p points directly at
# the var_kv decoded_cache slot. Mutations via p.list.push or p.field = … go
# through the pointer and write straight into the cache — so the cache stays
# internally consistent. var_kv.set(same_key, p) then encodes the (already
# canonical) cache and writes WAL.
#
# This is the cleanest pattern for "read, mutate, persist" because there is
# only ONE instance of the data; no shallow-copy/sharing problems possible.
#
# Before the var_kv.set fix in ast_compiler_call.cpp, this pattern compiled but
# wrote 8 bytes (the pointer value) instead of the struct because the
# code path for non-string typed values always spilled valVal into a temp
# alloca regardless of whether valVal was already a struct pointer.

- model:
    name: Bag
    fields:
      - [name,   string]
      - [items,  list<string>]
      - [counts, list<i32>]

- decl: [var_kv, Kv<string:Bag>, { call: [db.open_kv, "bag_ptr_view", {persist: true, path: "/tmp/aiml_test_kv_ptr_view/"}] }]

- decl: [pass, i32, 0]
- decl: [fail, i32, 0]

# ── Seed ────────────────────────────────────────────────────────────────────
- decl: [var_b1, Bag]
- set: [var_b1.name, "first"]
- call: [var_b1.items.push, "alpha"]
- call: [var_kv.set, "k", var_b1]

# ── Case A: ptr<Bag> read + write back ──────────────────────────────────────
- decl: [var_pa, ref<Bag>, { call: [var_kv.get, "k"] }]
- call: [var_pa.items.push, "beta"]
- call: [var_pa.items.push, "gamma"]
- set:  [var_pa.name, "second"]
- call: [var_kv.set, "k", var_pa]

- decl: [var_a2, Bag, { call: [var_kv.get_copy, "k"] }]
- if:
    condition: { "&&": [{ eq: [var_a2.items.len, 3] }, { eq: [var_a2.name, "second"] }] }
    then:
      - set: [pass, { "+": [pass, 1] }]
      - print: ["PASS A: ptr<Bag> mutate + set, items.len=3 name='${var_a2.name}'"]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL A: items.len=${var_a2.items.len} name='${var_a2.name}'"]

# ── Case B: ptr<Bag> with i32 list push (different element type) ────────────
- decl: [var_pb, ref<Bag>, { call: [var_kv.get, "k"] }]
- call: [var_pb.counts.push, 42]
- call: [var_pb.counts.push, 99]
- call: [var_kv.set, "k", var_pb]

- decl: [var_b2, Bag, { call: [var_kv.get_copy, "k"] }]
- if:
    condition: { eq: [var_b2.counts.len, 2] }
    then:
      - set: [pass, { "+": [pass, 1] }]
      - print: ["PASS B: ptr<Bag> i32 push + set, counts.len=2"]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL B: counts.len=${var_b2.counts.len}"]

# ── Case C: many pushes forcing realloc through ptr<Bag> ──────────────────
- decl: [var_pc, ref<Bag>, { call: [var_kv.get, "k"] }]
- call: [var_pc.items.push, "delta"]
- call: [var_pc.items.push, "epsilon"]
- call: [var_pc.items.push, "zeta"]
- call: [var_pc.items.push, "eta"]
- call: [var_pc.items.push, "theta"]
- call: [var_kv.set, "k", var_pc]

- decl: [var_c2, Bag, { call: [var_kv.get_copy, "k"] }]
- if:
    condition: { eq: [var_c2.items.len, 8] }
    then:
      - set: [pass, { "+": [pass, 1] }]
      - print: ["PASS C: ptr<Bag> 5 pushes (realloc) + set, items.len=8"]
    else:
      - set: [fail, { "+": [fail, 1] }]
      - print: ["FAIL C: items.len=${var_c2.items.len}"]

- print: ["test_kv_get_ptr_view: ${pass} passed, ${fail} failed"]
- if:
    condition: { neq: [fail, 0] }
    then: [{ call: [sys.exit, 1] }]
