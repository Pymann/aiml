# SPEC?: 31_db_integration   # derived from the file name, to be confirmed
# static-check: off
# Regression: `set: [outer.inner, { call: [kv.get_copy, key] }]` — assigning
# a kv.get_copy result DIRECTLY into a nested struct field.
#
# BUG (2026-07-10): the deep copy path for kv.get_copy (visitSetStmt) only applies
# to a top-level variable as the target, NOT to a nested
# field target (outer.inner).  Result: the heap fields of the nested
# struct (string/list/map) are garbage or 0 after the assignment.
#
# Evidence (see main):
#   V1  outer.inner = <local Inner>         → OK   (no get_copy)
#   V2  outer.inner = kv.get_copy(key)      → BUG  (heap fields corrupt)
#   V3  outer.inner.field = tmp.field (FbF) → OK   (workaround)
#
# Expectation after the fix: exit 0.  Currently: exit 1 (V2 fails).
# Backlog: doc/backlog/2026-07-10_kv_getcopy_nested_slot_assign.md

- model: { name: Inner, fields: [[name, string], [val, i32]] }
- model: { name: Outer, fields: [[tag, string], [inner, Inner]] }

- def:
    name: main
    return: i32
    body:
      - decl: [ddir, path, "/tmp/aiml_test_getcopy_nested/"]
      - call: [io.remove_all, ddir]
      - decl: [store, Kv<string:Inner>, { call: [db.open_kv, "inner", {persist: true, path: ddir}] }]
      - decl: [seed, Inner]
      - set: [seed.name, "Alpha"]
      - set: [seed.val,  42]
      - call: [store.set, "k1", seed]

      - decl: [fails, i32, 0]

      # V2: get_copy → nested slot (the buggy path).
      - decl: [outer, Outer]
      - set: [outer.tag, "T"]
      - set: [outer.inner, { call: [store.get_copy, "k1"] }]
      - if:
          condition: { neq: [outer.inner.name, "Alpha"] }
          then:
            - print: ["FAIL V2 nested-slot get_copy: inner.name='${outer.inner.name}' want 'Alpha'"]
            - set: [fails, { +: [fails, 1] }]
      - if:
          condition: { neq: [outer.inner.val, 42] }
          then:
            - print: ["FAIL V2 nested-slot get_copy: inner.val=${outer.inner.val} want 42"]
            - set: [fails, { +: [fails, 1] }]

      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS kv_getcopy_nested_slot"] }]
          else: [{ print: ["FAIL kv_getcopy_nested_slot: ${fails} (known bug — see backlog)"] }]
      - return: fails
