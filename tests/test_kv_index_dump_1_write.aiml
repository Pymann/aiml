# SPEC?: 31_db_integration   # §6.2.1 Index-Dump
# index_dump Phase 1.  Fuenf Schluessel, dann checkpoint -- dort und NUR dort
# entsteht <name>.kvidx mit dem Wasserstand.  Danach wird weiter in die WAL
# geschrieben (k5, k6) und k1 geloescht, ohne erneuten checkpoint.  Das liegt
# alles HINTER dem Wasserstand und muss Phase 2 beim Oeffnen nachspielen --
# der Tombstone eingeschlossen, sonst taucht k1 nach dem Neustart wieder auf.
# Expected exit code: 0

- call: [io.write_file, "/tmp/aiml_kvidx_20261106/.keep", ""]

- decl: [var_kv, Kv<string:string>]
- set: [var_kv, { call: [db.open_kv, "idxdump", {persist: true, index_dump: true, path: "/tmp/aiml_kvidx_20261106/"}] }]
- call: [var_kv.clear]

- decl: [var_i, i32, 0]
- while:
    condition: { "<": [var_i, 5] }
    body:
      - call: [var_kv.set, "k${var_i}", "wert_${var_i}"]
      - set: [var_i, { +: [var_i, 1] }]

- decl: [rcc, i32, { call: [db.checkpoint] }]
- print: ["checkpoint rc=${rcc}"]

# ── ab hier hinter dem Wasserstand ──────────────────────────────────────────
- call: [var_kv.set, "k5", "wert_5"]
- call: [var_kv.set, "k6", "wert_6"]
- call: [var_kv.delete, "k1"]

- decl: [anz, i32, { call: [var_kv.len] }]
- if:
    condition: { neq: [anz, 6] }
    then:
      - print: ["FAIL Phase 1: len=${anz}, expected 6"]
      - call: [sys.exit, 1]

- decl: [hat, i32, { call: [var_kv.has, "k1"] }]
- if:
    condition: { neq: [hat, 0] }
    then:
      - print: ["FAIL Phase 1: k1 nach delete noch da"]
      - call: [sys.exit, 1]

- print: ["Phase 1 ok: len=${anz}, k1 geloescht"]
