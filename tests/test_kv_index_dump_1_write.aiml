# SPEC?: 31_db_integration   # §6.2.1 index dump
# index_dump phase 1.  Five keys, then checkpoint -- there and ONLY there
# <name>.kvidx is created with the watermark.  After that writing continues into the WAL
# (k5, k6) and k1 is deleted, without another checkpoint.  All of that lies
# BEHIND the watermark and phase 2 must replay it when opening --
# the tombstone included, otherwise k1 reappears after the restart.
# Expected exit code: 0

- call: [io.write_file, "/tmp/aiml_kvidx_20261106/.keep", ""]

- decl: [var_kv, Kv<string:string>]
- set: [var_kv, { call: [db.open_kv, "idxdump", {persist: true, index_dump: true, path: "/tmp/aiml_kvidx_20261106/"}] }]
- call: [var_kv.clear]

- decl: [var_i, i32, 0]
- while:
    condition: { "<": [var_i, 5] }
    body:
      - call: [var_kv.set, "k${var_i}", "wert_${var_i}"]
      - set: [var_i, { +: [var_i, 1] }]

- decl: [rcc, i32, { call: [db.checkpoint] }]
- print: ["checkpoint rc=${rcc}"]

# ── from here on behind the watermark ──────────────────────────────────────
- call: [var_kv.set, "k5", "wert_5"]
- call: [var_kv.set, "k6", "wert_6"]
- call: [var_kv.delete, "k1"]

- decl: [anz, i32, { call: [var_kv.len] }]
- if:
    condition: { neq: [anz, 6] }
    then:
      - print: ["FAIL Phase 1: len=${anz}, expected 6"]
      - call: [sys.exit, 1]

- decl: [hat, i32, { call: [var_kv.has, "k1"] }]
- if:
    condition: { neq: [hat, 0] }
    then:
      - print: ["FAIL phase 1: k1 still there after delete"]
      - call: [sys.exit, 1]

- print: ["Phase 1 ok: len=${anz}, k1 geloescht"]
