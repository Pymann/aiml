# SPEC?: 31_db_integration   # §6.2.1 index dump
# index_dump phase 2.  Opens what phase 1 left behind: a dump with
# k0..k4 plus a WAL remainder with k5, k6 and the tombstone on k1.  Both are
# checked together -- values from the dump (binary search in the mmap), values from the
# overflow, and that the tombstone hides the dump entry.
# Expected exit code: 0

- def:
    name: pruefe
    args: [[key, string], [erw, string]]
    return: i32
    body:
      - decl: [kvh, "Kv<string:string>", { call: [db.open_kv, "idxdump", {persist: true, index_dump: true, path: "/tmp/aiml_kvidx_20261106/"}] }]
      - decl: [ist, string, { call: [kvh.get, key] }]
      - if:
          condition: { neq: [ist, erw] }
          then:
            - print: ["FAIL ${key}: '${ist}' instead of '${erw}'"]
            - return: 1
      - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [var_kv, "Kv<string:string>", { call: [db.open_kv, "idxdump", {persist: true, index_dump: true, path: "/tmp/aiml_kvidx_20261106/"}] }]

      - decl: [anz, i32, var_kv.len]
      - if:
          condition: { neq: [anz, 6] }
          then:
            - print: ["FAIL: len=${anz} after restart, expected 6"]
            - return: 1

      - decl: [bad, i32, 0]
      # from the dump
      - set: [bad, { +: [bad, { call: [pruefe, "k0", "wert_0"] }] }]
      - set: [bad, { +: [bad, { call: [pruefe, "k2", "wert_2"] }] }]
      - set: [bad, { +: [bad, { call: [pruefe, "k3", "wert_3"] }] }]
      - set: [bad, { +: [bad, { call: [pruefe, "k4", "wert_4"] }] }]
      # from the WAL remainder behind the watermark
      - set: [bad, { +: [bad, { call: [pruefe, "k5", "wert_5"] }] }]
      - set: [bad, { +: [bad, { call: [pruefe, "k6", "wert_6"] }] }]

      # the tombstone must hide the dump entry
      - decl: [hat, i32, { call: [var_kv.has, "k1"] }]
      - if:
          condition: { neq: [hat, 0] }
          then:
            - print: ["FAIL: k1 is back after the restart (tombstone lost)"]
            - set: [bad, { +: [bad, 1] }]

      - if:
          condition: { neq: [bad, 0] }
          then:
            - return: 1
      - print: ["Phase 2 ok: dump + overflow + tombstone match"]
      - return: 0
