# SPEC?: 31_db_integration   # §6.2.1 index dump, discarding an unusable dump
# Phase 3: build our own memory, checkpoint (the dump is created), then
# overwrite the .kvidx with garbage.  Phase 4 must discard it and replay fully per §6.2
# -- a broken dump must never lead to wrong data,
# at most to a slow start.
# Expected exit code: 0

- call: [io.write_file, "/tmp/aiml_kvidx_kaputt_20261106/.keep", ""]

- decl: [var_kv, Kv<string:string>]
- set: [var_kv, { call: [db.open_kv, "idxkaputt", {persist: true, index_dump: true, path: "/tmp/aiml_kvidx_kaputt_20261106/"}] }]
- call: [var_kv.clear]

- decl: [var_i, i32, 0]
- while:
    condition: { "<": [var_i, 8] }
    body:
      - call: [var_kv.set, "d${var_i}", "dwert_${var_i}"]
      - set: [var_i, { +: [var_i, 1] }]

- decl: [rcc, i32, { call: [db.checkpoint] }]
- print: ["checkpoint rc=${rcc}"]

# Destroy the dump: wrong magic, too short, unusable.
- call: [io.write_file, "/tmp/aiml_kvidx_kaputt_20261106/idxkaputt.kvidx", "MUELL"]
- print: ["Phase 3 ok: .kvidx overwritten"]
