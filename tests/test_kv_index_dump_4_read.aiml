# SPEC?: 31_db_integration   # §6.2.1 index dump, discarding an unusable dump
# Phase 4: opens the memory with the destroyed .kvidx.  Expected is
# the full replay and therefore all eight values -- not a crash and not
# a half-filled view.
# Expected exit code: 0

- def:
    name: main
    return: i32
    body:
      - decl: [var_kv, "Kv<string:string>", { call: [db.open_kv, "idxkaputt", {persist: true, index_dump: true, path: "/tmp/aiml_kvidx_kaputt_20261106/"}] }]

      - decl: [anz, i32, var_kv.len]
      - if:
          condition: { neq: [anz, 8] }
          then:
            - print: ["FAIL: len=${anz} with a broken dump, expected 8"]
            - return: 1

      - decl: [bad, i32, 0]
      - decl: [var_i, i32, 0]
      - while:
          condition: { "<": [var_i, 8] }
          body:
            - decl: [ist, string, { call: [var_kv.get, "d${var_i}"] }]
            - decl: [erw, string, "dwert_${var_i}"]
            - if:
                condition: { neq: [ist, erw] }
                then:
                  - print: ["FAIL d${var_i}: '${ist}' instead of '${erw}'"]
                  - set: [bad, { +: [bad, 1] }]
            - set: [var_i, { +: [var_i, 1] }]

      - if:
          condition: { neq: [bad, 0] }
          then:
            - return: 1
      - print: ["Phase 4 ok: broken dump discarded, all 8 values there"]
      - return: 0
