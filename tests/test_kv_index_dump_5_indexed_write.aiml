# SPEC?: 31_db_integration,45_db_indexed_fields   # §6.2.1 together with db_indexed
# Phase 5: a Kv with a db_indexed field AND index_dump, then checkpoint -- all
# entries are therefore in the dump and NOTHING in the overflow.
#
# Background: exactly this situation destroyed the secondary index.  The refill
# on open went via kv->index, and with a dump that is empty -- the index
# stayed empty, findings_by found nothing.  Measured on the cai knowledge graph: 0 instead of
# 682593 exported facts, while len and get stayed correct.  That is why
# phase 6 explicitly checks the secondary index and not just the values.
# Expected exit code: 0

- model:
    name: Werkzeug
    fields:
      - [kennung, string]
      - [name,    string, "", { db_indexed: true }]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_kvidx_indexed_20261106/"]
      - decl: [dinge, Kv<string:Werkzeug>]
      - set:  [dinge, { call: [db.open_kv, "idx_indexed", {persist: true, index_dump: true, path: db_path}] }]
      - call: [dinge.clear]

      - decl: [var_a, Werkzeug]
      - set:  [var_a.kennung, "wa"]
      - set:  [var_a.name,    "Hammer"]
      - call: [dinge.set, "wa", var_a]

      - decl: [var_b, Werkzeug]
      - set:  [var_b.kennung, "wb"]
      - set:  [var_b.name,    "Hammer"]
      - call: [dinge.set, "wb", var_b]

      - decl: [var_c, Werkzeug]
      - set:  [var_c.kennung, "wc"]
      - set:  [var_c.name,    "Saege"]
      - call: [dinge.set, "wc", var_c]

      # force everything into the dump: afterwards the overflow is empty.
      - decl: [rcc, i32, { call: [db.checkpoint] }]
      - print: ["checkpoint rc=${rcc}"]

      - decl: [vor, list<string>, { call: [dinge.findings_by, "name", "Hammer"] }]
      - if:
          condition: { neq: [vor.len, 2] }
          then:
            - print: ["FAIL phase 5: findings_by in the write run = ${vor.len}, expected 2"]
            - return: 1
      - print: ["Phase 5 ok"]
      - return: 0
