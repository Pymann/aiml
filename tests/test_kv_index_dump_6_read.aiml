# SPEC?: 31_db_integration,45_db_indexed_fields   # §6.2.1 together with db_indexed
# Phase 6: a new process on the same memory.  The secondary index is
# refilled from the main Kv when opening -- and that is entirely in the dump.
# If this test fails, the refill is running via the empty overflow again.
# Expected exit code: 0

- model:
    name: Werkzeug
    fields:
      - [kennung, string]
      - [name,    string, "", { db_indexed: true }]

- def:
    name: main
    return: i32
    body:
      - decl: [db_path, path, "/tmp/aiml_kvidx_indexed_20261106/"]
      - if:
          condition: { eq: [{ call: [db_path.exists] }, 0] }
          then:
            - print: ["SKIP Phase 6 (zuerst Phase 5 laufen lassen)"]
            - return: 0

      - decl: [dinge, Kv<string:Werkzeug>]
      - set:  [dinge, { call: [db.open_kv, "idx_indexed", {persist: true, index_dump: true, path: db_path}] }]

      - decl: [anz, i32, { call: [dinge.len] }]
      - if:
          condition: { neq: [anz, 3] }
          then:
            - print: ["FAIL: len=${anz}, expected 3"]
            - return: 1

      # The actual point: the secondary index must be refilled from the dump.
      - decl: [haemmer, list<string>, { call: [dinge.findings_by, "name", "Hammer"] }]
      - if:
          condition: { neq: [haemmer.len, 2] }
          then:
            - print: ["FAIL: findings_by Hammer = ${haemmer.len}, expected 2 (secondary index from the dump)"]
            - return: 1

      - decl: [saegen, list<string>, { call: [dinge.findings_by, "name", "Saege"] }]
      - if:
          condition: { neq: [saegen.len, 1] }
          then:
            - print: ["FAIL: findings_by Saege = ${saegen.len}, expected 1"]
            - return: 1

      # And the row itself, read from the dump.
      - decl: [var_c, Werkzeug, { call: [dinge.get_copy, "wc"] }]
      - if:
          condition: { eq: [{ eq: [var_c.name, "Saege"] }, 0] }
          then:
            - print: ["FAIL: Zeile wc.name='${var_c.name}', expected 'Saege'"]
            - return: 1

      - print: ["Phase 6 ok: secondary index and rows come from the dump"]
      - return: 0
