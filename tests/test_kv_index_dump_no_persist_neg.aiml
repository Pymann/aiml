# SPEC?: 31_db_integration   # §6.2.1: "index_dump without persist: true is an error"
# Without a WAL there are no offsets a dump could point to.  That must
# be noticed and not silently ignored -- otherwise the caller believes he
# has the gain and keeps paying for the full build.
# Expected exit code: 1

- decl: [var_kv, Kv<string:string>]
- set: [var_kv, { call: [db.open_kv, "idxnopersist", {persist: false, index_dump: true}] }]
- print: ["FAIL: index_dump without persist was accepted"]
