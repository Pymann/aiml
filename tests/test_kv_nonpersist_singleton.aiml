# SPEC?: 31_db_integration   # derived from the file name, to be confirmed
# tests/test_kv_nonpersist_singleton.aiml — repro: db.open_kv non-persistent singleton by name
#
# Tests: db.open_kv("name", {persist: false}) returns the same instance for the same
# name (singleton), even if it is opened from different functions.
#
# Before the fix: aiml_db_kv_open ignored the name parameter and returned a
# new empty KV every time → var_kv.get in function B did not find the key → null deref → SIGSEGV.

# ─── Hilfsfunktionen ──────────────────────────────────────────────────────────

- def:
    name: kv_writer
    args: [[kv_name, string], [key, string], [val, i32]]
    static_off: ["same_arg"]
    return: void
    body:
      - decl: [var_kv, "Kv<string:i32>", { call: [db.open_kv, kv_name, {persist: false}] }]
      - call: [var_kv.set, key, val]

- def:
    name: kv_reader
    args: [[kv_name, string], [key, string]]
    static_off: ["same_arg"]
    return: i32
    body:
      - decl: [var_kv, "Kv<string:i32>", { call: [db.open_kv, kv_name, {persist: false}] }]
      - return: [{ call: [var_kv.get, key] }]

- def:
    name: kv_writer_str
    args: [[kv_name, string], [key, string], [val, string]]
    static_off: ["same_arg"]
    return: void
    body:
      - decl: [var_kv, "Kv<string:string>", { call: [db.open_kv, kv_name, {persist: false}] }]
      - call: [var_kv.set, key, val]

- def:
    name: kv_reader_str
    args: [[kv_name, string], [key, string]]
    static_off: ["same_arg"]
    return: string
    body:
      - decl: [var_kv, "Kv<string:string>", { call: [db.open_kv, kv_name, {persist: false}] }]
      - return: [{ call: [var_kv.get, key] }]

# ─── Haupt-Test ───────────────────────────────────────────────────────────────

- def:
    name: main
    args: []
    return: i32
    body:
      # T1: Kv<string:i32> — writer in function A, reader in function B
      - call: [kv_writer, "test_kv_i32", "answer", 42]
      - decl: [var_v, i32, { call: [kv_reader, "test_kv_i32", "answer"] }]
      - if:
          condition: { neq: [var_v, 42] }
          then:
            - print: ["FAIL T1: expected 42, got ${var_v}"]
            - call: [sys.exit, 1]
      - print: ["T1 PASS: Kv<string:i32> singleton-by-name (cross-function)"]

      # T2: Kv<string:string> — same name, different functions
      - call: [kv_writer_str, "test_kv_str", "greeting", "hello"]
      - decl: [var_s, string, { call: [kv_reader_str, "test_kv_str", "greeting"] }]
      - if:
          condition: { neq: [var_s, "hello"] }
          then:
            - print: ["FAIL T2: expected hello, got ${var_s}"]
            - call: [sys.exit, 1]
      - print: ["T2 PASS: Kv<string:string> singleton-by-name (cross-function)"]

      # T3: several keys in the same KV (write in a function, read directly)
      - call: [kv_writer, "test_kv_multi", "var_n", 10]
      - call: [kv_writer, "test_kv_multi", "var_x", 99]
      - decl: [var_n, i32, { call: [kv_reader, "test_kv_multi", "var_n"] }]
      - decl: [var_x, i32, { call: [kv_reader, "test_kv_multi", "var_x"] }]
      - if:
          condition: { neq: [var_n, 10] }
          then:
            - print: ["FAIL T3a: var_n=${var_n}, expected 10"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_x, 99] }
          then:
            - print: ["FAIL T3b: var_x=${var_x}, expected 99"]
            - call: [sys.exit, 1]
      - print: ["T3 PASS: Kv<string:i32> multiple keys singleton"]

      # T4: two different KV names are isolated from each other
      - call: [kv_writer, "kv_alpha", "val", 1]
      - call: [kv_writer, "kv_beta",  "val", 2]
      - decl: [var_a, i32, { call: [kv_reader, "kv_alpha", "val"] }]
      - decl: [var_b, i32, { call: [kv_reader, "kv_beta",  "val"] }]
      - if:
          condition: { neq: [var_a, 1] }
          then:
            - print: ["FAIL T4a: kv_alpha.val=${var_a}, expected 1"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [var_b, 2] }
          then:
            - print: ["FAIL T4b: kv_beta.val=${var_b}, expected 2"]
            - call: [sys.exit, 1]
      - print: ["T4 PASS: two different KV names are isolated"]

      # T5: spawn — the worker writes, main reads from the same non-persistent KV
      - decl: [var_tw, thread_handle,
               { spawn: [kv_writer, "test_kv_thread", "from_worker", 777] }]
      - call: [var_tw.join]
      - decl: [var_tv, i32, { call: [kv_reader, "test_kv_thread", "from_worker"] }]
      - if:
          condition: { neq: [var_tv, 777] }
          then:
            - print: ["FAIL T5: thread-written value=${var_tv}, expected 777"]
            - call: [sys.exit, 1]
      - print: ["T5 PASS: non-persist KV singleton visible across threads"]

      - print: ["test_kv_nonpersist_singleton PASS"]
      - return: [0]
