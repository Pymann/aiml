# SPEC?: 45_db_indexed_fields   # persistence -- kv.clear deletes the dumps
# Phase 5: phase 4 left a fresh dump behind.  `clear` must delete the
# .kvsidx files; if one were left behind, it would repopulate the emptied store
# at the next open.
# Expected exit code: 0

- model:
    name: Ding
    fields:
      - [ding_id, string]
      - [name, string, "", { db_indexed: true }]
      - [sku,  string, "", { db_indexed: true, unique: true }]
      - [tag,  string, "", { db_indexed: "lower" }]

- def:
    name: main
    return: i32
    body:
      - decl: [pfad, path, "/tmp/aiml_kvsidx_20261107/"]
      - decl: [dinge, "Kv<string:Ding>"]
      - set: [dinge, { call: [db.open_kv, "sidx_dinge", {persist: true, index_dump: true, path: pfad}] }]

      # The dump from phase 4 must hold, otherwise this run checks nothing.
      - decl: [vor, list<string>, { call: [dinge.findings_by, "name", "Hammer"] }]
      - if:
          condition: { neq: [vor.len, 3] }
          then:
            - print: ["FAIL clear: starting point Hammer=${vor.len}, expected 3"]
            - return: 1

      - call: [dinge.clear]

      - decl: [anz, i32, { call: [dinge.len] }]
      - if:
          condition: { neq: [anz, 0] }
          then:
            - print: ["FAIL clear: len=${anz} after clear, expected 0"]
            - return: 1
      - decl: [nach, list<string>, { call: [dinge.findings_by, "name", "Hammer"] }]
      - if:
          condition: { neq: [nach.len, 0] }
          then:
            - print: ["FAIL clear: Hammer=${nach.len} after clear, expected 0"]
            - return: 1
      - decl: [sku_eins, string, { call: [dinge.finding_by, "sku", "S1"] }]
      - if:
          condition: { neq: [sku_eins.len, 0] }
          then:
            - print: ["FAIL clear: sku=S1 still lives as '${sku_eins}'"]
            - return: 1

      - print: ["sidx clear PASS"]
      - return: 0
