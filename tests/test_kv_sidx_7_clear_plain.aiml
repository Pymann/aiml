# SPEC?: 45_db_indexed_fields   # persistence -- clear also cleans the indexes
# An emptied store must not deliver any hits any more.  That applies equally WITHOUT
# index_dump: the secondary indexes hang on the store pointer and survived
# `clear` -- the query afterwards returned keys that no longer existed.
# This run needs no dump and no checkpoint.
# Expected exit code: 0

- model:
    name: Ding
    fields:
      - [ding_id, string]
      - [name, string, "", { db_indexed: true }]

- def:
    name: main
    return: i32
    body:
      - decl: [pfad, path, "/tmp/aiml_kvsidx_plain_20261107/"]
      - decl: [dinge, "Kv<string:Ding>"]
      - set: [dinge, { call: [db.open_kv, "sidx_plain", {persist: true, path: pfad}] }]
      - call: [dinge.clear]

      - decl: [eins, Ding]
      - set: [eins.ding_id, "aaa"]
      - set: [eins.name, "Hammer"]
      - call: [dinge.set, "aaa", eins]
      - decl: [zwei, Ding]
      - set: [zwei.ding_id, "bbb"]
      - set: [zwei.name, "Hammer"]
      - call: [dinge.set, "bbb", zwei]

      - decl: [tr_vor, list<string>, { call: [dinge.findings_by, "name", "Hammer"] }]
      - if:
          condition: { neq: [tr_vor.len, 2] }
          then:
            - print: ["FAIL clear_plain: before clear ${tr_vor.len} hits, expected 2"]
            - return: 1

      - call: [dinge.clear]

      - decl: [anzahl, i32, dinge.len]
      - if:
          condition: { neq: [anzahl, 0] }
          then:
            - print: ["FAIL clear_plain: len=${anzahl} after clear, expected 0"]
            - return: 1
      - decl: [tr_nach, list<string>, { call: [dinge.findings_by, "name", "Hammer"] }]
      - if:
          condition: { neq: [tr_nach.len, 0] }
          then:
            - print: ["FAIL clear_plain: ${tr_nach.len} hits after clear, expected 0 -- the secondary index survived clear"]
            - return: 1

      - print: ["sidx clear_plain PASS"]
      - return: 0
