# Test: Kv<string:i32> — scalar integer values in Kv store

- decl: [pass, i32, 0]
- decl: [fail, i32, 0]

- decl: [kv, "Kv<string:i32>"]
- set: [kv, { call: [db.open_kv, "test_kv_i32"] }]

# put + get
- call: [kv.set, "alpha", 42]
- call: [kv.set, "beta", 99]
- call: [kv.set, "zero", 0]

- decl: [v1, i32]
- set: [v1, { call: [kv.get, "alpha"] }]
- if:
    condition: { eq: [v1, 42] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL get alpha=${v1}"] }]

- decl: [v2, i32]
- set: [v2, { call: [kv.get, "beta"] }]
- if:
    condition: { eq: [v2, 99] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL get beta=${v2}"] }]

- decl: [v3, i32]
- set: [v3, { call: [kv.get, "zero"] }]
- if:
    condition: { eq: [v3, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL get zero=${v3}"] }]

# has
- decl: [h1, i32]
- set: [h1, { call: [kv.has, "alpha"] }]
- if:
    condition: { eq: [h1, 1] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL has alpha"] }]

- decl: [h2, i32]
- set: [h2, { call: [kv.has, "missing"] }]
- if:
    condition: { eq: [h2, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL has missing"] }]

# overwrite
- call: [kv.set, "alpha", 7]
- decl: [v4, i32]
- set: [v4, { call: [kv.get, "alpha"] }]
- if:
    condition: { eq: [v4, 7] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL overwrite alpha=${v4}"] }]

# delete
- call: [kv.delete, "beta"]
- decl: [h3, i32]
- set: [h3, { call: [kv.has, "beta"] }]
- if:
    condition: { eq: [h3, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL delete beta"] }]

# result
- print: ["kv_string_i32: ${pass} passed, ${fail} failed"]
- if:
    condition: { eq: [fail, 0] }
    then: [{ call: [sys.exit, 0] }]
    else: [{ call: [sys.exit, 1] }]
