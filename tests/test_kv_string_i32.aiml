# Test: Kv<string:i32> — scalar integer values in Kv store

- decl: [pass, i32, 0]
- decl: [fail, i32, 0]

- decl: [var_kv, "Kv<string:i32>"]
- set: [var_kv, { call: [db.open_kv, "test_kv_i32"] }]

# put + get
- call: [var_kv.set, "alpha", 42]
- call: [var_kv.set, "beta", 99]
- call: [var_kv.set, "zero", 0]

- decl: [var_v1, i32]
- set: [var_v1, { call: [var_kv.get, "alpha"] }]
- if:
    condition: { eq: [var_v1, 42] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL get alpha=${var_v1}"] }]

- decl: [var_v2, i32]
- set: [var_v2, { call: [var_kv.get, "beta"] }]
- if:
    condition: { eq: [var_v2, 99] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL get beta=${var_v2}"] }]

- decl: [var_v3, i32]
- set: [var_v3, { call: [var_kv.get, "zero"] }]
- if:
    condition: { eq: [var_v3, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL get zero=${var_v3}"] }]

# has
- decl: [var_h1, i32]
- set: [var_h1, { call: [var_kv.has, "alpha"] }]
- if:
    condition: { eq: [var_h1, 1] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL has alpha"] }]

- decl: [var_h2, i32]
- set: [var_h2, { call: [var_kv.has, "missing"] }]
- if:
    condition: { eq: [var_h2, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL has missing"] }]

# overwrite
- call: [var_kv.set, "alpha", 7]
- decl: [var_v4, i32]
- set: [var_v4, { call: [var_kv.get, "alpha"] }]
- if:
    condition: { eq: [var_v4, 7] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL overwrite alpha=${var_v4}"] }]

# delete
- call: [var_kv.delete, "beta"]
- decl: [var_h3, i32]
- set: [var_h3, { call: [var_kv.has, "beta"] }]
- if:
    condition: { eq: [var_h3, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL delete beta"] }]

# result
- print: ["kv_string_i32: ${pass} passed, ${fail} failed"]
- if:
    condition: { eq: [fail, 0] }
    then: [{ call: [sys.exit, 0] }]
    else: [{ call: [sys.exit, 1] }]
