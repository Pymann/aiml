# SPEC: 29_2_sys_exec,29_serialize
# spec/29_2 §15: sys.lib_load — compile a library ONCE.
#
# The first version of this test measured nothing: a library of ONE
# function (`return 7`) costs no noticeable code generation, so
# lib_load and merge were equally fast.  Here the library is big enough
# that its bodies carry weight — only then is the claim
# "compile once instead of every time" testable at all.
# Expected exit code: 0

- def:
    name: lib_calc_1
    static_off: ["same_arg"]
    args: [[val, i32]]
    return: i32
    body:
      - decl: [acc, i32, val]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, 8] }
          body:
            - set: [acc, { +: [{ '*': [acc, 3] }, { -: [idx, 1] }] }]
            - set: [acc, { -: [acc, { /: [acc, 7] }] }]
            - set: [idx, { +: [idx, 1] }]
      - return: acc

