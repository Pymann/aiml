      - return: acc

- def:
    name: lib_answer
    return: i32
    body:
      - decl: [sum, i32, { call: [lib_calc_1, 1] }]
      - set: [sum, { +: [sum, { call: [lib_calc_30, 2] }] }]
      - set: [sum, { +: [sum, { call: [lib_calc_60, 3] }] }]
      - if: { condition: { neq: [sum, sum] }, then: [{ return: 0 }] }
      - return: 7

- def:
    name: pipe_one
    return: i32
    body:
      - decl: [got, i32, { call: [lib_answer] }]
      - if: { condition: { neq: [got, 7] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: pipe_two
    return: i32
    body:
      - decl: [got, i32, { call: [lib_answer] }]
      - if: { condition: { neq: [got, 7] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]

      # Bundle the library (lib_answer pulls the 60 lib_calc_* along transitively).
      - decl: [lib, Code, { call: [sys.bundle, "lib_answer"] }]
      - decl: [lib_bytes, i64, { call: [lib.size] }]
      - print: ["library: ${lib_bytes} bytes of source text"]

      - decl: [dump, string, { call: [lib.toString] }]
      - print: ["--- Bundle-Anfang ---"]
      - print: [dump]
      - print: ["--- Bundle-Ende ---"]
      - decl: [has_c1, i32, { call: [lib.contains, "lib_calc_1"] }]
      - decl: [has_c30, i32, { call: [lib.contains, "lib_calc_30"] }]
      - print: ["Bundle enthaelt lib_calc_1=${has_c1} lib_calc_30=${has_c30}"]
      - decl: [nsym, i32, { call: [sys.lib_load, lib] }]
      - print: ["lib_load registrierte ${nsym} Symbole"]
      - set: [fails, { +: [fails, { call: [expect, "lib_load registers more than one function", { gt: [nsym, 1] }] }] }]

      # Route A: pipeline WITHOUT the library in the bundle (uses the loaded one).
      - decl: [one, Code, { call: [sys.bundle, "pipe_one", { context: true }] }]
      - decl: [t_a, i64, { call: [time.mono_ms] }]
      - decl: [rc_a, i32, { call: [sys.exec, one] }]
      - decl: [ms_a, i64, { -: [{ call: [time.mono_ms] }, t_a] }]
      - print: ["A) lib_load route: rc=${rc_a} in ${ms_a} ms"]
      - set: [fails, { +: [fails, { call: [expect, "A laeuft", { eq: [rc_a, 0] }] }] }]

      # Route B: the same pipeline WITH the library bundled along (§14).
      - decl: [two, Code, { call: [sys.bundle, "pipe_two", { context: true }] }]
      - decl: [merged, Code, { call: [two.merge, lib] }]
      - decl: [t_b, i64, { call: [time.mono_ms] }]
      - decl: [rc_b, i32, { call: [sys.exec, merged] }]
      - decl: [ms_b, i64, { -: [{ call: [time.mono_ms] }, t_b] }]
      - print: ["B) merge route:    rc=${rc_b} in ${ms_b} ms"]
      - set: [fails, { +: [fails, { call: [expect, "B laeuft", { eq: [rc_b, 0] }] }] }]

      - print: ["difference: ${ms_b} ms (merge) against ${ms_a} ms (lib_load)"]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_lib_load FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_lib_load PASS"]
      - return: 0
