- print: ["Testing Dynamic Lists..."]
- decl: [lst, list<i32>]
- call: [lst.push, 100]
- call: [lst.push, 200]
- idx: [lst, 0, 150]
- print: ["lst-0 = ${ { at: [lst, 0] } }"]
- print: ["lst-1 = ${ { at: [lst, 1] } }"]
- print: ["Size before pop: ${lst.len}"]
- call: [lst.pop]
- print: ["Popped element. New size: ${lst.len}"]
- print: ["lst-0 after pop: ${ { at: [lst, 0] } }"]

- print: ["Testing Insert..."]
- call: [lst.insert, 0, 999]
- print: ["Inserted 999 at 0. Size: ${lst.len}"]
- print: ["lst-0 = ${ { at: [lst, 0] } }"]
- print: ["lst-1 = ${ { at: [lst, 1] } }"]

- print: ["Testing Remove..."]
- call: [lst.remove, 0]
- print: ["Removed at 0. Size: ${lst.len}"]
- print: ["lst-0 = ${ { at: [lst, 0] } }"]

- print: ["Testing Clear/Empty..."]
- print: ["Is Empty? ${lst.empty}"]
- call: [lst.clear]
- print: ["Cleared. Size: ${lst.len}"]
- print: ["Is Empty? ${lst.empty}"]

- call: [sys.exit, 0]
