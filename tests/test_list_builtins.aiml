# SPEC?: 10_collections   # aus dem Dateinamen, zu bestaetigen
# test_list_builtins — contains/index_of/count/extend/remove_value (M1)
# + reverse/sort/sort_desc/shuffle (M2).  Bei erster Abweichung: print + exit 1.

- def:
    name: check
    args: [[label, string], [got, i32], [want, i32]]
    body:
      - if:
          condition: { neq: [got, want] }
          then:
            - print: ["FAIL ${label}: got ${got} want ${want}"]
            - call: [sys.exit, 1]

- def:
    name: main
    return: i32
    body:
      # ── M1: contains / index_of / count (list<i32>) ──
      - decl: [nums, list<i32>]
      - call: [nums.push, 10]
      - call: [nums.push, 20]
      - call: [nums.push, 30]
      - call: [nums.push, 20]
      - call: [check, "contains_start", { call: [nums.contains, 10] }, 1]
      - call: [check, "contains_mid",   { call: [nums.contains, 30] }, 1]
      - call: [check, "contains_miss",  { call: [nums.contains, 99] }, 0]
      - call: [check, "index_of_first", { call: [nums.index_of, 20] }, 1]
      - call: [check, "index_of_miss",  { call: [nums.index_of, 99] }, -1]
      - call: [check, "count_dup",      { call: [nums.count, 20] }, 2]
      - call: [check, "count_zero",     { call: [nums.count, 99] }, 0]

      # ── leere Liste ──
      - decl: [emp, list<i32>]
      - call: [check, "empty_contains", { call: [emp.contains, 1] }, 0]
      - call: [check, "empty_index_of", { call: [emp.index_of, 1] }, -1]
      - call: [check, "empty_count",    { call: [emp.count, 1] }, 0]

      # ── remove_value (nur erster Treffer) ──
      - call: [check, "rmv_hit",  { call: [nums.remove_value, 20] }, 1]
      - call: [check, "rmv_len",  nums.len, 3]
      - call: [check, "rmv_left", { call: [nums.count, 20] }, 1]     # ein 20 bleibt
      - call: [check, "rmv_miss", { call: [nums.remove_value, 99] }, 0]

      # ── string contains: Inhaltsgleichheit mit getrennt gebautem String ──
      - decl: [strs, list<string>]
      - call: [strs.push, "alpha"]
      - call: [strs.push, "beta"]
      - decl: [part, string, "al"]
      - decl: [needle, string, "${part}pha"]      # eigener Pointer, gleicher Inhalt
      - call: [check, "str_contains", { call: [strs.contains, needle] }, 1]
      - call: [check, "str_index",    { call: [strs.index_of, "beta"] }, 1]
      - call: [check, "str_miss",     { call: [strs.contains, "gamma"] }, 0]

      # ── extend: Reihenfolge + Quelle unverändert + realloc + self.extend(self) ──
      - decl: [dst, list<i32>]
      - call: [dst.push, 1]
      - decl: [src, list<i32>]
      - call: [src.push, 2]
      - call: [src.push, 3]
      - call: [dst.extend, src]
      - call: [check, "ext_len",  dst.len, 3]
      - call: [check, "ext_0", { at: [dst, 0] }, 1]
      - call: [check, "ext_1", { at: [dst, 1] }, 2]
      - call: [check, "ext_2", { at: [dst, 2] }, 3]
      - call: [check, "ext_src_unchanged", src.len, 2]
      # realloc: über Kapazität (>4) hinaus anhängen
      - decl: [big, list<i32>]
      - decl: [bidx, i32, 0]
      - while:
          condition: { lt: [bidx, 10] }
          body:
            - call: [big.push, bidx]
            - set: [bidx, { +: [bidx, 1] }]
      - decl: [grow, list<i32>]
      - call: [grow.extend, big]
      - call: [check, "ext_realloc_len", grow.len, 10]
      - call: [check, "ext_realloc_9", { at: [grow, 9] }, 9]
      # self.extend(self) verdoppelt die ursprüngliche Folge
      - decl: [self_e, list<i32>]
      - call: [self_e.push, 7]
      - call: [self_e.push, 8]
      - call: [self_e.extend, self_e]
      - call: [check, "self_len", self_e.len, 4]
      - call: [check, "self_0", { at: [self_e, 0] }, 7]
      - call: [check, "self_1", { at: [self_e, 1] }, 8]
      - call: [check, "self_2", { at: [self_e, 2] }, 7]
      - call: [check, "self_3", { at: [self_e, 3] }, 8]

      # ── M2: reverse ──
      - decl: [rv0, list<i32>]
      - call: [rv0.reverse]                        # 0 Elemente: kein Crash
      - call: [check, "rev0_len", rv0.len, 0]
      - decl: [rv1, list<i32>]
      - call: [rv1.push, 5]
      - call: [rv1.reverse]                        # 1 Element
      - call: [check, "rev1_0", { at: [rv1, 0] }, 5]
      - decl: [rvn, list<i32>]
      - call: [rvn.push, 1]
      - call: [rvn.push, 2]
      - call: [rvn.push, 3]
      - call: [rvn.push, 4]
      - call: [rvn.reverse]
      - call: [check, "revn_0", { at: [rvn, 0] }, 4]
      - call: [check, "revn_3", { at: [rvn, 3] }, 1]

      # ── sort / sort_desc (int) ──
      - decl: [sint, list<i32>]
      - call: [sint.push, 3]
      - call: [sint.push, 1]
      - call: [sint.push, 2]
      - call: [sint.push, 1]
      - call: [sint.sort]
      - call: [check, "sort_0", { at: [sint, 0] }, 1]
      - call: [check, "sort_1", { at: [sint, 1] }, 1]
      - call: [check, "sort_2", { at: [sint, 2] }, 2]
      - call: [check, "sort_3", { at: [sint, 3] }, 3]
      - call: [sint.sort_desc]
      - call: [check, "sortd_0", { at: [sint, 0] }, 3]
      - call: [check, "sortd_3", { at: [sint, 3] }, 1]

      # ── sort (string, lexikographisch) ──
      - decl: [sstr, list<string>]
      - call: [sstr.push, "banana"]
      - call: [sstr.push, "apple"]
      - call: [sstr.push, "cherry"]
      - call: [sstr.sort]
      - decl: [str0, string, { at: [sstr, 0] }]
      - if: { condition: { neq: [str0, "apple"] }, then: [{ print: ["FAIL sort_str_0: ${str0}"] }, { call: [sys.exit, 1] }] }
      - decl: [str2, string, { at: [sstr, 2] }]
      - if: { condition: { neq: [str2, "cherry"] }, then: [{ print: ["FAIL sort_str_2: ${str2}"] }, { call: [sys.exit, 1] }] }

      # ── shuffle: Länge + Multimenge erhalten, kein Crash bei 0/1 ──
      - decl: [sh0, list<i32>]
      - call: [sh0.shuffle]
      - call: [check, "shuf0_len", sh0.len, 0]
      - decl: [shuf, list<i32>]
      - decl: [shidx, i32, 0]
      - while:
          condition: { lt: [shidx, 6] }
          body:
            - call: [shuf.push, shidx]
            - set: [shidx, { +: [shidx, 1] }]
      - call: [shuf.shuffle]
      - call: [check, "shuf_len", shuf.len, 6]
      # Multimenge: jeder Wert 0..5 genau einmal vorhanden
      - decl: [shcnt, i32, 0]
      - while:
          condition: { lt: [shcnt, 6] }
          body:
            - call: [check, "shuf_multiset", { call: [shuf.contains, shcnt] }, 1]
            - call: [check, "shuf_count1",   { call: [shuf.count, shcnt] }, 1]
            - set: [shcnt, { +: [shcnt, 1] }]

      - print: ["PASS test_list_builtins"]
      - return: 0
