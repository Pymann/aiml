# Repro: heap-allocated class instances do not auto-initialize list<T> members yet.
# Expected exit code after the future fix: 0

- class:
    name: ListBox
    members:
      - [var_xs, list<i32>]

- decl: [box, ref<ListBox>, { new: ListBox }]

- call: [box.var_xs.push, 10]
- call: [box.var_xs.push, 20]

- decl: [var_n, i32, box.var_xs.len]
- if:
    condition: { neq: [var_n, 2] }
    then:
      - print: ["FAIL list class-member len: expected 2, got ${var_n}"]
      - exit: [1]

- free: [box]
- print: ["PASS test_list_class_member_heap_init_repro"]
