# SPEC?: 10_collections   # derived from the file name, to be confirmed
# A list<i32>/list<f64>/list<string> declared with a literal list keeps every element (negatives included), in a function
# and in a class method; `at` reads back the declared values.
# Expected exit code: 0
- class:
    name: Holder
    members:
      - [glyphs, list<i32>]
    methods:
      - def:
          name: init
          access: public
          body:
            - decl: [font, list<i32>, [31599, 11415, 29671]]
            - set: [<.glyphs, font]
      - def:
          name: ring
          access: public
          args: [[cur, i32]]
          return: i32
          body:
            - decl: [ring_x, list<i32>, [0, 1, 1, 1, 0, -1, -1, -1]]
            - return: { at: [ring_x, cur] }

- def:
    name: main
    return: i32
    body:
      - decl: [vals, list<i32>, [0, 1, 1, 1, 0, -1, -1, -1]]
      - if: { condition: { neq: [vals.len, 8] }, then: [{ call: [io.write, io.stderr, "FAIL len ${vals.len}"] }, { return: 1 }] }
      - if: { condition: { neq: [{ at: [vals, 2] }, 1] }, then: [{ call: [io.write, io.stderr, "FAIL vals[2] ${{ at: [vals, 2] }}"] }, { return: 1 }] }
      - if: { condition: { neq: [{ at: [vals, 5] }, -1] }, then: [{ call: [io.write, io.stderr, "FAIL vals[5]"] }, { return: 1 }] }
      - decl: [reals, list<f64>, [1, 2.5, -3]]
      - decl: [want_real, f64, -3]
      - if: { condition: { neq: [{ at: [reals, 2] }, want_real] }, then: [{ call: [io.write, io.stderr, "FAIL reals[2]"] }, { return: 1 }] }
      - decl: [kinds, list<string>, ["beast", "wraith", "construct"]]
      - if: { condition: { neq: [kinds.len, 3] }, then: [{ call: [io.write, io.stderr, "FAIL kinds len"] }, { return: 1 }] }
      - decl: [middle, string, { at: [kinds, 1] }]
      - if: { condition: { neq: [{ call: [middle.index_of, "wraith"] }, 0] }, then: [{ call: [io.write, io.stderr, "FAIL kinds[1] ${middle}"] }, { return: 1 }] }
      - decl: [holder, Holder]
      - call: [holder.init]
      - if: { condition: { neq: [{ at: [holder.glyphs, 1] }, 11415] }, then: [{ call: [io.write, io.stderr, "FAIL glyphs[1] ${{ at: [holder.glyphs, 1] }}"] }, { return: 1 }] }
      - if: { condition: { neq: [{ call: [holder.ring, 3] }, 1] }, then: [{ call: [io.write, io.stderr, "FAIL ring[3] ${{ call: [holder.ring, 3] }}"] }, { return: 1 }] }
      - if: { condition: { neq: [{ call: [holder.ring, 7] }, -1] }, then: [{ call: [io.write, io.stderr, "FAIL ring[7] ${{ call: [holder.ring, 7] }}"] }, { return: 1 }] }
      - return: 0
