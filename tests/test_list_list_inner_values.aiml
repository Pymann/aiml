# SPEC?: 10_collections   # derived from the file name, to be confirmed
# Test: list<list<i32>> inner values preserved through JSON deserialize and WAL var_kv
# Expected exit code: 0

- model:
    name: Ability
    fields:
      - [cost_text, string]
      - [activation_cost, list<list<i32>>]
      - [trigger, list<list<i32>>]
      - [effects, list<list<i32>>]

- def:
    name: main
    return: i32
    body:
      # Phase A: JSON deserialize → check inner values immediately
      - decl: [var_j1, string, '{"__type":"Ability","cost_text":"Tap","activation_cost":[[6]],"trigger":[],"effects":[[10,3]]}']
      - decl: [var_ab, Ability]
      - set: [var_ab, { call: [sys.deserialize, var_j1, "Ability"] }]

      - if:
          condition: { neq: [var_ab.activation_cost.len, 1] }
          then:
            - print: ["FAIL A1: activation_cost.len=${var_ab.activation_cost.len} expected 1"]
            - call: [sys.exit, 1]

      - decl: [var_cb, list<i32>]
      - set: [var_cb, { at: [var_ab.activation_cost, 0] }]
      - if:
          condition: { neq: [var_cb.len, 1] }
          then:
            - print: ["FAIL A2: var_cb.len=${var_cb.len} expected 1"]
            - call: [sys.exit, 1]

      - decl: [var_v0, i32, { at: [var_cb, 0] }]
      - if:
          condition: { neq: [var_v0, 6] }
          then:
            - print: ["FAIL A3: var_cb[0]=${var_v0} expected 6"]
            - call: [sys.exit, 1]

      - if:
          condition: { neq: [var_ab.effects.len, 1] }
          then:
            - print: ["FAIL A4: effects.len=${var_ab.effects.len} expected 1"]
            - call: [sys.exit, 1]

      - decl: [eff0, list<i32>]
      - set: [eff0, { at: [var_ab.effects, 0] }]
      - if:
          condition: { neq: [eff0.len, 2] }
          then:
            - print: ["FAIL A5: eff0.len=${eff0.len} expected 2"]
            - call: [sys.exit, 1]

      - decl: [var_e0, i32, { at: [eff0, 0] }]
      - if:
          condition: { neq: [var_e0, 10] }
          then:
            - print: ["FAIL A6: eff0[0]=${var_e0} expected 10"]
            - call: [sys.exit, 1]

      - print: ["Phase A PASS"]

      # Phase B: JSON deserialize → WAL var_kv.set → var_kv.get → check inner values
      - decl: [db_dir, path, "/tmp/aiml_test_list_list_inner_values/"]
      - call: [io.remove_all, db_dir]

      - decl: [var_kv, Kv<string:Ability>]
      - set: [var_kv, { call: [db.open_kv, "inner_values", {persist: true, path: db_dir}] }]
      - call: [var_kv.set, "ab1", var_ab]

      - decl: [got, ref<Ability>]
      - set: [got, { call: [var_kv.get, "ab1"] }]
      - if:
          condition: { eq: [got, null] }
          then:
            - print: ["FAIL B1: got=null"]
            - call: [sys.exit, 1]

      - if:
          condition: { neq: [got.activation_cost.len, 1] }
          then:
            - print: ["FAIL B2: got.activation_cost.len=${got.activation_cost.len} expected 1"]
            - call: [sys.exit, 1]

      - decl: [gcb, list<i32>]
      - set: [gcb, { at: [got.activation_cost, 0] }]
      - if:
          condition: { neq: [gcb.len, 1] }
          then:
            - print: ["FAIL B3: gcb.len=${gcb.len} expected 1 (inner list empty after WAL roundtrip)"]
            - call: [sys.exit, 1]

      - decl: [gv0, i32, { at: [gcb, 0] }]
      - if:
          condition: { neq: [gv0, 6] }
          then:
            - print: ["FAIL B4: gcb[0]=${gv0} expected 6"]
            - call: [sys.exit, 1]

      - if:
          condition: { neq: [got.effects.len, 1] }
          then:
            - print: ["FAIL B5: got.effects.len=${got.effects.len} expected 1"]
            - call: [sys.exit, 1]

      - decl: [geff0, list<i32>]
      - set: [geff0, { at: [got.effects, 0] }]
      - if:
          condition: { neq: [geff0.len, 2] }
          then:
            - print: ["FAIL B6: geff0.len=${geff0.len} expected 2"]
            - call: [sys.exit, 1]

      - decl: [ge0, i32, { at: [geff0, 0] }]
      - if:
          condition: { neq: [ge0, 10] }
          then:
            - print: ["FAIL B7: geff0[0]=${ge0} expected 10"]
            - call: [sys.exit, 1]

      - print: ["Phase B PASS"]
      - call: [db.checkpoint]
      - print: ["ALL PASS"]
      - return: 0
