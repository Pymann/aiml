# Test: list<list<Struct>> serialize and deserialize via JSON
# Expected exit code: 0

- model:
    name: Point
    fields:
      - [var_x, i32]
      - [var_y, i32]

- model:
    name: Shape
    fields:
      - [name, string]
      - [segments, list<list<Point>>]

- def:
    name: main
    return: i32
    body:
      # Build Shape with two segments: [[{1,2},{3,4}], [{5,6}]]
      - decl: [var_sh, Shape]
      - set: [var_sh.name, "poly"]

      - decl: [seg0, list<Point>]
      - decl: [var_p0, Point]
      - set: [var_p0.var_x, 1]
      - set: [var_p0.var_y, 2]
      - call: [seg0.push, var_p0]
      - decl: [var_p1, Point]
      - set: [var_p1.var_x, 3]
      - set: [var_p1.var_y, 4]
      - call: [seg0.push, var_p1]
      - call: [var_sh.segments.push, seg0]

      - decl: [seg1, list<Point>]
      - decl: [var_p2, Point]
      - set: [var_p2.var_x, 5]
      - set: [var_p2.var_y, 6]
      - call: [seg1.push, var_p2]
      - call: [var_sh.segments.push, seg1]

      # Serialize → JSON
      - decl: [json, string, { call: [sys.serialize, var_sh, "Shape"] }]
      - print: ["serialized=${json}"]

      # Deserialize back
      - decl: [sh2, Shape]
      - set: [sh2, { call: [sys.deserialize, json, "Shape"] }]

      - if:
          condition: { neq: [sh2.name, "poly"] }
          then:
            - print: ["FAIL name=${sh2.name}"]
            - call: [sys.exit, 1]

      - if:
          condition: { neq: [sh2.segments.len, 2] }
          then:
            - print: ["FAIL segments.len=${sh2.segments.len}"]
            - call: [sys.exit, 1]

      - decl: [gs0, list<Point>, { call: [sh2.segments.get, 0] }]
      - if:
          condition: { neq: [gs0.len, 2] }
          then:
            - print: ["FAIL gs0.len=${gs0.len}"]
            - call: [sys.exit, 1]

      - decl: [gp0, ref<Point>, { call: [gs0.get, 0] }]
      - if:
          condition: { neq: [gp0.var_x, 1] }
          then:
            - print: ["FAIL gp0.var_x=${gp0.var_x}"]
            - call: [sys.exit, 1]
      - if:
          condition: { neq: [gp0.var_y, 2] }
          then:
            - print: ["FAIL gp0.var_y=${gp0.var_y}"]
            - call: [sys.exit, 1]

      - decl: [gp1, ref<Point>, { call: [gs0.get, 1] }]
      - if:
          condition: { neq: [gp1.var_x, 3] }
          then:
            - print: ["FAIL gp1.var_x=${gp1.var_x}"]
            - call: [sys.exit, 1]

      - decl: [gs1, list<Point>, { call: [sh2.segments.get, 1] }]
      - if:
          condition: { neq: [gs1.len, 1] }
          then:
            - print: ["FAIL gs1.len=${gs1.len}"]
            - call: [sys.exit, 1]

      - decl: [gp2, ref<Point>, { call: [gs1.get, 0] }]
      - if:
          condition: { neq: [gp2.var_x, 5] }
          then:
            - print: ["FAIL gp2.var_x=${gp2.var_x}"]
            - call: [sys.exit, 1]

      - print: ["list<list<Struct>> PASS"]
      - return: 0
