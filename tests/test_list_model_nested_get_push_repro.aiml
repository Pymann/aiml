# SPEC?: 15_models   # derived from the file name, to be confirmed
# static-check: off
# Origin: 9rooms_v2 BoardScreen.cp_tick, crash after "Zwingende Böe": a nested
# `list<Model>.get()` (a pointer) pushed into a value list<Model> stored pointer bytes as
# the model.  spec/71 retired `get(i)` on sequences; `{ at: [l, i] }` reads the element.
# Pushed into a VALUE list it is a value copy; pushed into a list<ptr<M>> it is the
# element's address.  Both must hold, and the value copy must not alias the source.
# Expected exit code: 0

- model:
    name: ReproCard
    fields:
      - [marker, i32]
      - [title, string]

- def:
    name: main
    return: i32
    body:
      - decl: [original, ReproCard]
      - set: [original.marker, -1]
      - set: [original.title, "Probe Card"]
      - decl: [source_cards, list<ReproCard>]
      - call: [source_cards.push, original]

      # Control 1: materialize a model VALUE, then push it.
      - decl: [copied_cards, list<ReproCard>]
      - decl: [value_copy, ReproCard, { at: [source_cards, 0] }]
      - call: [copied_cards.push, value_copy]
      - decl: [control, ref<ReproCard>, { at: [copied_cards, 0] }]
      - if:
          condition: { '||': [{ neq: [control.marker, -1] }, { neq: [control.title, "Probe Card"] }] }
          then:
            - print: ["FAIL control: explicit model value copy"]
            - return: 2
      - print: ["PASS control: explicit model value copy"]

      # Control 2: pushed into a list of borrows, the element is its address (spec/61 §5.4).
      - decl: [pointer_cards, list<ref<ReproCard>>]
      - call: [pointer_cards.push, { at: [source_cards, 0] }]
      - decl: [pointer_card, ref<ReproCard>, { at: [pointer_cards, 0] }]
      - if:
          condition: { neq: [pointer_card.marker, -1] }
          then:
            - print: ["FAIL control: nested get into pointer list"]
            - return: 2
      - print: ["PASS control: nested get into pointer list"]

      # Former reproduction: pushed into a VALUE list, the element is copied.
      - decl: [broken_cards, list<ReproCard>]
      - call: [broken_cards.push, { at: [source_cards, 0] }]
      - decl: [broken, ref<ReproCard>, { at: [broken_cards, 0] }]
      - if:
          condition: { neq: [broken.marker, -1] }
          then:
            - print: ["FAIL nested get/push: model marker was replaced by pointer bytes"]
            - return: 1
      - print: ["PASS nested at/push: a value copy in a value list, an address in a pointer list"]
      - return: 0
