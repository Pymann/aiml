# SPEC?: 15_models,09_strings   # derived from the file name, to be confirmed
# Repro extension 3: the string comes from an INTERPOLATION (not a literal).
# Hypothesis: interpolated strings are temporary and are not deep-copied
# into the model.

- model:
    name: FakeDeck
    fields:
      - [name, string]
      - [tag,  i32]

- class:
    name: Holder
    members:
      - [decks, list<FakeDeck>]
    methods:
      - def:
          name: add
          args: [[nam, string]]
          body:
            - decl: [fdk, FakeDeck]
            # Instead of a direct assign: use interpolation to produce a "new" string.
            - decl: [nam_i, string, "${nam}"]
            - set: [fdk.name, nam_i]
            - set: [fdk.tag,  1]
            - call: [<.decks.push, fdk]

      - def:
          name: read_name
          args: [[idx, i32]]
          return: string
          body:
            - decl: [fdk, FakeDeck, { at: [<.decks, idx] }]
            - return: fdk.name

- def:
    name: main
    return: i32
    body:
      - decl: [hld, ptr<Holder>, { new: Holder }]
      # the string comes from a local decl (not a direct literal)
      - decl: [local, string, "hhh"]
      - call: [hld.add, local]
      - decl: [nam, string, { call: [hld.read_name, 0] }]
      - print: ["decks[0].name='${nam}'"]
      - if:
          condition: { eq: [nam, "hhh"] }
          then: [{ print: ["PASS"] }, { return: 0 }]
          else: [{ print: ["FAIL got='${nam}'"] }, { return: 1 }]
