# SPEC: 61_memory_management
# Several VIEW ALIASES onto elements of the same list, one after another in a
# loop — and afterwards the elements are read again.
#
# spec/61 §6.3: `decl: [x, Model, { at: [liste, i] }]` is an ALIAS onto the
# element, not a copy.  Cheap for pure reading — but only if discarding
# the alias does NOT free the element's inner memory.  If it did,
# the list would be damaged after the loop, and the next read access
# would run into freed memory.
#
# Occasion: the WASM client crashed in a function that has exactly this pattern
# (one alias held across the loop, further aliases in the loop).
# Natively something like this silently falls through; WASM checks bounds.
# Expected exit code: 0

- model:
    name: Row
    fields:
      - [name,  string]
      - [note,  string]
      - [count, i32]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [rows, list<Row>]
      - decl: [fill, i32, 0]
      - while:
          condition: { lt: [fill, 6] }
          body:
            - decl: [fresh, Row]
            - set: [fresh.name, "zeile-${fill}"]
            - set: [fresh.note, "eine laengere Bemerkung, damit der Heap wirklich benutzt wird ${fill}"]
            - set: [fresh.count, fill]
            - call: [rows.push, fresh]
            - set: [fill, { +: [fill, 1] }]

      # ONE alias that is held across the loop.
      - decl: [held, Row, { at: [rows, 2] }]
      - set: [fails, { +: [fails, { call: [expect, "held alias reads before the loop", { eq: [held.name, "zeile-2"] }] }] }]

      # The loop creates a further alias for EVERY element and
      # discards it at the end of the loop — also for element 2.
      - decl: [joined, string, ""]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, rows.len] }
          body:
            - decl: [cur, Row, { at: [rows, idx] }]
            - set: [joined, "${joined}${cur.name}:${cur.count} "]
            - set: [idx, { +: [idx, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "die Schleife liest alle sechs", { gt: [joined.len, 40] }] }] }]

      # AFTERWARDS: the held alias must still be valid.
      - set: [fails, { +: [fails, { call: [expect, "held alias reads AFTER the loop", { eq: [held.name, "zeile-2"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "its second string field too", { gt: [held.note.len, 20] }] }] }]

      # And the list itself is undamaged.
      - decl: [again, Row, { at: [rows, 2] }]
      - set: [fails, { +: [fails, { call: [expect, "erneutes Lesen desselben Elements", { eq: [again.name, "zeile-2"] }] }] }]
      - decl: [last, Row, { at: [rows, 5] }]
      - set: [fails, { +: [fails, { call: [expect, "and the last element", { eq: [last.count, 5] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_list_model_view_alias_loop FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_list_model_view_alias_loop PASS"]
      - return: 0
