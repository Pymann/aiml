# test_list_prefab_instance.aiml — verifies that list<prefab_instance>
# can be declared, pushed to, and read back. Discovered during datacreatures
# DnD work that `decl: [x, list<prefab_instance>]` reliably traps in wasm
# at module init ("unreachable executed"). This test isolates the question.

- prefab:
    name: Dummy
    width: 10
    height: 10
    children:
      - { name: r_rect, type: rect, x: 0, y: 0, width: 10, height: 10,
          bg_color: 0xFFFFFFFF }

- print: ["[test] before list decl"]

- decl: [tiles, list<prefab_instance>]

- print: ["[test] list<prefab_instance> declared, len=${tiles.len}"]

- decl: [var_a, prefab_instance, { call: [engine.instantiate, "Dummy"] }]
- decl: [var_b, prefab_instance, { call: [engine.instantiate, "Dummy"] }]

- print: ["[test] two instances spawned var_a=${var_a} var_b=${var_b}"]

- call: [tiles.push, var_a]
- call: [tiles.push, var_b]

- print: ["[test] after pushes, len=${tiles.len}"]

- decl: [var_t0, prefab_instance, { at: [tiles, 0] }]
- decl: [var_t1, prefab_instance, { at: [tiles, 1] }]

- print: ["[test] read back: var_t0==var_a? ${ { eq: [var_t0, var_a] } } var_t1==var_b? ${ { eq: [var_t1, var_b] } }"]
- print: ["[test] cross-check: var_t0==var_b? ${ { eq: [var_t0, var_b] } } var_t1==var_a? ${ { eq: [var_t1, var_a] } } (must be false)"]
- print: ["[test] direct: var_a==var_b? ${ { eq: [var_a, var_b] } } (must be false)"]
- print: ["[test] direct neq: var_a!=var_b? ${ { neq: [var_a, var_b] } } (must be true)"]
- print: ["[test] OK"]
