# SPEC: 01_primitive_types
# spec/01/§5.4: list.slice(start, end) — dash-free replacement for the deprecated `lst-a-b` slice
# notation. start inclusive, end exclusive; end optional → to len; negative end counts from the end.
# Shallow copy into a fresh heap handle. Deterministic; expected exit 0.

- def:
    name: check
    args: [[got, i32], [want, i32], [tag, string]]
    return: i32
    body:
      - if:
          condition: { neq: [got, want] }
          then:
            - print: ["FAIL ${tag}: got=${got} want=${want}"]
            - call: [sys.exit, 1]
      - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [lst, list<i32>]
      - call: [lst.push, 10]
      - call: [lst.push, 20]
      - call: [lst.push, 30]
      - call: [lst.push, 40]
      - call: [lst.push, 50]

      # slice(1, 4) → [20, 30, 40]
      - decl: [sl_a, list<i32>, { call: [lst.slice, 1, 4] }]
      - call: [check, sl_a.len, 3, "sl_a.len"]
      - call: [check, { at: [sl_a, 0] }, 20, "sl_a[0]"]
      - call: [check, { at: [sl_a, 2] }, 40, "sl_a[2]"]

      # slice(2) → to end → [30, 40, 50]
      - decl: [sl_b, list<i32>, { call: [lst.slice, 2] }]
      - call: [check, sl_b.len, 3, "sl_b.len"]
      - call: [check, { at: [sl_b, 0] }, 30, "sl_b[0]"]

      # slice(0, 3) → first three → [10, 20, 30]
      - decl: [sl_c, list<i32>, { call: [lst.slice, 0, 3] }]
      - call: [check, sl_c.len, 3, "sl_c.len"]
      - call: [check, { at: [sl_c, 2] }, 30, "sl_c[2]"]

      # source unchanged (slice is a copy)
      - call: [check, lst.len, 5, "lst.len"]

      - print: ["list.slice method PASS"]
      - return: 0
