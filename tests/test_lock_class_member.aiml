# SPEC: 26_concurrency, 47_thread_safety (§2 Shared User State)
# Test: `lock` as a class member — the basis for shard locks (several
# independent locks in one object, not one global bottleneck).
#   - a lock can be declared and initialised as a member
#   - two threads that take the same member lock count exactly (no race)
#   - two DIFFERENT member locks are independent (each protects its field)
# Expected exit code: 0

- class:
    name: ShardCounter
    members:
      - [lock_one, lock]
      - [lock_two, lock]
      - [hits_one, i32]
      - [hits_two, i32]
    methods:
      - def:
          name: prepare
          body:
            - call: [<.lock_one.init]
            - call: [<.lock_two.init]
            - set: [<.hits_one, 0]
            - set: [<.hits_two, 0]
      - def:
          name: bump_one
          args: [[times, i32]]
          body:
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, times] }
                body:
                  - call: [<.lock_one.acquire]
                  - set: [<.hits_one, { +: [<.hits_one, 1] }]
                  - call: [<.lock_one.release]
                  - set: [idx, { +: [idx, 1] }]
      - def:
          name: bump_two
          args: [[times, i32]]
          body:
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, times] }
                body:
                  - call: [<.lock_two.acquire]
                  - set: [<.hits_two, { +: [<.hits_two, 1] }]
                  - call: [<.lock_two.release]
                  - set: [idx, { +: [idx, 1] }]

- def:
    name: run_one
    args: [[box, ref<ShardCounter>], [times, i32]]
    return: void
    body:
      - call: [box.bump_one, times]

- def:
    name: run_two
    args: [[box, ref<ShardCounter>], [times, i32]]
    return: void
    body:
      - call: [box.bump_two, times]

- def:
    name: main
    return: i32
    body:
      - decl: [box, ptr<ShardCounter>, { new: ShardCounter }]
      - call: [box.prepare]
      - decl: [reps, i32, 50000]

      # two threads on THE SAME lock (lock_one) + one on lock_two.
      - decl: [th_a, thread_handle, { spawn: [run_one, box, reps] }]
      - decl: [th_b, thread_handle, { spawn: [run_one, box, reps] }]
      - decl: [th_c, thread_handle, { spawn: [run_two, box, reps] }]
      - call: [th_a.join]
      - call: [th_b.join]
      - call: [th_c.join]

      - decl: [fails, i32, 0]
      - decl: [want_one, i32, { '*': [reps, 2] }]
      - if:
          condition: { neq: [box.hits_one, want_one] }
          then:
            - print: ["FAIL lock_one does not protect: ${box.hits_one} instead of ${want_one} (race)"]
            - set: [fails, { +: [fails, 1] }]
      - if:
          condition: { neq: [box.hits_two, reps] }
          then:
            - print: ["FAIL lock_two: ${box.hits_two} instead of ${reps}"]
            - set: [fails, { +: [fails, 1] }]

      - free: [box]
      - if:
          condition: { eq: [fails, 0] }
          then:
            - print: ["PASS test_lock_class_member: ${want_one} + ${reps} increments without loss, two independent member locks"]
            - return: 0
      - print: ["FAIL test_lock_class_member: ${fails} errors"]
      - return: 1
