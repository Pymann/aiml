# SPEC: 26_concurrency — repro narrowing: `lock` as a class member, but via
# a NAMED receiver (box.lock_one.init) instead of via the self reference
# (<.lock_one.init).  Separates the two member access paths in the compiler.
# Expected exit code: 0

- class:
    name: LockBox
    members:
      - [lock_one, lock]
      - [hits, i32]

- def:
    name: main
    return: i32
    body:
      - decl: [box, ptr<LockBox>, { new: LockBox }]
      - call: [box.lock_one.init]
      - call: [box.lock_one.acquire]
      - set: [box.hits, { +: [box.hits, 1] }]
      - call: [box.lock_one.release]
      - if:
          condition: { neq: [box.hits, 1] }
          then:
            - print: ["FAIL hits=${box.hits}"]
            - return: 1
      - print: ["PASS test_lock_member_extern: box.lock_one.init/acquire/release"]
      - return: 0
