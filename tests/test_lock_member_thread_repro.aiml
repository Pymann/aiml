# SPEC: 26_concurrency — Repro-Stufen: wo genau stirbt ein Klassen-Member-Lock?
#   Stufe 1: direkter Aufruf ohne Thread
#   Stufe 2: EIN spawn-Thread (ptr<Class> + i32 als Argumente)
#   Stufe 3: zwei Threads auf denselben Member-Lock
# Expected exit code: 0

- class:
    name: Tally
    members:
      - [guard, lock]
      - [hits, i32]
    methods:
      - def:
          name: prepare
          body:
            - call: [<.guard.init]
            - set: [<.hits, 0]
      - def:
          name: bump
          args: [[times, i32]]
          body:
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, times] }
                body:
                  - call: [<.guard.acquire]
                  - set: [<.hits, { +: [<.hits, 1] }]
                  - call: [<.guard.release]
                  - set: [idx, { +: [idx, 1] }]

- def:
    name: run_bump
    args: [[box, ref<Tally>], [times, i32]]
    return: void
    body:
      - call: [box.bump, times]

- def:
    name: main
    return: i32
    body:
      - decl: [box, ptr<Tally>, { new: Tally }]
      - call: [box.prepare]
      - print: ["stage0 prepare ok"]

      - call: [box.bump, 10]
      - print: ["stage1 direkt: hits=${box.hits}"]

      - decl: [th_one, thread_handle, { spawn: [run_bump, box, 10] }]
      - call: [th_one.join]
      - print: ["stage2 ein Thread: hits=${box.hits}"]

      - decl: [th_a, thread_handle, { spawn: [run_bump, box, 1000] }]
      - decl: [th_b, thread_handle, { spawn: [run_bump, box, 1000] }]
      - call: [th_a.join]
      - call: [th_b.join]
      - print: ["stage3 zwei Threads: hits=${box.hits}"]

      - if:
          condition: { neq: [box.hits, 2020] }
          then:
            - print: ["FAIL hits=${box.hits} statt 2020"]
            - return: 1
      - print: ["PASS test_lock_member_thread_repro"]
      - return: 0
