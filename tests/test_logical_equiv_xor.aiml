# SPEC?: 46_log   # derived from the file name, to be confirmed
- def:
    name: main
    return: i32
    body:
      - decl: [var_t, bool, true]
      - decl: [var_f, bool, false]

      # equiv truth table
      - decl: [e_tt, bool, { equiv: [var_t, var_t] }]
      - decl: [e_tf, bool, { equiv: [var_t, var_f] }]
      - decl: [e_ft, bool, { equiv: [var_f, var_t] }]
      - decl: [e_ff, bool, { equiv: [var_f, var_f] }]
      - if: [{ neq: [e_tt, 1] }, true]
        then: [{ return: 1 }]
      - if: [{ neq: [e_tf, 0] }, true]
        then: [{ return: 2 }]
      - if: [{ neq: [e_ft, 0] }, true]
        then: [{ return: 3 }]
      - if: [{ neq: [e_ff, 1] }, true]
        then: [{ return: 4 }]

      # xor truth table
      - decl: [x_tt, bool, { xor: [var_t, var_t] }]
      - decl: [x_tf, bool, { xor: [var_t, var_f] }]
      - decl: [x_ft, bool, { xor: [var_f, var_t] }]
      - decl: [x_ff, bool, { xor: [var_f, var_f] }]
      - if: [{ neq: [x_tt, 0] }, true]
        then: [{ return: 5 }]
      - if: [{ neq: [x_tf, 1] }, true]
        then: [{ return: 6 }]
      - if: [{ neq: [x_ft, 1] }, true]
        then: [{ return: 7 }]
      - if: [{ neq: [x_ff, 0] }, true]
        then: [{ return: 8 }]

      # not alias
      - decl: [var_nt, bool, { not: [var_t] }]
      - decl: [var_nf, bool, { not: [var_f] }]
      - if: [{ neq: [var_nt, 0] }, true]
        then: [{ return: 9 }]
      - if: [{ neq: [var_nf, 1] }, true]
        then: [{ return: 10 }]

      # equiv/xor with i32 coercion
      - decl: [var_a, i32, 5]
      - decl: [var_b, i32, 0]
      - decl: [ec1, bool, { equiv: [var_a, var_a] }]
      - decl: [ec2, bool, { equiv: [var_a, var_b] }]
      - decl: [xc1, bool, { xor: [var_a, var_b] }]
      - if: [{ neq: [ec1, 1] }, true]
        then: [{ return: 11 }]
      - if: [{ neq: [ec2, 0] }, true]
        then: [{ return: 12 }]
      - if: [{ neq: [xc1, 1] }, true]
        then: [{ return: 13 }]

      - return: 0
