- decl: [scores, map<string:i32>]
- print: ["Testing Maps..."]
- call: [scores.set, "Alice", 100]
- call: [scores.set, "Bob", 200]

- print: ['Alice Score: ${ { call: [scores.get, "Alice"] } }']
- print: ['Bob Score: ${ { call: [scores.get, "Bob"] } }']

- print: ["Size before remove: ${scores.len}"] 

- call: [scores.delete, "Alice"]
- print: ["Size after remove: ${scores.len}"]

- print: ['Has Alice? ${ { call: [scores.has, "Alice"] } }']
- print: ['Has Bob? ${ { call: [scores.has, "Bob"] } }']

- print: ["Math Test: 10 + 20 = ${ { +: [10, 20] } }"]

- call: [sys.exit, 0]
