# SPEC: 18_instantiation,18_refs_and_pointers
# Repro candidate: heap-allocated class instances may fail to auto-initialize map<K:V> members.
# Expected exit code after the future fix: 0

- class:
    name: MapBox
    members:
      - [scores, "map<string:i32>"]

- decl: [box, ptr<MapBox>, { new: MapBox }]   # spec/18: `new` -> ptr<T>

- call: [box.scores.set, "alice", 7]
- call: [box.scores.set, "bob", 9]

- decl: [var_n, i32, box.scores.len]
- if:
    condition: { neq: [var_n, 2] }
    then:
      - print: ["FAIL map class-member len: expected 2, got ${var_n}"]
      - call: [sys.exit, 1]

- decl: [alice, i32, { call: [box.scores.get, "alice"] }]
- if:
    condition: { neq: [alice, 7] }
    then:
      - print: ["FAIL map class-member get: expected 7, got ${alice}"]
      - call: [sys.exit, 1]

- free: [box]
- print: ["PASS test_map_class_member_heap_init_repro"]
