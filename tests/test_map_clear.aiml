# SPEC: 10_collections
# Backlog item 8: `map<K:V>` had no `clear` ("Unknown map method: clear"), `hashmap`
# did. Caught up now.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]
      - decl: [tbl, map<string:i32>]
      - call: [tbl.put, "eins", 1]
      - call: [tbl.put, "zwei", 2]
      - call: [chk.expect_i, "before clear", tbl.len, 2]
      - call: [tbl.clear]
      - call: [chk.expect_i, "empty after clear", tbl.len, 0]
      - call: [tbl.put, "neu", 3]
      - call: [chk.expect_i, "usable again after clear", tbl.len, 1]
      - call: [chk.expect_i, "and the value is right", { call: [tbl.get, "neu"] }, 3]
      - call: [tbl.clear]
      - call: [chk.expect_i, "clear on an empty map is harmless", tbl.len, 0]
      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL map_clear (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS map_clear"]
      - return: 0
