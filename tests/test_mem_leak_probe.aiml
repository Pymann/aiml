# SPEC?: 61_memory_management   # derived from the file name, to be confirmed
# Memory leak probe: every probe method runs a primitive N times in a loop
# and returns the RSS delta (sys.mem_usage, bytes).  If a primitive leaks, the
# delta grows ~linearly with N → the 2N measurement is then ~twice as large as the N measurement.
# If both stay ~flat (the allocator recycles), the primitive is clean.
#
# Motivated by the 9rooms server leak (~13 MB/30s): the scheduler calls per tick
# match_get → matches.get_copy (deep copy of a MatchSession).  Probe A models exactly
# that; B–G are comparison/control cases.
#
# Parametrisation (memory lifetime plan §8.1 — probes ISOLATED in their own processes):
#   AIML_MEM_PROBE = A|B|C|D|E|F|G|all   (default all)
#   AIML_MEM_ITERS = <N>                 (default 20000; N and 2N are measured)
# For a clean attribution always start ONE probe per process, e.g.
#   AIML_MEM_PROBE=A AIML_MEM_ITERS=20000 aiml -r tests/test_mem_leak_probe.aiml

- model:
    name: Rec
    fields:
      - [name,  string]
      - [tags,  list<string>]
      - [nums,  list<i32>]

- class:
    name: Store
    members:
      - [store, Kv<string:Rec>]
    methods:
      - def:
          name: setup
          args: [[dir, string]]
          body:
            - set: [<.store, { call: [db.open_kv, "mem_leak_probe", {persist: true, path: dir}] }]
            # An entry with noticeable heap (string + two lists).
            - decl: [rec, Rec]
            - set: [rec.name, "some reasonably long value for the heap"]
            - decl: [sidx, i32, 0]
            - while:
                condition: { lt: [sidx, 16] }
                body:
                  - call: [rec.tags.push, "tag-entry-${sidx}"]
                  - call: [rec.nums.push, sidx]
                  - set: [sidx, { +: [sidx, 1] }]
            - call: [<.store.set, "k", rec]

      # Probe A: get_copy deep copy per iteration, the local goes out of scope at the end of the iteration.
      - def:
          name: probe_get_copy
          args: [[iters, i32]]
          return: i64
          body:
            - decl: [before, i64, { call: [sys.mem_usage] }]
            - decl: [acnt, i32, 0]
            - while:
                condition: { lt: [acnt, iters] }
                body:
                  - decl: [mrec, Rec, { call: [<.store.get_copy, "k"] }]
                  - set: [acnt, { +: [acnt, 1] }]
            - return: { -: [{ call: [sys.mem_usage] }, before] }

      # Probe C: kv.set of the same key per iteration (scheduler write-back path).
      # NOTE (2026-09-09): the RSS delta this reports is an ALLOCATOR/WAL-ring ARTIFACT,
      # not a true heap leak.  valgrind definite-lost is identical at 100 and 900 iters
      # (~20.9 KB, all compiler/JIT one-time), i.e. it does NOT scale — the kv.set path is
      # clean (blob freed, decoded_cache evicted, the get_copy mrec dropped).  glibc simply
      # does not return freed memory to the OS (arena growth) + the 16 MB WAL ring touches
      # pages as it fills.  Track true leaks with valgrind, not this RSS number.
      # IMPORTANT (§8.1): CONSTANT payload — REPLACE an existing scalar element,
      # do not append per iteration (otherwise the record itself grows and the measurement
      # is useless/a test artefact).
      - def:
          name: probe_set
          args: [[iters, i32]]
          return: i64
          body:
            - decl: [before, i64, { call: [sys.mem_usage] }]
            - decl: [ccnt, i32, 0]
            - while:
                condition: { lt: [ccnt, iters] }
                body:
                  - decl: [mrec, Rec, { call: [<.store.get_copy, "k"] }]
                  - idx: [mrec.nums, 0, ccnt]        # replace a scalar → payload constant
                  - call: [<.store.set, "k", mrec]
                  - set: [ccnt, { +: [ccnt, 1] }]
            - return: { -: [{ call: [sys.mem_usage] }, before] }

# Probe B: a fresh model instance per iteration (heap fields), goes out at the end of the iteration.
- def:
    name: probe_model_new
    static_off: ["same_arg"]
    args: [[iters, i32]]
    return: i64
    body:
      - decl: [before, i64, { call: [sys.mem_usage] }]
      - decl: [bcnt, i32, 0]
      - while:
          condition: { lt: [bcnt, iters] }
          body:
            - decl: [mrec, Rec]
            - set: [mrec.name, "local model instance with heap"]
            - call: [mrec.tags.push, "x"]
            - call: [mrec.tags.push, "y"]
            - call: [mrec.nums.push, bcnt]
            - set: [bcnt, { +: [bcnt, 1] }]
      - return: { -: [{ call: [sys.mem_usage] }, before] }

# Probe H: OWNED new box per iteration (ptr<Rec> via { new: Rec }, heap fields), goes
# out of scope at the end of the iteration.  Counterpart to B (value model local): B stays flat
# (deep scope drop), H MUST stay flat as well — if it does not, owned
# new boxes are not freed at the end of the scope (root of the 9rooms leaks: get_base /
# new CardMkpMath).  Regression assertion in _mem_sanitize/newbox_scope_drop.aiml.
- def:
    name: probe_box_new
    static_off: ["same_arg"]
    args: [[iters, i32]]
    return: i64
    body:
      - decl: [before, i64, { call: [sys.mem_usage] }]
      - decl: [hcnt, i32, 0]
      - while:
          condition: { lt: [hcnt, iters] }
          body:
            - decl: [box, ptr<Rec>, { new: Rec }]
            - set: [box.name, "owned new-box instance with heap"]
            - call: [box.tags.push, "x"]
            - call: [box.tags.push, "y"]
            - call: [box.nums.push, hcnt]
            - set: [hcnt, { +: [hcnt, 1] }]
      - return: { -: [{ call: [sys.mem_usage] }, before] }

# Probe D: pure list<string> build+drop per iteration (STRING LITERALS).
- def:
    name: probe_list
    static_off: ["same_arg"]
    args: [[iters, i32]]
    return: i64
    body:
      - decl: [before, i64, { call: [sys.mem_usage] }]
      - decl: [dcnt, i32, 0]
      - while:
          condition: { lt: [dcnt, iters] }
          body:
            - decl: [lst, list<string>]
            - call: [lst.push, "aaaaaaaaaaaaaaaa"]
            - call: [lst.push, "bbbbbbbbbbbbbbbb"]
            - call: [lst.push, "cccccccccccccccc"]
            - set: [dcnt, { +: [dcnt, 1] }]
      - return: { -: [{ call: [sys.mem_usage] }, before] }

# Probe E: list<string> with DYNAMIC (interpolated) strings per iteration.
# Disambiguates: does only model heap leak (then E≈0) or dynamic heap in EVERY
# container (then E≈B)?
- def:
    name: probe_list_dyn
    static_off: ["same_arg"]
    args: [[iters, i32]]
    return: i64
    body:
      - decl: [before, i64, { call: [sys.mem_usage] }]
      - decl: [ecnt, i32, 0]
      - while:
          condition: { lt: [ecnt, iters] }
          body:
            - decl: [lst, list<string>]
            - call: [lst.push, "dyn-value-${ecnt}-first"]
            - call: [lst.push, "dyn-value-${ecnt}-second"]
            - call: [lst.push, "dyn-value-${ecnt}-third"]
            - set: [ecnt, { +: [ecnt, 1] }]
      - return: { -: [{ call: [sys.mem_usage] }, before] }

# Probe F (control §8.1): BARE interpolation WITHOUT a container — one dynamic
# string local per iteration, nothing else.  Isolates the interpolation temporary
# itself (does the interpolated string leak even without any list?).
- def:
    name: probe_interp_bare
    static_off: ["same_arg"]
    args: [[iters, i32]]
    return: i64
    body:
      - decl: [before, i64, { call: [sys.mem_usage] }]
      - decl: [fcnt, i32, 0]
      - while:
          condition: { lt: [fcnt, iters] }
          body:
            - decl: [sval, string, "bare interpolation ${fcnt} value payload"]
            - set: [fcnt, { +: [fcnt, 1] }]
      - return: { -: [{ call: [sys.mem_usage] }, before] }

# Probe G (control §8.1): a list with dynamic strings created OUTSIDE the loop.
# Per iteration the same (already owned) dyn strings are pushed into a
# fresh list + the list is dropped.  Separates container element ownership
# (push/drop) from string creation: if G leaks, it is due to the container drop, not
# to creating dynamic strings.
- def:
    name: probe_list_dyn_hoisted
    static_off: ["same_arg"]
    args: [[iters, i32]]
    return: i64
    body:
      - decl: [before, i64, { call: [sys.mem_usage] }]
      - decl: [hsa, string, "hoisted-dyn-${iters}-alpha"]
      - decl: [hsb, string, "hoisted-dyn-${iters}-beta"]
      - decl: [hsc, string, "hoisted-dyn-${iters}-gamma"]
      - decl: [gcnt, i32, 0]
      - while:
          condition: { lt: [gcnt, iters] }
          body:
            - decl: [lst, list<string>]
            - call: [lst.push, hsa]
            - call: [lst.push, hsb]
            - call: [lst.push, hsc]
            - set: [gcnt, { +: [gcnt, 1] }]
      - return: { -: [{ call: [sys.mem_usage] }, before] }

# want: probe selection from AIML_MEM_PROBE (all → always).
- def:
    name: want
    static_off: ["same_arg", "str_cmp"]
    args: [[sel, string], [letter, string]]
    return: i32
    body:
      - if: { condition: { eq: [sel, "all"] }, then: [{ return: 1 }] }
      - if: { condition: { eq: [sel, letter] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - call: [io.remove_all, "/tmp/aiml_mem_probe/"]
      - decl: [svc, ptr<Store>, { new: Store }]
      - call: [svc.setup, "/tmp/aiml_mem_probe/"]
      - decl: [envm, map<string:string>, { call: [sys.env] }]
      - decl: [sel, string, "all"]
      - if: { condition: { gt: [{ call: [envm.contains, "AIML_MEM_PROBE"] }, 0] }, then: [{ set: [sel, { call: [envm.get, "AIML_MEM_PROBE"] }] }] }
      - decl: [reps, i32, 20000]
      - if: { condition: { gt: [{ call: [envm.contains, "AIML_MEM_ITERS"] }, 0] }, then: [{ decl: [itxt, string, { call: [envm.get, "AIML_MEM_ITERS"] }] }, { set: [reps, { call: [itxt.to_int] }] }] }
      - decl: [reps2, i32, { '*': [reps, 2] }]
      - call: [log.info, "MEMPROBE sel=${sel} N=${reps} 2N=${reps2} (leak ⇔ 2N≈2·N; clean ⇔ both≈0)"]
      # warm-up, so that one-time lazy allocations do not count as a leak.
      - decl: [warm, i64, { call: [svc.probe_get_copy, 2000] }]

      - if:
          condition: { gt: [{ call: [want, sel, "A"] }, 0] }
          then:
            - decl: [res_an, i64, { call: [svc.probe_get_copy, reps] }]
            - decl: [res_a2, i64, { call: [svc.probe_get_copy, reps2] }]
            - call: [log.info, "  A get_copy   deep-copy : N=${res_an}  2N=${res_a2} bytes"]
      - if:
          condition: { gt: [{ call: [want, sel, "B"] }, 0] }
          then:
            - decl: [res_bn, i64, { call: [probe_model_new, reps] }]
            - decl: [res_b2, i64, { call: [probe_model_new, reps2] }]
            - call: [log.info, "  B model_new  instance  : N=${res_bn}  2N=${res_b2} bytes"]
      - if:
          condition: { gt: [{ call: [want, sel, "H"] }, 0] }
          then:
            - decl: [res_hn, i64, { call: [probe_box_new, reps] }]
            - decl: [res_h2, i64, { call: [probe_box_new, reps2] }]
            - call: [log.info, "  H new-box    owned ptr  : N=${res_hn}  2N=${res_h2} bytes"]
      - if:
          condition: { gt: [{ call: [want, sel, "C"] }, 0] }
          then:
            - decl: [res_cn, i64, { call: [svc.probe_set, reps] }]
            - decl: [res_c2, i64, { call: [svc.probe_set, reps2] }]
            - call: [log.info, "  C kv.set     write-back : N=${res_cn}  2N=${res_c2} bytes"]
      - if:
          condition: { gt: [{ call: [want, sel, "D"] }, 0] }
          then:
            - decl: [res_dn, i64, { call: [probe_list, reps] }]
            - decl: [res_d2, i64, { call: [probe_list, reps2] }]
            - call: [log.info, "  D list<str>  literals   : N=${res_dn}  2N=${res_d2} bytes"]
      - if:
          condition: { gt: [{ call: [want, sel, "E"] }, 0] }
          then:
            - decl: [res_en, i64, { call: [probe_list_dyn, reps] }]
            - decl: [res_e2, i64, { call: [probe_list_dyn, reps2] }]
            - call: [log.info, "  E list<str>  dynamic    : N=${res_en}  2N=${res_e2} bytes"]
      - if:
          condition: { gt: [{ call: [want, sel, "F"] }, 0] }
          then:
            - decl: [res_fn, i64, { call: [probe_interp_bare, reps] }]
            - decl: [res_f2, i64, { call: [probe_interp_bare, reps2] }]
            - call: [log.info, "  F interp     bare       : N=${res_fn}  2N=${res_f2} bytes"]
      - if:
          condition: { gt: [{ call: [want, sel, "G"] }, 0] }
          then:
            - decl: [res_gn, i64, { call: [probe_list_dyn_hoisted, reps] }]
            - decl: [res_g2, i64, { call: [probe_list_dyn_hoisted, reps2] }]
            - call: [log.info, "  G list<str>  dyn-hoisted : N=${res_gn}  2N=${res_g2} bytes"]
      - return: 0
