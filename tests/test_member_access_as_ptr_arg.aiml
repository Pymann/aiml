# SPEC?: 18_refs_and_pointers   # derived from the file name, to be confirmed
# static-check: off
# BUG #4: pass a nested struct field (outer.inner) as an argument to a
# `ptr<T>` parameter.  Implicit ref (struct→ptr<T>) so far applies
# ONLY to plain variables, not to member access → the member is loaded by value
# → verification fail "Call parameter type does not match function
# signature" (or the fill does not propagate back).
#
# Expectation after the fix: outer.inner is filled via ptr → x=42.

- model: { name: Inner, fields: [[label, string], [xval, i32]] }
- model: { name: Outer, fields: [[tag, string], [inner, Inner]] }

- def:
    name: fill_inner
    args: [[dst, ref<Inner>]]
    body:
      - set: [dst.label, "filled"]
      - set: [dst.xval, 42]

- def:
    name: main
    return: i32
    body:
      - decl: [out, Outer]
      - set: [out.tag, "T"]
      # member-access als ptr<Inner>-Arg:
      - call: [fill_inner, out.inner]
      - call: [log.info, "out.inner.label='${out.inner.label}' xval=${out.inner.xval} (want filled/42)"]
      - decl: [fails, i32, 0]
      - if: { condition: { neq: [out.inner.label, "filled"] }, then: [{ set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [out.inner.xval, 42] }, then: [{ set: [fails, { +: [fails, 1] }] }] }
      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS member_access_as_ptr_arg"] }]
          else: [{ print: ["FAIL member_access_as_ptr_arg: ${fails}"] }]
      - return: fails
