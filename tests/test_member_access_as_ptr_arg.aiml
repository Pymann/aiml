# static-check: off
# BUG #4: ein verschachteltes Struct-Feld (outer.inner) als Argument an einen
# `ptr<T>`-Parameter übergeben.  Implicit-ref (struct→ptr<T>) greift bisher
# NUR bei plain Variablen, nicht bei member-access → member wird by-value
# geladen → Verification-Fail "Call parameter type does not match function
# signature" (bzw. Fill propagiert nicht zurück).
#
# Erwartung nach Fix: outer.inner wird via ptr befüllt → x=42.

- model: { name: Inner, fields: [[label, string], [xval, i32]] }
- model: { name: Outer, fields: [[tag, string], [inner, Inner]] }

- def:
    name: fill_inner
    args: [[dst, ptr<Inner>]]
    body:
      - set: [dst.label, "filled"]
      - set: [dst.xval, 42]

- def:
    name: main
    return: i32
    body:
      - decl: [out, Outer]
      - set: [out.tag, "T"]
      # member-access als ptr<Inner>-Arg:
      - call: [fill_inner, out.inner]
      - call: [log.info, "out.inner.label='${out.inner.label}' xval=${out.inner.xval} (want filled/42)"]
      - decl: [fails, i32, 0]
      - if: { condition: { neq: [out.inner.label, "filled"] }, then: [{ set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [out.inner.xval, 42] }, then: [{ set: [fails, { +: [fails, 1] }] }] }
      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS member_access_as_ptr_arg"] }]
          else: [{ print: ["FAIL member_access_as_ptr_arg: ${fails}"] }]
      - return: fails
