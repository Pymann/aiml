- class:
    name: TooManyArgsClass
    methods:
      - def:
          name: too_many_method
          args: [[a, i32], [b, i32], [c, i32], [d, i32], [e, i32], [f, i32]]
          return: i32
          body:
            - return: [{ +: [a, b, c, d, e, f] }]

- decl: [x, "ptr<TooManyArgsClass>", { new: TooManyArgsClass }]
- call: [x.too_many_method, 1, 2, 3, 4, 5, 6]
