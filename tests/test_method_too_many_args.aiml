- class:
    name: TooManyArgsClass
    methods:
      - def:
          name: too_many_method
          args: [[var_a, i32], [var_b, i32], [var_c, i32], [var_d, i32], [var_e, i32], [var_f, i32]]
          return: i32
          body:
            - return: [{ +: [var_a, var_b, var_c, var_d, var_e, var_f] }]

- decl: [var_x, "ptr<TooManyArgsClass>", { new: TooManyArgsClass }]
- call: [var_x.too_many_method, 1, 2, 3, 4, 5, 6]
