# SPEC: 44_5_mirror
# spec/44_5 §7.2 cancel_request: an ALREADY QUEUED response is removed and
# freed along with it — not just the registration deleted.
#
# The bug this test nails down: cancel_request only deleted the ID from
# `outstanding`.  A response that had already arrived and been queued before
# stayed in the queue forever — and was no longer reachable via take_response,
# because that first checks the ID against `outstanding`.  Since nothing is ever
# discarded to make room, such orphans run against the
# per-peer limit (4096 events / 64 MiB) and in the end disconnect our own peer.
# A client that only uses take_response (9rooms) has no poll_rpc drain
# that could still collect them.
#
# Checked in this order:
#   1. the response is queued (has_rpc rises), but not yet collected
#   2. cancel_request lowers has_rpc again — the orphan is gone
#   3. take_response on the cancelled ID reports -1 (request finished)
#   4. counter-probe: a second response that is NOT cancelled can still be collected
#      (without 4. 2. would also be satisfied by "empty the queue completely")
#
# Expected exit code: 0

- model:
    name: CancelReq
    fields: [[tag, string]]

- model:
    name: CancelResp
    fields: [[value, i32], [tag, string]]

- def:
    name: cancel_server
    static_off: ["str_cmp"]
    body:
      - decl: [sess, mirror_session, { call: [mirror.listen, "ws://127.0.0.1:19964"] }]
      - decl: [served, i32, 0]
      - decl: [tries, i32, 0]
      - while:
          condition: { '&&': [{ lt: [served, 2] }, { lt: [tries, 600] }] }
          body:
            - call: [sess.update]
            - if:
                condition: { gt: [{ call: [sess.has_rpc] }, 0] }
                then:
                  - decl: [rpc, rpc_event, { call: [sess.next_rpc] }]
                  - decl: [req, CancelReq]
                  - decl: [rc_d, i32, { call: [sess.decode_rpc, rpc, req] }]
                  - decl: [resp, CancelResp]
                  - set: [resp.tag, req.tag]
                  - set: [resp.value, 7]
                  - call: [sess.reply_rpc, rpc, "set_result", 0, resp]
                  - set: [served, { +: [served, 1] }]
            - call: [time.sleep_ms, 5]
            - set: [tries, { +: [tries, 1] }]
      # let the last packets out before closing
      - decl: [drain, i32, 0]
      - while:
          condition: { lt: [drain, 20] }
          body:
            - call: [sess.update]
            - call: [time.sleep_ms, 5]
            - set: [drain, { +: [drain, 1] }]
      - call: [sess.close]

- def:
    name: cancel_fail
    args: [[msg, string]]
    body:
      - call: [log.error, "FAIL ${msg}"]
      - call: [sys.exit, 1]

- def:
    name: main
    body:
      - decl: [host_th, thread_handle, { spawn: [cancel_server] }]
      - call: [time.sleep_ms, 150]
      - decl: [client, mirror_session, { call: [mirror.connect_timeout, "ws://127.0.0.1:19964", 3000] }]
      - call: [time.sleep_ms, 50]
      - call: [client.update]

      # ── 1. make a request and let the response be QUEUED ────────────────
      # Deliberately do NOT call take_response — the response should lie in the queue,
      # just as for a screen that has been closed in the meantime.
      - decl: [req_one, CancelReq]
      - set: [req_one.tag, "abandoned"]
      - decl: [id_one, i64, { call: [client.send_request, 0, "num", 0, req_one] }]
      - if: { condition: { le: [id_one, 0] }, then: [{ call: [cancel_fail, "send_request returned no ID (${id_one})"] }] }

      - decl: [queued, i32, 0]
      - decl: [wait_q, i32, 0]
      - while:
          condition: { '&&': [{ eq: [queued, 0] }, { lt: [wait_q, 400] }] }
          body:
            - call: [client.update]
            - if: { condition: { gt: [{ call: [client.has_rpc] }, 0] }, then: [{ set: [queued, 1] }] }
            - call: [time.sleep_ms, 5]
            - set: [wait_q, { +: [wait_q, 1] }]
      - if: { condition: { neq: [queued, 1] }, then: [{ call: [cancel_fail, "response was never queued"] }] }

      - decl: [n_before, i32, { call: [client.has_rpc] }]
      - if: { condition: { lt: [n_before, 1] }, then: [{ call: [cancel_fail, "has_rpc=${n_before} before the cancel"] }] }

      # ── 2. the cancel must take the orphan with it ─────────────────────
      - call: [client.cancel_request, id_one]
      - decl: [n_after, i32, { call: [client.has_rpc] }]
      - if:
          condition: { neq: [n_after, { -: [n_before, 1] }] }
          then: [{ call: [cancel_fail, "cancel_request left the queued response behind (has_rpc ${n_before} -> ${n_after}); it is now unreachable and counts permanently against the per-peer limit"] }]

      # ── 3. the cancelled ID is finished ───────────────────────────────
      - decl: [dead, CancelResp]
      - decl: [rc_dead, i32, { call: [client.take_response, id_one, dead] }]
      - if:
          condition: { neq: [rc_dead, -1] }
          then: [{ call: [cancel_fail, "take_response on the cancelled ID gave ${rc_dead}, expected -1"] }]

      # ── 4. counter-probe: a response that is not cancelled stays collectable ──
      - decl: [req_two, CancelReq]
      - set: [req_two.tag, "kept"]
      - decl: [id_two, i64, { call: [client.send_request, 0, "num", 0, req_two] }]
      - if: { condition: { le: [id_two, 0] }, then: [{ call: [cancel_fail, "second request returned no ID"] }] }
      - decl: [kept, CancelResp]
      - decl: [got_two, i32, 0]
      - decl: [wait_two, i32, 0]
      - while:
          condition: { '&&': [{ eq: [got_two, 0] }, { lt: [wait_two, 400] }] }
          body:
            - call: [client.update]
            - set: [got_two, { call: [client.take_response, id_two, kept] }]
            - if: { condition: { lt: [got_two, 0] }, then: [{ call: [cancel_fail, "second response could not be decoded"] }] }
            - call: [time.sleep_ms, 5]
            - set: [wait_two, { +: [wait_two, 1] }]
      - if: { condition: { neq: [got_two, 1] }, then: [{ call: [cancel_fail, "second response did not arrive — the cancel removed too much"] }] }
      - if: { condition: { neq: [kept.value, 7] }, then: [{ call: [cancel_fail, "second response has value=${kept.value}, expected 7"] }] }

      - call: [client.close]
      - call: [host_th.join]
      - call: [log.info, "PASS mirror_cancel_request_drains"]
