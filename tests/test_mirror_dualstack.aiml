# SPEC: 32_4_network_websockets §1.1 + 44_5_mirror §3.1
#
# A wildcard bind MUST serve both stacks: the same listener accepts an
# IPv4 AND an IPv6 connection.  Before, the listener bound AF_INET and silently
# rejected every IPv6 client — without a log line, because the connection never
# reaches the server.  In addition: peer_ip of a peer accepted via IPv4 must deliver the
# dotted form, not ::ffff:127.0.0.1 (otherwise bans and
# rate limit keys no longer match the ones stored via IPv4).
#
# Expected exit code: 0

- def:
    name: dualstack_host
    args: []
    body:
      - decl: [sess, mirror_session, { call: [mirror.listen, "ws://0.0.0.0:19886"] }]
      - if:
          condition: { peq: [sess, null] }
          then:
            - print: ["FAIL dualstack: listen on ws://0.0.0.0:19886 failed"]
            - return: []
      - decl: [tick, i32, 0]
      - while:
          condition: { lt: [tick, 300] }
          body:
            - call: [sess.update]
            - call: [time.sleep_ms, 10]
            - set: [tick, { +: [tick, 1] }]
      - call: [sess.close]

- decl: [g_v4_ready, i32, 0]

- def:
    name: v4only_host
    args: []
    body:
      - decl: [sess, mirror_session, { call: [mirror.listen, "ws://127.0.0.1:19887"] }]
      - if:
          condition: { peq: [sess, null] }
          then:
            - print: ["FAIL fallback: listen on 127.0.0.1:19887 failed"]
            - return: []
      - set: [g_v4_ready, 1]
      - decl: [tick, i32, 0]
      - while:
          condition: { lt: [tick, 300] }
          body:
            - call: [sess.update]
            - call: [time.sleep_ms, 10]
            - set: [tick, { +: [tick, 1] }]
      - call: [sess.close]

- def:
    name: main
    return: i32
    body:
      - decl: [host_th, thread_handle, { spawn: [dualstack_host] }]
      - call: [time.sleep_ms, 400]

      # ── IPv4 ───────────────────────────────────────────────────────────────
      - decl: [cli4, mirror_session, { call: [mirror.connect_timeout, "ws://127.0.0.1:19886", 3000] }]
      - if:
          condition: { peq: [cli4, null] }
          then:
            - print: ["FAIL dualstack: IPv4-Verbindung zu 127.0.0.1 abgelehnt"]
            - return: 1
      - call: [time.sleep_ms, 150]
      - call: [cli4.update]
      - print: ["  [ok] IPv4 verbunden (peers=${{ call: [cli4.peer_count] }})"]

      # ── IPv6 on THE SAME listener ──────────────────────────────────────────
      - decl: [cli6, mirror_session, { call: [mirror.connect_timeout, "ws://[::1]:19886", 3000] }]
      - if:
          condition: { peq: [cli6, null] }
          then:
            - print: ["FAIL dualstack: IPv6 connection to [::1] refused — listener is not dual-stack"]
            - call: [cli4.close]
            - return: 1
      - call: [time.sleep_ms, 150]
      - call: [cli6.update]
      - print: ["  [ok] IPv6 connected on the same listener"]

      - call: [cli4.close]
      - call: [cli6.close]

      # ── address fallback ─────────────────────────────────────────────────
      # "localhost" resolves to ::1 AND 127.0.0.1, and RFC 6724 puts ::1
      # first.  This listener binds ONLY IPv4 — so the client must keep walking the list
      # and arrive via 127.0.0.1.  Before, tcp_connect only took
      # res[0] and failed: exactly the case of a host whose AAAA record
      # is advertised but on which nothing listens (spec/32_4 §1.1).
      - decl: [v4_th, thread_handle, { spawn: [v4only_host] }]
      - call: [time.sleep_ms, 400]
      - if:
          condition: { neq: [g_v4_ready, 1] }
          then: [{ print: ["FAIL fallback: IPv4 listener not ready"] }, { return: 1 }]
      - decl: [fallb, mirror_session, { call: [mirror.connect_timeout, "ws://localhost:19887", 3000] }]
      - if:
          condition: { peq: [fallb, null] }
          then:
            - print: ["FAIL fallback: ws://localhost did not reach the IPv4 listener — no address fallback"]
            - return: 1
      - print: ["  [ok] Rueckfall ::1 -> 127.0.0.1 greift"]
      - call: [fallb.close]
      - print: ["PASS mirror_dualstack: one wildcard listener serves IPv4 and IPv6"]
      - return: 0
