# spec/44_5 §10 frame validation: malformed frames disconnect only the sending peer — no crash, no
# partial effect — and a well-behaved client keeps being served.  The raw clients stay OPEN, so every
# host-side disconnect is the host rejecting the frame.
#
# Expected exit code: 0

- model:
    name: MPing
    fields: [[note, string]]

- model:
    name: MPong
    fields: [[answered, i32]]

- decl: [g_mf_disconnects, i32, 0]
- decl: [g_mf_rpcs, i32, 0]
- decl: [g_mf_done, i32, 0]

- def:
    name: malformed_server
    static_off: ["str_cmp"]
    body:
      - decl: [sess, mirror_session, { call: [mirror.listen, "ws://127.0.0.1:19996"] }]
      - decl: [tries, i32, 0]
      - while:
          condition: { '&&': [{ eq: [g_mf_done, 0] }, { lt: [tries, 1500] }] }
          body:
            - call: [sess.update]
            - decl: [evt, mirror_event, { call: [sess.poll_event] }]
            - if: { condition: { eq: [evt.type, "peer_disconnected"] }, then: [{ set: [g_mf_disconnects, { +: [g_mf_disconnects, 1] }] }] }
            - decl: [rpc, rpc_event, { call: [sess.poll_rpc] }]
            - if:
                condition: { neq: [rpc.method, ""] }
                then:
                  - set: [g_mf_rpcs, { +: [g_mf_rpcs, 1] }]
                  - if:
                      condition: { eq: [rpc.method, "ping"] }
                      then:
                        - decl: [pong, MPong]
                        - set: [pong.answered, 1]
                        - call: [sess.reply_rpc, rpc, "set_result", 0, pong]
            - call: [time.sleep_ms, 3]
            - set: [tries, { +: [tries, 1] }]
      - call: [sess.close]

# [net_id:u32][type:u8][reserved:u8]
- def:
    name: put_hdr
    args: [[buf, buffer], [ptype, i32], [reserved, i32]]
    body:
      - call: [buf.write, 0, i32]
      - call: [buf.write, ptype, u8]
      - call: [buf.write, reserved, u8]

- def:
    name: main
    body:
      - decl: [host_th, thread_handle, { spawn: [malformed_server] }]
      - call: [time.sleep_ms, 200]

      # 1. RPC v2 with method_len 0
      - decl: [raw1, ws_handle, { call: [ws.connect, "127.0.0.1", 19996, "/"] }]
      - decl: [bad1, buffer]
      - call: [bad1.alloc, 64]
      - call: [put_hdr, bad1, 2, 0]
      - call: [bad1.write, 0, u8]
      - call: [bad1.write, 0, u8]
      - call: [bad1.write, 0, i32]
      - call: [bad1.write, 0, i32]
      - call: [bad1.ws_send, raw1]

      # 2. RPC v2, typed blob whose own length prefix lies (says 10, blob is 4 bytes)
      - decl: [raw2, ws_handle, { call: [ws.connect, "127.0.0.1", 19996, "/"] }]
      - decl: [bad2, buffer]
      - call: [bad2.alloc, 64]
      - call: [put_hdr, bad2, 2, 0]
      - call: [bad2.write, 1, u8]
      - call: [bad2.write, 120, u8]
      - call: [bad2.write, 1, u8]
      - call: [bad2.write, 0, i32]
      - call: [bad2.write, 4, i32]
      - call: [bad2.write, 10, i32]
      - call: [bad2.ws_send, raw2]

      # 3. unknown packet type
      - decl: [raw3, ws_handle, { call: [ws.connect, "127.0.0.1", 19996, "/"] }]
      - decl: [bad3, buffer]
      - call: [bad3.alloc, 16]
      - call: [put_hdr, bad3, 127, 0]
      - call: [bad3.ws_send, raw3]

      # 4. RPC v3 announcing a 2 GiB total length
      - decl: [raw4, ws_handle, { call: [ws.connect, "127.0.0.1", 19996, "/"] }]
      - decl: [bad4, buffer]
      - call: [bad4.alloc, 64]
      - call: [put_hdr, bad4, 5, 3]
      - call: [bad4.write, 2147483647, i32]
      - call: [bad4.write, 0, i32]
      - call: [bad4.ws_send, raw4]

      # 5. arg_kind 2 (only 0/1 exist)
      - decl: [raw5, ws_handle, { call: [ws.connect, "127.0.0.1", 19996, "/"] }]
      - decl: [bad5, buffer]
      - call: [bad5.alloc, 64]
      - call: [put_hdr, bad5, 2, 0]
      - call: [bad5.write, 1, u8]
      - call: [bad5.write, 120, u8]
      - call: [bad5.write, 2, u8]
      - call: [bad5.write, 0, i32]
      - call: [bad5.write, 0, i32]
      - call: [bad5.ws_send, raw5]

      # 6. trailing byte after a complete UNREGISTER packet
      - decl: [raw6, ws_handle, { call: [ws.connect, "127.0.0.1", 19996, "/"] }]
      - decl: [bad6, buffer]
      - call: [bad6.alloc, 16]
      - call: [put_hdr, bad6, 4, 0]
      - call: [bad6.write, 7, u8]
      - call: [bad6.ws_send, raw6]

      # 7. DELTA with the untagged former format 1 (spec/44_5 §10: invalid frame)
      - decl: [raw7, ws_handle, { call: [ws.connect, "127.0.0.1", 19996, "/"] }]
      - decl: [bad7, buffer]
      - call: [bad7.alloc, 32]
      - call: [put_hdr, bad7, 1, 1]
      - call: [bad7.write, 4, i32]
      - call: [bad7.write, 0, i32]
      - call: [bad7.ws_send, raw7]

      - call: [time.sleep_ms, 400]

      # a well-behaved client still gets served
      - decl: [client, mirror_session, { call: [mirror.connect_timeout, "ws://127.0.0.1:19996", 3000] }]
      - decl: [ping, MPing]
      - set: [ping.note, "hi"]
      - decl: [pong, ptr<MPong>, { new: MPong }]
      - decl: [got, i32, { call: [client.send_and_await, 0, "ping", ping, pong, 3000] }]
      - set: [g_mf_done, 1]
      - call: [host_th.join]
      - call: [client.close]
      - call: [raw1.close]
      - call: [raw2.close]
      - call: [raw3.close]
      - call: [raw4.close]
      - call: [raw5.close]
      - call: [raw6.close]
      - call: [raw7.close]
      - if: { condition: { neq: [got, 1] }, then: [{ print: ["FAIL valid client not served after malformed frames"] }, { call: [sys.exit, 1] }] }
      - if: { condition: { neq: [g_mf_rpcs, 1] }, then: [{ print: ["FAIL host queued ${g_mf_rpcs} RPCs (malformed frames must queue nothing)"] }, { call: [sys.exit, 1] }] }
      - if: { condition: { lt: [g_mf_disconnects, 7] }, then: [{ print: ["FAIL only ${g_mf_disconnects} of 7 malformed peers were disconnected"] }, { call: [sys.exit, 1] }] }
      - print: ["mirror rpc malformed PASS"]
