# SPEC: 44_5_mirror
# static-check: off
# 9rooms-like websocket mirror repro with imported globals on both sides (spec/44_5 §4 readiness).
# Host: REGISTER only binds the ClientInfo replica; it is ready once snapshot_revision > 0 and all
# fields match.  Client: the view is ready once its revision > 0 and every expected field arrived;
# then it acknowledges with an RPC, and only then does the host close.  Host fields are checked
# in the host thread only.  Every wait has a monotonic deadline and names its phase on timeout.
# With AIML_MIRROR_TEST_HOLD_DELTA=<file> (see test_mirror_ws_9rooms_imports_delayed) the host
# proves the gap (bound, revision 0) and releases the held DELTAs 150 ms after binding.
# Expected exit code: 0

- import: "tests/ws9_shared.aiml"
- import: "tests/ws9_client_globals.aiml"
- import: "tests/ws9_server_globals.aiml"

- def:
    name: ws9_fail
    args: [[msg, string]]
    body:
      - print: ["FAIL ${msg}"]
      - call: [sys.exit, 1]

- def:
    name: ws9_host
    args: []
    static_off: ["str_cmp"]
    body:
      - decl: [envm, map<string:string>, { call: [sys.env] }]
      - decl: [hold_path, string, ""]
      - if: { condition: { gt: [{ call: [envm.contains, "AIML_MIRROR_TEST_HOLD_DELTA"] }, 0] }, then: [{ set: [hold_path, { call: [envm.get, "AIML_MIRROR_TEST_HOLD_DELTA"] }] }] }

      - decl: [sess, mirror_session, { call: [mirror.listen, "ws://127.0.0.1:19897"] }]
      - decl: [var_v, GameViewWs9]
      - decl: [nid, i32, { call: [sess.register, var_v] }]

      # phase 1: peer, ClientInfo REGISTER (bind), ClientInfo snapshot
      - decl: [peer, i32, 0]
      - decl: [ci_nid, i32, 0]
      - decl: [bound_ci, i32, 0]
      - decl: [bound_at, i64, 0]
      - decl: [released, i32, 0]
      - decl: [got_ci, i32, 0]
      - decl: [deadline, i64, { +: [{ call: [time.mono_ms] }, 5000] }]
      - while:
          condition: { eq: [got_ci, 0] }
          body:
            - call: [sess.update]
            - decl: [cev, mirror_event, { call: [sess.poll_event] }]
            - if: { condition: { eq: [cev.type, "peer_connected"] }, then: [{ set: [peer, cev.peer_id] }] }
            - if:
                condition: { '&&': [{ eq: [cev.type, "object_registered"] }, { neq: [cev.net_id, nid] }] }
                then:
                  - set: [ci_nid, cev.net_id]
                  - call: [sess.register_id, g_ws9_server_client_info, ci_nid]
                  - set: [bound_ci, 1]
                  - set: [bound_at, { call: [time.mono_ms] }]
            - if:
                condition: { eq: [bound_ci, 1] }
                then:
                  - decl: [snap_err, i32, { call: [sess.snapshot_error, ci_nid] }]
                  - if: { condition: { neq: [snap_err, 0] }, then: [{ call: [ws9_fail, "ws9-host: ClientInfo net_id=${ci_nid} decode error=${snap_err}"] }] }
                  - decl: [rev, u64, { call: [sess.snapshot_revision, ci_nid] }]
                  - if:
                      condition: { '&&': [{ neq: [hold_path, ""] }, { eq: [released, 0] }] }
                      then:
                        - if: { condition: { gt: [rev, 0] }, then: [{ call: [ws9_fail, "ws9-host: snapshot applied while DELTAs were held"] }] }
                        - if:
                            condition: { gt: [{ call: [time.mono_ms] }, { +: [bound_at, 150] }] }
                            then:
                              - call: [io.write_file, hold_path, "go"]
                              - set: [released, 1]
                  - if:
                      condition: { gt: [rev, 0] }
                      then:
                        - if: { condition: { neq: [g_ws9_server_client_info.player_name, "Nikolai"] }, then: [{ call: [ws9_fail, "ws9-host: player='${g_ws9_server_client_info.player_name}' rev=${rev}"] }] }
                        - if: { condition: { neq: [g_ws9_server_client_info.deckset_id, "deckset-alpha"] }, then: [{ call: [ws9_fail, "ws9-host: deckset='${g_ws9_server_client_info.deckset_id}' rev=${rev}"] }] }
                        - if: { condition: { neq: [g_ws9_server_client_info.player_id, "token-123"] }, then: [{ call: [ws9_fail, "ws9-host: player_id='${g_ws9_server_client_info.player_id}' rev=${rev}"] }] }
                        - set: [got_ci, 1]
            - if:
                condition: { gt: [{ call: [time.mono_ms] }, deadline] }
                then:
                  - call: [ws9_fail, "ws9-host: timeout waiting for ClientInfo (peer=${peer} net_id=${ci_nid} bound=${bound_ci} rev=${ { call: [sess.snapshot_revision, ci_nid] } } err=${ { call: [sess.snapshot_error, ci_nid] } })"]
            - call: [time.sleep_ms, 2]
      - call: [ws9server.mark_client_info_seen]

      # phase 2: fill the view, wait for the client's acknowledgement
      - set: [var_v.round, 7]
      - set: [var_v.p1_name, g_ws9_server_client_info.player_name]
      - set: [var_v.p2_name, "Bot"]
      - set: [var_v.hand_count, 3]
      - set: [var_v.p1_hp, 26]
      - set: [var_v.p2_hp, 22]
      - decl: [acked, i32, 0]
      - set: [deadline, { +: [{ call: [time.mono_ms] }, 5000] }]
      - while:
          condition: { eq: [acked, 0] }
          body:
            - call: [sess.update]
            - decl: [rpc, rpc_event, { call: [sess.poll_rpc] }]
            - if:
                condition: { eq: [rpc.method, "ws9_view_received"] }
                then:
                  - if: { condition: { neq: [rpc.arg, 7] }, then: [{ call: [ws9_fail, "ws9-host: ack arg=${rpc.arg}"] }] }
                  - if: { condition: { neq: [rpc.peer_id, peer] }, then: [{ call: [ws9_fail, "ws9-host: ack from peer ${rpc.peer_id}, expected ${peer}"] }] }
                  - set: [acked, 1]
            - if:
                condition: { gt: [{ call: [time.mono_ms] }, deadline] }
                then:
                  - call: [ws9_fail, "ws9-host: timeout waiting for view ack (peer=${peer} view net_id=${nid})"]
            - call: [time.sleep_ms, 2]
      - call: [sess.close]
      - if: { condition: { neq: [g_ws9_server_client_info.player_name, "Nikolai"] }, then: [{ call: [ws9_fail, "ws9-host: ClientInfo lost after close"] }] }

- call: [ws9client.set_selected_deckset, "deckset-alpha"]

- decl: [host_th, thread_handle, { spawn: [ws9_host] }]
- call: [time.sleep_ms, 80]

- decl: [client, mirror_session, { call: [mirror.connect_timeout, "ws://127.0.0.1:19897", 4000] }]

# phase 1: view REGISTER
- decl: [deadline, i64, { +: [{ call: [time.mono_ms] }, 5000] }]
- decl: [got_view, i32, 0]
- while:
    condition: { eq: [got_view, 0] }
    body:
      - call: [client.update]
      - decl: [var_ev, mirror_event, { call: [client.poll_event] }]
      - if:
          condition: { eq: [var_ev.type, "object_registered"] }
          then:
            - set: [g_ws9_view_nid, var_ev.net_id]
            - set: [got_view, 1]
      - if: { condition: { gt: [{ call: [time.mono_ms] }, deadline] }, then: [{ call: [ws9_fail, "ws9-client: timeout waiting for view REGISTER"] }] }
      - call: [time.sleep_ms, 2]

- call: [client.register_id, g_ws9_view, g_ws9_view_nid]
- set: [g_ws9_client_info.deckset_id, g_ws9_selected_deckset_id]
- set: [g_ws9_client_info.player_name, "Nikolai"]
- set: [g_ws9_client_info.player_id, "token-123"]
- call: [client.register, g_ws9_client_info]

# phase 2: complete view snapshot
- set: [deadline, { +: [{ call: [time.mono_ms] }, 5000] }]
- decl: [view_ok, i32, 0]
- while:
    condition: { eq: [view_ok, 0] }
    body:
      - call: [client.update]
      - decl: [verr, i32, { call: [client.snapshot_error, g_ws9_view_nid] }]
      - if: { condition: { neq: [verr, 0] }, then: [{ call: [ws9_fail, "ws9-client: view net_id=${g_ws9_view_nid} decode error=${verr}"] }] }
      - if:
          condition: { gt: [{ call: [client.snapshot_revision, g_ws9_view_nid] }, 0] }
          then:
            - if:
                condition: { '&&': [{ eq: [g_ws9_view.round, 7] }, { '&&': [{ eq: [g_ws9_view.p1_name, "Nikolai"] }, { '&&': [{ eq: [g_ws9_view.p2_name, "Bot"] }, { '&&': [{ eq: [g_ws9_view.hand_count, 3] }, { '&&': [{ eq: [g_ws9_view.p1_hp, 26] }, { eq: [g_ws9_view.p2_hp, 22] }] }] }] }] }] }
                then: [{ set: [view_ok, 1] }]
      - if:
          condition: { gt: [{ call: [time.mono_ms] }, deadline] }
          then:
            - call: [ws9_fail, "ws9-client: timeout waiting for view (net_id=${g_ws9_view_nid} rev=${ { call: [client.snapshot_revision, g_ws9_view_nid] } } round=${g_ws9_view.round} p1='${g_ws9_view.p1_name}')"]
      - call: [time.sleep_ms, 2]

- call: [client.send_rpc, 0, "ws9_view_received", 7]
- set: [g_ws9_connected, 1]

# phase 3: host closes after the ack; the client's models stay valid
- call: [host_th.join]
- if: { condition: { neq: [g_ws9_selected_deckset_id, "deckset-alpha"] }, then: [{ call: [ws9_fail, "ws9: selected deckset lost='${g_ws9_selected_deckset_id}'"] }] }
- if: { condition: { neq: [g_ws9_client_info.deckset_id, "deckset-alpha"] }, then: [{ call: [ws9_fail, "ws9: client_info deckset='${g_ws9_client_info.deckset_id}'"] }] }
- if: { condition: { neq: [g_ws9_view.p1_name, "Nikolai"] }, then: [{ call: [ws9_fail, "ws9: view p1_name='${g_ws9_view.p1_name}'"] }] }
- if: { condition: { neq: [g_ws9_view.round, 7] }, then: [{ call: [ws9_fail, "ws9: view round=${g_ws9_view.round}"] }] }
- if: { condition: { neq: [{ call: [ws9client.get_connected] }, 1] }, then: [{ call: [ws9_fail, "ws9: connected flag"] }] }
- call: [client.close]
- if: { condition: { neq: [g_ws9_view.p1_name, "Nikolai"] }, then: [{ call: [ws9_fail, "ws9: view lost after close"] }] }
- print: ["WS 9rooms imports PASS"]
