# static-check: off
# Regression test: WebSocket mirror with in-place list mutations and RPCs
# Expected exit code: 0

- model:
    name: CounterState
    sync: [name, value]
    fields:
      - [name, string]
      - [value, i32, 0]

- model:
    name: StatusFlagState
    sync: [name, enabled]
    fields:
      - [name, string]
      - [enabled, i32, 0]

- model:
    name: MatchState
    sync: [match_id, round, last_event, waiting_for_command]
    fields:
      - [match_id, string]
      - [round, i32, 0]
      - [last_event, string]
      - [waiting_for_command, i32, 0]

- model:
    name: ParticipantState
    sync: [slot, display_name, is_active, var_hp, counters, flags]
    fields:
      - [slot, i32, -1]
      - [display_name, string]
      - [is_active, i32, 0]
      - [var_hp, i32, 100]
      - [counters, list<CounterState>]
      - [flags, list<StatusFlagState>]

- model:
    name: VisibleCardRef
    sync: [instance_id, owner_slot, zone_id, order_idx]
    fields:
      - [instance_id, string]
      - [owner_slot, i32, -1]
      - [zone_id, string]
      - [order_idx, i32, -1]

- model:
    name: ZoneState
    sync: [zone_id, zone_label, owner_slot, card_count, cards]
    fields:
      - [zone_id, string]
      - [zone_label, string]
      - [owner_slot, i32, -1]
      - [card_count, i32, 0]
      - [cards, list<VisibleCardRef>]

- model:
    name: CardInstanceState
    sync: [instance_id, display_name, owner_slot, zone_id, position_idx, current_hp, attack]
    fields:
      - [instance_id, string]
      - [display_name, string]
      - [owner_slot, i32, -1]
      - [zone_id, string]
      - [position_idx, i32, -1]
      - [current_hp, i32, 0]
      - [attack, i32, 0]

- model:
    name: GameStateRootMut
    sync: [match, participants, zones, card_instances]
    rpc: [select_card]
    fields:
      - [match, MatchState]
      - [participants, list<ParticipantState>]
      - [zones, list<ZoneState>]
      - [card_instances, list<CardInstanceState>]

- def:
    name: mirror_ws_mut_host
    args: []
    body:
      - decl: [sess, mirror_session]
      - set: [sess, { call: [mirror.listen, "ws://127.0.0.1:19894"] }]

      - decl: [root_json, string, '{"__type":"GameStateRootMut","match":{"match_id":"mut-1","round":1,"last_event":"boot","waiting_for_command":1},"participants":[{"slot":0,"display_name":"Alice","is_active":1,"var_hp":30,"counters":[{"name":"mana","value":3}],"flags":[{"name":"shield","enabled":1}]},{"slot":1,"display_name":"Bob","is_active":0,"var_hp":28,"counters":[{"name":"mana","value":4}],"flags":[{"name":"stun","enabled":0}]},{"slot":2,"display_name":"Cora","is_active":0,"var_hp":25,"counters":[{"name":"mana","value":2}],"flags":[{"name":"burn","enabled":1}]}],"zones":[{"zone_id":"field_0","zone_label":"Field 0","owner_slot":0,"card_count":2,"cards":[{"instance_id":"ci-1","owner_slot":0,"zone_id":"field_0","order_idx":0},{"instance_id":"ci-2","owner_slot":0,"zone_id":"field_0","order_idx":1}]},{"zone_id":"field_1","zone_label":"Field 1","owner_slot":1,"card_count":1,"cards":[{"instance_id":"ci-3","owner_slot":1,"zone_id":"field_1","order_idx":0}]}],"card_instances":[{"instance_id":"ci-1","display_name":"Knight","owner_slot":0,"zone_id":"field_0","position_idx":0,"current_hp":5,"attack":3},{"instance_id":"ci-2","display_name":"Archer","owner_slot":0,"zone_id":"field_0","position_idx":1,"current_hp":2,"attack":4},{"instance_id":"ci-3","display_name":"Slime","owner_slot":1,"zone_id":"field_1","position_idx":0,"current_hp":6,"attack":1}]}' ]
      - decl: [root, GameStateRootMut]
      - set: [root, { call: [sys.deserialize, root_json, "GameStateRootMut"] }]
      - decl: [nid, i32]
      - set: [nid, { call: [sess.register, root] }]
      - print: ["host-mut: root registered net_id=${nid}"]

      - decl: [var_i, i32, 0]
      - while:
          condition: { lt: [var_i, 30] }
          body:
            - call: [sess.update]
            - call: [time.sleep_ms, 10]
            - set: [var_i, { +: [var_i, 1] }]

      - decl: [var_p1, ptr<ParticipantState>]
      - set: [var_p1, { call: [root.participants.get, 1] }]
      - set: [var_p1.var_hp, 17]
      - set: [var_p1.is_active, 1]

      - decl: [var_z0, ptr<ZoneState>]
      - set: [var_z0, { call: [root.zones.get, 0] }]
      - call: [var_z0.cards.remove, 0]
      - decl: [new_ref, VisibleCardRef]
      - set: [new_ref.instance_id, "ci-4"]
      - set: [new_ref.owner_slot, 0]
      - set: [new_ref.zone_id, "field_0"]
      - set: [new_ref.order_idx, 1]
      - call: [var_z0.cards.push, new_ref]
      - set: [var_z0.card_count, { call: [var_z0.cards.len] }]

      - decl: [ci4, CardInstanceState]
      - set: [ci4.instance_id, "ci-4"]
      - set: [ci4.display_name, "Dragon"]
      - set: [ci4.owner_slot, 0]
      - set: [ci4.zone_id, "field_0"]
      - set: [ci4.position_idx, 1]
      - set: [ci4.current_hp, 9]
      - set: [ci4.attack, 7]
      - call: [root.card_instances.push, ci4]

      - decl: [match_delta_json, string, '{"__type":"MatchState","match_id":"mut-1","round":2,"last_event":"list_mutation_applied","waiting_for_command":1}' ]
      - decl: [match_delta, MatchState]
      - set: [match_delta, { call: [sys.deserialize, match_delta_json, "MatchState"] }]
      - set: [root.match, match_delta]
      - print: ["host-mut: list mutation delta applied"]

      - set: [var_i, 0]
      - while:
          condition: { lt: [var_i, 35] }
          body:
            - call: [sess.update]
            - if:
                condition: { call: [sess.has_rpc] }
                then:
                  - decl: [rpc, rpc_event]
                  - set: [rpc, { call: [sess.next_rpc] }]
                  - print: ["host-mut: rpc ${rpc.method}(${rpc.arg})"]
                  - decl: [rpc_match_json, string, '{"__type":"MatchState","match_id":"mut-1","round":2,"last_event":"rpc_select_42","waiting_for_command":0}' ]
                  - decl: [rpc_match, MatchState]
                  - set: [rpc_match, { call: [sys.deserialize, rpc_match_json, "MatchState"] }]
                  - set: [root.match, rpc_match]
            - call: [time.sleep_ms, 10]
            - set: [var_i, { +: [var_i, 1] }]

      - call: [sess.close]
      - print: ["host-mut: done"]

- decl: [host_th, thread_handle]
- set: [host_th, { spawn: [mirror_ws_mut_host] }]
- call: [time.sleep_ms, 80]

- decl: [client, mirror_session]
- set: [client, { call: [mirror.connect_timeout, "ws://127.0.0.1:19894", 4000] }]
- print: ["client-mut: ws connect ok"]

- call: [time.sleep_ms, 120]
- call: [client.update]

- decl: [has_ev, i32]
- set: [has_ev, { call: [client.has_event] }]
- if:
    condition: { eq: [has_ev, 0] }
    then:
      - print: ["FAIL mut: no object_registered event"]
      - call: [sys.exit, 1]

- decl: [var_ev, mirror_event]
- set: [var_ev, { call: [client.next_event] }]
- decl: [replica, GameStateRootMut]
- call: [client.register_id, replica, var_ev.net_id]
- print: ["client-mut: replica registered net_id=${var_ev.net_id}"]

- call: [time.sleep_ms, 150]
- call: [client.update]

- decl: [var_m0, MatchState, replica.match]
- decl: [pz1, ParticipantState, replica.participants-1]
- decl: [zz0, ZoneState, replica.zones-0]
- print: ["client-mut: round=${var_m0.round} last_event=${var_m0.last_event}"]
- print: ["client-mut: var_p1 var_hp=${pz1.var_hp} active=${pz1.is_active}"]
- print: ["client-mut: zone0 count=${zz0.card_count} card_instances.len=${replica.card_instances.len}"]

- if:
    condition: { neq: [pz1.var_hp, 17] }
    then:
      - print: ["FAIL mut: var_p1.var_hp=${pz1.var_hp}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [pz1.is_active, 1] }
    then:
      - print: ["FAIL mut: var_p1.is_active=${pz1.is_active}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [zz0.card_count, 2] }
    then:
      - print: ["FAIL mut: zz0.card_count=${zz0.card_count}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [replica.card_instances.len, 4] }
    then:
      - print: ["FAIL mut: card_instances.len=${replica.card_instances.len}"]
      - call: [sys.exit, 1]

- decl: [last_ref_ptr, ptr<VisibleCardRef>]
- set: [last_ref_ptr, { call: [zz0.cards.get, 1] }]
- decl: [cc_last_ptr, ptr<CardInstanceState>]
- set: [cc_last_ptr, { call: [replica.card_instances.get, 3] }]
- decl: [last_ref_id, string, last_ref_ptr.instance_id]
- decl: [last_card_name, string, cc_last_ptr.display_name]
- decl: [last_card_attack, i32, cc_last_ptr.attack]
- print: ["client-mut: zone0 last_ref=${last_ref_id}"]
- print: ["client-mut: card3=${last_card_name}/${last_card_attack}"]

- if:
    condition: { eq: [{ eq: [last_ref_ptr.instance_id, "ci-4"] }, 0] }
    then:
      - print: ["FAIL mut: last_ref_ptr.instance_id mismatch"]
      - call: [sys.exit, 1]

- if:
    condition: { eq: [{ eq: [cc_last_ptr.display_name, "Dragon"] }, 0] }
    then:
      - print: ["FAIL mut: cc_last_ptr.display_name mismatch"]
      - call: [sys.exit, 1]

- call: [client.send_rpc, var_ev.net_id, "select_card", 42]
- print: ["client-mut: sent rpc select_card(42)"]
- call: [time.sleep_ms, 200]
- call: [client.update]

- decl: [var_m1, MatchState, replica.match]
- print: ["client-mut: post-rpc round=${var_m1.round} last_event=${var_m1.last_event} waiting=${var_m1.waiting_for_command}"]

- if:
    condition: { eq: [{ eq: [var_m1.last_event, "rpc_select_42"] }, 0] }
    then:
      - print: ["FAIL mut: post-rpc last_event=${var_m1.last_event}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [var_m1.waiting_for_command, 0] }
    then:
      - print: ["FAIL mut: waiting_for_command=${var_m1.waiting_for_command}"]
      - call: [sys.exit, 1]

- call: [client.close]
- call: [host_th.join]
- print: ["WS list mutation mirror PASS"]
