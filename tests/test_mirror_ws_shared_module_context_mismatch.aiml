# Same shared module, but host and client are compiled as separate top-level
# processes with different import sets. This is the real reproduction shape.

- decl: [argv_host, list<string>]
- call: [argv_host.push, "./out/aiml/aiml"]
- call: [argv_host.push, "-r"]
- call: [argv_host.push, "tests/ws_context_host_process.aiml"]

- decl: [host, process]
- set: [host, { call: [sys.exe, argv_host] }]
# Give the host enough time to compile and start listening before the client connects.
- call: [time.sleep_ms, 600]

- decl: [argv_client, list<string>]
- call: [argv_client.push, "./out/aiml/aiml"]
- call: [argv_client.push, "-r"]
- call: [argv_client.push, "tests/ws_context_client_process.aiml"]

- decl: [client, process]
- set: [client, { call: [sys.exe, argv_client] }]

- decl: [client_rc, i32]
- set: [client_rc, { call: [client.wait] }]

- decl: [host_rc, i32]
- set: [host_rc, { call: [host.wait] }]

- print: ["ctx-main: client_rc=${client_rc} host_rc=${host_rc}"]

- if:
    condition: { neq: [client_rc, 0] }
    then:
      - print: ["FAIL ctx-main: client_rc=${client_rc}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [host_rc, 0] }
    then:
      - print: ["FAIL ctx-main: host_rc=${host_rc}"]
      - call: [sys.exit, 1]

- print: ["WS shared-module context mismatch PASS"]
