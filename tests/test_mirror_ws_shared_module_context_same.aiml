# SPEC: 44_5_mirror
# Host and client compiled as separate processes with different import sets but the same wire
# schema: the view snapshot applies (spec/44_5 §10).
# Expected exit code: 0

- def:
    name: ctx_pair
    args: [[host_file, string], [client_file, string], [label, string]]
    body:
      - decl: [argv_host, list<string>]
      - call: [argv_host.push, "./out/aiml/aiml"]
      - call: [argv_host.push, "-r"]
      - call: [argv_host.push, host_file]
      - decl: [host, process, { call: [sys.exe, argv_host] }]
      # Give the host enough time to compile and start listening before the client connects.
      - call: [time.sleep_ms, 600]
      - decl: [argv_client, list<string>]
      - call: [argv_client.push, "./out/aiml/aiml"]
      - call: [argv_client.push, "-r"]
      - call: [argv_client.push, client_file]
      - decl: [client, process, { call: [sys.exe, argv_client] }]
      - decl: [client_rc, i32, { call: [client.wait] }]
      - decl: [host_rc, i32, { call: [host.wait] }]
      - print: ["ctx-main ${label}: client_rc=${client_rc} host_rc=${host_rc}"]
      - if:
          condition: { '||': [{ neq: [client_rc, 0] }, { neq: [host_rc, 0] }] }
          then:
            - print: ["FAIL ctx-main ${label}"]
            - call: [sys.exit, 1]

- call: [ctx_pair, "tests/ws_context_host_process.aiml", "tests/ws_context_client_process_same.aiml", "same"]
- print: ["WS shared-module context same-schema PASS"]
