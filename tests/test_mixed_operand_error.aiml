# SPEC: 04_1_precedence,04_math
# spec/04_1 §3/§7a: two TYPED values of different floating-point width in
# a comparison are a compile error — not a silent conversion
# and certainly not an invalid module.
#
# Negative test: the compilation MUST fail.  The message names both types
# and points to `cast`.
# Expected exit code: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [wide_val, f64, 2.75]
      - decl: [narrow_val, f32, 2.75]
      # Nothing is guessed here: which side is converted is decided by the
      # author, because f64→f32 loses precision.
      - if:
          condition: { gt: [wide_val, narrow_val] }
          then: [{ print: ["unerreichbar"] }]
      - return: 0
