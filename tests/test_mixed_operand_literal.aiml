# SPEC: 04_1_precedence,04_math
# spec/04_1 §7a: a literal takes on the type of the other operand.
#
# Before, a mixed pair fell through the matching step and reached LLVM
# as an instruction with two different operand types — the module check
# then failed with "Both operands to FCmp instruction are not of the same
# type!", i.e. with a message about the compiler instead of about the source line.
# Expected exit code: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── comparison: f64 against a floating-point literal (the literal is otherwise f32) ──
      - decl: [ratio, f64, 2.75]
      - if:
          condition: { gt: [ratio, 2.5] }
          then: []
          else: [{ print: ["FAIL f64 > Literal"] }, { set: [fails, { +: [fails, 1] }] }]
      - if:
          condition: { neq: [ratio, 2.75] }
          then: [{ print: ["FAIL f64 != literal (equal values)"] }, { set: [fails, { +: [fails, 1] }] }]

      # reversed order: literal on the left
      - if:
          condition: { lt: [2.5, ratio] }
          then: []
          else: [{ print: ["FAIL Literal < f64"] }, { set: [fails, { +: [fails, 1] }] }]

      # ── f32 against a literal must keep working ──────────────────────────
      - decl: [small, f32, 0.5]
      - if:
          condition: { gt: [small, 0.25] }
          then: []
          else: [{ print: ["FAIL f32 > Literal"] }, { set: [fails, { +: [fails, 1] }] }]

      # ── integer literal against a floating-point value ───────────────────
      - decl: [whole, f64, 3.0]
      - if:
          condition: { eq: [whole, 3] }
          then: []
          else: [{ print: ["FAIL f64 == Ganzzahl-Literal"] }, { set: [fails, { +: [fails, 1] }] }]

      # ── arithmetic, the same matching step ──────────────────────────────
      - decl: [sum_val, f64, { +: [ratio, 0.25] }]
      - decl: [want_three, f64, 3.0]
      - if:
          condition: { neq: [sum_val, want_three] }
          then: [{ print: ["FAIL f64 + Literal = ${sum_val}, expected 3"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [prod, f64, { '*': [ratio, 2] }]
      - decl: [want_55, f64, 5.5]
      - if:
          condition: { neq: [prod, want_55] }
          then: [{ print: ["FAIL f64 * Ganzzahl-Literal = ${prod}, expected 5.5"] }, { set: [fails, { +: [fails, 1] }] }]

      # ── counter-probe: with cast everything stays possible as before ────
      - if:
          condition: { neq: [ratio, { cast: [small, f64] }] }
          then: []
          else: [{ print: ["FAIL cast comparison: 2.75 must not be 0.5"] }, { set: [fails, { +: [fails, 1] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["mixed_operand_literal FAIL — ${fails} Fall(e)"] }, { return: 1 }]
      - print: ["PASS mixed_operand_literal"]
      - return: 0
