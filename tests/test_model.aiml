# SPEC?: 15_models   # derived from the file name, to be confirmed
# Test: model: with primary_key + Store<T>.get_by_key
# Expected exit code: 0

# String primary key
- model:
    name: User
    primary_key: username
    fields: [[username, string], [score, i32]]

- decl: [users, Store<User>]
- set: [users, { call: [db.open, "users"] }]

- decl: [var_u, User]
- set: [var_u.username, "alice"]
- set: [var_u.score, 100]
- call: [users.insert, var_u]

- set: [var_u.username, "bob"]
- set: [var_u.score, 200]
- call: [users.insert, var_u]

- decl: [found, ptr<User>]
- set: [found, { call: [users.get_by_key, "alice"] }]
- print: ["alice score: ${found.score}"]

- set: [found, { call: [users.get_by_key, "bob"] }]
- print: ["bob score: ${found.score}"]

# Integer primary key
- model:
    name: Item
    primary_key: item_id
    fields: [[item_id, i32], [value, i32]]

- decl: [items, Store<Item>]
- set: [items, { call: [db.open, "items"] }]

- decl: [var_it, Item]
- set: [var_it.item_id, 42]
- set: [var_it.value, 999]
- call: [items.insert, var_it]

- set: [var_it.item_id, 7]
- set: [var_it.value, 777]
- call: [items.insert, var_it]

- decl: [var_fi, ptr<Item>]
- set: [var_fi, { call: [items.get_by_key, 7] }]
- print: ["item 7 value: ${var_fi.value}"]
