# SPEC: 61_memory_management
# Requires: library
# ═══════════════════════════════════════════════════════════════════════════
#  DESIGN DRAFT — model-bound + cascade prefabs.  Does not run until the runtime can do it.
# ═══════════════════════════════════════════════════════════════════════════
#
# Problem
# ───────
# The card editor has cascades.  "Effect = Modify Stat" opens 4 more
# fields [OwnerType, AttributeType, ValueType, DurationType].  Each of them
# is itself an enum again.  ValueType has "Fixed" → 1 numeric.  If one
# chooses "Equal to Dice Roll" instead → 2 numeric (COUNT, SIDES).  If one
# chooses "Equal to Attribute" → another dropdown (AttributeType).  If one chooses
# "Equal to Cards on Deck" → [DeckType, OwnerType].  DurationType is
# nested just as deeply: "Turns" → ValueType (recursive!), "Next Turn
# Phase" → GamePhase.
#
# A flat model with `trigger_p0, trigger_p1, effect_p0..p3` is not enough,
# because the meaning of the slots changes depending on the parent node.  We need
# a concept for "this enum has different payloads depending on the node".  Those
# are ALGEBRAIC DATA TYPES / TAGGED UNIONS / SUM TYPES — called a "cascade" here,
# because that is exactly what the UI is called: a choice on one level opens the
# next level.
#
# ─── 1) CASCADE: ENUM WITH A PAYLOAD PER NODE ───────────────────────────────
#
# A new top-level construct.  Every node carries: bytecode ID + a list of
# typed fields.  A field can be a primitive type, another cascade,
# an enum or a "plain" model.
#
# COMPACT SIGNATURE NOTATION
# ──────────────────────────
# Instead of writing out every node with `bytecode:` + `fields:` (which effectively
# doubles the cascade matrix — once as a bytecode comment,
# once as an AIML structure), cascade supports a compact line
# form that corresponds 1:1 to the bytecode comment in sources/models/bytecode_enums.aiml:
#
#
#     - <node_name>: [<bytecode_id>, <field1_type>, <field2_type>, ...]
#
# If the field type is a known type (enum, cascade, model, primitive)
# → it is used.  If the field type is a "role alias" (VALUE, COUNT,
# SIDES) → it is treated as i32 with a matching label ("Value"/"Count"/"Sides").
#
# Field names are generated automatically for the compact form:
#   • from the type name: DeckType → "deck", GamePhase → "phase", ValueType → "value"
#   • on a collision suffix _0/_1/…: [GameZone, GameZone] → zone_0, zone_1
#   • for a role alias: VALUE → "value", COUNT → "count", SIDES → "sides"
#
# Whoever wants named fields or default values can also use the
# verbose `{bytecode: N, fields: [...]}` form per node.

- cascade:
    name: ValueType
    nodes:
      - fixed:                  [1, VALUE]                    # [1, i32→"value"]
      - equal_to_mana_cost:     [2]
      - equal_to_attribute:     [3, AttributeType]
      - equal_to_cards_on_deck: [4, DeckType, OwnerType]
      - equal_to_cards_in_zone: [5, GameZone, OwnerType]
      - equal_to_cards_in_hand: [6, OwnerType]
      - equal_to_dice_roll:     [8, COUNT, SIDES]             # [8, i32, i32]
      - equal_to_manapool:      [9, ManaColor]
      - x_cost_spent:           [10, ManaColor]

- cascade:
    name: DurationType
    nodes:
      - permanent:               [1]
      - turns:                   [2, ValueType]                # rekursiv!
      - next_turn_phase:         [3, GamePhase]
      - end_of_phase:            [4, GamePhase]
      - as_long_as_equipped:     [5]
      - as_long_as_card_in_play: [6]

- cascade:
    name: TriggerCode
    nodes:
      - on_phase_start:    [1,  GamePhase]
      - on_phase_end:      [2,  GamePhase]
      - on_effect_code:    [3,  EffectCode]
      - on_card_move:      [4,  GameZone, GameZone]
      - on_attack:         [5,  OwnerType]
      - on_defend:         [6,  OwnerType]
      - on_draw:           [7,  OwnerType, DeckType]
      - on_destroy:        [8,  OwnerType, CardType]
      - on_card_played:    [9,  OwnerType, CardType]
      - on_hit:            [10, OwnerType]
      - on_kill:           [11, OwnerType]
      - on_soulmage_hit:   [12, OwnerType]
      - on_soulmage_attack:[13, OwnerType]
      - on_equip:          [14, OwnerType]
      - on_unequip:        [15, OwnerType]
      - on_drop:           [16, OwnerType, CardType]
      - on_reveal:         [17, OwnerType]
      - on_hide:           [18, OwnerType]

- cascade:
    name: EffectCode
    nodes:
      - draw_card:               [1,  DeckType, ValueType]
      - discard_card:            [2,  OwnerType, CardType, ValueType]
      - move_card:               [3,  GameZone, GameZone]
      - destroy_card:            [4,  OwnerType, CardType]
      - deal_damage:             [10, OwnerType, TargetType, ValueType]
      - heal_damage:             [11, OwnerType, TargetType, ValueType]
      - modify_stat:             [12, OwnerType, AttributeType, ValueType, DurationType]
      - add_passive_ability:     [20, PassiveAbility, OwnerType, DurationType]
      - remove_passive_ability:  [21, PassiveAbility, OwnerType, DurationType]
      - reveal_card:             [30, OwnerType, ValueType]
      - peek_hand:               [31, OwnerType, ValueType]
      - peek_deck:               [32, OwnerType, ValueType]
      - counter_spell:           [40, SpellType]
      - summon_token:            [41, CardType]
      - transform:               [42, CardType, DurationType]
      - drain_mana:              [43, ManaColor, ValueType]
      - destroy_mana:            [44, ManaColor, ValueType]
      - heal_soulmage:           [45, OwnerType, ValueType]
      - paralyze:                [46, OwnerType, DurationType]
      - revive:                  [47, OwnerType, OwnerType, GameZone, CardType]
      - counter_trap:            [48]
      - cant_be_attacked:        [49, OwnerType, DurationType]
      - soulmage_cant_be_attacked: [50, OwnerType, DurationType]
      - produce_mana:            [51, ManaColor, ValueType]

- cascade:
    name: ActivationCost
    nodes:
      - mana_cost:                [1, ManaColor, COUNT]
      - lp_cost:                  [2, COUNT]
      - drop_handcard:            [3, COUNT]
      - sacrifice:                [4, CardType, COUNT]
      - x_mana_cost:              [5, ManaColor]
      - tap_activating_creature:  [6]
      - tap_friendly_creature:    [7]
      - movement_cost:            [8, COUNT]

# ─── 1b) ROLE ALIASES ───────────────────────────────────────────────────────
#
# The abbreviations from the bytecode comments are declared as typed aliases for
# primitive types.  The compiler treats them as the underlying
# type, but the widget runtime sets the label and constraints if needed.

- alias: { name: VALUE, type: i32, label: "Value",  min: 0 }
- alias: { name: COUNT, type: i32, label: "Count",  min: 0 }
- alias: { name: SIDES, type: i32, label: "Sides",  min: 2, default: 6 }

# ─── 1c) BIDIRECTIONAL ID↔NAME↔LABEL MAP ────────────────────────────────────
#
# EVERY value (enum value OR cascade node) has three facets:
#   • id     — i32 (bytecode / serialize / wire format)
#   • name   — identifier (code references like `OwnerType.player`)
#   • label  — string (UI display in the dropdown, localised if needed)
#
# From that the compiler builds a bidirectional map (id→name, name→id,
# id→label, label→id).  The runtime uses id for serialisation, name for
# code refs, label for widget rendering.
#
# Notation as needed:
#
#   Compact (the label is auto-generated from the name: "draw_card" → "Draw Card"):
#       - enum: { name: GamePhase, values: [start, draw, mana, spell, combat, end] }
#
#   Explicit labels as a map (for titles/localisation):
#       - enum:
#           name: GamePhase
#           labels: {1: "Phase Start", 2: "Draw Phase", 3: "Mana Phase", 4: "Spell Phase", 5: "Combat Phase", 6: "End Phase"}
#
#   Full control (id + name + label):
#       - enum:
#           name: OwnerType
#           values:
#             - {id: 1, name: player,     label: "Player"}
#             - {id: 2, name: opponent,   label: "Opponent"}
#             - {id: 4, name: all_allies, label: "All Allies"}
#
# The same principle for cascade — the node name is already an identifier,
# the label is optional:
#
#     - cascade:
#         name: EffectCode
#         labels:
#           draw_card:   "Draw Card"
#           deal_damage: "Deal Damage"
#           counter_trap: "Counter Trap"
#         nodes:
#           - draw_card:   [1, DeckType, ValueType]
#           - deal_damage: [10, OwnerType, TargetType, ValueType]

# Plain enums (no payloads) — the leaves of the cascade.
# Compact form: names in lowercase_snake, labels are auto-generated
# ("start" → "Start", "all_allies" → "All Allies").  IDs start at 1 and
# count up consecutively unless specified otherwise.
- enum: { name: GamePhase,     values: [start, draw, mana, spell, combat, end] }
- enum: { name: OwnerType,     values: [player, opponent, ally, all_allies, all_players, all_opponents, equipped_card, triggering_card] }
- enum: { name: TargetType,    values: [card, soulmage, all_in_zone] }
- enum: { name: CardType,      values: [creature, item, trap, sorcery, ceremony, incantation, fate, mana, primordial, token] }
- enum: { name: DeckType,      values: [main, fate, discard, graveyard] }
- enum: { name: GameZone,      values: [hand, deck, field, mana_zone, graveyard, trap_zone, spell_stack] }
- enum: { name: AttributeType, values: [lp, atk, def, ini, mov, mor], labels: {1: "LP", 2: "ATK", 3: "DEF", 4: "INI", 5: "MOV", 6: "MOR"} }
- enum: { name: ManaColor,     values: [fire, light, shadow, forest, earth, frost, air, stars, water, amorph] }

# ─── 2) MODEL — a tree of cascade values ────────────────────────────────────
#
# An ability has 1 trigger, N effects, N costs.  The individual codes are
# `cascade<X>` — the runtime knows that it must persist "which node was chosen" +
# "its fields recursively".

- model:
    name: ActiveAbility
    fields:
      - [trigger, cascade<TriggerCode>]       # 1 Trigger
      - [effects, list<cascade<EffectCode>>]  # N Effects
      - [costs,   list<cascade<ActivationCost>>]

- model:
    name: Card
    fields:
      - [name,      string]
      - [abilities, list<ActiveAbility>]

# ─── 3) PREFAB — CASCADE WIDGET FOR VARIANT FIELDS ──────────────────────────
#
# The runtime knows the type `cascade<X>` and provides a standard
# widget for it: a root dropdown (node choice) + a dynamically filled
# children container with one widget per node field.  Nested cascades
# arise automatically and recursively.
#
# Convention:
#   • `bind: <field>` binds a child to a model field.  If the field type is cascade<X>,
#     the runtime spawns a `cascade` widget for the child.
#   • `bind_list: <list-field>` spawns one instance of `spawn:` per element.
#     For list<cascade<X>> that is enough — every child renders itself as a cascade.

- prefab:
    name: AbilityRowPrefab
    binds: ActiveAbility
    width: 900
    height: auto                # ← new: the layout decides the height
    children:
      # Trigger — 1 cascade
      - { name: trg_lbl, type: label, x: 0, y: 0, label: "Trigger" }
      - { name: trigger, type: cascade, x: 80, y: 0, bind: trigger }

      # Effects — any number.  Container with + / − buttons.
      # on_click accepts ANY instance implementing OnClick (see §5.4).
      # For standard list ops the stdlib provides directly bindable classes:
      # `ListPush<T>` and `ListPop<T>` (§5.5).  For user logic
      # `on_click: <.my_handler` can bind a method of the enclosing class.
      - { name: eff_lbl,   type: label,  x: 0,  y: 30, label: "Effects" }
      - { name: eff_plus,  type: button, x: 80, y: 30, label: "+",
          on_click: { new: ListPush<EffectCode>, target: <.effects } }
      - { name: eff_minus, type: button, x: 110, y: 30, label: "−",
          on_click: { new: ListPop<EffectCode>, target: <.effects } }
      - { name: effects,   type: container, x: 0, y: 60,
          bind_list: effects,
          spawn:     CascadeRowPrefab,
          layout:    vflow, gap: 4 }

      # Costs — beliebig viele.
      - { name: cost_lbl,   type: label,  x: 0,  y: 200, label: "Costs" }
      - { name: cost_plus,  type: button, x: 80, y: 200, label: "+",
          on_click: { new: ListPush<ActivationCost>, target: <.costs } }
      - { name: cost_minus, type: button, x: 110, y: 200, label: "−",
          on_click: { new: ListPop<ActivationCost>, target: <.costs } }
      - { name: costs,      type: container, x: 0, y: 230,
          bind_list: costs,
          spawn:     CascadeRowPrefab,
          layout:    vflow, gap: 4 }

# A "universal cascade" wrapper — the element in list<cascade<X>>.
# It is simply a cascade widget that binds the element.
- prefab:
    name: CascadeRowPrefab
    binds: cascade<any>       # any = is bound to a concrete cascade<X>
    width: 900
    height: auto
    children:
      - { name: cascade, type: cascade, x: 0, y: 0, bind: . }
      # . = the bound element itself (the prefab binds to a list item)

# ─── 4) SCREEN CLASS ────────────────────────────────────────────────────────
#
# No save/load.  No cascade reset.  The runtime keeps everything in sync.

- class:
    name: CardEditorScreen
    members:
      - [initialized, i32]
      - [scene,       prefab_instance]
      - [card,        Card]                   # Das komplette Editor-State-Modell
    methods:
      - def:
          name: init
          body:
            - if: { condition: { eq: [<.initialized, 1] }, then: [{ return }] }
            - set: [<.scene, { call: [engine.instantiate, "CardEditorScene"] }]
            # One empty ability to start with.  The container spawns the row prefab
            # because `bind_list: abilities` is coupled.
            - decl: [ab0, ActiveAbility, { new: ActiveAbility }]
            - call: [<.card.abilities.push, ab0]
            - set: [<.initialized, 1]

# ─── 5) VARIANT_CASCADE WIDGET — WHAT THE RUNTIME RENDERS ───────────────────
#
# The runtime must implement the widget type `cascade`.  For
# a field of type cascade<X>:
#
#   Header row:
#     [ node dropdown ] ← options from X.nodes[*].name
#
#   Payload rows: one widget per field of the CHOSEN node.  Field type
#   → widget type:
#     • i32           → text_input (numeric)
#     • i64/f32/f64   → text_input (numeric)
#     • string        → text_input (text)
#     • enum          → dropdown with enum.values as options
#     • cascade<Y>    → RECURSIVE: a new cascade widget, indented
#     • list<T>       → container with +/− (analogous to §3)
#     • ModelType     → grouped sub-container with one widget per field
#
#   Persistence:
#     On a node change the model field is set to the new node,
#     with default values from fields[*][2] (if defined).  The widget
#     instances for the old payload fields are destroyed, new ones spawned.
#     No manual reset needed.
#
# ─── 5.4) INTERFACE OnClick — OWN BUTTON LOGIC ─────────────────────────────
#
# on_click accepts EVERY value of type `OnClick` (interface).  That way
# the runtime does not depend on hard-coded actions and users can
# hang any logic on it without extending the prefab parser.

- interface:
    name: OnClick
    methods:
      - def: { name: fire, args: [[ctx, ClickCtx]] }

# ClickCtx carries the click environment: the widget that fired, the
# prefab instance, possibly the mouse button.  The runtime passes it automatically.
- model:
    name: ClickCtx
    fields:
      - [source_widget, string]                 # child name
      - [scene,         prefab_instance]
      - [button,        i32]                    # 0=left, 1=right, 2=middle

# ─── 5.5) STDLIB — LISTPUSH / LISTPOP / INVOKE ─────────────────────────────
#
# For the common cases the standard library provides ready-made OnClick
# implementations.  Users simply bind them with `{new: ...}`.

- class:
    name: ListPush<T>
    implements: OnClick
    members:
      - [target, list<T>]                       # shared handle (spec/61 §3: no ref<list>)
    methods:
      - def:
          name: fire
          args: [[ctx, ClickCtx]]
          body:
            - decl: [item, T, { new: T }]       # Neues Element mit Defaults
            - call: [<.target.push, item]

- class:
    name: ListPop<T>
    implements: OnClick
    members:
      - [target, list<T>]
    methods:
      - def:
          name: fire
          args: [[ctx, ClickCtx]]
          body:
            - if: { condition: { gt: [<.target.len, 0] }, then: [{ call: [<.target.pop] }] }

# Invoke — binds to a method.  For one-line logic without a class of its own.
# The prefab parser accepts method refs (<.method_name) and wraps them
# automatically in Invoke, so that prefab authors do not have to write
# `{new: Invoke, ...}`.
- class:
    name: Invoke
    implements: OnClick
    members:
      - [handler, fn(ClickCtx)]                 # Methoden-Referenz
    methods:
      - def:
          name: fire
          args: [[ctx, ClickCtx]]
          body:
            - call: [<.handler, ctx]

# ─── 5.6) EXAMPLE — OWN HANDLER METHOD ─────────────────────────────────────
#
# In the enclosing class (e.g. CardEditorScreen) the user defines a
# method with the signature `(ctx: ClickCtx)` and passes it as a method ref.
# The runtime wraps it automatically in `Invoke`.
#
#     - class:
#         name: MyEditor
#         methods:
#           - def:
#               name: on_save_clicked
#               args: [[ctx, ClickCtx]]
#               body:
#                 - call: [<.serialize_and_send]
#                 - call: [<.scene.set_text, "status_lbl", "saved"]
#
#     - prefab:
#         children:
#           - { name: save_btn, type: button, on_click: <.on_save_clicked }

# ─── 6) WHAT THE COMPILER NEEDS IN ADDITION ─────────────────────────────────
#
# 6.1 `cascade` as a top level.  The compiler emits:
#       • an enum wrapper (u8 tag) for the node choice
#       • one model per node with the fields
#       • an "any union" storage (tagged) or one ptr<> per node
#     For serialize/deserialize: the bytecode layout `[tag, field0, field1, ...]`
#     can be derived trivially from the structure.
#
# 6.2 `cascade<X>` as a field type.  Storage = { u8 tag, union<field-payloads> }
#     or { u8 tag, ptr<CascadeData> } as an opaque handle.
#
# 6.3 The prefab runtime understands `type: cascade`, `type: container`,
#     `bind:`, `bind_list:`, `spawn:`, `on_click: <OnClick instance or method ref>`.
#     Method refs are auto-wrapped in `Invoke`.
#
# 6.4 Introspection: the prefab runtime can query the cascade
#     definition from the compiler at runtime (`nodes[*].name`, `.fields`).
#     That way it knows which widgets which payload produces and how they
#     are bound.
#
# 6.5 The stdlib exposes `OnClick`, `ClickCtx`, `ListPush<T>`, `ListPop<T>`,
#     `Invoke` — the prefab runtime finds them without a user import.
#
# ─── 7) ADVANTAGES ──────────────────────────────────────────────────────────
#
# • The cascade is recursively data-modelled.  Not "aa_p0..p3 with a second use
#   depending on the trigger", but "the field has the type cascade<TriggerCode>".
# • No save/load.  The model IS the state.
# • No cascade reset.  On a node change the runtime wipes away old payload
#   widgets and spawns new ones.
# • No flat widget naming scheme.  Widgets are separated per ability instance
#   (every AbilityRow instance has its own widget instance ID).
# • Bytecode serialisation practically falls out by itself, because the structure
#   maps the signature directly.
# • Any number of abilities per card, any number of effects/costs per
#   ability, arbitrarily deep value/duration cascades — all described just by
#   `list<...>` and `cascade<...>`.
#
# ═══════════════════════════════════════════════════════════════════════════
