# SPEC?: 15_models   # aus dem Dateinamen, zu bestaetigen
# Test: model field defaults are applied on decl instancing and { new: Model }
# Expected exit code: 0

- model:
    name: ServerConfig
    fields:
      - [host, string, "localhost"]
      - [port, i32, 8080]
      - [ssl, bool, false]

- decl: [conf, ServerConfig]

- if:
    condition: { neq: [conf.host, "localhost"] }
    then:
      - print: ["FAIL decl default host: ${conf.host}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [conf.port, 8080] }
    then:
      - print: ["FAIL decl default port: ${conf.port}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [conf.ssl, false] }
    then:
      - print: ["FAIL decl default ssl"]
      - call: [sys.exit, 1]

- decl: [heap_conf, ptr<ServerConfig>, { new: ServerConfig }]

- if:
    condition: { neq: [heap_conf.host, "localhost"] }
    then:
      - print: ["FAIL new default host: ${heap_conf.host}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [heap_conf.port, 8080] }
    then:
      - print: ["FAIL new default port: ${heap_conf.port}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [heap_conf.ssl, false] }
    then:
      - print: ["FAIL new default ssl"]
      - call: [sys.exit, 1]

- set: [conf.port, 9001]
- if:
    condition: { neq: [conf.port, 9001] }
    then:
      - print: ["FAIL write after default port: ${conf.port}"]
      - call: [sys.exit, 1]

- free: [heap_conf]

# f32 defaults — stack
- model:
    name: Rates
    fields:
      - [var_lr, f32, 0.001]
      - [margin, f32, 0.5]

- decl: [var_r, Rates]
- if:
    condition: { "||": [{ "<": [var_r.var_lr, 0.0009] }, { ">": [var_r.var_lr, 0.0011] }] }
    then:
      - print: ["FAIL decl default var_lr: ${var_r.var_lr}"]
      - call: [sys.exit, 1]
- if:
    condition: { "||": [{ "<": [var_r.margin, 0.49] }, { ">": [var_r.margin, 0.51] }] }
    then:
      - print: ["FAIL decl default margin: ${var_r.margin}"]
      - call: [sys.exit, 1]

# f32 defaults — heap
- decl: [var_hr, ptr<Rates>, { new: Rates }]
- if:
    condition: { "||": [{ "<": [var_hr.var_lr, 0.0009] }, { ">": [var_hr.var_lr, 0.0011] }] }
    then:
      - print: ["FAIL new default var_lr: ${var_hr.var_lr}"]
      - call: [sys.exit, 1]
- if:
    condition: { "||": [{ "<": [var_hr.margin, 0.49] }, { ">": [var_hr.margin, 0.51] }] }
    then:
      - print: ["FAIL new default margin: ${var_hr.margin}"]
      - call: [sys.exit, 1]
- free: [var_hr]

- print: ["PASS test_model_defaults"]
