# Test: model inherits: — parent fields come first, child fields follow

- model:
    name: BaseCard
    fields:
      - [name,      string]
      - [card_type, string]
      - [mkp,       i32]

- model:
    name: CreatureCard
    inherits: BaseCard
    fields:
      - [lp,     i32]
      - [attack, i32]

- model:
    name: SpellCard
    inherits: BaseCard
    fields:
      - [spell_type, string]

- decl: [c, CreatureCard]
- set:  [c.name,      "Dragon"]
- set:  [c.card_type, "creature"]
- set:  [c.mkp,       5]
- set:  [c.lp,        30]
- set:  [c.attack,    4]
- print: ["name: ${c.name}"]
- print: ["card_type: ${c.card_type}"]
- print: ["mkp: ${c.mkp}"]
- print: ["lp: ${c.lp}"]
- print: ["attack: ${c.attack}"]

- decl: [s, SpellCard]
- set:  [s.name,       "Fireball"]
- set:  [s.card_type,  "spell"]
- set:  [s.mkp,        3]
- set:  [s.spell_type, "sorcery"]
- print: ["spell name: ${s.name}"]
- print: ["spell_type: ${s.spell_type}"]
