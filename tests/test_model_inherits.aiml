# Test: model inherits: — parent fields come first, child fields follow

- model:
    name: BaseCard
    fields:
      - [name,      string]
      - [card_type, string]
      - [mkp,       i32]

- model:
    name: CreatureCard
    inherits: BaseCard
    fields:
      - [var_lp,     i32]
      - [attack, i32]

- model:
    name: SpellCard
    inherits: BaseCard
    fields:
      - [spell_type, string]

- decl: [var_c, CreatureCard]
- set:  [var_c.name,      "Dragon"]
- set:  [var_c.card_type, "creature"]
- set:  [var_c.mkp,       5]
- set:  [var_c.var_lp,        30]
- set:  [var_c.attack,    4]
- print: ["name: ${var_c.name}"]
- print: ["card_type: ${var_c.card_type}"]
- print: ["mkp: ${var_c.mkp}"]
- print: ["var_lp: ${var_c.var_lp}"]
- print: ["attack: ${var_c.attack}"]

- decl: [var_s, SpellCard]
- set:  [var_s.name,       "Fireball"]
- set:  [var_s.card_type,  "spell"]
- set:  [var_s.mkp,        3]
- set:  [var_s.spell_type, "sorcery"]
- print: ["spell name: ${var_s.name}"]
- print: ["spell_type: ${var_s.spell_type}"]
