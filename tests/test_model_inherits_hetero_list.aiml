# SPEC: 02_types,13_cast
# static-check: off
# Test A: pure model inheritance mit heterogener list<BaseCard>.
#
# Frage: kann eine list<BaseCard> Instanzen von CreatureCard UND ManaCard
# gleichzeitig halten und beim get korrekt die base-Felder liefern?
#
# spec/02 + spec/13 §4: list<any> ist verboten — heterogen über die gemeinsame Basis list<ptr<BaseCard>>.

- model:
    name: BaseCard
    fields:
      - [nam,       string]
      - [card_type, string]
      - [mkp,       i32]

- model:
    name: CreatureCard
    inherits: BaseCard
    fields:
      - [attack,  i32]
      - [defense, i32]

- model:
    name: ManaCard
    inherits: BaseCard
    fields:
      - [provides_color,  i32]
      - [provides_amount, i32]

- class:
    name: Runner
    members:
      - [bases, list<ptr<BaseCard>>]
    methods:
      - def:
          name: run
          return: i32
          body:
            - decl: [crt, ptr<CreatureCard>, { new: CreatureCard }]
            - set: [crt.nam,       "Dragon"]
            - set: [crt.card_type, "creature"]
            - set: [crt.mkp,       5]
            - set: [crt.attack,    4]
            - set: [crt.defense,   3]
            - call: [<.bases.push, crt]
            - decl: [man, ptr<ManaCard>, { new: ManaCard }]
            - set: [man.nam,             "FireMana"]
            - set: [man.card_type,       "mana"]
            - set: [man.mkp,             1]
            - set: [man.provides_color,  0]
            - set: [man.provides_amount, 2]
            - call: [<.bases.push, man]
            - decl: [bas0, ref<BaseCard>, { call: [<.bases.get, 0] }]
            - decl: [bas1, ref<BaseCard>, { call: [<.bases.get, 1] }]
            - print: ["A[0]: name='${bas0.nam}' type='${bas0.card_type}' mkp=${bas0.mkp}"]
            - print: ["A[1]: name='${bas1.nam}' type='${bas1.card_type}' mkp=${bas1.mkp}"]
            - decl: [fails, i32, 0]
            - if:
                condition: { neq: [bas0.nam, "Dragon"] }
                then: [{ set: [fails, { +: [fails, 1] }] }]
            - if:
                condition: { neq: [bas1.nam, "FireMana"] }
                then: [{ set: [fails, { +: [fails, 1] }] }]
            - if:
                condition: { eq: [fails, 0] }
                then: [{ print: ["PASS: pure model inheritance heterogen list works"] }]
                else: [{ print: ["FAIL: ${fails} assertion(s)"] }]
            - return: fails

- def:
    name: main
    return: i32
    body:
      - decl: [rnr, ptr<Runner>, { new: Runner }]
      - return: { call: [rnr.run] }
