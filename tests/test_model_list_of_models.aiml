# SPEC?: 15_models   # derived from the file name, to be confirmed
# A model that has a LIST OF MODELS as a field — and a function
# that returns such an element with `lifetime: producer`.
#
# Regression: this combination made the compiler crash with SIGSEGV
# (found 2026-10-12 on the cosmos run record: PipelineRun.axes is
# list<PipelineAxis>).  A crash is never a permissible answer — even
# if the pattern were not supported, a diagnostic would have to come.
# Expected exit code: 0

- model:
    name: InnerAxis
    fields:
      - [name,   string]
      - [values, list<string>]

- model:
    name: OuterRun
    fields:
      - [run_id, string]
      - [axes,   list<InnerAxis>]

- def:
    name: make_axis
    args: [[axis_name, string], [first_val, string]]
    return: { type: InnerAxis, lifetime: producer }
    body:
      - decl: [axis, InnerAxis]
      - set: [axis.name, axis_name]
      - call: [axis.values.push, first_val]
      - return: axis

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [run, OuterRun]
      - set: [run.run_id, "run-1"]

      # variant A: via a local variable
      - decl: [axis_a, InnerAxis, { call: [make_axis, "arch", "x86_64"] }]
      - call: [run.axes.push, axis_a]
      # variant B: push the result directly
      - call: [run.axes.push, { call: [make_axis, "mode", "debug"] }]

      - set: [fails, { +: [fails, { call: [expect, "two axes in the model", { eq: [run.axes.len, 2] }] }] }]
      - decl: [got_a, InnerAxis, { at: [run.axes, 0] }]
      - decl: [got_b, InnerAxis, { at: [run.axes, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "first axis is called arch", { eq: [got_a.name, "arch"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "second axis is called mode", { eq: [got_b.name, "mode"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "inner list carries its value", { eq: [{ at: [got_a.values, 0] }, "x86_64"] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_model_list_of_models FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_model_list_of_models PASS"]
      - return: 0
