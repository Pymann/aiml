# SPEC: 15_models "Model Inheritance"
# EXPECTED_CODE: 1
# static-check: off
#
# A BASE value into a derived FIELD is ambiguous -- what should happen to the
# target's own fields?  The path there first freed the whole
# target memory and then only copied the prefix; the own fields
# then pointed to freed memory (SIGSEGV, measured 2026-11-21).
# Rejected instead of invented.  Allowed and tested are `decl: [x, Derived,
# base]` and the assignment to a VARIABLE (test_model_init_from_base).

- model: { name: Grund,     fields: [[kennung, string], [zahl, i32]] }
- model: { name: Erweitert, inherits: Grund, fields: [[notiz, string, "frisch"], [marken, list<string>]] }
- model: { name: Traeger,   fields: [[platz, Erweitert]] }

- def:
    name: main
    return: i32
    body:
      - decl: [basis, Grund]
      - set: [basis.kennung, "abc"]
      - decl: [trg, Traeger]
      - set: [trg.platz, basis]
      - return: 0
