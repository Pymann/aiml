# SPEC: 15_models
# Regression (heap variant): spec/15_models.md §"Default Field Initialization"
# guarantees default init "for BOTH stack decls AND { new: Model } heap
# allocations".  The existing test_model_string_field_default_init only covers
# the stack path (- decl: [x, Model]).  This test covers the HEAP path
# ({ new: Model } → ptr): unset string fields must be "", not null.
#
# Expected exit code: 0

- model:
    name: Gadget
    fields:
      - [label, string]
      - [descr, string]                 # never set → must be "", not null
      - [note,  string]                 # never set either
      - [tags,  list<string>]           # counter-probe: list default = empty

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [gad, ptr<Gadget>, { new: Gadget }]
      - set: [gad.label, "hello"]

      # the set field is correct.
      - if: { condition: { neq: [gad.label.len, 5] }, then: [{ print: ["FAIL label.len=${gad.label.len}"] }, { set: [fails, { +: [fails, 1] }] }] }
      # UNSET string fields (heap): .len must not crash, = 0.
      - if: { condition: { neq: [gad.descr.len, 0] }, then: [{ print: ["FAIL descr.len=${gad.descr.len}"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { neq: [gad.note.len, 0] }, then: [{ print: ["FAIL note.len=${gad.note.len}"] }, { set: [fails, { +: [fails, 1] }] }] }
      # counter-probe list field.
      - if: { condition: { neq: [gad.tags.len, 0] }, then: [{ print: ["FAIL tags.len=${gad.tags.len}"] }, { set: [fails, { +: [fails, 1] }] }] }
      # interpolation (strlen path) on an unset heap field.
      - decl: [joined, string, "d=[${gad.descr}]"]
      - if: { condition: { neq: [joined, "d=[]"] }, then: [{ print: ["FAIL interp='${joined}'"] }, { set: [fails, { +: [fails, 1] }] }] }

      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS model_string_default_heap_new: { new: Model } unset string fields default to \"\" (len 0)"] }]
          else: [{ print: ["FAIL model_string_default_heap_new: ${fails}"] }]
      - return: fails
