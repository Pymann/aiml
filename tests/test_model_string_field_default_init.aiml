# SPEC?: 15_models,09_strings   # derived from the file name, to be confirmed
# Regression: unset `string` fields of a model must be pre-initialised as an EMPTY string
# (""), not as a null pointer.  A string field is an
# i8* and `.len` lowers to strlen(ptr) — a null field segfaults on EVERY
# access.  Analogous to list/map fields, which default to empty containers.
#
# The bug before: the DeckEditor crashed in build_card_text, because a freshly
# built MockCard had the never set `ability_text` as null and
# `card.ability_text.len` executed strlen(null).
#
# Expected exit code: 0

- model:
    name: Widget
    fields:
      - [label, string]
      - [descr, string]                 # never set → must be "", not null
      - [tags,  list<string>]           # counter-probe: list default = empty

- def:
    name: read_len
    args: [[wid, Widget]]
    return: i32
    body:
      # by-value passing: the copy must also have valid "" fields.
      - return: wid.descr.len

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [wid, Widget]
      - set: [wid.label, "hello"]

      # the set field is correct.
      - if: { condition: { neq: [wid.label.len, 5] }, then: [{ print: ["FAIL label.len=${wid.label.len}"] }, { set: [fails, { +: [fails, 1] }] }] }
      # UNSET string field: direct .len access must not crash, = 0.
      - if: { condition: { neq: [wid.descr.len, 0] }, then: [{ print: ["FAIL descr.len=${wid.descr.len}"] }, { set: [fails, { +: [fails, 1] }] }] }
      # counter-probe list field.
      - if: { condition: { neq: [wid.tags.len, 0] }, then: [{ print: ["FAIL tags.len=${wid.tags.len}"] }, { set: [fails, { +: [fails, 1] }] }] }
      # unset field in an interpolation (strlen path too).
      - decl: [joined, string, "d=[${wid.descr}]"]
      - if: { condition: { neq: [joined, "d=[]"] }, then: [{ print: ["FAIL interp='${joined}'"] }, { set: [fails, { +: [fails, 1] }] }] }
      # by value to a function — the copy must be valid too.
      - if: { condition: { neq: [{ call: [read_len, wid] }, 0] }, then: [{ print: ["FAIL byval descr.len"] }, { set: [fails, { +: [fails, 1] }] }] }

      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS model_string_field_default_init: unset string fields default to \"\" (len 0), no null-deref"] }]
          else: [{ print: ["FAIL model_string_field_default_init: ${fails}"] }]
      - return: fails
