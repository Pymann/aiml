# SPEC?: 03_modifiers   # aus dem Dateinamen, zu bestaetigen
# Modifiers Test

- class:
    name: Bank
    members:
      - [balance, i32, 0, { access: private }]
      - [var_id, i32, 12345, { access: public, const: true }]
    methods:
      - def:
          name: deposit
          access: public
          args: [[amount, i32]]
          return: void
          body:
            # Internal access to private member allowed
            - set: [<.balance, {+: [<.balance, amount]}]
            - print: ["Deposited: ", amount]

      - def:
          name: getBalance
          access: public
          args: []
          return: i32
          body:
             - return: <.balance

- decl: [var_b, Bank] # Stack allocation, default init (var_id=12345, balance=0)

- print: ["Bank ID: ", var_b.var_id]

# Valid: Call public method
- call: [var_b.deposit, 100]
- print: ["Balance: ${ { call: [var_b.getBalance] } }"]



# Volatile Tests
- decl: [vol_var, i32, 42, { volatile: true }]
- print: ["Volatile Var initially: ", vol_var]
- set: [vol_var, 100]
- print: ["Volatile Var after set: ", vol_var]

- class:
    name: Sensor
    members:
      - [reading, i32, 0, { volatile: true, access: public }]
- decl: [var_s, Sensor]
- set: [var_s.reading, 55]
- print: ["Sensor reading: ", var_s.reading]
