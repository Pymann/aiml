# Tests for net namespace + socket_handle
# Expected exit code: 0

# ── Phase A: Lifecycle (no real network traffic) ──────────────────────────────

# socket creation → var_fd must be positive
- decl: [sock, socket_handle]
- set: [sock, { call: [net.socket, "tcp"] }]
- decl: [var_fd, i32]
- set: [var_fd, { call: [net.fd, sock] }]
- print: ["socket created (var_fd should be > 0): ${var_fd}"]
- call: [net.close, sock]

# bind to 127.0.0.1:0 (OS picks port) + listen
- decl: [srv, socket_handle]
- set: [srv, { call: [net.socket, "tcp"] }]
- decl: [brc, i32]
- set: [brc, { call: [net.bind, srv, "127.0.0.1", 0] }]
- print: ["bind_rc: ${brc}"]
- decl: [lrc, i32]
- set: [lrc, { call: [net.listen, srv, 5] }]
- print: ["listen_rc: ${lrc}"]
- call: [net.close, srv]
- print: ["lifecycle done"]

# ── Phase B: Loopback via spawn (ping/pong) ───────────────────────────────────

- def:
    name: net_server
    args: []
    body:
      - decl: [var_s, socket_handle]
      - set: [var_s, { call: [net.socket, "tcp"] }]
      - call: [net.bind, var_s, "127.0.0.1", 19876]
      - call: [net.listen, var_s, 5]
      - decl: [var_c, socket_handle]
      - set: [var_c, { call: [net.accept, var_s] }]
      - decl: [msg, string]
      - set: [msg, { call: [net.recv_string, var_c, 64] }]
      - print: ["server got: ${msg}"]
      - call: [net.send_string, var_c, "pong"]
      - call: [net.close, var_c]
      - call: [net.close, var_s]

- decl: [srv_thread, thread_handle]
- set: [srv_thread, { spawn: [net_server] }]
- call: [time.sleep_ms, 100]

- decl: [client, socket_handle]
- set: [client, { call: [net.socket, "tcp"] }]
- call: [net.connect, client, "127.0.0.1", 19876]
- call: [net.send_string, client, "ping"]
- decl: [resp, string]
- set: [resp, { call: [net.recv_string, client, 64] }]
- print: ["client got: ${resp}"]
- call: [net.close, client]

# Wait for server thread to finish (ensures its print is flushed)
- call: [srv_thread.join]

- print: ["net tests done"]
