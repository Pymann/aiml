# SPEC: 61_memory_management
# spec/61 §6 rule 1: `{ new: T }` initialises the fields "exactly like a
# stack decl".  For a `ptr<T>` field that means NULL — rule 2 strictly presupposes
# it: the release FOLLOWS every ptr<T> field, and following an unset
# field would be a jump into the unknown.
#
# Occasion: an unwired `ptr<LiveState>` member in the cosmos client passed
# `pneq null` and dragged the next call down with it (SIGSEGV at addr=0x8).
# Expected exit code: 0

- class:
    name: Payload
    members:
      - [count, i32]

- class:
    name: Holder
    members:
      - [tag,     string]
      - [numbers, list<i32>]
      - [linked,  ptr<Payload>]
      - [plain,   i32]

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      # 1) on the stack
      - decl: [stacked, Holder]
      - if: { condition: { pneq: [stacked.linked, null] }, then: [{ print: ["FAIL stack: ptr field is not null"] }, { set: [fails, 1] }] }
      - if: { condition: { neq: [stacked.plain, 0] }, then: [{ print: ["FAIL stack: i32 field is not 0"] }, { set: [fails, 1] }] }
      - if: { condition: { neq: [stacked.tag.len, 0] }, then: [{ print: ["FAIL stack: string field is not empty"] }, { set: [fails, 1] }] }
      - if: { condition: { neq: [stacked.numbers.len, 0] }, then: [{ print: ["FAIL stack: list is not empty"] }, { set: [fails, 1] }] }
      # 2) on the heap — the same defaults (spec/61 §6 rule 1)
      - decl: [boxed, ptr<Holder>, { new: Holder }]
      - if: { condition: { pneq: [boxed.linked, null] }, then: [{ print: ["FAIL new: ptr field is not null"] }, { set: [fails, 1] }] }
      - if: { condition: { neq: [boxed.plain, 0] }, then: [{ print: ["FAIL new: i32 field is not 0"] }, { set: [fails, 1] }] }
      - if: { condition: { neq: [boxed.tag.len, 0] }, then: [{ print: ["FAIL new: string field is not empty"] }, { set: [fails, 1] }] }
      - if: { condition: { neq: [boxed.numbers.len, 0] }, then: [{ print: ["FAIL new: list is not empty"] }, { set: [fails, 1] }] }
      - if: { condition: { eq: [fails, 0] }, then: [{ print: ["PASS new_ptr_member_null"] }, { return: 0 }] }
      - return: 1
