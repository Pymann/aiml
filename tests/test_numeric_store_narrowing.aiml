# SPEC: 13_cast
# spec/13 §6: eine REALZAHL in einen Ganzzahl-Slot konvertiert den WERT (Abschneiden
# gegen Null) -- auf JEDEM Speicherpfad, so wie die Gegenrichtung in
# tests/test_numeric_store_widening.aiml.
#
# Vier Pfade schrieben bis 2026-11-12 das BITMUSTER statt des Werts: Member-Store
# (`set: [m.feld, <f32>]`), Member-Pfad beim `idx:`, list<T>-Element und dyn_array.
# Unter Opaque Pointers ist so ein Store gueltiges IR -- der Verifier schwieg, und
# `100.0` kam als 1120403456 im Feld an (gemessen in datacreatures: Fundvorschau).
# Expected exit code: 0

- model: { name: Sample, fields: [[count, i32], [wide, i64]] }
- class:
    name: Holder
    members: [[kept, i32]]
    methods:
      - def:
          name: put
          access: public
          args: [[num, f32]]
          body:
            - set: [<.kept, num]
      - def:
          name: value
          access: public
          return: i32
          body:
            - return: <.kept
      - def:
          name: make
          access: public
          args: [[num, f32]]
          return: Sample
          body:
            - decl: [out, Sample]
            - set: [out.count, num]
            - return: out
- def:
    name: expect
    args: [[got, i64], [want, i64], [what, string]]
    body:
      - if:
          condition: { neq: [got, want] }
          then:
            - call: [log.error, "FAIL ${what}: ${got} != ${want}"]
            - call: [sys.exit, 1]
- def:
    name: main
    return: i32
    body:
      - decl: [ratio, f32, 3.75]
      - decl: [minus, f64, -2.5]
      - decl: [drei, i64, 3]
      - decl: [zwei_neg, i64, -2]

      # --- Pfade, die es schon konnten ---
      - decl: [vom_decl, i32, ratio]
      - call: [expect, vom_decl, drei, "decl init"]
      - decl: [lokal, i32, 0]
      - set: [lokal, ratio]
      - call: [expect, lokal, drei, "set local"]
      - decl: [feld, "array<i32:3>"]
      - idx: [feld, 0, ratio]
      - call: [expect, { at: [feld, 0] }, drei, "idx array element"]

      # --- Pfade, die das Bitmuster schrieben ---
      - decl: [smp, Sample]
      - set: [smp.count, ratio]
      - call: [expect, smp.count, drei, "set member i32"]
      - set: [smp.wide, ratio]
      - call: [expect, smp.wide, drei, "set member i64"]
      - set: [smp.count, minus]
      - call: [expect, smp.count, zwei_neg, "set member, negativ (gegen Null)"]

      - decl: [halter, Holder]
      - call: [halter.put, ratio]
      - call: [expect, { call: [halter.value] }, drei, "set <.member in Methode"]
      - decl: [gebaut, Sample, { call: [halter.make, ratio] }]
      - call: [expect, gebaut.count, drei, "set member eines Rueckgabewerts"]

      - decl: [zahlen, list<i32>]
      - call: [zahlen.push, 0]
      - idx: [zahlen, 0, ratio]
      - call: [expect, { at: [zahlen, 0] }, drei, "idx list<i32> element"]

      - decl: [reihen, list<Sample>]
      - call: [reihen.push, smp]
      - idx: [reihen, 0, .count, ratio]
      - call: [expect, { at: [reihen, 0, .count] }, drei, "idx Member-Pfad"]

      - decl: [dyn, "dyn_array<i32>", { new_array: [i32, 4] }]
      - idx: [dyn, 0, ratio]
      - call: [expect, { at: [dyn, 0] }, drei, "idx dyn_array element"]

      - call: [log.info, "PASS numeric_store_narrowing"]
      - return: 0
