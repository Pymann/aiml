# SPEC: 18_instantiation,18_refs_and_pointers
# static-check: off

# 1. Define Interface
- interface:
    name: Printable
    methods:
      - [print, void, []]

# 2. Define Model (Mixin)
- model:
    name: Point2D
    fields:
      - [var_x, i32, 10]
      - [var_y, i32, 20]

# 3. Define Base Class
- class:
    name: Shape
    members:
      - [var_id, i32, 1]
    methods:
      - def: { name: getId, return: i32, args: [], body: [ { return: [<.var_id] } ] }

# 4. Define Child Class with Inheritance and Mixin
- class:
    name: Circle
    extends: Shape
    models: [Point2D]
    implements: [Printable]
    members:
      - [radius, i32, 5]
    methods:
      - def: 
          name: print
          return: void
          args: []
          body:
            - print: ["Circle ID: ${<.var_id}, Pos: (${<.var_x}, ${<.var_y}), Radius: ${<.radius}"]

# 5. Test Instantiation and Methods
- decl: [var_c, ptr<Circle>]            # spec/18: the owner of a `new` allocation is ptr<T>
- set: [var_c, { new: Circle }]

- print: ["Testing OO Features..."]
- call: [var_c.print]

# Test inherited method
- decl: [shapeId, i32]
- set: [shapeId, { call: [var_c.getId] }]
- print: ["Shape ID (Inherited): ${shapeId}"]

# Test Mixin fields
- print: ["Mixin Field X: ${var_c.var_x}"]

- free: [var_c]
