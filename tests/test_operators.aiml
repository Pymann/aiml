# Tests for operator rework: eq/neq/lt/gt/lte/gte/peq/pneq + __eq__ overload
# Expected exit code: 0

# ── Phase A: eq / neq (integer) ───────────────────────────────────────────────

- decl: [var_a, i32, 5]
- decl: [var_b, i32, 5]
- decl: [var_c, i32, 7]

- if:
    condition: { neq: [var_a, var_b] }
    then:
      - print: ["FAIL A1: eq integer"]
      - call: [sys.exit, 1]

- if:
    condition: { eq: [var_a, var_c] }
    then:
      - print: ["FAIL A2: neq integer"]
      - call: [sys.exit, 1]

- print: ["A ok: eq/neq integer"]

# ── Phase B: eq / neq (string content) ────────────────────────────────────────

- decl: [var_s1, string, "hello"]
- decl: [var_s2, string, "hello"]
- decl: [var_s3, string, "world"]

- if:
    condition: { neq: [var_s1, var_s2] }
    then:
      - print: ["FAIL B1: eq string content"]
      - call: [sys.exit, 1]

- if:
    condition: { eq: [var_s1, var_s3] }
    then:
      - print: ["FAIL B2: neq string content"]
      - call: [sys.exit, 1]

- print: ["B ok: eq/neq string"]

# ── Phase C: lt / gt / lte / gte ─────────────────────────────────────────────

- decl: [var_x, i32, 3]
- decl: [var_y, i32, 7]

- if:
    condition: { gt: [var_x, var_y] }
    then:
      - print: ["FAIL C1: lt"]
      - call: [sys.exit, 1]

- if:
    condition: { lt: [var_y, var_x] }
    then:
      - print: ["FAIL C2: gt"]
      - call: [sys.exit, 1]

- if:
    condition: { gte: [var_x, var_y] }
    then:
      - print: ["FAIL C3: lte"]
      - call: [sys.exit, 1]

- if:
    condition: { lte: [var_y, var_x] }
    then:
      - print: ["FAIL C4: gte"]
      - call: [sys.exit, 1]

# boundary: var_x lte var_x (should be true — if var_x > var_x that is false, so no fail)
- if:
    condition: { gt: [var_x, var_x] }
    then:
      - print: ["FAIL C5: lte equal"]
      - call: [sys.exit, 1]

# boundary: var_x gte var_x (should be true — if var_x < var_x that is false, so no fail)
- if:
    condition: { lt: [var_x, var_x] }
    then:
      - print: ["FAIL C6: gte equal"]
      - call: [sys.exit, 1]

- print: ["C ok: lt/gt/lte/gte"]

# ── Phase D: peq / pneq (pointer identity) ────────────────────────────────────

- decl: [var_p1, string, "same"]
- decl: [var_p2, string, "same"]
- decl: [var_p3, string, "other"]

# var_p1 eq var_p2 => true (content)  but peq may differ (different alloca/ptrs)
# peq var_p1 var_p1 must be true (same pointer)
- if:
    condition: { pneq: [var_p1, var_p1] }
    then:
      - print: ["FAIL D1: peq self"]
      - call: [sys.exit, 1]

# pneq var_p1 var_p3 should be true (different allocations)
- if:
    condition: { peq: [var_p1, var_p3] }
    then:
      - print: ["FAIL D2: pneq different"]
      - call: [sys.exit, 1]

- print: ["D ok: peq/pneq"]

# ── Phase E: __eq__ overload on class ─────────────────────────────────────────

- class:
    name: Point
    members:
      - [var_px, i32]
      - [var_py, i32]
    methods:
      - def:
          name: __eq__
          args: [[other, ref<Point>]]
          return: i32
          body:
            - if:
                condition: { neq: [<.var_px, other.var_px] }
                then:
                  - return: [0]
            - if:
                condition: { neq: [<.var_py, other.var_py] }
                then:
                  - return: [0]
            - return: [1]

- decl: [pt1, Point]
- set: [pt1.var_px, 3]
- set: [pt1.var_py, 4]

- decl: [pt2, Point]
- set: [pt2.var_px, 3]
- set: [pt2.var_py, 4]

- decl: [pt3, Point]
- set: [pt3.var_px, 1]
- set: [pt3.var_py, 2]

- if:
    condition: { neq: [pt1, pt2] }
    then:
      - print: ["FAIL E1: __eq__ same values"]
      - call: [sys.exit, 1]

- if:
    condition: { eq: [pt1, pt3] }
    then:
      - print: ["FAIL E2: __eq__ different values"]
      - call: [sys.exit, 1]

- print: ["E ok: __eq__ overload"]

- print: ["All operator tests passed."]
