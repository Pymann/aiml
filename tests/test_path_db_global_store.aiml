# SPEC?: 31_db_integration,42_path_type   # derived from the file name, to be confirmed
# Compare top-level/global path variable usage in db.open Store<T>.
# Expected exit code: 0

- class:
    name: GlobalStorePlayer
    members: [[score, i32], [level, i32]]

- decl: [db_dir, path]
- set: [db_dir, "/tmp/aiml_test_path_db_global_store/"]
- call: [io.remove_all, db_dir]

- decl: [players, Store<GlobalStorePlayer>]
- set: [players, { call: [db.open, "path_db_global_store", {persist: true, path: db_dir}] }]

- decl: [var_p, GlobalStorePlayer]
- set: [var_p.score, 101]
- set: [var_p.level, 7]

- decl: [var_id, i32]
- set: [var_id, { call: [players.insert, var_p] }]
- print: ["global_store_id=${var_id}"]

- decl: [var_n, i32]
- set: [var_n, { call: [players.len] }]
- print: ["global_store_len=${var_n}"]

- decl: [got, ref<GlobalStorePlayer>]
- set: [got, { call: [players.get, var_id] }]
- if:
    condition: { eq: [got, null] }
    then:
      - print: ["FAIL global_store_get=null"]
      - call: [sys.exit, 1]

- print: ["global_store_score=${got.score} level=${got.level}"]

- decl: [var_cp, i32]
- set: [var_cp, { call: [db.checkpoint] }]
- print: ["global_store_checkpoint=${var_cp}"]
