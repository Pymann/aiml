# SPEC?: 31_db_integration,42_path_type   # derived from the file name, to be confirmed
# Minimal repro for relative path + top-level Store<T> persist.
# Expected exit code: 0

- class:
    name: RelativeStorePlayer
    members: [[score, i32], [level, i32]]

- decl: [db_dir, path]
- set: [db_dir, "./aiondb_rel_global/"]
- call: [io.remove_all, db_dir]

- decl: [players, Store<RelativeStorePlayer>]
- set: [players, { call: [db.open, "players_rel_global", {persist: true, path: db_dir}] }]

- decl: [var_p, RelativeStorePlayer]
- set: [var_p.score, 314]
- set: [var_p.level, 15]

- decl: [var_id, i32]
- set: [var_id, { call: [players.insert, var_p] }]
- print: ["rel_global_id=${var_id}"]

- decl: [var_n, i32]
- set: [var_n, { call: [players.len] }]
- print: ["rel_global_len=${var_n}"]

- decl: [got, ref<RelativeStorePlayer>]
- set: [got, { call: [players.get, var_id] }]
- if:
    condition: { eq: [got, null] }
    then:
      - print: ["FAIL rel_global_get=null"]
      - call: [sys.exit, 1]

- print: ["rel_global_score=${got.score} level=${got.level}"]

- decl: [var_cp, i32]
- set: [var_cp, { call: [db.checkpoint] }]
- print: ["rel_global_checkpoint=${var_cp}"]
