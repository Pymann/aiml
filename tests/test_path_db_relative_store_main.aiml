# Minimal repro for relative path + def main Store<T> persist.
# Expected exit code: 0

- class:
    name: RelativeMainPlayer
    members: [[score, i32], [level, i32]]

- def:
    name: main
    return: i32
    body:
      - decl: [db_dir, path, "./aiondb_rel_main/"]
      - call: [io.remove_all, db_dir]

      - decl: [players, Store<RelativeMainPlayer>]
      - set: [players, { call: [db.open, "players_rel_main", {persist: true, path: db_dir}] }]

      - decl: [var_p, RelativeMainPlayer]
      - set: [var_p.score, 271]
      - set: [var_p.level, 82]

      - decl: [var_id, i32]
      - set: [var_id, { call: [players.insert, var_p] }]
      - print: ["rel_main_id=${var_id}"]

      - decl: [var_n, i32]
      - set: [var_n, { call: [players.len] }]
      - print: ["rel_main_len=${var_n}"]

      - decl: [got, ptr<RelativeMainPlayer>]
      - set: [got, { call: [players.get, var_id] }]
      - if:
          condition: { eq: [got, null] }
          then:
            - print: ["FAIL rel_main_get=null"]
            - call: [sys.exit, 1]

      - print: ["rel_main_score=${got.score} level=${got.level}"]

      - decl: [var_cp, i32]
      - set: [var_cp, { call: [db.checkpoint] }]
      - print: ["rel_main_checkpoint=${var_cp}"]
      - return: 0
