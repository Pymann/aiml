# Extended tests for the built-in path type.
# Expected exit code: 0

- def:
    name: main
    return: i32
    body:
      - decl: [base, path, "/tmp/aiml_path_suite/base"]
      - decl: [child, path]
      - set: [child, { call: [base.join, "cards.json"] }]
      - decl: [child_s, string]
      - set: [child_s, { call: [child.to_string] }]
      - if:
          condition: { "==": [{ eq: [child_s, "/tmp/aiml_path_suite/base/cards.json"] }, 0] }
          then:
            - print: ["FAIL join_to_string=${child_s}"]
            - call: [sys.exit, 1]

      - decl: [parent, path]
      - set: [parent, { call: [child.parent] }]
      - if:
          condition: { "==": [{ eq: [parent, "/tmp/aiml_path_suite/base"] }, 0] }
          then:
            - print: ["FAIL parent=${parent}"]
            - call: [sys.exit, 1]

      - decl: [rel, path]
      - set: [rel, { call: [child.relative_to, base] }]
      - if:
          condition: { "==": [{ eq: [rel, "cards.json"] }, 0] }
          then:
            - print: ["FAIL relative_to=${rel}"]
            - call: [sys.exit, 1]

      - decl: [joined_ok, path]
      - set: [joined_ok, { call: [base.safe_join, "nested/../deck.txt"] }]
      - if:
          condition: { "==": [{ eq: [joined_ok, "/tmp/aiml_path_suite/base/deck.txt"] }, 0] }
          then:
            - print: ["FAIL safe_join_ok=${joined_ok}"]
            - call: [sys.exit, 1]

      - decl: [cfg_dir, path]
      - set: [cfg_dir, { call: [path.config_dir, "aiml_path_suite"] }]
      - decl: [cfg_name, string]
      - set: [cfg_name, { call: [cfg_dir.name] }]
      - if:
          condition: { "==": [{ eq: [cfg_name, "aiml_path_suite"] }, 0] }
          then:
            - print: ["FAIL config_dir_name=${cfg_name}"]
            - call: [sys.exit, 1]

      - decl: [cfg_abs, i32]
      - set: [cfg_abs, { call: [cfg_dir.is_absolute] }]
      - if:
          condition: { "!=": [cfg_abs, 1] }
          then:
            - print: ["FAIL config_dir_abs=${cfg_abs}"]
            - call: [sys.exit, 1]

      - decl: [tmpdir, path]
      - set: [tmpdir, { call: [path.temp_dir] }]
      - decl: [tmp_abs, i32]
      - set: [tmp_abs, { call: [tmpdir.is_absolute] }]
      - if:
          condition: { "!=": [tmp_abs, 1] }
          then:
            - print: ["FAIL temp_dir_abs=${tmp_abs}"]
            - call: [sys.exit, 1]

      - decl: [exe, path]
      - set: [exe, { call: [path.current_exe] }]
      - decl: [exe_is_file, i32]
      - set: [exe_is_file, { call: [io.is_file, exe] }]
      - if:
          condition: { "!=": [exe_is_file, 1] }
          then:
            - print: ["FAIL current_exe_is_file=${exe_is_file} exe=${exe}"]
            - call: [sys.exit, 1]

      - decl: [suite_dir, path]
      - set: [suite_dir, "/tmp/aiml_path_suite_io"]
      - call: [io.remove_all, suite_dir]
      - decl: [mk_rc, i32]
      - set: [mk_rc, { call: [io.mkdir_all, suite_dir] }]
      - if:
          condition: { "!=": [mk_rc, 0] }
          then:
            - print: ["FAIL mkdir_all=${mk_rc}"]
            - call: [sys.exit, 1]

      - decl: [out_file, path]
      - set: [out_file, { call: [suite_dir.join, "state.txt"] }]
      - decl: [wrc, i32]
      - set: [wrc, { call: [io.write_file, out_file, "path-suite"] }]
      - if:
          condition: { "!=": [wrc, 0] }
          then:
            - print: ["FAIL write_file=${wrc}"]
            - call: [sys.exit, 1]

      - decl: [exists_file, i32]
      - set: [exists_file, { call: [io.exists, out_file] }]
      - decl: [is_file, i32]
      - set: [is_file, { call: [io.is_file, out_file] }]
      - decl: [is_dir, i32]
      - set: [is_dir, { call: [io.is_dir, suite_dir] }]
      - if:
          condition: { "!=": [exists_file, 1] }
          then:
            - print: ["FAIL exists_file=${exists_file}"]
            - call: [sys.exit, 1]
      - if:
          condition: { "!=": [is_file, 1] }
          then:
            - print: ["FAIL is_file=${is_file}"]
            - call: [sys.exit, 1]
      - if:
          condition: { "!=": [is_dir, 1] }
          then:
            - print: ["FAIL is_dir=${is_dir}"]
            - call: [sys.exit, 1]

      - decl: [content, string]
      - set: [content, { call: [io.read_file, out_file] }]
      - if:
          condition: { "==": [{ eq: [content, "path-suite"] }, 0] }
          then:
            - print: ["FAIL read_file=${content}"]
            - call: [sys.exit, 1]

      - print: ["path extended PASS"]
      - return: 0
