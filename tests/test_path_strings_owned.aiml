# SPEC: 42_path_type,61_memory_management
# spec/42 + spec/61 §7: path.name/stem/extension/to_string return an owned rc string — bound,
# reassigned, interpolated and dropped repeatedly without leak or header misread (valgrind clean).
# Expected exit code: 0
- class:
    name: Splitter
    members: [[calls, i32]]
    methods:
      - def:
          name: describe
          access: public
          args: [[text, string]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [src, path, text]
            - decl: [base, string, { call: [src.stem] }]
            - decl: [ext, string, { call: [src.extension] }]
            - set: [base, { call: [src.name] }]
            - decl: [full, string, { call: [src.to_string] }]
            - set: [<.calls, { +: [<.calls, 1] }]
            - return: "${base}|${ext}|${full}"
- def:
    name: main
    return: i32
    body:
      - decl: [splitter, ptr<Splitter>, { new: Splitter }]
      - decl: [round, i32, 0]
      - while:
          condition: { lt: [round, 50] }
          body:
            - decl: [one, string, { call: [splitter.describe, "models/a/scout_bot.yaml"] }]
            - if: { condition: { neq: [one, "scout_bot.yaml|.yaml|models/a/scout_bot.yaml"] }, then: [{ print: ["FAIL one '${one}'"] }, { return: 1 }] }
            - decl: [two, string, { call: [splitter.describe, "noext"] }]
            - if: { condition: { neq: [two, "noext||noext"] }, then: [{ print: ["FAIL two '${two}'"] }, { return: 1 }] }
            - decl: [src, path, "dir/file.tar.gz"]
            - decl: [stem_txt, string, { call: [src.stem] }]
            - if: { condition: { neq: [stem_txt, "file.tar"] }, then: [{ print: ["FAIL stem '${stem_txt}'"] }, { return: 1 }] }
            - set: [round, { +: [round, 1] }]
      - print: ["PASS path_strings_owned"]
      - return: 0
