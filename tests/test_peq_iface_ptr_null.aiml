# SPEC?: 18_refs_and_pointers   # derived from the file name, to be confirmed
# static-check: off
# BUG repro: peq/pneq on an INTERFACE pointer (fat pointer
# AimlFatPtr_<Iface> = {obj, vtable}) against null makes the compiler crash with an
# LLVM assertion ("Both operands to ICmp instruction are not of the
# same type") — peq builds ICmpEQ(struct, ptr).  peq/pneq would have to extract the obj part
# of the fat pointer and compare it against null.
#
# Motivation: CardService.get_base(...) → ptr<CardBase>, null when not found;
# the caller needs `peq [base, null]`.
#
# Expectation after the fix: compiles; a freshly allocated iface ptr is
# NOT null, a `return: null` iface ptr IS null.

- interface: { name: Speak, methods: [[word, i32, []]] }
- model: { name: SpkData, fields: [[num, i32]] }
- class:
    name: Spk
    models: [SpkData]
    implements: [Speak]
    methods:
      - def: { name: word, return: i32, body: [{ return: <.num }] }

- def:
    name: maybe
    args: [[give, i32]]
    return: ptr<Speak>
    body:
      - if: { condition: { eq: [give, 0] }, then: [{ return: null }] }
      - decl: [obj, ptr<Spk>, { new: Spk }]
      - return: obj

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [some, ptr<Speak>, { call: [maybe, 1] }]
      - decl: [none, ptr<Speak>, { call: [maybe, 0] }]
      - if: { condition: { peq: [some, null] }, then: [{ print: ["FAIL some is null"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if: { condition: { pneq: [none, null] }, then: [{ print: ["FAIL none is not null"] }, { set: [fails, { +: [fails, 1] }] }] }
      - if:
          condition: { eq: [fails, 0] }
          then: [{ print: ["PASS peq_iface_ptr_null: fat-pointer null comparison works"] }]
          else: [{ print: ["FAIL peq_iface_ptr_null: ${fails}"] }]
      - return: fails
