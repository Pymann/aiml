# SPEC?: 31_db_integration   # derived from the file name, to be confirmed
# Test: db.open_kv {persist: true} + db.open_timeseries {persist: true}
# Expected exit code: 0

# ── Phase A: Persistent Kv ────────────────────────────────────────────────────

- decl: [cfg, Kv<string:string>]
- set: [cfg, { call: [db.open_kv, "persist_cfg", {persist: true}] }]

- call: [cfg.set, "mode", "fast"]
- call: [cfg.set, "debug", "true"]

- decl: [var_v, string]
- set: [var_v, { call: [cfg.get, "mode"] }]
- print: ["mode: ${var_v}"]

- decl: [has, i32]
- set: [has, { call: [cfg.has, "debug"] }]
- print: ["has debug: ${has}"]

- decl: [klen, i32]
- set: [klen, { call: [cfg.len] }]
- print: ["kv len: ${klen}"]

# delete + verify
- call: [cfg.delete, "debug"]
- set: [has, { call: [cfg.has, "debug"] }]
- print: ["has after del: ${has}"]

# clear + verify
- call: [cfg.set, "x", "1"]
- call: [cfg.clear]
- set: [klen, { call: [cfg.len] }]
- print: ["kv after clear: ${klen}"]

# ── Phase B: Persistent TimeSeries ───────────────────────────────────────────

- class:
    name: Reading
    members: [[val, i32]]

- decl: [var_ts, TimeSeries<Reading>]
- set: [var_ts, { call: [db.open_timeseries, "persist_ts", {persist: true}] }]

- decl: [var_r, Reading]
- set: [var_r.val, 42]
- call: [var_ts.append, var_r, 1000]

- set: [var_r.val, 99]
- call: [var_ts.append, var_r, 2000]

- set: [var_r.val, 7]
- call: [var_ts.append, var_r, 3000]

- decl: [tlen, i32]
- set: [tlen, { call: [var_ts.len] }]
- print: ["var_ts len: ${tlen}"]

- decl: [var_tp, ref<Reading>]
- set: [var_tp, { call: [var_ts.at, 1500] }]
- print: ["at 1500: ${var_tp.val}"]

- set: [var_tp, { call: [var_ts.at, 2500] }]
- print: ["at 2500: ${var_tp.val}"]

# checkpoint flushes both
- decl: [var_rc, i32]
- set: [var_rc, { call: [db.checkpoint] }]
- print: ["checkpoint var_rc: ${var_rc}"]
