# SPEC: 62_pipelines
# spec/62 §5.2: a subset of the axes in `args` is the POINT, not
# carelessness.  The key only carries the DECLARED bindings (§8),
# so a step that does not use an axis does not rerun when it changes
# either — a result is shared across those lanes.
#
# The flip side is checked too: whoever declares axes they do not need
# LOSES the reuse (F62-32 reasoning).  Hence three identical
# bodies that differ ONLY in the declared axes:
#   no axis      -> once for the whole matrix
#   only arch    -> once per arch
#   arch + mode  -> every lane individually
# Expected exit code: 0

- def:
    name: noop_step
    return: i32
    body: [{ return: 0 }]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# two_axis: 2x2 = four lanes.  `declare` chooses which axes the step
# declares: 0 = none, 1 = only arch, 2 = arch and mode.
- def:
    name: two_axis
    args: [[declare, i32]]
    return: pipeline
    body:
      - decl: [stp, step, { call: [step.new] }]
      - call: [stp.set_name, "work"]
      - call: [stp.set_body, { call: [sys.bundle, "noop_step", { context: true }] }]
      - call: [stp.set_cache, CacheClass.pure]
      - if: { condition: { ge: [declare, 1] }, then: [{ call: [stp.use_arg, "arch"] }] }
      - if: { condition: { ge: [declare, 2] }, then: [{ call: [stp.use_arg, "mode"] }] }
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "only"]
      - call: [stg.add_step, stp]
      - decl: [arch, list<string>]
      - call: [arch.push, "x86_64"]
      - call: [arch.push, "arm64"]
      - decl: [mode, list<string>]
      - call: [mode.push, "debug"]
      - call: [mode.push, "release"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "subset"]
      - call: [pipe.add_param, "arch", arch]
      - call: [pipe.add_param, "mode", mode]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── no axis declared: once for the whole matrix ─────────────────────
      - decl: [p_none, pipeline, { call: [two_axis, 0] }]
      - set: [fails, { +: [fails, { call: [expect, "2x2 gives four lanes", { eq: [{ call: [p_none.lane_count] }, 4] }] }] }]
      - decl: [rc_n, i32, { call: [p_none.run] }]
      - set: [fails, { +: [fails, { call: [expect, "without axes: the run succeeds", { eq: [rc_n, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "without axes: executed ONCE", { eq: [{ call: [p_none.ran_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "without axes: three lanes share the result", { eq: [{ call: [p_none.reused_count] }, 3] }] }] }]

      # ── only arch declared: a mode change changes nothing ───────────────
      - decl: [p_arch, pipeline, { call: [two_axis, 1] }]
      - decl: [rc_a, i32, { call: [p_arch.run] }]
      - set: [fails, { +: [fails, { call: [expect, "only arch: the run succeeds", { eq: [rc_a, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "only arch: executed once per arch", { eq: [{ call: [p_arch.ran_count] }, 2] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "only arch: mode change hits", { eq: [{ call: [p_arch.reused_count] }, 2] }] }] }]

      # ── both axes declared: no more reuse ───────────────────────────────
      - decl: [p_both, pipeline, { call: [two_axis, 2] }]
      - decl: [rc_b, i32, { call: [p_both.run] }]
      - set: [fails, { +: [fails, { call: [expect, "both axes: the run succeeds", { eq: [rc_b, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "both axes: every lane runs individually", { eq: [{ call: [p_both.ran_count] }, 4] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "both axes: nothing is shared", { eq: [{ call: [p_both.reused_count] }, 0] }] }] }]

      # ── the core of §5.2 as ONE comparison: the same body, the same
      # matrix, only the declaration differs -> 1 against 4 runs.
      - set: [fails, { +: [fails, { call: [expect, "unnecessary axes cost reuse", { gt: [{ call: [p_both.ran_count] }, { call: [p_none.ran_count] }] }] }] }]

      # ── and a second run hits throughout (the key is stable) ─
      - decl: [rc_b2, i32, { call: [p_both.run] }]
      - set: [fails, { +: [fails, { call: [expect, "second run hits in all four lanes", { eq: [{ call: [p_both.reused_count] }, 4] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_args_subset FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_args_subset PASS"]
      - return: 0
