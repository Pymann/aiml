# SPEC: 62_pipelines
# spec/62 §5.2: eine Teilmenge der Achsen in `args` ist der SINN, nicht eine
# Nachlaessigkeit.  Der Schluessel traegt nur die DEKLARIERTEN Bindungen (§8),
# also laeuft ein Schritt, der eine Achse nicht benutzt, bei deren Wechsel auch
# nicht neu — ein Ergebnis wird ueber jene Lanes geteilt.
#
# Geprueft wird die Kehrseite mit: wer Achsen deklariert, die er nicht braucht,
# VERLIERT die Wiederverwendung (F62-32-Begruendung).  Darum drei gleiche
# Rumpfe, die sich NUR in den deklarierten Achsen unterscheiden:
#   keine Achse  -> einmal fuer die ganze Matrix
#   nur arch     -> einmal pro arch
#   arch + mode  -> jede Lane einzeln
# Expected exit code: 0

- def:
    name: noop_step
    return: i32
    body: [{ return: 0 }]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# two_axis: 2x2 = vier Lanes.  `declare` waehlt, welche Achsen der Schritt
# deklariert: 0 = keine, 1 = nur arch, 2 = arch und mode.
- def:
    name: two_axis
    args: [[declare, i32]]
    return: pipeline
    body:
      - decl: [stp, step, { call: [step.new] }]
      - call: [stp.set_name, "work"]
      - call: [stp.set_body, { call: [sys.bundle, "noop_step", { context: true }] }]
      - call: [stp.set_cache, CacheClass.pure]
      - if: { condition: { ge: [declare, 1] }, then: [{ call: [stp.use_arg, "arch"] }] }
      - if: { condition: { ge: [declare, 2] }, then: [{ call: [stp.use_arg, "mode"] }] }
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "only"]
      - call: [stg.add_step, stp]
      - decl: [arch, list<string>]
      - call: [arch.push, "x86_64"]
      - call: [arch.push, "arm64"]
      - decl: [mode, list<string>]
      - call: [mode.push, "debug"]
      - call: [mode.push, "release"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "subset"]
      - call: [pipe.add_param, "arch", arch]
      - call: [pipe.add_param, "mode", mode]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── keine Achse deklariert: einmal fuer die ganze Matrix ────────────
      - decl: [p_none, pipeline, { call: [two_axis, 0] }]
      - set: [fails, { +: [fails, { call: [expect, "2x2 ergibt vier Lanes", { eq: [{ call: [p_none.lane_count] }, 4] }] }] }]
      - decl: [rc_n, i32, { call: [p_none.run] }]
      - set: [fails, { +: [fails, { call: [expect, "ohne Achsen: der Lauf gelingt", { eq: [rc_n, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "ohne Achsen: EINMAL ausgefuehrt", { eq: [{ call: [p_none.ran_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "ohne Achsen: drei Lanes teilen das Ergebnis", { eq: [{ call: [p_none.reused_count] }, 3] }] }] }]

      # ── nur arch deklariert: mode-Wechsel aendert nichts ────────────────
      - decl: [p_arch, pipeline, { call: [two_axis, 1] }]
      - decl: [rc_a, i32, { call: [p_arch.run] }]
      - set: [fails, { +: [fails, { call: [expect, "nur arch: der Lauf gelingt", { eq: [rc_a, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "nur arch: einmal pro arch ausgefuehrt", { eq: [{ call: [p_arch.ran_count] }, 2] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "nur arch: mode-Wechsel trifft", { eq: [{ call: [p_arch.reused_count] }, 2] }] }] }]

      # ── beide Achsen deklariert: keine Wiederverwendung mehr ────────────
      - decl: [p_both, pipeline, { call: [two_axis, 2] }]
      - decl: [rc_b, i32, { call: [p_both.run] }]
      - set: [fails, { +: [fails, { call: [expect, "beide Achsen: der Lauf gelingt", { eq: [rc_b, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "beide Achsen: jede Lane laeuft einzeln", { eq: [{ call: [p_both.ran_count] }, 4] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "beide Achsen: nichts wird geteilt", { eq: [{ call: [p_both.reused_count] }, 0] }] }] }]

      # ── der Kern von §5.2 als EIN Vergleich: gleicher Rumpf, gleiche
      # Matrix, nur die Deklaration unterscheidet sich -> 1 gegen 4 Laeufe.
      - set: [fails, { +: [fails, { call: [expect, "unnoetige Achsen kosten Wiederverwendung", { gt: [{ call: [p_both.ran_count] }, { call: [p_none.ran_count] }] }] }] }]

      # ── und ein zweiter Lauf trifft durchweg (der Schluessel ist stabil) ─
      - decl: [rc_b2, i32, { call: [p_both.run] }]
      - set: [fails, { +: [fails, { call: [expect, "zweiter Lauf trifft in allen vier Lanes", { eq: [{ call: [p_both.reused_count] }, 4] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_args_subset FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_args_subset PASS"]
      - return: 0
