# SPEC: 62_pipelines
# spec/62 §13.5: build structure AT RUNTIME — stages in a loop.
#
# test_pipeline_types.aiml shows the fixed form (one step, one stage).
# Here it is about the question for which the composed form exists at all:
# the number of stages is only fixed when running.  Exactly that is what the
# declared form cannot do — its grid unfolds when COMPILING (§13.3).
#
# Expected exit code: 0

- def:
    name: do_work
    return: i32
    body:
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # The names come from a list — they could just as well come from a file,
      # a database or an RPC response.  That is the point.
      - decl: [names, list<string>]
      - call: [names.push, "fetch"]
      - call: [names.push, "build"]
      - call: [names.push, "test"]

      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "zusammengebaut"]
      - decl: [modes, list<string>]
      - call: [modes.push, "debug"]
      - call: [modes.push, "release"]
      - call: [pipe.add_param, "mode", modes]

      - decl: [prev, string, ""]
      - decl: [nix, i32, 0]
      - while:
          condition: { lt: [nix, names.len] }
          body:
            - decl: [name_txt, string, { at: [names, nix] }]
            - set: [nix, { +: [nix, 1] }]
            - decl: [stp, step, { call: [step.new] }]
            - call: [stp.set_name, name_txt]
            # The body is a BUNDLE, not text: compiled and checked
            # (F62-85), and its content forms the cache key (§8).
            # `pure: true` PROVES the purity — without it `cache: pure` counts
            # as unbacked and the runtime says so (F62-103).
            - call: [stp.set_body, { call: [sys.bundle, "do_work", { context: true, pure: true }] }]
            - call: [stp.set_cache, CacheClass.pure]
            - call: [stp.use_arg, "mode"]
            # order via `needs` — only on EARLIER ones (F62-9).
            - if: { condition: { gt: [prev.len, 0] }, then: [{ call: [stp.add_need, prev] }] }
            - set: [prev, name_txt]
            - decl: [stg, stage, { call: [stage.new] }]
            - call: [stg.set_name, name_txt]
            - call: [stg.add_step, stp]
            - call: [pipe.add_stage, stg]

      - set: [fails, { +: [fails, { call: [expect, "two lanes from two values", { eq: [{ call: [pipe.lane_count] }, 2] }] }] }]
      - decl: [rc_run, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "the assembled run succeeds (rc=${rc_run})", { eq: [rc_run, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_compose_loop FAIL (${fails})"] }, { return: 1 }]
      - print: ["PASS test_pipeline_compose_loop"]
      - return: 0
