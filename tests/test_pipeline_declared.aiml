# SPEC: 62_pipelines
# spec/62 §5 + §13.5f: die DEKLARIERTE Form — die Schreibweise, in der die
# Spec ihre Beispiele schreibt.  Sie wird vor dem Uebersetzen in die
# zusammengesetzte Form umgeschrieben, ist also keine zweite Implementierung.
#
# Geprueft wird, dass die Umschreibung die Bedeutung TRAEGT, nicht nur
# uebersetzt:
#   * die deklarierten Achsen sind im Rumpf als ${name} lesbar (F62-109)
#   * jede Lane hat ihren eigenen Arbeitsbereich
#   * exclude, cache und parallel wirken wie in der zusammengesetzten Form
#   * die Pipeline entsteht erst beim Aufruf von demo() (F62-108)
# Expected exit code: 0

- pipeline:
    name: declared_demo
    params:
      - [arch, string, [x86_64, arm64]]
      - [mode, string, [debug, release]]
    exclude:
      - { arch: arm64, mode: release }
    parallel: 2
    workspace_root: logs/declared_ws
    steps:
      - stage:
          name: mark
          steps:
            # per: once — EINMAL fuer die ganze Matrix (§5.5).  Genau das, was
            # ein `git clone` oder `apt install` braucht.
            - step:
                name: prepare
                per: once
                cache: pure
                args: []
                return: string
                body:
                  - call: [io.write_file, "${workspace}/shared.txt", "einmal"]
                  # F62-121: der Rueckgabewert wandert von selbst in den
                  # Ergebniskanal — der Autor schreibt nur `return`.
                  - return: "commit-xyz"
            - step:
                name: write
                needs: [prepare]
                cache: pure
                args: [arch, mode]
                return: i32
                body:
                  # ${prepare} ist der Wert, den der Schritt `prepare`
                  # zurueckgegeben hat (F62-121) — als lokaler Name, wie die
                  # Achsen.
                  - call: [io.write_file, "${workspace}/lane.txt", "${arch}-${mode}-${prepare}"]
                  - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # F62-108: die Deklaration fuehrt nichts aus — erst der Aufruf baut sie.
      - decl: [pipe, pipeline, { call: [declared_demo] }]
      - set: [fails, { +: [fails, { call: [expect, "2x2 minus ein exclude = drei Lanes", { eq: [{ call: [pipe.lane_count] }, 3] }] }] }]

      - decl: [rc_run, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "der Lauf gelingt", { eq: [rc_run, 0] }] }] }]
      # 1x prepare (per: once) + 3x write (je Lane)
      - set: [fails, { +: [fails, { call: [expect, "einmal gemeinsam plus drei Lanes", { eq: [{ call: [pipe.ran_count] }, 4] }] }] }]
      - decl: [p_shared, string, "logs/declared_ws/declared_demo/_/mark/shared.txt"]
      - set: [fails, { +: [fails, { call: [expect, "der gemeinsame Schritt hat EINEN Arbeitsbereich", { call: [io.exists, p_shared] }] }] }]

      # F62-109: der Rumpf hat SEINE Achsen gesehen.
      - decl: [p_one, string, "logs/declared_ws/declared_demo/arch=x86_64,mode=debug/mark/lane.txt"]
      - decl: [p_two, string, "logs/declared_ws/declared_demo/arch=arm64,mode=debug/mark/lane.txt"]
      - set: [fails, { +: [fails, { call: [expect, "Lane x86_64/debug schrieb ihre Datei", { call: [io.exists, p_one] }] }] }]
      - decl: [got_one, string, { call: [io.read_file, p_one] }]
      - decl: [got_two, string, { call: [io.read_file, p_two] }]
      - set: [fails, { +: [fails, { call: [expect, "und ihre eigenen Achsenwerte", { eq: [got_one, "x86_64-debug-commit-xyz"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "die andere Lane ebenso", { eq: [got_two, "arm64-debug-commit-xyz"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "der Rueckgabewert des gemeinsamen Schritts kam an", { gt: [got_one.len, 15] }] }] }]

      # Die ausgeschlossene Lane gibt es nicht.
      - decl: [p_gone, string, "logs/declared_ws/declared_demo/arch=arm64,mode=release/mark/lane.txt"]
      - set: [fails, { +: [fails, { call: [expect, "die ausgeschlossene Lane lief nicht", { eq: [{ call: [io.exists, p_gone] }, false] }] }] }]

      # Ein zweiter Lauf trifft (cache: pure wirkt wie zusammengesetzt).
      - decl: [rc_two, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "der zweite Lauf trifft viermal", { eq: [{ call: [pipe.reused_count] }, 4] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_declared FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_declared PASS"]
      - return: 0
