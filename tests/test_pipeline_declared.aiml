# SPEC: 62_pipelines
# spec/62 §5 + §13.5f: the DECLARED form — the notation in which the
# spec writes its examples.  It is rewritten into the composed form before compiling,
# so it is not a second implementation.
#
# What is checked is that the rewrite CARRIES the meaning, not just
# compiles:
#   * the declared axes are readable in the body as ${name} (F62-109)
#   * every lane has its own workspace
#   * exclude, cache and parallel act as in the composed form
#   * the pipeline only comes into being when demo() is called (F62-108)
# Expected exit code: 0

- pipeline:
    name: declared_demo
    params:
      - [arch, string, [x86_64, arm64]]
      - [mode, string, [debug, release]]
    exclude:
      - { arch: arm64, mode: release }
    parallel: 2
    workspace_root: logs/declared_ws
    steps:
      - stage:
          name: mark
          steps:
            # per: once — ONCE for the whole matrix (§5.5).  Exactly what
            # a `git clone` or `apt install` needs.
            - step:
                name: prepare
                per: once
                cache: pure
                args: []
                return: string
                body:
                  - call: [io.write_file, "${workspace}/shared.txt", "einmal"]
                  # F62-121: the return value moves into the result channel by itself
                  # — the author only writes `return`.
                  - return: "commit-xyz"
            - step:
                name: write
                needs: [prepare]
                cache: pure
                args: [arch, mode]
                return: i32
                body:
                  # ${prepare} is the value that the step `prepare`
                  # returned (F62-121) — as a local name, like the
                  # axes.
                  - call: [io.write_file, "${workspace}/lane.txt", "${arch}-${mode}-${prepare}"]
                  - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # F62-108: the declaration executes nothing — only the call builds it.
      - decl: [pipe, pipeline, { call: [declared_demo] }]
      - set: [fails, { +: [fails, { call: [expect, "2x2 minus one exclude = three lanes", { eq: [{ call: [pipe.lane_count] }, 3] }] }] }]

      - decl: [rc_run, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "the run succeeds", { eq: [rc_run, 0] }] }] }]
      # 1x prepare (per: once) + 3x write (je Lane)
      - set: [fails, { +: [fails, { call: [expect, "once shared plus three lanes", { eq: [{ call: [pipe.ran_count] }, 4] }] }] }]
      - decl: [p_shared, string, "logs/declared_ws/declared_demo/_/mark/shared.txt"]
      - set: [fails, { +: [fails, { call: [expect, "the shared step has ONE workspace", { call: [io.exists, p_shared] }] }] }]

      # F62-109: the body saw ITS axes.
      - decl: [p_one, string, "logs/declared_ws/declared_demo/arch=x86_64,mode=debug/mark/lane.txt"]
      - decl: [p_two, string, "logs/declared_ws/declared_demo/arch=arm64,mode=debug/mark/lane.txt"]
      - set: [fails, { +: [fails, { call: [expect, "lane x86_64/debug wrote its file", { call: [io.exists, p_one] }] }] }]
      - decl: [got_one, string, { call: [io.read_file, p_one] }]
      - decl: [got_two, string, { call: [io.read_file, p_two] }]
      - set: [fails, { +: [fails, { call: [expect, "and its own axis values", { eq: [got_one, "x86_64-debug-commit-xyz"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the other lane likewise", { eq: [got_two, "arm64-debug-commit-xyz"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the return value of the shared step arrived", { gt: [got_one.len, 15] }] }] }]

      # The excluded lane does not exist.
      - decl: [p_gone, string, "logs/declared_ws/declared_demo/arch=arm64,mode=release/mark/lane.txt"]
      - set: [fails, { +: [fails, { call: [expect, "the excluded lane did not run", { eq: [{ call: [io.exists, p_gone] }, false] }] }] }]

      # A second run hits (cache: pure acts as in the composed form).
      - decl: [rc_two, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "the second run hits four times", { eq: [{ call: [pipe.reused_count] }, 4] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_declared FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_declared PASS"]
      - return: 0
