# SPEC: 62_pipelines
# spec/62 §5.6 + §5.7: reach of a failure, attempts, status.
#
# The core of §5.6 is that the reach hangs on the STEP, not on the
# pipeline: a failed fetch_sources makes every lane pointless, a
# failed build in one lane says nothing about the others.  Three
# reaches must therefore differ MEASURABLY — the same pipeline,
# the same body, only on_fail differs:
#   lane      -> every lane tries it, none gets to the second stage
#   pipeline  -> after the first failure nothing starts any more
#   continue  -> the failure is noted, the lane keeps running
#
# Of the status only what is already DECIDED in spec/62 is checked (F62-93):
# that a set colour reaches the step and that the lane aggregates
# instead of mixing.  No individual colour meaning — that is open (§16.6).
# Expected exit code: 0

- decl: [g_b_runs, i32, 0]

- class:
    name: StepFailed
    members: [[message, string]]

- def:
    name: ok_body
    return: i32
    body: [{ return: 0 }]

# bad_body: fails.  A step fails if its body THROWS (F62-41) —
# NOT if it returns a number != 0: by §5.3 the return value is a
# result and is cached.  Measured in tests/test_bundle_exec_semantics.aiml.
- def:
    name: bad_body
    return: i32
    body:
      - throw: { new: StepFailed, message: "geplatzt" }
      - return: 0

# yellow_body: gelingt, setzt aber seine Farbe selbst (§5.7).
- def:
    name: yellow_body
    return: i32
    body:
      - call: [step.set_status, StepStatus.yellow]
      - return: 0

# lane_body: explicitly aborts its own lane (F62-46).
- def:
    name: lane_body
    return: i32
    body:
      - call: [step.fail_lane, "ausdruecklich"]
      - return: 0

# slow_body: runs longer than the step's time limit.
- def:
    name: slow_body
    return: i32
    body:
      - decl: [argv, list<string>]
      - call: [argv.push, "sleep"]
      - call: [argv.push, "2"]
      - decl: [proc, process, { call: [sys.exe, argv] }]
      - decl: [wait_rc, i32, { call: [proc.wait] }]
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# Observer: counts how often the SECOND stage runs — that is the measure of
# the reach.  It runs in the caller's context (F62-89), so it may keep a
# global variable.
- def:
    name: on_step
    args: [[event, ref<StepRun>]]
    static_off: ["str_cmp"]
    body:
      - if: { condition: { eq: [event.name, "second"] }, then: [{ set: [g_b_runs, { +: [g_b_runs, 1] }] }] }

# two_stage: two lanes, stage 1 fails, stage 2 is the witness.
- def:
    name: two_stage
    args: [[reach, i32], [cls, i32], [tries, i32]]
    return: pipeline
    body:
      - decl: [bad, step, { call: [step.new] }]
      - call: [bad.set_name, "first"]
      - call: [bad.set_body, { call: [sys.bundle, "bad_body", { context: true }] }]
      - call: [bad.set_cache, cls]
      - call: [bad.set_on_fail, reach]
      - if: { condition: { gt: [tries, 1] }, then: [{ call: [bad.set_retry, tries] }] }
      - decl: [stg_one, stage, { call: [stage.new] }]
      - call: [stg_one.set_name, "one"]
      - call: [stg_one.add_step, bad]
      - decl: [good, step, { call: [step.new] }]
      - call: [good.set_name, "second"]
      - call: [good.set_body, { call: [sys.bundle, "ok_body", { context: true }] }]
      # The same class as the first step: otherwise the second can never
      # hit, and "a success IS recorded" would not be testable.
      - call: [good.set_cache, cls]
      - decl: [stg_two, stage, { call: [stage.new] }]
      - call: [stg_two.set_name, "two"]
      - call: [stg_two.add_step, good]
      - decl: [lanes, list<string>]
      - call: [lanes.push, "a"]
      - call: [lanes.push, "b"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "reach"]
      - call: [pipe.add_param, "lane", lanes]
      - call: [pipe.add_stage, stg_one]
      - call: [pipe.add_stage, stg_two]
      - return: pipe

# one_step: one lane, one step — for status and time limit.
- def:
    name: one_step
    args: [[which, i32]]
    return: pipeline
    body:
      - decl: [stp, step, { call: [step.new] }]
      - call: [stp.set_name, "only"]
      - call: [stp.set_cache, CacheClass.opaque]
      - if: { condition: { eq: [which, 0] }, then: [{ call: [stp.set_body, { call: [sys.bundle, "yellow_body", { context: true }] }] }] }
      - if: { condition: { eq: [which, 1] }, then: [{ call: [stp.set_body, { call: [sys.bundle, "lane_body", { context: true }] }] }] }
      - if:
          condition: { eq: [which, 2] }
          then:
            - call: [stp.set_body, { call: [sys.bundle, "slow_body", { context: true }] }]
            - call: [stp.set_timeout, 100]
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "only"]
      - call: [stg.add_step, stp]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "single"]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── on_fail: lane (Vorgabe) ─────────────────────────────────────────
      - set: [g_b_runs, 0]
      - decl: [p_lane, pipeline, { call: [two_stage, OnFail.lane, CacheClass.opaque, 1] }]
      - decl: [rc_l, i32, { call: [p_lane.run, on_step] }]
      - set: [fails, { +: [fails, { call: [expect, "lane: the run reports the failure", { neq: [rc_l, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "lane: JEDE Lane versucht es", { eq: [{ call: [p_lane.attempt_count] }, 2] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "lane: no lane gets to the second stage", { eq: [g_b_runs, 0] }] }] }]

      # ── on_fail: pipeline ───────────────────────────────────────────────
      - set: [g_b_runs, 0]
      - decl: [p_pipe, pipeline, { call: [two_stage, OnFail.pipeline, CacheClass.opaque, 1] }]
      - decl: [rc_p, i32, { call: [p_pipe.run, on_step] }]
      - set: [fails, { +: [fails, { call: [expect, "pipeline: the run reports the failure", { neq: [rc_p, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "pipeline: after the first failure nothing starts any more", { eq: [{ call: [p_pipe.attempt_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "pipeline: second stage does not run", { eq: [g_b_runs, 0] }] }] }]

      # ── on_fail: continue ───────────────────────────────────────────────
      - set: [g_b_runs, 0]
      - decl: [p_cont, pipeline, { call: [two_stage, OnFail.proceed, CacheClass.opaque, 1] }]
      - decl: [rc_c, i32, { call: [p_cont.run, on_step] }]
      - set: [fails, { +: [fails, { call: [expect, "continue: the run succeeds despite the failure", { eq: [rc_c, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "continue: die Lane laeuft weiter", { eq: [g_b_runs, 2] }] }] }]

      # ── retry: the body is attempted several times (F62-41) ───────────────
      - decl: [p_try, pipeline, { call: [two_stage, OnFail.pipeline, CacheClass.opaque, 3] }]
      - decl: [rc_t, i32, { call: [p_try.run] }]
      - set: [fails, { +: [fails, { call: [expect, "retry: three attempts, then failure", { eq: [{ call: [p_try.attempt_count] }, 3] }] }] }]

      # ── retry + pure is a CONTRADICTION, not a run (F62-41) ──────────────
      - decl: [p_bad, pipeline, { call: [two_stage, OnFail.lane, CacheClass.pure, 3] }]
      - decl: [rc_bad, i32, { call: [p_bad.run] }]
      - set: [fails, { +: [fails, { call: [expect, "retry with pure is rejected", { neq: [rc_bad, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "and BEFORE anything runs", { eq: [{ call: [p_bad.attempt_count] }, 0] }] }] }]

      # ── a failure is NOT recorded (§7, F62-92) ───────────────────────────
      # pure + continue: if the first lane fails and that were recorded,
      # the second lane would hit the failure instead of attempting it itself.
      - decl: [p_rec, pipeline, { call: [two_stage, OnFail.proceed, CacheClass.pure, 1] }]
      - decl: [rc_rec, i32, { call: [p_rec.run] }]
      # The first step must have run in BOTH lanes (2 attempts), the
      # second only once (1 attempt) and must have hit in the second lane.
      - set: [fails, { +: [fails, { call: [expect, "a failure is not recorded", { eq: [{ call: [p_rec.attempt_count] }, 3] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "a success is", { eq: [{ call: [p_rec.reused_count] }, 1] }] }] }]

      # ── set_status: the body's colour reaches the step ───────────────────
      - decl: [p_col, pipeline, { call: [one_step, 0] }]
      - decl: [rc_col, i32, { call: [p_col.run] }]
      - set: [fails, { +: [fails, { call: [expect, "set_status: the run succeeds", { eq: [rc_col, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "set_status: die Farbe erreicht die Pipeline", { eq: [{ call: [p_col.status] }, StepStatus.yellow] }] }] }]

      # ── fail_lane from the body (F62-46) ─────────────────────────────────
      - decl: [p_fl, pipeline, { call: [one_step, 1] }]
      - decl: [rc_fl, i32, { call: [p_fl.run] }]
      - set: [fails, { +: [fails, { call: [expect, "fail_lane breaks the lane although the body returns 0", { neq: [rc_fl, 0] }] }] }]

      # ── timeout limits the WHOLE step (F62-40) ───────────────────────────
      - decl: [start_ms, i64, { call: [time.now] }]
      - decl: [p_to, pipeline, { call: [one_step, 2] }]
      - decl: [rc_to, i32, { call: [p_to.run] }]
      - decl: [elapsed_ms, i64, { -: [{ call: [time.now] }, start_ms] }]
      - set: [fails, { +: [fails, { call: [expect, "timeout: the step counts as failed", { neq: [rc_to, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_failure FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_failure PASS"]
      - return: 0
