# SPEC: 62_pipelines
# spec/62 §5.5 + §13.5g: `per: once`, `needs`, latches, skipping, input_keys.
#
# That is the part that is at the core: NOT repeating the same `git clone` or
# `apt install` per lane.  `args: []` alone is not enough for that
# — a step without axes only hits the cache, it is still visited per
# lane, and with `opaque` it even runs every time.  `per: once` runs
# ONCE.
#
# In addition the flip side is checked, which only makes a pipeline reliable:
#
#   * if the shared step fails, exactly its dependants are
#     SKIPPED, the rest runs (F62-117)
#   * if the predecessor's key changes, the successor reruns,
#     although its OWN inputs are the same (input_keys, F62-114)
#   * `per: once` with a declared axis is an error (F62-115)
#   * `needs` on an unknown step is an error (F62-9)
# Expected exit code: 0

- decl: [g_head, string, "commit-aaa"]
- decl: [g_once_runs, i32, 0]
- decl: [g_lane_runs, i32, 0]

- class:
    name: StepFailed
    members: [[message, string]]

- def:
    name: shared_body
    return: i32
    body: [{ return: 0 }]

- def:
    name: shared_bad
    return: i32
    body:
      - throw: { new: StepFailed, message: "clone kaputt" }
      - return: 0

- def:
    name: lane_body
    return: i32
    body: [{ return: 0 }]

- def:
    name: other_body
    return: i32
    body: [{ return: 0 }]

# Probe of the shared step: makes its key movable.
- def:
    name: head_probe
    return: { type: string, lifetime: producer }
    body: [{ return: g_head }]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: count_steps
    args: [[event, ref<StepRun>]]
    static_off: ["str_cmp"]
    body:
      - if: { condition: { eq: [event.name, "shared"] }, then: [{ set: [g_once_runs, { +: [g_once_runs, 1] }] }] }
      - if: { condition: { eq: [event.name, "perlane"] }, then: [{ set: [g_lane_runs, { +: [g_lane_runs, 1] }] }] }

# graph_pipe: four lanes.  One shared step, one step that
# needs it, and a third that does NOT need it.
#   broken=1  -> the shared step fails
#   probed=1  -> it gets a probe (moving key)
- def:
    name: graph_pipe
    args: [[broken, i32], [probed, i32], [linked, i32]]
    return: pipeline
    body:
      - decl: [shared, step, { call: [step.new] }]
      - call: [shared.set_name, "shared"]
      - if:
          condition: { eq: [broken, 1] }
          then: [{ call: [shared.set_body, { call: [sys.bundle, "shared_bad", { context: true }] }] }]
          else: [{ call: [shared.set_body, { call: [sys.bundle, "shared_body", { context: true }] }] }]
      - call: [shared.set_per, Per.once]
      - if:
          condition: { eq: [probed, 1] }
          then:
            - call: [shared.set_cache, CacheClass.resolved]
            - call: [shared.set_resolve, head_probe]
          else: [{ call: [shared.set_cache, CacheClass.opaque] }]

      - decl: [dependent, step, { call: [step.new] }]
      - call: [dependent.set_name, "perlane"]
      - call: [dependent.set_body, { call: [sys.bundle, "lane_body", { context: true }] }]
      - call: [dependent.set_cache, CacheClass.pure]
      - call: [dependent.use_arg, "arch"]
      - if: { condition: { eq: [linked, 1] }, then: [{ call: [dependent.add_need, "shared"] }] }

      - decl: [independent, step, { call: [step.new] }]
      - call: [independent.set_name, "lonely"]
      - call: [independent.set_body, { call: [sys.bundle, "other_body", { context: true }] }]
      - call: [independent.set_cache, CacheClass.pure]
      - call: [independent.use_arg, "arch"]

      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "only"]
      - call: [stg.add_step, shared]
      - call: [stg.add_step, dependent]
      - call: [stg.add_step, independent]
      - decl: [arch, list<string>]
      - call: [arch.push, "x86_64"]
      - call: [arch.push, "arm64"]
      - decl: [mode, list<string>]
      - call: [mode.push, "debug"]
      - call: [mode.push, "release"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "graph"]
      - call: [pipe.add_param, "arch", arch]
      - call: [pipe.add_param, "mode", mode]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── per: once runs ONCE, the lane steps per lane ───────────────────
      - set: [g_once_runs, 0]
      - set: [g_lane_runs, 0]
      - decl: [pipe, pipeline, { call: [graph_pipe, 0, 0, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "2x2 gives four lanes", { eq: [{ call: [pipe.lane_count] }, 4] }] }] }]
      - decl: [rc_one, i32, { call: [pipe.run, count_steps] }]
      - set: [fails, { +: [fails, { call: [expect, "the run succeeds", { eq: [rc_one, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the shared step ran ONCE", { eq: [g_once_runs, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the lane step ran per lane", { eq: [g_lane_runs, 4] }] }] }]
      # 1 (once) + 4 (perlane) + 2 (lonely: only arch declared -> 2 keys)
      - set: [fails, { +: [fails, { call: [expect, "only arch declared -> two executions shared", { eq: [{ call: [pipe.ran_count] }, 5] }] }] }]

      # ── if the shared step fails: dependants skipped ─────────────────────
      - set: [g_once_runs, 0]
      - set: [g_lane_runs, 0]
      - decl: [broke, pipeline, { call: [graph_pipe, 1, 0, 1] }]
      - decl: [rc_bad, i32, { call: [broke.run, count_steps] }]
      - set: [fails, { +: [fails, { call: [expect, "the failure arrives", { neq: [rc_bad, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the shared step was attempted once", { eq: [g_once_runs, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "its dependants do NOT start", { eq: [g_lane_runs, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the independent step runs anyway", { eq: [{ call: [broke.ran_count] }, 2] }] }] }]

      # ── input_keys as A/B: the same pipeline twice, once WITH and
      # once WITHOUT `needs`.  Only the difference proves something — a number
      # alone could also come about for another reason.
      #
      # The shared step is 'resolved', its probe returns g_head.
      # If that changes, it reruns.  The successor's OWN inputs
      # (the axis arch) stay unchanged meanwhile.
      - set: [g_head, "commit-aaa"]
      - decl: [chain, pipeline, { call: [graph_pipe, 0, 1, 1] }]
      - decl: [rc_c1, i32, { call: [chain.run] }]
      - set: [fails, { +: [fails, { call: [expect, "first run of the chain succeeds", { eq: [rc_c1, 0] }] }] }]
      - decl: [rc_c2, i32, { call: [chain.run] }]
      - set: [fails, { +: [fails, { call: [expect, "second run hits throughout", { eq: [{ call: [chain.ran_count] }, 0] }] }] }]
      - set: [g_head, "commit-bbb"]
      - decl: [rc_c3, i32, { call: [chain.run] }]
      # 1x the shared step + 2x the successor: it declares ONLY arch,
      # so it shares its result across mode (§5.2) — four lanes, two
      # keys.
      - set: [fails, { +: [fails, { call: [expect, "WITH needs: the successor reruns", { eq: [{ call: [chain.ran_count] }, 3] }] }] }]

      - set: [g_head, "commit-aaa"]
      - decl: [loose, pipeline, { call: [graph_pipe, 0, 1, 0] }]
      - decl: [rc_l1, i32, { call: [loose.run] }]
      - decl: [rc_l2, i32, { call: [loose.run] }]
      - set: [fails, { +: [fails, { call: [expect, "WITHOUT needs: the second run also hits throughout", { eq: [{ call: [loose.ran_count] }, 0] }] }] }]
      - set: [g_head, "commit-ccc"]
      - decl: [rc_l3, i32, { call: [loose.run] }]
      # Only the shared step reruns.  The successor hits, because
      # without `needs` its predecessor's key does not go into its own.
      - set: [fails, { +: [fails, { call: [expect, "WITHOUT needs: only the predecessor reruns", { eq: [{ call: [loose.ran_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "so exactly `needs` is the difference", { gt: [{ call: [chain.ran_count] }, { call: [loose.ran_count] }] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_graph FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_graph PASS"]
      - return: 0
