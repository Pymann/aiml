# SPEC: 62_pipelines
# spec/62 §13.5e: how a step body sees its lane.
#
# Without that the matrix would be ineffective — every lane would execute the same body
# without knowing which lane it is.  That is why what is checked is what
# makes the matrix useful in the first place:
#   * the body reads the value of ITS lane (step.arg)
#   * every (lane, stage) has its OWN directory (step.workspace, §4.3)
#   * reading an undeclared axis is an ERROR, not an empty value
#     (F62-106) — an empty value would be a blind key
# Expected exit code: 0

# The body writes its lane value into a file IN the workspace.  That way
# both are checked at once: that it knows the value and that it has its
# own place.
- def:
    name: write_marker
    return: i32
    body:
      - decl: [which, string, { call: [step.arg, "arch"] }]
      - decl: [work_dir, string, { call: [step.workspace] }]
      - if: { condition: { eq: [work_dir.len, 0] }, then: [{ return: 2 }] }
      - call: [io.write_file, "${work_dir}/marker.txt", which]
      - return: 0

# Reads an axis that the step did NOT declare.
- def:
    name: read_undeclared
    return: i32
    body:
      - decl: [sneaky, string, { call: [step.arg, "mode"] }]
      - if: { condition: { eq: [sneaky.len, 0] }, then: [{ return: 3 }] }
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: two_arch
    args: [[which_body, i32]]
    return: pipeline
    body:
      - decl: [stp, step, { call: [step.new] }]
      - call: [stp.set_name, "marker"]
      - if:
          condition: { eq: [which_body, 0] }
          then: [{ call: [stp.set_body, { call: [sys.bundle, "write_marker", { context: true }] }] }]
          else: [{ call: [stp.set_body, { call: [sys.bundle, "read_undeclared", { context: true }] }] }]
      - call: [stp.set_cache, CacheClass.pure]
      - call: [stp.use_arg, "arch"]
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "mark"]
      - call: [stg.add_step, stp]
      - decl: [arch, list<string>]
      - call: [arch.push, "x86_64"]
      - call: [arch.push, "arm64"]
      - decl: [mode, list<string>]
      - call: [mode.push, "debug"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "lanes"]
      - call: [pipe.add_param, "arch", arch]
      - call: [pipe.add_param, "mode", mode]
      - call: [pipe.set_workspace_root, "logs/pipeline_ws"]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      - decl: [pipe, pipeline, { call: [two_arch, 0] }]
      - decl: [rc_run, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "the run succeeds", { eq: [rc_run, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "both lanes ran", { eq: [{ call: [pipe.ran_count] }, 2] }] }] }]

      # Every lane has its own workspace with ITS value in it.
      - decl: [p_x86, string, "logs/pipeline_ws/lanes/arch=x86_64,mode=debug/mark/marker.txt"]
      - decl: [p_arm, string, "logs/pipeline_ws/lanes/arch=arm64,mode=debug/mark/marker.txt"]
      - set: [fails, { +: [fails, { call: [expect, "lane x86_64 has its directory", { call: [io.exists, p_x86] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "lane arm64 has its directory", { call: [io.exists, p_arm] }] }] }]
      - decl: [got_x86, string, { call: [io.read_file, p_x86] }]
      - decl: [got_arm, string, { call: [io.read_file, p_arm] }]
      - set: [fails, { +: [fails, { call: [expect, "x86_64 saw its own value", { eq: [got_x86, "x86_64"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "arm64 saw its own value", { eq: [got_arm, "arm64"] }] }] }]

      # Reading an undeclared axis: an error, not an empty value (F62-106).
      - decl: [sneak, pipeline, { call: [two_arch, 1] }]
      - decl: [rc_sneak, i32, { call: [sneak.run] }]
      - set: [fails, { +: [fails, { call: [expect, "reading an undeclared axis fails", { neq: [rc_sneak, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_lane_access FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_lane_access PASS"]
      - return: 0
