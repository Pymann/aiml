# SPEC: 62_pipelines
# spec/62 §4: parameter space and exclude.
#
# The matrix is the main thing (§1): three axes give eight lanes, a
# partial binding excludes two of them.  Above all it is checked that a
# WRONG exclude is noticed (F62-4) instead of silently excluding nothing — that
# is the kind of error that makes matrix configuration unreliable elsewhere.
# Expected exit code: 0

- def:
    name: noop_step
    return: i32
    body: [{ return: 0 }]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# build_three: a pipeline with three axes, freshly built.
- def:
    name: build_three
    return: pipeline
    body:
      - decl: [stp, step, { call: [step.new] }]
      - call: [stp.set_name, "noop"]
      - call: [stp.set_body, { call: [sys.bundle, "noop_step", { context: true }] }]
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "only"]
      - call: [stg.add_step, stp]
      - decl: [arch, list<string>]
      - call: [arch.push, "x86_64"]
      - call: [arch.push, "arm64"]
      - decl: [comp, list<string>]
      - call: [comp.push, "gcc"]
      - call: [comp.push, "clang"]
      - decl: [mode, list<string>]
      - call: [mode.push, "debug"]
      - call: [mode.push, "release"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "matrix"]
      - call: [pipe.add_param, "arch", arch]
      - call: [pipe.add_param, "compiler", comp]
      - call: [pipe.add_param, "mode", mode]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── Cross product ────────────────────────────────────────────────────
      - decl: [full, pipeline, { call: [build_three] }]
      - set: [fails, { +: [fails, { call: [expect, "2x2x2 gives eight lanes", { eq: [{ call: [full.lane_count] }, 8] }] }] }]

      # ── exclude as a partial binding: two lanes drop out ─────────────────
      - decl: [cut, pipeline, { call: [build_three] }]
      - call: [cut.add_exclude, "arch=arm64,compiler=gcc"]
      - set: [fails, { +: [fails, { call: [expect, "a partial binding excludes two lanes", { eq: [{ call: [cut.lane_count] }, 6] }] }] }]
      - decl: [rc_cut, i32, { call: [cut.run] }]
      - set: [fails, { +: [fails, { call: [expect, "the shortened run succeeds", { eq: [rc_cut, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "and executes exactly six steps", { eq: [{ call: [cut.ran_count] }, 6] }] }] }]

      # ── F62-4: an unknown axis in exclude is an ERROR ───────────────────
      - decl: [bad_axis, pipeline, { call: [build_three] }]
      - call: [bad_axis.add_exclude, "gibtsnicht=egal"]
      - decl: [rc_axis, i32, { call: [bad_axis.run] }]
      - set: [fails, { +: [fails, { call: [expect, "unknown axis in exclude is rejected", { neq: [rc_axis, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "no step ran in the process", { eq: [{ call: [bad_axis.ran_count] }, 0] }] }] }]

      # ── F62-4: a value outside the domain is an ERROR ───────────────────
      # Otherwise a typo silently excludes NOTHING, and the matrix runs
      # larger than intended — without anyone noticing.
      - decl: [bad_val, pipeline, { call: [build_three] }]
      - call: [bad_val.add_exclude, "arch=sparc"]
      - decl: [rc_val, i32, { call: [bad_val.run] }]
      - set: [fails, { +: [fails, { call: [expect, "value outside the domain is rejected", { neq: [rc_val, 0] }] }] }]

      # ── F62-5: excluding everything is an ERROR ─────────────────────────
      - decl: [all_out, pipeline, { call: [build_three] }]
      - call: [all_out.add_exclude, "arch=x86_64"]
      - call: [all_out.add_exclude, "arch=arm64"]
      - decl: [rc_all, i32, { call: [all_out.run] }]
      - set: [fails, { +: [fails, { call: [expect, "an empty matrix is rejected", { neq: [rc_all, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_matrix FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_matrix PASS"]
      - return: 0
