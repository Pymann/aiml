# SPEC: 62_pipelines
# spec/62 §6: lanes run in parallel, and that must change nothing in the RESULT.
#
# That is only cleared by the measurement in
# tests/test_concurrent_spawn_hazard.aiml (F62-14/F62-101).  What is checked here is not
# speed — that depends on the machine — but the statement
# of F62-98: the same pipeline with parallel=1 and parallel=4 must deliver the same
# keys, the same counters and the same outcome.  If that were
# different, the concurrency itself would be an input, and a hit would
# depend on how fast the machine happened to be.
# Expected exit code: 0

- decl: [g_events, i32, 0]

- class:
    name: StepFailed
    members: [[message, string]]

- def:
    name: lane_work
    return: i32
    body: [{ return: 0 }]

- def:
    name: lane_bad
    return: i32
    body:
      - throw: { new: StepFailed, message: "geplatzt" }
      - return: 0

- def:
    name: count_events
    args: [[event, ref<StepRun>]]
    body:
      - set: [g_events, { +: [g_events, 1] }]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# eight_lanes: 2x2x2 = eight lanes, one step that declares ALL axes —
# so that every lane really works and nothing hits.
- def:
    name: eight_lanes
    args: [[par, i32], [broken, i32]]
    return: pipeline
    body:
      - decl: [stp, step, { call: [step.new] }]
      - call: [stp.set_name, "work"]
      - if:
          condition: { eq: [broken, 1] }
          then: [{ call: [stp.set_body, { call: [sys.bundle, "lane_bad", { context: true }] }] }]
          else: [{ call: [stp.set_body, { call: [sys.bundle, "lane_work", { context: true }] }] }]
      - call: [stp.set_cache, CacheClass.pure]
      - call: [stp.use_arg, "arch"]
      - call: [stp.use_arg, "compiler"]
      - call: [stp.use_arg, "mode"]
      - if: { condition: { eq: [broken, 1] }, then: [{ call: [stp.set_on_fail, OnFail.pipeline] }] }
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "only"]
      - call: [stg.add_step, stp]
      - decl: [arch, list<string>]
      - call: [arch.push, "x86_64"]
      - call: [arch.push, "arm64"]
      - decl: [comp, list<string>]
      - call: [comp.push, "gcc"]
      - call: [comp.push, "clang"]
      - decl: [mode, list<string>]
      - call: [mode.push, "debug"]
      - call: [mode.push, "release"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "parallel"]
      - call: [pipe.add_param, "arch", arch]
      - call: [pipe.add_param, "compiler", comp]
      - call: [pipe.add_param, "mode", mode]
      - call: [pipe.add_stage, stg]
      - call: [pipe.set_parallel, par]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      # spec/62 F62-24a: results outlive a pipeline value and the process; every
      # value here has a store of its own, so that it counts its OWN runs.
      - call: [io.remove_all, "logs/test_pipeline_parallel_stores"]
      - decl: [fails, i32, 0]

      # ── serial: the reference value ─────────────────────────────────────
      - set: [g_events, 0]
      - decl: [serial, pipeline, { call: [eight_lanes, 1, 0] }]
      - call: [serial.set_store, "logs/test_pipeline_parallel_stores/serial"]
      - decl: [rc_s, i32, { call: [serial.run, count_events] }]
      - decl: [ran_s, i32, { call: [serial.ran_count] }]
      - decl: [ev_s, i32, g_events]
      - set: [fails, { +: [fails, { call: [expect, "serial: eight lanes run through", { eq: [rc_s, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "serial: eight executions", { eq: [ran_s, 8] }] }] }]

      # ── parallel: the same result, the same counters ────────────────────
      - set: [g_events, 0]
      - decl: [par4, pipeline, { call: [eight_lanes, 4, 0] }]
      - call: [par4.set_store, "logs/test_pipeline_parallel_stores/par4"]
      - decl: [rc_p, i32, { call: [par4.run, count_events] }]
      - set: [fails, { +: [fails, { call: [expect, "parallel: the same outcome", { eq: [rc_p, rc_s] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "parallel: the same number of executions", { eq: [{ call: [par4.ran_count] }, ran_s] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "parallel: nothing hit, nothing doubled", { eq: [{ call: [par4.reused_count] }, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "parallel: the observer sees every lane exactly once", { eq: [g_events, ev_s] }] }] }]

      # ── a second run also hits in all eight lanes in parallel ──────────
      - decl: [rc_p2, i32, { call: [par4.run] }]
      - set: [fails, { +: [fails, { call: [expect, "parallel: the second run hits eight times", { eq: [{ call: [par4.reused_count] }, 8] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "parallel: so the keys are the same", { eq: [rc_p2, 0] }] }] }]

      # ── auto (parallel = 0): one core per lane, the same result ─────────
      - decl: [auto_p, pipeline, { call: [eight_lanes, 0, 0] }]
      - call: [auto_p.set_store, "logs/test_pipeline_parallel_stores/auto_p"]
      - decl: [rc_a, i32, { call: [auto_p.run] }]
      - set: [fails, { +: [fails, { call: [expect, "auto: the same outcome", { eq: [rc_a, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "auto: the same number of executions", { eq: [{ call: [auto_p.ran_count] }, 8] }] }] }]

      # ── on_fail=pipeline also brakes in parallel: not all eight run ───────
      - decl: [broke, pipeline, { call: [eight_lanes, 4, 1] }]
      - call: [broke.set_store, "logs/test_pipeline_parallel_stores/broke"]
      - decl: [rc_b, i32, { call: [broke.run] }]
      - set: [fails, { +: [fails, { call: [expect, "parallel: the failure arrives", { neq: [rc_b, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "parallel: on_fail=pipeline stops the dispatch", { lt: [{ call: [broke.attempt_count] }, 8] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_parallel FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_parallel PASS"]
      - return: 0
