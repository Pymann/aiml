# SPEC: 62_pipelines
# spec/62 §5.9: pausing at the step boundary and resuming from the cache.
#
# The core is F62-56: resuming needs NO state of its own.  What a
# resume continues is the set of already recorded (step, lane) —
# i.e. the cache.  That is why it is checked here that a resumed run HITS the
# finished steps instead of repeating them; if that were not so,
# one would have to build a resume state, and that is exactly what §5.9 does not want.
#
# Two ways into pausing, both required:
#   pause_before   -> declared in the source text, a release gate (F62-54)
#   request_pause  -> from outside, takes effect AFTER the running step (F62-55)
# Expected exit code: 0

- decl: [g_seen, i32, 0]
- decl: [g_pipe_handle, pipeline]

- def:
    name: step_one
    return: i32
    body: [{ return: 0 }]

- def:
    name: step_two
    return: i32
    body: [{ return: 0 }]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# Observer that pauses from OUTSIDE: after the first step (F62-97).
- def:
    name: pause_after_first
    args: [[event, ref<StepRun>]]
    static_off: ["str_cmp"]
    body:
      - set: [g_seen, { +: [g_seen, 1] }]
      - if: { condition: { eq: [event.name, "one"] }, then: [{ call: [g_pipe_handle.request_pause] }] }

- def:
    name: two_steps
    args: [[gate, i32]]
    return: pipeline
    body:
      - decl: [one, step, { call: [step.new] }]
      - call: [one.set_name, "one"]
      - call: [one.set_body, { call: [sys.bundle, "step_one", { context: true }] }]
      - call: [one.set_cache, CacheClass.pure]
      - decl: [two, step, { call: [step.new] }]
      - call: [two.set_name, "two"]
      - call: [two.set_body, { call: [sys.bundle, "step_two", { context: true }] }]
      - call: [two.set_cache, CacheClass.pure]
      - if: { condition: { eq: [gate, 1] }, then: [{ call: [two.set_pause_before, 1] }] }
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "only"]
      - call: [stg.add_step, one]
      - call: [stg.add_step, two]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "pausable"]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── declared gate: the run stops BEFORE the second step ────────────
      - decl: [gated, pipeline, { call: [two_steps, 1] }]
      - decl: [rc_g1, i32, { call: [gated.run] }]
      - set: [fails, { +: [fails, { call: [expect, "gate: the run reports 'paused'", { eq: [rc_g1, -6] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "gate: the life cycle is paused", { eq: [{ call: [gated.lifecycle] }, Lifecycle.paused] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "gate: the first step ran", { eq: [{ call: [gated.ran_count] }, 1] }] }] }]

      # ── release + resume: the finished step HITS ──────────────────────
      - call: [gated.release, "two"]
      - call: [gated.resume]
      - decl: [rc_g2, i32, { call: [gated.run] }]
      - set: [fails, { +: [fails, { call: [expect, "release: the run gets through", { eq: [rc_g2, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "resume: the finished step hits", { eq: [{ call: [gated.reused_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "resume: only the open step runs", { eq: [{ call: [gated.ran_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "resume: the life cycle is done", { eq: [{ call: [gated.lifecycle] }, Lifecycle.done] }] }] }]

      # ── without a gate the same pipeline runs through ───────────────────
      - decl: [plain, pipeline, { call: [two_steps, 0] }]
      - decl: [rc_p, i32, { call: [plain.run] }]
      - set: [fails, { +: [fails, { call: [expect, "without a gate: the run gets through", { eq: [rc_p, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "without a gate: both steps ran", { eq: [{ call: [plain.ran_count] }, 2] }] }] }]

      # ── from outside: the observer pauses AFTER the first step ─────────
      - set: [g_seen, 0]
      - decl: [outer, pipeline, { call: [two_steps, 0] }]
      - set: [g_pipe_handle, outer]
      - decl: [rc_o1, i32, { call: [outer.run, pause_after_first] }]
      - set: [fails, { +: [fails, { call: [expect, "from outside: the run reports 'paused'", { eq: [rc_o1, -6] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "from outside: only AFTER the running step", { eq: [g_seen, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "from outside: the first step is finished", { eq: [{ call: [outer.ran_count] }, 1] }] }] }]
      - call: [outer.resume]
      - decl: [rc_o2, i32, { call: [outer.run] }]
      - set: [fails, { +: [fails, { call: [expect, "von aussen: fortgesetzt kommt er durch", { eq: [rc_o2, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "from outside: the finished step hits", { eq: [{ call: [outer.reused_count] }, 1] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_pause FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_pause PASS"]
      - return: 0
