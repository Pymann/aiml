# SPEC: 62_pipelines
# spec/62 §20.4: die uebersetzte Pipeline LESEN.  Ein Kontroller bekommt die
# Gestalt des Laufs aus dem Wert — nicht aus dem Quelltext (§20.1).
#
# Geprueft wird vor allem das, was der Uebersetzer VORHER tut (§20.3):
#   * Lanes gebildet, Bindungstext in der kanonischen Form (F62-152)
#   * Vorrang aufgeloest: Stufe schlaegt Pipeline (F62-151)
#   * `shares:` addieren sich (F62-138)
#   * `steplayer` hergeleitet: mit `image:` ist es `own` (F110-125)
#   * die verteilten Schluessel UEBERSETZEN (F62-124a) — abgelehnt wird erst
#     beim lokalen Lauf, siehe tests/test_pipeline_local_refuses.aiml
# Expected exit code: 0

- pipeline:
    name: lese_demo
    agent: x86_64
    image: ubuntu-base
    base: "job:vorlauf"
    timeout: 60000
    requires: [git, gcc]
    resources: { cpu: 4, mem: "2G", pids: 512 }
    shares:
      - { name: quellen, to: /mnt/quellen }
    push:
      - { from: bauen, to: "oci:deploy/oci/demo", tag: "nightly" }
    params:
      - [arch, string, [x86_64, arm64]]
    steps:
      - stage:
          name: bauen
          run: "make -j4"
      - stage:
          name: pruefen
          agent: arm64
          timeout: 1000
          resources: { cpu: 2 }
          requires: [ctest]
          shares:
            - { name: artefakte, to: /mnt/out, mode: rw }
          run: "ctest"

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: expect_str
    static_off: ["str_cmp"]
    args: [[what, string], [got, string], [want, string]]
    return: i32
    body:
      - if:
          condition: { eq: [got, want] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}: '${got}' statt '${want}'"]
      - return: 1

- def:
    name: lies_kopf
    args: [[pipe, ref<pipeline>]]
    return: i32
    body:
      - decl: [bad, i32, 0]
      - set: [bad, { +: [bad, { call: [expect_str, "der Name", { call: [pipe.name] }, "lese_demo"] }] }]
      - set: [bad, { +: [bad, { call: [expect, "zwei Lanes", { eq: [{ call: [pipe.lane_count] }, 2] }] }] }]
      - set: [bad, { +: [bad, { call: [expect, "zwei Stufen je Lane", { eq: [{ call: [pipe.stage_count] }, 2] }] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "Bindungstext der ersten Lane", { call: [pipe.lane_bindings, 0] }, "arch=x86_64"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "Bindungstext der zweiten Lane", { call: [pipe.lane_bindings, 1] }, "arch=arm64"] }] }]
      - set: [bad, { +: [bad, { call: [expect, "eine Achse", { eq: [{ call: [pipe.axis_count] }, 1] }] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "ihr Name", { call: [pipe.axis_name, 0] }, "arch"] }] }]
      - set: [bad, { +: [bad, { call: [expect, "ihre Domaene hat zwei Werte", { eq: [{ call: [pipe.axis_value_count, 0] }, 2] }] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "der erste Wert", { call: [pipe.axis_value, 0, 0] }, "x86_64"] }] }]
      - set: [bad, { +: [bad, { call: [expect, "ein push-Ziel", { eq: [{ call: [pipe.push_count] }, 1] }] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "es nennt die Stufe", { call: [pipe.push_from, 0] }, "bauen"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "und das Ziel", { call: [pipe.push_to, 0] }, "oci:deploy/oci/demo"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "und die Marke", { call: [pipe.push_tag, 0] }, "nightly"] }] }]
      - return: bad

- def:
    name: lies_geerbt
    args: [[stg, ref<stage>]]
    return: i32
    body:
      - decl: [bad, i32, 0]
      - set: [bad, { +: [bad, { call: [expect_str, "Stufe 1 heisst bauen", { call: [stg.name] }, "bauen"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "sie erbt agent", { call: [stg.agent] }, "x86_64"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "sie erbt image", { call: [stg.image] }, "ubuntu-base"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "steplayer kommt aus image (F110-125)", { call: [stg.steplayer] }, "own"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "sie erbt base", { call: [stg.base] }, "job:vorlauf"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "sie erbt requires als eine Zeile", { call: [stg.requires] }, "git,gcc"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "sie erbt shares", { call: [stg.shares] }, "quellen:/mnt/quellen:ro"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "ihr Befehl", { call: [stg.command] }, "make -j4"] }] }]
      - set: [bad, { +: [bad, { call: [expect, "sie erbt die Zeitgrenze", { eq: [{ call: [stg.timeout_ms] }, 60000] }] }] }]
      - set: [bad, { +: [bad, { call: [expect, "sie erbt cpu", { eq: [{ call: [stg.cpu_cores] }, 4] }] }] }]
      - set: [bad, { +: [bad, { call: [expect, "sie erbt mem", { eq: [{ call: [stg.mem_mb] }, 2048] }] }] }]
      - set: [bad, { +: [bad, { call: [expect, "sie erbt pids", { eq: [{ call: [stg.pids_max] }, 512] }] }] }]
      - return: bad

- def:
    name: lies_eigenes
    args: [[stg, ref<stage>]]
    return: i32
    body:
      - decl: [bad, i32, 0]
      - set: [bad, { +: [bad, { call: [expect_str, "Stufe 2 heisst pruefen", { call: [stg.name] }, "pruefen"] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "ihr agent schlaegt den der Pipeline", { call: [stg.agent] }, "arm64"] }] }]
      - set: [bad, { +: [bad, { call: [expect, "ihre Zeitgrenze schlaegt die der Pipeline", { eq: [{ call: [stg.timeout_ms] }, 1000] }] }] }]
      - set: [bad, { +: [bad, { call: [expect, "ihr cpu schlaegt das der Pipeline", { eq: [{ call: [stg.cpu_cores] }, 2] }] }] }]
      - set: [bad, { +: [bad, { call: [expect, "mem bleibt geerbt", { eq: [{ call: [stg.mem_mb] }, 2048] }] }] }]
      - set: [bad, { +: [bad, { call: [expect_str, "ihr requires schlaegt das der Pipeline", { call: [stg.requires] }, "ctest"] }] }]
      # F62-138: Freigaben ADDIEREN sich — Pipeline zuerst, dann die Stufe.
      - set: [bad, { +: [bad, { call: [expect_str, "shares addieren sich", { call: [stg.shares] }, "quellen:/mnt/quellen:ro,artefakte:/mnt/out:rw"] }] }]
      - return: bad

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      # F62-108: die Deklaration fuehrt nichts aus — erst der Aufruf baut sie.
      - decl: [pipe, pipeline, { call: [lese_demo] }]
      - set: [fails, { +: [fails, { call: [lies_kopf, pipe] }] }]
      - decl: [one, stage, { call: [pipe.stage_at, 0] }]
      - set: [fails, { +: [fails, { call: [lies_geerbt, one] }] }]
      - decl: [two, stage, { call: [pipe.stage_at, 1] }]
      - set: [fails, { +: [fails, { call: [lies_eigenes, two] }] }]
      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_read FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_read PASS"]
      - return: 0
