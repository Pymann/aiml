# SPEC: 62_pipelines §18.2, 23_system §5.6
# `requires:` an einer Stufe — LOKAL geprueft, bevor der erste Schritt laeuft.
#
# Der Fall, den das loest: eine Pipeline laeuft auf einem Rechner, dem ein
# Werkzeug fehlt, und faellt nach fuenf Minuten mit einer Meldung ueber eine
# fehlende Header-Datei um.  Hier faellt es in der ersten Sekunde auf, mit
# NAMEN (F62-126).
#
# Geprueft wird die erfuellte Richtung (die Pipeline laeuft durch): die
# Gegenrichtung wirft, und ein geworfener Fehler in einer deklarierten Pipeline
# ist ein eigener Testfall — hier zaehlt, dass die Pruefung den Lauf NICHT
# aufhaelt, wenn alles da ist.
#
# Expected exit code: 0

- pipeline:
    name: req_demo
    stages:
      - stage:
          name: bauen
          requires: [sh, python3]
          steps:
            - step:
                name: sagen
                return: i32
                body:
                  - print: ["Stufe lief — Umgebung war vollstaendig"]
                  - return: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      # F62-108: die Deklaration fuehrt nichts aus — erst der Aufruf baut sie.
      - decl: [pipe, pipeline, { call: [req_demo] }]
      - decl: [res, i32, { call: [pipe.run] }]
      - if:
          condition: { neq: [res, 0] }
          then: [{ print: ["FAIL: Lauf endete mit ${res}"] }, { return: 1 }]
      # Und die Pruefung selbst, direkt: was fehlt, wird genannt.
      - decl: [miss, string, { call: [sys.require_tools, "gibtesnicht_zzz,sh"] }]
      - if:
          condition: { eq: [{ call: [miss.index_of, "gibtesnicht_zzz"] }, -1] }
          then: [{ print: ["FAIL: fehlendes Werkzeug wurde nicht genannt"] }, { return: 1 }]
      - print: ["test_pipeline_requires PASS"]
      - return: 0
