# SPEC: 29_2_sys_exec,29_serialize,62_pipelines
# spec/62 §7/§9: the reuse classes and the probe.
#
# The core is not "a hit works", but that NO wrong hit
# arises.  Three classes, three behaviours:
#   pure      -> hits with equal inputs
#   opaque    -> NEVER hits (§7)
#   resolved  -> the probe ALWAYS runs, its result is in the key;
#                if it changes, the step reruns (§9)
# Expected exit code: 0

- decl: [g_probe_runs, i32, 0]
- decl: [g_head,       string, "commit-aaa"]

# The body must NOT touch any global variable of the caller: it runs in the
# isolated context, and a bundle carries code, not process state
# (spec/29_2 §13).  That is why counting is done via ran_count/reused_count, which
# the runtime keeps OUTSIDE the context.
- def:
    name: work_body
    return: i32
    body:
      - return: 0

# The probe: cheap, runs every time, returns the resolved address.
- def:
    name: head_probe
    return: { type: string, lifetime: producer }
    body:
      - set: [g_probe_runs, { +: [g_probe_runs, 1] }]
      - return: g_head

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: one_step_pipe
    args: [[cls, i32], [with_probe, i32]]
    return: pipeline
    body:
      - decl: [stp, step, { call: [step.new] }]
      - call: [stp.set_name, "work"]
      - call: [stp.set_body, { call: [sys.bundle, "work_body", { context: true }] }]
      - call: [stp.set_cache, cls]
      - if: { condition: { eq: [with_probe, 1] }, then: [{ call: [stp.set_resolve, head_probe] }] }
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "only"]
      - call: [stg.add_step, stp]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "resolve_test"]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── pure: zweiter Lauf trifft ───────────────────────────────────────
      - decl: [pure_pipe, pipeline, { call: [one_step_pipe, CacheClass.pure, 0] }]
      - decl: [rc_p1, i32, { call: [pure_pipe.run] }]
      - decl: [rc_p2, i32, { call: [pure_pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "pure: zweiter Lauf trifft", { eq: [{ call: [pure_pipe.reused_count] }, 1] }] }] }]

      # ── opaque: trifft NIE ──────────────────────────────────────────────
      - decl: [op_pipe, pipeline, { call: [one_step_pipe, CacheClass.opaque, 0] }]
      - decl: [rc_o1, i32, { call: [op_pipe.run] }]
      - decl: [rc_o2, i32, { call: [op_pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "opaque never hits", { eq: [{ call: [op_pipe.reused_count] }, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "opaque runs both times", { eq: [{ call: [op_pipe.ran_count] }, 1] }] }] }]

      # ── resolved: Sonde laeuft IMMER ───────────────────────────────────
      - set: [g_probe_runs, 0]
      - decl: [res_pipe, pipeline, { call: [one_step_pipe, CacheClass.resolved, 1] }]
      - decl: [rc_r1, i32, { call: [res_pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "resolved: first run executes", { eq: [{ call: [res_pipe.ran_count] }, 1] }] }] }]
      - decl: [rc_r2, i32, { call: [res_pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "Sonde lief BEIDE Male", { eq: [g_probe_runs, 2] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "gleiche Adresse -> Treffer", { eq: [{ call: [res_pipe.reused_count] }, 1] }] }] }]

      # ── the address changes -> the step reruns ──────────────────────────
      - set: [g_head, "commit-bbb"]
      - decl: [rc_r3, i32, { call: [res_pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "new address -> step reruns", { eq: [{ call: [res_pipe.ran_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "and does NOT hit while doing so", { eq: [{ call: [res_pipe.reused_count] }, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "probe ran the third time too", { eq: [g_probe_runs, 3] }] }] }]

      # ── resolved without a probe is an ERROR (F62-16) ───────────────────
      - decl: [no_probe, pipeline, { call: [one_step_pipe, CacheClass.resolved, 0] }]
      - decl: [rc_np, i32, { call: [no_probe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "resolved without a probe is rejected", { neq: [rc_np, 0] }] }] }]

      # ── and 'pure' WITH a probe is an error as well (F62-16, second half)
      - decl: [pure_probe, pipeline, { call: [one_step_pipe, CacheClass.pure, 1] }]
      - decl: [rc_pp, i32, { call: [pure_probe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "pure WITH a probe is rejected", { neq: [rc_pp, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_resolve FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_resolve PASS"]
      - return: 0
