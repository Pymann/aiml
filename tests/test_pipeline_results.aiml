# SPEC: 62_pipelines
# spec/62 §13.5h: der Ergebniskanal — Datenfluss von Schritt zu Schritt.
#
# Der Kern ist F62-120: ein TREFFER muss das Ergebnis wiederherstellen, ohne
# den Rumpf zu rufen.  Sonst waere ein wiederverwendeter Schritt fuer seine
# eigenen Nachfolger unsichtbar — sie bekaemen nichts und muessten neu laufen,
# womit die Wiederverwendung genau dort entfaellt, wo sie am meisten wert ist.
#
# Ausserdem F62-119: ein Ergebnis zu lesen, das NICHT in den eigenen `needs`
# steht, ist ein Fehler — es wirkte sonst auf das Ergebnis, ohne ueber
# input_keys im Schluessel zu stehen (blinder Schluessel).
# Expected exit code: 0

- decl: [g_round, string, "r1"]

# Sonde des VERBRAUCHERS: macht nur SEINEN Schluessel beweglich, nicht den des
# Erzeugers.  Damit trifft der Erzeuger im zweiten Lauf, waehrend der
# Verbraucher frisch laufen MUSS — genau die Lage, die F62-120 beschreibt.
- def:
    name: round_probe
    return: { type: string, lifetime: producer }
    body: [{ return: g_round }]

- def:
    name: produce
    return: i32
    body:
      - call: [step.set_result, "commit-42"]
      - return: 0

- def:
    name: consume
    return: i32
    body:
      - decl: [got, string, { call: [step.need_result, "producer"] }]
      # In der ZUSAMMENGESETZTEN Form gibt es kein ${workspace}: die lokalen
      # Namen erzeugt nur die Umschreibung der deklarierten Form (F62-109).
      - decl: [work_dir, string, { call: [step.workspace] }]
      - call: [io.write_file, "${work_dir}/seen.txt", got]
      - return: 0

# Liest ein Ergebnis, das nicht in den eigenen needs steht (F62-119).
- def:
    name: consume_blind
    return: i32
    body:
      - decl: [sneaky, string, { call: [step.need_result, "producer"] }]
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# chain: ein einmaliger Erzeuger, ein Verbraucher je Lane.
#   linked=0 -> der Verbraucher deklariert den needs NICHT (F62-119)
- def:
    name: chain_pipe
    args: [[linked, i32]]
    return: pipeline
    body:
      - decl: [prod, step, { call: [step.new] }]
      - call: [prod.set_name, "producer"]
      - call: [prod.set_body, { call: [sys.bundle, "produce", { context: true }] }]
      - call: [prod.set_per, Per.once]
      - call: [prod.set_cache, CacheClass.pure]
      - decl: [cons, step, { call: [step.new] }]
      - call: [cons.set_name, "consumer"]
      - if:
          condition: { eq: [linked, 1] }
          then:
            - call: [cons.set_body, { call: [sys.bundle, "consume", { context: true }] }]
            - call: [cons.add_need, "producer"]
          else: [{ call: [cons.set_body, { call: [sys.bundle, "consume_blind", { context: true }] }] }]
      - call: [cons.set_cache, CacheClass.resolved]
      - call: [cons.set_resolve, round_probe]
      - call: [cons.use_arg, "arch"]
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "flow"]
      - call: [stg.add_step, prod]
      - call: [stg.add_step, cons]
      - decl: [arch, list<string>]
      - call: [arch.push, "x86_64"]
      - call: [arch.push, "arm64"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "results"]
      - call: [pipe.add_param, "arch", arch]
      - call: [pipe.set_workspace_root, "logs/results_ws"]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── der Wert kommt beim Nachfolger an ──────────────────────────────
      - decl: [pipe, pipeline, { call: [chain_pipe, 1] }]
      - decl: [rc_one, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "der Lauf gelingt", { eq: [rc_one, 0] }] }] }]
      - decl: [p_x86, string, "logs/results_ws/results/arch=x86_64/flow/seen.txt"]
      - decl: [p_arm, string, "logs/results_ws/results/arch=arm64/flow/seen.txt"]
      - set: [fails, { +: [fails, { call: [expect, "der Verbraucher hat geschrieben", { call: [io.exists, p_x86] }] }] }]
      - decl: [got_x86, string, { call: [io.read_file, p_x86] }]
      - decl: [got_arm, string, { call: [io.read_file, p_arm] }]
      - set: [fails, { +: [fails, { call: [expect, "Lane x86_64 sah den Wert des Erzeugers", { eq: [got_x86, "commit-42"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "Lane arm64 ebenso", { eq: [got_arm, "commit-42"] }] }] }]

      # ── F62-120: der Treffer stellt den Wert wieder her ────────────────
      # Dieselbe Pipeline (der Cache haengt an der Instanz).  Die Sonde des
      # Verbrauchers liefert etwas Neues -> nur ER laeuft neu; der Erzeuger
      # trifft.  Trotzdem muss sein Wert beim Verbraucher ankommen.
      - call: [io.remove, p_x86]
      - call: [io.remove, p_arm]
      - set: [fails, { +: [fails, { call: [expect, "die Dateien sind vorher weg", { eq: [{ call: [io.exists, p_x86] }, false] }] }] }]
      - set: [g_round, "r2"]
      - decl: [rc_two, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "zweiter Lauf gelingt", { eq: [rc_two, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "der Erzeuger TRAF (lief nicht erneut)", { eq: [{ call: [pipe.reused_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "die beiden Verbraucher liefen neu", { eq: [{ call: [pipe.ran_count] }, 2] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "und bekamen den Wert aus dem Cache", { eq: [{ call: [io.read_file, p_x86] }, "commit-42"] }] }] }]

      # ── F62-119: ohne needs ist das Lesen ein Fehler ───────────────────
      - decl: [blind, pipeline, { call: [chain_pipe, 0] }]
      - call: [blind.set_workspace_root, "logs/results_ws3"]
      - decl: [rc_blind, i32, { call: [blind.run] }]
      - set: [fails, { +: [fails, { call: [expect, "Lesen ohne needs wird abgelehnt", { neq: [rc_blind, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_results FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_results PASS"]
      - return: 0
