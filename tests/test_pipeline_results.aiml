# SPEC: 62_pipelines
# spec/62 §13.5h: the result channel — data flow from step to step.
#
# The core is F62-120: a HIT must restore the result without
# calling the body.  Otherwise a reused step would be invisible to its
# own successors — they would get nothing and would have to rerun,
# so the reuse would drop out exactly where it is worth the most.
#
# Also F62-119: reading a result that is NOT in one's own `needs`
# is an error — otherwise it would affect the result without being in the key
# via input_keys (blind key).
# Expected exit code: 0

- decl: [g_round, string, "r1"]

# The CONSUMER's probe: only makes ITS key move, not the
# producer's.  That way the producer hits in the second run, while the
# consumer MUST run fresh — exactly the situation F62-120 describes.
- def:
    name: round_probe
    return: { type: string, lifetime: producer }
    body: [{ return: g_round }]

- def:
    name: produce
    return: i32
    body:
      - call: [step.set_result, "commit-42"]
      - return: 0

- def:
    name: consume
    return: i32
    body:
      - decl: [got, string, { call: [step.need_result, "producer"] }]
      # In the COMPOSED form there is no ${workspace}: the local
      # names are only produced by the rewrite of the declared form (F62-109).
      - decl: [work_dir, string, { call: [step.workspace] }]
      - call: [io.write_file, "${work_dir}/seen.txt", got]
      - return: 0

# Reads a result that is not in its own needs (F62-119).
- def:
    name: consume_blind
    return: i32
    body:
      - decl: [sneaky, string, { call: [step.need_result, "producer"] }]
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# chain: a one-off producer, one consumer per lane.
#   linked=0 -> the consumer does NOT declare the needs (F62-119)
- def:
    name: chain_pipe
    args: [[linked, i32]]
    return: pipeline
    body:
      - decl: [prod, step, { call: [step.new] }]
      - call: [prod.set_name, "producer"]
      - call: [prod.set_body, { call: [sys.bundle, "produce", { context: true }] }]
      - call: [prod.set_per, Per.once]
      - call: [prod.set_cache, CacheClass.pure]
      - decl: [cons, step, { call: [step.new] }]
      - call: [cons.set_name, "consumer"]
      - if:
          condition: { eq: [linked, 1] }
          then:
            - call: [cons.set_body, { call: [sys.bundle, "consume", { context: true }] }]
            - call: [cons.add_need, "producer"]
          else: [{ call: [cons.set_body, { call: [sys.bundle, "consume_blind", { context: true }] }] }]
      - call: [cons.set_cache, CacheClass.resolved]
      - call: [cons.set_resolve, round_probe]
      - call: [cons.use_arg, "arch"]
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "flow"]
      - call: [stg.add_step, prod]
      - call: [stg.add_step, cons]
      - decl: [arch, list<string>]
      - call: [arch.push, "x86_64"]
      - call: [arch.push, "arm64"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "results"]
      - call: [pipe.add_param, "arch", arch]
      - call: [pipe.set_workspace_root, "logs/results_ws"]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── the value arrives at the successor ─────────────────────────────
      - decl: [pipe, pipeline, { call: [chain_pipe, 1] }]
      - decl: [rc_one, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "the run succeeds", { eq: [rc_one, 0] }] }] }]
      - decl: [p_x86, string, "logs/results_ws/results/arch=x86_64/flow/seen.txt"]
      - decl: [p_arm, string, "logs/results_ws/results/arch=arm64/flow/seen.txt"]
      - set: [fails, { +: [fails, { call: [expect, "the consumer wrote", { call: [io.exists, p_x86] }] }] }]
      - decl: [got_x86, string, { call: [io.read_file, p_x86] }]
      - decl: [got_arm, string, { call: [io.read_file, p_arm] }]
      - set: [fails, { +: [fails, { call: [expect, "lane x86_64 saw the producer's value", { eq: [got_x86, "commit-42"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "lane arm64 likewise", { eq: [got_arm, "commit-42"] }] }] }]

      # ── F62-120: the hit restores the value ───────────────────────────
      # The same pipeline (the cache hangs on the instance).  The consumer's
      # probe delivers something new -> only IT reruns; the producer
      # hits.  Nevertheless its value must arrive at the consumer.
      - call: [io.remove, p_x86]
      - call: [io.remove, p_arm]
      - set: [fails, { +: [fails, { call: [expect, "the files are gone beforehand", { eq: [{ call: [io.exists, p_x86] }, false] }] }] }]
      - set: [g_round, "r2"]
      - decl: [rc_two, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "second run succeeds", { eq: [rc_two, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the producer HIT (did not run again)", { eq: [{ call: [pipe.reused_count] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the two consumers ran anew", { eq: [{ call: [pipe.ran_count] }, 2] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "and got the value from the cache", { eq: [{ call: [io.read_file, p_x86] }, "commit-42"] }] }] }]

      # ── F62-119: without needs reading is an error ─────────────────────
      - decl: [blind, pipeline, { call: [chain_pipe, 0] }]
      - call: [blind.set_workspace_root, "logs/results_ws3"]
      - decl: [rc_blind, i32, { call: [blind.run] }]
      - set: [fails, { +: [fails, { call: [expect, "reading without needs is rejected", { neq: [rc_blind, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_results FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_results PASS"]
      - return: 0
