# SPEC: 62_pipelines
# spec/62 §18.6: `secrets:` on pipeline and stage, read the way a host reads
# them (stg.secrets).
#
#   * F62-165 a secret is a name bound to an environment name
#   * F62-166 pipeline and stage add up, the same env: the stage wins
#   * F62-167 a stage with secrets is opaque, its steps too
# Expected exit code: 0

- pipeline:
    name: geheim
    cache: pure
    secrets:
      - { name: gh_token, env: GH_TOKEN }
      - { name: alt, env: DEPLOY }
    steps:
      - stage:
          name: hochladen
          secrets:
            - { name: deploy, env: DEPLOY }
          run: "curl -u \"$DEPLOY_USER:$DEPLOY_PASSWORD\" https://example.org/"
      - stage:
          name: pruefen
          steps:
            - step: { name: eins, return: i32, body: [{ return: 0 }] }

- pipeline:
    name: offen
    cache: pure
    steps:
      - stage:
          name: bauen
          run: "make"
      - stage:
          name: signieren
          secrets:
            - { name: signing, env: SIGN_KEY }
          run: "sign $SIGN_KEY"

- def:
    name: expect_str
    static_off: ["str_cmp"]
    args: [[what, string], [got, string], [want, string]]
    return: i32
    body:
      - if:
          condition: { eq: [got, want] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}: '${got}' instead of '${want}'"]
      - return: 1

- def:
    name: secrets_of
    static_off: ["same_arg"]
    args: [[pipe, ref<pipeline>], [idx, i32]]
    return: { type: string, lifetime: producer }
    body:
      - decl: [stg, stage, { call: [pipe.stage_at, idx] }]
      - return: { call: [stg.secrets] }

- def:
    name: class_of
    static_off: ["same_arg"]
    args: [[pipe, ref<pipeline>], [idx, i32]]
    return: { type: string, lifetime: producer }
    body:
      - decl: [stg, stage, { call: [pipe.stage_at, idx] }]
      - return: { call: [stg.cache] }

- def:
    name: step_class
    static_off: ["same_arg"]
    args: [[pipe, ref<pipeline>], [idx, i32], [sidx, i32]]
    return: { type: string, lifetime: producer }
    body:
      - decl: [stg, stage, { call: [pipe.stage_at, idx] }]
      - decl: [stp, step, { call: [stg.step_at, sidx] }]
      - return: { call: [stp.cache] }

- def:
    name: composed
    return: pipeline
    body:
      - decl: [stg, stage, { call: [stage.new] }]
      - call: [stg.set_name, "zusammen"]
      - call: [stg.set_attr, "command", "true"]
      - call: [stg.set_attr, "cache", "pure"]
      - call: [stg.set_attr, "secrets", "tok:TOKEN"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "zusammengesetzt"]
      - call: [pipe.add_stage, stg]
      - return: pipe

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [pipe, pipeline, { call: [geheim] }]
      - set: [fails, { +: [fails, { call: [expect_str, "pipeline and stage add up, the stage wins DEPLOY", { call: [secrets_of, pipe, 0] }, "gh_token:GH_TOKEN,deploy:DEPLOY"] }] }]
      - set: [fails, { +: [fails, { call: [expect_str, "a stage without its own gets the pipeline's", { call: [secrets_of, pipe, 1] }, "gh_token:GH_TOKEN,alt:DEPLOY"] }] }]
      - set: [fails, { +: [fails, { call: [expect_str, "a stage with secrets is opaque", { call: [class_of, pipe, 0] }, "opaque"] }] }]
      - set: [fails, { +: [fails, { call: [expect_str, "its steps are opaque too", { call: [step_class, pipe, 1, 0] }, "opaque"] }] }]
      - set: [fails, { +: [fails, { call: [expect_str, "and so is a stage with steps", { call: [class_of, pipe, 1] }, "opaque"] }] }]
      - decl: [other, pipeline, { call: [offen] }]
      - set: [fails, { +: [fails, { call: [expect_str, "no secrets: empty", { call: [secrets_of, other, 0] }, ""] }] }]
      - set: [fails, { +: [fails, { call: [expect_str, "no secrets: pure stays pure", { call: [class_of, other, 0] }, "pure"] }] }]
      - set: [fails, { +: [fails, { call: [expect_str, "a stage's own secrets", { call: [secrets_of, other, 1] }, "signing:SIGN_KEY"] }] }]
      - set: [fails, { +: [fails, { call: [expect_str, "make only that stage opaque", { call: [class_of, other, 1] }, "opaque"] }] }]
      - decl: [comp, pipeline, { call: [composed] }]
      - set: [fails, { +: [fails, { call: [expect_str, "composed form: secrets read back", { call: [secrets_of, comp, 0] }, "tok:TOKEN"] }] }]
      - set: [fails, { +: [fails, { call: [expect_str, "composed form: opaque with secrets", { call: [class_of, comp, 0] }, "opaque"] }] }]
      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_stage_secrets FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_stage_secrets PASS"]
      - return: 0
