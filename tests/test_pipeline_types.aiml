# SPEC: 62_pipelines
# spec/62 §13.5: pipeline / stage / step as instantiable types.
#
# The composed form is checked: structure built at runtime, body
# as a code bundle (i.e. compiled and checked, spec/62 F62-85).  Decisive
# are three things: the matrix unfolds at START, the structure is checked BEFORE the
# first step (F62-84), and a second run hits the cache.
# Expected exit code: 0

- def:
    name: do_build
    return: i32
    body:
      - print: ["   do_build runs"]
      - return: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── step: the body is a bundle, not text ───────────────────────────
      - decl: [bld, step, { call: [step.new] }]
      - call: [bld.set_name, "build"]
      - call: [bld.set_body, { call: [sys.bundle, "do_build", { context: true }] }]
      - call: [bld.set_cache, CacheClass.pure]
      - call: [bld.use_arg, "mode"]

      # ── stage ─────────────────────────────────────────────────────────
      - decl: [cmp, stage, { call: [stage.new] }]
      - call: [cmp.set_name, "compile"]
      - call: [cmp.add_step, bld]

      # ── pipeline with one axis from a runtime list ────────────────────
      - decl: [modes, list<string>]
      - call: [modes.push, "debug"]
      - call: [modes.push, "release"]
      - decl: [pipe, pipeline, { call: [pipeline.new] }]
      - call: [pipe.set_name, "generated"]
      - call: [pipe.add_param, "mode", modes]
      - call: [pipe.add_stage, cmp]

      - set: [fails, { +: [fails, { call: [expect, "two lanes from two values", { eq: [{ call: [pipe.lane_count] }, 2] }] }] }]

      - decl: [rc_one, i32, { call: [pipe.run] }]
      - print: ["first run rc=${rc_one}"]
      - set: [fails, { +: [fails, { call: [expect, "first run succeeds", { eq: [rc_one, 0] }] }] }]

      # second run: the same body, the same bindings → cache hit.
      - decl: [rc_two, i32, { call: [pipe.run] }]
      - set: [fails, { +: [fails, { call: [expect, "second run succeeds", { eq: [rc_two, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "second run came from the cache", { eq: [{ call: [pipe.reused_count] }, 2] }] }] }]

      # ── F62-84: a faulty structure fails BEFORE the first step ──────────
      - decl: [bad_step, step, { call: [step.new] }]
      - call: [bad_step.set_name, "broken"]
      - call: [bad_step.set_body, { call: [sys.bundle, "do_build", { context: true }] }]
      - call: [bad_step.use_arg, "gibtsnicht"]
      - decl: [bad_stage, stage, { call: [stage.new] }]
      - call: [bad_stage.set_name, "bad"]
      - call: [bad_stage.add_step, bad_step]
      - decl: [bad_pipe, pipeline, { call: [pipeline.new] }]
      - call: [bad_pipe.set_name, "broken"]
      - call: [bad_pipe.add_param, "mode", modes]
      - call: [bad_pipe.add_stage, bad_stage]
      - decl: [rc_bad, i32, { call: [bad_pipe.run] }]
      - print: ["fehlerhafte Pipeline rc=${rc_bad}"]
      - set: [fails, { +: [fails, { call: [expect, "unknown axis is rejected", { neq: [rc_bad, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "and no step ran in the process", { eq: [{ call: [bad_pipe.ran_count] }, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_pipeline_types FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_pipeline_types PASS"]
      - return: 0
