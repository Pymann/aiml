# SPEC?: 12_pointers   # derived from the file name, to be confirmed
- decl: [var_x, i32, 10]
- print: ["Original X: ${var_x}"]

# Declare pointer
- decl: [var_p, ptr<i32>, { '&': [var_x] }]

# Dereference Read
- print: ["Value via pointer: ${ { '?': [var_p] } }"]

# Dereference Write (Store) is still store: [var_p, val] ?
# User only asked about ref/deref operators.
# store is a command.
- store: [var_p, 20]
# Dereference Write (Store)
- store: [var_p, 20]
- print: ["Modified X via pointer: ${var_x}"]

# Pointer to Pointer
- decl: [var_pp, ptr<ptr<i32>>, { '&': [var_p] }]
# Double Dereference (Syntax: '??' or '???')
- print: ["Value of X via PP (??): ${ { '??': [var_pp] } }"]

# Address of Address Check (&&)
# { '&&': [var_x] } creates a temporary pointer to pointer to var_x?
# No, &&[var_x] -> &(&var_x). &var_x is a value (address). &(&var_x) is address of that temporary value.
# Let's verify we can take address of address.
- decl: [pp_temp, ptr<ptr<i32>>, { '&&': [var_x] }]
- print: ["Value via pp_temp (should be var_x): ${ { '??': [pp_temp] } }"]

# Deep Store (Depth 2)
# Writes to *(*var_pp) which is var_x
# Depth 1 (default) is *var_pp. Depth 2 is **var_pp.
- store: [var_pp, 99, 2]
- print: ["Modified X via PP deep store: ${var_x}"]

# Pointer Arithmetic? (Maybe later)
# - set: [var_p, { +: [var_p, 1] }] 
