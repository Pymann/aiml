# SPEC: 44_6_prefabs
# spec/44_6 §5g: a `text_input` takes key presses of the FOCUSED field —
# one per press.  Reported on the cosmos console source text field: "backspace
# always deleted 2 characters" (2026-10-18).
#
# What is checked is the NUMBER: one backspace, one character less.  Without this test
# a doubly queued event is invisible — on every single press the field looks
# "somehow wrong", but nothing is measurable.
#
# Requires: display
# Expected exit code: 0

- prefab:
    name: BackspaceScene
    width: 520
    height: 300
    children:
      # Like cosmos' src_box: multi-line with line numbers.
      - { name: code_input, type: text_input, gutter: true,
          x: 20, y: 20, width: 480, height: 200,
          bg_color: 0x0D1218FF, border_color: 0x2D3642FF, border_width: 1.0,
          color: 0xDDE6F0FF }

# A frame as the host drives it: mouse pipeline, then draw.
- def:
    name: one_frame
    args: [[win, window_handle], [pos_x, f32], [pos_y, f32]]
    body:
      - call: [engine.update_hover, pos_x, pos_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 520, 300, "backspace"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 520, 300]
      - call: [input.init, win]
      - decl: [font, ui_font, { call: [ui.load_font_default, 12.0] }]
      - if: { condition: { neq: [font, null] }, then: [{ call: [engine.prefab_set_font, font] }] }

      - decl: [scene, prefab_instance, { call: [engine.instantiate, "BackspaceScene"] }]
      - call: [scene.set_pos, 0.0, 0.0]
      - call: [scene.set_text, "code_input", "abcdef"]

      - decl: [box_x, f32, { call: [scene.child_rect_x, "code_input"] }]
      - decl: [box_y, f32, { call: [scene.child_rect_y, "code_input"] }]
      - decl: [box_w, f32, { call: [scene.child_rect_w, "code_input"] }]
      - if: { condition: { lt: [box_w, 1.0] }, then: [{ print: ["FAIL widget not found"] }, { return: 1 }] }
      - call: [one_frame, win, 0.0, 0.0]

      # Click behind the last character: far right in the first line.
      - decl: [aim_x, f32, { +: [box_x, { -: [box_w, 20.0] }] }]
      - decl: [aim_y, f32, { +: [box_y, 8.0] }]
      - call: [input.post_mouse_move, aim_x, aim_y]
      - call: [one_frame, win, aim_x, aim_y]
      - call: [input.post_mouse_down, 0]
      - call: [one_frame, win, aim_x, aim_y]
      - call: [input.post_mouse_up, 0]
      - call: [one_frame, win, aim_x, aim_y]

      # One press, one frame.
      - call: [input.post_key_down, "backspace"]
      - call: [one_frame, win, aim_x, aim_y]
      - call: [input.post_key_up, "backspace"]
      - call: [one_frame, win, aim_x, aim_y]
      - decl: [after_one, string, { call: [scene.text_value, "code_input"] }]
      - print: ["after one backspace: '${after_one}' (${after_one.len} characters)"]
      - if:
          condition: { neq: [after_one, "abcde"] }
          then:
            - print: ["FAIL one backspace does not delete exactly ONE character: '${after_one}' instead of 'abcde'"]
            - call: [engine.destroy_window, win]
            - return: 1

      # And one more — so that an error does not only hang on the first press.
      - call: [input.post_key_down, "backspace"]
      - call: [one_frame, win, aim_x, aim_y]
      - call: [input.post_key_up, "backspace"]
      - call: [one_frame, win, aim_x, aim_y]
      - decl: [after_two, string, { call: [scene.text_value, "code_input"] }]
      - print: ["after two backspaces: '${after_two}' (${after_two.len} characters)"]
      - if:
          condition: { neq: [after_two, "abcd"] }
          then:
            - print: ["FAIL two backspaces do not delete exactly TWO characters: '${after_two}' instead of 'abcd'"]
            - call: [engine.destroy_window, win]
            - return: 1

      # The same for delete: the cursor is at the end, so NOTHING may
      # disappear — a delete at the end of the text is a non-event.
      - call: [input.post_key_down, "delete"]
      - call: [one_frame, win, aim_x, aim_y]
      - call: [input.post_key_up, "delete"]
      - call: [one_frame, win, aim_x, aim_y]
      - decl: [after_del, string, { call: [scene.text_value, "code_input"] }]
      - if:
          condition: { neq: [after_del, "abcd"] }
          then:
            - print: ["FAIL delete at the end of the text changes something: '${after_del}'"]
            - call: [engine.destroy_window, win]
            - return: 1

      # ── Enter key in the MULTI-LINE field (spec/44_6 §5g) ───────────────
      # A code field in which one cannot start a line is not an editor.
      # Before the fix (2026-10-18) Enter did NOTHING AT ALL here.
      - call: [input.post_key_down, "enter"]
      - call: [one_frame, win, aim_x, aim_y]
      - call: [input.post_key_up, "enter"]
      - call: [one_frame, win, aim_x, aim_y]
      - decl: [after_ret, string, { call: [scene.text_value, "code_input"] }]
      - print: ["after Enter: '${after_ret}' (${after_ret.len} characters)"]
      - if:
          condition: { neq: [after_ret, "abcd\n"] }
          then:
            - print: ["FAIL Enter makes no new line in the multi-line field: '${after_ret}'"]
            - call: [engine.destroy_window, win]
            - return: 1
      # And exactly ONE: a second line break per press would be the same doubling
      # as with the backspace key.
      - call: [input.post_text, "x"]
      - call: [one_frame, win, aim_x, aim_y]
      - decl: [after_x, string, { call: [scene.text_value, "code_input"] }]
      - if:
          condition: { neq: [after_x, "abcd\nx"] }
          then:
            - print: ["FAIL after Enter the character does not land in the new line: '${after_x}'"]
            - call: [engine.destroy_window, win]
            - return: 1

      - print: ["test_prefab_backspace PASS"]
      - call: [engine.destroy_window, win]
      - return: 0
