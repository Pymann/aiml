# SPEC: 44_6_prefabs
# spec/44_6: eine Pfeiltaste bewegt den Cursor um GENAU ein Zeichen.
#
# Gemeldet am cosmos-Quelltextfeld (2026-10-15): „es springt bei jeder
# pfeiltaste immer 2 zeichen".  Geprueft wird das Einzige, was man von aussen
# sehen kann: WO ein danach getipptes Zeichen landet.
#
# Requires: display
# Expected exit code: 0

- prefab:
    name: ArrowScene
    width: 420
    height: 260
    children:
      - { name: one_input, type: text_input, font_size: 12, x: 20, y: 20, width: 380, height: 26,
          bg_color: 0x0D1218FF, border_color: 0x2D3642FF, border_width: 1.0, color: 0xDDE6F0FF }
      - { name: many_input, type: text_input, font_size: 12, gutter: true,
          x: 20, y: 70, width: 380, height: 150,
          bg_color: 0x0D1218FF, border_color: 0x2D3642FF, border_width: 1.0, color: 0xDDE6F0FF }

- def:
    name: step_frame
    args: [[win, window_handle]]
    body:
      - call: [engine.update_hover, 5.0, 5.0]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 420, 260, "arrows"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 420, 260]
      - call: [input.init, win]
      - decl: [font, ui_font, { call: [ui.load_font_default, 12.0] }]
      - if: { condition: { neq: [font, null] }, then: [{ call: [engine.prefab_set_font, font] }] }
      - decl: [scene, prefab_instance, { call: [engine.instantiate, "ArrowScene"] }]
      - call: [scene.set_pos, 0.0, 0.0]

      # ── einzeilig ────────────────────────────────────────────────────────
      - call: [scene.set_text, "one_input", "abcdef"]
      - call: [scene.focus, "one_input"]
      - call: [step_frame, win]
      # Cursor steht nach set_text bei 0.  Zweimal nach RECHTS muss GENAU zwei
      # Zeichen weit sein: 'ab|cdef'.  Springt eine Taste zwei Zeichen, landet
      # das X bei 'abcd|ef' — daran ist der Fehler eindeutig zu erkennen.
      - call: [input.post_key_down, "right"]
      - call: [input.post_key_up, "right"]
      - call: [step_frame, win]
      - call: [input.post_key_down, "right"]
      - call: [input.post_key_up, "right"]
      - call: [step_frame, win]
      - call: [input.post_text, "X"]
      - call: [step_frame, win]
      - decl: [got_one, string, { call: [scene.text_value, "one_input"] }]
      - if:
          condition: { neq: [got_one, "abXcdef"] }
          then:
            - print: ["FAIL einzeilig: '${got_one}' expected 'abXcdef' (zwei Rechtspfeile = zwei Zeichen)"]
            - call: [engine.destroy_window, win]
            - return: 1

      # ── mehrzeilig mit Gutter ────────────────────────────────────────────
      - call: [scene.set_text, "many_input", "abcdef\nzweite"]
      - call: [scene.focus, "many_input"]
      - call: [step_frame, win]
      - call: [input.post_key_down, "right"]
      - call: [input.post_key_up, "right"]
      - call: [step_frame, win]
      - call: [input.post_text, "Y"]
      - call: [step_frame, win]
      - decl: [got_many, string, { call: [scene.text_value, "many_input"] }]
      - if:
          condition: { eq: [got_many, "aYbcdef\nzweite"] }
          then:
            - print: ["PASS caret_arrows: eine Pfeiltaste bewegt genau ein Zeichen"]
            - call: [engine.destroy_window, win]
            - return: 0
      - print: ["FAIL mehrzeilig: '${got_many}' expected 'aYbcdef\nzweite' (ein Rechtspfeil = ein Zeichen)"]
      - call: [engine.destroy_window, win]
      - return: 1
