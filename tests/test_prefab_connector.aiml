# SPEC?: 44_6_prefabs   # aus dem Dateinamen, zu bestaetigen
# Requires: display
# Smoke-test for the connector (cable) API: type resolution, engine.connect,
# connector methods, and instance.set_connector_anchor.  Needs var_a GL context,
# so it is display-gated (auto-skipped headless).

- prefab:
    name: NodeBox
    width: 80
    height: 80
    children:
      - { name: bg_layer, type: rect, x: 0, y: 0, width: 80, height: 80,
          bg_color: 0x2A4870FF, border_color: 0x66B0E0FF, border_width: 1.5,
          corner_radius: 8.0 }

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 800, 600, "connector"] }]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 800, 600]

      - decl: [var_a, prefab_instance, { call: [engine.instantiate, "NodeBox"] }]
      - call: [var_a.set_pos, 100.0, 100.0]
      - decl: [var_b, prefab_instance, { call: [engine.instantiate, "NodeBox"] }]
      - call: [var_b.set_pos, 400.0, 300.0]
      - decl: [var_c, prefab_instance, { call: [engine.instantiate, "NodeBox"] }]
      - call: [var_c.set_pos, 400.0, 100.0]

      # Distributed anchor on the hub, edge on the leaves.
      - call: [var_a.set_connector_anchor, 2]
      - call: [var_b.set_connector_anchor, 1]
      - call: [var_c.set_connector_anchor, 1]

      - decl: [cab1, connector, { call: [engine.connect, var_a, var_b] }]
      - call: [cab1.set_colors, 0x44CCFFFF, 0x2266AAFF]
      - call: [cab1.set_highlight, 0xFFFFFFFF]
      - call: [cab1.set_width, 8.0]
      - call: [cab1.set_bow, 0.15]

      - decl: [cab2, connector, { call: [engine.connect, var_a, var_c] }]
      - call: [cab2.set_colors, 0xFFAA44FF, 0xAA5522FF]
      - call: [cab2.set_width, 6.0]

      - call: [log.info, "connector smoke: 2 cables created"]

      # One render tick to exercise the cable geometry/shader path.
      - call: [gl.clear_all, 0.05, 0.05, 0.1, 1.0]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]

      - call: [cab2.destroy]
      - call: [log.info, "connector smoke OK"]
      - return: 0
