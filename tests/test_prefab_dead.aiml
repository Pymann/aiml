# SPEC: 44_8_prefab_static,44_8_vocab
# Positive test (Tier 3, dead prefab): a declared prefab that is NEVER
# instantiated produces a compiler WARNING (not an error) — the
# compilation runs through normally.  A used prefab is NOT reported.
# See spec/44_8 (Tier 3).
#
# Expected exit code: 0
#
# Diagnostic form (warning), only for "Dead":
#   prefab 'DeadBox' is declared but never instantiated in this build — no
#   engine.instantiate("Dead") anywhere. ...
#
# "UsedBox" is instantiated behind a condition that is false at runtime; the
# static walk sees the literal regardless of reachability → no
# dead warning for "UsedBox" (headless-capable, GL is never touched).

- prefab:
    name: UsedBox
    width: 100
    height: 40
    children:
      # `spawn: ListRow` instantiates the row prefab declaratively per list element —
      # a use, although it is NEVER called via engine.instantiate("Row").
      - { name: list_box, type: container, x: 0, y: 20, width: 100, height: 20,
          spawn: ListRow, layout: vflow, gap: 2 }
      - { name: title, type: label, x: 0, y: 0, width: 100, height: 20 }

# referenced only via spawn: → must NOT be reported as dead.
- prefab:
    name: ListRow
    width: 100
    height: 18
    children:
      - { name: text_lbl, type: label, x: 0, y: 0, width: 100, height: 18 }

- prefab:
    name: DeadBox
    width: 50
    height: 50
    children:
      - { name: icon_img, type: sprite, x: 0, y: 0, width: 50, height: 50 }

- def:
    name: main
    return: i32
    body:
      - decl: [flag, i32, 0]
      - if:
          condition: { eq: [flag, 1] }
          then:
            - decl: [inst, prefab_instance, { call: [engine.instantiate, "UsedBox"] }]
      - print: ["PASS prefab_dead: 'UsedBox' (instantiate) + 'ListRow' (spawn) used → no warning; only 'DeadBox' → warning"]
      - return: 0
