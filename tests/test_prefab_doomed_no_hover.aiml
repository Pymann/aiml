# SPEC: 44_6_prefabs
# An instance marked for deletion must not take any more input, and the
# scene must not keep a reference to it after it has been freed.
#
# The gap: `destroy` does not clean up nested children immediately, but sets
# them to parent=null + pending_delete; the sweep at the end of the frame frees them and
# marks THEIR children the same way.  So a second-level child exists
# for ONE whole frame as an orphan: top-level (parent==null), visible, and
# `hit_test` did not query `pending_delete` — so the orphan could take the hover
# although it is already dead.  It renders at raw local
# coordinates, so it shows up somewhere at the window origin.  When the next
# sweep frees it, `g_scene->hovered` pointed to freed memory, and the
# next `update_hover` wrote into it (`hovered->hovered = false`).
#
# Checked in this order:
#   1. starting point: the grandchild is nested and NOT hit-testable (otherwise
#      step 3 would also be green with broken nesting)
#   2. after destroy+sweep the grandchild still lives (orphan frame) ...
#   3. ... but takes no hover: get_hovered stays null
#   4. after the second sweep the scene holds no hover reference any more
# Requires: display
# Expected exit code: 0

- prefab:
    name: DoomRoot
    width: 120
    height: 90
    children:
      - { name: root_body, type: rect, x: 0, y: 0, width: 120, height: 90,
          bg_color: 0x404040FF }

- prefab:
    name: DoomRow
    width: 100
    height: 70
    children:
      - { name: row_body, type: rect, x: 0, y: 0, width: 100, height: 70,
          bg_color: 0x606060FF }

- prefab:
    name: DoomLeaf
    width: 80
    height: 60
    children:
      - { name: leaf_body, type: rect, x: 0, y: 0, width: 80, height: 60,
          bg_color: 0x8A3A3AFF }

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "doomed"] }]
      - if: { condition: { eq: [win, null] }, then: [{ call: [log.error, "FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]

      # root → row → leaf.  The grandchild's local position is at the same time its
      # orphan position, because an orphan renders at raw local coordinates.
      - decl: [root, prefab_instance, { call: [engine.instantiate, "DoomRoot"] }]
      - call: [root.set_pos, 10.0, 10.0]
      - call: [root.set_z, 5]
      - decl: [row, prefab_instance, { call: [engine.instantiate, "DoomRow"] }]
      - call: [root.add_child, row]
      - decl: [leaf, prefab_instance, { call: [engine.instantiate, "DoomLeaf"] }]
      - call: [row.add_child, leaf]
      - call: [leaf.set_pos, 200.0, 180.0]

      - decl: [probe_x, f32, 230.0]
      - decl: [probe_y, f32, 200.0]

      # ── 1. starting point: nested, so not hit-testable ────────────────
      - call: [engine.draw_scene]
      - decl: [hit_nested, prefab_instance, { call: [engine.hit_test, probe_x, probe_y] }]
      - if:
          condition: { peq: [hit_nested, leaf] }
          then: [{ call: [log.error, "FAIL nested grandchild is hit-testable — nesting broken, the test would be worthless"] }, { return: 1 }]

      # ── 2. destroy + sweep: the grandchild still lives as an orphan ─────
      - call: [engine.destroy, root]
      - call: [engine.draw_scene]

      # ── 3. ... but takes no hover any more ─────────────────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, probe_x, probe_y]
      - call: [engine.update_hover, probe_x, probe_y]
      - decl: [hov_doomed, prefab_instance, { call: [engine.get_hovered] }]
      - if:
          condition: { pneq: [hov_doomed, null] }
          then: [{ call: [log.error, "FAIL an orphan marked for deletion took the hover"] }, { return: 1 }]

      # ── 4. the second sweep frees the orphan — no reference remains ─────
      - call: [engine.draw_scene]
      - call: [engine.update_hover, probe_x, probe_y]
      - decl: [hov_after, prefab_instance, { call: [engine.get_hovered] }]
      - if:
          condition: { pneq: [hov_after, null] }
          then: [{ call: [log.error, "FAIL the scene still holds a hover reference after freeing"] }, { return: 1 }]

      - call: [engine.destroy_window, win]
      - call: [log.info, "PASS prefab_doomed_no_hover"]
      - return: 0
