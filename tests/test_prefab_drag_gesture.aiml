# SPEC: 44_6_prefabs,44_0_input
# spec/44_6 "engine.update_drag_gesture — pick up at the press point".
#
# The two error classes that are unavoidable with engine.update_drag and that
# this test nails down:
#   A) pickup at the wrong card.  update_drag is level-triggered and picks
#      with THIS frame's mouse position.  Browser callbacks write the
#      position live, key edges only at the frame snapshot (spec/44_0 §7.1) —
#      so the edge belongs to an older position.  With a moving mouse
#      update_drag grabs the card that is under the cursor NOW.
#      update_drag_gesture picks up at drag_origin, i.e. at the press point.
#   B) a tap becomes a drag.  Without a threshold every click is a mini drag.
#
# Checked in this order:
#   1. press without movement = candidate (1), NO drag
#   2. movement beyond the threshold = drags (2), namely the card at the press point,
#      even if the cursor is over another card by now
#   3. release reports "released" (3) exactly once; get_drag_source still names
#      the source in the same frame
#   4. counter-probe cancel: reports (4) and NOT (3)
# Requires: display
# Expected exit code: 0

- prefab:
    name: GestureCardA
    width: 80
    height: 100
    children:
      - { name: card_a_body, type: rect, x: 0, y: 0, width: 80, height: 100,
          bg_color: 0x3A5A8AFF }

- prefab:
    name: GestureCardB
    width: 80
    height: 100
    children:
      - { name: card_b_body, type: rect, x: 0, y: 0, width: 80, height: 100,
          bg_color: 0x8A3A5AFF }

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "gesture"] }]
      - if: { condition: { eq: [win, null] }, then: [{ call: [log.error, "FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]

      # Card A on the left (20,50), card B on the right (200,50) — far apart, so that
      # "press point" and "current cursor" are unambiguously different cards.
      - decl: [card_a, prefab_instance, { call: [engine.instantiate, "GestureCardA"] }]
      - call: [card_a.set_pos, 20.0, 50.0]
      - call: [card_a.set_draggable, 1]
      - decl: [card_b, prefab_instance, { call: [engine.instantiate, "GestureCardB"] }]
      - call: [card_b.set_pos, 200.0, 50.0]
      - call: [card_b.set_draggable, 1]
      - call: [engine.draw_scene]

      - decl: [a_mid_x, f32, 60.0]
      - decl: [a_mid_y, f32, 100.0]
      - decl: [b_mid_x, f32, 240.0]
      - decl: [b_mid_y, f32, 100.0]

      # ── 1. press without movement = candidate, no drag ──────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, a_mid_x, a_mid_y]
      - decl: [g_idle, i32, { call: [engine.update_drag_gesture, a_mid_x, a_mid_y] }]
      - if: { condition: { neq: [g_idle, 0] }, then: [{ call: [log.error, "FAIL without a press state ${g_idle}, expected 0"] }, { return: 1 }] }

      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - decl: [g_press, i32, { call: [engine.update_drag_gesture, a_mid_x, a_mid_y] }]
      - if:
          condition: { neq: [g_press, 1] }
          then: [{ call: [log.error, "FAIL press without movement gave state ${g_press}, expected 1 (candidate) — a tap must not be a drag"] }, { return: 1 }]
      - if:
          condition: { pneq: [{ call: [engine.get_dragged] }, null] }
          then: [{ call: [log.error, "FAIL tap already started a drag"] }, { return: 1 }]

      # ── 2. beyond the threshold: the card at the PRESS POINT is dragged ──
      # The cursor is now over card B.  Nevertheless card A
      # must be picked up, because that is where the press happened.
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, b_mid_x, b_mid_y]
      - decl: [g_drag, i32, { call: [engine.update_drag_gesture, b_mid_x, b_mid_y] }]
      - if:
          condition: { neq: [g_drag, 2] }
          then: [{ call: [log.error, "FAIL after movement state ${g_drag}, expected 2 (drags)"] }, { return: 1 }]
      - decl: [picked, prefab_instance, { call: [engine.get_dragged] }]
      - if:
          condition: { peq: [picked, null] }
          then: [{ call: [log.error, "FAIL no drag after exceeding the threshold"] }, { return: 1 }]
      - if:
          condition: { pneq: [picked, card_a] }
          then: [{ call: [log.error, "FAIL the card under the CURSOR was picked up, not the one at the press point"] }, { return: 1 }]

      # ── 3. release = exactly once "released" ─────────────────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - decl: [g_drop, i32, { call: [engine.update_drag_gesture, b_mid_x, b_mid_y] }]
      - if:
          condition: { neq: [g_drop, 3] }
          then: [{ call: [log.error, "FAIL release gave state ${g_drop}, expected 3"] }, { return: 1 }]
      - decl: [src, prefab_instance, { call: [engine.get_drag_source] }]
      - if:
          condition: { pneq: [src, card_a] }
          then: [{ call: [log.error, "FAIL get_drag_source does not name the source in the drop frame"] }, { return: 1 }]
      - call: [engine.swap, win]
      - decl: [g_after, i32, { call: [engine.update_drag_gesture, b_mid_x, b_mid_y] }]
      - if:
          condition: { eq: [g_after, 3] }
          then: [{ call: [log.error, "FAIL drop was reported twice — one drop per gesture"] }, { return: 1 }]

      # ── 4. counter-probe: cancel reports 4, not 3 ──────────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, a_mid_x, a_mid_y]
      - call: [engine.update_drag_gesture, a_mid_x, a_mid_y]
      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_drag_gesture, a_mid_x, a_mid_y]
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, b_mid_x, b_mid_y]
      - decl: [g_drag2, i32, { call: [engine.update_drag_gesture, b_mid_x, b_mid_y] }]
      - if:
          condition: { neq: [g_drag2, 2] }
          then: [{ call: [log.error, "FAIL second gesture does not drag (${g_drag2})"] }, { return: 1 }]
      - call: [engine.swap, win]
      - call: [input.post_touch_cancel]
      - decl: [g_cancel, i32, { call: [engine.update_drag_gesture, b_mid_x, b_mid_y] }]
      - if:
          condition: { neq: [g_cancel, 4] }
          then: [{ call: [log.error, "FAIL Abbruch gab Zustand ${g_cancel}, expected 4"] }, { return: 1 }]
      - if:
          condition: { pneq: [{ call: [engine.get_dragged] }, null] }
          then: [{ call: [log.error, "FAIL drag continues after the cancel"] }, { return: 1 }]

      # ── 5. AFTER the cancel the next gesture must drag again ────────────
      # This probe was missing at first and would have hidden a real bug: the
      # cancel edge was never cleared in the native branch, so
      # drag_cancelled permanently reported 1 and update_drag_gesture immediately aborted EVERY further
      # drag — symptom: from the first cancel on nothing could be dragged at all.
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, a_mid_x, a_mid_y]
      - decl: [g_recover, i32, { call: [engine.update_drag_gesture, a_mid_x, a_mid_y] }]
      - if:
          condition: { eq: [g_recover, 4] }
          then: [{ call: [log.error, "FAIL cancel edge sticks — every further drag is aborted immediately"] }, { return: 1 }]
      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_drag_gesture, a_mid_x, a_mid_y]
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, b_mid_x, b_mid_y]
      - decl: [g_drag3, i32, { call: [engine.update_drag_gesture, b_mid_x, b_mid_y] }]
      - if:
          condition: { neq: [g_drag3, 2] }
          then: [{ call: [log.error, "FAIL third gesture does not drag after the cancel (${g_drag3})"] }, { return: 1 }]

      - call: [engine.destroy_window, win]
      - call: [log.info, "PASS prefab_drag_gesture"]
      - return: 0
