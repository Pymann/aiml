# SPEC: 44_6_prefabs
# spec/44_6 §8.1: engine.draw_scene_upto(z) zeichnet nur die Instanzen unter z,
# das abschliessende draw_scene den Rest -- jede Instanz GENAU EINMAL.
#
# Geprueft wird am Pixel, nicht am Zustand.  Beide Flaechen sind halb
# durchsichtig; dadurch ist das Ergebnis eine Rechnung, die jeden Fehler
# sichtbar macht:
#   * eine Schicht gar nicht gezeichnet  -> Farbe fehlt
#   * eine Schicht ZWEIMAL gezeichnet    -> zu hell (0.5 statt 0.25 Restanteil)
#   * Reihenfolge vertauscht             -> andere Mischung
#
# Rechnung bei Clear = schwarz, unten = rot mit a=0.5, oben = blau mit a=0.5:
#   nach unten:            rot*0.5                 -> (128,  0,  0)
#   nach oben:  blau*0.5 + (128,0,0)*0.5           -> ( 64,  0,128)
# Wird unten zweimal gezeichnet, steht dort 191 statt 128 und danach 95 statt 64.
# Requires: display
# Expected exit code: 0

- prefab:
    name: UntenRot
    width: 64
    height: 64
    children:
      - { name: flaeche, type: rect,
          x: 0, y: 0, width: 64, height: 64,
          bg_color: 0xFF000080 }

- prefab:
    name: ObenBlau
    width: 64
    height: 64
    children:
      - { name: flaeche, type: rect,
          x: 0, y: 0, width: 64, height: 64,
          bg_color: 0x0000FF80 }

- decl: [fehl, i32, 0]

# Ein Kanal des Pixels in der Mitte.  kanal: 0=R 1=G 2=B
- def:
    name: kanal_mitte
    args: [[kanal, i32]]
    return: i32
    body:
      - decl: [pixel, buffer<u8>, { call: [gl.read_rgba8, 32, 32, 1, 1] }]
      - return: { cast: [{ call: [pixel.get, kanal] }, i32] }

# Toleranz 6, weil die Mischung in 8 Bit rundet.
- def:
    name: pruefe
    args: [[was, string], [ist, i32], [soll, i32]]
    body:
      - decl: [abst, i32, { "-": [ist, soll] }]
      - if: { condition: { lt: [abst, 0] }, then: [{ set: [abst, { "-": [0, abst] }] }] }
      - if:
          condition: { gt: [abst, 6] }
          then:
            - set: [fehl, { "+": [fehl, 1] }]
            - print: ["FAIL ${was}: ist ${ist}, soll ${soll}"]

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 64, 64, "draw_upto"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL kein Fenster"] }, { return: 1 }] }
      - call: [engine.prefab_scene_init, 64, 64]
      - decl: [unten, prefab_instance, { call: [engine.instantiate, "UntenRot"] }]
      - call: [unten.set_z, 5]
      - decl: [oben, prefab_instance, { call: [engine.instantiate, "ObenBlau"] }]
      - call: [oben.set_z, 50]

      # ── 1. Die ganze Szene in einem Zug: der Sollwert, gegen den sich die
      #       Teilzeichnung messen muss.
      - call: [gl.clear_all, 0.0, 0.0, 0.0, 1.0]
      - call: [engine.draw_scene]
      - call: [pruefe, "ganz: rot", { call: [kanal_mitte, 0] }, 64]
      - call: [pruefe, "ganz: blau", { call: [kanal_mitte, 2] }, 128]

      # ── 2. Geteilt.  Nach der unteren Haelfte steht NUR das Rot da -- das
      #       Blau wartet noch.
      - call: [gl.clear_all, 0.0, 0.0, 0.0, 1.0]
      - call: [engine.draw_scene_upto, 10]
      - call: [pruefe, "geteilt, untere Haelfte: rot", { call: [kanal_mitte, 0] }, 128]
      - call: [pruefe, "geteilt, untere Haelfte: noch kein blau", { call: [kanal_mitte, 2] }, 0]

      # ── 3. Der Rest.  Das Ergebnis MUSS dem ungeteilten Zug aus 1 gleichen:
      #       jede Instanz genau einmal.
      - call: [engine.draw_scene]
      - call: [pruefe, "geteilt, fertig: rot wie ungeteilt", { call: [kanal_mitte, 0] }, 64]
      - call: [pruefe, "geteilt, fertig: blau wie ungeteilt", { call: [kanal_mitte, 2] }, 128]

      # ── 4. Mehrere Schnitte im selben Frame, und ein Schnitt UNTER allem
      #       (zeichnet nichts) sowie einer UEBER allem (zeichnet beide).
      - call: [gl.clear_all, 0.0, 0.0, 0.0, 1.0]
      - call: [engine.draw_scene_upto, 0]
      - call: [pruefe, "Schnitt unter allem: nichts gezeichnet", { call: [kanal_mitte, 0] }, 0]
      - call: [engine.draw_scene_upto, 10]
      - call: [pruefe, "dann die untere: rot", { call: [kanal_mitte, 0] }, 128]
      - call: [engine.draw_scene_upto, 999]
      - call: [pruefe, "dann alles: blau", { call: [kanal_mitte, 2] }, 128]
      - call: [pruefe, "dann alles: rot gemischt", { call: [kanal_mitte, 0] }, 64]
      # draw_scene schliesst den Frame abst und darf NICHTS mehr hinzufuegen.
      - call: [engine.draw_scene]
      - call: [pruefe, "Abschluss zeichnet nicht doppelt: rot", { call: [kanal_mitte, 0] }, 64]
      - call: [pruefe, "Abschluss zeichnet nicht doppelt: blau", { call: [kanal_mitte, 2] }, 128]

      # ── 5. Nach dem Abschluss ist die Marke zurueckgesetzt: der naechste
      #       Frame zeichnet wieder die ganze Szene.
      - call: [gl.clear_all, 0.0, 0.0, 0.0, 1.0]
      - call: [engine.draw_scene]
      - call: [pruefe, "naechster Frame wieder vollstaendig: rot", { call: [kanal_mitte, 0] }, 64]
      - call: [pruefe, "naechster Frame wieder vollstaendig: blau", { call: [kanal_mitte, 2] }, 128]

      - call: [engine.destroy_window, win]
      - if: { condition: { neq: [fehl, 0] }, then: [{ print: ["FAIL draw_scene_upto: ${fehl}"] }, { return: 1 }] }
      - print: ["PASS prefab_draw_upto: Teilzeichnung, Rest, mehrere Schnitte, Marke zurueckgesetzt"]
      - return: 0
