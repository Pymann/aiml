# SPEC: 44_6_prefabs
# spec/44_6 "Modal: set_input_blocking".
#
# The gap this test nails down: `hit_test` arbitrates over z, but the
# WIDGET pass does not.  That one deliberately runs over all instances, so that
# a transparent panel lets its own widgets through — with the consequence
# that a fullscreen overlay correctly blocked the hover, but the buttons BELOW it
# stayed clickable.  In 9rooms that means: the surrender dialog lies
# over the board, and a click into its area additionally triggered the
# confirm button below it — a combat confirmation nobody wanted.
#
# Checked in this order:
#   1. starting point WITHOUT blocking: the button BELOW fires although the
#      overlay lies above it.  Without this step 2. would be worthless — the test
#      could also be green because the click never arrives.
#   2. drag starting point: the card below the overlay can be dragged
#   3. switched to blocking → the button below does NOT fire any more
#   4. ... the overlay's OWN button keeps firing (it does not block
#      itself, a dialog needs buttons of its own)
#   5. ... and no move starts below the overlay any more
#   6. switched back, the button below fires again (effective both ways)
# Requires: display
# Expected exit code: 0

- prefab:
    name: BlkUnder
    width: 200
    height: 60
    children:
      - { name: und_btn, type: button, pos_x: 0, pos_y: 0, width: 200, height: 60,
          label: "unten", bg_color: 0x334455FF, color: 0xFFFFFFFF, font_size: 12 }

- prefab:
    name: BlkCard
    width: 60
    height: 80
    draggable: true
    children:
      - { name: card_face, type: rect, pos_x: 0, pos_y: 0, width: 60, height: 80,
          bg_color: 0x3A5A8AFF }

- prefab:
    name: BlkModal
    width: 400
    height: 300
    children:
      - { name: dim_rect, type: rect, pos_x: 0, pos_y: 0, width: 400, height: 300,
          bg_color: 0x20202080 }
      - { name: mod_btn, type: button, pos_x: 10, pos_y: 10, width: 100, height: 40,
          label: "oben", bg_color: 0x553333FF, color: 0xFFFFFFFF, font_size: 12 }

- def:
    name: click_at
    args: [[win, window_handle], [clk_x, f32], [clk_y, f32]]
    body:
      # spec/44_0 §8.3: inject AFTER engine.swap, swap clears the latches.
      # A click = press in one frame, release in the next (§8.4).
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, clk_x, clk_y]
      - call: [engine.update_hover, clk_x, clk_y]
      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_hover, clk_x, clk_y]
      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - call: [engine.update_hover, clk_x, clk_y]

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "blocking"] }]
      - if: { condition: { eq: [win, null] }, then: [{ call: [log.error, "FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]

      - decl: [under, prefab_instance, { call: [engine.instantiate, "BlkUnder"] }]
      - call: [under.set_pos, 50.0, 200.0]
      - call: [under.set_z, 5]
      - decl: [card, prefab_instance, { call: [engine.instantiate, "BlkCard"] }]
      - call: [card.set_pos, 300.0, 200.0]
      - call: [card.set_z, 5]
      - decl: [modal, prefab_instance, { call: [engine.instantiate, "BlkModal"] }]
      - call: [modal.set_pos, 0.0, 0.0]
      - call: [modal.set_z, 100]
      - call: [engine.draw_scene]

      # centre of the lower button (50..250 / 200..260) and of the upper one (10..110 / 10..50).
      - decl: [und_x, f32, 150.0]
      - decl: [und_y, f32, 230.0]
      - decl: [mod_x, f32, 60.0]
      - decl: [mod_y, f32, 30.0]

      # ── 1. starting point: the button BELOW fires despite the overlay ─────
      - call: [click_at, win, und_x, und_y]
      - if:
          condition: { neq: [{ call: [under.child_clicked, "und_btn"] }, 1] }
          then: [{ call: [log.error, "FAIL starting point: the click does not reach the lower button at all — the test would be worthless"] }, { return: 1 }]

      # ── 2. drag starting point: the card below the overlay can be grabbed ──
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 330.0, 240.0]
      - call: [engine.update_hover, 330.0, 240.0]
      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_hover, 330.0, 240.0]
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 330.0, 252.0]
      - call: [engine.update_hover, 330.0, 252.0]
      - decl: [gst_a, i32, { call: [engine.update_drag_gesture, 330.0, 252.0] }]
      - decl: [drg_a, prefab_instance, { call: [engine.get_dragged] }]
      - if:
          condition: { pneq: [drg_a, card] }
          then: [{ call: [log.error, "FAIL drag starting point: the card was not picked up (gst=${gst_a}) — step 5 would be worthless"] }, { return: 1 }]
      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - call: [engine.update_hover, 330.0, 252.0]
      - call: [engine.update_drag_gesture, 330.0, 252.0]

      # ── 3. blocking: the button below does NOT fire any more ───────────
      - call: [modal.set_input_blocking, 1]
      - if:
          condition: { neq: [{ call: [modal.get_input_blocking] }, 1] }
          then: [{ call: [log.error, "FAIL get_input_blocking does not return the set value"] }, { return: 1 }]
      - call: [click_at, win, und_x, und_y]
      - if:
          condition: { neq: [{ call: [under.child_clicked, "und_btn"] }, 0] }
          then: [{ call: [log.error, "FAIL the button below the modal overlay fired anyway"] }, { return: 1 }]

      # ── 4. the overlay's own button keeps firing ───────────────────────
      - call: [click_at, win, mod_x, mod_y]
      - if:
          condition: { neq: [{ call: [modal.child_clicked, "mod_btn"] }, 1] }
          then: [{ call: [log.error, "FAIL the overlay blocks its OWN button — a dialog needs buttons"] }, { return: 1 }]

      # ── 5. no move starts below the overlay any more ───────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 330.0, 240.0]
      - call: [engine.update_hover, 330.0, 240.0]
      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_hover, 330.0, 240.0]
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 330.0, 252.0]
      - call: [engine.update_hover, 330.0, 252.0]
      - call: [engine.update_drag_gesture, 330.0, 252.0]
      - decl: [drg_b, prefab_instance, { call: [engine.get_dragged] }]
      - if:
          condition: { pneq: [drg_b, null] }
          then: [{ call: [log.error, "FAIL a move was started below the modal overlay"] }, { return: 1 }]
      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - call: [engine.update_hover, 330.0, 252.0]
      - call: [engine.update_drag_gesture, 330.0, 252.0]

      # ── 6. switched back, the button below fires again ─────────────────
      - call: [modal.set_input_blocking, 0]
      - call: [click_at, win, und_x, und_y]
      - if:
          condition: { neq: [{ call: [under.child_clicked, "und_btn"] }, 1] }
          then: [{ call: [log.error, "FAIL after switching back the lower button does not fire again"] }, { return: 1 }]

      - call: [engine.destroy_window, win]
      - call: [log.info, "PASS prefab_input_blocking"]
      - return: 0
