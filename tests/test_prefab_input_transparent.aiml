# SPEC: 44_6_prefabs
# spec/44_6 "Click-through: set_input_transparent".
#
# The gap this test nails down: there were only `visible` and `draggable`,
# so a purely decorative instance could STEAL input.  hit_test returns the
# topmost visible instance without asking whether it wants to be operated, and
# update_hover sets `hovered` only to this result.  A large preview
# over a card thereby made the card unreachable: never is_hovered, so
# no was_clicked and no target selection any more (in 9rooms the preview covered the
# lower 47 px of the middle room and the attack could not be declared).
#
# Checked in this order:
#   1. starting point: the overlay is on top and CATCHES the hit (without that
#      2. would be worthless — then the test could be green even with a broken z order)
#   2. input_transparent=1 → hit_test hits the card BELOW
#   3. update_hover sets hovered to the card, not to the overlay
#   4. switched back, the overlay catches again (the property works both ways)
# Requires: display
# Expected exit code: 0

- prefab:
    name: TranspCard
    width: 60
    height: 80
    children:
      - { name: card_body, type: rect, x: 0, y: 0, width: 60, height: 80,
          bg_color: 0x3A5A8AFF }

# A decoration that declares it on the PREFAB — that way one does not forget it at the next
# effect (spec/44_6 "prefab keys").
- prefab:
    name: TranspDecor
    width: 300
    height: 200
    input_transparent: true
    children:
      - { name: decor_body, type: rect, pos_x: 0, pos_y: 0, width: 300, height: 200,
          bg_color: 0x80303030 }

- prefab:
    name: TranspOverlay
    width: 300
    height: 200
    children:
      - { name: over_body, type: rect, x: 0, y: 0, width: 300, height: 200,
          bg_color: 0x20202080 }

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "transp"] }]
      - if: { condition: { eq: [win, null] }, then: [{ call: [log.error, "FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]

      # card below (z=5), overlay above it (z=200) — like a field card vs. a preview.
      - decl: [card, prefab_instance, { call: [engine.instantiate, "TranspCard"] }]
      - call: [card.set_pos, 100.0, 100.0]
      - call: [card.set_z, 5]
      - decl: [over, prefab_instance, { call: [engine.instantiate, "TranspOverlay"] }]
      - call: [over.set_pos, 50.0, 50.0]
      - call: [over.set_z, 200]
      # draw_scene establishes the z order for hit_test (spec/44_6).
      - call: [engine.draw_scene]

      # a point in the middle of the card that also lies in the overlay (100..160 / 100..180
      # against 50..350 / 50..250).
      - decl: [probe_x, f32, 130.0]
      - decl: [probe_y, f32, 140.0]

      # ── 1. starting point: the overlay catches ───────────────────────────
      - decl: [hit_over, prefab_instance, { call: [engine.hit_test, probe_x, probe_y] }]
      - if:
          condition: { pneq: [hit_over, over] }
          then: [{ call: [log.error, "FAIL starting point: the overlay is on top but does not catch the hit — z order broken, the test would be worthless"] }, { return: 1 }]

      # ── 2. click-through → the card below is hit ─────────────────────────
      - call: [over.set_input_transparent, 1]
      - if:
          condition: { neq: [{ call: [over.get_input_transparent] }, 1] }
          then: [{ call: [log.error, "FAIL get_input_transparent does not return the set value"] }, { return: 1 }]
      - decl: [hit_card, prefab_instance, { call: [engine.hit_test, probe_x, probe_y] }]
      - if:
          condition: { pneq: [hit_card, card] }
          then: [{ call: [log.error, "FAIL click-through overlay still catches the hit — the card below stays unreachable"] }, { return: 1 }]
      # It stays visible nevertheless: drawing and input are separate.
      - if:
          condition: { neq: [{ call: [over.get_visible] }, 1] }
          then: [{ call: [log.error, "FAIL overlay became invisible — set_input_transparent may only switch off the INPUT"] }, { return: 1 }]

      # ── 3. update_hover sets hovered to the card ─────────────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, probe_x, probe_y]
      - call: [engine.update_hover, probe_x, probe_y]
      - if:
          condition: { neq: [{ call: [card.is_hovered] }, 1] }
          then: [{ call: [log.error, "FAIL card is not hovered — so was_clicked and target selection stay dead"] }, { return: 1 }]
      - if:
          condition: { neq: [{ call: [over.is_hovered] }, 0] }
          then: [{ call: [log.error, "FAIL click-through overlay reports itself as hovered"] }, { return: 1 }]

      # ── 4. zurueckgeschaltet faengt es wieder ──────────────────────────
      - call: [over.set_input_transparent, 0]
      - decl: [hit_again, prefab_instance, { call: [engine.hit_test, probe_x, probe_y] }]
      - if:
          condition: { pneq: [hit_again, over] }
          then: [{ call: [log.error, "FAIL after switching back the overlay does not catch again"] }, { return: 1 }]

      # ── 5. declared on the PREFAB: applies without any setter call ─────
      # Reason (spec/44_6): setting it per call site is a line that
      # one forgets at the next effect — and then the decoration steals
      # the hover again.
      - call: [over.set_visible, 0]
      - decl: [decor, prefab_instance, { call: [engine.instantiate, "TranspDecor"] }]
      - call: [decor.set_pos, 50.0, 50.0]
      - call: [decor.set_z, 210]
      - call: [engine.draw_scene]
      - if:
          condition: { neq: [{ call: [decor.get_input_transparent] }, 1] }
          then: [{ call: [log.error, "FAIL input_transparent on the prefab does not act on the instance"] }, { return: 1 }]
      - decl: [hit_dec, prefab_instance, { call: [engine.hit_test, probe_x, probe_y] }]
      - if:
          condition: { pneq: [hit_dec, card] }
          then: [{ call: [log.error, "FAIL the decoration declared on the prefab catches the hit anyway"] }, { return: 1 }]
      # The instance method overrides the prefab value — back as well.
      - call: [decor.set_input_transparent, 0]
      - decl: [hit_dec2, prefab_instance, { call: [engine.hit_test, probe_x, probe_y] }]
      - if:
          condition: { pneq: [hit_dec2, decor] }
          then: [{ call: [log.error, "FAIL set_input_transparent(0) does not override the prefab value"] }, { return: 1 }]

      - call: [engine.destroy_window, win]
      - call: [log.info, "PASS prefab_input_transparent"]
      - return: 0
