# SPEC: 44_8_prefab_static,44_8_vocab
# Negative test (Tier 2b, spec/44_8): the scene lives in a CLASS MEMBER,
# bound in `init`, addressed in `render` — the predominant notation of
# every screen.  The child name does not exist.  At runtime find_child
# throws; in the WASM build (exceptions off) the whole application aborts.
# So it must be a HARD compiler error.
#
# Expected exit code: 1
#
# Diagnostic form:
#   ...: '<.scene'.set_text("does_not_exist") addresses an unknown child of
#   prefab 'MenuPanel' — no child with that name is declared ...

- prefab:
    name: MenuPanel
    width: 100
    height: 40
    children:
      - { name: title_lbl, type: label, x: 0, y: 0, width: 100, height: 20 }

- class:
    name: MenuScreen
    members:
      - [scene, prefab_instance]
    methods:
      - def:
          name: init
          body:
            - set: [<.scene, { call: [engine.instantiate, "MenuPanel"] }]
      - def:
          name: render
          body:
            - call: [<.scene.set_text, "does_not_exist", "hi"]

- def:
    name: main
    return: i32
    body:
      - decl: [scr, MenuScreen]
      - return: 0
