# SPEC: 44_8_prefab_static,44_8_vocab
# Positive test (Tier 2b, spec/44_8): the member check must not fire with correct
# use — and it must NOT guess where it cannot prove anything.
# Two cases in one file:
#
#   1. `<.scene` is unambiguously bound to AlphaPanel; set_text/child_clicked/
#      text_value with declared child names → no error.
#   2. `<.dual` is bound to TWO different prefabs (init: AlphaPanel,
#      switch_over: BetaPanel).  So it is not statically decidable which
#      prefab lies there → the field is NOT tracked, and `beta_lbl` (only in
#      BetaPanel) must not be reported as an unknown child.  A check
#      that guesses here reports wrong things and gets switched off.
#
# Expected exit code: 0
#
# The GL path is parked behind a condition that is false at runtime or is
# never called: the static checks read the AST regardless of
# reachability → headless-capable.

- prefab:
    name: AlphaPanel
    width: 100
    height: 60
    children:
      - { name: alpha_lbl, type: label, x: 0, y: 0, width: 100, height: 20 }
      - { name: alpha_btn, type: button, x: 0, y: 20, width: 100, height: 20 }
      - { name: alpha_inp, type: text_input, x: 0, y: 40, width: 100, height: 20 }

- prefab:
    name: BetaPanel
    width: 100
    height: 20
    children:
      - { name: beta_lbl, type: label, x: 0, y: 0, width: 100, height: 20 }

- class:
    name: DualScreen
    members:
      - [scene, prefab_instance]
      - [dual,  prefab_instance]
    methods:
      - def:
          name: init
          body:
            - set: [<.scene, { call: [engine.instantiate, "AlphaPanel"] }]
            - set: [<.dual,  { call: [engine.instantiate, "AlphaPanel"] }]
      - def:
          name: switch_over
          body:
            - set: [<.dual, { call: [engine.instantiate, "BetaPanel"] }]
      - def:
          name: render
          return: i32
          body:
            # case 1: unambiguous field, declared children — writing and reading.
            - call: [<.scene.set_text, "alpha_lbl", "hallo"]
            - decl: [txt, string, { call: [<.scene.text_value, "alpha_inp"] }]
            - if: { condition: { eq: [{ call: [<.scene.child_clicked, "alpha_btn"] }, 1] }, then: [{ return: 1 }] }
            # case 2: ambiguous field — the check must stay silent.
            - call: [<.dual.set_text, "beta_lbl", "welt"]
            - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [flag, i32, 0]
      - decl: [scr, DualScreen]
      - if:
          condition: { eq: [flag, 1] }
          then:
            - call: [scr.init]
            - decl: [hit, i32, { call: [scr.render] }]
      - call: [log.info, "PASS prefab_member_child_ok: member child names accepted, ambiguous field not guessed"]
      - return: 0
