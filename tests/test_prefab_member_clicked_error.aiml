# SPEC: 44_8_prefab_static,44_8_vocab
# Negative test (Tier 2b, spec/44_8): the READING child methods.  A typo
# in child_clicked gives a silently dead button (no throw, no message —
# a missing child simply means "not clicked"), one in text_value a
# silently empty input field.  That is exactly why the compiler must say so.
#
# Expected exit code: 1
#
# Diagnostic form:
#   ...: '<.form'.child_clicked("send_bttn") addresses an unknown child of
#   prefab 'FormPanel' — ...

- prefab:
    name: FormPanel
    width: 100
    height: 40
    children:
      - { name: send_btnx, type: button, x: 0, y: 0, width: 80, height: 20 }
      - { name: host_input, type: text_input, x: 0, y: 20, width: 80, height: 20 }

- class:
    name: FormScreen
    members:
      - [form, prefab_instance]
    methods:
      - def:
          name: init
          body:
            - set: [<.form, { call: [engine.instantiate, "FormPanel"] }]
      - def:
          name: poll
          return: i32
          body:
            # typo: the child is called send_btnx.  Without the check: a dead button.
            - if: { condition: { eq: [{ call: [<.form.child_clicked, "send_bttn"] }, 1] }, then: [{ return: 1 }] }
            - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [scr, FormScreen]
      - return: 0
