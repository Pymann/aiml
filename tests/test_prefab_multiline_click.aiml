# SPEC: 44_6_prefabs
# spec/44_6 §5g + widget table: a MULTI-LINE `text_input` has "a movable
# cursor, text selection (mouse drag)".  For multi-line fields that was not
# delivered: the render pass created exactly ONE cursor stop (byte 0), so
# every click jumped to the start of the document — and with `gutter: true` the
# column was additionally off by the width of the number column.
#
# Reported on the cosmos source text field: "in the pipeline text box
# I cannot get to the end of the label, the cursor does not do at all what the
# keyboard says" (2026-10-15).
#
# What is checked is what the human does: click into a SPECIFIC line and
# type — the character must land THERE, not at the start.
#
# Requires: display
# Expected exit code: 0

- prefab:
    name: EditorScene
    width: 520
    height: 300
    children:
      - { name: code_input, type: text_input, font_size: 12, gutter: true,
          x: 20, y: 20, width: 480, height: 200,
          bg_color: 0x0D1218FF, border_color: 0x2D3642FF, border_width: 1.0,
          color: 0xDDE6F0FF }

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 520, 300, "editor"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 520, 300]
      - call: [input.init, win]
      - decl: [font, ui_font, { call: [ui.load_font_default, 12.0] }]
      - if: { condition: { neq: [font, null] }, then: [{ call: [engine.prefab_set_font, font] }] }

      - decl: [scene, prefab_instance, { call: [engine.instantiate, "EditorScene"] }]
      - call: [scene.set_pos, 0.0, 0.0]
      # Four clearly distinguishable lines.  Line 3 is the target.
      - call: [scene.set_text, "code_input", "eins\nzwei\nDRITTE\nvier"]

      - decl: [box_x, f32, { call: [scene.child_rect_x, "code_input"] }]
      - decl: [box_y, f32, { call: [scene.child_rect_y, "code_input"] }]
      - decl: [box_w, f32, { call: [scene.child_rect_w, "code_input"] }]
      - if: { condition: { lt: [box_w, 1.0] }, then: [{ print: ["FAIL widget not found"] }, { return: 1 }] }

      # Draw a frame, so that the cursor map is in place.
      - call: [engine.swap, win]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]

      # Two targets, both WITHOUT knowledge of the font metrics:
      #   A) top right         → end of the FIRST line
      #   B) far bottom right  → end of the LAST visible line
      # Before the fix both landed at the start of the document (a single stop, byte 0).
      - decl: [aim_x, f32, { +: [box_x, { -: [box_w, 20.0] }] }]
      - decl: [aim_y, f32, { +: [box_y, 8.0] }]

      - call: [engine.swap, win]
      - call: [input.post_mouse_move, aim_x, aim_y]
      - call: [engine.update_hover, aim_x, aim_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_hover, aim_x, aim_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - call: [engine.update_hover, aim_x, aim_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]
      - call: [input.post_text, "X"]
      - call: [engine.update_hover, aim_x, aim_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]

      - decl: [got_a, string, { call: [scene.text_value, "code_input"] }]
      - decl: [want_a, string, "einsX\nzwei\nDRITTE\nvier"]
      - if:
          condition: { neq: [got_a, want_a] }
          then:
            - if:
                condition: { gt: [{ call: [got_a.index_of, "Xeins"] }, -1] }
                then: [{ print: ["FAIL click landed at the START OF THE DOCUMENT instead of at the end of line 1"] }]
                else: [{ print: ["FAIL A: '${got_a}' expected '${want_a}'"] }]
            - call: [engine.destroy_window, win]
            - return: 1

      # B) far down: the last visible line
      - decl: [low_y, f32, { +: [box_y, 150.0] }]
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, aim_x, low_y]
      - call: [engine.update_hover, aim_x, low_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]
      - call: [input.post_mouse_down, 0]
      - call: [engine.update_hover, aim_x, low_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - call: [engine.update_hover, aim_x, low_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]
      - call: [input.post_text, "Y"]
      - call: [engine.update_hover, aim_x, low_y]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]

      - decl: [got_b, string, { call: [scene.text_value, "code_input"] }]
      - decl: [want_b, string, "einsX\nzwei\nDRITTE\nvierY"]
      - if:
          condition: { eq: [got_b, want_b] }
          then:
            - print: ["PASS multiline_click: click hits line AND column (also with gutter)"]
            - call: [engine.destroy_window, win]
            - return: 0
      - print: ["FAIL B: '${got_b}' expected '${want_b}'"]
      - call: [engine.destroy_window, win]
      - return: 1
