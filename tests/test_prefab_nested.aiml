# Requires: display
# Smoke-test for nested prefab instances: a Tile hosts a Badge + a bar; both
# inherit the tile's transform (move/scale together).

- prefab:
    name: TileBox
    width: 96
    height: 96
    children:
      - { name: bg_layer, type: rect, x: 0, y: 0, width: 96, height: 96,
          bg_color: 0x223044FF, border_color: 0x66B0E0FF, border_width: 1.5, corner_radius: 8.0 }

- prefab:
    name: Badge
    width: 32
    height: 32
    children:
      - { name: dot_mark, type: rect, x: 0, y: 0, width: 32, height: 32,
          bg_color: 0xFFAA33FF, corner_radius: 16.0 }

- prefab:
    name: MiniBar
    width: 80
    height: 12
    children:
      - { name: lvl_lbl, type: bar, x: 0, y: 0, width: 80, height: 12,
          bg_color: 0x111122FF, fill_color: 0x44CC66FF, value: 0.6, max: 1.0, corner_radius: 4.0 }

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "nested"] }]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]

      - decl: [tile, prefab_instance, { call: [engine.instantiate, "TileBox"] }]
      - call: [tile.set_pos, 120.0, 100.0]

      - decl: [badge, prefab_instance, { call: [engine.instantiate, "Badge"] }]
      - call: [badge.set_pos, 56.0, 8.0]      # local to tile
      - call: [tile.add_child, badge]

      - decl: [bar, prefab_instance, { call: [engine.instantiate, "MiniBar"] }]
      - call: [bar.set_pos, 8.0, 76.0]        # local to tile
      - call: [tile.add_child, bar]

      # Moving / scaling the tile moves the nested children too.
      - call: [tile.set_pos, 160.0, 120.0]
      - call: [tile.set_scale, 1.25]

      - call: [gl.clear_all, 0.05, 0.05, 0.1, 1.0]
      - call: [engine.draw_scene]
      - call: [engine.swap, win]

      - call: [tile.remove_child, badge]
      - call: [log.info, "nested smoke OK"]
      - return: 0
