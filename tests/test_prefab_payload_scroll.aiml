# SPEC: 44_6_prefabs §5h
# Requires: display
# Regression for `payload_scroll` + `cascade_flow` (spec/44_6 §5h).
#
# What this test PROVES:
#   1. Both keys come through DECLARATIVELY — they were only wired into the runtime's
#      JSON loader, so declared they were an "unknown attribute" error.
#      Exactly the gap §4 warns about (min/scrollable/tail already had it).
#   2. A deep cascade (4 fields, 130 wide → 200+4*134 = 736 > row width
#      520) no longer runs out of the row with payload_scroll: the row becomes
#      a clip viewport, the bar is drawn, nothing crashes.
#   3. `cascade_flow: vertical` is accepted and drawn.
#
# NOT interactive: a finite number of frames, then the window closes (a blocking
# loop holds up the whole suite).

- config:
    entry: main

- enum: { name: OwnerType,     values: [player, opponent, ally] }
- enum: { name: AttributeType, values: [lp, atk, def], labels: {1: "LP", 2: "ATK", 3: "DEF"} }
- enum: { name: TargetType,    values: [card, soulmage] }
- alias: { name: VALUE, type: i32, label: "Value", min: 0 }

- cascade:
    name: ValueType
    nodes:
      - fixed: [1, VALUE]

# deal_damage has 4 fields (owner, target, value cascade, value) → the chain is
# wider than the row, exactly the case §5h is meant to clip.
- cascade:
    name: DmgCode
    nodes:
      - deal_damage: [10, OwnerType, TargetType, ValueType, AttributeType]
      - nothing:     [48]

- prefab:
    name: PsFieldChip
    width: 130
    height: 22
    texture: ""
    children:
      - { name: control, type: label, x: 0, y: 0, width: 130, height: 22,
          font_size: 10, color: 0xFFCC44FF, bg_color: 0x223040FF,
          border_color: 0x88AACCFF, border_width: 1.0, corner_radius: 3.0,
          options: "---", label: "?" }

# row 520 wide: 200 dropdown + 6 spacing leave 314 for the chain (4*134=536)
# → overhangs, the bar must appear.  34 high: 6 px at the bottom for the bar.
- prefab:
    name: PsRow
    width: 520
    height: 34
    texture: ""
    children:
      - { name: dmg_dd, type: dropdown, x: 0, y: 2, width: 200, height: 22,
          cascade_type: DmgCode, payload_spawn: PsFieldChip, payload_scroll: true,
          bg_color: 0x223040FF, border_color: 0x88AACCFF, border_width: 1.0,
          corner_radius: 3.0, color: 0xFFFFFFFF, font_size: 10 }

# Counter-probe: the same cascade with vertical flow — payload_scroll has no
# effect there and must not break anything.
- prefab:
    name: PsRowVertical
    width: 520
    height: 34
    texture: ""
    children:
      - { name: dmg_dd, type: dropdown, x: 0, y: 2, width: 200, height: 22,
          cascade_type: DmgCode, payload_spawn: PsFieldChip,
          cascade_flow: vertical, payload_scroll: true,
          bg_color: 0x223040FF, border_color: 0x88AACCFF, border_width: 1.0,
          corner_radius: 3.0, color: 0xFFFFFFFF, font_size: 10 }

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 640, 240, "payload_scroll"] }]
      - decl: [row_h, prefab_instance, { call: [engine.instantiate, "PsRow"] }]
      - call: [row_h.set_pos, 20.0, 20.0]
      - decl: [row_v, prefab_instance, { call: [engine.instantiate, "PsRowVertical"] }]
      - call: [row_v.set_pos, 20.0, 120.0]
      # set both to deal_damage → 4 payload fields, the chain overhangs.
      - call: [row_h.set_dropdown_index, "dmg_dd", 0]
      - call: [row_v.set_dropdown_index, "dmg_dd", 0]
      - decl: [frames, i32, 0]
      - while:
          condition: { lt: [frames, 12] }
          body:
            - call: [gl.clear_all, 0.05, 0.05, 0.08, 1.0]
            - call: [engine.update_hover, 300.0, 44.0]
            - call: [engine.draw_scene]
            - call: [engine.swap, win]
            - set: [frames, { +: [frames, 1] }]
      - decl: [sel_h, i32, { call: [row_h.dropdown_index, "dmg_dd"] }]
      - decl: [sel_v, i32, { call: [row_v.dropdown_index, "dmg_dd"] }]
      - call: [engine.destroy_window, win]
      - if:
          condition: { '||': [{ neq: [sel_h, 0] }, { neq: [sel_v, 0] }] }
          then:
            - print: ["FAIL Auswahl verloren: h=${sel_h} v=${sel_v}"]
            - return: 1
      - print: ["PASS payload_scroll: accepted declaratively, 12 frames without a crash"]
      - return: 0
