# SPEC: 44_6_prefabs
# An on_click callback may CREATE prefabs.
#
# The bug this probe records: the widget pass in
# `update_hover` ran as a range-for over `g_scene->instances`.  If a
# callback creates instances meanwhile, every `instantiate` appends to exactly
# this vector -- if it grows beyond its capacity in the process, the
# running iterator is INVALID and the next step reads freed
# memory.  Natively a crash, in the browser
# "RuntimeError: index out of bounds" in the middle of aiml_prefab_update_hover.
# In the game it hit the travel map: its click handler builds eight instances,
# and the client froze on the first open.
#
# Secondly the probe records that a press has exactly ONE recipient:
# what only comes into being through this click must not get the same click
# once more -- otherwise a freshly appeared overlay takes the press
# that has just opened it.
# Requires: display
# Expected exit code: 0

- prefab:
    name: SpawnButton
    width: 200
    height: 80
    children:
      - { name: spawn_btn, type: button,
          x: 0, y: 0, width: 200, height: 80,
          label: "spawn",
          bg_color: 0x2A4060FF,
          on_click: handle_spawn_click }

# The created cards are buttons themselves and lie EXACTLY under the same
# point -- only that way does it show whether they take along the click that created them.
- prefab:
    name: SpawnCard
    width: 200
    height: 80
    children:
      - { name: card_btn, type: button,
          x: 0, y: 0, width: 200, height: 80,
          label: "card",
          bg_color: 0x603030FF,
          on_click: handle_card_click }

- decl: [g_spawn_clicks, i32, 0]
- decl: [g_card_clicks,  i32, 0]
- decl: [g_cards, list<prefab_instance>, []]

# Enough instances that the vector is sure to move (the capacity doubles).
- def:
    name: handle_spawn_click
    args: [[param, prefab_instance]]
    body:
      - set: [g_spawn_clicks, { "+": [g_spawn_clicks, 1] }]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, 64] }
          body:
            - decl: [card, prefab_instance, { call: [engine.instantiate, "SpawnCard"] }]
            - call: [card.set_z, 9]
            - call: [card.set_pos, 20.0, 20.0]
            - call: [card.set_visible, 1]
            - call: [g_cards.push, card]
            - set: [idx, { "+": [idx, 1] }]

- def:
    name: handle_card_click
    args: [[param, prefab_instance]]
    body:
      - set: [g_card_clicks, { "+": [g_card_clicks, 1] }]

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "spawncb"] }]
      - if: { condition: { eq: [win, null] }, then: [{ call: [log.error, "FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]

      - decl: [btn, prefab_instance, { call: [engine.instantiate, "SpawnButton"] }]
      - call: [btn.set_pos, 20.0, 20.0]
      - call: [btn.set_z, 5]
      - call: [btn.set_visible, 1]
      - call: [engine.draw_scene]

      # press + release on the button, evaluated in the same frame.
      - decl: [probe_x, f32, 60.0]
      - decl: [probe_y, f32, 50.0]
      - call: [input.post_mouse_move, probe_x, probe_y]
      - call: [input.post_mouse_down, 0]
      - call: [input.post_mouse_up, 0]
      # THIS is where it crashed: the callback creates 64 instances while the
      # loop is still running.
      - call: [engine.update_hover, probe_x, probe_y]

      - if:
          condition: { neq: [g_spawn_clicks, 1] }
          then:
            - call: [log.error, "FAIL the button fired ${g_spawn_clicks} times instead of exactly once"]
            - return: 1
      - if:
          condition: { neq: [g_cards.len, 64] }
          then:
            - call: [log.error, "FAIL ${g_cards.len} cards instead of 64 -- the callback did not run through"]
            - return: 1
      - if:
          condition: { neq: [g_card_clicks, 0] }
          then:
            - call: [log.error, "FAIL ${g_card_clicks} freshly created cards took the same click along"]
            - return: 1

      # The scene must stay usable after the pass: draw,
      # hover again, and a second click now hits the topmost card.
      - call: [engine.draw_scene]
      - call: [input.post_mouse_move, probe_x, probe_y]
      - call: [input.post_mouse_down, 0]
      - call: [input.post_mouse_up, 0]
      - call: [engine.update_hover, probe_x, probe_y]
      - if:
          condition: { lt: [g_card_clicks, 1] }
          then:
            - call: [log.error, "FAIL the second click reached none of the created cards"]
            - return: 1

      - call: [engine.destroy_window, win]
      - call: [log.info, "PASS prefab_spawn_in_callback (${g_spawn_clicks} button, ${g_cards.len} cards, ${g_card_clicks} card clicks)"]
      - return: 0
