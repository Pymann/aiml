# SPEC: 44_8_prefab_static,44_8_vocab
# Positive test: the static prefab check (spec/44_8) must not fire with CORRECT
# use —
#   Tier 1: engine.instantiate("<Name>") with a declared prefab name,
#   Tier 2: v.set_text("<child>", …) with a name declared in `children:`.
#
# Expected exit code: 0
#
# The instantiate/child path is parked behind a condition that is false at runtime:
# the static checks scan the AST regardless of
# reachability (they see the literal "Panel" or child "title"), but at runtime
# no graphics/GL path is touched → headless-capable.

- prefab:
    name: Panel
    width: 100
    height: 40
    children:
      - { name: title, type: label, x: 0, y: 0, width: 100, height: 20 }

- def:
    name: main
    return: i32
    body:
      - decl: [flag, i32, 0]
      - if:
          condition: { eq: [flag, 1] }
          then:
            - decl: [inst, prefab_instance, { call: [engine.instantiate, "Panel"] }]
            # Tier 2 positive: "title" IS a declared child of Panel.
            - call: [inst.set_text, "title", "hello"]
      - print: ["PASS prefab_static: known prefab 'Panel' + child 'title' accepted"]
      - return: 0
