# SPEC: 44_8_prefab_static,44_8_vocab
# Negative test: engine.instantiate("<Name>") with a name for which NO
# `- prefab:` is declared (or imported).  At runtime that produces an
# invisible null instance (silent no-op) and MUST therefore be a HARD compiler
# error — see spec/44_8 (Tier 1: instantiate-known).
#
# Expected exit code: 1
#
# Diagnostic form:
#   ...: engine.instantiate("NoSuchPrefab") refers to an unknown prefab — no
#   `- prefab:` with that name is declared or imported in this module. ...

- def:
    name: main
    return: i32
    body:
      - decl: [inst, prefab_instance, { call: [engine.instantiate, "NoSuchPrefab"] }]
      - return: 0
