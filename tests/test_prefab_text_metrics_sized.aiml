# SPEC: 44_6_prefabs
# spec/44_6 §5i: engine.text_width takes an OPTIONAL font_size, and
# engine.text_height reports the line height.
#
# Why the size argument has to exist: a prefab scene bakes a SEPARATE font per
# size and a child renders at font_size * instance_scale.  Advances are therefore
# not proportional between sizes, so a width measured in the scene font and
# scaled afterwards is wrong — close enough to look right, wrong enough to clip
# the last glyph of a label.
# Requires: display
# Expected exit code: 0
- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "color"] }]
      - if: { condition: { eq: [win, null] }, then: [{ call: [log.error, "FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - decl: [font, ui_font, { call: [ui.load_font_default, 14.0] }]
      - if: { condition: { peq: [font, null] }, then: [{ call: [log.error, "FAIL no font"] }, { return: 1 }] }
      - call: [engine.prefab_set_font, font]

      # 1. The existing, size-less form keeps working (scene font).
      - decl: [base_w, f32, { call: [engine.text_width, "Angriff abgelehnt"] }]
      - if:
          condition: { le: [base_w, 0.0] }
          then: [{ call: [log.error, "FAIL text_width gave ${base_w} for real text"] }, { return: 1 }]

      # 2. Omitting the size MUST equal asking for the scene font's own size.
      #    This is the compatibility hinge: if these two drift apart, every
      #    existing caller silently changes behaviour.
      - decl: [same_w, f32, { call: [engine.text_width, "Angriff abgelehnt", 14.0] }]
      - if:
          condition: { gt: [same_w, { +: [base_w, 0.01] }] }
          then: [{ call: [log.error, "FAIL sized 14.0 wider than scene font (${same_w} vs ${base_w})"] }, { return: 1 }]
      - if:
          condition: { lt: [same_w, { -: [base_w, 0.01] }] }
          then: [{ call: [log.error, "FAIL sized 14.0 narrower than scene font (${same_w} vs ${base_w})"] }, { return: 1 }]

      # 3. A bigger size is strictly wider — the property the argument exists for.
      - decl: [big_w, f32, { call: [engine.text_width, "Angriff abgelehnt", 28.0] }]
      - if:
          condition: { le: [big_w, base_w] }
          then: [{ call: [log.error, "FAIL 28 px not wider than 14 px (${big_w} vs ${base_w})"] }, { return: 1 }]

      # 4. Empty string has no width at any size.
      - decl: [empty_w, f32, { call: [engine.text_width, "", 28.0] }]
      - if:
          condition: { gt: [empty_w, 0.0] }
          then: [{ call: [log.error, "FAIL empty string measured ${empty_w}"] }, { return: 1 }]

      # 5. Line height: positive, and taller for a bigger font.
      - decl: [lh_small, f32, { call: [engine.text_height, 14.0] }]
      - decl: [lh_big, f32, { call: [engine.text_height, 28.0] }]
      - if:
          condition: { le: [lh_small, 0.0] }
          then: [{ call: [log.error, "FAIL text_height gave ${lh_small}"] }, { return: 1 }]
      - if:
          condition: { le: [lh_big, lh_small] }
          then: [{ call: [log.error, "FAIL 28 px line height not taller (${lh_big} vs ${lh_small})"] }, { return: 1 }]

      - call: [log.info, "engine.text_width/text_height sized OK (14=${base_w}, 28=${big_w})"]
      - return: 0
