# SPEC: 44_6_prefabs
# spec/44_6: engine.text_width — width in the prefab font, including the
# inline marker rules ({icon:stem} counts ascent_px).  Centring and wrapping
# depend on it: if a marker wrongly counts width, every
# centred line shifts and text boxes wrap at the wrong place.
#
# (Colour per line is done by set_color_runs, spec/44_6 §5g — byte range → colour,
#  correct across line breaks.  An inline colour marker of its own would be a
#  duplication and broke exactly at line breaks.)
# Requires: display
# Expected exit code: 0
- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "color"] }]
      - if: { condition: { eq: [win, null] }, then: [{ call: [log.error, "FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - decl: [font, ui_font, { call: [ui.load_font_default, 14.0] }]
      - if: { condition: { peq: [font, null] }, then: [{ call: [log.error, "FAIL no font"] }, { return: 1 }] }
      - call: [engine.prefab_set_font, font]

      # ── 1. measurement works at all ──────────────────────────────────────
      - decl: [plain_w, f32, { call: [engine.text_width, "Angriff abgelehnt"] }]
      - if:
          condition: { le: [plain_w, 0.0] }
          then: [{ call: [log.error, "FAIL text_width returns ${plain_w} for real text"] }, { return: 1 }]
      - decl: [short_w, f32, { call: [engine.text_width, "Angriff"] }]
      - if:
          condition: { ge: [short_w, plain_w] }
          then: [{ call: [log.error, "FAIL shorter text not narrower (${short_w} vs ${plain_w})"] }, { return: 1 }]
