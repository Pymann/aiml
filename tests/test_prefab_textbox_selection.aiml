# SPEC: 44_0_input,44_6_prefabs
# spec/44_6 §5f: textbox selection.  Checks the part that can be checked WITHOUT a mouse:
# select_all marks the whole content, selection returns it, and the
# result can be put into the clipboard.  Mouse selection itself
# (dragging across wrapped lines) needs a window and real clicks.
# Requires: display
# Expected exit code: 0

- prefab:
    name: SelScene
    width: 400
    height: 300
    children:
      - { name: log_box, type: textbox, x: 10, y: 10, width: 380, height: 200,
          font_size: 12, color: 0xDDDDDDFF }
      - { name: name_input, type: text_input, x: 10, y: 230, width: 380, height: 28,
          bg_color: 0x202020FF, color: 0xFFFFFFFF, font_size: 12 }

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "sel"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [engine.prefab_scene_init, 400, 300]
      - call: [input.init, win]      # without that no window clipboard (spec/44_0 §2.5)
      - decl: [font, ui_font, { call: [ui.load_font_default, 12.0] }]
      - if: { condition: { neq: [font, null] }, then: [{ call: [engine.prefab_set_font, font] }] }

      - decl: [scene, prefab_instance, { call: [engine.instantiate, "SelScene"] }]
      - call: [scene.set_pos, 0.0, 0.0]

      # multi-line content with wrapping — exactly the case that did not work before.
      - decl: [body, string, "b9bbe4c3becfb6d8.a52823d31f8c64f737b53eba95b8dd\nzweite Zeile mit mehreren Woertern\ndritte"]
      - call: [scene.set_text, "log_box", body]

      # without a selection: empty
      - decl: [none_sel, string, { call: [scene.selection, "log_box"] }]
      - if: { condition: { neq: [none_sel.len, 0] }, then: [{ print: ["FAIL empty selection: '${none_sel}'"] }, { return: 1 }] }

      # select_all marks the WHOLE source text — verbatim, with line breaks
      - call: [scene.select_all, "log_box"]
      - decl: [all_sel, string, { call: [scene.selection, "log_box"] }]
      - if: { condition: { neq: [all_sel, body] }, then: [{ print: ["FAIL select_all returns '${all_sel}'"] }, { return: 1 }] }

      # ... and lands in the clipboard (window present → real clipboard)
      - call: [input.clipboard_set, all_sel]
      - decl: [clip, string, { call: [input.clipboard_get] }]
      - if: { condition: { neq: [clip, body] }, then: [{ print: ["FAIL clipboard: '${clip}'"] }, { return: 1 }] }

      # text_input can still do it as well
      - call: [scene.set_text, "name_input", "hallo welt"]
      - call: [scene.select_all, "name_input"]
      - decl: [in_sel, string, { call: [scene.selection, "name_input"] }]
      - if: { condition: { neq: [in_sel, "hallo welt"] }, then: [{ print: ["FAIL input-Auswahl: '${in_sel}'"] }, { return: 1 }] }

      # the focus moves along: the textbox is no longer selected
      - decl: [box_after, string, { call: [scene.selection, "log_box"] }]
      - if: { condition: { neq: [box_after.len, 0] }, then: [{ print: ["FAIL selection stayed after focus change: '${box_after}'"] }, { return: 1 }] }

      # An unknown child name throws as with all widget methods
      # (find_child is deliberately loud — almost always a typo); hence
      # no negative case here.

      - call: [engine.destroy_window, win]
      - print: ["PASS prefab_textbox_selection"]
      - return: 0
