# SPEC: 44_6_prefabs
# An unknown prefab attribute must ABORT the build (spec/44_6 §4).
#
# Occasion: in the cosmos client `password: true` stood on the input fields for
# SSH and sudo passwords.  The masking key is called `secret`, so
# `password` was silently discarded during parsing — the passwords
# were on the screen in plain text.  YAML accepted the line, nobody
# objected.  Since then an unknown attribute is a compile error.
# Expected exit code: 1

- prefab:
    name: TypoScene
    width: 200
    height: 100
    children:
      - { name: pw_field, type: text_input, x: 10, y: 10, width: 180, height: 30,
          password: true }

- def:
    name: main
    return: i32
    body:
      - decl: [scene, prefab_instance, { call: [engine.instantiate, "TypoScene"] }]
      - return: 0
