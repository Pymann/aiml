# SPEC?: 18_refs_and_pointers   # derived from the file name, to be confirmed
# static-check: off
# BUG #2 (diagnostic test — must give a suppressible WARNING AFTER the fix):
# `ptr<list<T>>` / `ptr<map<K:V>>` as a param type is double indirection
# (lists/maps are already by-ref) → SIGSEGV at runtime.  So far it compiles
# without complaint and only crashes on .push.
#
# Expectation AFTER the fix: a WARNING when compiling ("ptr<list>/ptr<map> param —
# lists/maps are already by-ref; double indirection"), can be switched off.
# The program still runs (the warning is non-fatal) — here we do NOT call the
# function, to avoid the crash; we only check the message.
# Verify manually (warning in the compiler output).

- def:
    name: drain_bad
    args: [[out, ptr<list<string>>]]     # <-- should trigger a WARNING
    body:
      - call: [out.push, "x"]

- def:
    name: main
    return: i32
    body:
      - call: [log.info, "compiled (warning expected above)"]
      - return: 0
