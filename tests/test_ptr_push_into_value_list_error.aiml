# SPEC?: 18_refs_and_pointers   # derived from the file name, to be confirmed
# static-check: off
# Negative test: push(ptr<T>) into a VALUE list<T> must be a compile error.
# An 8-byte pointer would be written into a value struct slot (rest garbage)
# → heap corruption / SIGSEGV when serialising (aiml_ser_encode).  Fix:
# dereference { '?': [x] } or declare list<ptr<T>>.
# Expected exit code: 1 (Compilation failed).
- model: { name: Foo, fields: [ [xval, i32] ] }
- def:
    name: main
    return: i32
    body:
      - decl: [lst, list<Foo>]
      - decl: [fpp, ptr<Foo>, { new: Foo }]
      - call: [lst.push, fpp]
      - return: 0
