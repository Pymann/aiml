# SPEC?: 15_models,18_refs_and_pointers   # derived from the file name, to be confirmed
# A model via `ref<>` to a METHOD — for reading and for changing.
#
# Regression: for a free function `args: [[m, ref<MeinModell>]]` always
# worked, for a method the IR check failed with "Call parameter
# type does not match function signature".  The caller passes a VALUE in both
# cases; the compiler takes the address.
#
# Found 2026-10-13 on the allocator in cosmos, worked around there ("list instead of
# model").  That workaround should not become the pattern: a class must be able to
# take a model.
# Expected exit code: 0

- model:
    name: Counter
    fields:
      - [name,  string]
      - [ticks, i32]

- model:
    name: Pair
    fields:
      - [left,  Counter]
      - [right, Counter]

# The same as a FREE function — that already worked before.
- def:
    name: bump_free
    args: [[counter, ref<Counter>], [by_amount, i32]]
    body:
      - set: [counter.ticks, { +: [counter.ticks, by_amount] }]

- class:
    name: Bumper
    members:
      - [calls, i32]
    methods:
      # reading via ref<>
      - def:
          name: read_ticks
          access: public
          args: [[counter, ref<Counter>]]
          return: i32
          body:
            - set: [<.calls, { +: [<.calls, 1] }]
            - return: counter.ticks

      # CHANGING via ref<> — the actual point: does the caller see it?
      - def:
          name: bump
          access: public
          args: [[counter, ref<Counter>], [by_amount, i32]]
          body:
            - set: [<.calls, { +: [<.calls, 1] }]
            - set: [counter.ticks, { +: [counter.ticks, by_amount] }]

      # A string field as well, so that not only numbers are checked.
      - def:
          name: rename
          access: public
          args: [[counter, ref<Counter>], [new_name, string]]
          body:
            - set: [counter.name, new_name]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [bumper, ptr<Bumper>, { new: Bumper }]

      - decl: [one, Counter]
      - set: [one.name, "erster"]
      - set: [one.ticks, 5]

      # free function: was already fine, stands here for comparison.
      - call: [bump_free, one, 3]
      - set: [fails, { +: [fails, { call: [expect, "free function changes through ref<>", { eq: [one.ticks, 8] }] }] }]

      # method, reading — this is where the IR check failed.
      - decl: [seen, i32, { call: [bumper.read_ticks, one] }]
      - set: [fails, { +: [fails, { call: [expect, "method reads through ref<>", { eq: [seen, 8] }] }] }]

      # method, changing: the caller MUST see it.
      - call: [bumper.bump, one, 4]
      - set: [fails, { +: [fails, { call: [expect, "method changes through ref<> (number)", { eq: [one.ticks, 12] }] }] }]
      - call: [bumper.rename, one, "umbenannt"]
      - set: [fails, { +: [fails, { call: [expect, "method changes through ref<> (string)", { eq: [one.name, "umbenannt"] }] }] }]

      # A model IN a model: the address must also come from a field.
      - decl: [pair, Pair]
      - set: [pair.left.ticks, 100]
      - call: [bumper.bump, pair.left, 7]
      - set: [fails, { +: [fails, { call: [expect, "a field model is changed too", { eq: [pair.left.ticks, 107] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "and the neighbouring field stays untouched", { eq: [pair.right.ticks, 0] }] }] }]

      - set: [fails, { +: [fails, { call: [expect, "the method was called three times", { eq: [bumper.calls, 3] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_ref_model_method_arg FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_ref_model_method_arg PASS"]
      - return: 0
