# SPEC?: 10_collections   # derived from the file name, to be confirmed
# Repro: a direct return expression with a list-producing builtin fails.
#
# Observed in the DataCreatures itemgen refactor (model.aiml::load_vocab_list):
#   - def:
#       name: load_vocab_list
#       return: list<string>
#       body:
#         - return: { call: [blob.split, "|"] }
#
# → LLVM module verification:
#     ret ptr %split_alloca
#     %list_string = type { i32, i32, ptr }
#
# Cause: visitRetStmt takes `val` directly from visitExpression and calls
# `createRet(val)`.  If val is an alloca pointer to a list struct
# and the return type is a struct, the `load <struct>, ptr` before it is missing.
#
# Workaround (present in itemgen): an intermediate decl, then return varname.
# We want the root fix.

- def:
    name: split_pipe
    args: [[var_s, string]]
    return: list<string>
    body:
      - return: { call: [var_s.split, "|"] }

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [out, list<string>, { call: [split_pipe, "alpha|beta|gamma"] }]
      - if:
          condition: { neq: [out.len, 3] }
          then:
            - print: ["FAIL: expected 3 parts, got ${out.len}"]
            - return: 1
      - decl: [var_a, string, { at: [out, 0] }]
      - decl: [var_b, string, { at: [out, 1] }]
      - decl: [var_c, string, { at: [out, 2] }]
      - if:
          condition: { neq: [var_a, "alpha"] }
          then:
            - print: ["FAIL: parts[0]='${var_a}', expected 'alpha'"]
            - return: 1
      - if:
          condition: { neq: [var_b, "beta"] }
          then:
            - print: ["FAIL: parts[1]='${var_b}', expected 'beta'"]
            - return: 1
      - if:
          condition: { neq: [var_c, "gamma"] }
          then:
            - print: ["FAIL: parts[2]='${var_c}', expected 'gamma'"]
            - return: 1
      - print: ["PASS test_return_list_from_call"]
      - return: 0
