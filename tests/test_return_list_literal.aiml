# `return: [a, b]` returns a LIST (spec/10 "list literal as a return value").
#
# Before 2026-11-21 the elements landed in the parser's argument storage, the
# body got no value at all, and the function returned an undefined
# return value: `len` was garbage (measured 1768256100) and the first
# access crashed.  The element type comes from the DECLARED return type,
# which is why the empty list works too.

- def:
    name: drei_woerter
    args: []
    return: list<string>
    body:
      - return: ["eins", "zwei", "drei"]

- def:
    name: leere_liste
    args: []
    return: list<string>
    body:
      - return: []

- def:
    name: zahlen
    args: []
    return: list<i32>
    body:
      - return: [7, 8, 9]

- def:
    name: brueche
    args: []
    return: list<f32>
    body:
      - return: [1, 2]

# Pass-through (spec/10): a ONE-ELEMENT sequence in a function that does not return a list
# is the value itself -- this notation is everywhere in the corpus.
- def:
    name: plus_eins
    args: [[wert, i32]]
    return: i32
    body:
      - return: [{ "+": [wert, 1] }]

# The same if the one element ITSELF has the return type: no list inside the list.
- def:
    name: liste_weiter
    args: []
    return: list<string>
    body:
      - decl: [innen, list<string>]
      - call: [innen.push, "durch"]
      - return: [innen]

# A list of literal AND expression mixed.
- def:
    name: gemischt
    args: [[dazu, string]]
    return: list<string>
    body:
      - return: ["fest", dazu]

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [fehler, i32, 0]
      - decl: [woerter, list<string>, { call: [drei_woerter] }]
      - if:
          condition: { neq: [woerter.len, 3] }
          then: [{ call: [log.error, "FAIL three words: ${woerter.len}"] }, { set: [fehler, { "+": [fehler, 1] }] }]
      - decl: [erstes, string, { at: [woerter, 0] }]
      - decl: [letztes, string, { at: [woerter, 2] }]
      - if:
          condition: { neq: [erstes, "eins"] }
          then: [{ call: [log.error, "FEHL erstes Wort: '${erstes}'"] }, { set: [fehler, { "+": [fehler, 1] }] }]
      - if:
          condition: { neq: [letztes, "drei"] }
          then: [{ call: [log.error, "FEHL letztes Wort: '${letztes}'"] }, { set: [fehler, { "+": [fehler, 1] }] }]

      - decl: [leer, list<string>, { call: [leere_liste] }]
      - if:
          condition: { neq: [leer.len, 0] }
          then: [{ call: [log.error, "FAIL empty list: ${leer.len}"] }, { set: [fehler, { "+": [fehler, 1] }] }]
      # A returned empty list must be USABLE, not just empty.
      - call: [leer.push, "danach"]
      - if:
          condition: { neq: [leer.len, 1] }
          then: [{ call: [log.error, "FAIL push onto empty list: ${leer.len}"] }, { set: [fehler, { "+": [fehler, 1] }] }]

      - decl: [zahl_liste, list<i32>, { call: [zahlen] }]
      - decl: [mitte, i32, { at: [zahl_liste, 1] }]
      - if:
          condition: { "||": [{ neq: [zahl_liste.len, 3] }, { neq: [mitte, 8] }] }
          then: [{ call: [log.error, "FEHL Zahlen: ${zahl_liste.len} / ${mitte}"] }, { set: [fehler, { "+": [fehler, 1] }] }]

      - decl: [bruch_liste, list<f32>, { call: [brueche] }]
      - decl: [erster_bruch, f32, { at: [bruch_liste, 0] }]
      - if:
          condition: { "||": [{ neq: [bruch_liste.len, 2] }, { gt: [{ call: [math.abs, { "-": [erster_bruch, 1.0] }] }, 0.001] }] }
          then: [{ call: [log.error, "FEHL Brueche: ${bruch_liste.len} / ${erster_bruch}"] }, { set: [fehler, { "+": [fehler, 1] }] }]

      - decl: [mix, list<string>, { call: [gemischt, "beweglich"] }]
      - decl: [mix_zwei, string, { at: [mix, 1] }]
      - if:
          condition: { "||": [{ neq: [mix.len, 2] }, { neq: [mix_zwei, "beweglich"] }] }
          then: [{ call: [log.error, "FAIL mixed: ${mix.len} / '${mix_zwei}'"] }, { set: [fehler, { "+": [fehler, 1] }] }]

      - decl: [sechs, i32, { call: [plus_eins, 5] }]
      - if:
          condition: { neq: [sechs, 6] }
          then: [{ call: [log.error, "FEHL Durchlass i32: ${sechs}"] }, { set: [fehler, { "+": [fehler, 1] }] }]

      - decl: [weiter, list<string>, { call: [liste_weiter] }]
      - if:
          condition: { neq: [weiter.len, 1] }
          then: [{ call: [log.error, "FEHL Durchlass Liste: ${weiter.len}"] }, { set: [fehler, { "+": [fehler, 1] }] }]

      - if:
          condition: { gt: [fehler, 0] }
          then:
            - call: [log.error, "test_return_list_literal: ${fehler} errors"]
            - return: 1
      - call: [log.info, "test_return_list_literal: alles gut"]
      - return: 0
