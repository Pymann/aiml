# Negative test (spec/10): SEVERAL values in `return: [...]`, but the return type is
# not a list.  Before, the LAST element silently won -- the function returned 9,
# and nobody said anything.  That must be a hard error.
- def:
    name: drei_werte
    args: []
    return: i32
    body:
      - return: [7, 8, 9]

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [wert, i32, { call: [drei_werte] }]
      - call: [log.info, "never reached: ${wert}"]
      - return: 0
