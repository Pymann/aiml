# SPEC?: 16_classes   # derived from the file name, to be confirmed
# Two classes with a method of THE SAME NAME, but a different return type.
#
# Regression: the compiler resolved the return type via the bare
# method name instead of via the receiver's class.  If it hit the
# string-returning variant, it treated the void call as a string temporary
# and crashed in createEntryAlloca (SIGSEGV, found 2026-10-12 on
# cosmos: RunsScreen.render is void, MatrixView.render returns string).
#
# Methods of the same name in different classes are the normal case — `render`,
# `init`, `run`, `size`.  A crash is never a permissible answer.
# Expected exit code: 0

- class:
    name: TextMaker
    methods:
      - def:
          name: render
          access: public
          return: { type: string, lifetime: producer }
          body: [{ return: "gerendert" }]

- class:
    name: SilentScreen
    members:
      - [draw_count, i32]
    methods:
      - def:
          name: render
          access: public
          body:
            - set: [<.draw_count, { +: [<.draw_count, 1] }]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [maker, ptr<TextMaker>, { new: TextMaker }]
      - decl: [screen, ptr<SilentScreen>, { new: SilentScreen }]

      # The void call: this is where the compiler crashed.
      - call: [screen.render]
      - call: [screen.render]
      - set: [fails, { +: [fails, { call: [expect, "void method runs twice", { eq: [screen.draw_count, 2] }] }] }]

      # And the other class's string method of the same name returns its value.
      - decl: [txt, string, { call: [maker.render] }]
      - set: [fails, { +: [fails, { call: [expect, "string method returns its value", { eq: [txt, "gerendert"] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_same_method_name_two_classes FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_same_method_name_two_classes PASS"]
      - return: 0
