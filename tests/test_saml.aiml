# Expected exit code: 0
# spec/67 §4: saml.verify_response against the fixtures in tests/_saml/
# (generated by tests/_saml/gen.sh, committed) and saml.authn_request_url.
# Run from the aiml project root (as run_all_tests.sh does).

- def:
    name: fixture
    args: [[name, string]]
    return: string
    body:
      - return: [{ call: [io.read_file, "tests/_saml/${name}"] }]

# What a verification is checked against; the attack cases vary one member.
- class:
    name: SamlCheck
    members:
      - [cert, string, "", { access: public }]
      - [sp_entity, string, "", { access: public }]
      - [acs_url, string, "", { access: public }]
      - [req_id, string, "", { access: public }]
    methods:
      # Verifies `name`.b64 and checks ok/error.  `want_err` is a substring of
      # the expected error ("" when ok is expected).  Returns 0 = as expected.
      - def:
          name: expect
          args: [[label, string], [name, string], [want_err, string]]
          return: i32
          body:
            - decl: [res, map<string:string>, { call: [saml.verify_response, { call: [fixture, "${name}.b64"] }, <.cert, <.sp_entity, <.acs_url, <.req_id] }]
            - decl: [okv, string, { call: [res.get, "ok"] }]
            - decl: [errv, string, { call: [res.get, "error"] }]
            - decl: [is_ok, i32, 0]
            - if:
                condition: { eq: [okv, "1"] }
                then:
                  - set: [is_ok, 1]
            - if:
                condition: { eq: [want_err.len, 0] }
                then:
                  - if:
                      condition: { eq: [is_ok, 1] }
                      then:
                        - print: ["  ok   ${label}"]
                        - return: [0]
                  - print: ["  FAIL ${label}: expected ok, got error '${errv}'"]
                  - return: [1]
            - if:
                condition: { and: [{ eq: [is_ok, 0] }, { ge: [{ call: [errv.index_of, want_err] }, 0] }] }
                then:
                  - print: ["  ok   ${label} (${errv})"]
                  - return: [0]
            - print: ["  FAIL ${label}: expected error containing '${want_err}', got ok=${okv} error='${errv}'"]
            - return: [1]

- def:
    name: same
    args: [[label, string], [got, string], [want, string]]
    return: i32
    body:
      - if:
          condition: { eq: [got, want] }
          then:
            - print: ["  ok   ${label}"]
            - return: [0]
      - print: ["  FAIL ${label}: got '${got}' want '${want}'"]
      - return: [1]

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [cert, string, { call: [fixture, "idp_cert.pem"] }]
      - decl: [other, string, { call: [fixture, "other_cert.pem"] }]
      - decl: [sp_entity, string, "https://sp.example/metadata"]
      - decl: [acs, string, "https://sp.example/acs"]
      - decl: [req, string, "_req123"]
      - decl: [chk, ptr<SamlCheck>, { new: SamlCheck }]
      - set: [chk.cert, cert]
      - set: [chk.sp_entity, sp_entity]
      - set: [chk.acs_url, acs]
      - set: [chk.req_id, req]

      # valid shapes
      - set: [fails, { +: [fails, { call: [chk.expect, "signed assertion", "assertion_signed", ""] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "signed response", "response_signed", ""] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "both signed", "both_signed", ""] }] }]
      - set: [chk.req_id, ""]
      - set: [fails, { +: [fails, { call: [chk.expect, "IdP-initiated (no expected request id)", "assertion_signed", ""] }] }]
      - set: [chk.req_id, req]

      # values come from the signed assertion
      - decl: [good, map<string:string>, { call: [saml.verify_response, { call: [fixture, "assertion_signed.b64"] }, cert, sp_entity, acs, req] }]
      - set: [fails, { +: [fails, { call: [same, "name_id", { call: [good.get, "name_id"] }, "alice@example.org"] }] }]
      - set: [fails, { +: [fails, { call: [same, "issuer", { call: [good.get, "issuer"] }, "https://idp.example"] }] }]
      - set: [fails, { +: [fails, { call: [same, "session_index", { call: [good.get, "session_index"] }, "_sess42"] }] }]
      - set: [fails, { +: [fails, { call: [same, "request_id", { call: [good.get, "request_id"] }, "_req123"] }] }]
      - set: [fails, { +: [fails, { call: [same, "signed", { call: [good.get, "signed"] }, "assertion"] }] }]
      - set: [fails, { +: [fails, { call: [same, "attr.displayName", { call: [good.get, "attr.displayName"] }, "Alice Example"] }] }]
      - set: [fails, { +: [fails, { call: [same, "attr.groups (multi-valued)", { call: [good.get, "attr.groups"] }, "devs\nops"] }] }]

      # attacks and mismatches
      - set: [chk.cert, other]
      - set: [fails, { +: [fails, { call: [chk.expect, "wrong certificate", "assertion_signed", "signature is invalid"] }] }]
      - set: [chk.cert, cert]
      - set: [fails, { +: [fails, { call: [chk.expect, "NameID tampered after signing", "tampered", "Assertion"] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "wrapping: extra unsigned assertion", "wrapping", "exactly one Assertion"] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "unsigned", "unsigned", "not signed"] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "expired", "expired", "expired"] }] }]
      - set: [chk.sp_entity, "https://other-sp.example"]
      - set: [fails, { +: [fails, { call: [chk.expect, "wrong audience", "assertion_signed", "Audience"] }] }]
      - set: [chk.sp_entity, sp_entity]
      - set: [chk.acs_url, "https://sp.example/other-acs"]
      - set: [fails, { +: [fails, { call: [chk.expect, "wrong destination", "assertion_signed", "Destination"] }] }]
      - set: [chk.sp_entity, sp_entity]
      - set: [chk.acs_url, acs]
      - set: [chk.req_id, "_req999"]
      - set: [fails, { +: [fails, { call: [chk.expect, "InResponseTo mismatch", "assertion_signed", "InResponseTo"] }] }]
      - set: [chk.req_id, req]
      - set: [fails, { +: [fails, { call: [chk.expect, "comment inside NameID", "comment_nameid", "comments"] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "SHA-1 signature", "sha1", "signature could not be processed"] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "signature references another element", "foreign_ref", "enclosing element"] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "duplicate IDs", "duplicate_id", "duplicate ID"] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "encrypted assertion", "encrypted", "encrypted assertions"] }] }]
      - set: [fails, { +: [fails, { call: [chk.expect, "DTD / entity", "dtd", "DTD"] }] }]

      # malformed input never crashes
      - decl: [junk, map<string:string>, { call: [saml.verify_response, "!!!not base64!!!", cert, sp_entity, acs, req] }]
      - set: [fails, { +: [fails, { call: [same, "junk -> ok=0", { call: [junk.get, "ok"] }, "0"] }] }]
      - decl: [not_xml, map<string:string>, { call: [saml.verify_response, { call: [base64.encode, "hello <world"] }, cert, sp_entity, acs, req] }]
      - set: [fails, { +: [fails, { call: [same, "not xml -> ok=0", { call: [not_xml.get, "ok"] }, "0"] }] }]
      - decl: [no_cert, map<string:string>, { call: [saml.verify_response, { call: [fixture, "assertion_signed.b64"] }, "", sp_entity, acs, req] }]
      - set: [fails, { +: [fails, { call: [same, "no cert -> ok=0", { call: [no_cert.get, "ok"] }, "0"] }] }]

      # AuthnRequest URL (HTTP-Redirect binding)
      - decl: [rid, string, { call: [saml.new_request_id] }]
      - set: [fails, { +: [fails, { call: [same, "request id shape", { call: [rid.substr, 0, 1] }, "_"] }] }]
      - decl: [rid_len, string, "${rid.len}"]
      - set: [fails, { +: [fails, { call: [same, "request id length", rid_len, "41"] }] }]
      - decl: [login_url, string, { call: [saml.authn_request_url, "https://idp.example/sso", sp_entity, acs, "_req123", "/after/login"] }]
      - set: [fails, { +: [fails, { call: [same, "redirect prefix", { call: [login_url.substr, 0, 36] }, "https://idp.example/sso?SAMLRequest="] }] }]
      - decl: [relay_at, i32, { call: [login_url.index_of, "&RelayState=%2Fafter%2Flogin"] }]
      - decl: [relay_ok, string, "no"]
      - if:
          condition: { gt: [relay_at, 0] }
          then:
            - set: [relay_ok, "yes"]
      - set: [fails, { +: [fails, { call: [same, "relay state appended", relay_ok, "yes"] }] }]
      - decl: [with_query, string, { call: [saml.authn_request_url, "https://idp.example/sso?tenant=a", sp_entity, acs, "", ""] }]
      - set: [fails, { +: [fails, { call: [same, "existing query kept", { call: [with_query.substr, 0, 45] }, "https://idp.example/sso?tenant=a&SAMLRequest="] }] }]

      - if:
          condition: { gt: [fails, 0] }
          then:
            - print: ["FAIL saml: ${fails}"]
            - return: [1]
      - print: ["PASS saml"]
      - return: [0]
