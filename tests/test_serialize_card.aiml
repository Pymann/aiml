- model:
    name: ActiveAbility
    fields:
      - [cost_text,       string]
      - [activation_cost, list<i32>]
      - [trigger,         list<list<i32>>]
      - [effects,         list<list<i32>>]

- enum:
    name: ManaColor
    values:
      - fire: 1
      - earth: 5

- enum:
    name: CardType
    values:
      - creature: 1
      - spell: 2
      - mana_card: 3
      - trap: 7

- enum:
    name: SpellType
    values:
      - sorcery: 2
      - ceremony: 3

- enum:
    name: PassiveAbility
    values:
      - flying: 1
      - double_strike: 10
      - burning: 30
      - reach: 12

- model:
    name: BaseCard
    fields:
      - [name,        string]
      - [card_type,   CardType]
      - [mkp,         i32]
      - [mana_cost,   map<ManaColor:i32>]
      - [description, string]
      - [passive_abilities, list<PassiveAbility>]
      - [active_abilities,  list<ActiveAbility>]

- model:
    name: Card
    inherits: BaseCard
    fields:
      - [lp,         i32]
      - [attack,     i32]
      - [defense,    i32]
      - [initiative, i32]
      - [moral,      i32]
      - [movement,   i32]
      - [spell_type, SpellType]
      - [equip_cost, i32]
      - [created_at, i64]

- def:
    name: main
    return: i32
    body:
      - print: ["TEST START"]

      - decl: [j1, string, '{"name": "Red Pyromancer IV", "card_type": 1, "mkp": 5, "mana_cost": {"1": 2}, "description": "A red creature.", "passive_abilities": [10, 30, 12], "active_abilities": [], "lp": 4, "attack": 5, "defense": 1, "initiative": 2, "moral": 3, "movement": 2, "spell_type": 0, "equip_cost": 0, "created_at": 0}']
      - decl: [c1, Card]
      - set: [c1, {call: [sys.deserialize, j1, "Card"]}]
      - print: ["c1.name=${c1.name} type=${c1.card_type} lp=${c1.lp}"]
      - print: ["c1.passive_abilities.len=${c1.passive_abilities.len}"]
      - print: ["c1.active_abilities.len=${c1.active_abilities.len}"]

      - print: ["ALL PASS"]
      - return: 0
