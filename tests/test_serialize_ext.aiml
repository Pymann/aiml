# Extended serialization tests: structs, enums, lists, maps, round-trips

# --- Type definitions ---
- enum:
    name: Status
    values:
      - Ok
      - Error: 5
      - Unknown

- class:
    name: Vec2
    members:
      - [var_x, i32]
      - [var_y, i32]

# --- Enum serialize ---
- decl: [st1, Status, Status.Ok]
- decl: [s_st1, string]
- set: [s_st1, { call: [sys.serialize, st1] }]
- print: ["enum Ok serialized: ${s_st1}"]

- decl: [st2, Status, Status.Error]
- decl: [s_st2, string]
- set: [s_st2, { call: [sys.serialize, st2] }]
- print: ["enum Error serialized: ${s_st2}"]

# --- Struct serialize ---
- decl: [var_v, Vec2]
- set: [var_v.var_x, 10]
- set: [var_v.var_y, 20]
- decl: [s_v, string]
- set: [s_v, { call: [sys.serialize, var_v] }]
- print: ["struct Vec2 serialized: ${s_v}"]

# --- List serialize ---
- decl: [nums, list<i32>]
- call: [nums.push, 1]
- call: [nums.push, 2]
- call: [nums.push, 3]
- decl: [s_nums, string]
- set: [s_nums, { call: [sys.serialize, nums] }]
- print: ["list serialized: ${s_nums}"]

# --- Struct deserialize round-trip ---
- decl: [json_v, string]
- set: [json_v, "{\"__type\":\"Vec2\",\"var_x\":5,\"var_y\":7}"]
- decl: [var_v2, Vec2]
- set: [var_v2, { call: [sys.deserialize, json_v, "Vec2"] }]
- print: ["deserialized Vec2.var_x: ${var_v2.var_x}"]
- print: ["deserialized Vec2.var_y: ${var_v2.var_y}"]
