- model:
    name: Ability
    fields:
      - [cost_text, string]
      - [activation_cost, list<i32>]
      - [trigger, list<list<i32>>]
      - [effects, list<list<i32>>]

- model:
    name: TestCard
    fields:
      - [name, string]
      - [abilities, list<Ability>]

- def:
    name: main
    return: i32
    body:
      - print: ["TEST START"]
      # Test: empty abilities list
      - decl: [json1, string, '{"__type":"TestCard","name":"Fireball","abilities":[]}']
      - decl: [var_c1, TestCard]
      - set: [var_c1, {call: [sys.deserialize, json1, "TestCard"]}]
      - print: ["card1.name=${var_c1.name} abilities=${var_c1.abilities.len}"]

      # Test: ability with nested lists
      - decl: [json2, string, '{"__type":"TestCard","name":"Dragon","abilities":[{"cost_text":"2 Fire","activation_cost":[1,2],"trigger":[],"effects":[[10,3],[20,5,1]]}]}']
      - decl: [var_c2, TestCard]
      - set: [var_c2, {call: [sys.deserialize, json2, "TestCard"]}]
      - print: ["card2.name=${var_c2.name} abilities=${var_c2.abilities.len}"]
      - decl: [var_ab, Ability, { at: [var_c2.abilities, 0] }]
      - print: ["var_ab.cost_text=${var_ab.cost_text}"]
      - print: ["var_ab.activation_cost.len=${var_ab.activation_cost.len}"]
      - print: ["var_ab.trigger.len=${var_ab.trigger.len}"]
      - print: ["var_ab.effects.len=${var_ab.effects.len}"]

      # Serialize back and check
      - decl: [ser, string]
      - set: [ser, {call: [sys.serialize, var_c2, "TestCard"]}]
      - print: ["serialized=${ser}"]
      - print: ["ALL PASS"]
      - return: 0
