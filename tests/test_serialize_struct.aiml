- model:
    name: Ability
    fields:
      - [cost_text, string]
      - [activation_cost, list<i32>]
      - [trigger, list<list<i32>>]
      - [effects, list<list<i32>>]

- model:
    name: TestCard
    fields:
      - [name, string]
      - [abilities, list<Ability>]

- def:
    name: main
    return: i32
    body:
      - print: ["TEST START"]
      # Test: empty abilities list
      - decl: [json1, string, '{"__type":"TestCard","name":"Fireball","abilities":[]}']
      - decl: [c1, TestCard]
      - set: [c1, {call: [sys.deserialize, json1, "TestCard"]}]
      - print: ["card1.name=${c1.name} abilities=${c1.abilities.len}"]

      # Test: ability with nested lists
      - decl: [json2, string, '{"__type":"TestCard","name":"Dragon","abilities":[{"cost_text":"2 Fire","activation_cost":[1,2],"trigger":[],"effects":[[10,3],[20,5,1]]}]}']
      - decl: [c2, TestCard]
      - set: [c2, {call: [sys.deserialize, json2, "TestCard"]}]
      - print: ["card2.name=${c2.name} abilities=${c2.abilities.len}"]
      - decl: [ab, Ability, c2.abilities-0]
      - print: ["ab.cost_text=${ab.cost_text}"]
      - print: ["ab.activation_cost.len=${ab.activation_cost.len}"]
      - print: ["ab.trigger.len=${ab.trigger.len}"]
      - print: ["ab.effects.len=${ab.effects.len}"]

      # Serialize back and check
      - decl: [ser, string]
      - set: [ser, {call: [sys.serialize, c2, "TestCard"]}]
      - print: ["serialized=${ser}"]
      - print: ["ALL PASS"]
      - return: 0
