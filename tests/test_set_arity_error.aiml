# SPEC: 02_types
# spec/02: `set` takes EXACTLY [target, value]. A third element is a compile error —
# before, it was silently swallowed: `set: [nums, 0, 99]` assigned 0 and threw 99 away, without
# any message. The existing check was dead code (it demanded !exprArg, which was always
# occupied by `expectingValue`).
#
# Negative test: the compilation MUST fail, and the message MUST point to `idx:`.
# Expected exit code: 1

- def:
    name: main
    return: i32
    body:
      - decl: [nums, list<i32>, [1, 2, 3]]
      - set: [nums, 0, 99]
      - return: 0
