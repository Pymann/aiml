# SPEC: 02_types
# spec/02: a container target takes no scalar. Before, the scalar landed in the
# container slot → `.len` read garbage, then SIGSEGV.
#
# Negative test: the compilation MUST fail, and the message MUST name the alternatives
# (push for one element, a literal for the whole content).
# Expected exit code: 1

- def:
    name: main
    return: i32
    body:
      - decl: [nums, list<i32>, []]
      - set: [nums, 99]
      - return: 0
