# SPEC: 10_collections
# spec/10: `set: [liste, [v1, v2, ...]]` ersetzt den Inhalt (clear + push je Element).
# Bis 2026-10-31 sah der Parser die innere Sequenz nur bei `decl`: bei `set` wurde das ERSTE
# Element als Wert verbraucht, der Rest fiel still weg, und der Skalar landete im
# Container-Slot → `.len` las Muell, dann SIGSEGV. `set: [x, []]` uebersetzte gar nicht
# ("Failed to evaluate value expression"). Backlog-Punkte 13 und 36.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- class:
    name: Holder
    members:
      - [names, list<string>, null, { access: public }]
    methods:
      - def:
          name: fill
          args: []
          return: i32
          body:
            - set: [<.names, ["Knoten", "Text"]]
            - return: <.names.len

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]

      # 1) Der gemeldete Minimalfall: Literal auf eine lokale Liste.
      - decl: [pick, list<string>, []]
      - set: [pick, ["x", "y"]]
      - call: [chk.expect_i, "set-Literal: Laenge", pick.len, 2]
      - call: [chk.expect_s, "set-Literal: Element 0", { at: [pick, 0] }, "x"]
      - call: [chk.expect_s, "set-Literal: Element 1", { at: [pick, 1] }, "y"]

      # 2) Variablen als Elemente — im Bericht ausdruecklich genannt.
      - decl: [one, string, "eins"]
      - decl: [two, string, "zwei"]
      - set: [pick, [one, two]]
      - call: [chk.expect_i, "Variablen-Elemente: Laenge", pick.len, 2]
      - call: [chk.expect_s, "Variablen-Elemente: Element 1", { at: [pick, 1] }, "zwei"]

      # 3) Ersetzen, nicht anhaengen: eine kuerzere Zuweisung verkuerzt die Liste.
      - set: [pick, ["nur_eins"]]
      - call: [chk.expect_i, "Ersetzen statt Anhaengen", pick.len, 1]

      # 4) Leeres Literal — uebersetzte vorher nicht.
      - set: [pick, []]
      - call: [chk.expect_i, "leeres Literal leert die Liste", pick.len, 0]

      # 5) Zahlen werden in den Elementtyp umgewandelt (spec/13), wie beim decl.
      - decl: [nums, list<i32>, []]
      - set: [nums, [1, -2, 3]]
      - call: [chk.expect_i, "i32-Literal: Laenge", nums.len, 3]
      - call: [chk.expect_i, "i32-Literal: negatives Element", { at: [nums, 1] }, -2]

      # 6) Member-Zuweisung = Backlog-Punkt 13 (war SIGSEGV in aiml_list_handle_incref).
      - decl: [box, ptr<Holder>, { new: Holder }]
      - decl: [filled, i32, { call: [box.fill] }]
      - call: [chk.expect_i, "Member-Literal: Laenge in der Methode", filled, 2]
      - call: [chk.expect_i, "Member-Literal: von aussen sichtbar", box.names.len, 2]
      - call: [chk.expect_s, "Member-Literal: Element 0", { at: [box.names, 0] }, "Knoten"]

      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL set_list_literal (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS set_list_literal"]
      - return: 0
