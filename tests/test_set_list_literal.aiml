# SPEC: 10_collections
# spec/10: `set: [list, [v1, v2, ...]]` replaces the content (clear + push per element).
# Until 2026-10-31 the parser only saw the inner sequence for `decl`: for `set` the FIRST
# element was consumed as the value, the rest silently fell away, and the scalar landed in the
# container slot → `.len` read garbage, then SIGSEGV. `set: [x, []]` did not compile at all
# ("Failed to evaluate value expression"). Backlog items 13 and 36.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- class:
    name: Holder
    members:
      - [names, list<string>, null, { access: public }]
    methods:
      - def:
          name: fill
          args: []
          return: i32
          body:
            - set: [<.names, ["Knoten", "Text"]]
            - return: <.names.len

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]

      # 1) the reported minimal case: a literal onto a local list.
      - decl: [pick, list<string>, []]
      - set: [pick, ["x", "y"]]
      - call: [chk.expect_i, "set literal: length", pick.len, 2]
      - call: [chk.expect_s, "set-Literal: Element 0", { at: [pick, 0] }, "x"]
      - call: [chk.expect_s, "set-Literal: Element 1", { at: [pick, 1] }, "y"]

      # 2) variables as elements — named explicitly in the report.
      - decl: [one, string, "eins"]
      - decl: [two, string, "zwei"]
      - set: [pick, [one, two]]
      - call: [chk.expect_i, "variable elements: length", pick.len, 2]
      - call: [chk.expect_s, "Variablen-Elemente: Element 1", { at: [pick, 1] }, "zwei"]

      # 3) replace, not append: a shorter assignment shortens the list.
      - set: [pick, ["nur_eins"]]
      - call: [chk.expect_i, "replacing instead of appending", pick.len, 1]

      # 4) empty literal — did not compile before.
      - set: [pick, []]
      - call: [chk.expect_i, "an empty literal empties the list", pick.len, 0]

      # 5) numbers are converted into the element type (spec/13), as for decl.
      - decl: [nums, list<i32>, []]
      - set: [nums, [1, -2, 3]]
      - call: [chk.expect_i, "i32 literal: length", nums.len, 3]
      - call: [chk.expect_i, "i32-Literal: negatives Element", { at: [nums, 1] }, -2]

      # 6) Member-Zuweisung = Backlog-Punkt 13 (war SIGSEGV in aiml_list_handle_incref).
      - decl: [box, ptr<Holder>, { new: Holder }]
      - decl: [filled, i32, { call: [box.fill] }]
      - call: [chk.expect_i, "member literal: length in the method", filled, 2]
      - call: [chk.expect_i, "member literal: visible from outside", box.names.len, 2]
      - call: [chk.expect_s, "Member-Literal: Element 0", { at: [box.names, 0] }, "Knoten"]

      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL set_list_literal (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS set_list_literal"]
      - return: 0
