# SPEC: 04_1_precedence
# Backlog item 2: `{ shl: [6, -4] }` delivered undefined garbage (measured 372022024),
# because the C UB came through. A CONSTANT shift amount outside [0, width) is
# statically recognisable and therefore a compile error.
# Expected exit code: 1

- def:
    name: main
    return: i32
    body:
      - decl: [res, i32, { shl: [6, -4] }]
      - return: 0
