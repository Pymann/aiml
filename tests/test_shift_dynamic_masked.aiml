# SPEC: 04_1_precedence
# Backlog-Punkt 2: eine DYNAMISCHE Schiebeweite kann der Compiler nicht pruefen. Statt
# C-UB wird sie auf die Operandenbreite maskiert (i32 -> & 31, i64 -> & 63) und ist damit
# definiert. Vorher kam Muell heraus.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- def:
    name: shift_by
    args: [[val, i32], [amount, i32]]
    return: i32
    body:
      - return: { shl: [val, amount] }

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]
      - call: [chk.expect_i, "i32: 68 maskiert auf 4", { call: [shift_by, 6, 68] }, 96]
      - call: [chk.expect_i, "i32: 0 schiebt nicht", { call: [shift_by, 6, 0] }, 6]
      - call: [chk.expect_i, "i32: 31 ist noch gueltig", { call: [shift_by, 1, 31] }, -2147483648]
      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL shift_dynamic (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS shift_dynamic_masked"]
      - return: 0
