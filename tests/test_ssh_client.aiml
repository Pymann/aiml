# SPEC: 32_6_network_ssh,32_network
# spec/32_6: SSH client against the test server in our own process.
#
# Without our own server there would be no evidence: on the development machine
# no sshd runs (port 22 empty, openssh-server not installed).  libssh brings
# a server side along, so the test spins up its own — bound to
# 127.0.0.1, with a one-time host key and exactly one credential pair (spec/32_6 §7).
#
# Checked in this order:
#   1. host verification is BINDING — without accept_host nothing works
#   2. wrong fingerprint → rejected, right one → accepted
#   3. password authentication, a wrong password fails
#   4. exec: stdout and stderr SEPARATE, exit code right
#   5. stdin is writable (that is the reason why there are channels)
#   6. write_buffer transfers binary data unaltered
# Expected exit code: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [port, i32, 22899]
      - decl: [srv, ssh_test_server, { call: [ssh.test_listen, port, "deploy", "geheim-123"] }]
      - if:
          condition: { eq: [srv, null] }
          then: [{ print: ["FAIL test server does not start on port ${port}"] }, { return: 1 }]
      # Serving MUST run concurrently — single-threaded, connect waits for a
      # server that never gets its turn (spec/32_6 §7).
      - decl: [srv_thread, thread_handle, { call: [srv.serve_async] }]

      - decl: [host_fp, string, { call: [srv.fingerprint] }]
      - if:
          condition: { lt: [{ call: [host_fp.index_of, "SHA256:"] }, 0] }
          then: [{ print: ["FAIL fingerprint does not have the form SHA256:... ('${host_fp}')"] }, { set: [fails, { +: [fails, 1] }] }]

      # ── 1./2. host verification ──────────────────────────────────────────
      - decl: [sess_a, ssh_session, { call: [ssh.connect, "127.0.0.1", port, "deploy", 5000] }]
      - if:
          condition: { eq: [sess_a, null] }
          then: [{ print: ["FAIL connect failed"] }, { return: 1 }]

      # Without accept_host the authentication MUST fail — that is the
      # promise from §3, and without this check it would only be an intention.
      - decl: [early, i32, { call: [sess_a.auth_password, "geheim-123"] }]
      - if:
          condition: { neq: [early, 0] }
          then: [{ print: ["FAIL auth on an UNVERIFIED session was allowed (${early})"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [wrong_fp, i32, { call: [sess_a.accept_host, "SHA256:ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ"] }]
      - if:
          condition: { neq: [wrong_fp, 0] }
          then: [{ print: ["FAIL wrong fingerprint was accepted"] }, { set: [fails, { +: [fails, 1] }] }]

      - decl: [right_fp, i32, { call: [sess_a.accept_host, host_fp] }]
      - if:
          condition: { neq: [right_fp, 1] }
          then: [{ print: ["FAIL right fingerprint was rejected"] }, { return: 1 }]

      # ── 3. Authentifizierung ─────────────────────────────────────────────
      - decl: [bad_pw, i32, { call: [sess_a.auth_password, "falsch"] }]
      - if:
          condition: { neq: [bad_pw, 0] }
          then: [{ print: ["FAIL wrong password was accepted"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [good_pw, i32, { call: [sess_a.auth_password, "geheim-123"] }]
      - if:
          condition: { neq: [good_pw, 1] }
          then: [{ print: ["FAIL right password was rejected"] }, { return: 1 }]

      # ── 4. exec: separate streams, exit code ────────────────────────────
      - decl: [ch_ok, ssh_channel, { call: [sess_a.exec, "echo auf-stdout; echo auf-stderr 1>&2; exit 7"] }]
      - if:
          condition: { eq: [ch_ok, null] }
          then: [{ print: ["FAIL exec returned null"] }, { return: 1 }]
      - decl: [got_out, string, { call: [ch_ok.read_out, 4096] }]
      - decl: [got_err, string, { call: [ch_ok.read_err, 4096] }]
      - decl: [got_rc, i32, { call: [ch_ok.exit_code] }]
      - if:
          condition: { lt: [{ call: [got_out.index_of, "auf-stdout"] }, 0] }
          then: [{ print: ["FAIL stdout missing ('${got_out}')"] }, { set: [fails, { +: [fails, 1] }] }]
      - if:
          condition: { lt: [{ call: [got_err.index_of, "auf-stderr"] }, 0] }
          then: [{ print: ["FAIL stderr missing ('${got_err}')"] }, { set: [fails, { +: [fails, 1] }] }]
      # The separation is the point: stderr must NOT show up in stdout.
      - if:
          condition: { gt: [{ call: [got_out.index_of, "auf-stderr"] }, -1] }
          then: [{ print: ["FAIL stderr landete in stdout ('${got_out}')"] }, { set: [fails, { +: [fails, 1] }] }]
      - if:
          condition: { neq: [got_rc, 7] }
          then: [{ print: ["FAIL exit_code=${got_rc}, expected 7"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [ch_ok.close]

      # ── 5. stdin ─────────────────────────────────────────────────────────
      # The reason for the channel API: a sudo password must not be in argv.
      - decl: [ch_in, ssh_channel, { call: [sess_a.exec, "cat"] }]
      - decl: [n_wrote, i32, { call: [ch_in.write, "durch-stdin\n"] }]
      - if:
          condition: { lt: [n_wrote, 1] }
          then: [{ print: ["FAIL write wrote ${n_wrote} bytes"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [eof_rc, i32, { call: [ch_in.send_eof] }]
      - decl: [echoed, string, { call: [ch_in.read_out, 4096] }]
      - if:
          condition: { lt: [{ call: [echoed.index_of, "durch-stdin"] }, 0] }
          then: [{ print: ["FAIL stdin did not arrive ('${echoed}')"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [ch_in.close]

      # ── 6. binary data via write_buffer ─────────────────────────────────
      # With 0x00 and 0xFF in it: exactly that is where a string-based
      # transfer fails, and that is how the agent will be deployed later (§6).
      - decl: [payload, buffer<u8>]
      - call: [payload.alloc, 5]
      - call: [payload.write, 0, u8]
      - call: [payload.write, 255, u8]
      - call: [payload.write, 65, u8]
      - call: [payload.write, 0, u8]
      - call: [payload.write, 66, u8]
      - decl: [ch_bin, ssh_channel, { call: [sess_a.exec, "wc -c"] }]
      - decl: [n_bin, i32, { call: [ch_bin.write_buffer, payload] }]
      - if:
          condition: { neq: [n_bin, 5] }
          then: [{ print: ["FAIL write_buffer wrote ${n_bin} of 5 bytes"] }, { set: [fails, { +: [fails, 1] }] }]
      - decl: [eof_bin, i32, { call: [ch_bin.send_eof] }]
      - decl: [counted, string, { call: [ch_bin.read_out, 256] }]
      - if:
          condition: { lt: [{ call: [counted.index_of, "5"] }, 0] }
          then: [{ print: ["FAIL the other side did not count 5 bytes ('${counted}')"] }, { set: [fails, { +: [fails, 1] }] }]
      - call: [ch_bin.close]

      - call: [sess_a.close]
      - call: [srv.stop]
      - call: [srv_thread.join]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_ssh_client FAIL (${fails})"] }, { return: 1 }]
      - print: ["PASS ssh_client"]
      - return: 0
