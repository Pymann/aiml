# SPEC: 49_static_analysis,49_static_off
# Positive test (warning, not an error): a variable is compared EXACTLY ONCE against
# a string literal.  That is allowed, but produces a
# compiler WARNING with a hint at regular expressions (see spec/49 §16).
# The compilation runs through normally (exit 0).
#
# Expected exit code: 0
#
# Diagnostic form (warning):
#   ...: variable 'kind' is compared against a string literal — consider a
#   regular expression for string matching.

- def:
    name: is_fire
    args: [[kind, string]]
    return: i32
    body:
      - if: { condition: { eq: [kind, "fire"] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [res, i32, { call: [is_fire, "fire"] }]
      - if: { condition: { neq: [res, 1] }, then: [{ call: [sys.exit, 5] }] }
      - return: 0
