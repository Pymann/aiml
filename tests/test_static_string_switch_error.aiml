# SPEC: 49_static_analysis,49_static_off
# Negative test: the same variable ('kind') is compared SEVERAL times against string
# literals.  That is a hand-rolled string switch and must be
# a HARD compiler error — with a hint at enum / polymorphic
# programming (see spec/49 §16).
#
# Expected exit code: 1
#
# Diagnostic form:
#   ...: variable 'kind' is compared against string literals 2 times — this
#   hand-rolled string switch should be an enum or polymorphic dispatch.

- def:
    name: classify
    args: [[kind, string]]
    return: i32
    body:
      - if: { condition: { eq: [kind, "fire"] },  then: [{ return: 1 }] }
      - if: { condition: { eq: [kind, "water"] }, then: [{ return: 2 }] }
      - return: 0

- def:
    name: main
    return: i32
    body:
      - decl: [cval, i32, { call: [classify, "fire"] }]
      - return: 0
