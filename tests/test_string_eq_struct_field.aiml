# SPEC: 39_overloading
# Regression test for spec/39 §0:
#   "eq / neq semantics: For `string` pointers: byte-by-byte content
#    comparison (like strcmp)"
#
# Before 2026-06-08: resolveTypeName only recognised VariableExpr/LiteralExpr.
# Member access on string fields (e.g. `struct.field`) got an empty
# typeName → eq:[a.field, b.field] fell back to pointer identity
# instead of strcmp.  Datacreatures repro: terrain lookup in the cockpit hover
# (zone.terrain_id vs terrain.terrain_id, the same string but different
# allocations) → the match failed → the location tooltip was empty.
#
# Fix: resolveTypeName splits dotted names + resolvePropertyWritePtr
# returns the propTypeName, so that visitStringCompare is jumped to.
#
# On regression: pointer identity → a.str_field != b.str_field because of
# different string allocations → exit 1 (FAIL).

- model:
    name: Holder
    fields:
      - [str_field, string]

- def:
    name: main
    return: i32
    body:
      - decl: [first,  Holder]
      - decl: [second, Holder]
      - set: [first.str_field, "regression_match"]
      # By construction a separate allocation with the same content:
      # string interpolation builds a fresh buffer (see StringUtils::
      # concat).  A pointer identity comparison would fail here.
      - decl: [prefix, string, "regression_"]
      - decl: [suffix, string, "match"]
      - set: [second.str_field, "${prefix}${suffix}"]
      - if:
          condition: { eq: [first.str_field, second.str_field] }
          then:
            - print: ["PASS: struct.string_field eq performs content compare"]
            - return: 0
      - print: ["FAIL: struct.string_field eq fell back to pointer identity"]
      - print: ["       first.str_field='${first.str_field}'"]
      - print: ["       second.str_field='${second.str_field}'"]
      - return: 1
