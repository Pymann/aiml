# SPEC?: 09_strings   # aus dem Dateinamen, zu bestaetigen
# Tests for string.substr, string.starts_with, string.index_of

- decl: [pass, i32, 0]
- decl: [fail, i32, 0]

# ── substr(start) ────────────────────────────────────────────────────────────

- decl: [var_s, string, "Bearer abc123"]

- decl: [tok, string]
- set:  [tok, { call: [var_s.substr, 7] }]
- print: ["substr(7): ${tok}"]
- if:
    condition: { eq: [tok, "abc123"] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL substr(7)"] }]

# ── substr(start, len) ───────────────────────────────────────────────────────

- decl: [bearer, string]
- set:  [bearer, { call: [var_s.substr, 0, 6] }]
- print: ["substr(0,6): ${bearer}"]
- if:
    condition: { eq: [bearer, "Bearer"] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL substr(0,6)"] }]

- decl: [mid, string]
- set:  [mid, { call: [var_s.substr, 8, 3] }]
- print: ["substr(8,3): ${mid}"]
- if:
    condition: { eq: [mid, "bc1"] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL substr(8,3)"] }]

- decl: [tail_empty, string]
- set:  [tail_empty, { call: [var_s.substr, 13] }]
- print: ["substr(13): ${tail_empty}"]
- if:
    condition: { eq: [tail_empty, ""] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL substr(13)"] }]

- decl: [full_copy, string]
- set:  [full_copy, { call: [var_s.substr, 0, 13] }]
- print: ["substr(0,13): ${full_copy}"]
- if:
    condition: { eq: [full_copy, "Bearer abc123"] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL substr(0,13)"] }]

- decl: [zero_len, string]
- set:  [zero_len, { call: [var_s.substr, 4, 0] }]
- print: ["substr(4,0): ${zero_len}"]
- if:
    condition: { eq: [zero_len, ""] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL substr(4,0)"] }]

- decl: [single_char, string]
- set:  [single_char, { call: [var_s.substr, 12, 1] }]
- print: ["substr(12,1): ${single_char}"]
- if:
    condition: { eq: [single_char, "3"] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL substr(12,1)"] }]

- decl: [empty_s, string, ""]
- decl: [empty_sub, string]
- set:  [empty_sub, { call: [empty_s.substr, 0] }]
- print: ["empty substr(0): ${empty_sub}"]
- if:
    condition: { eq: [empty_sub, ""] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL empty substr(0)"] }]

# ── starts_with ──────────────────────────────────────────────────────────────

- decl: [sw1, i32]
- set:  [sw1, { call: [var_s.starts_with, "Bearer "] }]
- print: ["starts_with Bearer: ${sw1}"]
- if:
    condition: { eq: [sw1, 1] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL starts_with true"] }]

- decl: [sw2, i32]
- set:  [sw2, { call: [var_s.starts_with, "Token "] }]
- print: ["starts_with Token: ${sw2}"]
- if:
    condition: { eq: [sw2, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL starts_with false"] }]

- decl: [sw3, i32]
- set:  [sw3, { call: [var_s.starts_with, ""] }]
- print: ["starts_with empty: ${sw3}"]
- if:
    condition: { eq: [sw3, 1] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL starts_with empty"] }]

- decl: [sw4, i32]
- set:  [sw4, { call: [var_s.starts_with, "Bearer abc123"] }]
- print: ["starts_with full string: ${sw4}"]
- if:
    condition: { eq: [sw4, 1] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL starts_with full"] }]

- decl: [sw5, i32]
- set:  [sw5, { call: [var_s.starts_with, "Bearer abc1234"] }]
- print: ["starts_with longer string: ${sw5}"]
- if:
    condition: { eq: [sw5, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL starts_with longer"] }]

- decl: [sw6, i32]
- set:  [sw6, { call: [empty_s.starts_with, ""] }]
- print: ["empty starts_with empty: ${sw6}"]
- if:
    condition: { eq: [sw6, 1] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL empty starts_with empty"] }]

- decl: [sw7, i32]
- set:  [sw7, { call: [empty_s.starts_with, "x"] }]
- print: ["empty starts_with x: ${sw7}"]
- if:
    condition: { eq: [sw7, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL empty starts_with x"] }]

# ── index_of ─────────────────────────────────────────────────────────────────

- decl: [idx1, i32]
- set:  [idx1, { call: [var_s.index_of, "abc"] }]
- print: ["index_of abc: ${idx1}"]
- if:
    condition: { eq: [idx1, 7] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL index_of found"] }]

- decl: [idx2, i32]
- set:  [idx2, { call: [var_s.index_of, "xyz"] }]
- print: ["index_of xyz: ${idx2}"]
- if:
    condition: { eq: [idx2, -1] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL index_of not found"] }]

- decl: [idx3, i32]
- set:  [idx3, { call: [var_s.index_of, "Bearer"] }]
- print: ["index_of Bearer: ${idx3}"]
- if:
    condition: { eq: [idx3, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL index_of prefix"] }]

- decl: [idx4, i32]
- set:  [idx4, { call: [var_s.index_of, "123"] }]
- print: ["index_of 123: ${idx4}"]
- if:
    condition: { eq: [idx4, 10] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL index_of suffix"] }]

- decl: [idx5, i32]
- set:  [idx5, { call: [var_s.index_of, " "] }]
- print: ["index_of space: ${idx5}"]
- if:
    condition: { eq: [idx5, 6] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL index_of space"] }]

- decl: [idx6, i32]
- set:  [idx6, { call: [var_s.index_of, "a"] }]
- print: ["index_of a: ${idx6}"]
- if:
    condition: { eq: [idx6, 2] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL index_of single char"] }]

- decl: [idx7, i32]
- set:  [idx7, { call: [var_s.index_of, ""] }]
- print: ["index_of empty: ${idx7}"]
- if:
    condition: { eq: [idx7, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL index_of empty"] }]

- decl: [idx8, i32]
- set:  [idx8, { call: [empty_s.index_of, ""] }]
- print: ["empty index_of empty: ${idx8}"]
- if:
    condition: { eq: [idx8, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL empty index_of empty"] }]

- decl: [idx9, i32]
- set:  [idx9, { call: [empty_s.index_of, "x"] }]
- print: ["empty index_of x: ${idx9}"]
- if:
    condition: { eq: [idx9, -1] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL empty index_of x"] }]

# ── parse_i32 ──────────────────────────────────────────────────────────────

- decl: [pi1, string, "42"]
- decl: [pi1_val, i32, { call: [pi1.parse_i32] }]
- print: ["parse_i32 '42': ${pi1_val}"]
- if:
    condition: { eq: [pi1_val, 42] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_i32 42"] }]

- decl: [pi2, string, "-7"]
- decl: [pi2_val, i32, { call: [pi2.parse_i32] }]
- print: ["parse_i32 '-7': ${pi2_val}"]
- if:
    condition: { eq: [pi2_val, -7] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_i32 -7"] }]

- decl: [pi3, string, "0"]
- decl: [pi3_val, i32, { call: [pi3.parse_i32] }]
- print: ["parse_i32 '0': ${pi3_val}"]
- if:
    condition: { eq: [pi3_val, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_i32 0"] }]

- decl: [pi4, string, "hello"]
- decl: [pi4_val, i32, { call: [pi4.parse_i32] }]
- print: ["parse_i32 'hello': ${pi4_val}"]
- if:
    condition: { eq: [pi4_val, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_i32 non-numeric"] }]

- decl: [pi5, string, "  123  "]
- decl: [pi5_val, i32, { call: [pi5.parse_i32] }]
- print: ["parse_i32 '  123  ': ${pi5_val}"]
- if:
    condition: { eq: [pi5_val, 123] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_i32 whitespace"] }]

- decl: [pi6, string, ""]
- decl: [pi6_val, i32, { call: [pi6.parse_i32] }]
- print: ["parse_i32 '': ${pi6_val}"]
- if:
    condition: { eq: [pi6_val, 0] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_i32 empty"] }]

# ── parse_f32 ──────────────────────────────────────────────────────────────

- decl: [pf1, string, "3.14"]
- decl: [pf1_val, f32, { call: [pf1.parse_f32] }]
- print: ["parse_f32 '3.14': ${pf1_val}"]
# Check: 3.13 < pf1_val < 3.15 (float precision)
- if:
    condition: { "&&": [{ ">": [pf1_val, 3.13] }, { "<": [pf1_val, 3.15] }] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_f32 3.14"] }]

- decl: [pf2, string, "-0.5"]
- decl: [pf2_val, f32, { call: [pf2.parse_f32] }]
- print: ["parse_f32 '-0.5': ${pf2_val}"]
- if:
    condition: { "&&": [{ ">": [pf2_val, -0.51] }, { "<": [pf2_val, -0.49] }] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_f32 -0.5"] }]

- decl: [pf3, string, "0.0"]
- decl: [pf3_val, f32, { call: [pf3.parse_f32] }]
- print: ["parse_f32 '0.0': ${pf3_val}"]
- if:
    condition: { "&&": [{ ">=": [pf3_val, -0.01] }, { "<=": [pf3_val, 0.01] }] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_f32 0.0"] }]

- decl: [pf4, string, "abc"]
- decl: [pf4_val, f32, { call: [pf4.parse_f32] }]
- print: ["parse_f32 'abc': ${pf4_val}"]
- if:
    condition: { "&&": [{ ">=": [pf4_val, -0.01] }, { "<=": [pf4_val, 0.01] }] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_f32 non-numeric"] }]

- decl: [pf5, string, ""]
- decl: [pf5_val, f32, { call: [pf5.parse_f32] }]
- print: ["parse_f32 '': ${pf5_val}"]
- if:
    condition: { "&&": [{ ">=": [pf5_val, -0.01] }, { "<=": [pf5_val, 0.01] }] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_f32 empty"] }]

- decl: [pf6, string, "1.5e2"]
- decl: [pf6_val, f32, { call: [pf6.parse_f32] }]
- print: ["parse_f32 '1.5e2': ${pf6_val}"]
- if:
    condition: { "&&": [{ ">": [pf6_val, 149.0] }, { "<": [pf6_val, 151.0] }] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_f32 scientific"] }]

- decl: [pf7, string, "100"]
- decl: [pf7_val, f32, { call: [pf7.parse_f32] }]
- print: ["parse_f32 '100': ${pf7_val}"]
- if:
    condition: { "&&": [{ ">": [pf7_val, 99.0] }, { "<": [pf7_val, 101.0] }] }
    then: [{ set: [pass, { +: [pass, 1] }] }]
    else: [{ set: [fail, { +: [fail, 1] }] }, { print: ["FAIL parse_f32 integer string"] }]

# ── Result ───────────────────────────────────────────────────────────────────

- print: ["string methods: ${pass} passed, ${fail} failed"]
- if:
    condition: { eq: [fail, 0] }
    then:
      - call: [sys.exit, 0]
    else:
      - call: [sys.exit, 1]
