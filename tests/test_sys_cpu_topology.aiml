# SPEC: 23_system (§4.1 core_count / logical_thread_count / quota_thread_count)
# Test: host parallelism — three functions, three questions.
#   - all >= 1 (never 0 → a sizing formula must never divide by 0)
#   - core_count <= logical_thread_count (SMT can only add, never subtract)
#   - quota_thread_count <= logical_thread_count (a quota caps, it does not raise)
#   - deterministic within a process (values are cached process-wide)
#   - the spec sizing formula delivers >= 1 and <= cap
# Expected exit code: 0

- def:
    name: expect_ge
    args: [[label, string], [got, i32], [want, i32], [fails, ref<i32>]]
    body:
      - if:
          condition: { lt: [got, want] }
          then:
            - print: ["FAIL ${label}: ${got} < ${want}"]
            - store: [fails, { +: [{ '?': [fails] }, 1] }]

- def:
    name: expect_le
    args: [[label, string], [got, i32], [want, i32], [fails, ref<i32>]]
    body:
      - if:
          condition: { gt: [got, want] }
          then:
            - print: ["FAIL ${label}: ${got} > ${want}"]
            - store: [fails, { +: [{ '?': [fails] }, 1] }]

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [cores,   i32, { call: [sys.core_count] }]
      - decl: [threads, i32, { call: [sys.logical_thread_count] }]
      - decl: [budget,  i32, { call: [sys.quota_thread_count] }]

      # lower bound 1 — normative, so that sizing never divides by 0.
      - call: [expect_ge, "core_count >= 1", cores, 1, {'&': [fails]}]
      - call: [expect_ge, "logical_thread_count >= 1", threads, 1, {'&': [fails]}]
      - call: [expect_ge, "quota_thread_count >= 1", budget, 1, {'&': [fails]}]

      # relations: SMT can only deliver more threads than cores, a quota caps.
      - call: [expect_le, "core_count <= logical_thread_count", cores, threads, {'&': [fails]}]
      - call: [expect_le, "quota_thread_count <= logical_thread_count", budget, threads, {'&': [fails]}]

      # cached process-wide → the second call returns the same value.
      - decl: [again, i32, { call: [sys.logical_thread_count] }]
      - if:
          condition: { neq: [again, threads] }
          then:
            - print: ["FAIL logical_thread_count not deterministic: ${threads} then ${again}"]
            - set: [fails, { +: [fails, 1] }]

      # sizing formula from spec/23 §4.1: one worker per 4 units, capped.
      - decl: [units, i32, 9]
      - decl: [want, i32, { /: [{ +: [units, 3] }, 4] }]
      - decl: [workers, i32, want]
      - if: { condition: { gt: [want, budget] }, then: [{ set: [workers, budget] }] }
      - if: { condition: { lt: [workers, 1] }, then: [{ set: [workers, 1] }] }
      - call: [expect_ge, "Sizing >= 1 Worker", workers, 1, {'&': [fails]}]
      - call: [expect_le, "Sizing <= cap", workers, budget, {'&': [fails]}]
      - if:
          condition: { '&&': [{ gte: [budget, 3] }, { neq: [workers, 3] }] }
          then:
            - print: ["FAIL ceil(9/4) expected 3 workers, is ${workers}"]
            - set: [fails, { +: [fails, 1] }]

      - if:
          condition: { eq: [fails, 0] }
          then:
            - print: ["PASS test_sys_cpu_topology: ${cores} cores, ${threads} logical threads, budget ${budget} → ${workers} workers"]
            - return: 0
      - print: ["FAIL test_sys_cpu_topology: ${fails} errors"]
      - return: 1
