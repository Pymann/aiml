# SPEC: 23_system
# Expected exit code: 1
# static-check: off
#
# Negative (spec/23 §5.1): `sys.exe` takes argv as `list<string>`.
#
# Until 2026-10-17 a string as the first argument was NOT an error but a
# SIGSEGV: a string is an `i8*` in LLVM too, so it slipped through the
# builtin's pointer switch and was read by the runtime as a `GenericList*`.
# Found because a probe of our own had the argument the wrong way round —
# a crash is the wrong answer to a type error.
#
# Two cases, both must give a diagnostic:
#   1. a string literal
#   2. a variable with a wrong declared type

- def:
    name: main
    return: i32
    body:
      - decl: [proc_a, process, { call: [sys.exe, "id"] }]
      - decl: [not_argv, string, "id"]
      - decl: [proc_b, process, { call: [sys.exe, not_argv] }]
      - return: [0]
