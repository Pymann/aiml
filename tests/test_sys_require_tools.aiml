# SPEC: 23_system §5.6
# `sys.require_tools`: what the environment must bring along — in ONE answer.
#
# Checked against things that exist on every Linux (`sh`), and against
# a name that certainly does not exist.  And the order of the answer:
# EVERYTHING missing, not the first (F23-40) — otherwise a user needs three
# runs for three missing packages.
#
# Expected exit code: 0

- def:
    name: expect
    static_off: ["str_cmp"]
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ call: [log.info, "  ok   ${what}"] }, { return: 0 }]
      - call: [log.info, "  FAIL ${what}"]
      - return: 1

- def:
    name: has_text
    static_off: ["str_cmp"]
    args: [[hay, string], [needle, string]]
    return: i32
    body:
      - if: { condition: { gt: [{ call: [hay.index_of, needle] }, -1] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # present: the shell exists everywhere.
      - decl: [ok_one, string, { call: [sys.require_tools, "sh"] }]
      - set: [fails, { +: [fails, { call: [expect, "present tool → empty answer", { eq: [ok_one.len, 0] }] }] }]

      # not present — and the name is in the answer.
      - decl: [miss_one, string, { call: [sys.require_tools, "gibtesnicht_xyz"] }]
      - set: [fails, { +: [fails, { call: [expect, "missing tool is named", { call: [has_text, miss_one, "gibtesnicht_xyz"] }] }] }]

      # EVERYTHING missing, not the first (F23-40).
      - decl: [miss_two, string, { call: [sys.require_tools, "gibtesnicht_a,sh,gibtesnicht_b"] }]
      - set: [fails, { +: [fails, { call: [expect, "both missing ones are in it", { '&&': [{ call: [has_text, miss_two, "gibtesnicht_a"] }, { call: [has_text, miss_two, "gibtesnicht_b"] }] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the present one is not", { eq: [{ call: [has_text, miss_two, "sh"] }, 0] }] }] }]

      # Version: checked against `python3`, because it prints a number.
      # `sh` is NO good for this: dash knows no `--version` and then rightly
      # counts as unsatisfied (F23-42) — the check does not guess.
      - decl: [ver_ok, string, { call: [sys.require_tools, "python3>=3"] }]
      - set: [fails, { +: [fails, { call: [expect, "a satisfied minimum version stays silent", { eq: [ver_ok.len, 0] }] }] }]
      - decl: [ver_bad, string, { call: [sys.require_tools, "python3>=9999"] }]
      - set: [fails, { +: [fails, { call: [expect, "missed minimum version is named", { call: [has_text, ver_bad, "python3>=9999"] }] }] }]
      # And the case without a number: named, not guessed (F23-42).
      - decl: [ver_none, string, { call: [sys.require_tools, "sh>=1"] }]
      - set: [fails, { +: [fails, { call: [expect, "without a version output it counts as unsatisfied", { call: [has_text, ver_none, "sh>=1"] }] }] }]

      # Empty setting: nothing to check, nothing to report.
      - decl: [nix, string, { call: [sys.require_tools, ""] }]
      - set: [fails, { +: [fails, { call: [expect, "empty requirement = empty answer", { eq: [nix.len, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ call: [log.info, "test_sys_require_tools FAIL (${fails})"] }, { return: 1 }]
      - call: [log.info, "test_sys_require_tools PASS"]
      - return: 0
