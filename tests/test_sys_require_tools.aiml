# SPEC: 23_system §5.6
# `sys.require_tools`: was die Umgebung mitbringen muss — in EINER Antwort.
#
# Geprueft wird gegen Dinge, die es auf jedem Linux gibt (`sh`), und gegen
# einen Namen, den es sicher nicht gibt.  Und die Reihenfolge der Antwort:
# ALLES Fehlende, nicht das erste (F23-40) — sonst braucht ein Nutzer drei
# Laeufe fuer drei fehlende Pakete.
#
# Expected exit code: 0

- def:
    name: expect
    static_off: ["str_cmp"]
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ call: [log.info, "  ok   ${what}"] }, { return: 0 }]
      - call: [log.info, "  FAIL ${what}"]
      - return: 1

- def:
    name: has_text
    static_off: ["str_cmp"]
    args: [[hay, string], [needle, string]]
    return: i32
    body:
      - if: { condition: { gt: [{ call: [hay.index_of, needle] }, -1] }, then: [{ return: 1 }] }
      - return: 0

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # Da: die Shell gibt es ueberall.
      - decl: [ok_one, string, { call: [sys.require_tools, "sh"] }]
      - set: [fails, { +: [fails, { call: [expect, "vorhandenes Werkzeug → leere Antwort", { eq: [ok_one.len, 0] }] }] }]

      # Nicht da — und der Name steht in der Antwort.
      - decl: [miss_one, string, { call: [sys.require_tools, "gibtesnicht_xyz"] }]
      - set: [fails, { +: [fails, { call: [expect, "fehlendes Werkzeug wird genannt", { call: [has_text, miss_one, "gibtesnicht_xyz"] }] }] }]

      # ALLES Fehlende, nicht das erste (F23-40).
      - decl: [miss_two, string, { call: [sys.require_tools, "gibtesnicht_a,sh,gibtesnicht_b"] }]
      - set: [fails, { +: [fails, { call: [expect, "beide fehlenden stehen drin", { '&&': [{ call: [has_text, miss_two, "gibtesnicht_a"] }, { call: [has_text, miss_two, "gibtesnicht_b"] }] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "das vorhandene nicht", { eq: [{ call: [has_text, miss_two, "sh"] }, 0] }] }] }]

      # Version: geprueft wird gegen `python3`, weil es eine Zahl ausgibt.
      # `sh` taugt dafuer NICHT: dash kennt kein `--version` und gilt dann
      # berechtigterweise als unerfuellt (F23-42) — die Pruefung raet nicht.
      - decl: [ver_ok, string, { call: [sys.require_tools, "python3>=3"] }]
      - set: [fails, { +: [fails, { call: [expect, "erfuellte Mindestversion schweigt", { eq: [ver_ok.len, 0] }] }] }]
      - decl: [ver_bad, string, { call: [sys.require_tools, "python3>=9999"] }]
      - set: [fails, { +: [fails, { call: [expect, "verfehlte Mindestversion wird genannt", { call: [has_text, ver_bad, "python3>=9999"] }] }] }]
      # Und der Fall ohne Zahl: genannt, nicht geraten (F23-42).
      - decl: [ver_none, string, { call: [sys.require_tools, "sh>=1"] }]
      - set: [fails, { +: [fails, { call: [expect, "ohne Versionsausgabe gilt es als unerfuellt", { call: [has_text, ver_none, "sh>=1"] }] }] }]

      # Leere Angabe: nichts zu pruefen, nichts zu melden.
      - decl: [nix, string, { call: [sys.require_tools, ""] }]
      - set: [fails, { +: [fails, { call: [expect, "leere Anforderung = leere Antwort", { eq: [nix.len, 0] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ call: [log.info, "test_sys_require_tools FAIL (${fails})"] }, { return: 1 }]
      - call: [log.info, "test_sys_require_tools PASS"]
      - return: 0
