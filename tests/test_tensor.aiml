# SPEC?: 50_tensor_runtime   # derived from the file name, to be confirmed
# Tests for Tensor Runtime: Lifecycle, Ops, Autograd, Adam
# Expected exit code: 0

# ── Phase A: Lifecycle + Shape ───────────────────────────────────────────────

- decl: [var_t1, tensor]
- set: [var_t1, { call: [tensor.zeros, 2, 3] }]
- print: ["A1 ndim:"]
- decl: [var_nd, i32]
- set: [var_nd, { call: [var_t1.ndim] }]
- print: ["${var_nd}"]

- decl: [var_sz, i32]
- set: [var_sz, { call: [var_t1.size] }]
- print: ["A2 size: ${var_sz}"]

- decl: [var_s0, i32]
- set: [var_s0, { call: [var_t1.shape, 0] }]
- decl: [var_s1, i32]
- set: [var_s1, { call: [var_t1.shape, 1] }]
- print: ["A3 shape: ${var_s0} ${var_s1}"]

# item access
- call: [var_t1.set, 0, 1.5]
- call: [var_t1.set, 3, 2.5]
- decl: [var_v0, f32]
- set: [var_v0, { call: [var_t1.get, 0] }]
- decl: [var_v3, f32]
- set: [var_v3, { call: [var_t1.get, 3] }]
- print: ["A4 vals: ${var_v0} ${var_v3}"]

# ones
- decl: [var_t2, tensor]
- set: [var_t2, { call: [tensor.ones, 3] }]
- decl: [ones_item, f32]
- set: [ones_item, { call: [var_t2.item] }]
# item() should fail for non-scalar but let's test size
- decl: [ones_sz, i32]
- set: [ones_sz, { call: [var_t2.size] }]
- print: ["A5 ones size: ${ones_sz}"]

# clone
- decl: [var_t3, tensor]
- set: [var_t3, { call: [var_t1.clone] }]
- decl: [clone_v, f32]
- set: [clone_v, { call: [var_t3.get, 0] }]
- print: ["A6 clone[0]: ${clone_v}"]

# fill
- call: [var_t3.fill, 7.0]
- decl: [fill_v, f32]
- set: [fill_v, { call: [var_t3.get, 0] }]
- print: ["A7 fill: ${fill_v}"]

# free
- call: [var_t3.free]
- call: [var_t2.free]
- print: ["A8 freed"]

# ── Phase B: Numerical Ops ───────────────────────────────────────────────────

# Create two 2x2 tensors and test add/sub/mul
- decl: [var_a, tensor]
- set: [var_a, { call: [tensor.ones, 2, 2] }]
- call: [tensor.fill, var_a, 2.0]

- decl: [var_b, tensor]
- set: [var_b, { call: [tensor.ones, 2, 2] }]
- call: [tensor.fill, var_b, 3.0]

# add
- decl: [var_c, tensor]
- set: [var_c, { call: [tensor.add, var_a, var_b] }]
- decl: [add_v, f32]
- set: [add_v, { call: [var_c.get, 0] }]
- print: ["B1 add: ${add_v}"]
- call: [var_c.free]

# sub
- set: [var_c, { call: [tensor.sub, var_a, var_b] }]
- decl: [sub_v, f32]
- set: [sub_v, { call: [var_c.get, 0] }]
- print: ["B2 sub: ${sub_v}"]
- call: [var_c.free]

# mul (hadamard)
- set: [var_c, { call: [tensor.mul, var_a, var_b] }]
- decl: [mul_v, f32]
- set: [mul_v, { call: [var_c.get, 0] }]
- print: ["B3 mul: ${mul_v}"]
- call: [var_c.free]

# mul_scalar
- set: [var_c, { call: [tensor.mul_scalar, var_a, 0.5] }]
- decl: [muls_v, f32]
- set: [muls_v, { call: [var_c.get, 0] }]
- print: ["B4 mul_scalar: ${muls_v}"]
- call: [var_c.free]

# neg
- set: [var_c, { call: [tensor.neg, var_a] }]
- decl: [neg_v, f32]
- set: [neg_v, { call: [var_c.get, 0] }]
- print: ["B5 neg: ${neg_v}"]
- call: [var_c.free]

# matmul 2x2 @ 2x2
- set: [var_c, { call: [tensor.matmul, var_a, var_b] }]
- decl: [mm_v, f32]
- set: [mm_v, { call: [var_c.get, 0] }]
- print: ["B6 matmul: ${mm_v}"]
- call: [var_c.free]

# sum (all)
- set: [var_c, { call: [tensor.sum, var_a, -1] }]
- decl: [sum_v, f32]
- set: [sum_v, { call: [var_c.item] }]
- print: ["B7 sum_all: ${sum_v}"]
- call: [var_c.free]

# mean (all)
- set: [var_c, { call: [tensor.mean, var_a, -1] }]
- decl: [mean_v, f32]
- set: [mean_v, { call: [var_c.item] }]
- print: ["B8 mean_all: ${mean_v}"]
- call: [var_c.free]

# relu
- call: [tensor.fill, var_a, -1.0]
- call: [var_a.set, 0, 2.0]
- set: [var_c, { call: [tensor.relu, var_a] }]
- decl: [relu0, f32]
- set: [relu0, { call: [var_c.get, 0] }]
- decl: [relu1, f32]
- set: [relu1, { call: [var_c.get, 1] }]
- print: ["B9 relu: ${relu0} ${relu1}"]
- call: [var_c.free]

# exp
- call: [tensor.fill, var_a, 0.0]
- set: [var_c, { call: [tensor.exp, var_a] }]
- decl: [exp_v, f32]
- set: [exp_v, { call: [var_c.get, 0] }]
- print: ["B10 exp(0): ${exp_v}"]
- call: [var_c.free]

# softmax (1D-like via 2x2, dim=-1)
- call: [tensor.fill, var_a, 1.0]
- set: [var_c, { call: [tensor.softmax, var_a, -1] }]
- decl: [sm_v, f32]
- set: [sm_v, { call: [var_c.get, 0] }]
- print: ["B11 softmax: ${sm_v}"]
- call: [var_c.free]

# argmax_scalar
- call: [tensor.fill, var_a, 1.0]
- call: [var_a.set, 2, 9.0]
- decl: [var_am, i32]
- set: [var_am, { call: [tensor.argmax_scalar, var_a] }]
- print: ["B12 argmax: ${var_am}"]

- call: [var_a.free]
- call: [var_b.free]
- print: ["B DONE"]

# ── Phase C: Autograd ────────────────────────────────────────────────────────

- call: [tensor.begin_graph]

# Create parameters with grad
- decl: [var_w, tensor]
- set: [var_w, { call: [tensor.ones, 2, 2] }]
- call: [var_w.set_requires_grad, 1]

# Forward: var_y = var_w * var_w  (element-wise)
- decl: [var_y, tensor]
- set: [var_y, { call: [tensor.mul, var_w, var_w] }]

# loss = sum(var_y)
- decl: [loss, tensor]
- set: [loss, { call: [tensor.sum, var_y, -1] }]

# Backward
- call: [tensor.backward, loss]

# grad(var_w) should be 2*var_w = 2*1 = 2.0
- decl: [var_g, tensor]
- set: [var_g, { call: [var_w.grad] }]
- decl: [var_gv, f32]
- set: [var_gv, { call: [var_g.get, 0] }]
- print: ["C1 grad: ${var_gv}"]

# Another test: var_y = var_a + var_b, loss = sum(var_y)
- call: [tensor.begin_graph]
- decl: [var_pa, tensor]
- set: [var_pa, { call: [tensor.ones, 3] }]
- call: [var_pa.set_requires_grad, 1]
- call: [tensor.fill, var_pa, 3.0]

- decl: [var_pb, tensor]
- set: [var_pb, { call: [tensor.ones, 3] }]
- call: [var_pb.set_requires_grad, 1]
- call: [tensor.fill, var_pb, 5.0]

- decl: [var_pc, tensor]
- set: [var_pc, { call: [tensor.add, var_pa, var_pb] }]
- decl: [loss2, tensor]
- set: [loss2, { call: [tensor.sum, var_pc, -1] }]
- call: [tensor.backward, loss2]

# grad(var_pa) = 1, grad(var_pb) = 1 (add passes gradient through)
- decl: [var_ga, tensor]
- set: [var_ga, { call: [var_pa.grad] }]
- decl: [gva, f32]
- set: [gva, { call: [var_ga.get, 0] }]
- print: ["C2 grad_add_a: ${gva}"]

- decl: [var_gb, tensor]
- set: [var_gb, { call: [var_pb.grad] }]
- decl: [gvb, f32]
- set: [gvb, { call: [var_gb.get, 0] }]
- print: ["C3 grad_add_b: ${gvb}"]

# matmul gradient: var_y = var_a @ var_b, loss = sum(var_y)
- call: [tensor.begin_graph]
- decl: [var_ma, tensor]
- set: [var_ma, { call: [tensor.ones, 2, 3] }]
- call: [var_ma.set_requires_grad, 1]

- decl: [var_mb, tensor]
- set: [var_mb, { call: [tensor.ones, 3, 2] }]
- call: [var_mb.set_requires_grad, 1]

- decl: [var_mc, tensor]
- set: [var_mc, { call: [tensor.matmul, var_ma, var_mb] }]
- decl: [loss3, tensor]
- set: [loss3, { call: [tensor.sum, var_mc, -1] }]
- call: [tensor.backward, loss3]

# grad(var_ma) = dl/dmc @ var_mb^T = ones(2,2) @ ones(2,3) = 2*ones(2,3)
# Actually: dl/dmc = ones(2,2), var_mb^T = ones(2,3), matmul = sum over k of 1*1 = 2 for each element
# grad(var_ma) should be 2.0 everywhere (shape 2x3)
- decl: [gma, tensor]
- set: [gma, { call: [var_ma.grad] }]
- decl: [gma_v, f32]
- set: [gma_v, { call: [gma.get, 0] }]
- print: ["C4 grad_matmul_a: ${gma_v}"]

# grad(var_mb) = var_ma^T @ dl/dmc = ones(3,2) @ ones(2,2) = 2*ones(3,2)
- decl: [gmb, tensor]
- set: [gmb, { call: [var_mb.grad] }]
- decl: [gmb_v, f32]
- set: [gmb_v, { call: [gmb.get, 0] }]
- print: ["C5 grad_matmul_b: ${gmb_v}"]

# relu gradient
- call: [tensor.begin_graph]
- decl: [var_rx, tensor]
- set: [var_rx, { call: [tensor.ones, 4] }]
- call: [var_rx.set_requires_grad, 1]
- call: [var_rx.set, 0, -1.0]
- call: [var_rx.set, 1, 2.0]
- call: [var_rx.set, 2, -3.0]
- call: [var_rx.set, 3, 4.0]

- decl: [var_ry, tensor]
- set: [var_ry, { call: [tensor.relu, var_rx] }]
- decl: [rloss, tensor]
- set: [rloss, { call: [tensor.sum, var_ry, -1] }]
- call: [tensor.backward, rloss]

- decl: [grx, tensor]
- set: [grx, { call: [var_rx.grad] }]
# grad should be: 0 1 0 1 (relu derivative: 0 where x<0, 1 where x>0)
- decl: [gr0, f32]
- set: [gr0, { call: [grx.get, 0] }]
- decl: [gr1, f32]
- set: [gr1, { call: [grx.get, 1] }]
- decl: [gr2, f32]
- set: [gr2, { call: [grx.get, 2] }]
- decl: [gr3, f32]
- set: [gr3, { call: [grx.get, 3] }]
- print: ["C6 relu_grad: ${gr0} ${gr1} ${gr2} ${gr3}"]

- print: ["C DONE"]

# ── Phase D: Adam Optimizer ──────────────────────────────────────────────────

- call: [tensor.begin_graph]

- decl: [param, tensor]
- set: [param, { call: [tensor.ones, 4] }]
- call: [param.set_requires_grad, 1]
- call: [tensor.fill, param, 5.0]

# m and v state for Adam
- decl: [adam_m, tensor]
- set: [adam_m, { call: [tensor.zeros, 4] }]
- decl: [adam_v, tensor]
- set: [adam_v, { call: [tensor.zeros, 4] }]

# Simple loss = sum(param^2) → grad = 2*param
- decl: [var_p2, tensor]
- set: [var_p2, { call: [tensor.mul, param, param] }]
- decl: [adam_loss, tensor]
- set: [adam_loss, { call: [tensor.sum, var_p2, -1] }]
- call: [tensor.backward, adam_loss]

# Adam step
- call: [tensor.adam_step, param, adam_m, adam_v, 0.01, 0.9, 0.999, 0.00000001, 1]

# After one Adam step, param should have decreased
- decl: [p_after, f32]
- set: [p_after, { call: [param.get, 0] }]
- print: ["D1 param after adam: ${p_after}"]

# Do var_a few more steps to see convergence
- decl: [step, i32]
- set: [step, 2]
- while:
    cond: { "<": [step, 11] }
    body:
      - call: [param.zero_grad]
      - call: [tensor.begin_graph]
      - set: [var_p2, { call: [tensor.mul, param, param] }]
      - set: [adam_loss, { call: [tensor.sum, var_p2, -1] }]
      - call: [tensor.backward, adam_loss]
      - call: [tensor.adam_step, param, adam_m, adam_v, 0.01, 0.9, 0.999, 0.00000001, step]
      - set: [step, { "+": [step, 1] }]

- decl: [p_final, f32]
- set: [p_final, { call: [param.get, 0] }]
- print: ["D2 param after 10 steps: ${p_final}"]

# Verify param is closer to 0 than initial 5.0
- print: ["D DONE"]

- print: ["ALL TESTS PASSED"]
