# spec/50 §14.1/§15: who owns the Adam state (m, v) between the steps?
#
# Two cases, two responsibilities:
#
#  (1) The first step only comes AFTER several `begin_graph` (a trainer
#      that accumulates gradients over a batch).  Until then m/v are nothing
#      but tensors of their own and are collected -- the caller MUST mark them with
#      `keep`, like every other tensor before the loop.
#
#  (2) After a step a long stretch without a step follows (a
#      MEASUREMENT LOOP: many `begin_graph`, no backward).  Here the
#      runtime is responsible: `adam_step` marks m/v as `keep`.  Before,
#      it only kept the epoch fresh, the state went stale after two
#      passes and the next step read freed memory
#      (SIGSEGV in adam_step, 2026-11-21 on the chance head: 6856 measurement rows
#      between epoch 1 and 2).

- def:
    name: main
    args: []
    return: i32
    body:
      - decl: [fehlt, i32, 0]

      # ── case 2: step, then a long measurement stretch, then step ────────────
      - decl: [gew, tensor, { call: [tensor.randn_ex, 0.0, 0.1, 4, 3] }]
      - call: [gew.set_requires_grad, 1]
      - decl: [mom, tensor, { call: [tensor.zeros, 4, 3] }]
      - decl: [vel, tensor, { call: [tensor.zeros, 4, 3] }]
      - decl: [ziel, tensor, { call: [tensor.zeros, 1, 3] }]
      - call: [ziel.keep]
      - idx: [ziel, 0, 1.0]
      - decl: [ein, tensor, { call: [tensor.zeros, 1, 4] }]
      - call: [ein.keep]
      - idx: [ein, 0, 1.0]

      - call: [tensor.begin_graph]
      - decl: [aus1, tensor, { call: [tensor.matmul, ein, gew] }]
      - decl: [feh1, tensor, { call: [tensor.sub, aus1, ziel] }]
      - decl: [qua1, tensor, { call: [tensor.mul, feh1, feh1] }]
      - call: [tensor.backward, qua1]
      - decl: [verlust_erst, f32, { at: [qua1, 0] }]
      - call: [tensor.adam_step, gew, mom, vel, 0.05, 0.9, 0.999, 0.00000001, 1]
      - call: [gew.zero_grad]

      # measurement stretch: 50 passes, no step.
      - decl: [mess, i32, 0]
      - while:
          condition: { lt: [mess, 50] }
          body:
            - set: [mess, { "+": [mess, 1] }]
            - call: [tensor.begin_graph]
            - decl: [aus_m, tensor, { call: [tensor.matmul, ein, gew] }]
            - decl: [feh_m, tensor, { call: [tensor.sub, aus_m, ziel] }]

      # This is where it died: m/v had been collected and freed.
      - call: [tensor.begin_graph]
      - decl: [aus2, tensor, { call: [tensor.matmul, ein, gew] }]
      - decl: [feh2, tensor, { call: [tensor.sub, aus2, ziel] }]
      - decl: [qua2, tensor, { call: [tensor.mul, feh2, feh2] }]
      - call: [tensor.backward, qua2]
      - decl: [verlust_zwei, f32, { at: [qua2, 0] }]
      - call: [tensor.adam_step, gew, mom, vel, 0.05, 0.9, 0.999, 0.00000001, 2]
      - call: [gew.zero_grad]
      - if:
          condition: { gte: [verlust_zwei, verlust_erst] }
          then:
            - call: [log.error, "FAIL measurement stretch: ${verlust_erst} -> ${verlust_zwei}"]
            - set: [fehlt, { "+": [fehlt, 1] }]
      # A zeroed momentum would be a freshly created substitute -- i.e. the old
      # bug without a crash.
      - decl: [m_null, i32, 0]
      - decl: [pos_m, i32, 0]
      - while:
          condition: { lt: [pos_m, 12] }
          body:
            - decl: [wert_m, f32, { at: [mom, pos_m] }]
            - if: { condition: { eq: [wert_m, 0.0] }, then: [{ set: [m_null, { "+": [m_null, 1] }] }] }
            - set: [pos_m, { "+": [pos_m, 1] }]
      - if:
          condition: { eq: [m_null, 12] }
          then:
            - call: [log.error, "FAIL the momentum is empty -- m/v were replaced"]
            - set: [fehlt, { "+": [fehlt, 1] }]

      # ── case 1: batch, first step only after 8 passes ─────────────────────
      - decl: [gew_b, tensor, { call: [tensor.randn_ex, 0.0, 0.1, 4, 3] }]
      - call: [gew_b.set_requires_grad, 1]
      - decl: [mom_b, tensor, { call: [tensor.zeros, 4, 3] }]
      - decl: [vel_b, tensor, { call: [tensor.zeros, 4, 3] }]
      - call: [mom_b.keep]
      - call: [vel_b.keep]
      - decl: [schritt, i32, 0]
      - decl: [runde, i32, 0]
      - decl: [erste_summe, f32, 0.0]
      - decl: [letzte_summe, f32, 0.0]
      - while:
          condition: { lt: [runde, 5] }
          body:
            - set: [runde, { "+": [runde, 1] }]
            - decl: [im_stapel, i32, 0]
            - decl: [summe, f32, 0.0]
            - while:
                condition: { lt: [im_stapel, 8] }
                body:
                  - set: [im_stapel, { "+": [im_stapel, 1] }]
                  - call: [tensor.begin_graph]
                  - decl: [aus_s, tensor, { call: [tensor.matmul, ein, gew_b] }]
                  - decl: [feh_s, tensor, { call: [tensor.sub, aus_s, ziel] }]
                  - decl: [qua_s, tensor, { call: [tensor.mul, feh_s, feh_s] }]
                  - call: [tensor.backward, qua_s]
                  - set: [summe, { "+": [summe, { at: [qua_s, 0] }] }]
            - set: [schritt, { "+": [schritt, 1] }]
            - call: [tensor.adam_step, gew_b, mom_b, vel_b, 0.05, 0.9, 0.999, 0.00000001, schritt]
            - call: [gew_b.zero_grad]
            - if: { condition: { eq: [runde, 1] }, then: [{ set: [erste_summe, summe] }] }
            - set: [letzte_summe, summe]
      - if:
          condition: { gte: [letzte_summe, erste_summe] }
          then:
            - call: [log.error, "FAIL batch: ${erste_summe} -> ${letzte_summe}"]
            - set: [fehlt, { "+": [fehlt, 1] }]

      - if: { condition: { gt: [fehlt, 0] }, then: [{ return: 1 }] }
      - call: [log.info, "test_tensor_adam_batched: all good (measurement stretch ${verlust_erst}->${verlust_zwei}, batch ${erste_summe}->${letzte_summe})"]
      - return: 0
