# SPEC?: 50_tensor_runtime   # aus dem Dateinamen, zu bestaetigen
# Tests for tensor.div (elementwise division)
# Expected exit code: 0

- decl: [var_a, tensor, { call: [tensor.zeros, 2, 2] }]
- call: [var_a.set, 0, 4.0]
- call: [var_a.set, 1, 9.0]
- call: [var_a.set, 2, 16.0]
- call: [var_a.set, 3, 25.0]

- decl: [var_b, tensor, { call: [tensor.zeros, 2, 2] }]
- call: [var_b.set, 0, 2.0]
- call: [var_b.set, 1, 3.0]
- call: [var_b.set, 2, 4.0]
- call: [var_b.set, 3, 5.0]

- decl: [var_c, tensor, { call: [tensor.div, var_a, var_b] }]

# var_c should be [2.0, 3.0, 4.0, 5.0]
- decl: [var_c0, f32, { call: [var_c.get, 0] }]
- decl: [var_c1, f32, { call: [var_c.get, 1] }]
- decl: [var_c2, f32, { call: [var_c.get, 2] }]
- decl: [var_c3, f32, { call: [var_c.get, 3] }]

- print: ["tensor.div result: ${var_c0} ${var_c1} ${var_c2} ${var_c3}"]

- if:
    condition: { neq: [var_c0, 2.0] }
    then:
      - print: ["FAIL: var_c[0] expected 2.0 got ${var_c0}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [var_c1, 3.0] }
    then:
      - print: ["FAIL: var_c[1] expected 3.0 got ${var_c1}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [var_c2, 4.0] }
    then:
      - print: ["FAIL: var_c[2] expected 4.0 got ${var_c2}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [var_c3, 5.0] }
    then:
      - print: ["FAIL: var_c[3] expected 5.0 got ${var_c3}"]
      - call: [sys.exit, 1]

- call: [var_a.free]
- call: [var_b.free]
- call: [var_c.free]
- print: ["tensor.div ok"]
