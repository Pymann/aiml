# SPEC?: 50_tensor_runtime   # derived from the file name, to be confirmed
# ── Test A: grad_view — gradient correct, param->data unchanged ──────────────

- call: [tensor.begin_graph]

- decl: [param, tensor, { call: [tensor.ones, 4] }]
- call: [param.set_requires_grad, 1]
- call: [tensor.fill, param, 3.0]

- decl: [view, tensor, { call: [param.grad_view] }]

- decl: [var_sq, tensor, { call: [tensor.mul, view, view] }]
- decl: [loss, tensor, { call: [tensor.sum, var_sq, -1] }]
- call: [tensor.backward, loss]

- decl: [gview, tensor, { call: [view.grad] }]
- decl: [gv0, f32, { at: [gview, 0] }]
- decl: [pv0, f32, { at: [param, 0] }]

- if:
    condition: { neq: [pv0, 3.0] }
    then:
      - print: ["FAIL A param_changed=${pv0}"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [gv0, 6.0] }
    then:
      - print: ["FAIL A grad_view_grad=${gv0} (expected 6.0)"]
      - call: [sys.exit, 1]

- call: [tensor.thread_cleanup]
- print: ["PASS A: grad correct, param unchanged"]

# ── Test B: compare grad_view vs clone — numerically identical gradient ───────

- call: [tensor.begin_graph]

- decl: [var_p2, tensor, { call: [tensor.ones, 4] }]
- call: [var_p2.set_requires_grad, 1]
- call: [tensor.fill, var_p2, 5.0]

- decl: [view2, tensor, { call: [var_p2.grad_view] }]
- decl: [sq2, tensor, { call: [tensor.mul, view2, view2] }]
- decl: [loss2, tensor, { call: [tensor.sum, sq2, -1] }]
- call: [tensor.backward, loss2]
- decl: [gview2, tensor, { call: [view2.grad] }]
- decl: [gv2, f32, { at: [gview2, 0] }]

- call: [tensor.thread_cleanup]

- call: [tensor.begin_graph]

- decl: [var_p3, tensor, { call: [tensor.ones, 4] }]
- call: [var_p3.set_requires_grad, 1]
- call: [tensor.fill, var_p3, 5.0]

- decl: [clone3, tensor, { call: [tensor.clone, var_p3] }]
- call: [clone3.set_requires_grad, 1]
- decl: [sq3, tensor, { call: [tensor.mul, clone3, clone3] }]
- decl: [loss3, tensor, { call: [tensor.sum, sq3, -1] }]
- call: [tensor.backward, loss3]
- decl: [gclone3, tensor, { call: [clone3.grad] }]
- decl: [gc3, f32, { at: [gclone3, 0] }]

- call: [tensor.thread_cleanup]

- if:
    condition: { neq: [gv2, gc3] }
    then:
      - print: ["FAIL B grad_view=${gv2} clone=${gc3} differ"]
      - call: [sys.exit, 1]

- print: ["PASS B: grad_view == clone gradient (${gv2})"]

# ── Test C: two views on the same data — separate grad buffers ──────────────

- call: [tensor.begin_graph]

- decl: [var_p4, tensor, { call: [tensor.ones, 4] }]
- call: [var_p4.set_requires_grad, 1]
- call: [tensor.fill, var_p4, 2.0]

- decl: [var_va, tensor, { call: [var_p4.grad_view] }]
- decl: [var_vb, tensor, { call: [var_p4.grad_view] }]

- decl: [prod_a, tensor, { call: [tensor.mul, var_va, var_va] }]
- decl: [loss_a, tensor, { call: [tensor.sum, prod_a, -1] }]
- call: [tensor.backward, loss_a]

- decl: [var_ga, tensor, { call: [var_va.grad] }]
- decl: [var_gb, tensor, { call: [var_vb.grad] }]
- decl: [ga0, f32, { at: [var_ga, 0] }]
- decl: [gb0, f32, { at: [var_gb, 0] }]

- if:
    condition: { neq: [ga0, 4.0] }
    then:
      - print: ["FAIL C var_va.grad=${ga0} (expected 4.0)"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [gb0, 0.0] }
    then:
      - print: ["FAIL C var_vb.grad=${gb0} (expected 0.0, var_vb not used in graph)"]
      - call: [sys.exit, 1]

- call: [tensor.thread_cleanup]
- print: ["PASS C: two views have separate grad buffers, no double-free"]

# ── Test D: begin_graph after creating the view — the view survives ──────────

- call: [tensor.begin_graph]

- decl: [var_p5, tensor, { call: [tensor.ones, 4] }]
- call: [var_p5.set_requires_grad, 1]
- call: [tensor.fill, var_p5, 7.0]

- decl: [var_v5, tensor, { call: [var_p5.grad_view] }]

- call: [tensor.begin_graph]

- decl: [pv5, f32, { at: [var_p5, 0] }]

- if:
    condition: { neq: [pv5, 7.0] }
    then:
      - print: ["FAIL D param not 7.0 after begin_graph: ${pv5}"]
      - call: [sys.exit, 1]

- decl: [sq5, tensor, { call: [tensor.mul, var_v5, var_v5] }]
- decl: [loss5, tensor, { call: [tensor.sum, sq5, -1] }]
- call: [tensor.backward, loss5]
- decl: [gv5, tensor, { call: [var_v5.grad] }]
- decl: [gv5_0, f32, { at: [gv5, 0] }]

- if:
    condition: { neq: [gv5_0, 14.0] }
    then:
      - print: ["FAIL D grad after begin_graph=${gv5_0} (expected 14.0)"]
      - call: [sys.exit, 1]

- call: [tensor.thread_cleanup]
- print: ["PASS D: view survives begin_graph, grad correct"]

- print: ["ALL PASS test_tensor_grad_view"]
