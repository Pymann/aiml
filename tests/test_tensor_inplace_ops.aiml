# SPEC?: 50_tensor_runtime   # derived from the file name, to be confirmed
# ── Test A: add_inplace — numerisch korrekt ──────────────────────────────────

- decl: [var_a, tensor, { call: [tensor.ones, 2] }]
- call: [tensor.fill, var_a, 1.0]
- decl: [var_b, tensor, { call: [tensor.ones, 2] }]
- call: [tensor.fill, var_b, 3.0]

- call: [var_a.add_inplace, var_b]

- decl: [var_a0, f32, { call: [var_a.get, 0] }]
- if:
    condition: { neq: [var_a0, 4.0] }
    then:
      - print: ["FAIL A add_inplace var_a[0]=${var_a0} (expected 4.0)"]
      - call: [sys.exit, 1]

- print: ["PASS A: add_inplace correct (${var_a0})"]

# ── Test B: scale_inplace — numerisch korrekt ────────────────────────────────

- decl: [var_c, tensor, { call: [tensor.ones, 2] }]
- call: [tensor.fill, var_c, 6.0]

- call: [var_c.scale_inplace, 0.5]

- decl: [var_c0, f32, { call: [var_c.get, 0] }]
- if:
    condition: { neq: [var_c0, 3.0] }
    then:
      - print: ["FAIL B scale_inplace var_c[0]=${var_c0} (expected 3.0)"]
      - call: [sys.exit, 1]

- print: ["PASS B: scale_inplace correct (${var_c0})"]

# ── Test C: Reduktionssequenz == tensor.add + tensor.mul_scalar ───────────────
# Inplace-Pfad: fill(0) + add_inplace(var_g0) + add_inplace(var_g1) + scale_inplace(0.5)
# Referenzpfad: tensor.add(var_g0, var_g1) + tensor.mul_scalar(sum, 0.5)

- decl: [var_g0, tensor, { call: [tensor.ones, 4] }]
- call: [tensor.fill, var_g0, 3.0]
- decl: [var_g1, tensor, { call: [tensor.ones, 4] }]
- call: [tensor.fill, var_g1, 5.0]

# Inplace-Pfad
- decl: [acc, tensor, { call: [tensor.ones, 4] }]
- call: [tensor.fill, acc, 0.0]
- call: [acc.add_inplace, var_g0]
- call: [acc.add_inplace, var_g1]
- call: [acc.scale_inplace, 0.5]
- decl: [acc0, f32, { call: [acc.get, 0] }]

# Referenzpfad
- decl: [ref_sum, tensor, { call: [tensor.add, var_g0, var_g1] }]
- decl: [ref_mean, tensor, { call: [tensor.mul_scalar, ref_sum, 0.5] }]
- decl: [ref0, f32, { call: [ref_mean.get, 0] }]

- if:
    condition: { neq: [acc0, ref0] }
    then:
      - print: ["FAIL C inplace=${acc0} ref=${ref0} differ"]
      - call: [sys.exit, 1]

- print: ["PASS C: inplace reduction == reference (${acc0})"]

# ── Test D: fill(0.0) + erneute Akkumulation korrekt ─────────────────────────

- decl: [buf, tensor, { call: [tensor.ones, 2] }]
- call: [tensor.fill, buf, 99.0]

# Erste Akkumulation
- call: [tensor.fill, buf, 0.0]
- decl: [var_x, tensor, { call: [tensor.ones, 2] }]
- call: [tensor.fill, var_x, 7.0]
- call: [buf.add_inplace, var_x]
- decl: [buf0_a, f32, { call: [buf.get, 0] }]
- if:
    condition: { neq: [buf0_a, 7.0] }
    then:
      - print: ["FAIL D first accumulation buf[0]=${buf0_a} (expected 7.0)"]
      - call: [sys.exit, 1]

# Puffer nullen + zweite Akkumulation
- call: [tensor.fill, buf, 0.0]
- decl: [var_y, tensor, { call: [tensor.ones, 2] }]
- call: [tensor.fill, var_y, 4.0]
- call: [buf.add_inplace, var_y]
- decl: [buf0_b, f32, { call: [buf.get, 0] }]
- if:
    condition: { neq: [buf0_b, 4.0] }
    then:
      - print: ["FAIL D second accumulation buf[0]=${buf0_b} (expected 4.0)"]
      - call: [sys.exit, 1]

- print: ["PASS D: fill(0)+add_inplace reuse correct (${buf0_b})"]

- print: ["ALL PASS test_tensor_inplace_ops"]
