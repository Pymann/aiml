# Tests for tensor.sha256
# Expected exit code: 0

- decl: [var_a, tensor, { call: [tensor.zeros, 2, 2] }]
- call: [var_a.set, 0, 1.0]
- call: [var_a.set, 1, 2.0]
- call: [var_a.set, 2, 3.0]
- call: [var_a.set, 3, 4.0]

- decl: [var_b, tensor, { call: [var_a.clone] }]

- decl: [var_h1, string, { call: [tensor.sha256, var_a] }]
- decl: [var_h2, string, { call: [tensor.sha256, var_b] }]
- decl: [h1_len, i32, { call: [var_h1.len] }]

- print: ["tensor sha256: ${var_h1}"]

- if:
    condition: { neq: [h1_len, 64] }
    then:
      - print: ["FAIL: tensor sha256 length must be 64 hex chars"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [var_h1, var_h2] }
    then:
      - print: ["FAIL: cloned tensors must hash identically"]
      - call: [sys.exit, 1]

- call: [var_b.set, 3, 5.0]
- decl: [var_h3, string, { call: [tensor.sha256, var_b] }]

- if:
    condition: { eq: [var_h1, var_h3] }
    then:
      - print: ["FAIL: changed tensor data must change hash"]
      - call: [sys.exit, 1]

- decl: [var_c, tensor, { call: [tensor.reshape, var_a, 4] }]
- decl: [var_h4, string, { call: [tensor.sha256, var_c] }]

- if:
    condition: { eq: [var_h1, var_h4] }
    then:
      - print: ["FAIL: changed tensor shape must change hash"]
      - call: [sys.exit, 1]

- call: [var_a.set_requires_grad, 1]
- decl: [var_h5, string, { call: [tensor.sha256, var_a] }]

- if:
    condition: { neq: [var_h1, var_h5] }
    then:
      - print: ["FAIL: autograd metadata must not affect tensor hash"]
      - call: [sys.exit, 1]

- call: [var_a.free]
- call: [var_b.free]
- call: [var_c.free]
- print: ["tensor sha256 ok"]
