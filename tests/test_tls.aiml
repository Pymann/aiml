# Tests for tls namespace + tls_socket_handle
# Expected exit code: 0

# ── Phase A: Lifecycle (no TLS traffic) ──────────────────────────────────────

# Socket creation → var_fd must be >= 0
- decl: [sock, tls_socket_handle]
- set: [sock, { call: [tls.socket] }]
- decl: [var_fd, i32]
- set: [var_fd, { call: [tls.fd, sock] }]
- print: ["tls socket created (var_fd should be > 0): ${var_fd}"]
- call: [tls.close, sock]

# bind to 127.0.0.1 + listen (no TLS handshake)
- decl: [srv, tls_socket_handle]
- set: [srv, { call: [tls.socket] }]
- decl: [brc, i32]
- set: [brc, { call: [tls.bind, srv, "127.0.0.1", 0] }]
- print: ["bind_rc: ${brc}"]
- decl: [lrc, i32]
- set: [lrc, { call: [tls.listen, srv, 5] }]
- print: ["listen_rc: ${lrc}"]
- call: [tls.close, srv]
- print: ["lifecycle done"]

# ── Phase B: TLS loopback via spawn (ping/pong, self-signed cert) ─────────────

- def:
    name: tls_server
    args: []
    body:
      - decl: [cert, path]
      - set: [cert, "tests/tls_certs/server.crt"]
      - decl: [key, path]
      - set: [key, "tests/tls_certs/server.key"]
      - decl: [var_s, tls_socket_handle]
      - set: [var_s, { call: [tls.socket] }]
      - call: [tls.set_cert, var_s, cert, key]
      - call: [tls.set_verify, var_s, "none"]
      - call: [tls.bind, var_s, "127.0.0.1", 19877]
      - call: [tls.listen, var_s, 5]
      - decl: [var_c, tls_socket_handle]
      - set: [var_c, { call: [tls.accept, var_s] }]
      - decl: [msg, string]
      - set: [msg, { call: [tls.recv_string, var_c, 64] }]
      - print: ["tls server got: ${msg}"]
      - call: [tls.send_string, var_c, "tls_pong"]
      - call: [tls.close, var_c]
      - call: [tls.close, var_s]

- decl: [srv_thread, thread_handle]
- set: [srv_thread, { spawn: [tls_server] }]
- call: [time.sleep_ms, 200]

- decl: [client, tls_socket_handle]
- set: [client, { call: [tls.socket] }]
- call: [tls.set_verify, client, "none"]
- call: [tls.connect, client, "127.0.0.1", 19877]
- call: [tls.send_string, client, "tls_ping"]
- decl: [resp, string]
- set: [resp, { call: [tls.recv_string, client, 64] }]
- print: ["tls client got: ${resp}"]
- call: [tls.close, client]

- call: [srv_thread.join]

- print: ["tls tests done"]
