# SPEC: 22_exceptions — several catch branches: the first MATCHING one catches, a branch
# on the base class also catches the descendants, and what no branch catches
# propagates to the enclosing try.
# Expected exit code: 0
- class:
    name: Exception
    members:
      - [message, string]

- class:
    name: NotHere
    extends: Exception

- class:
    name: Wrong
    extends: Exception

- def:
    name: thrower
    static_off: ["str_cmp"]
    args: [[which, i32]]
    return: i32
    body:
      - if: { condition: { eq: [which, 1] }, then: [{ throw: { new: NotHere, message: "not here" } }] }
      - if: { condition: { eq: [which, 2] }, then: [{ throw: { new: Wrong, message: "falsch" } }] }
      - if: { condition: { eq: [which, 3] }, then: [{ throw: { new: Exception, message: "sonstwas" } }] }
      - return: 0

# Returns 1/2/3 depending on the branch caught, 0 if nothing was thrown.
- def:
    name: catch_kind
    static_off: ["str_cmp"]
    args: [[which, i32]]
    return: i32
    body:
      - decl: [kind, i32, 0]
      - try:
          body:
            - call: [thrower, which]
          catch:
            - type: NotHere
              var: miss
              body:
                - set: [kind, 1]
            - type: Wrong
              var: wrong
              body:
                - set: [kind, 2]
            - type: Exception
              var: other
              body:
                - set: [kind, 3]
      - return: kind

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [bad, i32, 0]

      - decl: [kind_none, i32, { call: [catch_kind, 0] }]
      - if: { condition: { neq: [kind_none, 0] }, then: [{ print: ["FAIL without throw -> ${kind_none}"] }, { set: [bad, 1] }] }

      - decl: [kind_miss, i32, { call: [catch_kind, 1] }]
      - if: { condition: { neq: [kind_miss, 1] }, then: [{ print: ["FAIL NotHere -> branch ${kind_miss}, expected 1"] }, { set: [bad, 1] }] }

      - decl: [kind_wrong, i32, { call: [catch_kind, 2] }]
      - if: { condition: { neq: [kind_wrong, 2] }, then: [{ print: ["FAIL Wrong -> branch ${kind_wrong}, expected 2"] }, { set: [bad, 1] }] }

      - decl: [kind_base, i32, { call: [catch_kind, 3] }]
      - if: { condition: { neq: [kind_base, 3] }, then: [{ print: ["FAIL Exception -> branch ${kind_base}, expected 3"] }, { set: [bad, 1] }] }

      # no branch matches -> propagates to the enclosing try
      - decl: [outer, i32, 0]
      - try:
          body:
            - try:
                body:
                  - call: [thrower, 2]
                catch:
                  - type: NotHere
                    var: only_miss
                    body:
                      - set: [outer, 1]
          catch:
            - type: Exception
              var: caught_outside
              body:
                - set: [outer, 2]
      - if: { condition: { neq: [outer, 2] }, then: [{ print: ["FAIL rethrow -> ${outer}, expected 2"] }, { set: [bad, 1] }] }

      - if: { condition: { eq: [bad, 0] }, then: [{ print: ["test_try_catch_typed PASS"] }] }
      - return: bad
