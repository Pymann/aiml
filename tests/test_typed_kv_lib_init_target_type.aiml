# SPEC?: 31_db_integration   # derived from the file name, to be confirmed
# Repro: a top-level `decl: [kv, Kv<string:T>, db.open_kv]` in an imported
# library file (libraryMode) lowered the db.open_kv call onto the UNTYPED
# path (val_size=0, no ser_nodes) instead of the typed path.
#
# Cause: ast_compiler.cpp::Compiler::compile() in the libraryMode branch calls
# `visitExpression(decl->initialValue)` without setting `ctx.deserializeTargetType`
# — the db.open_kv builtin reads that field to extract vName from
# "Kv<string:T>".  Without the set, vName = "string" and
# the hasHeap logic falls back to the untyped open.
#
# Symptom in DataCreatures (2026-06-02): server_main opens
# creatures.kvwal as typed (val_size=432, ser_nodes for DataCreature),
# the imported discovery.aiml opens the same Kv as untyped (val_size=0).
# Both hit the same singleton cache; the first open wins.  If
# discovery's lib_init runs first, the KV registers as untyped.
# A later creatures.get from server_main returns raw bytes instead of the
# deserialised struct → strlen() on an i32+i32 list header sequence interpreted as char*
# → SIGSEGV.
#
# Fix: in libraryMode also set `ctx.deserializeTargetType = decl->typeName`
# before `visitExpression(init)` (mirror visitDeclStmt).

- import: "tests/lib_typed_kv_lib_init.aiml"

# Main opens the same Kv — the singleton cache must deliver the
# same (typed!) entry with both.
- decl: [tkv_main, Kv<string:TKVHeavy>, { call: [db.open_kv, "tkv_repro.kvwal", {persist: true, path: "/tmp/aiml_tkv_repro/"}] }]

- call: [lib_put, "id-1", "alpha"]

# With the bug we do not read the TKVHeavy struct here but the raw
# bytes from the untyped open → var_t.var_k would be a garbage pointer → crash on
# string-interpolating ${var_t.var_k}.
- decl: [var_t, TKVHeavy, { call: [tkv_main.get_copy, "id-1"] }]

- if:
    condition: { neq: [var_t.var_k, "id-1"] }
    then:
      - print: ["FAIL: var_t.var_k='${var_t.var_k}', expected 'id-1'"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [var_t.tags.len, 1] }
    then:
      - print: ["FAIL: var_t.tags.len=${var_t.tags.len}, expected 1"]
      - call: [sys.exit, 1]

- decl: [tag0, string, { at: [var_t.tags, 0] }]
- if:
    condition: { neq: [tag0, "alpha"] }
    then:
      - print: ["FAIL: tag0='${tag0}', expected 'alpha'"]
      - call: [sys.exit, 1]

- if:
    condition: { neq: [var_t.var_n, 42] }
    then:
      - print: ["FAIL: var_t.var_n=${var_t.var_n}, expected 42"]
      - call: [sys.exit, 1]

- print: ["PASS test_typed_kv_lib_init_target_type"]
