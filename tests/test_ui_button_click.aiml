# SPEC: 44_3_ui,44_0_input
# spec/44_3 §4.2 + §7: nimmt `ui.button` einen injizierten Klick an?
#
# Fuer Prefab-Widgets beantwortet das test_input_injection_click.aiml; fuer die
# Sofort-UI gab es nichts -- `test_ui.aiml` ist eine Vorfuehrung, die auf einen
# Menschen wartet.  Der Unterschied ist nicht akademisch: in einem Spiel stand
# 2026-11-11 die Frage, ob eine Bedienung ueber der 3D-Szene mit `ui.button`
# gebaut werden kann (sie zeichnet NACH `engine.draw_scene`, Prefabs nicht).
# Ich hatte das verneint -- auf Grund einer Probe, die `input.init` vergass und
# in der darum jedes `input.post_*` ein No-op war (spec/44_0 §8.2).  Dieser
# Test haelt die richtige Antwort fest.
#
# Geprueft:
#   1. Druck ALLEIN ist noch kein Klick (der Knopf meldet beim Loslassen)
#   2. Loslassen ueber dem Knopf meldet 1
#   3. derselbe Ablauf NEBEN dem Knopf meldet nichts (sonst waere 2. wertlos)
# Requires: display
# Expected exit code: 0

# Zeichnet EINEN Knopf in die rechte obere Zelle und meldet, ob er in diesem
# Bild geklickt wurde.  Gitter: rechte Spalte 200 px breit, obere Zeile 90 px
# hoch -- der Knopf sitzt also bei x 200..400, y 0..~27.
- def:
    name: knopf_bild
    args: [[win, window_handle]]
    return: i32
    body:
      - decl: [spalten, buffer<f32>, [1.0, 0.5]]
      - decl: [reihen,  buffer<f32>, [0.3, 1.0]]
      - decl: [tat, i32, 0]
      - call: [ui.begin, win]
      - call: [ui.begin_grid, spalten, reihen]
      - call: [ui.begin_cell, 1, 0, 1, 1]
      - if: { condition: { eq: [{ call: [ui.button, "Klick"] }, 1] }, then: [{ set: [tat, 1] }] }
      - call: [ui.end_cell]
      - call: [ui.end_grid]
      - call: [ui.end]
      - return: tat

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "ui click"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [input.init, win]
      - decl: [font, ui_font, { call: [ui.load_font_default, 16.0] }]
      - call: [ui.set_default_font, font]

      # ── 1. Zeigen und druecken -- noch kein Klick ────────────────────────
      # Injiziert wird NACH dem Swap, der die Latches leert (spec/44_0 §8.3).
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 300.0, 12.0]
      - decl: [bild1, i32, { call: [knopf_bild, win] }]
      - if: { condition: { neq: [bild1, 0] }, then: [{ print: ["FAIL blosses Zeigen meldet schon einen Klick"] }, { return: 1 }] }

      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 300.0, 12.0]
      - call: [input.post_mouse_down, 0]
      - decl: [bild2, i32, { call: [knopf_bild, win] }]
      - if: { condition: { neq: [bild2, 0] }, then: [{ print: ["FAIL Druck allein meldet schon einen Klick"] }, { return: 1 }] }

      # ── 2. Loslassen ueber dem Knopf ─────────────────────────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 300.0, 12.0]
      - call: [input.post_mouse_up, 0]
      - decl: [bild3, i32, { call: [knopf_bild, win] }]
      - if: { condition: { neq: [bild3, 1] }, then: [{ print: ["FAIL Loslassen ueber dem Knopf meldet keinen Klick"] }, { return: 1 }] }

      # ── 3. Gegenprobe: derselbe Ablauf daneben ───────────────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 40.0, 240.0]
      - call: [input.post_mouse_down, 0]
      - decl: [bild4, i32, { call: [knopf_bild, win] }]
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 40.0, 240.0]
      - call: [input.post_mouse_up, 0]
      - decl: [bild5, i32, { call: [knopf_bild, win] }]
      - if: { condition: { "||": [{ neq: [bild4, 0] }, { neq: [bild5, 0] }] }, then: [{ print: ["FAIL Klick NEBEN dem Knopf meldet einen Treffer"] }, { return: 1 }] }

      - call: [engine.destroy_window, win]
      - print: ["OK ui.button nimmt injizierte Klicks an"]
      - return: 0
