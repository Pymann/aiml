# SPEC: 44_3_ui,44_0_input
# spec/44_3 §4.2 + §7: does `ui.button` accept an injected click?
#
# For prefab widgets test_input_injection_click.aiml answers that; for the
# immediate-mode UI there was nothing -- `test_ui.aiml` is a demo that waits for a
# human.  The difference is not academic: in a game the question came up
# 2026-11-11 whether a control over the 3D scene can be built with `ui.button`
# (it draws AFTER `engine.draw_scene`, prefabs do not).
# I had said no -- on the basis of a probe that forgot `input.init` and
# in which therefore every `input.post_*` was a no-op (spec/44_0 §8.2).  This
# test records the right answer.
#
# Checked:
#   1. a press ALONE is not yet a click (the button reports on release)
#   2. releasing over the button reports 1
#   3. the same sequence NEXT TO the button reports nothing (otherwise 2. would be worthless)
# Requires: display
# Expected exit code: 0

# Draws ONE button into the top right cell and reports whether it was clicked in this
# frame.  Grid: right column 200 px wide, top row 90 px
# high -- so the button sits at x 200..400, y 0..~27.
- def:
    name: knopf_bild
    args: [[win, window_handle]]
    return: i32
    body:
      - decl: [spalten, buffer<f32>, [1.0, 0.5]]
      - decl: [reihen,  buffer<f32>, [0.3, 1.0]]
      - decl: [tat, i32, 0]
      - call: [ui.begin, win]
      - call: [ui.begin_grid, spalten, reihen]
      - call: [ui.begin_cell, 1, 0, 1, 1]
      - if: { condition: { eq: [{ call: [ui.button, "Klick"] }, 1] }, then: [{ set: [tat, 1] }] }
      - call: [ui.end_cell]
      - call: [ui.end_grid]
      - call: [ui.end]
      - return: tat

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 300, "ui click"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: 1 }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [input.init, win]
      - decl: [font, ui_font, { call: [ui.load_font_default, 16.0] }]
      - call: [ui.set_default_font, font]

      # ── 1. point and press -- not a click yet ────────────────────────────
      # Injection happens AFTER the swap, which clears the latches (spec/44_0 §8.3).
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 300.0, 12.0]
      - decl: [bild1, i32, { call: [knopf_bild, win] }]
      - if: { condition: { neq: [bild1, 0] }, then: [{ print: ["FAIL merely pointing already reports a click"] }, { return: 1 }] }

      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 300.0, 12.0]
      - call: [input.post_mouse_down, 0]
      - decl: [bild2, i32, { call: [knopf_bild, win] }]
      - if: { condition: { neq: [bild2, 0] }, then: [{ print: ["FAIL a press alone already reports a click"] }, { return: 1 }] }

      # ── 2. release over the button ───────────────────────────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 300.0, 12.0]
      - call: [input.post_mouse_up, 0]
      - decl: [bild3, i32, { call: [knopf_bild, win] }]
      - if: { condition: { neq: [bild3, 1] }, then: [{ print: ["FAIL releasing over the button reports no click"] }, { return: 1 }] }

      # ── 3. counter-probe: the same sequence next to it ────────────────────
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 40.0, 240.0]
      - call: [input.post_mouse_down, 0]
      - decl: [bild4, i32, { call: [knopf_bild, win] }]
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 40.0, 240.0]
      - call: [input.post_mouse_up, 0]
      - decl: [bild5, i32, { call: [knopf_bild, win] }]
      - if: { condition: { "||": [{ neq: [bild4, 0] }, { neq: [bild5, 0] }] }, then: [{ print: ["FAIL click NEXT TO the button reports a hit"] }, { return: 1 }] }

      - call: [engine.destroy_window, win]
      - print: ["OK ui.button accepts injected clicks"]
      - return: 0
