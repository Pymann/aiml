# SPEC: 44_3_ui,44_0_input
# ui.password_input (spec/44_3 F44-3-20): it takes typed text like
# ui.text_input and returns the real text, but what it draws is one bullet per
# character -- ui.password_mask is that caption, the same function the widget
# draws with.
# Requires: display
# Expected exit code: 0

# One password field filling the window's single cell; returns its buffer.
- def:
    name: field_frame
    args: [[win, window_handle], [buffer, string]]
    return: string
    body:
      - decl: [cols, buffer<f32>, [1.0]]
      - decl: [rows, buffer<f32>, [1.0]]
      - call: [ui.begin, win]
      - call: [ui.begin_grid, cols, rows]
      - call: [ui.begin_cell, 0, 0, 1, 1]
      - decl: [out, string, { call: [ui.password_input, "pw", buffer] }]
      - call: [ui.end_cell]
      - call: [ui.end_grid]
      - call: [ui.end]
      - return: [out]

- def:
    name: main
    return: i32
    body:
      - decl: [win, window_handle, { call: [engine.create_window, 400, 120, "password"] }]
      - if: { condition: { eq: [win, null] }, then: [{ print: ["FAIL create_window"] }, { return: [1] }] }
      - call: [gl.init]
      - call: [ui.init]
      - call: [input.init, win]
      - decl: [font, ui_font, { call: [ui.load_font_default, 16.0] }]
      - call: [ui.set_default_font, font]

      # focus it with a click
      - call: [engine.swap, win]
      - call: [input.post_mouse_move, 50.0, 10.0]
      - call: [input.post_mouse_down, 0]
      - decl: [first, string, { call: [field_frame, win, ""] }]
      - call: [engine.swap, win]
      - call: [input.post_mouse_up, 0]
      - call: [field_frame, win, first]

      # type
      - call: [engine.swap, win]
      - call: [input.post_text, "secret1"]
      - decl: [typed, string, { call: [field_frame, win, ""] }]
      - call: [engine.swap, win]
      - set: [typed, { call: [field_frame, win, ""] }]
      - if:
          condition: { neq: [typed, "secret1"] }
          then:
            - print: ["FAIL buffer '${typed}', want 'secret1'"]
            - return: [1]

      # what it shows: the bullets, never the text
      - decl: [shown, string, { call: [ui.password_mask, typed] }]
      - if:
          condition: { neq: [shown, "•••••••"] }
          then:
            - print: ["FAIL mask '${shown}'"]
            - return: [1]
      - decl: [umlauts, string, { call: [ui.password_mask, "äöü"] }]
      - if:
          condition: { neq: [umlauts, "•••"] }
          then:
            - print: ["FAIL one bullet per UTF-8 character: '${umlauts}'"]
            - return: [1]
      - print: ["PASS ui_password_input: real text returned, bullets drawn"]
      - return: [0]
