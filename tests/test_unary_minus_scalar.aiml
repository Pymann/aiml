# SPEC: 04_math,04_1_precedence
# spec/04_1 §"`-` — Unary Negation" + spec/04_math §Operator Arity: `-` takes two operands
# as subtraction and ONE as negation, for i32/i64/f32/f64. `/` and `%` exist only
# as binary. For vectors the same unary form is defined in spec/43_0 and spec/39.
#
# The unary form was only tested for vectors (tests/test_math.aiml), not for scalars —
# and until 2026-10-31 spec/04_math claimed that `-` was strictly binary. The test holds both
# sides together.
# Expected exit code: 0

- import: "tests/_cross/check.aiml"

- def:
    name: twice
    args: [[val, i32]]
    return: i32
    body:
      - return: { "*": [val, 2] }

- def:
    name: main
    return: i32
    body:
      - decl: [chk, ptr<Checker>, { new: Checker }]

      # i32: literal, variable, and the interplay with subtraction.
      - decl: [num, i32, 7]
      - decl: [negi, i32, { -: [num] }]
      - call: [chk.expect_i, "i32 Negation", negi, -7]
      - decl: [diff, i32, { -: [num, 2] }]
      - call: [chk.expect_i, "i32 subtraction stays binary", diff, 5]

      # negation of an already negative number.
      - decl: [back, i32, { -: [negi] }]
      - call: [chk.expect_i, "doppelte Negation", back, 7]

      # i64
      - decl: [big, i64, 4000000000]
      - decl: [negbig, i64, { -: [big] }]
      - call: [chk.expect_i, "i64 Negation", negbig, -4000000000]

      # f32/f64 via comparison with the subtraction from 0.
      - decl: [flt, f64, 2.5]
      - decl: [negf, f64, { -: [flt] }]
      - decl: [zerof, f64, { +: [negf, flt] }]
      - call: [chk.expect_i, "f64 negation cancels out", { cast: [zerof, i32] }, 0]

      # negation of a call result — the operand is not just a variable.
      - decl: [negcall, i32, { -: [{ call: [twice, 4] }] }]
      - call: [chk.expect_i, "negation of a call result", negcall, -8]

      - if: { condition: { gt: [chk.fails, 0] }, then: [{ print: ["FAIL unary_minus_scalar (${chk.fails})"] }, { return: 1 }] }
      - print: ["PASS unary_minus_scalar"]
      - return: 0
