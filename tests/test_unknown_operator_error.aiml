# SPEC: 04_1_precedence
# Backlog item 1: `select` does not exist. Until 2026-11-01 the compiler compiled it
# SILENTLY and returned 0 — so every typo in the operator name produces the same wrong
# zero. An unknown operator MUST be a compile error.
#
# Negative test: the compilation MUST fail and name the operator.
# Expected exit code: 1

- def:
    name: main
    return: i32
    body:
      - decl: [res, i64, { select: [false, 10, 20] }]
      - return: 0
