# SPEC: 49_static_analysis,49_static_off
# Negative test (spec/49 §2a): an unknown statement key MUST be a
# hard error.  Before, the statement vanished silently — the source text
# said what should happen, and it simply did not happen.  Exactly that way
# `exit:` stayed ineffective 54× in the corpus (FAIL branches returned 0).
#
# Expected exit code: 1
#
# Diagnostic form:
#   ...: unknown statement 'continue' — not an aiml statement ...
- class:
    name: Zaehler
    members:
      - [wert, i32]
    methods:
      - def:
          name: zaehle
          access: public
          return: i32
          body:
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, 3] }
                body:
                  - set: [idx, { +: [idx, 1] }]
                  - continue: []
                  - set: [<.wert, { +: [<.wert, 1] }]
            - return: <.wert

- def:
    name: main
    return: i32
    body:
      - decl: [zz, ptr<Zaehler>, { new: Zaehler }]
      - print: ["${{ call: [zz.zaehle] }}"]
      - return: 0
