# SPEC: 49_static_analysis,49_static_off
# Unused-enumerator analysis (spec/49): enum members that are declared but never
# referenced as `Enum.Member` produce a non-blocking
# compiler WARNING.  The build continues (exit 0).
#
# Color: 3 members, only `red` referenced  → 2 warnings (green, blue).
# Dir:   2 members, both referenced        → 0 warnings.
#
# Verification (warning text on stdout) is not possible via the run_all_tests wrapper
# (the harness only checks exit codes) → grepped separately.  Expected exit code: 0

- enum:
    name: Color
    values:
      - red:   1
      - green: 2       # never referenced → warning expected
      - blue:  3       # never referenced → warning expected

- enum:
    name: Dir
    values:
      - north: 1
      - south: 2

- def:
    name: main
    return: i32
    body:
      - decl: [col_val, i32, Color.red]
      - decl: [dir_n,   i32, Dir.north]
      - decl: [dir_s,   i32, Dir.south]
      - if: { condition: { neq: [col_val, 1] }, then: [{ print: ["FAIL Color.red"] }, { call: [sys.exit, 1] }] }
      - if: { condition: { neq: [{ +: [dir_n, dir_s] }, 3] }, then: [{ print: ["FAIL Dir sum"] }, { call: [sys.exit, 1] }] }
      - print: ["PASS unused_enum_member: build ran; Color.green/blue expected as warnings"]
      - return: 0
