# SPEC: 49_static_analysis,49_static_off
# Unused enum V2 (spec/49 §18.2): an `enum: T` dropdown binding counts as a
# reflective whole-enum use → NO unused warning for Flavor, although no
# Flavor.Member appears in the code.  Contrast: Unbound stays unused and would warn.

- enum:
    name: Flavor
    values:
      - sweet:  1
      - sour:   2
      - bitter: 3

- prefab:
    name: FlavorPicker
    width: 200
    height: 100
    children:
      - { name: flav_dd, type: dropdown, x: 0, y: 0, width: 120, height: 24, enum: Flavor }

- def:
    name: main
    return: i32
    body:
      - return: 0
