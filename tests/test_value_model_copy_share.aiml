# SPEC: 61_memory §7 — eine Wertmodell-Kopie ist member-weise, mit incref je
# String-/Container-Feld.  Ohne das incref teilen Kopie und Original einen
# Puffer mit rc=1; der naechste Member-Store gibt ihn frei und das ORIGINAL
# zeigt ins Leere.
#
# Gefunden beim Cache-Schluessel in cosmos (doc/spec/92 Befund 5): zwei Aufrufe
# mit demselben Schritt ergaben verschiedene Schluessel, weil ein Feld nach einer
# Kopie Muell las.
# Expected exit code: 0

- model:
    name: Tragbar
    fields:
      - [ers, string]
      - [zwe, string]

- def:
    name: liest
    args: [[tra, Tragbar]]
    return: { type: string, lifetime: producer }
    body:
      - return: "${tra.ers.len}:${tra.ers}|${tra.zwe.len}:${tra.zwe}"

- def:
    name: zeigt
    static_off: ["str_cmp"]
    args: [[was, string], [ist, string], [soll, string]]
    return: i32
    body:
      - if: { condition: { eq: [ist, soll] }, then: [{ call: [log.info, "  ok   ${was}: ${ist}"] }, { return: 0 }] }
      - call: [log.info, "  FAIL ${was}: ${ist} (erwartet ${soll})"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fehler, i32, 0]
      - decl: [erst, Tragbar]
      - set: [erst.ers, "aaa"]
      - set: [erst.zwe, "bbb"]
      - set: [fehler, { +: [fehler, { call: [zeigt, "Original direkt", "${erst.ers}|${erst.zwe}", "aaa|bbb"] }] }]
      - set: [fehler, { +: [fehler, { call: [zeigt, "Original by value", { call: [liest, erst] }, "3:aaa|3:bbb"] }] }]

      # Eine Kopie, nichts geaendert.
      - decl: [unberuehrt, Tragbar, erst]
      - set: [fehler, { +: [fehler, { call: [zeigt, "Kopie direkt", "${unberuehrt.ers}|${unberuehrt.zwe}", "aaa|bbb"] }] }]
      - set: [fehler, { +: [fehler, { call: [zeigt, "Kopie by value", { call: [liest, unberuehrt] }, "3:aaa|3:bbb"] }] }]

      # Eine Kopie, EIN Feld neu gesetzt — der Kern des Befunds.
      - decl: [geaendert, Tragbar, erst]
      - set: [geaendert.zwe, "ccc"]
      - set: [fehler, { +: [fehler, { call: [zeigt, "Kopie+set direkt", "${geaendert.ers}|${geaendert.zwe}", "aaa|ccc"] }] }]
      - set: [fehler, { +: [fehler, { call: [zeigt, "Kopie+set by value", { call: [liest, geaendert] }, "3:aaa|3:ccc"] }] }]
      - set: [fehler, { +: [fehler, { call: [zeigt, "Original danach", "${erst.ers}|${erst.zwe}", "aaa|bbb"] }] }]
      - set: [fehler, { +: [fehler, { call: [zeigt, "Original danach by value", { call: [liest, erst] }, "3:aaa|3:bbb"] }] }]

      # Und die Lesefunktion muss zweimal dasselbe sagen — ein Schluessel, der
      # sich bei jedem Lesen bewegt, ist kein Schluessel.
      - decl: [zuerst, string, { call: [liest, geaendert] }]
      - decl: [danach, string, { call: [liest, geaendert] }]
      - set: [fehler, { +: [fehler, { call: [zeigt, "zweimal gelesen", danach, zuerst] }] }]

      - if: { condition: { eq: [fehler, 0] }, then: [{ call: [log.info, "test_value_model_copy_share PASS"] }, { return: 0 }] }
      - call: [log.info, "test_value_model_copy_share FAIL (${fehler})"]
      - return: 1
