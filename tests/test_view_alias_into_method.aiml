# SPEC: 61_memory_management
# A VIEW ALIAS from a container, passed BY VALUE into a method — and
# afterwards the container is read again.
#
# spec/61 §6.3: `decl: [x, Model, { at: [liste, i] }]` aliases the inner heap
# of the element.  If this x is passed on by value, the callee gets
# a copy whose pointers point to the same heap — and discarding it must
# NOT free the container.
#
# Occasion: the WASM client crashed exactly in this situation (alias from
# `g_live_cluster.pipelines`, passed by value into a method).  Natively something like this
# silently runs through, WASM checks bounds.
# Expected exit code: 0

- model:
    name: Inner
    fields:
      - [tag,   string]
      - [items, list<string>]

- model:
    name: Outer
    fields:
      - [title, string]
      - [parts, list<Inner>]

- class:
    name: Reader
    methods:
      # takes the model BY VALUE — as render_run does.
      - def:
          name: describe
          access: public
          static_off: ["str_cmp"]
          args: [[one, Outer]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [out, string, "${one.title}:"]
            - decl: [pix, i32, 0]
            - while:
                condition: { lt: [pix, one.parts.len] }
                body:
                  - decl: [part, Inner, { at: [one.parts, pix] }]
                  - set: [out, "${out} ${part.tag}/${part.items.len}"]
                  - set: [pix, { +: [pix, 1] }]
            - return: out

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [reader, ptr<Reader>, { new: Reader }]

      - decl: [shelf, list<Outer>]
      - decl: [fill, i32, 0]
      - while:
          condition: { lt: [fill, 4] }
          body:
            - decl: [one, Outer]
            - set: [one.title, "stueck-${fill}"]
            - decl: [inner_a, Inner]
            - set: [inner_a.tag, "teil-a-${fill}"]
            - call: [inner_a.items.push, "first element with length"]
            - call: [inner_a.items.push, "second element with length"]
            - call: [one.parts.push, inner_a]
            - decl: [inner_b, Inner]
            - set: [inner_b.tag, "teil-b-${fill}"]
            - call: [inner_b.items.push, "drittes element"]
            - call: [one.parts.push, inner_b]
            - call: [shelf.push, one]
            - set: [fill, { +: [fill, 1] }]

      # The alias, passed by value into the method several times — as in a
      # frame loop.
      - decl: [picked, Outer, { at: [shelf, 1] }]
      - decl: [round, i32, 0]
      - while:
          condition: { lt: [round, 20] }
          body:
            - decl: [text, string, { call: [reader.describe, picked] }]
            - if:
                condition: { lt: [text.len, 10] }
                then: [{ print: ["  FAIL description too short in round ${round}"] }, { set: [fails, { +: [fails, 1] }] }]
            - set: [round, { +: [round, 1] }]

      # Afterwards the container must be undamaged.
      - set: [fails, { +: [fails, { call: [expect, "the alias is still readable", { eq: [picked.title, "stueck-1"] }] }] }]
      - decl: [again, Outer, { at: [shelf, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "the element is undamaged", { eq: [again.title, "stueck-1"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "its inner list too", { eq: [again.parts.len, 2] }] }] }]
      - decl: [deep, Inner, { at: [again.parts, 0] }]
      - set: [fails, { +: [fails, { call: [expect, "and the innermost list", { eq: [deep.items.len, 2] }] }] }]
      - decl: [other, Outer, { at: [shelf, 3] }]
      - set: [fails, { +: [fails, { call: [expect, "another element likewise", { eq: [other.title, "stueck-3"] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_view_alias_into_method FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_view_alias_into_method PASS"]
      - return: 0
