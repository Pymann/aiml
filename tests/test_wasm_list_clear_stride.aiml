# SPEC: 61_memory_management
# Regression test (spec/61 §5.7): `clear()` / `pop()` must free pointer-sized
# element slots with the TARGET stride — 8 on x86_64, 4 on wasm32.
#
# Occasion: `classifyListElem` hard-set `elemSize = 8` for string / model handle / ptr<T>.
# On wasm32 clear() therefore ran past the end of the buffer with double the stride
# and dereferenced data garbage as a string pointer — the
# cosmos WASM client died of it (Firefox: "index out of bounds").  Natively
# nothing showed: there the stride IS 8.
#
# That is why this test belongs in the WASM list (tests/wasm_tests.list).  Enough
# elements so that the double stride runs past the end.
# Expected exit code: 0

- model:
    name: StrideRow
    fields:
      - [row_id,   string]
      - [row_num,  i32]

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ call: [log.info, "  ok   ${what}"] }, { return: 0 }]
      - call: [log.info, "  FAIL ${what}"]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # 1) list<string>: the case that tore down the client.
      - decl: [names, list<string>]
      - decl: [six, i32, 0]
      - while:
          condition: { lt: [six, 128] }
          body:
            - call: [names.push, "zeile-${six}-mit-etwas-laenge-damit-geheapt-wird"]
            - set: [six, { +: [six, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "128 Strings", { eq: [names.len, 128] }] }] }]
      - call: [names.clear]
      - set: [fails, { +: [fails, { call: [expect, "clear on list<string> survives", { eq: [names.len, 0] }] }] }]
      # The same buffer is reused: too large a step in clear
      # would already have freed foreign memory here.
      - call: [names.push, "danach"]
      - set: [fails, { +: [fails, { call: [expect, "buffer usable again after clear", { eq: [names.len, 1] }] }] }]

      # 2) pop() mit verworfenem Ergebnis — gleiche Freigabe, letzter Slot.
      - decl: [more, list<string>]
      - decl: [pix, i32, 0]
      - while:
          condition: { lt: [pix, 64] }
          body:
            - call: [more.push, "weg-${pix}-weg-weg-weg-weg-weg-weg"]
            - set: [pix, { +: [pix, 1] }]
      - decl: [qix, i32, 0]
      - while:
          condition: { lt: [qix, 64] }
          body:
            - call: [more.pop]
            - set: [qix, { +: [qix, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "64x pop on list<string> survives", { eq: [more.len, 0] }] }] }]

      # 3) list<Model> with a heap field: element release via the descriptors.
      - decl: [rows, list<StrideRow>]
      - decl: [mix, i32, 0]
      - while:
          condition: { lt: [mix, 96] }
          body:
            - decl: [row, StrideRow]
            - set: [row.row_id, "satz-${mix}-satz-satz-satz-satz"]
            - set: [row.row_num, mix]
            - call: [rows.push, row]
            - set: [mix, { +: [mix, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "96 Modelle", { eq: [rows.len, 96] }] }] }]
      # Read before the clear: the contents must be intact (stride in at).
      - decl: [bad, i32, 0]
      - decl: [vix, i32, 0]
      - while:
          condition: { lt: [vix, rows.len] }
          body:
            - decl: [got, StrideRow, { at: [rows, vix] }]
            - if: { condition: { neq: [got.row_num, vix] }, then: [{ set: [bad, { +: [bad, 1] }] }] }
            - set: [vix, { +: [vix, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "jedes Modell liegt an seinem Platz", { eq: [bad, 0] }] }] }]
      - call: [rows.clear]
      - set: [fails, { +: [fails, { call: [expect, "clear on list<Model> survives", { eq: [rows.len, 0] }] }] }]

      - if:
          condition: { eq: [fails, 0] }
          then: [{ call: [log.info, "PASS wasm_list_clear_stride"] }, { return: 0 }]
      - call: [log.info, "FAIL wasm_list_clear_stride (${fails})"]
      - return: 1
