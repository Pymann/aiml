# SPEC: 44_5_mirror §8 (when a peer counts as disconnected) + 32_4 §5
#
# A signal is not a connection loss.  `aiml_ws_poll` computed
#
#     int r = ::poll(&pfd, 1, timeout_ms);
#     return r > 0 ? 1 : (r == 0 ? 0 : -1);
#
# and so returned -1 as soon as any signal hit the process -- poll(2)
# is NOT resumed by SA_RESTART, which aiml even notes itself on `sys.catch_signals`.
# The mirror turned this -1 into a `peer_disconnected`,
# and SILENTLY: a healthy session vanished without a single line of reason
# (datacreatures, 2026-11-15 and 2026-11-20, the server kept running each time).
#
# The behaviour is checked, not the race: a blocking
# ws.poll(2000) is hit by SIGUSR1 after ~300 ms.
#   before:  poll returns at ~300 ms with -1 (error)
#   now:     poll runs out its 2000 ms and reports 0 (nothing there),
#            and the connection still carries data afterwards.
#
# Expected exit code: 0

- decl: [g_srv_bereit, i32, 0]

- def:
    name: stiller_server
    args: []
    body:
      - decl: [srv, ws_handle, { call: [ws.server, "127.0.0.1", 19907] }]
      - if:
          condition: { peq: [srv, null] }
          then:
            - print: ["FAIL: listen on 127.0.0.1:19907 failed"]
            - return: []
      - set: [g_srv_bereit, 1]
      - decl: [conn, ws_handle, { call: [ws.accept, srv] }]
      # Deliberately SILENT: only after the poll window has expired does something come.
      # That way the test really measures the timer and not arriving data.
      - call: [time.sleep_ms, 2600]
      - call: [ws.send, conn, "nach dem Signal"]
      - call: [time.sleep_ms, 300]
      - call: [ws.close, conn]

- decl: [pass, i32, 0]
- decl: [fail, i32, 0]

# Without a handler no EINTR: a signal with default handling does not interrupt
# a system call.  catch_signals sets exactly the handler that a real
# application sets too (spec/23 §5.7).
- decl: [fang, i32, { call: [sys.catch_signals, "USR1"] }]
- if:
    condition: { neq: [fang, 0] }
    then:
      - print: ["FAIL: sys.catch_signals('USR1') ergab ${fang}"]
      - set: [fail, { +: [fail, 1] }]

- decl: [srv_t, thread_handle]
- set: [srv_t, { spawn: [stiller_server] }]
- decl: [warte, i32, 0]
- while:
    condition: { "&&": [{ eq: [g_srv_bereit, 0] }, { lt: [warte, 200] }] }
    body:
      - call: [time.sleep_ms, 10]
      - set: [warte, { +: [warte, 1] }]

- decl: [cli, ws_handle, { call: [ws.connect, "127.0.0.1", 19907, "/"] }]
- if:
    condition: { peq: [cli, null] }
    then:
      - print: ["FAIL: connect to 127.0.0.1:19907 failed"]
      - set: [fail, { +: [fail, 1] }]

# A child sends the own process SIGUSR1 after 300 ms -- $PPID is the
# test itself, because sys.exe starts directly out of it.
- decl: [argv, list<string>]
- call: [argv.push, "sh"]
- call: [argv.push, "-c"]
- call: [argv.push, "sleep 0.3; kill -USR1 $PPID"]
- decl: [kind, process, { call: [sys.exe, argv] }]

- decl: [beginn, i64, { call: [time.mono_ms] }]
- decl: [erg, i32, { call: [ws.poll, cli, 2000] }]
- decl: [dauer, i64, { -: [{ call: [time.mono_ms] }, beginn] }]

- print: ["ws.poll(2000) → ${erg} after ${dauer} ms"]

# The signal really arrived too -- otherwise the test checks nothing.
- decl: [sig, i32, { call: [sys.caught_signal] }]
- if:
    condition: { eq: [sig, 0] }
    then:
      - print: ["FAIL: no signal arrived — the test missed its subject"]
      - set: [fail, { +: [fail, 1] }]
    else: [{ set: [pass, { +: [pass, 1] }] }]

- if:
    condition: { eq: [erg, -1] }
    then:
      - print: ["FAIL: ws.poll reported an error (-1) — the signal counts as a connection loss"]
      - set: [fail, { +: [fail, 1] }]
    else: [{ set: [pass, { +: [pass, 1] }] }]

# The poll window must have RUN OUT; an abort at ~300 ms is exactly the
# bug this is about.
- if:
    condition: { lt: [dauer, 1900] }
    then:
      - print: ["FAIL: ws.poll returned after ${dauer} ms, 2000 were promised"]
      - set: [fail, { +: [fail, 1] }]
    else: [{ set: [pass, { +: [pass, 1] }] }]

# And the connection lives: the server sends after 2600 ms, that must arrive.
- decl: [erg2, i32, { call: [ws.poll, cli, 2000] }]
- if:
    condition: { neq: [erg2, 1] }
    then:
      - print: ["FAIL: nothing got through any more after the signal (poll → ${erg2})"]
      - set: [fail, { +: [fail, 1] }]
    else:
      - decl: [txt, string, { call: [ws.recv, cli] }]
      - if:
          condition: { eq: [txt, "nach dem Signal"] }
          then: [{ set: [pass, { +: [pass, 1] }] }]
          else:
            - print: ["FAIL: wrong payload after the signal: '${txt}'"]
            - set: [fail, { +: [fail, 1] }]

- call: [ws.close, cli]
- call: [srv_t.join]

- print: [""]
- print: ["=== test_ws_poll_signal_interrupt: ${pass} passed, ${fail} failed ==="]
