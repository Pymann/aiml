# SPEC: 60_yaml
# spec/60 yaml.tokens — error-tolerant lexer for highlighting.
# Above all the CONTRACT is checked: complete, non-overlapping,
# line-local, and never a failure — because the half-typed state is
# the normal case, not the exception.
# Expected exit code: 0

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ print: ["  ok   ${what}"] }, { return: 0 }]
      - print: ["  FAIL ${what}"]
      - return: 1

# kind_at: the kind of the token that contains byte `pos`; -1 if none.
- def:
    name: kind_at
    args: [[toks, list<i32>], [pos, i32]]
    return: i32
    body:
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, toks.len] }
          body:
            - decl: [beg, i32, { at: [toks, idx] }]
            - decl: [tln, i32, { at: [toks, { +: [idx, 1] }] }]
            - if:
                condition: { '&&': [{ ge: [pos, beg] }, { lt: [pos, { +: [beg, tln] }] }] }
                then: [{ return: { at: [toks, { +: [idx, 2] }] } }]
            - set: [idx, { +: [idx, 3] }]
      - return: -1

# covered: the sum of the token lengths plus whitespace must give the text;
# at the same time tokens must not overlap and must not go backwards.
- def:
    name: covered_ok
    args: [[toks, list<i32>], [total, i32]]
    return: i32
    body:
      - decl: [idx, i32, 0]
      - decl: [prev_end, i32, 0]
      - while:
          condition: { lt: [idx, toks.len] }
          body:
            - decl: [beg, i32, { at: [toks, idx] }]
            - decl: [tln, i32, { at: [toks, { +: [idx, 1] }] }]
            - if: { condition: { lt: [beg, prev_end] }, then: [{ return: 0 }] }
            - if: { condition: { le: [tln, 0] }, then: [{ return: 0 }] }
            - if: { condition: { gt: [{ +: [beg, tln] }, total] }, then: [{ return: 0 }] }
            - set: [prev_end, { +: [beg, tln] }]
            - set: [idx, { +: [idx, 3] }]
      - return: 1

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]

      # ── basic case: key, value, comment ─────────────────────────────────
      - decl: [src, string, "name: build_matrix  # ein Kommentar\n"]
      - decl: [toks, list<i32>, { call: [yaml.tokens, src] }]
      - set: [fails, { +: [fails, { call: [expect, "triple multiple of 3", { eq: [{ '%': [toks.len, 3] }, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "non-overlapping and in order", { call: [covered_ok, toks, src.len] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "'name' is a key", { eq: [{ call: [kind_at, toks, 0] }, YamlTok.key] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "':' is punctuation", { eq: [{ call: [kind_at, toks, 4] }, YamlTok.punct] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "'#' starts a comment", { eq: [{ call: [kind_at, toks, 20] }, YamlTok.comment] }] }] }]

      # ── line-local: no token spans a \n ───────────────────────────────────
      - decl: [two, string, "a: 1\nb: 2\n"]
      - decl: [tk2, list<i32>, { call: [yaml.tokens, two] }]
      - set: [fails, { +: [fails, { call: [expect, "no token at \\n (line 1 ends)", { eq: [{ call: [kind_at, tk2, 4] }, -1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "second line has its own key", { eq: [{ call: [kind_at, tk2, 5] }, YamlTok.key] }] }] }]

      # ── error tolerance: truncated key ───────────────────────────────────
      # The most common state while typing.  A parser delivers NOTHING
      # here; the lexer must colour anyway.
      - decl: [half, string, "pipeline:\n  nam"]
      - decl: [tk3, list<i32>, { call: [yaml.tokens, half] }]
      - set: [fails, { +: [fails, { call: [expect, "half text delivers tokens", { gt: [tk3.len, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "half text stays non-overlapping", { call: [covered_ok, tk3, half.len] }] }] }]

      # ── error tolerance: unclosed string ─────────────────────────────────
      - decl: [unq, string, "name: \"offen\nnext: 1\n"]
      - decl: [tk4, list<i32>, { call: [yaml.tokens, unq] }]
      - set: [fails, { +: [fails, { call: [expect, "open string ends at the line", { eq: [{ call: [kind_at, tk4, 6] }, YamlTok.string] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "next line is read normally again", { eq: [{ call: [kind_at, tk4, 13] }, YamlTok.key] }] }] }]

      # ── empty text is not an error ───────────────────────────────────────
      - decl: [tk5, list<i32>, { call: [yaml.tokens, ""] }]
      - set: [fails, { +: [fails, { call: [expect, "empty text delivers an empty list", { eq: [tk5.len, 0] }] }] }]

      # ── Kinds ───────────────────────────────────────────────────────────
      - decl: [kinds, string, "- [a, 1, true, 'q', &anc, !tag]\n"]
      - decl: [tk6, list<i32>, { call: [yaml.tokens, kinds] }]
      - set: [fails, { +: [fails, { call: [expect, "number recognised", { eq: [{ call: [kind_at, tk6, 6] }, YamlTok.number] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "keyword recognised", { eq: [{ call: [kind_at, tk6, 9] }, YamlTok.keyword] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "single quote recognised", { eq: [{ call: [kind_at, tk6, 15] }, YamlTok.string] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "anchor recognised", { eq: [{ call: [kind_at, tk6, 20] }, YamlTok.anchor] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "tag recognised", { eq: [{ call: [kind_at, tk6, 26] }, YamlTok.tag] }] }] }]

      # ── negative number ──────────────────────────────────────────────────
      # Regression: the scalar branch did not advance on a leading '-' (the '-'
      # is punctuation) and spun forever — every source with `-1` made the
      # lexer hang, contrary to the "Never fails" contract of spec/60.
      - decl: [negs, string, "gt: [open, -1]\n"]
      - decl: [tk7, list<i32>, { call: [yaml.tokens, negs] }]
      - set: [fails, { +: [fails, { call: [expect, "negative number recognised", { eq: [{ call: [kind_at, tk7, 11] }, YamlTok.number] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "negative number: the digit belongs to the token", { eq: [{ call: [kind_at, tk7, 12] }, YamlTok.number] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "negative number: non-overlapping", { call: [covered_ok, tk7, negs.len] }] }] }]
      - decl: [bare, string, "-1\n"]
      - decl: [tk8, list<i32>, { call: [yaml.tokens, bare] }]
      - set: [fails, { +: [fails, { call: [expect, "a bare -1 delivers a token", { eq: [{ call: [kind_at, tk8, 0] }, YamlTok.number] }] }] }]

      - if:
          condition: { neq: [fails, 0] }
          then: [{ print: ["test_yaml_tokens FAIL (${fails})"] }, { return: 1 }]
      - print: ["test_yaml_tokens PASS"]
      - return: 0
