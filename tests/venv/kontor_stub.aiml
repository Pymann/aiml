# Requires: driver
# kontor's exodus routes, served from a directory — so that tests/venv/run.sh
# can test `install --kontor` (spec/68 §6.1) and `publish` (§6.3) without a kontor.
#
#   KONTOR_STUB_DIR=<dir> aiml kontor_stub.aiml -- <port>
#
# A request for /p is answered with <dir>/p, so the fixture is a tree in
# kontor's own shape: exodus/<name>/<version>/{exodus.json,package} and
# api/v1/graph.  Whoever writes the fixture decides what kontor "says".
#
# PUT /exodus/<name>/<version>/{exodus.json,package} writes there, as kontor
# does: only with `Authorization: Bearer $KONTOR_STUB_TOKEN` or
# `$KONTOR_STUB_ADMIN_TOKEN` (else 401).  A version whose package is there, or
# that was deleted (a `tombstone.json` in its directory, GET answers 410), is
# not overwritten (409) — except with the admin token (kontor FW-47a), which
# replaces it and takes the tombstone away.
#
# PUT /generic/<name>/<version>/<file> (spec/68 §9) writes there with the same
# tokens, and — as kontor's generic store does — replaces what is there; it
# wants an X-Checksum-Sha256 header (400 without one).

- def:
    name: stub_dir
    return: string
    body:
      - decl: [vars, map<string:string>, { call: [sys.env] }]
      - return: [{ call: [vars.get, "KONTOR_STUB_DIR"] }]

- def:
    name: on_get
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - decl: [root, string, { call: [stub_dir] }]
      - decl: [file, string, "${root}${req.path}"]
      - decl: [file_p, path, file]
      - decl: [dir_p, path, { call: [file_p.parent] }]
      - if:
          condition: { and: [{ not: [{ call: [io.exists, file] }] }, { call: [io.exists, "${dir_p}/tombstone.json"] }] }
          then:
            - set: [resp.status, 410]
            - set: [resp.body, "{\"error\":\"deleted\",\"code\":\"gone\"}"]
            - call: [resp.send]
            - return: []
      - if:
          condition: { not: [{ call: [io.exists, file] }] }
          then:
            - set: [resp.status, 404]
            - set: [resp.body, "not found"]
            - call: [resp.send]
            - return: []
      - call: [resp.headers.put, "content-type", "application/octet-stream"]
      - set: [resp.body_file, file]
      - call: [resp.send]

# PUT /exodus/:name/:version/<file> — `file` says which of the two.
- def:
    name: on_put
    args: [[req, http_request_handle], [resp, http_response_handle], [file, string]]
    body:
      - decl: [vars, map<string:string>, { call: [sys.env] }]
      - decl: [token, string, { call: [vars.get, "KONTOR_STUB_TOKEN"] }]
      - decl: [admin_token, string, "-"]
      - if:
          condition: { call: [vars.contains, "KONTOR_STUB_ADMIN_TOKEN"] }
          then:
            - set: [admin_token, { call: [vars.get, "KONTOR_STUB_ADMIN_TOKEN"] }]
      - decl: [auth, string, { call: [req.header, "authorization"] }]
      - decl: [is_admin, bool, false]
      - if:
          condition: { and: [{ neq: [auth, null] }, { eq: [auth, "Bearer ${admin_token}"] }] }
          then:
            - set: [is_admin, true]
      - if:
          condition: { and: [{ not: [is_admin] }, { or: [{ eq: [auth, null] }, { neq: [auth, "Bearer ${token}"] }] }] }
          then:
            - set: [resp.status, 401]
            - set: [resp.body, "{\"error\":\"authentication required\",\"code\":\"unauthorized\"}"]
            - call: [resp.send]
            - return: []
      - decl: [params, map<string:string>]
      - set: [params, req.params]
      - decl: [name, string, { call: [params.get, "name"] }]
      - decl: [version, string, { call: [params.get, "version"] }]
      - decl: [root, string, { call: [stub_dir] }]
      - decl: [dir, string, "${root}/exodus/${name}/${version}"]
      - if:
          condition: { and: [{ not: [is_admin] }, { or: [{ call: [io.exists, "${dir}/package"] }, { call: [io.exists, "${dir}/tombstone.json"] }] }] }
          then:
            - set: [resp.status, 409]
            - set: [resp.body, "{\"error\":\"${name}@${version} is published; a version is not overwritten\",\"code\":\"conflict\"}"]
            - call: [resp.send]
            - return: []
      - call: [io.mkdir_all, dir]
      - if:
          condition: { call: [io.exists, "${dir}/tombstone.json"] }
          then:
            - call: [io.remove, "${dir}/tombstone.json"]
      - decl: [payload, buffer<u8>]
      - set: [payload, req.body_bytes]
      - call: [io.write_file, "${dir}/${file}", payload]
      - set: [resp.status, 201]
      - set: [resp.body, "{}"]
      - call: [resp.send]

- def:
    name: on_put_manifest
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - call: [on_put, req, resp, "exodus.json"]

- def:
    name: on_put_package
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - call: [on_put, req, resp, "package"]

- def:
    name: on_put_generic
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - decl: [vars, map<string:string>, { call: [sys.env] }]
      - decl: [token, string, { call: [vars.get, "KONTOR_STUB_TOKEN"] }]
      - decl: [admin_token, string, "-"]
      - if:
          condition: { call: [vars.contains, "KONTOR_STUB_ADMIN_TOKEN"] }
          then:
            - set: [admin_token, { call: [vars.get, "KONTOR_STUB_ADMIN_TOKEN"] }]
      - decl: [auth, string, { call: [req.header, "authorization"] }]
      - if:
          condition: { or: [{ eq: [auth, null] }, { and: [{ neq: [auth, "Bearer ${token}"] }, { neq: [auth, "Bearer ${admin_token}"] }] }] }
          then:
            - set: [resp.status, 401]
            - set: [resp.body, "{\"error\":\"authentication required\",\"code\":\"unauthorized\"}"]
            - call: [resp.send]
            - return: []
      - decl: [sum, string, { call: [req.header, "x-checksum-sha256"] }]
      - if:
          condition: { eq: [sum, null] }
          then:
            - set: [resp.status, 400]
            - set: [resp.body, "{\"error\":\"X-Checksum-Sha256 missing\",\"code\":\"bad_request\"}"]
            - call: [resp.send]
            - return: []
      - decl: [params, map<string:string>]
      - set: [params, req.params]
      - decl: [name, string, { call: [params.get, "name"] }]
      - decl: [version, string, { call: [params.get, "version"] }]
      - decl: [file, string, { call: [params.get, "file"] }]
      - decl: [root, string, { call: [stub_dir] }]
      - decl: [dir, string, "${root}/generic/${name}/${version}"]
      - call: [io.mkdir_all, dir]
      - decl: [payload, buffer<u8>]
      - set: [payload, req.body_bytes]
      - call: [io.write_file, "${dir}/${file}", payload]
      - call: [io.write_file, "${dir}/${file}.sha256", sum]
      - set: [resp.status, 201]
      - set: [resp.body, "{}"]
      - call: [resp.send]

- def:
    name: main
    return: i32
    body:
      - decl: [port, i32, 18599]
      - decl: [arg, string, { call: [sys.get_arg, 1] }]
      - if:
          condition: { gt: [arg.len, 0] }
          then:
            - set: [port, arg]
      - decl: [srv, http_server_handle, { call: [http.server, "127.0.0.1", port] }]
      - call: [srv.route, "GET", "/*", on_get]
      - call: [srv.route, "PUT", "/exodus/:name/:version/exodus.json", on_put_manifest]
      - call: [srv.route, "PUT", "/exodus/:name/:version/package", on_put_package]
      - call: [srv.route, "PUT", "/generic/:name/:version/:file", on_put_generic]
      - decl: [root, string, { call: [stub_dir] }]
      - print: ["kontor-stub ${port} ${root}"]
      - call: [srv.start]
      - return: 0
