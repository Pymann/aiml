# static-check: off
# Native side of the mirror RPC WASM test.  Listens on ws://localhost:18888,
# registers ItemImpl (sync path) which also handles RPC `cast` (rpc path).
# Tests both:
#   sync   — server pushes tags=["tool","metal","starter"] to client
#   rpc    — client sends RpcCast payload containing list<string>; server decodes
#
# Same wire codec as DataCreatures (binary aiml_ser_encode/decode over WS).

- interface:
    name: Tagged
    methods:
      - [tags, list<string>, []]

- model:
    name: Item
    sync: [name, tags]
    rpc:  [cast]
    fields:
      - [name, string]
      - [tags, list<string>]

- class:
    name: ItemImpl
    models: [Item]
    implements: [Tagged]
    methods:
      - def:
          name: tags
          return: list<string>
          args: []
          body:
            - decl: [var_r, list<string>, <.tags]
            - return: var_r

- model:
    name: RpcCast
    fields:
      - [name, string]
      - [amount, i32]
      - [tags, list<string>]

# Two-level nested model — matches DataCreatures' CreatureDetail (which has
# items: list<ptr<ItemBehavior>>, each ItemBehavior having tags: list<string>).
- model:
    name: Detail
    rpc: [request_detail]
    fields:
      - [creature_id, string]
      - [items,       list<ptr<ItemImpl>>]

- decl: [sess, mirror_session]
- set: [sess, { call: [mirror.listen, "ws://0.0.0.0:18888"] }]
- print: ["server: listening on ws://0.0.0.0:18888"]

- decl: [obj, ItemImpl]
- set: [obj.name, "Hammer"]
- call: [obj.tags.push, "tool"]
- call: [obj.tags.push, "metal"]
- call: [obj.tags.push, "starter"]
- decl: [nid, i32, { call: [sess.register, obj] }]
- print: ["server: registered ItemImpl nid=${nid} tags.len=${obj.tags.len}"]

# Detail handler — accepts request_detail RPCs from client.
- decl: [detail_handler, Detail]
- decl: [detail_nid, i32, { call: [sess.register, detail_handler] }]
- print: ["server: registered Detail nid=${detail_nid}"]

# Pump 8 seconds — accept connection, send sync, accept incoming RPC.
- decl: [var_i, i32, 0]
- decl: [rpc_count, i32, 0]
- while:
    condition: { lt: [var_i, 800] }
    body:
      - call: [sess.update]
      - if:
          condition: { gt: [{ call: [sess.has_rpc] }, 0] }
          then:
            - decl: [rpc_ev, rpc_event, { call: [sess.next_rpc] }]
            - if:
                condition: { eq: [rpc_ev.method, "cast"] }
                then:
                  - decl: [incoming, RpcCast]
                  - decl: [var_rc, i32, { call: [sess.decode_rpc, rpc_ev, incoming] }]
                  - if:
                      condition: { eq: [var_rc, 0] }
                      then:
                        - print: ["server: RPC cast — name='${incoming.name}' tags.len=${incoming.tags.len}"]
                        - set: [rpc_count, { "+": [rpc_count, 1] }]
                      else:
                        - print: ["server: RPC cast decode FAILED var_rc=${var_rc}"]
                else:
                  - if:
                      condition: { eq: [rpc_ev.method, "request_detail"] }
                      then:
                        # Client wants the nested detail.  Build it and send back
                        # via send_rpc("deliver_detail", payload).
                        - decl: [req, Detail]
                        - decl: [rc2, i32, { call: [sess.decode_rpc, rpc_ev, req] }]
                        - print: ["server: RPC request_detail var_rc=${rc2} req.creature_id='${req.creature_id}'"]

                        # Build the reply: a Detail with 2 items, each with tags.
                        - decl: [reply, Detail]
                        - set: [reply.creature_id, "creature-42"]
                        - decl: [it1, ptr<ItemImpl>, { new: ItemImpl }]
                        - set: [it1.name, "Hammer"]
                        - call: [it1.tags.push, "tool"]
                        - call: [it1.tags.push, "metal"]
                        - call: [reply.items.push, it1]
                        - decl: [it2, ptr<ItemImpl>, { new: ItemImpl }]
                        - set: [it2.name, "Crystal"]
                        - call: [it2.tags.push, "gem"]
                        - call: [it2.tags.push, "shiny"]
                        - call: [it2.tags.push, "rare"]
                        - call: [reply.items.push, it2]
                        - print: ["server: sending deliver_detail reply (items=${reply.items.len})"]
                        - call: [sess.send_rpc, rpc_ev.net_id, "deliver_detail", 0, reply]
                        - set: [rpc_count, { "+": [rpc_count, 1] }]
      - call: [time.sleep_ms, 10]
      - set: [var_i, { "+": [var_i, 1] }]

- call: [sess.close]
- print: ["server: shutdown rpc_count=${rpc_count}"]
- call: [sys.exit, 0]
