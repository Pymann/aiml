# Curated WASM testsuite — tests that exercise the wasm32 codegen + linker
# path.  Each line is a path to an AIML test (relative to repo root) that must
# exit 0 when run through the WASM pipeline (compile → emcc → node).
#
# Selection criteria: pure-compute, no GL/network/filesystem.  As bugs in the
# native-vs-wasm ABI surface, add the repro test here.
#
# To run: bash run_wasm_tests.sh
# To run ALL tests/*.aiml: bash run_wasm_tests.sh --all  (slow)

tests/test_iface_list_return.aiml
tests/test_iface_polymorphism.aiml
tests/test_iface_list_iterate.aiml
tests/test_class_list_return.aiml
tests/test_return_list_from_call.aiml

# spec/61 member handle SHARE and recursive release (wasm32 pointer layout)
tests/lifetime/61_member_handle_share.aiml
tests/lifetime/62_member_share_recursive_release.aiml
tests/test_input_injection_wasm.aiml
tests/test_input_focus_lost_keys_wasm.aiml
# spec/44_0 §2.3 + §8.3a: event layer, the edge survives a new press
tests/test_input_pending_layer_wasm.aiml
tests/test_wasm_list_clear_stride.aiml

# spec/10 F10-23 — the bounds check puts the throw site into every function with
# `at`/`get`; it must stay compilable and linkable on wasm32.
tests/test_builtin_throw_after_list_alloc.aiml
tests/test_base64.aiml
