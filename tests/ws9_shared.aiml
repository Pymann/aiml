# Requires: library
- model:
    name: GameViewWs9
    sync: [round, p1_name, p2_name, hand_count, p1_hp, p2_hp]
    rpc: [draw]
    fields:
      - [round, i32, 0]
      - [p1_name, string]
      - [p2_name, string]
      - [hand_count, i32, 0]
      - [p1_hp, i32, 100]
      - [p2_hp, i32, 100]

- model:
    name: ClientInfoWs9
    sync: [deckset_id, player_name, player_id]
    fields:
      - [deckset_id, string]
      - [player_name, string]
      - [player_id, string]
