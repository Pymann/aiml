# SPEC?: 23_system   # aus dem Dateinamen, zu bestaetigen
# Requires: library
# Client-side entrypoint compiled with import set A.  The host uses set B (SharedCard with rarity).

- import: "tests/ws_context_client_top_a.aiml"

- decl: [client, mirror_session]
- set: [client, { call: [mirror.connect_timeout, "ws://127.0.0.1:19923", 4000] }]

- decl: [view_nid, i32, -1]
- decl: [deadline, i64, { +: [{ call: [time.mono_ms] }, 6000] }]
- while:
    condition: { lt: [view_nid, 0] }
    body:
      - call: [client.update]
      - decl: [var_ev, mirror_event, { call: [client.poll_event] }]
      - if: { condition: { eq: [var_ev.type, "object_registered"] }, then: [{ set: [view_nid, var_ev.net_id] }] }
      - if:
          condition: { gt: [{ call: [time.mono_ms] }, deadline] }
          then:
            - print: ["FAIL ctx-client: no object_registered event"]
            - call: [sys.exit, 1]
      - call: [time.sleep_ms, 5]

- decl: [replica, SharedViewWsCtx]
- call: [client.register_id, replica, view_nid]

# the host's wire schema differs: the snapshot must be rejected, the replica stays untouched
- decl: [snap_err, i32, 0]
- set: [deadline, { +: [{ call: [time.mono_ms] }, 4000] }]
- while:
    condition: { eq: [snap_err, 0] }
    body:
      - call: [client.update]
      - set: [snap_err, { call: [client.snapshot_error, view_nid] }]
      - if:
          condition: { gt: [{ call: [client.snapshot_revision, view_nid] }, 0] }
          then:
            - print: ["FAIL ctx-client: foreign-schema snapshot was applied (round=${replica.round} title='${replica.title}')"]
            - call: [sys.exit, 1]
      - if:
          condition: { gt: [{ call: [time.mono_ms] }, deadline] }
          then:
            - print: ["FAIL ctx-client: no snapshot result within 4 s"]
            - call: [sys.exit, 1]
      - call: [time.sleep_ms, 5]

- if:
    condition: { neq: [snap_err, -2] }
    then:
      - print: ["FAIL ctx-client: snapshot_error=${snap_err}, expected -2 (schema)"]
      - call: [sys.exit, 1]
- if:
    condition: { '||': [{ neq: [replica.round, 0] }, { '||': [{ neq: [replica.title, ""] }, { '||': [{ neq: [replica.card_count, 0] }, { neq: [replica.cards.len, 0] }] }] }] }
    then:
      - print: ["FAIL ctx-client: replica mutated (round=${replica.round} title='${replica.title}' cards.len=${replica.cards.len})"]
      - call: [sys.exit, 1]

- call: [client.close]
- print: ["ctx-client: rejected as expected"]
